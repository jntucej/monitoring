# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
.next
tsconfig*.tsbuildinfo

# supabase local cache
supabase/.temp/
**/supabase/.temp/
*.tsbuildinfo
next-env.d.ts

# playwright output
/playwright-report/
/test-results/

# logs and workspace outputs
*.log
repomix-output*

# permission document uploads (Step 7) — never commit uploaded/signed PDFs
data/uploads/
.DS_Store

# One-shot credential-minting tools (removed from repo; never re-commit)
mint_jwt.mjs
scripts/provision-role-accounts.mts
scripts/prov/

# macOS
**/provenance/.DS_Store
/backups/
# Ignore SQL dumps and compressed archives, but never the versioned
# migration/seed files (gitignore is a list of rules, not a whitelist —
# so the specific negation patterns below must follow the blanket rule).
*.sql.gz
*.sql
!database/migrations/*.sql
!database/seeds/*.sql
!database/schema.sql
!database/bootstrap.sql
!database/bootstrap-roles.sql


# Python bytecode
__pycache__/
*.pyc

# local AI-tooling config (contains credentials — never commit)
.continue/

# scratch / one-off scripts and dumps (not part of the app)
/scratch/
/diff.txt
/route_dump.txt
/tables_code.txt
/tables_sql.txt
/get_file.js
/mark-done.js
/print_api.js
/print_file.js
/print_fn.js
/chunk.ts
/txt.b64

# Scratch scripts
fix-*.js*
create_missing_tables.js
dumpScanner.js
test_merge.ts
test-del.js

# Committed artifacts not tracked
qa-evidence/
*.bak.*
docker-compose.yml.bak*
users.json

# deploy-state dedup file (local runtime state, never commit)
.last_notified_hash

# Permission workflow document uploads (never commit)
data/uploads/
.scannerwork/
scripts/smoke-creds.json
scripts/smoke-report.json
