{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist-tools"
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "packages/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "src"
  ]
}
