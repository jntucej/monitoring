[data-theme="dark"] .liquid-glass, html.dark .liquid-glass {
  background: rgba(10, 15, 26, 0.65);
  border-color: rgba(16, 185, 129, 0.15);
}
[data-theme="glass"] .liquid-glass, html.glass .liquid-glass {
  background: rgba(24, 27, 33, 0.55);
  border-color: rgba(255, 255, 255, 0.15); /* Stronger specular outline */
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.15), /* Inner subtle boundary glow */
