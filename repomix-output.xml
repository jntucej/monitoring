                  </button>
                )}
              </div>
              <button
                onClick={() => { stopCamera(); onClose(); }}
                className="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 text-slate-400 text-xs font-bold"
              >
                Cancel & Close
              </button>
            </div>
          </div>
        </motion.div>
      </div>
    </AnimatePresence>
  );
}
