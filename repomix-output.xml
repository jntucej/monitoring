@import "tailwindcss";

/* ============================================================
   DESIGN TOKENS — JNTUH CEJ Student Gate Monitoring System
   Apple-Inspired HIG Design System: Calm, Restrained, Precise
   ============================================================ */

:root {
  /* Typography - Clean Apple SF Pro / Inter font stack */
  --font-family: var(--font-inter), -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Roboto, sans-serif;

  /* Spacing Scale (Strict 8px System) */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;

  /* Touch Target Dimensions (Apple HIG Compliant) */
  --touch-target-min: 48px;
  --touch-target-operational: 64px;

  /* Radius (Subtle Apple-style rounded rects) */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;

  /* Motion & Spring Dynamics */
  --duration-fast: 120ms;
  --duration-normal: 220ms;
  --duration-slow: 350ms;
  --ease-apple: cubic-bezier(0.16, 1, 0.3, 1);

  /* Fallback Base Tokens (Default Dark High Contrast) */
  --bg-base: #060911;
  --bg-surface: #0f172a;
  --bg-elevated: #1e293b;
  --text-primary: #ffffff;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
  --border: rgba(255, 255, 255, 0.12);
  --border-strong: rgba(255, 255, 255, 0.24);

  --action-primary: #10b981;
  --action-danger: #f43f5e;
  --action-warning: #f59e0b;
  --action-info: #3b82f6;
  --focus-ring: #10b981;
}

/* ===== DARK THEME — Deep High Contrast Developer & Security Aesthetic ===== */
:root[data-theme="dark"],
html.dark {
  --bg-base: #060911;        /* Deep Obsidian Black */
  --bg-surface: #0f172a;     /* Slate-900 High Contrast Card Surface */
  --bg-elevated: #1e293b;    /* Slate-800 High-Visibility Container */
  --text-primary: #ffffff;   /* Pure 100% Crisp White Text */
  --text-secondary: #cbd5e1; /* Slate-300 Readable Subtitle */
  --text-muted: #94a3b8;     /* Slate-400 Soft Contrast */
  --border: rgba(255, 255, 255, 0.14); /* Vivid border */
  --border-strong: rgba(255, 255, 255, 0.28);

  --action-primary: #10b981; /* High-contrast Emerald Green */
  --action-danger: #f43f5e;  /* Vivid Crimson Red */
  --action-warning: #f59e0b; /* Bright Amber */
  --action-info: #3b82f6;    /* Vibrant Royal Blue */
  --focus-ring: #10b981;
}

/* ===== LIGHT THEME — Crisp Pure White High-Contrast ===== */
:root[data-theme="light"],
html.light {
  --bg-base: #f8fafc;        /* Slate-50 Crisp Light Background */
  --bg-surface: #ffffff;     /* Pure White Card Surface */
  --bg-elevated: #f1f5f9;    /* Slate-100 High Contrast Sub-panel */
  --text-primary: #020617;   /* Slate-950 Deepest Black Text for sharp contrast */
  --text-secondary: #334155; /* Slate-700 Text */
  --text-muted: #64748b;     /* Slate-500 Text */
  --border: #cbd5e1;        /* Slate-300 Crisp Border */
  --border-strong: #94a3b8; /* Slate-400 Strong Border */

  --action-primary: #059669; /* Emerald-600 */
  --action-danger: #dc2626;  /* Red-600 */
  --action-warning: #d97706; /* Amber-600 */
  --action-info: #2563eb;    /* Blue-600 */
  --focus-ring: #059669;
}

/* ===== SEMANTIC HIG STATUS SURFACES ===== */
.status-entry     { color: var(--action-primary); }
.status-exit      { color: var(--action-danger); }
.status-dayout    { color: var(--action-warning); }
.status-leave     { color: var(--action-info); }

.bg-entry-subtle  { background-color: rgba(16, 185, 129, 0.12); color: var(--action-primary); }
.bg-exit-subtle   { background-color: rgba(244, 63, 94, 0.12); color: var(--action-danger); }
.bg-dayout-subtle { background-color: rgba(245, 158, 11, 0.12); color: var(--action-warning); }
.bg-leave-subtle  { background-color: rgba(59, 130, 246, 0.12); color: var(--action-info); }

/* Numeric Precision Utilities */
.tabular-nums {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* Operational Touch Targets */
.touch-target-primary {
  min-height: var(--touch-target-operational);
  display: flex;
  align-items: center;
  justify-content: center;
}

.touch-target-secondary {
  min-height: var(--touch-target-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Safe Area Inset Layout Support */
.pb-safe {
  padding-bottom: env(safe-area-inset-bottom, 16px);
}
.pt-safe {
  padding-top: env(safe-area-inset-top, 16px);
}

/* Focus Visibility Rules */
*:focus-visible {
  outline: 2px solid var(--focus-ring);
  outline-offset: 2px;
}

/* Base Body Setup */
html {
  scroll-behavior: smooth;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  background-color: var(--bg-base);
  color: var(--text-primary);
  font-family: var(--font-family);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
