  border-color: rgba(5, 150, 105, 0.30) !important;
}

/* ===== High-End vs Low-Profile Specific UI Hardware Profiles ===== */
html[data-device-profile="high-end"] .glass-card {
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(16, 185, 129, 0.25);
  box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.4), 0 0 15px 0 rgba(16, 185, 129, 0.1);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

html[data-device-profile="high-end"] .glass-card:hover {
  box-shadow: 0 12px 40px -5px rgba(0, 0, 0, 0.5), 0 0 25px 0 rgba(16, 185, 129, 0.25);
  border-color: rgba(16, 185, 129, 0.45);
  transform: translateY(-3px);
}

html[data-device-profile="low-profile"] .glass-card {
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  background-color: var(--bg-surface) !important;
  border: 1px solid var(--border) !important;
  box-shadow: none !important;
  transform: none !important;
  transition: none !important;
}

.tabular-nums {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* Operational Touch Targets */
.touch-target-primary {
  min-height: var(--touch-target-operational);
  display: flex;
  align-items: center;
  justify-content: center;
}

.touch-target-secondary {
  min-height: var(--touch-target-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Safe Area Inset Layout Support */
.pb-safe {
  padding-bottom: env(safe-area-inset-bottom, 16px);
}
.pt-safe {
  padding-top: env(safe-area-inset-top, 16px);
}

/* Focus Visibility Rules */
*:focus-visible {
  outline: 2px solid var(--focus-ring);
  outline-offset: 2px;
}

/* Base Body Setup */
html {
  scroll-behavior: smooth;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  background-color: var(--bg-base);
  color: var(--text-primary);
  font-family: var(--font-family);
