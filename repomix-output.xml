<file path="monitoring/scripts/sync-bridge/types.ts">
export interface RawDeviceLog {
  deviceUserId: string;
  localTimestamp: string;
  verifyMode?: string;
  state?: number;
  meta?: Record<string, unknown>;
}

export interface ResolvedDeviceEvent {
  deviceSerial: string;
  deviceUserId: string;
  userId: string;
  localTimestamp: string;
  timestampUtc: string;
  direction: 'IN' | 'OUT';
  verifyMode?: string;
  meta?: Record<string, unknown>;
}

export interface AttendanceRecordMirror {
  dedupe_key: string;
