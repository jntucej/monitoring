/* Mobile Touch / Nav Adjustments */
@media (max-width: 640px) {
  .touch-target-primary { min-height: 56px; }
  .glass-nav-dock { padding-bottom: calc(env(safe-area-inset-bottom, 16px) + 4px) !important; }
}

:root {
  --glass-blur: 24px;
  --glass-saturate: 220%; /* Bump saturation boost for deeper richness */
  --glass-sheen-color: rgba(255, 255, 255, 0.25);
  --glass-sheen-start: 0%;
  --glass-sheen-end: 100%;
  --rail-width: 220px;
}
@media (min-width: 768px) { :root { --rail-width: 240px; } }
@media (min-width: 1024px){ :root { --rail-width: 260px; } }
@media (min-width: 1280px){ :root { --rail-width: 280px; } }

@keyframes liquid-sheen {
  0%   { transform: translateX(-100%) skewX(-12deg); opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { transform: translateX(200%) skewX(-12deg); opacity: 0; }
}
@keyframes glass-rail-in {
