/* Glass‑specific text styles (for navigation only) */
.text-on-glass-primary { color: #ffffff; }
.text-on-glass-secondary { color: rgba(255, 255, 255, 0.7); }
.text-on-glass-muted { color: rgba(255, 255, 255, 0.5); }

/* Globals Overrides */
html {
  font-family: var(--font-family);
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
