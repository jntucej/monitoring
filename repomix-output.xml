  --bg-base: #0a0d13;        /* Deep Obsidian Black */
  --bg-surface: #0f172a;     /* Slate-900 High Contrast Card Surface */
  --bg-elevated: #1e293b;    /* Slate-800 High-Visibility Container */
  --text-primary: #eef1f6;   /* Pure Crisp White Text */
  --text-secondary: #cbd5e1; /* Slate-300 Readable Subtitle */
  --text-muted: #94a3b8;     /* Slate-400 Soft Contrast */
    --border: rgba(255, 255, 255, 0.14); /* Vivid border */
