/* ===== CINEMATIC GLOSSY LIQUID THEME — Translucent Light Frosted Glassmorphism ===== */
:root[data-theme="glossy-liquid"],
:root[data-theme="glass"],
[data-theme="glossy-liquid"],
[data-theme="glass"],
html.glass {
  --color-canvas: #edf4fe;
  --glass-bg: rgba(255, 255, 255, 0.72);
  --orb-cyan: hsl(192, 95%, 55%);
  --orb-magenta: hsl(265, 88%, 66%);
  --orb-primary: hsl(217, 91%, 60%);
  --orb-secondary: hsl(187, 92%, 55%);
  --rim-top: rgba(255, 255, 255, 0.95);
  --rim-bottom: rgba(0, 50, 120, 0.08);
  --text-primary: #0f172a;

  /* Typography - Apple HIG Strict bounds */
  --font-family: var(--font-inter), -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-size-xs: clamp(0.75rem, 0.7rem + 0.2vw, 0.875rem);
  --font-size-sm: clamp(0.875rem, 0.8rem + 0.25vw, 1rem);
  --font-size-base: clamp(1rem, 0.9rem + 0.3vw, 1.125rem);
  --font-size-md: clamp(1.125rem, 1rem + 0.4vw, 1.25rem);
  --font-size-lg: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
  --font-size-xl: clamp(1.5rem, 1.3rem + 0.7vw, 2rem);
  --font-size-2xl: clamp(2rem, 1.6rem + 1vw, 3rem);
  --line-height-tight: 1.1;
  --line-height-snug: 1.2;
  --line-height-normal: 1.5;
  --tracking-tight: -0.02em;
  --tracking-normal: -0.01em;
  --tracking-wide: 0.02em;
  --tracking-wider: 0.05em;

  /* Translucent Liquid Glass Canvas */
  --bg-base: #edf4fe;
  --bg-surface: rgba(255, 255, 255, 0.76);
  --bg-elevated: rgba(255, 255, 255, 0.92);
  --text-primary: #0f172a;
  --text-secondary: #334155;
  --text-muted: #64748b;
  --border: rgba(255, 255, 255, 0.85);
  --border-strong: rgba(255, 255, 255, 0.95);

  --action-primary: #0072ff;
  --action-danger: #ef4444;
  --action-warning: #d97706;
  --action-info: #00c6ff;
  --action-success: #00c896; /* vivid emerald — good/true rows */
  --focus-ring: #0072ff;

  /* Study-resource per-unit accents (theme-adaptive) */
  --unit-a: #00b3ff;  /* vivid sky — Unit I */
  --unit-b: #00c896;  /* vivid emerald — Unit II */
  --unit-c: #c084fc;  /* soft purple — Unit III */
  --unit-a-soft: rgba(0, 179, 255, 0.14);
  --unit-b-soft: rgba(0, 200, 150, 0.14);
  --unit-c-soft: rgba(192, 132, 252, 0.14);
}

/* Dark theme specific text shadow for readability */
html.dark .glass-panel h1,
html.dark .glass-panel h2,
html.dark .glass-panel .metric-number,
html.dark .glass-panel .stat-value {
  text-shadow: 0 0 30px rgba(0, 0, 0, 0.85), 0 2px 8px rgba(0, 0, 0, 0.6);
}

html.dark .glass-panel p,
html.dark .glass-panel span,
html.dark .glass-panel small,
html.dark .glass-panel time {
  text-shadow: 0 0 8px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.25) !important;
}

/* Self-moving Ambient Floating Movement Keyframes */
@keyframes glossy-self-float {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-7px); }
  100% { transform: translateY(0px); }
}

@keyframes glossy-self-float-alt {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
  100% { transform: translateY(0px); }
}

/* Glass Mode Universal Card & Panel Frosted Blur & Tangible Floating Shadow Enhancement */
@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
  html[data-theme="glass"] [class*="bg-[var(--bg-surface)]"],
  html[data-theme="glass"] [class*="bg-[var(--bg-elevated)]"],
  html[data-theme="glossy-liquid"] [class*="bg-[var(--bg-surface)]"],
  html[data-theme="glossy-liquid"] [class*="bg-[var(--bg-elevated)]"] {
    backdrop-filter: blur(28px) saturate(210%);
    -webkit-backdrop-filter: blur(28px) saturate(210%);
    border: 1.5px solid rgba(255, 255, 255, 0.92) !important;
    background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.65) 100%);
    box-shadow: 
      0 26px 54px -12px rgba(0, 114, 255, 0.16),
      0 12px 24px -8px rgba(31, 38, 135, 0.12),
      0 2px 6px rgba(0, 0, 0, 0.04),
      inset 0 1.5px 2px rgba(255, 255, 255, 1),
      inset 0 -1.5px 2px rgba(0, 114, 255, 0.10);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, background 0.4s ease;
    animation: glossy-self-float 8s ease-in-out infinite;
  }

  html[data-theme="glass"] [class*="bg-[var(--bg-surface)]"]:nth-child(even),
  html[data-theme="glass"] [class*="bg-[var(--bg-elevated)]"]:nth-child(even) {
    animation: glossy-self-float-alt 10s ease-in-out infinite 1s;
  }

  /* Interactive Hover Lift & Edge Light Distortion Sheen Shift + Radiant Underglow */
  html[data-theme="glass"] [class*="bg-[var(--bg-surface)]"]:hover,
  html[data-theme="glass"] [class*="bg-[var(--bg-elevated)]"]:hover {
    transform: translateY(-9px) scale(1.012) !important;
    box-shadow: 
      0 0 35px 5px rgba(0, 198, 255, 0.40),
      0 38px 75px -15px rgba(0, 114, 255, 0.42),
      0 20px 35px -10px rgba(31, 38, 135, 0.20),
      0 4px 10px rgba(0, 0, 0, 0.05),
      inset 0 2px 2.5px rgba(255, 255, 255, 1),
      inset 0 -2px 3px rgba(0, 198, 255, 0.30) !important;
    border-color: rgba(255, 255, 255, 1) !important;
    background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.94) 0%, rgba(255, 255, 255, 0.78) 100%);
  }

  /* Radiant Hover Underglow for Buttons & Action Pills in Glossy Theme */
  html[data-theme="glass"] button:hover,
  html[data-theme="glass"] [role="button"]:hover,
  html[data-theme="glass"] .btn:hover {
    box-shadow: 
      0 0 26px 4px rgba(0, 198, 255, 0.55),
      0 12px 28px -3px rgba(0, 114, 255, 0.45),
      inset 0 1.5px 2px rgba(255, 255, 255, 0.95) !important;
    transform: translateY(-1.5px);
  }

  /* Radiant Hover Underglow for Links, Tabs, & Nav Badges */
  html[data-theme="glass"] a:hover,
  html[data-theme="glass"] .nav-item:hover,
  html[data-theme="glass"] [role="tab"]:hover {
    box-shadow: 
      0 0 22px 3px rgba(0, 198, 255, 0.45),
      0 8px 22px -2px rgba(0, 114, 255, 0.35) !important;
  }

  /* Radiant Focus/Hover Underglow for Inputs & Selects */
  html[data-theme="glass"] input:hover,
  html[data-theme="glass"] input:focus,
  html[data-theme="glass"] select:hover,
  html[data-theme="glass"] select:focus,
  html[data-theme="glass"] textarea:hover,
  html[data-theme="glass"] textarea:focus {
    box-shadow: 
      0 0 24px 4px rgba(0, 198, 255, 0.50),
      0 8px 20px rgba(0, 114, 255, 0.30),
      inset 0 1px 1.5px rgba(255, 255, 255, 0.95) !important;
    border-color: #00c6ff !important;
  }

  /* Ultra Glossy Floating Card Surface */
  html[data-theme="glass"] .glass-floating-surface,
  html[data-theme="glossy-liquid"] .glass-floating-surface {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.68) 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(28px) saturate(210%);
    -webkit-backdrop-filter: blur(28px) saturate(210%);
    box-shadow: 0 24px 50px rgba(0, 70, 180, 0.12), inset 0 1.5px 1.5px rgba(255, 255, 255, 1);
  }
}

/* Cinematic Motion Keyframes & Utilities */
@keyframes cinematic-float-glow {
  0% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(4vw, 3vh) scale(1.1); }
  100% { transform: translate(-2vw, -2vh) scale(0.95); }
}

@keyframes cinematic-shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.cinematic-shimmer-effect {
  position: relative;
  overflow: hidden;
}

/* ============================================================
   ENHANCEMENT 1: THEME TRANSITION MORPH (Liquid Flow)
   ============================================================ */
.glass-panel,
.theme-transitioning .glass-panel,
header.glass-header,
.floating-orb-container {
  transition: background-color 0.7s cubic-bezier(0.22, 1, 0.36, 1),
              box-shadow 0.7s cubic-bezier(0.22, 1, 0.36, 1),
              border-color 0.7s cubic-bezier(0.22, 1, 0.36, 1),
              backdrop-filter 0.7s cubic-bezier(0.22, 1, 0.36, 1),
              -webkit-backdrop-filter 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}

/* For the main canvas body background */
body, .canvas-root {
  transition: background-color 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}
.cinematic-shimmer-effect::after {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.06) 50%, rgba(255,255,255,0) 100%);
  transform: translateX(-100%);
  pointer-events: none;
}
@media (prefers-reduced-motion: no-preference) {
  .cinematic-shimmer-effect:hover::after {
    animation: cinematic-shimmer 3s ease-in-out infinite;
  }
  .glass-card {
    will-change: transform, backdrop-filter;
    transition: backdrop-filter 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
}

/* ===== SEMANTIC HIG STATUS SURFACES ===== */
.status-entry     { color: var(--action-primary); }
.status-exit      { color: var(--action-danger); }
.status-dayout    { color: var(--action-warning); }
.status-leave     { color: var(--action-info); }

.bg-entry-subtle  { background-color: rgba(16, 185, 129, 0.12); color: var(--action-primary); }
.bg-exit-subtle   { background-color: rgba(244, 63, 94, 0.12); color: var(--action-danger); }
.bg-dayout-subtle { background-color: rgba(245, 158, 11, 0.12); color: var(--action-warning); }
.bg-leave-subtle  { background-color: rgba(59, 130, 246, 0.12); color: var(--action-info); }

/* Numeric Precision Utilities */
.glass-card {
  /* Theme-aware card surface — uses CSS variables so all three themes respond */
  background-color: var(--bg-surface);

  /* Lightweight blur to prevent scroll jank on Android */
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  /* GPU Layer Promotion */
  transform: translateZ(0);
  -webkit-transform: translateZ(0);

  border: 1px solid var(--border);
  box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.25);

  /* Smooth theme morph transition */
  transition: background-color 0.4s cubic-bezier(0.22, 1, 0.36, 1),
              border-color 0.4s cubic-bezier(0.22, 1, 0.36, 1),
              box-shadow 0.3s ease-out;
}

.glass-card:hover {
  box-shadow: 0 8px 40px -8px var(--focus-ring);
  border-color: var(--focus-ring);
  transform: translateY(-2px);
}

/* ===== THEME-SPECIFIC .glass-card OVERRIDES =====
   These ensure every study resource container morphs correctly across all three themes. */

/* Dark theme — deep slate cards */
html.dark .glass-card,
:root[data-theme="dark"] .glass-card {
  background-color: rgba(15, 23, 42, 0.85);
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.35);
}
html.dark .glass-card:hover,
:root[data-theme="dark"] .glass-card:hover {
  box-shadow: 0 0 60px 0px rgba(99, 102, 241, 0.5);
  border-color: rgba(99, 102, 241, 0.45);
}

/* Glossy / Glass theme — frosted translucent cards with ambient float */
html.glass .glass-card,
:root[data-theme="glass"] .glass-card,
:root[data-theme="glossy-liquid"] .glass-card {
  background-color: rgba(255, 255, 255, 0.72);
  border-color: rgba(255, 255, 255, 0.92);
  background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.65) 100%);
  box-shadow: 0 26px 54px -12px rgba(0, 114, 255, 0.16),
              0 12px 24px -8px rgba(31, 38, 135, 0.12),
              0 2px 6px rgba(0, 0, 0, 0.04),
              inset 0 1.5px 2px rgba(255, 255, 255, 1),
              inset 0 -1.5px 2px rgba(0, 114, 255, 0.10);
  backdrop-filter: blur(28px) saturate(210%);
  -webkit-backdrop-filter: blur(28px) saturate(210%);
}
html.glass .glass-card:hover,
:root[data-theme="glass"] .glass-card:hover,
:root[data-theme="glossy-liquid"] .glass-card:hover {
  box-shadow: 0 30px 60px -10px rgba(0, 114, 255, 0.22),
              0 16px 32px -8px rgba(31, 38, 135, 0.18),
              0 2px 6px rgba(0, 0, 0, 0.04),
              inset 0 1.5px 2px rgba(255, 255, 255, 1),
              inset 0 -1.5px 2px rgba(0, 114, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.98);
  transform: translateY(-4px);
}

/* Light theme — crisp white cards with subtle shadow */
html.light .glass-card,
:root[data-theme="light"] .glass-card {
  background-color: #ffffff;
  border-color: #cbd5e1;
  box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.08),
              0 2px 6px -2px rgba(0, 0, 0, 0.04);
}
html.light .glass-card:hover,
:root[data-theme="light"] .glass-card:hover {
  box-shadow: 0 8px 30px -6px rgba(0, 0, 0, 0.12),
              0 4px 10px -4px rgba(0, 0, 0, 0.06);
  border-color: #94a3b8;
  transform: translateY(-2px);
}

/* ============================================================
   INNER CARD HIGHLIGHT OVERRIDES
   Fix bg-[var(--action-primary)]/5 type blocks so they
   don't bleed into white card surfaces in glass / light themes.
   ============================================================ */

/* Study cheat-sheet inner highlight blocks — fix for glass theme */
html.glass .glass-card [class*="bg-[var(--action-primary)]/5"],
html.glass .glass-card [class*="bg-[var(--action-primary)]/10"],
html.glass .glass-card [class*="bg-[var(--action-success)]/10"],
html.glass .glass-card [class*="bg-[var(--action-danger)]/10"],
html.glass .glass-card [class*="bg-[var(--action-warning)]/10"],
html.glass .glass-card [class*="bg-[var(--action-info)]/10"] {
  background-color: rgba(0, 114, 255, 0.08) !important;
}
html.glass .glass-card [class*="border-[var(--action-primary)]/20"],
html.glass .glass-card [class*="border-[var(--action-primary)]/40"] {
  border-color: rgba(0, 114, 255, 0.25) !important;
}

/* Light theme inner highlight blocks */
html.light .glass-card [class*="bg-[var(--action-primary)]/5"],
html.light .glass-card [class*="bg-[var(--action-primary)]/10"],
html.light .glass-card [class*="bg-[var(--action-success)]/10"],
html.light .glass-card [class*="bg-[var(--action-danger)]/10"],
html.light .glass-card [class*="bg-[var(--action-warning)]/10"],
html.light .glass-card [class*="bg-[var(--action-info)]/10"] {
  background-color: rgba(5, 150, 105, 0.10) !important;
}
html.light .glass-card [class*="border-[var(--action-primary)]/20"],
html.light .glass-card [class*="border-[var(--action-primary)]/40"] {
  border-color: rgba(5, 150, 105, 0.30) !important;
}

/* ===== High-End vs Low-Profile Specific UI Hardware Profiles ===== */
html[data-device-profile="high-end"] .glass-card {
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(16, 185, 129, 0.25);
  box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.4), 0 0 15px 0 rgba(16, 185, 129, 0.1);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

html[data-device-profile="high-end"] .glass-card:hover {
  box-shadow: 0 12px 40px -5px rgba(0, 0, 0, 0.5), 0 0 25px 0 rgba(16, 185, 129, 0.25);
  border-color: rgba(16, 185, 129, 0.45);
  transform: translateY(-3px);
}

html[data-device-profile="low-profile"] .glass-card {
