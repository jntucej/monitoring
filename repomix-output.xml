  } catch (idxCheckErr: any) {
    console.warn("Notice checking indexes:", idxCheckErr.message);
  }

  console.log("\n🎉 Supabase Migrations Check Finished!");
  process.exit(0);
}

checkMigrations().catch((e) => {
