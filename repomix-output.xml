  --font-size-md: clamp(1.05rem, 0.95rem + 0.4vw, 1.2rem);
  --font-size-lg: clamp(1.2rem, 1.05rem + 0.5vw, 1.4rem);
  --font-size-xl: clamp(1.4rem, 1.2rem + 0.7vw, 1.8rem);
  --font-size-2xl: clamp(1.8rem, 1.5rem + 1vw, 2.5rem);
  --line-height-tight: 1.1;
  --line-height-snug: 1.3;
  --line-height-normal: 1.4;
  --tracking-tight: 0;
  --tracking-normal: 0.02em;
  --tracking-wide: 0.04em;
