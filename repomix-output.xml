                </div>
              </form>
            </div>
          </div>
        )}

        {/* Bulk Import Modal */}
        {showBulkModal && (
          <BulkUserImportModal onClose={() => setShowBulkModal(false)} onSuccess={() => { setShowBulkModal(false); loadStudents(); }} />
        )}
      </div>
    </AuthGuard>
  );
}
