<file path="monitoring-check/src/app/globals.css">
@import "tailwindcss";

/* ============================================================
   DESIGN TOKENS — Student Gate Monitoring System
   Apple-Inspired HIG Design System: Calm, Restrained, Precise
   ============================================================ */

:root {
  /* Base Temperatures — DIRECTION 1: Cold Forge */
  --hue-primary: 213;
  --hue-secondary: 248;
  --hue-cyan: 213;
  --hue-magenta: 248;
  
  /* Ambient Orbs */
  --orb-primary: hsl(213, 48%, 36%);
  --orb-secondary: hsl(248, 42%, 30%);
  --orb-cyan: hsl(213, 48%, 36%);
  --orb-magenta: hsl(248, 42%, 30%);

  /* UI Accent */
  --accent: hsl(36, 68%, 56%);
  --accent-dim: hsl(30, 42%, 30%);
  --accent-cyan: hsl(36, 68%, 56%);
  --accent-cyan-dim: hsl(30, 42%, 30%);

  /* Alert States (Fully Saturated, Highly Luminous) */
  --alert-critical: hsl(0, 92%, 50%);   /* Pure Red - Stop/Evacuate */
  --alert-warning: hsl(45, 100%, 55%);  /* Bright Amber - Caution/Review */
  --alert-success: hsl(160, 90%, 40%);  /* Deep Teal/Emerald - All Clear */

  /* Typography - Clean Apple SF Pro / Inter font stack */
  --font-family: var(--font-inter), -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

  /* Fluid sizes */
  --font-size-xs: clamp(0.75rem, 0.7rem + 0.2vw, 0.875rem);
  --font-size-sm: clamp(0.875rem, 0.8rem + 0.25vw, 1rem);
  --font-size-base: clamp(1rem, 0.9rem + 0.3vw, 1.125rem);
  --font-size-md: clamp(1.125rem, 1rem + 0.4vw, 1.25rem);
  --font-size-lg: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
  --font-size-xl: clamp(1.5rem, 1.3rem + 0.7vw, 2rem);
  --font-size-2xl: clamp(2rem, 1.6rem + 1vw, 3rem);

  /* Line heights */
  --line-height-tight: 1.1;
  --line-height-snug: 1.2;
  --line-height-normal: 1.5;

  /* Tracking */
  --tracking-tight: -0.02em;
  --tracking-normal: -0.01em;
  --tracking-wide: 0.02em;
  --tracking-wider: 0.05em;

  /* Spacing Scale (Strict 8px System) */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;

  /* Touch Target Dimensions (Apple HIG Compliant) */
  --touch-target-min: 48px;
  --touch-target-operational: 64px;

  /* Radius (Subtle Apple-style rounded rects) */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;

  /* Motion & Spring Dynamics */
  --duration-fast: 120ms;
  --duration-normal: 220ms;
  --duration-slow: 350ms;
  --ease-apple: cubic-bezier(0.16, 1, 0.3, 1);

  /* Fallback Base Tokens (Default Dark High Contrast) */
  --bg-base: #0a0d13;
  --bg-surface: #0f172a;
  --bg-elevated: #1e293b;
  --text-primary: #eef1f6;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
  --border: rgba(255, 255, 255, 0.12);
  --border-strong: rgba(255, 255, 255, 0.24);

  --action-primary: #10b981;
  --action-danger: #f43f5e;
  --action-warning: #f59e0b;
  --action-info: #3b82f6;
  --action-success: #10b981; /* emerald — "good/true" rows in comparisons */
  --focus-ring: #10b981;

  /* Study-resource per-unit accents — also defined per-theme below
     (dark / glass / light). These exist in the base :root so a valid
     colour is always present even before the theme attribute is applied. */
  --unit-a: #38bdf8;  /* sky 400 — Unit I */
  --unit-b: #34d399;  /* emerald 400 — Unit II */
  --unit-c: #e879f9;  /* fuchsia 400 — Unit III */
  --unit-a-soft: rgba(56, 189, 248, 0.12);
  --unit-b-soft: rgba(52, 211, 153, 0.12);
  --unit-c-soft: rgba(232, 121, 249, 0.12);
}

/* ===== DARK THEME — Deep High Contrast Developer & Security Aesthetic ===== */
:root[data-theme="dark"],
[data-theme="dark"],
html.dark {
  --color-canvas: #0a0d13;
  --glass-bg: rgba(20, 26, 36, 0.52);
  --orb-cyan: hsl(213, 48%, 36%);
  --orb-magenta: hsl(248, 42%, 30%);
  --orb-primary: hsl(213, 48%, 36%);
  --orb-secondary: hsl(248, 42%, 30%);
  --rim-top: rgba(255, 255, 255, 0.12);
  --rim-bottom: rgba(0, 0, 0, 0.55);
  --text-primary: #eef1f6;

