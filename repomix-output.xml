    margin-left: var(--rail-width);
  }
}

/* --- BASE MOBILE SAFEGUARDS & OVERFLOW CONTAINMENT --- */
* {
  -webkit-tap-highlight-color: transparent; /* Removes default iOS tap flash */
}

html, body {
  min-height: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  touch-action: manipulation;
}

/* Touch targets safeguard for interactive components */
button, a, [role="button"], .clickable-card {
  min-height: 44px;
}

/* For the Theme Toggle pill */
.theme-toggle-pill button {
  padding: 0.5rem 0.75rem;
}

/* --- RESPONSIVE GLASS: Reduce blur & padding on phones --- */
@media (max-width: 640px) {
  .glass-panel {
    backdrop-filter: blur(12px) saturate(180%) !important; /* Half the blur (24px -> 12px) */
    -webkit-backdrop-filter: blur(12px) saturate(180%) !important;
    padding: 1rem !important; /* Tighter padding for small cards */
    border-radius: 1rem !important; /* Slightly smaller radius */
  }

  /* Headers & Metric Numbers (Prevent overflow on small screens) */
  .glass-panel h1, 
  .glass-panel .metric-number,
  .glass-panel .stat-value {
    font-size: 1.8rem !important; /* Scales down from ~2.5rem on desktop */
    word-break: break-word;
  }

  /* Metadata & Timestamps - keep them small but readable */
  .glass-panel .timestamp,
  .glass-panel .text-muted {
    font-size: 0.65rem !important;
  }
}

/* --- EXTRA SMALL (Phones < 400px) --- */
@media (max-width: 400px) {
  .glass-panel {
    padding: 0.75rem !important;
    border-radius: 0.75rem !important;
  }
  .glass-panel h1 {
    font-size: 1.4rem !important;
  }
}

/* ============================================================
   MOBILE UI REDESIGN & TOUCH UTILITIES
   ============================================================ */
@layer utilities {
  .-webkit-overflow-scrolling-touch {
    -webkit-overflow-scrolling: touch;
  }
  .touch-target {
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom, 16px);
  }
  .active-tap {
    transition: transform 0.1s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .active-tap:active {
    transform: scale(0.96);
  }
  /* Hide scrollbar for horizontal scroll containers on mobile */
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Thin custom scrollbar for vertical lists */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.25);
  }
}

/* ============================================================
   GLOSSY THEME TEXT COLOR FIXES — Override hardcoded dark-mode colors
   ============================================================ */

/* Primary text colors — force dark text on light backgrounds */
html.glass [class*="text-white"],
html.glass [class*="text-slate-100"],
html.glass [class*="text-slate-200"],
html.glass [class*="text-slate-300"],
html.glass [class*="text-gray-100"],
html.glass [class*="text-gray-200"],
html.glass [class*="text-gray-300"] {
  color: var(--text-secondary, #334155) !important;
}

html.glass [class*="text-slate-400"],
html.glass [class*="text-gray-400"] {
  color: var(--text-muted, #64748b) !important;
}

html.glass [class*="text-slate-500"],
html.glass [class*="text-gray-500"] {
  color: var(--text-muted, #64748b) !important;
}

/* Background overrides — dark backgrounds on glossy must become light */
html.glass [class*="bg-slate-900"],
html.glass [class*="bg-slate-800"],
html.glass [class*="bg-slate-700"],
html.glass [class*="bg-gray-900"],
html.glass [class*="bg-gray-800"],
html.glass [class*="bg-gray-700"] {
  background-color: var(--bg-surface, rgba(255,255,255,0.76)) !important;
}

html.glass [class*="bg-slate-950"],
html.glass [class*="bg-gray-950"] {
  background-color: var(--bg-base, #edf4fe) !important;
}

/* Force text on those dark backgrounds to be readable */
html.glass [class*="bg-slate-900"] *,
html.glass [class*="bg-slate-800"] *,
html.glass [class*="bg-slate-700"] *,
html.glass [class*="bg-gray-900"] *,
html.glass [class*="bg-gray-800"] *,
html.glass [class*="bg-gray-700"] *,
html.glass [class*="bg-slate-950"] *,
html.glass [class*="bg-gray-950"] * {
  color: var(--text-primary, #0f172a) !important;
}

/* Operator/Scanner dark panel overrides */
html.glass .scanner-panel,
html.glass [class*="bg-slate-950"],
html.glass [class*="bg-slate-900"] {
  background: var(--bg-surface, rgba(255,255,255,0.76)) !important;
  color: var(--text-primary, #0f172a) !important;
}

html.glass .scanner-panel *,
html.glass [class*="bg-slate-950"] *,
html.glass [class*="bg-slate-900"] * {
  color: var(--text-primary, #0f172a) !important;
}

/* Specific component fixes */
html.glass .bg-gray-800,
html.glass .bg-gray-900 {
  background-color: var(--bg-elevated, rgba(255,255,255,0.92)) !important;
}

html.glass .bg-gray-800 *,
html.glass .bg-gray-900 * {
  color: var(--text-primary, #0f172a) !important;
}

/* Navbar/sidebar dark backgrounds */
html.glass .sidebar,
html.glass [class*="bg-slate-900"],
html.glass [class*="bg-slate-800"] {
  background: var(--bg-surface, rgba(255,255,255,0.76)) !important;
}

/* Input fields on glossy */
html.glass input,
html.glass textarea,
html.glass select {
  background-color: var(--bg-elevated, rgba(255,255,255,0.92)) !important;
  color: var(--text-primary, #0f172a) !important;
  border-color: var(--border, rgba(255,255,255,0.85)) !important;
}

/* Table rows on glossy */
html.glass table tbody tr {
  background-color: var(--bg-surface, rgba(255,255,255,0.76)) !important;
  color: var(--text-primary, #0f172a) !important;
}

html.glass table tbody tr:hover {
  background-color: var(--bg-elevated, rgba(255,255,255,0.92)) !important;
}

/* Modal/dialog dark overrides */
html.glass [class*="bg-slate-900"],
html.glass [class*="bg-gray-900"] {
  background: var(--bg-surface, rgba(255,255,255,0.76)) !important;
}

/* Badge & tag text */
html.glass [class*="bg-slate-800"] [class*="text-slate-"],
html.glass [class*="bg-gray-800"] [class*="text-gray-"] {
  color: var(--text-secondary, #334155) !important;
}

/* ===== Login form error feedback animations ===== */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-6px); }
  20%, 40%, 60%, 80% { transform: translateX(6px); }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-shake {
  animation: shake 0.5s ease-in-out;
}

.animate-fadeIn {
  animation: fadeIn 0.3s ease-out;
}

@media (prefers-reduced-motion: reduce) {
  .animate-shake,
  .animate-fadeIn {
    animation: none;
  }
}
</file>

<file path="moniteringteam/src/app/layout.tsx">
import type { Metadata } from "next";
import { Inter } from "next/font/google";
import "./globals.css";
import { ClientProviders } from "./ClientProviders";
import { supabase } from "@/lib/supabaseClient";

const inter = Inter({
  variable: "--font-inter",
  subsets: ["latin"],
});

export async function generateMetadata(): Promise<Metadata> {
  let siteName = "Gate Monitor";
  let description = "Student Gate Monitoring System";
  
  try {
    const { data } = await supabase
      .from('config_college_info')
      .select('name, short_name')
      .limit(1)
      .maybeSingle();

    if (data) {
      siteName = `${data.short_name} Gate Monitor`;
      description = `Student Gate Monitoring System — ${data.name}`;
    }
  } catch (err) {
    // silently fallback
  }

  return {
    title: siteName,
    description: description,
    icons: [{ rel: "icon", url: "/favicon.ico" }],
  };
}

export default function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
  return (
    <html lang="en" data-theme="dark" data-scroll-behavior="smooth" suppressHydrationWarning className={`${inter.variable} min-h-full antialiased dark`}>
      <body className="min-h-full flex flex-col bg-[var(--bg-base)] text-[var(--text-primary)] font-[var(--font-family)]">
        {/* Restore saved theme before first paint — supports dark, light, and glossy glass themes */}
        <script
          dangerouslySetInnerHTML={{
            __html: `try{var t=localStorage.getItem("gate-monitor-theme");if(t==="light"||t==="dark"||t==="glass"){document.documentElement.setAttribute("data-theme",t);document.documentElement.classList.remove("dark","light","glass");document.documentElement.classList.add(t);}else{document.documentElement.setAttribute("data-theme","dark");document.documentElement.classList.add("dark");localStorage.setItem("gate-monitor-theme","dark");}}catch(e){document.documentElement.setAttribute("data-theme","dark");document.documentElement.classList.add("dark");}`,
          }}
        />
        <ClientProviders>{children}</ClientProviders>
      </body>
    </html>
  );
}
</file>

