        hostel_block: isHostel ? (isMale ? (i % 2 === 0 ? 'Boys-A' : 'Boys-B') : (i % 2 === 0 ? 'Girls-A' : 'Girls-B')) : null,
        room_number: isHostel ? String(randInt(101, 420)) : null,
