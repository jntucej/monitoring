          {tab.icon}
          {tab.label}
          {activeTab === tab.id && (
            <span className="absolute bottom-0 left-0 right-0 h-0.5 bg-[var(--action-primary)] rounded-t-full" />
          )}
        </button>
      ))}
    </div>
  );
};

export { Tabs };
