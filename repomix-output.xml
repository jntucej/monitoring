  --action-primary: #10b981; /* High-contrast Emerald Green */
  --action-danger: #f43f5e;  /* Vivid Crimson Red */
  --action-warning: #f59e0b; /* Bright Amber */
  --action-info: #3b82f6;    /* Vibrant Royal Blue */
