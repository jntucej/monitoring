    extrapolateRight: "clamp",
  });
  const pulseOpacity = interpolate(frame % 90, [0, 45, 90], [0.6, 0.1, 0.6]);

  // Rotating specular holographic scanner arc
  const rotation = (frame * 2) % 360;

  // Grid line scan wave
  const scanLineY = interpolate(frame % 120, [0, 120], [0, 100]);

  const glowColor =
    status === "entry"
      ? "#10b981"
      : status === "exit"
      ? "#f43f5e"
      : status === "warning"
