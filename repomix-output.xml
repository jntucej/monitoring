            )}
            {title && (
              <div className="px-6 py-4 border-b border-[var(--border)]">
                <h2 className="text-xl font-semibold">{title}</h2>
              </div>
            )}
            <div className={cn("p-6", !title && "p-6")}>{children}</div>
          </motion.div>
        </motion.div>
      )}
