          <Button variant="secondary" size="sm" onClick={handleSyncNow} disabled={syncing} className="gap-1 text-xs">
            <RefreshCw className={`h-3.5 w-3.5 ${syncing ? "animate-spin" : ""}`} />
            {syncing ? "Syncing..." : "Sync Roster Now"}
