        </div>
      </div>
    );
  }

  const studentStats = data?.personTypeBreakdown?.student || { total: 0, onCampus: 0, inToday: 0, outToday: 0 };
  const facultyStats = data?.personTypeBreakdown?.faculty || { total: 0, onCampus: 0, inToday: 0, outToday: 0 };
