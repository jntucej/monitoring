"use client";

import React from 'react';
import { Unit } from '@/types/cheatsheet';

export const UnitSection = ({ unit, globalCompactMode }: { unit: Unit; globalCompactMode: boolean }) => {
  return (
    <div id={unit.id} className="mb-12">
