}

/* Premium Focus Glow only in Glossy Mode */
/* ============================================================
   TYPOGRAPHY SYSTEM — Apple HIG Compliant
   ============================================================ */

/* Fluid text utilities */
.text-fluid-xs { font-size: var(--font-size-xs); }
.text-fluid-sm { font-size: var(--font-size-sm); }
.text-fluid-base { font-size: var(--font-size-base); }
.text-fluid-md { font-size: var(--font-size-md); }
.text-fluid-lg { font-size: var(--font-size-lg); }
.text-fluid-xl { font-size: var(--font-size-xl); }
.text-fluid-2xl { font-size: var(--font-size-2xl); }

/* Tracking utilities */
.tracking-tight { letter-spacing: -0.02em; }
.tracking-normal { letter-spacing: -0.01em; }
.tracking-wide { letter-spacing: 0.02em; }
.tracking-wider { letter-spacing: 0.05em; }

/* Line heights */
.leading-tight { line-height: 1.1; }
.leading-snug { line-height: 1.2; }
.leading-normal { line-height: 1.5; }

/* Glass‑specific text styles (for navigation only) */
