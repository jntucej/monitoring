{
    admin off
    log {
        output stdout
        format json
    }
}

# Behind Cloudflare Tunnel, edge TLS terminates at Cloudflare and traffic
# arrives here as plain HTTP — so no `tls` directive and no HSTS (which would
# force browsers into an HTTPS loop against a plain-HTTP origin).
:80 {
    log {
        output stdout
        format json
    }

    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy web:3000 {
        flush_interval -1
        header_up X-Forwarded-For {remote_host}
    }
}
