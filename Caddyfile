{
    admin off
    log {
        output stdout
        format json
    }
}

:80 {
    log {
        output stdout
        format json
    }

    header {
        X-Frame-Options        "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy        "strict-origin-when-cross-origin"
        Permissions-Policy     "camera=(self), microphone=(self), geolocation=(self)"
        # Strip attacker-supplied identity/forwarding headers
        -X-Client-IP
        -X-Forwarded-For
        -X-Real-IP
        -X-Auth-User
        -X-Auth-Timestamp
        -X-Auth-Signature
    }

    reverse_proxy web:3000 {
        flush_interval -1
        # Cloudflare always overwrites CF-Connecting-IP at the edge, so the
        # value here is the real client. Caddy is bound to 127.0.0.1:80, so
        # the only way in is through the tunnel — nobody can spoof it.
        header_up X-Client-IP {http.request.header.CF-Connecting-IP}
        header_up X-Real-IP   {http.request.header.CF-Connecting-IP}
        header_up X-Forwarded-Proto https
    }
}
