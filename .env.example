# ==============================================================================
# Gate Monitor — Self-Hosted Production / Development Environment Variables
# ==============================================================================
# IMPORTANT: Do NOT use the placeholder values below. Generate real secrets:
#   openssl rand -hex 32      (for JWT/encryption keys)
#   openssl rand -base64 24   (for passwords)
# validate-env.js will fail at startup if secrets are empty or placeholder.

# Node Environment
# NODE_ENV is intentionally NOT set here. Next.js owns it: `next dev` -> development,
# `next build`/`next start` -> production. Declaring it here overrides the build and
# breaks prerendering (see the "build" script in package.json).
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=
POSTGRES_DB=gate_monitor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PG_MAX_POOL_SIZE=20

# ------------------------------------------------------------------------------
# Redis Cache & Realtime Configuration
# ------------------------------------------------------------------------------
REDIS_URL=
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Authentication & JWT Secrets (Must be at least 32 characters long)
# Generate each with: openssl rand -hex 32
# ------------------------------------------------------------------------------
AUTH_JWT_SECRET=
MOBILE_TOKEN_SECRET=
QR_TOKEN_SECRET=
MFA_ENROLL_SECRET=
# AES-256-GCM key for encrypting TOTP secrets at rest (32 bytes hex).
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
# Explicit MFA posture: must be "true" or "false" in production (startup fails otherwise).
# Add to production .env: MFA_REQUIRED_FOR_ADMIN=false
MFA_REQUIRED_FOR_ADMIN=false

# Cron endpoint secret (used by auto-check.sh / external scheduler)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Telegram bot (required for bot_daemon.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Cloudflare Tunnel / Ingress (Optional)
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# Email Integration (Optional)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@campus-access.edu
EMAIL_FROM_NAME="Campus Access Management"
EMAIL_API_KEY=

# ------------------------------------------------------------------------------
# SMS Integration (Optional)
# ------------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_API_KEY=

# ------------------------------------------------------------------------------
# Document Uploads & Digital Signature Settings
# ------------------------------------------------------------------------------
# Defines the absolute path where signed documents and digital signature
# artifacts are stored. Used centrally by the permission workflow pipeline.
DOCUMENT_UPLOADS_ROOT=/var/lib/gate-monitor/uploads

# ------------------------------------------------------------------------------
# Biometric Device Configuration
# ------------------------------------------------------------------------------
# Connection settings for ZK/face/thumb scanners
BIOMETRIC_DEVICE_HOST=
BIOMETRIC_DEVICE_PORT=
BIOMETRIC_DEVICE_SERIAL=
BIOMETRIC_DEVICE_TCP_TIMEOUT_MS=3000
BIOMETRIC_DEVICE_TIMEZONE=Asia/Kolkata
BIOMETRIC_SOURCE_LABEL=zk-device
BIOMETRIC_BINARY_BLOCK_SIZE=1024
BIOMETRIC_BINARY_FILE_PATH=/var/lib/gate-monitor/biometric/
BIOMETRIC_TEXT_FILE_PATH=/var/lib/gate-monitor/biometric/text/

# Face matching threshold (0.0-1.0)
FACE_MATCH_THRESHOLD=0.6
# External face matching service URL (optional)
FACE_MATCH_URL=

# ------------------------------------------------------------------------------
# LDAP / Active Directory Integration (Optional)
# ------------------------------------------------------------------------------
LDAP_URL=
LDAP_HOST=
LDAP_BIND_DN=
LDAP_BASE_DN=ou=users,dc=campus,dc=edu
LDAP_ENABLE_MOCK=false

# ------------------------------------------------------------------------------
# SSO / OAuth Configuration (Optional)
# ------------------------------------------------------------------------------
SSO_CLIENT_SECRET=
RP_ID=campus-access.edu
RP_NAME="Campus Access Management"

# ------------------------------------------------------------------------------
# Supabase (if using managed Supabase instead of self-hosted Postgres)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# HRMS Integration (Optional)
# ------------------------------------------------------------------------------
HRMS_API_ENDPOINT=
HRMS_API_KEY=

# ------------------------------------------------------------------------------
# LMS Integration (Optional)
# ------------------------------------------------------------------------------
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_API_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIM=1536
RAG_LLM_API_KEY=
RAG_LLM_API_URL=
RAG_LLM_MODEL=
RAG_MIN_SCORE=0.7
RAG_TOP_K=5
RAG_TRANSLATE_MODEL=

# ------------------------------------------------------------------------------
# Monitoring & Observability (Optional)
# ------------------------------------------------------------------------------
MONITORING_PROM_URL=
MONITORING_LOKI_URL=
MONITORING_GRAFANA_URL=
NEXT_PUBLIC_MONITORING_GRAFANA_URL=
METRICS_SECRET=
METRICS_SCRAPE_TOKEN=
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Worker Configuration
# ------------------------------------------------------------------------------
WORKER_HEALTH_PORT=3001
ENABLE_SYNC_BRIDGE=false
SYNC_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# Retention Policies (days)
# ------------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=30
INTEGRATION_LOG_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# Feature Flags / Dev Options
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_WS_MOCK=false
NEXT_PUBLIC_ALLOW_MOCK_WS=false
NEXT_RUNTIME=nodejs
ENV_FILE=.env
EXIT_FLOW_FAIL_OPEN=false
ALLOW_FAKE_DEVICE_LOGS=false
USE_FAKE_DEVICE_LOGS=false
USE_TCP=true
SCAN_SIGNING_SECRET=
SEED_DEFAULT_PIN=123456
SYSADMIN_SEED_PASSWORD=
SYSADMIN_SEED_PIN=
SKIP_ENV_VALIDATION=0
SCRAPER_IPS=
ADMIN_JWT=
AUTH_JWT_SECRETS=
ALLOWED_ORIGINS=
APP_URL=
MOBILE_LOGIN_ENABLED=false
