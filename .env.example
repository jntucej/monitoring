# ==============================================================================
# Gate Monitor — Self-Hosted Production / Development Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGIN=*

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres_secure_password@postgres:5432/gate_monitor
POSTGRES_DB=gate_monitor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PG_MAX_POOL_SIZE=20

# ------------------------------------------------------------------------------
# Redis Cache & Realtime Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://:redis_secure_password@redis:6379
REDIS_PASSWORD=redis_secure_password

# ------------------------------------------------------------------------------
# Authentication & JWT Secrets (Must be at least 32 characters long)
# ------------------------------------------------------------------------------
AUTH_JWT_SECRET=change_me_to_a_secure_random_32_character_string_minimum
MOBILE_TOKEN_SECRET=change_me_to_a_secure_random_32_character_string_minimum
QR_TOKEN_SECRET=change_me_to_a_secure_random_32_character_string_minimum
MFA_ENROLL_SECRET=change_me_to_a_secure_random_32_character_string_minimum

# ------------------------------------------------------------------------------
# Cloudflare Tunnel / Ingress (Optional)
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ------------------------------------------------------------------------------
# Email Integration (Optional)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@campus-access.edu
EMAIL_FROM_NAME="Campus Access Management"
EMAIL_API_KEY=

# ------------------------------------------------------------------------------
# SMS Integration (Optional)
# ------------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_API_KEY=
