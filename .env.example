# Cron endpoint secret (REQUIRED — worker refuses to start without it).
# Used by worker/index.mjs to POST /api/cron/*. Generate with:
#   openssl rand -hex 32
# docker-compose uses ${CRON_SECRET:?...} on the worker service, so a missing
# value aborts the whole compose up. Do not leave this blank in prod.
CRON_SECRET=

# ── Kiosk session auth ──────────────────────────────────────────────────────
# The kiosk session route (POST/GET /api/operator/kiosk-session) mints an
# OPERATOR token without a login, so in production it REFUSES open mode
# (426 KIOSK_OPEN_REFUSED) unless exactly one of the two is set. Set ONE:
#   TRUSTED_KIOSK_IPS=10.0.0.5,10.0.0.6   # allowlist the kiosk box(es)
# OR
#   KIOSK_SESSION_REQUIRE_PIN=true        # kiosk collects the operator PIN
# If both are unset in production the kiosk is unusable by design.
# TRUSTED_KIOSK_IPS=
# KIOSK_SESSION_REQUIRE_PIN=

# ── Postgres connection pool ────────────────────────────────────────────────
# Production connection:
#   DATABASE_URL=postgres://gate_app:***@postgres:5432/gate_monitor
# JWT and Tokens:
#   JWT_SECRET=
#   AUTH_JWT_SECRET=
#   QR_TOKEN_SECRET=
#   MOBILE_TOKEN_SECRET=
#
# In production set POSTGRES_USER=gate_app (the NOBYPASSRLS role) so RLS is
# actually enforced. The DATABASE_URL in docker-compose.yml connects as
# gate_app; rotate its password via scripts/rotate-db-creds.sh before going live.
POSTGRES_USER=gate_app
POSTGRES_PASSWORD=  # openssl rand -hex 24
# Dedicated gate_app credential. Falls back to POSTGRES_PASSWORD when unset.
# Set + rotate for production via scripts/rotate-db-creds.sh (preferred), which
# writes GATE_APP_PASSWORD back here. The app DSN uses gate_app:GATE_APP_PASSWORD.
GATE_APP_PASSWORD=
POSTGRES_DB=gate_monitor
#
# src/lib/postgres.ts reads PG_MAX_POOL_SIZE (default 20). Raise for
# multi-gate / multi-operator deployments (see capacity table in the
# operator-flow review): 50 concurrent operators -> 30, 200+ -> 50 + pgbouncer.
# Must stay below postgres max_connections (default 100).
# PG_MAX_POOL_SIZE=20
# PG_SSL=false

# ── SMS sending (MSG91 primary / Twilio fallback) ────────────────────────────
# India requires TRAI DLT registration (entity → sender ID → template) before
# SMS delivers to Indian numbers. Register at https://www.vilpower.in/ first.
#
# Primary: MSG91 (India-native, DLT-compliant, ~₹0.20/SMS)
#   MSG91_AUTH_KEY=                  — from the MSG91 dashboard
#   MSG91_WEBHOOK_SECRET=            — set in MSG91 → Settings → Webhooks
#                                     (sent as the 'X-MSG91-Secret' header)
#
# Fallback: Twilio (international numbers / NRI parents, ~₹1.50/SMS)
#   TWILIO_ACCOUNT_SID=
#   TWILIO_AUTH_TOKEN=
#   TWILIO_FROM_NUMBER=+15551234567  — your Twilio phone number
#
# Campus security line (used in the emergency_sos template)
#   CAMPUS_SECURITY_PHONE=910000000000
#
# Existing Twilio-only vars (SMS_ENABLED, SMS_PROVIDER, SMS_ACCOUNT_SID,
# SMS_AUTH_TOKEN, SMS_FROM) still work as the fallback path. The new
# MSG91_AUTH_KEY / TWILIO_ACCOUNT_SID vars are the canonical ones.
#
MSG91_AUTH_KEY=
MSG91_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CAMPUS_SECURITY_PHONE=

# ── Notification dispatch (email / SMS) ─────────────────────────────────────
# Worker email transport (worker/jobs/send_emails.js, Brevo SMTP via nodemailer):
#   BREVO_SMTP_LOGIN / BREVO_SMTP_KEY — SMTP credentials (key acts as password)
#   BREVO_SMTP_HOST / BREVO_SMTP_PORT — override the Brevo relay defaults
#   BREVO_SMTP_FROM                   — From address (default noreply@ucej.in)
#
# Worker SMS transport (worker/jobs/dispatch_notifications.js, Twilio REST):
#   SMS_ENABLED=true                  — switch that actually starts delivering
#   SMS_PROVIDER                      — provider name (default 'twilio')
#   SMS_ACCOUNT_SID / TWILIO_ACCOUNT_SID
#   SMS_AUTH_TOKEN / TWILIO_AUTH_TOKEN / SMS_API_SECRET
#   SMS_FROM                          — sender number, e.g. +91…
# Leave blank in dev; the worker logs loudly and leaves rows pending when
# credentials are incomplete, and only marks SMS 'delivered' on a real send.
#   BREVO_SMTP_LOGIN=
#   BREVO_SMTP_KEY=
#   BREVO_SMTP_HOST=
#   BREVO_SMTP_PORT=587
#   BREVO_SMTP_FROM=
#   SMS_ENABLED=false
#   SMS_PROVIDER=twilio
#   SMS_ACCOUNT_SID=
#   SMS_AUTH_TOKEN=
#   SMS_FROM=
#
# Push notifications: no transport is wired yet. The worker drains
# notification_push_queue as a visible no-op (rows stay 'pending', batch is
# logged) — configure a web-push SDK (VAPID + service worker) before push
# items can be marked delivered.
#
# Alerting outbound delivery (src/lib/alerting.ts):
#   ALERT_WEBHOOK_URL — generic webhook POST target for the 'webhook' alert channel
#   ALERT_EMAIL_TO    — recipient for the 'email' alert channel (falls back to BREVO_SMTP_LOGIN)
#   opsgenie / pagerduty channels remain documented no-ops (no SDK in package.json);
#   alerts are still persisted to the `alerts` table either way.
#   ALERT_WEBHOOK_URL=
#   ALERT_EMAIL_TO=
#
# ── Metrics scrape token ────────────────────────────────────────────────────
# GET /metrics requires `Authorization: Bearer <METRICS_SCRAPE_TOKEN>`; if
# unset, the endpoint returns 401 and Prometheus scrapes fail. Generate:
#   openssl rand -hex 32
# METRICS_SCRAPE_TOKEN=

# Anti-ragging reporter hash key (HMAC-SHA256). Regenerate: openssl rand -hex 32
ANTI_RAGGING_HASH_SECRET=
