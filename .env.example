# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Mobile/Auth Security
MOBILE_TOKEN_SECRET=your_jwt_secret_key

# Seeded account bootstrap PIN (used by scripts/seed-data.js)
# Every seeded account gets this PIN — rotate all system accounts before production!
SEED_DEFAULT_PIN=

# Credentials for test/debug scripts and Playwright E2E specs
# (values are intentionally NOT committed; set real ones in .env.local)
TEST_OPERATOR_ID=OP-001
TEST_OPERATOR_PIN=

# SMS Provider Configuration
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# Email Provider Configuration
EMAIL_ENABLED=false
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
