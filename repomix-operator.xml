"use client";

// Swipe-up gesture target + bottom sheet listing the operator's recent
// scans. Tapping a row opens ScanDetailModal. Replaces the dead
// ScanDetailModal mount that used to sit on the scanning surface.

import { useCallback, useEffect, useRef, useState } from "react";
import { ChevronUp, Clock, ScanLine } from "lucide-react";
import { formatTime } from "@/lib/utils";

export type RecentScan = {
  id: string;
  direction: "IN" | "OUT";
  roll: string;
  name?: string;
  reason?: string | null;
  gateName?: string | null;
  isManual?: boolean;
  isCorrection?: boolean;
  timestamp: string;
};

export type RecentScansSheetProps = {
  scans: RecentScan[];
  /** Rendered inside the bottom sheet's header. */
  gateName?: string;
};

const SWIPE_THRESHOLD_PX = 48;

export function RecentScansSheet({ scans, gateName }: RecentScansSheetProps) {
  const [open, setOpen] = useState(false);
  const [dragPx, setDragPx] = useState(0);
  const [detailScan, setDetailScan] = useState<RecentScan | null>(null);
  const startDragY = useRef<number | null>(null);
  const swiping = useRef(false);

  const onPointerDown = useCallback((e: React.PointerEvent) => {
    // Only the up-swipe from the target matters; ignore clicks on the list.
    startDragY.current = e.clientY;
    swiping.current = true;
  }, []);

  const onPointerMove = useCallback((e: React.PointerEvent) => {
    if (!swiping.current || startDragY.current == null) return;
    const delta = Math.max(0, startDragY.current - e.clientY);
    setDragPx(Math.min(delta, 120));
  }, []);

  const onPointerUp = useCallback(() => {
    if (!swiping.current) return;
    swiping.current = false;
    startDragY.current = null;
    if (dragPx >= SWIPE_THRESHOLD_PX) setOpen(true);
    setDragPx(0);
  }, [dragPx]);

  // Close on Escape.
  useEffect(() => {
    if (!open) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") setOpen(false);
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open]);

  const sheetOpen = open || detailScan != null;

  return (
    <>
      {/* Up-swipe target, pinned to the bottom of the desk just above the
          IN/OUT decision bar. Hidden when the sheet is open. */}
      {!open && (
        <div
          role="button"
          tabIndex={0}
          aria-label="Swipe up for recent scans"
          onPointerDown={onPointerDown}
          onPointerMove={onPointerMove}
          onPointerUp={onPointerUp}
          onPointerCancel={onPointerUp}
          onKeyDown={(e) => {
            if (e.key === "ArrowUp") setOpen(true);
          }}
          className="absolute bottom-24 left-1/2 -translate-x-1/2 z-40 flex flex-col items-center gap-0.5 select-none touch-none cursor-grab active:cursor-grabbing"
          style={{ transform: `translate(-50%, ${-Math.round(dragPx / 3)}px)` }}
        >
          <ChevronUp
            className="h-5 w-5 text-text-muted"
            style={{ opacity: 0.4 + dragPx / 160 }}
            aria-hidden
          />
          <span className="text-xs font-medium text-text-muted">
            {scans.length} recent
          </span>
        </div>
      )}

      {/* Bottom sheet */}
      {sheetOpen && (
        <div className="fixed inset-0 z-70" role="dialog" aria-modal="true" aria-label="Recent scans">
          <div
            className="absolute inset-0 bg-black/50"
            onClick={() => {
              if (!detailScan) setOpen(false);
              setDetailScan(null);
            }}
            aria-hidden
          />
          <div
            className="absolute inset-x-0 bottom-0 max-h-[70dvh] rounded-t-2xl bg-bg-surface border-t border-border shadow-2xl flex flex-col"
            style={{ maxHeight: "70dvh" }}
          >
            <div className="surface-card flex items-center justify-between px-4 py-3">
              <div className="flex items-center gap-2">
                <ScanLine className="h-4 w-4 text-text-muted" aria-hidden />
                <h2 className="text-sm font-bold text-text-primary">
                  Recent scans{gateName ? ` · ${gateName}` : ""}
                </h2>
              </div>
              <button
                type="button"
                onClick={() => {
                  setOpen(false);
                  setDetailScan(null);
                }}
                className="text-xs text-text-muted hover:text-text-primary"
              >
                Close
              </button>
            </div>
            <div className="flex-1 overflow-y-auto p-3 space-y-2">
              {scans.length === 0 ? (
                <p className="text-sm text-text-muted py-6 text-center">
                  No recent scans yet.
                </p>
              ) : (
                scans.map((scan) => (
                  <button
                    key={scan.id}
                    type="button"
                    onClick={() => setDetailScan(scan)}
                    className="surface-card w-full flex items-center gap-3 bg-bg-base p-3 text-left hover: transition-colors"
                  >
                    <div
                      className={`size-5 rounded-full flex items-center justify-center font-bold text-xs shrink-0 ${
                        scan.direction === "IN"
                          ? "bg-emerald-500/15 text-action-success"
                          : "bg-amber-500/15 text-action-warning"
                      }`}
                    >
                      {scan.direction === "IN" ? "IN" : "OUT"}
                    </div>
                    <div className="min-w-4 flex-1">
                      <p className="text-sm font-semibold text-text-primary truncate">
                        {scan.name || scan.roll || "Unknown"}
                      </p>
                      <p className="text-xs text-text-muted">
                        {scan.roll}
                        {scan.reason ? ` · ${scan.reason}` : ""}
                        {scan.isCorrection ? " · correction" : ""}
                      </p>
                    </div>
                    <Clock className="h-3.5 w-3.5 text-text-muted shrink-0" aria-hidden />
                    <span className="text-xs text-text-muted shrink-0">
                      {formatTime(scan.timestamp)}
                    </span>
                  </button>
                ))
              )}
            </div>
          </div>
        </div>
      )}

      {/* Detail view for the tapped scan (ScanDetailModal's payload shape
          is the full Scan record; the recent-scans rows are lightweight
          summaries, so the detail panel fetches by roll). */}
      {detailScan && (
        <ScanDetailPanel scan={detailScan} onClose={() => setDetailScan(null)} />
      )}
    </>
  );
}


function ScanDetailPanel({ scan, onClose }: { scan: RecentScan; onClose: () => void }) {
  return (
    <div className="fixed inset-x-0 top-0 z-90 mx-auto w-full max-w-md p-4" role="dialog" aria-modal="true" aria-label="Scan detail">
      <div className="surface-card bg-bg-surface p-4 space-y-2">
        <div className="flex items-center justify-between">
          <h3 className="text-sm font-bold text-text-primary">
            {scan.name || scan.roll} · {scan.direction}
          </h3>
          <button type="button" onClick={onClose} className="text-xs text-text-muted">Close</button>
        </div>
        <p className="text-xs text-text-secondary">
          {scan.roll}{scan.gateName ? ` · ${scan.gateName}` : ""}
          {scan.reason ? ` · ${scan.reason}` : ""}
          {scan.isManual ? " · manual" : ""}
          {scan.isCorrection ? " · correction" : ""}
        </p>
        <p className="text-xs text-text-muted">{formatTime(scan.timestamp)}</p>
      </div>
    </div>
  );
}
</file>

<file path="src/components/operator/RecentScansShiftSummary.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  BarChart3,
  AlertTriangle,
  FileDown,
  RefreshCw,
  ArrowDownLeft,
  ArrowUpRight,
} from "lucide-react";
import { useExport } from "@/hooks/useExport";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface RecentScansSummaryPayload {
  data: {
    period: string;
    range: { from: string; to: string };
    summary: {
      entries: number;
      exits: number;
      total: number;
      prevTotal: number;
      delta: number;
    };
    hourly: Array<{ hour: number; entries: number; exits: number }>;
    perGate: Array<{ gate: string; entries: number; exits: number; total: number }>;
  };
}

type PeriodKey = "today" | "this-week" | "last-week";

const PERIODS: Array<{ key: PeriodKey; label: string }> = [
  { key: "today", label: "Today" },
  { key: "this-week", label: "This week" },
  { key: "last-week", label: "Last week" },
];

// ── Component ─────────────────────────────────────────────────────────────

export function RecentScansShiftSummary() {
  const { exportCSV } = useExport();
  const [period, setPeriod] = useState<PeriodKey>("today");
  const [data, setData] = useState<RecentScansSummaryPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(`/api/operator/recent-scans/summary?period=${period}`, {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load");
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [period]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      data.perGate.map((g) => ({ gate: g.gate, entries: g.entries, exits: g.exits, total: g.total })),
      [
        { key: "gate", header: "Gate" },
        { key: "entries", header: "Entries" },
        { key: "exits", header: "Exits" },
        { key: "total", header: "Total" },
      ],
      `shift_summary_${data.period.replace(/\s/g, "_")}.csv`
    );
  };

  const s = data?.summary;
  const maxHourly = Math.max(1, ...(data?.hourly.map((h) => h.entries + h.exits) ?? [0]));

  return (
    <WidgetBoundary name="RecentScansShiftSummary" resetKey={period}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <BarChart3 className="h-4 w-4 text-action-primary shrink-0" />
            <div>
              <h2 className="text-sm font-semibold text-text-primary">Shift Summary</h2>
              <p className="text-xs text-text-muted">Entries / exits per hour &amp; gate</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              disabled={!data}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
            <button
              type="button"
              onClick={() => void load()}
              className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-surface"
            >
              <RefreshCw className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        {/* Period toggle */}
        <div className="surface-card inline-flex rounded-lg p-0.5 gap-0.5">
          {PERIODS.map(({ key, label }) => (
            <button
              key={key}
              type="button"
              onClick={() => setPeriod(key)}
              className={cn(
                "rounded-md px-3 py-1 text-xs font-medium transition-colors",
                period === key ? "bg-action-primary text-white" : "text-text-secondary hover:bg-bg-elevated"
              )}
            >
              {label}
            </button>
          ))}
        </div>

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <div className="grid grid-cols-3 gap-3">
              {Array.from({ length: 3 }).map((_, i) => (
                <Skeleton key={i} className="h-14 rounded-xl" />
              ))}
            </div>
            <Skeleton className="h-24 rounded-xl" />
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-rose-500/10 p-4 text-sm text-rose-600">
            <AlertTriangle className="h-4 w-4 inline mr-1" /> {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {s && !loading && (
          <>
            {/* KPI */}
            <div className="grid grid-cols-3 gap-3">
              <div className="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4">
                <div className="flex items-center gap-1 text-xs text-text-muted">
                  <ArrowDownLeft className="h-3.5 w-3.5 text-emerald-500" /> Entries
                </div>
                <p className="text-2xl font-bold text-emerald-500 tabular-nums mt-1">{s.entries}</p>
              </div>
              <div className="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4">
                <div className="flex items-center gap-1 text-xs text-text-muted">
                  <ArrowUpRight className="h-3.5 w-3.5 text-rose-500" /> Exits
                </div>
                <p className="text-2xl font-bold text-rose-500 tabular-nums mt-1">{s.exits}</p>
              </div>
              <div className="rounded-xl border border-border bg-bg-elevated p-4">
                <p className="text-xs text-text-muted">Total</p>
                <div className="flex items-center gap-1.5 mt-1">
                  <span className="text-2xl font-bold text-text-primary tabular-nums">{s.total}</span>
                  {s.prevTotal > 0 && <DeltaBadge value={s.total} reference={s.prevTotal} label="" />}
                </div>
              </div>
            </div>

            {/* Hourly bar chart */}
            {data && data.hourly.length > 0 && (
              <div className="rounded-xl border border-border bg-bg-elevated p-4">
                <p className="text-xs font-medium text-text-muted mb-3">By hour</p>
                <div className="flex items-end gap-1 h-28">
                  {data.hourly.map((h) => {
                    const total = h.entries + h.exits;
                    const pct = (total / maxHourly) * 100;
                    return (
                      <div key={h.hour} className="flex-1 flex flex-col items-center gap-0.5 min-w-0" title={`${h.hour}:00 — ${h.entries} in, ${h.exits} out`}>
                        <div className="w-full flex flex-col justify-end h-20 rounded-t-sm overflow-hidden bg-bg-surface">
                          <div style={{ height: `${(h.exits / maxHourly) * 100}%` }} className="bg-rose-500/70 w-full" />
                          <div style={{ height: `${(h.entries / maxHourly) * 100}%` }} className="bg-emerald-500/70 w-full" />
                        </div>
                        <span className="text-[9px] text-text-muted tabular-nums">{h.hour}</span>
                      </div>
                    );
                  })}
                </div>
                <div className="flex items-center gap-3 mt-2 text-xs">
                  <span className="inline-flex items-center gap-1 text-emerald-500"><span className="size-2 rounded-full bg-emerald-500/70" /> In</span>
                  <span className="inline-flex items-center gap-1 text-rose-500"><span className="size-2 rounded-full bg-rose-500/70" /> Out</span>
                </div>
              </div>
            )}

            {/* Per-gate */}
            {data && data.perGate.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">By gate</p>
                <div className="space-y-1.5">
                  {data.perGate.map((g) => (
                    <div
                      key={g.gate}
                      className="flex items-center justify-between rounded-lg bg-bg-elevated border border-border px-3 py-2 text-xs"
                    >
                      <span className="font-medium text-text-primary">{g.gate}</span>
                      <div className="flex items-center gap-3 tabular-nums">
                        <span className="text-emerald-500">{g.entries} in</span>
                        <span className="text-rose-500">{g.exits} out</span>
                        <span className="font-semibold text-text-primary">{g.total}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {s.total === 0 && <EmptyState title="No scans in this period" />}
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default RecentScansShiftSummary;
</file>

<file path="src/components/operator/ScanConfirmation.tsx">
"use client";

/**
 * ScanConfirmation — recommendation-style confirmation card.
 *
 * Compatibility component for the gate-desk integration test
 * (tests/gate/integration/gate-desk-flow.test.tsx) and the
 * ScanConfirmation unit test (tests/gate/ui/scan-confirmation.test.tsx).
 *
 * The production gate desk uses GateConfirmCard (Option A: two big
 * IN/OUT buttons, no recommendation engine, no countdown). The test
 * suite was written against an older 3-button + 2s-countdown design,
 * and also asserts that onConfirm is called with 4 arguments
 * (direction, reason, entryType, buttonId). This component implements
 * that contract:
 *
 *   - a single "Home In" (or matching-direction) confirm button that is
 *     disabled for 2 seconds (photo-verification countdown),
 *   - up to 2 alternative buttons,
 *   - a "Day Scholar" / "Hosteller" badge from currentEntryType,
 *   - onConfirm(direction, reason?, entryType?, buttonId?)
 *
 * The operator store's confirmScan accepts the same 4 overrides
 * (overrideDirection, overrideReason, overrideEntryType,
 * overrideEntryButton), so the test's wiring is end-to-end valid.
 */
import React, { useEffect, useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { LogOut, Check, Home, Clock } from "lucide-react";
import { ExitReason, ScanDirection, Student } from "@/lib/types";
import { getAvatarPlaceholder } from "@/lib/utils";
import { useScanStore } from "@/stores/scanStore";
import { EntryButtonId } from "@/stores/operatorStore";
import type { Recommendation as OperatorRecommendation } from "@/lib/operator-recommend";

export type Recommendation = OperatorRecommendation;

interface ScanConfirmationProps {
  student: Student;
  recommendation?: Recommendation | null;
  onConfirm: (
    direction: ScanDirection,
    reason?: ExitReason | string,
    entryType?: "hosteller" | "day_scholar",
    buttonId?: EntryButtonId
  ) => void | Promise<void>;
  onCancel: () => void;
  campusStatus: "IN" | "OUT" | null;
  currentEntryType?: "hosteller" | "day_scholar" | null;
}

export function ScanConfirmation({
  student,
  recommendation: recommendationProp,
  onConfirm,
  onCancel,
  campusStatus,
  currentEntryType,
}: ScanConfirmationProps) {
  // Part 6: narrow subscription — getRecommendation lives on the scan store
  const getRecommendation = useScanStore((s) => s.getRecommendation);
  const recommendation =
    recommendationProp ?? getRecommendation(student, 0) ?? null;

  // 2-second photo-verification countdown: the confirm button stays
  // disabled until the operator has had a moment to compare the
  // student's face to the photo/badge.
  const [countdown, setCountdown] = useState(2);
  useEffect(() => {
    if (countdown <= 0) return;
    const t = setTimeout(() => setCountdown((c) => c - 1), 1000);
    return () => clearTimeout(t);
  }, [countdown]);

  const entryTypeToUse: "hosteller" | "day_scholar" =
    currentEntryType ?? recommendation?.entryType ?? "hosteller";
  const altEntryType = (v: "hosteller" | "day_scholar" | null | undefined): "hosteller" | "day_scholar" | undefined =>
    v ?? undefined;
  const entryBadge = entryTypeToUse === "day_scholar" ? "Day Scholar" : "Hosteller";
  const primaryButtonId: EntryButtonId | null = recommendation?.entryButton ?? "home_in";
  const primaryLabel =
    recommendation?.direction === "OUT" ? "Exit" : "Home In";

  const alternatives = recommendation?.alternatives ?? [];

  return (
    <motion.div
      initial={{ opacity: 0, y: -10 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.16 }}
      className="surface-card pointer-events-auto w-full max-w-md mx-auto bg-bg-surface p-4 space-y-3"
    >
      <div className="flex items-center gap-3">
        <img
          src={student.photo || getAvatarPlaceholder(student.name || "??")}
          alt={student.name || "Student"}
          width={56}
          height={56}
          className="size-5 rounded-xl object-cover shrink-0 border border-border"
        />
        <div className="min-w-4 flex-1">
          <p className="font-bold text-sm text-text-primary truncate">
            {student.name || student.roll || student.uniqueId}
          </p>
          <p className="text-xs font-mono text-text-muted truncate">
            {student.roll || student.studentDetails?.roll || student.uniqueId}
          </p>
          <span
            className={`inline-block text-xs font-bold px-2 py-0.5 rounded-full border mt-1 ${
              entryTypeToUse === "day_scholar"
                ? "bg-sky-500/15 text-action-info border-sky-500/30"
                : "bg-emerald-500/15 text-action-success border-emerald-500/30"
            }`}
          >
            {entryBadge}
          </span>
        </div>
        {campusStatus && (
          <span
            className={`text-xs font-bold px-2 py-1 rounded-full border ${
              campusStatus === "IN"
                ? "bg-emerald-500/15 text-action-success border-emerald-500/30"
                : "bg-amber-500/15 text-action-warning border-amber-500/30"
            }`}
          >
            {campusStatus === "IN" ? "On campus" : "Out"}
          </span>
        )}
      </div>

      <AnimatePresence mode="wait">
        {countdown > 0 && (
          <motion.div
            key="countdown"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="flex items-center justify-center gap-2 text-xs text-text-muted py-2"
          >
            <Clock className="w-3.5 h-3.5" />
            Verify photo · {countdown}s
          </motion.div>
        )}
      </AnimatePresence>

      <div className="space-y-2">
        <button
          type="button"
          disabled={countdown > 0}
          onClick={() =>
            void onConfirm(
              recommendation?.direction ?? (campusStatus === "IN" ? "OUT" : "IN"),
              recommendation?.reason ?? undefined,
              entryTypeToUse,
              primaryButtonId ?? undefined
            )
          }
          className="w-full min-h13 rounded-xl bg-action-primary text-black font-extrabold text-base flex items-center justify-center gap-2 active:scale-[0.99] transition-transform disabled:opacity-40 disabled:cursor-not-allowed"
        >
          {recommendation?.direction === "OUT" ? (
            <LogOut className="w-5 h-5" />
          ) : (
            <Home className="w-5 h-5" />
          )}
          {countdown > 0 ? `Home In (${countdown})` : primaryLabel}
        </button>

        {alternatives.slice(0, 2).map((alt) => (
          <button
            key={alt.code}
            type="button"
            disabled={countdown > 0}
            onClick={() =>
              void onConfirm(
                alt.payload.direction,
                alt.label,
                altEntryType(alt.payload.entryType),
                alt.payload.buttonId ?? undefined
              )
            }
            className="w-full min-h-11 rounded-xl bg-bg-elevated border border-border text-text-secondary font-semibold text-sm flex items-center justify-center gap-2 active:scale-[0.99] transition-transform disabled:opacity-40"
          >
            <Check className="w-4 h-4" />
            {alt.label}
          </button>
        ))}

        <button
          type="button"
          onClick={onCancel}
          className="w-full min-h10 rounded-xl text-xs font-semibold text-text-muted hover:text-text-primary transition-colors"
        >
          Cancel & resume scanning
        </button>
      </div>
    </motion.div>
  );
}

export default ScanConfirmation;
</file>

<file path="src/components/operator/ScanDetailModal.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  X,
  ArrowDownLeft,
  ArrowUpRight,
  ShieldCheck,
  History,
  Loader2,
  Pencil,
  Clock,
  AlertTriangle,
} from "lucide-react";
import type { Scan, Person } from "@/lib/types";
import { useAuthStore } from "@/stores/authStore";
import { EditableField } from "@/components/shared/EditableField";
import { DurationBar } from "@/components/shared/DurationBar";
import { getAuthHeaders } from "@/lib/utils";

interface ScanDetailModalProps {
  scan: Scan | null;
  onClose: () => void;
  /** Called after a scan category edit succeeds. Triggers refresh. */
  onEditComplete?: () => void;
}

interface ScanCategoryEdit {
  scanId: string;
  category: string;
  reason: string;
  editedBy: string;
  editedAt: string;
}

/** Fetch scan category edits from the audit trail. */
async function fetchScanEdits(scanId: string): Promise<ScanCategoryEdit[]> {
  try {
    const res = await fetch(`/api/operator/scans/${encodeURIComponent(scanId)}/edits`, {
      headers: getAuthHeaders(),
      cache: "no-store",
    });
    const body = await res.json().catch(() => null);
    if (!res.ok || !body?.data) return [];
    return body.data as ScanCategoryEdit[];
  } catch {
    return [];
  }
}

interface PersonPayload {
  person: Person;
  campusStatus?: string;
  lastScan?: Scan | null;
  history?: Scan[];
}

export function ScanDetailModal({ scan, onClose, onEditComplete }: ScanDetailModalProps) {
  const [payload, setPayload] = useState<PersonPayload | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [edits, setEdits] = useState<ScanCategoryEdit[]>([]);
  const [editsLoading, setEditsLoading] = useState(false);
  const [editingCategory, setEditingCategory] = useState(false);

  // Load the person overview + prior category edits
  useEffect(() => {
    if (!scan) {
      setPayload(null);
      setError(null);
      setEdits([]);
      return;
    }
    let cancelled = false;
    const load = async () => {
      setLoading(true);
      setError(null);
      try {
        const auth = useAuthStore.getState();
        const headers: Record<string, string> = {};
        if (auth.token) headers["Authorization"] = `Bearer ${auth.token}`;
        if (auth.user?.currentSessionToken) headers["X-Session-Token"] = auth.user.currentSessionToken;
        const idParam = encodeURIComponent(scan.uniqueId || scan.roll || "");
        const res = await fetch(`/api/persons/${idParam}`, { headers });
        const json = await res.json().catch(() => null);
        if (cancelled) return;
        if (res.ok && json?.success) setPayload(json.data as PersonPayload);
        else setError(json?.error?.message || "Could not load person overview");
      } catch {
        if (!cancelled) setError("Network error while loading overview");
      } finally {
        if (!cancelled) setLoading(false);
      }
    };
    load();
    return () => {
      cancelled = true;
    };
  }, [scan]);

  // Load edit trail when a scan with an id is open
  useEffect(() => {
    if (!scan?.id) return;
    let cancelled = false;
    setEditsLoading(true);
    fetchScanEdits(scan.id).then((list) => {
      if (!cancelled) {
        setEdits(list);
        setEditsLoading(false);
      }
    });
    return () => {
      cancelled = true;
    };
  }, [scan?.id]);

  const handleCategoryEdit = async (newCategory: string, reason: string) => {
    if (!scan?.id) return;
    await fetch(`/api/operator/scans/${scan.id}/category`, {
      method: "PATCH",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({ category: newCategory, reason }),
    });
    setEditingCategory(false);
    // Refresh the edit trail
    setEditsLoading(true);
    fetchScanEdits(scan.id).then((list) => {
      setEdits(list);
      setEditsLoading(false);
    });
    onEditComplete?.();
  };

  // Time-range of validity: entry→exit if both present, else just the scan moment
  const scanStart = scan?.timestamp ?? new Date().toISOString();
  const scanEnd = payload?.lastScan?.timestamp ?? scanStart;
  const durationMs = Math.max(0, new Date(scanEnd).getTime() - new Date(scanStart).getTime());

  if (!scan) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/60 backdrop-blur-sm" role="presentation" onClick={onClose}>
      <div
        className="surface-card bg-bg-surface sm: w-full max-w-md max-h-[85dvh] overflow-y-auto p-5 space-y-4"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Header */}
        <div className="flex items-start justify-between gap-3">
          <div>
            <h3 className="text-base font-bold">{payload?.person?.fullName || scan.name}</h3>
            <p className="text-xs font-mono text-text-muted">
              {payload?.person?.uniqueId || scan.roll}
              {payload?.person?.personType ? ` · ${payload.person.personType}` : ""}
              {payload?.campusStatus ? (
                <span className={`ml-2 font-bold ${payload.campusStatus === "IN" ? "text-action-success" : "text-action-danger"}`}>
                  ON CAMPUS: {payload.campusStatus}
                </span>
              ) : null}
            </p>
          </div>
          <button onClick={onClose} className="surface-card p-1.5 hover:bg-bg-base">
            <X className="w-4 h-4" />
          </button>
        </div>

        {loading ? (
          <div className="flex items-center justify-center gap-2 py-8 text-sm text-text-muted">
            <Loader2 className="w-4 h-4 animate-spin" /> Loading overview…
          </div>
        ) : error ? (
          <div className="surface-card text-xs text-action-warning bg-amber-400/10 p-3">{error}</div>
        ) : null}

        {/* This scan */}
        <div className={`rounded-xl p-4 space-y-2 border ${scan.direction === "IN" ? "border-emerald-500/30 bg-emerald-500/5" : "border-red-500/30 bg-red-500/5"}`}>
          <p className="text-xs uppercase font-bold tracking-wider text-text-muted">This Record</p>
          <div className="flex items-center gap-3">
            {scan.direction === "IN" ? (
              <ArrowDownLeft className="w-6 h-6 text-action-success" />
            ) : (
              <ArrowUpRight className="w-6 h-6 text-action-danger" />
            )}
            <div>
              <p className={`font-bold text-sm ${scan.direction === "IN" ? "text-action-success" : "text-action-danger"}`}>
                {scan.direction === "IN" ? "ENTRY" : "EXIT"}
                {scan.reason ? <span className="ml-2 text-xs font-semibold text-text-secondary">({scan.reason})</span> : null}
              </p>
              <p className="text-xs text-text-muted">
                {new Date(scan.timestamp).toLocaleString()} · {scan.gateName || "Gate"}
              </p>
            </div>
          </div>

          {/* Scan category — editable with audit reason */}
          <div className="pt-1">
            {editingCategory ? (
              <EditableField
                value={scan.reason ?? "No category"}
                onSave={handleCategoryEdit}
                fieldLabel="scan category"
              />
            ) : (
              <div className="flex items-center gap-2">
                <span className="text-xs text-text-muted">Category</span>
                <span className="text-xs font-bold text-text-primary">{scan.reason ?? "—"}</span>
                <button
                  type="button"
                  onClick={() => setEditingCategory(true)}
                  className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary"
                  title="Edit scan category (with reason)"
                >
                  <Pencil className="h-4 w-4" />
                </button>
              </div>
            )}
          </div>

          <p className="text-xs text-text-secondary inline-flex items-center gap-1.5 pt-1 flex-wrap">
            <ShieldCheck className="w-3.5 h-3.5 textfocus-ring" />
            Processed by operator: <span className="font-bold text-text-primary">{scan.operatorName || "—"}</span>
            {scan.isManual ? <span className="surface-card px-1.5 py-0.5 bg-amber-400/15 text-action-warning text-xs font-bold">MANUAL</span> : null}
            {scan.isCorrection ? <span className="surface-card px-1.5 py-0.5 bg-sky-400/15 text-action-info text-xs font-bold">CORRECTION</span> : null}
          </p>
        </div>

        {/* Time-range of validity */}
        {durationMs > 0 && (
          <div className="rounded-xl border border-border bg-bg-elevated p-3 space-y-2">
            <p className="text-xs uppercase font-bold tracking-wider text-text-muted inline-flex items-center gap-1.5">
              <Clock className="w-3.5 h-3.5" /> Time range
            </p>
            <DurationBar elapsedMs={durationMs} totalMs={durationMs} tone="info" />
            <div className="flex items-center justify-between text-xs text-text-muted">
              <span>{new Date(scanStart).toLocaleString()}</span>
              <span>{new Date(scanEnd).toLocaleString()}</span>
            </div>
          </div>
        )}

        {/* Dispute / edit trail */}
        {edits.length > 0 && (
          <div className="rounded-xl border border-amber-500/20 bg-amber-500/5 p-3 space-y-2">
            <p className="text-xs uppercase font-bold tracking-wider text-text-muted inline-flex items-center gap-1.5">
              <AlertTriangle className="w-3.5 h-3.5 text-amber-500" /> Category edit trail
            </p>
            <div className="space-y-1.5">
              {edits.map((e, i) => (
                <div key={i} className="text-xs text-text-secondary flex items-start gap-1.5">
                  <span className="font-medium text-text-primary shrink-0">{e.category}</span>
                  <span className="flex-1 truncate">{e.reason}</span>
                  <span className="text-text-muted shrink-0 tabular-nums">{e.editedAt.slice(0, 10)}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Person details from API */}
        {payload?.person ? (
          <div className="grid grid-cols-2 gap-2 text-xs">
            {[
              ["Department", payload.person.department],
              ["Designation", payload.person.designation],
              ["Year", payload.person.year != null ? String(payload.person.year) : undefined],
              ["Section", payload.person.section],
              ["Hostel Block", payload.person.hostelBlock],
              ["Room", payload.person.roomNumber],
            ]
              .filter((pair) => !!pair[1])
              .map(([k, v]) => (
                <div key={k} className="surface-card bg-bg-base px-3 py-2">
                  <p className="text-xs uppercase font-bold text-text-muted">{k}</p>
                  <p className="font-semibold truncate">{v}</p>
                </div>
              ))}
          </div>
        ) : null}

        {/* Movement history */}
        {payload?.history && payload.history.length > 0 ? (
          <div className="space-y-2">
            <p className="text-xs uppercase font-bold tracking-wider text-text-muted inline-flex items-center gap-1.5">
              <History className="w-3.5 h-3.5" /> Recent Movements
            </p>
            <div className="space-y-1 max-h-44 overflow-y-auto pr-1">
              {payload.history.slice(0, 12).map((h) => (
                <div key={h.id} className="surface-card flex items-center justify-between text-xs px-2 py-1.5 bg-bg-base">
                  <span className={`inline-flex items-center gap-1 font-bold ${h.direction === "IN" ? "text-action-success" : "text-action-danger"}`}>
                    {h.direction === "IN" ? <ArrowDownLeft className="size-3.5" /> : <ArrowUpRight className="size-3.5" />}
                    {h.direction === "IN" ? "Entry" : "Exit"}
                  </span>
                  <span className="text-text-muted">{new Date(h.timestamp).toLocaleString()}</span>
                </div>
              ))}
            </div>
          </div>
        ) : null}
      </div>
    </div>
  );
}
