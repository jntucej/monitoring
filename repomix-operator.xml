  reason: string | null;
}

interface LastScanResponse {
  success: boolean;
  data: LastScan | null;
}

type LookupState = "idle" | "loading" | "found" | "notfound" | "error";







function StatusBadge({ status }: { status: string }) {
  const s = (status ?? "").toUpperCase();
  if (s === "ACTIVE") return <span className="surface-card bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold uppercase text-action-success">Active</span>;
  if (s === "SUSPENDED" || s === "LOCKED") return <span className="surface-card bg-rose-500/10 px-2 py-0.5 text-xs font-semibold uppercase text-action-danger">{s}</span>;
  return <span className="surface-card bg-amber-500/10 px-2 py-0.5 text-xs font-semibold uppercase text-action-warning">{s}</span>;
}

function OperatorLookupInner() {
  const user = useAuthStore((s) => s.user);
  const [name, setName] = useState("");
  const [idNumber, setIdNumber] = useState("");
  const [lastQuery, setLastQuery] = useState("");

  const searchParams = useSearchParams();
  useEffect(() => {
    const qid = searchParams.get("id");
    if (qid) setIdNumber(qid);
  }, [searchParams]);

  const [lookupState, setLookupState] = useState<LookupState>("idle");
  const [result, setResult] = useState<LookupPerson | null>(null);
  const [lookupError, setLookupError] = useState<string | null>(null);
  const [quickEntryType, setQuickEntryType] = useState<"REGULAR" | "LATE" | "RETURN">("REGULAR");
  const [quickReason, setQuickReason] = useState("");
  const [quickBusy, setQuickBusy] = useState<"IN" | "OUT" | null>(null);
  const [quickFeedback, setQuickFeedback] = useState<string | null>(null);

  const gateId = user?.gateId;
  const handleQuickRecord = useCallback(
    async (direction: "IN" | "OUT") => {
      if (!result) return;
      setQuickBusy(direction);
      setQuickFeedback(null);
      try {
        const res = await fetch("/api/operator/manual-entry", {
          method: "POST",
          headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
          body: JSON.stringify({
            roll: result.uniqueId,
            direction,
            reason: quickReason.trim() || `Operator lookup ${direction}`,
            gateId,
            ...(result.personType === "student" && direction === "IN"
              ? { entryType: quickEntryType }
              : {}),
          }),
          cache: "no-store",
        });
        const json = await res.json().catch(() => null);
        if (!res.ok) {
          setQuickFeedback(json?.error?.message || `Failed to record ${direction}.`);
          return;
        }
        setResult((prev) => (prev ? { ...prev, onCampus: direction === "IN" } : prev));
        setQuickReason("");
        setQuickFeedback(`Recorded ${direction} for ${result.name} (${result.uniqueId}).`);
      } catch {
        setQuickFeedback(`Network error while recording ${direction}.`);
      } finally {
        setQuickBusy(null);
      }
    },
    [result, quickReason, quickEntryType, gateId],
  );

  // O12: voice-assisted lookup — prefill the id field on high-confidence
  // recognition so the operator confirms before searching.
  const [_voiceOpen, setVoiceOpen] = useState(false);
  // L1 FrontlinePivot: open the duty-scoped subject sheet from a lookup result.
  const [frontlineSubject, setFrontlineSubject] = useState<FrontlineSubject | null>(null);
  const handleVoiceCommand = useCallback((cmd: VoiceCommand) => {
    if (cmd.roll_number) {
      setIdNumber(cmd.roll_number);
      setVoiceOpen(false);
    }
  }, []);

  const {
    data: lastScanData,
    loading: lastScanLoading,
    error: lastScanError,
  } = useApiResource<LastScanResponse>(
    result?.id ? `/api/operator/last-scan?userId=${encodeURIComponent(result.id)}` : null,
    { ttlMs: 15_000 },
  );

  const refreshAll = useCallback(async () => {
    if (result?.id) {
      // force refresh last scan
    }
  }, [result?.id]);

  usePolling(refreshAll, { intervalMs: 15_000, enabled: !!user });

  const runLookup = useCallback(async () => {
    const id = idNumber.trim().toUpperCase();
    if (!id) return;
    setLastQuery(id);
    setLookupState("loading");
    setResult(null);
    setLookupError(null);

    try {
      const res = await fetch(
        `/api/operator/lookup?id=${encodeURIComponent(id)}`,
        { headers: getAuthHeaders(), cache: "no-store" },
      );
      const json = await res.json();
      if (!res.ok || !json.success) {
        setLookupState("error");
        setLookupError(json.error?.message || `HTTP ${res.status}`);
        return;
      }
      if (json.data?.found && json.data?.person) {
        setResult(json.data.person as LookupPerson);
        setLookupState("found");
      } else {
        setLookupState("notfound");
      }
    } catch (err) {
      setLookupState("error");
      setLookupError(err instanceof Error ? err.message : "Lookup failed");
    }
  }, [idNumber]);

  const fmtTime = (iso: string | null | undefined) =>
    iso
      ? new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
      : "—";

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-5 py-6 min-w-0">
      <ContextSituationBar
        roleLabel="Gate Operator"
        purpose="Lookup student records, current hosteller or day-scholar campus state, and approved passes"
        contextLabel="Student & Pass Lookup"
        statusSummary="Search any student by roll number or name to verify campus status, active passes, and hostel blocks."
        why="Use lookup when students do not have their ID cards ready, need curfew status checked, or report missing permission records."
        primaryAction={{ label: "Manual Entry", href: "/operator/manual-entry" }}
        secondaryAction={{ label: "Pass Verification", href: "/operator/pass-verification" }}
      />
      <PostIncidentBanner
        incidents={[]}
        onAcknowledge={() => {}}
        onResolve={() => {}}
      />
      {/* Search form */}
      <OperatorWidgetBoundary title="Person Lookup">
        {/* O12: voice-assisted lookup — prefill the id field */}
        <button
          type="button"
