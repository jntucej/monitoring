<file path="src/components/operator/ExitReasonsPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  DoorOpen,
  FileDown,
  RefreshCw,
  AlertTriangle,
  Loader2,
} from "lucide-react";
import { useExport } from "@/hooks/useExport";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { MiniSparkline } from "@/components/shared/MiniSparkline";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface ExitReasonPayload {
  data: {
    period: string;
    range: { from: string; to: string };
    total: number;
    prevTotal: number;
    delta: number;
    byReason: Array<{ reason: string; count: number; pct: number }>;
    byGate: Array<{ gate: string; reason: string; count: number }>;
  };
}

type PeriodKey = "today" | "this-week" | "last-week" | "this-month" | "last-month";

const PERIODS: Array<{ key: PeriodKey; label: string }> = [
  { key: "today", label: "Today" },
  { key: "this-week", label: "This week" },
  { key: "last-week", label: "Last week" },
  { key: "this-month", label: "This month" },
  { key: "last-month", label: "Last month" },
];

// ── Component ─────────────────────────────────────────────────────────────

export function ExitReasonsPanel() {
  const { exportCSV } = useExport();
  const [period, setPeriod] = useState<PeriodKey>("today");
  const [data, setData] = useState<ExitReasonPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(`/api/operator/stats/exit-reasons?period=${period}`, {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load");
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [period]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      data.byReason.map((r) => ({
        reason: r.reason,
        count: r.count,
        pct: `${r.pct}%`,
      })),
      [
        { key: "reason", header: "Reason" },
        { key: "count", header: "Exits" },
        { key: "pct", header: "Share" },
      ],
      `exit_reasons_${data.period}.csv`
    );
  };

  const maxPct = Math.max(1, ...(data?.byReason.map((r) => r.pct) ?? [0]));

  return (
    <WidgetBoundary name="ExitReasonsPanel" resetKey={period}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <DoorOpen className="h-4 w-4 text-action-danger shrink-0" />
            <div>
              <h2 className="text-sm font-semibold text-text-primary">Exit Reasons</h2>
              <p className="text-xs text-text-muted">Per-reason exit breakdown</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              disabled={!data || data.total === 0}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
            <button
              type="button"
              onClick={() => void load()}
              className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-surface"
            >
              <RefreshCw className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        {/* Period toggle */}
        <div className="surface-card inline-flex rounded-lg p-0.5 gap-0.5">
          {PERIODS.map(({ key, label }) => (
            <button
              key={key}
              type="button"
              onClick={() => setPeriod(key)}
              className={cn(
                "rounded-md px-3 py-1 text-xs font-medium transition-colors",
                period === key ? "bg-action-primary text-white" : "text-text-secondary hover:bg-bg-elevated"
              )}
            >
              {label}
            </button>
          ))}
        </div>

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <Skeleton className="h-16 rounded-xl" />
            <Skeleton className="h-32 rounded-xl" />
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-rose-500/10 p-4 text-sm text-rose-600">
            <AlertTriangle className="h-4 w-4 inline mr-1" /> {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {data && !loading && (
          <>
            {/* KPI */}
            <div className="rounded-xl border border-border bg-bg-elevated p-4">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-xs text-text-muted">Total exits</p>
                  <div className="flex items-center gap-2 mt-1">
                    <span className="text-2xl font-bold text-text-primary tabular-nums">{data.total}</span>
                    {data.prevTotal > 0 && <DeltaBadge value={data.total} reference={data.prevTotal} label="" />}
                  </div>
                </div>
                <p className="text-xs text-text-muted">
                  {data.range.from} → {data.range.to}
                </p>
              </div>
            </div>

            {/* Per-reason bars */}
            {data.byReason.length > 0 ? (
              <div className="space-y-2">
                <p className="text-xs font-medium text-text-muted">Reason breakdown</p>
                {data.byReason.map((r) => (
                  <div key={r.reason} className="rounded-lg bg-bg-elevated border border-border px-3 py-2">
                    <div className="flex items-center justify-between text-xs mb-1.5">
                      <span className="font-medium text-text-primary">{r.reason}</span>
                      <span className="text-text-muted tabular-nums">{r.count} · {r.pct}%</span>
                    </div>
                    <div className="h-1.5 rounded-full bg-bg-surface overflow-hidden">
                      <div
                        style={{ width: `${(r.pct / maxPct) * 100}%` }}
                        className="h-full rounded-full bg-rose-500/70"
                      />
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p className="text-xs text-text-muted">No exits in this period.</p>
            )}

            {/* Per-gate */}
            {data.byGate.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">By gate</p>
                <div className="grid grid-cols-2 gap-2">
                  {data.byGate.slice(0, 8).map((g, i) => (
                    <div key={i} className="rounded-lg bg-bg-elevated border border-border px-3 py-2 text-xs">
                      <p className="font-medium text-text-primary truncate">{g.gate}</p>
                      <p className="text-text-muted mt-0.5">{g.reason}: {g.count}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default ExitReasonsPanel;
</file>

<file path="src/components/operator/GateConfirmCard.tsx">
"use client";

import { motion } from "framer-motion";
import { LogIn, LogOut, ShieldAlert, X, KeyRound } from "lucide-react";
import { ExitReason, ScanDirection, Student } from "@/lib/types";
import { getAvatarPlaceholder } from "@/lib/utils";

interface GateConfirmCardProps {
  student: Student;
  campusStatus: "IN" | "OUT" | null;
  lastOutReason?: string | null;
  onConfirm: (dir: ScanDirection, reason?: ExitReason | string, entryType?: "hosteller" | "day_scholar") => void | Promise<void>;
  onCancel: () => void;
  onManualEntry: () => void;
}

/**
 * Option A gate-desk confirmation card.
 *
 * Deliberately the opposite of the old ScanConfirmation: no recommendation
 * engine, no "1 recommended + 2 alternatives", no entry-type picker, no
 * auto-confirm. The operator's whole decision at the door is one of two:
 *   IN  — they are entering
 *   OUT — they are leaving
 * Entry type (hosteller vs day-scholar) is institutional data, pre-set by
 * startScan from student_details.current_entry_type; the store's confirmScan
 * resolves it without asking the operator. Two big buttons, always in the
 * same place, so muscle memory does the work.
 *
 * Renders as a small card at the TOP of the camera so the student's face
 * stays visible for badge/identity comparison.
 */
export function GateConfirmCard({
  student,
  campusStatus,
  lastOutReason,
  onConfirm,
  onCancel,
  onManualEntry,
}: GateConfirmCardProps) {
  // Flagged students: the card surfaces the flag banner; the two buttons are
  // still the only actions (no auto-fire was ever wired here), so a flagged
  // scan is always a deliberate tap.
  const flagged = Boolean(student.flagStatus);

  return (
    <motion.div
      initial={{ opacity: 0, y: -10 }}
      animate={{ opacity: 1, y: 0 }}
      exit={{ opacity: 0, y: -10 }}
      transition={{ duration: 0.16 }}
      className="surface-card pointer-events-auto w-full max-w-md mx-auto bg-bg-surface p-4 space-y-3"
    >
      <div className="flex items-center gap-3">
        <img
          src={student.photo || getAvatarPlaceholder(student.name || "??")}
          alt={student.name || "Student"}
          width={56}
          height={56}
          className="size-5 rounded-xl object-cover shrink-0 border border-border"
        />
        <div className="min-w-4 flex-1">
          <p className="font-bold text-sm text-text-primary truncate">{student.name || student.roll}</p>
          <p className="text-xs font-mono text-text-muted truncate">{student.roll}</p>
        </div>
        {campusStatus && (
          <span
            className={`text-xs font-bold px-2 py-1 rounded-full border ${
              campusStatus === "IN"
                ? "bg-emerald-500/15 text-action-success border-emerald-500/30"
                : "bg-amber-500/15 text-action-warning border-amber-500/30"
            }`}
          >
            {campusStatus === "IN" ? "On campus" : "Out"}
          </span>
        )}
      </div>

      {flagged && (
        <div className="surface-card flex items-start gap-2 px-3 py-2 bg-rose-500/15 text-action-danger">
          <ShieldAlert className="w-4 h-4 shrink-0 mt-0.5" />
          <p className="text-xs leading-snug">
            <span className="font-extrabold uppercase tracking-wide">{student.flagStatus}</span>
            <span className="opacity-80"> — verify before releasing.</span>
          </p>
        </div>
      )}

      {!flagged && lastOutReason && campusStatus === "OUT" && (
        <p className="text-xs text-text-muted">Last out · {lastOutReason}</p>
      )}

      {/* The two decisions — always the same two, always the same place. */}
      <div className="grid grid-cols-2 gap-2">
        <button
          type="button"
          onClick={() => onConfirm("IN")}
          className="min-h14 rounded-xl bg-action-primary text-black font-extrabold text-base flex items-center justify-center gap-2 active:scale-[0.99] transition-transform"
        >
          <LogIn className="w-5 h-5" /> IN
        </button>
        <button
          type="button"
          onClick={() => onConfirm("OUT")}
          className="min-h14 rounded-xl bg-action-danger text-white font-extrabold text-base flex items-center justify-center gap-2 active:scale-[0.99] transition-transform"
        >
          <LogOut className="w-5 h-5" /> OUT
        </button>
      </div>

      <div className="flex items-center justify-between text-xs text-text-muted">
        <button
          type="button"
          onClick={onManualEntry}
          className="surface-card inline-flex items-center gap-1.5 px-2 py-1 hover:text-text-primary transition-colors"
        >
          <KeyRound className="w-3.5 h-3.5" /> Manual entry
        </button>
        <button
          type="button"
          onClick={onCancel}
          className="surface-card inline-flex items-center gap-1.5 px-2 py-1 hover:text-text-primary transition-colors"
        >
          <X className="w-3.5 h-3.5" /> Cancel
        </button>
      </div>
    </motion.div>
  );
}
</file>

<file path="src/components/operator/GateModeBanner.tsx">
"use client";

import { useState } from "react";
import Link from "next/link";
import { Modal } from "@/components/ui/modal";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import {
  ShieldAlert,
  Wrench,
  Moon,
  CheckCircle2,
  Loader2,
  X,
} from "lucide-react";
import type { GateMode } from "@/lib/gate-operations";

/** Client-side mirror of the active-lockdown payload (do NOT import from
 *  server/policy — that file pulls in server-only code and would drag the
 *  server graph into the client bundle). */
export interface LockdownInfo {
  id: string;
  scopes: string[];
  message: string | null;
}

export interface GateModeBannerProps {
  mode: GateMode;
  /** Null when no lockdown is active. */
  lockdown: LockdownInfo | null;
  /** Whether the desk is currently allowed to scan. The override button is
   *  hidden when this is true (nothing to override) — the pill still shows
   *  so the operator can confirm the state. */
  scanningAllowed: boolean;
  /** Must post to /api/operator/mode with { mode: "OPEN", reason } and
   *  refetch. Throwing surfaces the error inline; do not swallow. */
  onOverrideMaintenance: (reason: string) => Promise<void>;
  /** Dismisses the lockdown banner for this session only. The scan remains
   *  disabled until an admin lifts the lockdown (DELETE /api/admin/lockdown). */
  onDismissLockdown: () => void;
  /** Compact: a single-line status strip (pill + one-line reason) instead of
   *  the full card. Used on the scan desk so lockdown/curfew/maintenance
   *  stop piling into 3-4 stacked cards that obscure the scan area. */
  compact?: boolean;
}

function pillForMode(mode: GateMode, lockdown: LockdownInfo | null) {
  if (lockdown) {
    return {
      label: "LOCKDOWN",
      Icon: ShieldAlert,
      tone: "bg-action-danger text-white",
      pulse: true,
    };
  }
  switch (mode) {
    case "CURFEW":
      return {
        label: "CURFEW",
        Icon: Moon,
        tone: "bg-amber-500/20 text-action-warning border border-amber-500/40",
        pulse: false,
      };
    case "MAINTENANCE":
      return {
        label: "MAINTENANCE",
        Icon: Wrench,
        tone: "bg-amber-500/20 text-action-warning border border-amber-500/40",
        pulse: false,
      };
    case "OPEN":
    default:
      return {
        label: "OPEN",
        Icon: CheckCircle2,
        tone: "bg-emerald-500/20 text-action-success border border-emerald-500/40",
        pulse: false,
      };
  }
}

export function GateModeBanner({
  mode,
  lockdown,
  scanningAllowed,
  onOverrideMaintenance,
  onDismissLockdown,
  compact = false,
}: GateModeBannerProps) {
  const [overrideOpen, setOverrideOpen] = useState(false);
  const [reason, setReason] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const { label, Icon, tone, pulse } = pillForMode(mode, lockdown);
  const isMaintenance = !lockdown && mode === "MAINTENANCE";
  const isCurfew = !lockdown && mode === "CURFEW";

  async function submitOverride(e: React.FormEvent) {
    e.preventDefault();
    const trimmed = reason.trim();
    if (trimmed.length < 3) {
      setError("Reason is required (min 3 chars) — it is written to the audit log.");
      return;
    }
    setSubmitting(true);
    setError(null);
    try {
      await onOverrideMaintenance(trimmed);
      setOverrideOpen(false);
      setReason("");
    } catch (err) {
      setError(err instanceof Error ? err.message : "Override failed.");
    } finally {
      setSubmitting(false);
    }
  }

  return (
    <>
      <div className="flex items-center gap-2">
        <button
          type="button"
          onClick={() => {
            if (isMaintenance) setOverrideOpen(true);
          }}
          className={[
            "flex items-center gap-1.5 rounded-md px-2 py-0.5 text-xs font-bold tracking-wide",
            tone,
            pulse ? "animate-pulse" : "",
            isMaintenance ? "cursor-pointer hover:opacity-90" : "cursor-default",
          ].join(" ")}
          aria-label={`Gate mode: ${label}${isMaintenance ? " — tap to override" : ""}`}
        >
          <Icon className="size-3.5" aria-hidden />
          {label}
        </button>

        {isMaintenance && (
          <button
            type="button"
            onClick={() => setOverrideOpen(true)}
            className="text-xs text-action-warning underline underline-offset-2"
          >
            Override
          </button>
        )}

        {isCurfew && (
          <span className="text-xs text-amber-400/80">
            Scans still allowed — curfew advisory
          </span>
        )}

        {lockdown && (
          <button
            type="button"
            onClick={onDismissLockdown}
            className="ml-1 inline-flex items-center gap-1 text-xs text-white/90 underline underline-offset-2"
            aria-label="Dismiss lockdown message (scan remains disabled)"
          >
            <X className="size-3.5" aria-hidden /> dismiss message
          </button>
        )}
      </div>

      {lockdown && (
        <div
          role="alert"
          className={compact
            ? "mt-1 flex flex-col gap-1.5 max-w-md bg-action-danger/10 px-2.5 py-2 text-xs text-action-danger"
            : "surface-card mt-1 max-w-md bg-action-danger/10 px-2 py-2 text-xs text-action-danger"}
        >
          <div className="flex items-center gap-2">
            <ShieldAlert className="size-3.5 shrink-0" aria-hidden />
            <span>
              <strong>Campus lockdown — all scans are blocked.</strong>{" "}
              {lockdown.message ?? "An administrator must lift the lockdown before any pass (camera, manual, or photo) can be verified."}
              {lockdown.scopes.length > 0 && <> Scopes: {lockdown.scopes.join(", ")}.</>}
            </span>
          </div>
          {/* Actionable path during lockdown. The previous version only said
              "manual entry disabled" with no next step, which the 20-persona
              runs scored 42x as "blocks verification without an actionable
              path". Two concrete moves: a still-available read-only lookup
              (clickable), and an escalation inbox for flagging the person. */}
          <div className="flex flex-wrap items-center gap-x-3 gap-y-1 pl-5.5">
            <Link
              href="/operator/lookup"
              className="font-semibold text-action-danger underline underline-offset-2 hover:text-action-danger/80"
            >
              Look up a person
            </Link>
            <Link
              href="/operator/exceptions"
              className="font-semibold text-action-danger underline underline-offset-2 hover:text-action-danger/80"
            >
              Flag / escalate
            </Link>
            <span className="text-action-danger/80">
              Scans resume when security administration lifts the lockdown.
            </span>
          </div>
        </div>
      )}

      <Modal
        isOpen={overrideOpen}
        onClose={() => {
          if (submitting) return;
          setOverrideOpen(false);
          setError(null);
        }}
        title="Override maintenance mode"
        size="sm"
      >
        <form onSubmit={submitOverride} className="space-y-3">
          <p className="text-sm text-text-secondary">
            Gate mode is <strong>MAINTENANCE</strong> and scans are currently
            disabled. Overriding records the reason in the audit log and is
            visible to supervisors.
          </p>
          <Input
            autoFocus
            label="Reason"
            placeholder="e.g. verified gate sensor OK after field check"
            value={reason}
            onChange={(e) => setReason(e.target.value)}
            maxLength={200}
            required
          />
          {error && (
            <p role="alert" className="text-sm text-action-danger">
              {error}
            </p>
          )}
          <div className="flex justify-end gap-2">
            <Button
              type="button"
              variant="secondary"
              onClick={() => setOverrideOpen(false)}
              disabled={submitting}
            >
              Cancel
            </Button>
            <Button type="submit" disabled={submitting || !scanningAllowed}>
              {submitting ? (
                <Loader2 className="h-4 w-4 animate-spin" aria-hidden />
              ) : (
                "Override and re-enable scans"
              )}
            </Button>
          </div>
        </form>
      </Modal>
    </>
  );
}
</file>

<file path="src/components/operator/GatePickerScreen.tsx">
"use client";

import React, { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { Loader2, MapPin, AlertCircle } from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { useToast } from "@/components/ui/toast";

interface Gate {
  id: string;
  gateCode?: string;
  name: string;
  location?: string;
  isActive?: boolean;
}

export function GatePickerScreen() {
  const router = useRouter();
  const { addToast } = useToast();
  const user = useAuthStore((s) => s.user);
  const setUser = useAuthStore((s) => s.setUser);
  const token = useAuthStore((s) => s.token);

  const [gates, setGates] = useState<Gate[]>([]);
  const [selected, setSelected] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    async function fetchGates() {
      try {
        const res = await fetch("/api/gates", {
          headers: {
            "Content-Type": "application/json",
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
          },
        });
        const json = await res.json();
        if (!json.success) {
          setError("Failed to load gates");
          return;
        }
        const allGates: Gate[] = Array.isArray(json.data) ? json.data : [];
        // Filter to active gates only (API returns camelCase via getAllGatesLive)
        const active = allGates.filter(
          (g) => g.isActive === true
        );
        setGates(active);
      } catch {
        setError("Could not reach the server. Check your connection.");
      } finally {
        setLoading(false);
      }
    }
    fetchGates();
  }, [token]);

  async function handleSubmit() {
    if (!selected || !user) return;
    setSubmitting(true);
    setError(null);
    try {
      // Patch the current user's gate assignment via /api/users/[id]
      const res = await fetch(`/api/users/${user.id}`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
        body: JSON.stringify({ gateId: selected }),
      });
      const json = await res.json();
      if (!json.success) {
        setError(json.error?.message || "Failed to assign gate");
        addToast({
          variant: "error",
          message: json.error?.message || "Failed to assign gate",
        });
        return;
      }
      // Update in-memory store so downstream components see the new gate immediately
      if (user) setUser({ ...user, gateId: selected });
      addToast({
        variant: "success",
        message: `Assigned to ${gates.find((g) => g.id === selected)?.name ?? "gate"}.`,
      });
      // Re-check session so the store reflects the latest user data
      await useAuthStore.getState().checkSession();
      router.replace(`/gate/${selected}`);
    } catch {
      setError("Could not reach the server. Check your connection and try again.");
      addToast({
        variant: "error",
        message: "Could not reach the server. Check your connection.",
      });
    } finally {
      setSubmitting(false);
    }
  }

  if (loading) {
    return (
      <div className="min-h-dvh bg-bg-base flex-col items-center justify-center gap-3">
        <div className="size-6 border-t-transparent rounded-full animate-spin" />
        <p className="font-semibold text-text-muted">Loading gates…</p>
      </div>
    );
  }

  return (
    <div className="min-h-dvh bg-bg-base flex-col items-center justify-center p-4">
      <div className="w-full max-w-md space-y-4">
        {/* Header */}
        <div className="text-center space-y-1">
          <div className="size-6 rounded-full bg-emerald-500/15 text-action-success flex items-center justify-center mx-auto">
            <MapPin className="w-6 h-6" />
          </div>
          <h1 className="font-bold text-text-primary">
            Select Your Gate
          </h1>
          <p className="text-text-secondary">
            Choose the gate desk where you are working today.
          </p>
        </div>

        {/* Gate list */}
        {error && (
          <div className="surface-card flex items-start gap-2 p-3 bg-rose-500/10 text-xs">
            <AlertCircle className="w-4 h-4 shrink-0 mt-0.5" />
            <span>{error}</span>
          </div>
        )}

        {gates.length === 0 ? (
          <div className="surface-card bg-bg-surface p-6 text-text-muted">
            No active gates found. Contact your supervisor.
          </div>
        ) : (
          <div className="space-y-2">
            {gates.map((g) => (
              <button
                key={g.id}
                type="button"
                onClick={() => setSelected(g.id)}
                className={[
                  "w-full flex items-center gap-3 px-4 py-3 rounded-xl border text-left transition-all",
                  selected === g.id
                    ? "border-action-success bg-emerald-500/10 text-text-primary"
                    : "border-border bg-bg-surface text-text-primary hover:border-border hover:bg-bg-elevated",
                ].join(" ")}
              >
                <div
                  className={[
                    "w-4 h-4 rounded-full border-2 flex items-center justify-center shrink-0",
                    selected === g.id
                      ? "border-action-success bg-action-success"
                      : "border-border",
                  ].join(" ")}
                >
                  {selected === g.id && (
                    <div className="size-4 rounded-full bg-white" />
                  )}
                </div>
                <div className="flex-1 min-w-4">
                  <div className="font-semibold text-sm truncate">{g.name}</div>
                  {g.location && (
                    <div className="text-text-muted truncate">
                      {g.location}
                    </div>
                  )}
                </div>
                {g.gateCode && (
                  <span className="font-mono text-text-muted shrink-0">
                    {g.gateCode}
                  </span>
                )}
              </button>
            ))}
          </div>
        )}

        {/* Continue button */}
        <button
          type="button"
          onClick={handleSubmit}
          disabled={submitting || !selected}
          className="surface-card w-full py-3 px-4 bg-action-primary hover:brightness-110 disabled:opacity-50 font-bold text-sm flex items-center justify-center gap-2 transition-all active:scale-[0.99]"
        >
          {submitting ? (
            <>
              <Loader2 className="w-4 h-4 animate-spin" />
              Assigning…
            </>
          ) : (
            <>Continue</>
          )}
        </button>
      </div>
    </div>
  );
}
