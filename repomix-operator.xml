<file path="src/components/operator/shared/QuickActions.tsx">
"use client";

import { useCallback, useMemo } from "react";
import { useRouter } from "next/navigation";
import {
  Inbox,
  ArrowUpRight,
  FilePlus2,
  Ticket,
  ScanLine,
  LayoutDashboard,
  ClipboardList,
  Clock,
} from "lucide-react";
import { useAuthStore, useHasHydrated } from "@/stores/authStore";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

/**
 * QuickActions — a compact set of role-aware quick-action buttons.
 *
 * Reads the user's role from useAuthStore and shows 3-6 contextually
 * useful actions that route to the correct sub-pages. No admin/approver
 * power is granted to non-approvers: approver-only actions render only
 * when the signed-in user actually holds an approver or admin role.
 */

interface QuickAction {
  label: string;
  icon: React.ComponentType<{ className?: string }>;
  href: string;
}

const APPROVER_ROLES = new Set([
  "caretaker",
  "deputy_warden",
  "hostel_manager",
  "faculty",
  "hod",
  "oie",
  "vice_principal",
  "principal",
  "exam_branch",
  "exam_superintendent",
  "admin",
  "sysadmin",
]);

/** Canonical home + approvals inbox per approver role. */
const APPROVER_HOMES: Record<string, { home: string; inbox: string; escalated?: string }> = {
  principal: { home: "/principal", inbox: "/principal/approvals", escalated: "/principal/approvals?status=ESCALATED" },
  admin: { home: "/admin", inbox: "/admin/permission-policies", escalated: "/admin/permission-policies" },
  sysadmin: { home: "/sysadmin", inbox: "/sysadmin", escalated: "/sysadmin?tab=approvals" },
  faculty: { home: "/faculty", inbox: "/faculty/permissions", escalated: "/faculty/permissions?status=ESCALATED" },
  hod: { home: "/hod", inbox: "/hod/approvals/pending", escalated: "/hod/approvals/escalated" },
  vice_principal: { home: "/vice-principal", inbox: "/vice-principal/approvals", escalated: "/vice-principal/approvals?status=ESCALATED" },
  oie: { home: "/oie", inbox: "/oie/queue/pending", escalated: "/oie/queue/escalated" },
  exam_branch: { home: "/exam-branch", inbox: "/exam/permissions", escalated: "/exam/permissions?status=ESCALATED" },
  exam_superintendent: { home: "/exam/superintendent", inbox: "/exam/permissions", escalated: "/exam/permissions?status=ESCALATED" },
  caretaker: { home: "/hostel/permissions", inbox: "/hostel/permissions", escalated: "/hostel/permissions?status=ESCALATED" },
  deputy_warden: { home: "/deputy-warden", inbox: "/deputy-warden/delegated-approvals", escalated: "/deputy-warden/delegated-approvals?status=ESCALATED" },
  hostel_manager: { home: "/hostel-manager", inbox: "/hostel-manager/complaints", escalated: "/hostel-manager/complaints" },
};

function actionsForRole(role: string | null, userGateId?: string | null): QuickAction[] {
  if (!role) return [];

  // Approvers (including admin/sysadmin)
  if (APPROVER_ROLES.has(role)) {
    const target = APPROVER_HOMES[role] ?? { home: "/", inbox: "/", escalated: "/" };
    return [
      { label: "Open Approval Inbox", icon: Inbox, href: target.inbox },
      { label: "View Escalated", icon: ArrowUpRight, href: target.escalated ?? target.inbox },
      { label: "New Request", icon: FilePlus2, href: role === "admin" ? "/admin/permission-policies" : target.inbox },
      { label: "All Pending", icon: Ticket, href: target.inbox },
      { label: "Dashboard", icon: LayoutDashboard, href: target.home },
    ];
  }

  // Student
  if (role === "student") {
    return [
      { label: "Request Pass", icon: FilePlus2, href: "/student/permissions/new" },
      { label: "View My Requests", icon: Ticket, href: "/student/permissions" },
      { label: "My Passes", icon: ClipboardList, href: "/student/passes" },
      { label: "Dashboard", icon: LayoutDashboard, href: "/student" },
    ];
  }

  // Parent / Guardian
  if (role === "parent" || role === "guardian") {
    return [
      { label: "Request Pass", icon: FilePlus2, href: "/guardian/request-status" },
      { label: "View My Requests", icon: Ticket, href: "/guardian/request-status" },
      { label: "Child Status", icon: LayoutDashboard, href: "/guardian/child-status" },
      { label: "Dashboard", icon: LayoutDashboard, href: "/guardian" },
    ];
  }

  // Operator: the landing page's hero already shows the primary "Open gate
  // desk" CTA. A second near-identical button in QuickActions was the
  // #2 friction point in the 20-persona run ("duplicate 'Open gate desk'
  // elements lack visual distinction"). So QuickActions points at a
  // distinct, useful destination instead of repeating the desk link.
  if (role === "operator") {
    return [
      { label: "My recent scans", icon: Clock, href: "/operator/transactions" },
      { label: "Look up a person", icon: ScanLine, href: "/operator/lookup" },
    ];
  }

  // Admin / Sysadmin fallback (already handled above, but keep a floor)
  return [{ label: "Dashboard", icon: LayoutDashboard, href: "/" }];
}

export interface QuickActionsProps {
  /** Optional embedded view (no wrapper card). Default: wrapped in a card. */
  compact?: boolean;
}

export function QuickActions({ compact = false }: QuickActionsProps) {
  const hasHydrated = useHasHydrated();
  const user = useAuthStore((s) => s.user);
  const role = user?.role ?? null;
  const router = useRouter();

  const actions = useMemo(() => {
    if (!hasHydrated || !role) return [] as QuickAction[];
    return actionsForRole(role, user?.gateId ?? null);
  }, [hasHydrated, role, user?.gateId]);

  const navigate = useCallback(
    (href: string) => {
      router.push(href);
    },
    [router]
  );

  const grid = (
    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {actions.map((a) => (
        <button
          key={a.label}
          type="button"
          onClick={() => navigate(a.href)}
          className="surface-card group flex items-center gap-3 bg-bg-surface p-3.5 text-left transition-all hover:bg-bg-elevated focus-visible:outline-none focus-visible:ring-2 focus-visible:ringfocus-ring active:scale-[0.98]"
        >
          <span className="flex size-6 shrink-0 items-center justify-center rounded-lg bg-bg-elevated border border-border text-action-primary">
            <a.icon className="h-4 w-4" />
          </span>
          <span className="text-sm font-semibold text-text-primary group-hover:text-text-primary">
            {a.label}
          </span>
        </button>
      ))}
    </div>
  );

  if (actions.length === 0) {
    return (
      <WidgetBoundary title="Quick Actions">
        <div className="surface-card bg-bg-surface/40 p-4 sm:p-5">
          <p className="text-xs text-text-muted">
            No quick actions available for your role.
          </p>
        </div>
      </WidgetBoundary>
    );
  }

  const card = (
    <div className="surface-card bg-bg-surface/40 p-4 sm:p-5 min-w-0">
      <div className="flex items-center gap-2 mb-4">
        <Inbox className="h-4 w-4 text-action-primary" />
        <h3 className="text-sm font-semibold text-text-primary">Quick Actions</h3>
      </div>
      {grid}
    </div>
  );

  if (compact) {
    return <WidgetBoundary title="Quick Actions">{card}</WidgetBoundary>;
  }
  return <WidgetBoundary title="Quick Actions">{card}</WidgetBoundary>;
}

export default QuickActions;
</file>

<file path="src/components/operator/sheet/ConfirmSheet.tsx">
"use client";

import { useState, useCallback } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { X, ShieldAlert, Clock, AlertTriangle } from "lucide-react";
import { cn } from "@/lib/utils";
import type { Student } from "@/lib/types";
import type { ExitReason } from "@/lib/types";
import type { EntryButtonId, Recommendation } from "@/lib/operator-recommend";

interface ConfirmSheetProps {
  student: Student | null;
  recommendation: Recommendation | null;
  onConfirm: (direction: "IN" | "OUT", reason?: ExitReason, entryType?: "hosteller" | "day_scholar", buttonId?: EntryButtonId) => void;
  onCancel: () => void;
  /** ms before auto-confirm (null = manual only). */
  autoConfirmMs?: number | null;
  /** Current entry type from the operator store. */
  currentEntryType?: "hosteller" | "day_scholar" | null;
  /** Last out reason for context. */
  lastOutReason?: ExitReason | null;
  isOpen?: boolean;
}

export function ConfirmSheet({
  student,
  recommendation,
  onConfirm,
  onCancel,
  autoConfirmMs = null,
  currentEntryType: _currentEntryType,
  lastOutReason: _lastOutReason,
  isOpen = true,
}: ConfirmSheetProps) {
  const [selectedDirection, setSelectedDirection] = useState<"IN" | "OUT">(
    recommendation?.direction || "IN"
  );
  const [selectedReason, setSelectedReason] = useState<ExitReason | undefined>(
    () => recommendation?.reason as ExitReason | undefined
  );
  const [selectedEntryType, setSelectedEntryType] = useState<"hosteller" | "day_scholar" | undefined>(
    () => recommendation?.entryType as "hosteller" | "day_scholar" | undefined
  );
  const [selectedButtonId] = useState<EntryButtonId | undefined>(
    () => recommendation?.entryButton as EntryButtonId | undefined
  );
  const [countdown, setCountdown] = useState<number | null>(null);

  // Countdown timer for auto-confirm.
  useState(() => {
    if (!autoConfirmMs || autoConfirmMs <= 0 || !student) return;
    // Skip auto-confirm for flagged students.
    if (student.flagStatus) return;
    const t = setTimeout(() => {
      setCountdown(null);
      onConfirm(selectedDirection, selectedReason, selectedEntryType, selectedButtonId);
    }, autoConfirmMs);
    return () => clearTimeout(t);
  });

  const handleConfirm = useCallback(() => {
    onConfirm(selectedDirection, selectedReason, selectedEntryType, selectedButtonId);
  }, [onConfirm, selectedDirection, selectedReason, selectedEntryType, selectedButtonId]);

  if (!student || !isOpen) return null;

  // Flag banner.
  const flagBanner = student.flagStatus ? (
    <div className="surface-card flex items-start gap-3 px-4 py-3 bg-rose-500/10 text-action-danger">
      <ShieldAlert className="w-5 h-5 shrink-0 mt-0.5 text-action-danger" />
      <div className="min-w-0 flex-1">
        <div className="flex items-center gap-1.5">
          <span className="font-extrabold text-xs uppercase tracking-wider">{student.flagStatus}</span>
        </div>
        <p className="text-xs opacity-90 mt-0.5">
          {student.flagStatus === "UNAUTHORIZED_EXIT" && "Exit attempt without valid pass."}
          {student.flagStatus === "NO_GATE_PASS" && "No approved gate pass on file."}
          {student.flagStatus === "SUSPENDED" && "Account is suspended."}
          {student.flagStatus === "MANUAL_LOCKDOWN" && "Account manually locked."}
          {student.flagStatus === "OVERDUE" && "Approved pass window has lapsed."}
          {student.flagStatus === "CURFEW_VIOLATION" && "Movement attempted outside curfew."}
          {!["UNAUTHORIZED_EXIT", "NO_GATE_PASS", "SUSPENDED", "MANUAL_LOCKDOWN", "OVERDUE", "CURFEW_VIOLATION"].includes(student.flagStatus || "") &&
            "Flagged student — verify before proceeding."}
        </p>
      </div>
    </div>
  ) : null;

  return (
    <AnimatePresence>
      {isOpen && (
        <>
          {/* Backdrop */}
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="fixed inset-0 z-50 bg-black/40"
            onClick={onCancel}
            aria-hidden="true"
          />
          
          {/* Bottom sheet */}
          <motion.div
            initial={{ y: "100%" }}
            animate={{ y: 0 }}
            exit={{ y: "100%" }}
            transition={{ type: "spring", damping: 25, stiffness: 200 }}
            className="fixed inset-x-0 bottom-0 z-50 bg-bg-surface border-t border-border rounded-t-2xl shadow-2xl max-h-[85dvh] flex flex-col"
            role="dialog"
            aria-modal="true"
            aria-label="Scan confirmation"
          >
            {/* Handle bar */}
            <div className="flex justify-center pt-3 pb-2">
              <div className="w-12 h-1.5 rounded-full bgborder" />
            </div>

            {/* Header */}
            <div className="surface-card flex items-center justify-between px-4 py-3">
              <h2 className="text-sm font-bold text-text-primary">Confirm Scan</h2>
              <button
                type="button"
                onClick={onCancel}
                className="size-6 rounded-lg flex items-center justify-center text-text-muted hover:text-text-primary hover:bg-bg-elevated"
                aria-label="Cancel"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Content */}
            <div className="flex-1 overflow-y-auto px-4 py-4 space-y-4">
              {/* Flag banner */}
              {flagBanner}

              {/* P0: reconciliation banner — direction was inferred from
                  unreliable state (no scan history or stale > 2h). The operator
                  MUST verify before recording; the scan is routed to the
                  supervisor exception queue, not recorded as-is. */}
              {recommendation?.reconciliationRequired && (
                <div className="surface-card flex items-start gap-3 px-4 py-3 bg-amber-500/10 border-l-2 border-action-warning">
                  <AlertTriangle className="w-5 h-5 shrink-0 mt-0.5 text-action-warning" />
                  <div className="min-w-0 flex-1">
                    <span className="font-extrabold text-xs uppercase tracking-wider text-action-warning">
                      Needs Review
                    </span>
                    <p className="text-xs opacity-90 mt-0.5">
                      Direction is inferred from stale or missing scan history.
                      Confirm the correct entry/exit before recording. This scan
                      will be routed to the supervisor exception queue.
                    </p>
                  </div>
                </div>
              )}

              {/* Student info */}
              <div className="flex items-center gap-3">
                <div className="size-6 rounded-full bg-action-primary/20 text-action-primary flex items-center justify-center text-lg font-bold">
                  {student.name?.charAt(0) || "?"}
                </div>
                <div className="min-w-0 flex-1">
                  <p className="text-base font-bold text-text-primary truncate">
                    {student.name || student.roll || "Unknown"}
                  </p>
                  {student.roll && (
                    <p className="text-xs text-text-muted font-mono">{student.roll}</p>
                  )}
                  {student.department && (
                    <p className="text-xs text-text-muted">{student.department}</p>
                  )}
                </div>
              </div>

              {/* Direction + Reason */}
              {recommendation && (
                <div className="space-y-3">
                  <div className="space-y-1.5">
                    <span className="text-xs font-semibold text-text-muted uppercase tracking-wide">
                      Direction
                    </span>
                    <div className="grid grid-cols-2 gap-2">
                      {(["IN", "OUT"] as const).map((dir) => (
                        <button
                          key={dir}
                          type="button"
                          onClick={() => setSelectedDirection(dir)}
                          className={cn(
                            "py-2.5 rounded-xl border text-sm font-bold transition-all",
                            selectedDirection === dir
                              ? "bg-action-primary border-action-primary text-black"
                              : "border-border bg-bg-base text-text-primary hover:border-border"
                          )}
                        >
                          {dir === "IN" ? "Entry (IN)" : "Exit (OUT)"}
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* Entry type for students */}
                  {student.personType === "student" && selectedDirection === "IN" && (
                    <div className="space-y-1.5">
                      <span className="text-xs font-semibold text-text-muted uppercase tracking-wide">
                        Entry Type
                      </span>
                      <div className="grid grid-cols-2 gap-2">
                        {(["hosteller", "day_scholar"] as const).map((type) => (
                          <button
                            key={type}
                            type="button"
                            onClick={() => setSelectedEntryType(type)}
                            className={cn(
                              "py-2 px-3 rounded-lg border text-xs font-medium transition-colors",
                              selectedEntryType === type
                                ? "border-action-primary bg-action-primary/10 text-action-primary"
                                : "border-border bg-bg-base text-text-primary hover:border-border"
                            )}
                          >
                            {type === "hosteller" ? "Hosteller" : "Day Scholar"}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Reason for exit */}
                  {selectedDirection === "OUT" && (
                    <div className="space-y-1.5">
                      <span className="text-xs font-semibold text-text-muted uppercase tracking-wide">
                        Reason
                      </span>
                      <select
                        value={selectedReason || ""}
                        onChange={(e) => setSelectedReason(e.target.value as ExitReason)}
                        className="surface-card w-full px-3 py-2.5 bg-bg-base text-sm text-text-primary focus:ring-2 focus:ringfocus-ring outline-none"
                      >
                        <option value="">Select reason...</option>
                        <option value="daily_outing">Daily Outing</option>
                        <option value="home_out">Home Out</option>
                        <option value="day_pass">Day Pass</option>
                        <option value="emergency">Emergency</option>
                        <option value="special_leave">Special Leave</option>
                        <option value="day_scholar_out">Day Scholar Out</option>
                      </select>
                    </div>
                  )}
                </div>
              )}
            </div>

            {/* Footer */}
            <div className="surface-card p-4 space-y-2">
              {autoConfirmMs && autoConfirmMs > 0 && countdown !== null && (
                <div className="flex items-center justify-center gap-2 text-xs text-text-muted">
                  <Clock className="w-3.5 h-3.5 animate-pulse" />
                  Auto-confirming in {countdown}ms...
                </div>
              )}
              <div className="grid grid-cols-2 gap-2">
                <button
                  type="button"
                  onClick={onCancel}
                  className="surface-card py-3 text-sm font-semibold text-text-secondary hover:bg-bg-elevated transition-colors"
                >
                  Cancel
                </button>
                <button
                  type="button"
                  onClick={handleConfirm}
                  className="surface-card py-3 bg-action-primary text-black font-bold text-sm hover:brightness-110 transition-all active:scale-[0.99]"
                >
                  Confirm
                </button>
              </div>
            </div>
          </motion.div>
        </>
      )}
    </AnimatePresence>
  );
}
</file>

<file path="src/components/operator/sheet/ManualEntrySheet.tsx">
"use client";

import { useState, useCallback } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { X, KeyRound, ListChecks } from "lucide-react";
import { normalizeScannedPayload } from "@/lib/barcode";
import { ReasonSelect } from "@/components/shared/ReasonSelect";
import type { WorkflowType } from "@/lib/types";

interface ManualEntrySheetProps {
  isOpen: boolean;
  onClose: () => void;
  onScan: (roll: string, reason?: string) => void;
  gateId?: string;
  /** Workflow type that scopes the reason list — "hostel" for student manual entries. */
  workflowType?: WorkflowType;
}

export function ManualEntrySheet({ isOpen, onClose, onScan, gateId: _gateId, workflowType = "hostel" }: ManualEntrySheetProps) {
  const [rollInput, setRollInput] = useState("");
  const [reasonCode, setReasonCode] = useState("");
  const [_reasonLabel, setReasonLabel] = useState("");
  const [error, setError] = useState<string | null>(null);

  const handleSubmit = useCallback(() => {
    const raw = rollInput.trim().toUpperCase();
    const roll = raw.startsWith(">") ? raw.slice(1).trim() : raw;
    
    if (!roll) {
      setError("Please enter a roll number.");
      return;
    }

    const normalized = normalizeScannedPayload(roll);
    if (!normalized) {
      setError("Could not parse the roll number. Please check and try again.");
      return;
    }

    setError(null);
    // O15: pass the structured reason code when one is selected.
    onScan(normalized, reasonCode || undefined);
    setRollInput("");
    setReasonCode("");
    setReasonLabel("");
  }, [rollInput, reasonCode, onScan]);

  const handleKeyDown = useCallback((e: React.KeyboardEvent) => {
    if (e.key === "Enter") {
      e.preventDefault();
      handleSubmit();
    } else if (e.key === "Escape") {
      onClose();
    }
  }, [handleSubmit, onClose]);

  return (
    <AnimatePresence>
      {isOpen && (
        <>
          {/* Backdrop */}
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="fixed inset-0 z-50 bg-black/40"
            onClick={onClose}
            aria-hidden="true"
          />
          
          {/* Bottom sheet */}
          <motion.div
            initial={{ y: "100%" }}
            animate={{ y: 0 }}
            exit={{ y: "100%" }}
            transition={{ type: "spring", damping: 25, stiffness: 200 }}
            className="surface-card fixed inset-x-0 bottom-0 z-50 bg-bg-surface p-4"
            role="dialog"
            aria-modal="true"
            aria-label="Manual entry"
          >
            {/* Handle bar */}
            <div className="flex justify-center pt-1 pb-3">
              <div className="w-12 h-1.5 rounded-full bgborder" />
            </div>

            {/* Header */}
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-2">
                <KeyRound className="w-5 h-5 text-action-primary" />
                <h2 className="text-sm font-bold text-text-primary">Manual Entry</h2>
              </div>
              <button
                type="button"
                onClick={onClose}
                className="size-6 rounded-lg flex items-center justify-center text-text-muted hover:text-text-primary hover:bg-bg-elevated"
                aria-label="Close"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Input */}
            <div className="space-y-3">
              <div>
                <label
                  htmlFor="manual-roll-input"
                  className="block text-xs font-semibold text-text-muted uppercase tracking-wide mb-1.5"
                >
                  Roll / Employee ID
                </label>
                <input
                  id="manual-roll-input"
                  type="text"
                  value={rollInput}
                  onChange={(e) => {
                    setRollInput(e.target.value.toUpperCase());
                    setError(null);
                  }}
                  onKeyDown={handleKeyDown}
                  placeholder="e.g. 24JJ1A0501 or >24JJ1A0501"
                  className="surface-card w-full px-4 py-3 bg-bg-base text-base font-mono font-bold tracking-wider text-text-primary uppercase placeholder-[var(--text-muted)] focus:ring-2 focus:ringfocus-ring outline-none"
                  autoFocus
                />
              </div>

              {error && (
                <p className="text-xs text-action-danger flex items-center gap-1.5">
                  <span className="size-3.5 rounded-full bg-rose-400/20 flex items-center justify-center text-xs">!</span>
                  {error}
                </p>
              )}

              {/* O15: structured reason — replaces the free-text input */}
              <div>
                <div className="flex items-center gap-1.5 mb-1.5">
                  <ListChecks className="h-3.5 w-3.5 text-text-muted" aria-hidden />
                  <label className="text-xs font-semibold text-text-muted uppercase tracking-wide">
                    Entry reason <span className="normal-case text-text-muted/60">(optional)</span>
                  </label>
                </div>
                <ReasonSelect
                  workflowType={workflowType}
                  value={reasonCode}
                  onChange={(code, label) => { setReasonCode(code); setReasonLabel(label); }}
                />
              </div>

              <p className="text-xs text-text-muted">
                Type &gt; then roll number, or paste directly. Press Enter to submit.
              </p>

              <button
                type="button"
                onClick={handleSubmit}
                disabled={!rollInput.trim()}
                className="surface-card w-full py-3 bg-action-primary text-black font-bold text-sm hover:brightness-110 disabled:opacity-50 disabled:cursor-not-allowed transition-all active:scale-[0.99]"
              >
                Verify Roll Number
              </button>
            </div>
          </motion.div>
        </>
      )}
    </AnimatePresence>
  );
}
</file>

<file path="src/components/operator/BiometricPrompt.tsx">
"use client";

// Biometric step for high-risk OUT scans (home_out with a valid pass).
//
// HARDWARE NOTE: the signature <Input> below is the integration point for
// the kiosk's fingerprint reader. Swap it for one of:
//   - WebAuthn: navigator.credentials.get({ publicKey: { challenge,
//     allowCredentials, userVerification: "required" } }) and base64 the
//     assertion's signature field;
//   - serial-port SDK: subscribe to the reader's data event and call
//     setSignature(data) on receipt;
//   - keyboard-wedge reader: keep the <Input> as-is.
// The server endpoint (/api/gate/verify-thumbprint) is unchanged.
//
// If no reader exists on the kiosk yet, leave this component in place but
// keep the requireBiometric gate in the desk commented out — a dead button
// is worse than no button. The biometric flow is not load-bearing today.

import { useCallback, useState } from "react";
import { Fingerprint, Loader2, ShieldQuestion } from "lucide-react";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { fetchWithTimeout } from "@/lib/fetch-with-timeout";
import { getAuthHeaders } from "@/lib/utils";

export type BiometricPromptProps = {
  ticketNumber: string;
  roll: string;
  /** "thumb" = fingerprint reader; "pin" = operator PIN fallback. */
  mode?: "thumb" | "pin";
  onCancel: () => void;
  onVerified: () => void;
};

type VerifyResult = "checking" | "ok" | "mismatch" | "error" | null;

export function BiometricPrompt({
  ticketNumber,
  roll,
  mode = "thumb",
  onCancel,
  onVerified,
}: BiometricPromptProps) {
  const [signature, setSignature] = useState("");
  const [result, setResult] = useState<VerifyResult>(null);
  const [busy, setBusy] = useState(false);

  const verify = useCallback(async () => {
    if (!signature.trim()) return;
    setBusy(true);
    setResult("checking");
    try {
      const res = await fetchWithTimeout(
        "/api/gate/verify-thumbprint",
        {
          method: "POST",
          headers: { "Content-Type": "application/json", ...getAuthHeaders() },
          body: JSON.stringify({ roll, ticket_number: ticketNumber, signature }),
        },
        10_000,
      );
      const json = await res.json().catch(() => null);
      if (res.ok && json?.match === true) {
        setResult("ok");
        onVerified();
      } else {
        setResult(json?.match === false ? "mismatch" : "error");
      }
    } catch {
      setResult("error");
    } finally {
      setBusy(false);
    }
  }, [signature, roll, ticketNumber, onVerified]);

  const caption =
    result === "mismatch"
      ? "Fingerprint did not match the registered print. Try again, or escalate."
      : result === "error"
        ? "Could not reach the biometric verifier. Retry or escalate."
        : result === "ok"
          ? "Verified — recording the scan."
          : `Place the student's finger on the reader (ticket ${ticketNumber}).`;

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-label="Biometric verification"
      className="fixed inset-x-0 bottom-0 z-80 mx-auto w-full max-w-md p-4"
    >
      <div className="surface-card bg-bg-surface p-4">
        <div className="flex items-center gap-2">
          {busy ? (
            <Loader2 className="h-5 w-5 animate-spin text-action-primary" aria-hidden />
          ) : (
            <Fingerprint className="h-5 w-5 text-action-primary" aria-hidden />
          )}
          <h3 className="text-sm font-bold text-text-primary">
            Thumbprint required
          </h3>
          <ShieldQuestion className="ml-auto h-4 w-4 text-text-muted" aria-hidden />
        </div>
        <p className="mt-2 text-xs text-text-secondary">{caption}</p>

        {mode === "thumb" && (
          <div className="mt-3">
            <Input
              label="Reader signature"
              value={signature}
              onChange={(e) => {
                setSignature(e.target.value);
                if (result !== null) setResult(null);
              }}
              placeholder="Tap the fingerprint reader…"
              disabled={busy}
              autoFocus
            />
          </div>
        )}

        <div className="mt-3 flex justify-end gap-2">
          <Button variant="secondary" size="sm" onClick={onCancel} disabled={busy}>
            Cancel
          </Button>
          <Button
            size="sm"
            onClick={verify}
            disabled={busy || !signature.trim() || result === "checking"}
          >
            {busy ? "Verifying…" : "Verify"}
          </Button>
        </div>
      </div>
    </div>
  );
}
</file>

