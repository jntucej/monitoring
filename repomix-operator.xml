"use client";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { Loader2, KeyRound, CheckCircle2, AlertTriangle } from "lucide-react";
import { useAuthStore } from "@/stores/authStore";

/**
 * Operator claim page — redeem a 6-digit claim code minted by a supervisor
 * at /api/supervisor/claim-codes, which binds the operator to that gate.
 *
 * Flow: operator lands here (from the /operator desk when they have no gate
 * assigned), enters the code, POSTs { code } to /api/operator/claim-gate.
 * On success the operator's users.gate_id is bound and the auth cache is
 * evicted server-side; we refresh the user row and route them to the gate
 * desk. If they already have a gate assigned the API returns ALREADY_ASSIGNED
 * — we show that and link back to their desk instead of claiming again.
 */
export default function OperatorClaimPage() {
  const router = useRouter();
  const user = useAuthStore((s) => s.user);
  const token = useAuthStore((s) => s.token);
  const checkSession = useAuthStore((s) => s.checkSession);
  const setRole = useAuthStore((s) => s.setRole);

  const [code, setCode] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [claimedGateName, setClaimedGateName] = useState<string | null>(null);

  const authHeaders = {
    Authorization: `Bearer ${token ?? ""}`,
    "Content-Type": "application/json",
  };

  const submit = async () => {
    const trimmed = code.trim();
    if (!trimmed || submitting) return;
    setSubmitting(true);
    setError(null);
    try {
      const res = await fetch("/api/operator/claim-gate", {
        method: "POST",
        headers: authHeaders,
        body: JSON.stringify({ code: trimmed }),
      });
      const body = await res.json().catch(() => ({}));
      if (body?.success) {
        setClaimedGateName(body?.data?.gateName ?? null);
        // Re-hydrate the user row so the desk shows the freshly bound gate.
        await checkSession();
        setRole("operator");
        // Route to the gate desk for the freshly claimed gate.
        if (body?.data?.gateId) {
          router.push(`/gate/${body.data.gateId}`);
          return;
        }
        router.push("/operator");
        return;
      }
      const errCode = body?.error?.code;
      if (errCode === "ALREADY_ASSIGNED") {
        setError(
          body?.error?.message ||
            "You already have a gate assigned. Open your desk instead of claiming a new one."
        );
      } else if (errCode === "CODE_REQUIRED") {
        setError("Enter the 6-digit claim code your supervisor gave you.");
      } else {
        setError(body?.error?.message || "Claim failed. Check the code and try again.");
      }
    } catch {
      setError("Could not reach the server. Try again.");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
      <div className="mb-4">
        <ContextSituationBar
          roleLabel="Gate Operator"
          purpose="Claim physical gate assignment for the shift using supervisor-issued authorization tokens"
          contextLabel="Gate Claim Terminal"
          statusSummary="Enter the gate claim PIN or select an unassigned terminal to activate your scanner session."
          why="Claiming ties your operator identity to the specific physical gate terminal and begins scan logging for the shift."
          primaryAction={{ label: "Set Kiosk PIN", href: "/operator/kiosk-pin" }}
          secondaryAction={{ label: "Operator Home", href: "/operator" }}
        />
      </div>
      <div className="mx-auto max-w-lg space-y-5">
        <div>
          <h1 className="text-lg font-bold text-text-primary flex items-center gap-2">
            <KeyRound className="w-5 h-5 text-action-success" />
            Claim your gate
          </h1>
          <p className="text-xs text-text-muted mt-1.5">
            Enter the 6-digit code a supervisor generated for you. It&apos;s one-time
            use and binds you to that gate. You can only claim if you don&apos;t already
            have a gate assigned.
          </p>
        </div>

        <div className="surface-card bg-bg-surface p-5 space-y-4">
          <label className="block">
            <span className="block text-xs font-semibold text-text-muted mb-1.5 uppercase tracking-wide">
              Claim code
            </span>
            <input
              type="text"
              inputMode="numeric"
              autoComplete="off"
              maxLength={12}
              value={code}
              onChange={(e) => {
                setCode(e.target.value.replace(/[^0-9]/g, ""));
                setError(null);
              }}
              onKeyDown={(e) => {
                if (e.key === "Enter") submit();
              }}
              placeholder="e.g. 482913"
              className="surface-card w-full px-4 py-3 bg-bg-base text-2xl font-mono tracking-[0.3em] text-text-primary placeholder:text-text-muted placeholder:text-base placeholder:tracking-normal placeholder:font-sans focus:ring-2 focus:ring-emerald-500/40 outline-none"
              disabled={submitting}
            />
          </label>

          {error && (
            <div className="surface-card p-2.5 bg-rose-500/10 text-action-danger text-xs font-medium flex items-start gap-2">
              <AlertTriangle className="w-4 h-4 shrink-0 mt-0.5" />
              <span>
                {error}{" "}
                {user?.gateId && (
                  <button
                    type="button"
                    onClick={() => router.push(`/gate/${user.gateId}`)}
                    className="underline underline-offset-2 hover:text-rose-600"
                  >
                    Open your current gate
                  </button>
                )}
              </span>
            </div>
          )}

          {claimedGateName && !error && (
            <div className="surface-card p-2.5 bg-emerald-500/10 text-action-success text-xs font-medium flex items-center gap-2">
              <CheckCircle2 className="w-4 h-4 shrink-0" />
              Gate claimed ({claimedGateName}). Routing to your desk…
            </div>
          )}

          <button
            type="button"
            onClick={submit}
            disabled={submitting || code.length < 4}
            className="w-full min-h-11 rounded-lg bg-action-success hover:bg-action-success disabled:opacity-40 text-white text-sm font-bold flex items-center justify-center gap-2 transition"
          >
            {submitting ? (
              <>
                <Loader2 className="w-4 h-4 animate-spin" />
                Claiming…
              </>
            ) : (
              <>
                <KeyRound className="w-4 h-4" />
                Claim gate
              </>
            )}
          </button>

          {user?.gateId && (
            <p className="text-xs text-text-muted text-center">
              You already have gate <span className="font-mono text-text-secondary">{user.gateId}</span>{" "}
              assigned. Use the link above to return to your desk.
            </p>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/app/(operator)/operator/exceptions/page.tsx">
"use client";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { Suspense, useCallback, useMemo, useState } from "react";
import { OperatorWidgetBoundary } from "@/components/operator/shared/OperatorWidgetBoundary";
import { OperatorPageLoading } from "@/components/operator/shared/OperatorLoading";

import { useAuthStore } from "@/stores/authStore";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { EntityInspector } from "@/components/shared/EntityInspector";
import {
  exceptionInspection,
  passTicketInspection,
  useRoleInspectorHost,
  type ExceptionTag,
} from "@/components/shared/roleInspectors";
import {
  Loader2,
  AlertTriangle,
  Inbox,
  Clock,
  ShieldAlert,
} from "lucide-react";

/* ── response shapes ── */

interface TransactionRow {
  id: string;
  roll: string | null;
  name: string | null;
  person_type: string | null;
  direction: string;
  reason: string | null;
  gate_id: string | null;
  gate_name: string | null;
  timestamp: string;
  scan_type: boolean | null;
  is_correction: boolean | null;
  created_at: string | null;
}

interface TransactionsResponse {
  success: boolean;
  data: {
    transactions: TransactionRow[];
    counts: { total: number; entries: number; exits: number; manual: number; flagged: number };
    gateScoped: boolean;
    gateId: string | null;
  };
}

interface PermissionsResponse {
  success: boolean;
  data: Array<{
    id: string;
    ticket_number?: string;
    workflow_type?: string;
    status?: string;
    created_at?: string;
    student?: { name?: string; unique_id?: string } | null;
  }>;
  total?: number;
}

type Filter = "ALL" | "FLAGGED" | "DENIED" | "MANUAL";

function safeText(v: string | number | null | undefined, fallback = "—"): string {
  const s = String(v ?? "").trim();
  if (!s || s === "undefined" || s === "NaN" || s.toLowerCase() === "null") return fallback;
  return s;
}

function ExceptionsInner() {
  const user = useAuthStore((s) => s.user);
  const { inspection, inspect, closeInspection, role } = useRoleInspectorHost();
  const [filter, setFilter] = useState<Filter>("ALL");

  const {
    data: transactions,
    loading: txLoading,
    error: txError,
    refresh: refreshTransactions,
  } = useApiResource<TransactionsResponse>("/api/operator/transactions", {
    ttlMs: 30_000,
  });

  // Rejected permissions that touched the main-gate stage today — the
  // operator's denied-entries source.
  const {
    data: deniedPerms,
    loading: permLoading,
    error: permError,
    refresh: refreshPerms,
  } = useApiResource<PermissionsResponse>(
    "/api/permissions?workflow_type=hostel&status=REJECTED",
    { ttlMs: 60_000 }
  );

  const refreshAll = useCallback(async () => {
    clearCache();
    await Promise.all([refreshTransactions(), refreshPerms()]);
  }, [refreshTransactions, refreshPerms]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const rows = transactions?.data?.transactions ?? [];
  const busy = txLoading && !transactions;

  const isFlagged = (r: TransactionRow) =>
    Boolean(r.is_correction) ||
    (r.reason !== null && r.reason !== undefined &&
      /denied|rejected|blocked|violation|exception|correction|hold/i.test(
        String(r.reason)
      ));

  const isDenied = (r: TransactionRow) =>
    r.reason !== null &&
    r.reason !== undefined &&
    /denied|rejected|blocked/i.test(String(r.reason));

  const isManual = (r: TransactionRow) =>
    r.scan_type === true;

  const filtered = useMemo(() => {
    switch (filter) {
      case "FLAGGED":
        return rows.filter(isFlagged);
      case "DENIED":
        return rows.filter(isDenied);
      case "MANUAL":
        return rows.filter(isManual);
      default:
        return rows.filter((r) => isFlagged(r) || isDenied(r) || isManual(r));
    }
     
  }, [rows, filter]);

  const deniedPermissionRows = useMemo(() => {
    const cutoff = new Date().setHours(0, 0, 0, 0);
    return (deniedPerms?.data ?? []).filter((p) => {
      const created = p.created_at ? new Date(p.created_at).getTime() : 0;
      return created >= cutoff;
    });
     
  }, [deniedPerms]);

  const fmtTime = (iso: string | null | undefined) =>
    iso
      ? new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
      : "—";

  const tagsForRow = (r: TransactionRow): ExceptionTag[] => {
    const tags: ExceptionTag[] = [];
    if (isDenied(r)) tags.push("Denied");
    if (isFlagged(r)) tags.push("Flagged");
    if (isManual(r)) tags.push("Manual");
    if (Boolean(r.is_correction)) tags.push("Correction");
    return tags;
  };

  const openException = (r: TransactionRow) => {
    inspect(exceptionInspection(r, tagsForRow(r), role));
  };

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-5 py-6 min-w-0">
      <ContextSituationBar
        roleLabel="Gate Operator"
        purpose="Review denied scans, invalid pass alerts, curfew overrides, and gate transit discrepancies"
        contextLabel="Exceptions Register"
        statusSummary="Investigate gate scan rejections, expired pass attempts, and perimeter security anomalies."
        why="Reviewing failed or blocked scan attempts prevents repeat gate bottlenecks and flags unauthorized perimeter movements."
        severity="warn"
        primaryAction={{ label: "Manual Entry", href: "/operator/manual-entry" }}
        secondaryAction={{ label: "Transit Log", href: "/operator/transactions" }}
      />
      {(txError || permError) && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex items-center gap-2 min-w-0">
          <AlertTriangle className="w-4 h-4 shrink-0" />
          <span className="truncate min-w-0">
            {[txError, permError].filter(Boolean).join(" · ")}
          </span>
        </div>
      )}

      <OperatorWidgetBoundary title="Today&rsquo;s Exceptions">
        <div className="rounded-xl bg-bg-elevated overflow-hidden min-w-0">
          {/* Filter tabs */}
          <div className="surface-card flex flex-wrap items-center gap-2 px-3 py-2 min-w-0">
            {(["ALL", "FLAGGED", "DENIED", "MANUAL"] as Filter[]).map((f) => (
              <button
                key={f}
                type="button"
                onClick={() => setFilter(f)}
