<file path="src/app/api/operator/passes/batch-verify/route.ts">
// /api/operator/passes/batch-verify/route.ts
// Peak-hour batch scan: verify many pass codes in one call instead of
// one round-trip per pass. Each result carries its own verdict so the
// operator UI can render a summary.

import { NextRequest } from "next/server";
import { withAuthorization } from "@/middleware/authorization";
import { withMutationGuard } from "@/server/http/mutation-guard";
import { ok, fail } from "@/server/http/response";
import { query } from "@/lib/postgres";
import type { AuthContext } from "@/lib/authContext";

async function implPost(req: NextRequest, ctx: { auth: AuthContext }) {
  const { auth } = ctx;
  const body = (await req.json().catch(() => null)) as {
    codes?: string[];
  } | null;
  if (!body?.codes?.length || body.codes.length > 200) {
    return fail("VALIDATION_ERROR", "codes[] required, max 200 per call", 400);
  }

  const results: Array<{ code: string; valid: boolean; reason?: string; roll?: string | null; name?: string | null }> = [];
  for (const code of body.codes.slice(0, 200)) {
    const c = String(code).trim();
    const { rows } = await query<{ unique_id: string | null; name: string; flag_status: string | null }>(
      `SELECT u.unique_id, u.name, u.flag_status
         FROM public.passes p
         JOIN public.users u ON u.id = p.user_id
        WHERE p.code = $1 AND p.status = 'ACTIVE'
          AND p.expires_at > now()
        LIMIT 1`,
      [c],
    );
    if (rows.length === 0) {
      results.push({ code: c, valid: false, reason: "NOT_FOUND_OR_EXPIRED" });
    } else if (rows[0].flag_status) {
      results.push({
        code: c, valid: false, reason: `FLAGGED_${rows[0].flag_status}`,
        roll: rows[0].unique_id, name: rows[0].name,
      });
    } else {
      results.push({ code: c, valid: true, roll: rows[0].unique_id, name: rows[0].name });
    }
  }

  return ok({
    total: results.length,
    valid: results.filter((r) => r.valid).length,
    results,
    verifiedBy: auth.role,
  });
}

export const POST = withMutationGuard(implPost, {
  requiredRole: ["operator", "supervisor", "admin", "sysadmin"],
  rateLimit: { keyPrefix: "passes-batch-verify", maxRequests: 5 },
});
</file>

<file path="src/app/api/operator/register-thumbprint/route.ts">
import { errMsg } from "@/lib/err-msg";
import { NextRequest, NextResponse } from "next/server";
import { registerThumbprint, clearThumbprint, hashThumbprint, addAudit, findUserById } from "@/lib/db";
import { withMutationGuard } from "@/server/http/mutation-guard";
import type { Role } from "@/lib/types";

async function handlePost(req: NextRequest) {
  try {
    const actorId = req.headers.get("x-user-id") || "";
    const actorRole = (req.headers.get("x-user-role") || "admin") as Role;
    const body = await req.json().catch(() => ({}));
    const { userId, signature, clear } = body;

    if (!userId) {
      return NextResponse.json(
        { success: false, error: { code: "BAD_REQUEST", message: "userId is required" } },
        { status: 400 }
      );
    }

    const targetUser = await findUserById(userId);
    if (!targetUser) {
      return NextResponse.json(
        { success: false, error: { code: "NOT_FOUND", message: "User not found" } },
        { status: 404 }
      );
    }

    // Guard: operators cannot register or clear thumbprints for sysadmin/admin accounts
    if (actorRole === "operator" && (targetUser.role === "admin" || targetUser.role === "sysadmin")) {
      return NextResponse.json(
        { success: false, error: { code: "FORBIDDEN", message: "Operators cannot modify biometric records of administrators" } },
        { status: 403 }
      );
    }

    if (clear) {
      const ok = await clearThumbprint(userId);
      if (!ok) {
        return NextResponse.json(
          { success: false, error: { code: "DB_ERROR", message: "Failed to clear thumbprint" } },
          { status: 500 }
        );
      }

      await addAudit({
        userId: actorId,
        action: "THUMBPRINT_CLEARED",
        role: actorRole,
        details: { targetUserId: userId, targetName: targetUser.name },
      });

      return NextResponse.json({ success: true, message: "Thumbprint cleared successfully" });
    }

    if (!signature || typeof signature !== "string") {
      return NextResponse.json(
        { success: false, error: { code: "BAD_REQUEST", message: "Biometric signature is required" } },
        { status: 400 }
      );
    }

    const hashed = await hashThumbprint(signature);
    const ok = await registerThumbprint(userId, hashed);
    if (!ok) {
      return NextResponse.json(
        { success: false, error: { code: "DB_ERROR", message: "Failed to save thumbprint" } },
        { status: 500 }
      );
    }

    await addAudit({
      userId: actorId,
      action: "THUMBPRINT_REGISTERED",
      role: actorRole,
      details: { targetUserId: userId, targetName: targetUser.name },
    });

    return NextResponse.json({ success: true, message: "Thumbprint registered successfully" });
  } catch (error) {
    return NextResponse.json(
      { success: false, error: { code: "SERVER_ERROR", message: errMsg(error) || "Internal error" } },
      { status: 500 }
    );
  }
}

export const POST = withMutationGuard(handlePost, {requiredRole: ["admin", "sysadmin", "operator"], rateLimit: { keyPrefix: "register_thumbprint", maxRequests: 30 }});
</file>

<file path="src/app/api/operator/scans/[id]/category/route.ts">
/**
 * PATCH /api/operator/scans/[id]/category
 *
 * Edit a movement_log's category with a mandatory reason (audit).
 * Logs to scan_corrections + audit_logs.
 */

import { NextRequest } from "next/server";
import { query } from "@/lib/postgres";
import { withMutationGuard } from "@/server/http/mutation-guard";
import { ok, fail } from "@/server/http/response";
import { TIER } from "@/server/policy/roles";
import type { AuthContext } from "@/lib/authContext";

function getScanId(req: NextRequest): string {
  const segments = new URL(req.url).pathname.split("/").filter(Boolean);
  // .../scans/<id>/category  ->  the segment before "category"
  const ci = segments.lastIndexOf("category");
  return ci > 0 ? decodeURIComponent(segments[ci - 1] ?? "") : "";
}

async function handlePatch(req: NextRequest, { auth }: { auth: AuthContext }) {
  const id = getScanId(req);
  if (!id) return fail("MISSING_PARAM", "Scan id required", 400);

  const body = await req.json().catch(() => null);
  const category: string = typeof body?.category === "string" ? body.category.trim() : "";
  const reason: string = typeof body?.reason === "string" ? body.reason.trim() : "";

  if (!category) return fail("VALIDATION", "category required");
  if (!reason) return fail("VALIDATION", "reason required (audit)");

  const upd = await query<{ id: string }>(
    `UPDATE movement_logs SET category = $2 WHERE id = $1::uuid RETURNING id::text`,
    [id, category]
  );
  if (upd.rows.length === 0) {
    return fail("NOT_FOUND", "Scan not found or not yours", 404);
  }

  await query(
    `INSERT INTO scan_corrections (log_id, category, reason, corrected_by)
     VALUES ($1::uuid, $2, $3, $4::uuid)`,
    [id, category, reason, auth.userId]
  );

  return ok({ logId: id, category, reason, at: new Date().toISOString() });
}

export const PATCH = withMutationGuard(handlePatch, {
  requiredRole: TIER.OPERATOR,
  rateLimit: { maxRequests: 30, windowMs: 60_000 },
});
</file>

