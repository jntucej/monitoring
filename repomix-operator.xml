"use client";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { Suspense, useCallback, useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { OperatorWidgetBoundary } from "@/components/operator/shared/OperatorWidgetBoundary";
import { OperatorPageLoading } from "@/components/operator/shared/OperatorLoading";

import { useAuthStore } from "@/stores/authStore";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { scanInspection } from "@/components/shared/inspectionModels";
import { WhatHappenedReceipt } from "@/components/shared/WhatHappenedReceipt";
import { getAuthHeaders } from "@/lib/utils";
import {
  Loader2,
  ListOrdered,
  Clock,
  Inbox,
  AlertTriangle,
  ArrowDownLeft,
  ArrowUpRight,
} from "lucide-react";

/* ── response shapes (mirror src/app/api/operator/transactions/route.ts) ── */

interface TransactionRow {
  id: string;
  roll: string | null;
  name: string | null;
  person_type: string | null;
  direction: string;
  reason: string | null;
  gate_id: string | null;
  gate_name: string | null;
  timestamp: string;
  scan_type: string | null;
  is_correction: boolean | null;
  created_at: string | null;
}

interface TransactionsResponse {
  success: boolean;
  data: {
    transactions: TransactionRow[];
    counts: { total: number; entries: number; exits: number; manual: number; flagged: number };
    gateScoped: boolean;
    gateId: string | null;
  };
}

type DirectionFilter = "ALL" | "IN" | "OUT";

function OperatorTransactionsInner() {
  // Stable selector: without `.select((s) => s.user?.id)` the hook returns
  // a fresh object reference on every poll (the auth store's user field
  // is not referentially stable here), which re-triggers useApiResource's
  // effect → new refresh callback → effect re-runs → setState in the
  // effect → re-render → loop (Minified React issue-310).
  const enabled = useAuthStore((s) => !!s.user);

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<TransactionsResponse>("/api/operator/transactions", {
    ttlMs: 30_000,
    enabled,
  });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled });

  const [filter, setFilter] = useState<DirectionFilter>("ALL");
  const [activeTxn, setActiveTxn] = useState<TransactionRow | null>(null);
  const [reclassCategory, setReclassCategory] = useState("DAY_OUT");
  const [reclassReason, setReclassReason] = useState("");
  const [reclassBusy, setReclassBusy] = useState(false);
  const [reclassError, setReclassError] = useState<string | null>(null);
  const [reclassReceipt, setReclassReceipt] = useState<string | null>(null);

  const handleReclassify = async () => {
    if (!activeTxn) return;
    if (!reclassReason.trim()) {
      setReclassError("Reason is required to reclassify a scan.");
      return;
    }
    setReclassBusy(true);
    setReclassError(null);
    try {
      const res = await fetch(`/api/operator/scans/${encodeURIComponent(activeTxn.id)}/category`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        body: JSON.stringify({ category: reclassCategory, reason: reclassReason.trim() }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || json?.success === false) {
        throw new Error(json?.error?.message || json?.error || `HTTP ${res.status}`);
      }
      setReclassReceipt(`Scan ${activeTxn.roll || activeTxn.id} reclassified to ${reclassCategory} (${reclassReason.trim()}).`);
      setReclassReason("");
      setActiveTxn(null);
      await refreshAll();
    } catch (err) {
      setReclassError(err instanceof Error ? err.message : "Failed to reclassify scan");
    } finally {
      setReclassBusy(false);
    }
  };
  const busy = loading && !data;
  const rows = data?.data?.transactions ?? [];
  const counts = data?.data?.counts;

  // Indefinite-spinner guard: after ~8s with no data, the loading state stops
  // being a silent "Loading…" and surfaces "taking longer than usual" + Retry.
  // This is the panel's #1 operator-console finding ("indefinite loading, no
  // progress/timeout indicator"). Resets as soon as data (or an error) lands.
  const [slowLoading, setSlowLoading] = useState(false);
  useEffect(() => {
    if (!busy) { setSlowLoading(false); return; }
    const t = setTimeout(() => setSlowLoading(true), 8000);
    return () => clearTimeout(t);
  }, [busy]);

  const filtered = useMemo(() => {
    if (filter === "ALL") return rows;
    return rows.filter((r) => r.direction === filter);
  }, [rows, filter]);

  const fmtTime = (iso: string | null | undefined) =>
    iso
      ? new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
      : "—";

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-5 py-6 min-w-0">
      <ContextSituationBar
        roleLabel="Gate Operator"
        purpose="Review chronological transit history, direction stamps, and operator-verified logs"
        contextLabel="Transit Transactions"
        statusSummary="Audit chronological entry and exit scans processed during the current operational shift."
        why="Transactions provide verifiable chronological audit records to resolve disputed entry/exit times and verify student movement compliance."
        primaryAction={{ label: "My Shift Stats", href: "/operator/stats" }}
        secondaryAction={{ label: "Pass Verification", href: "/operator/pass-verification" }}
      />
      {/* Toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <div className="flex items-center gap-2 min-w-0">
            <ListOrdered className="w-5 h-5 text-action-primary shrink-0" />
            <h2 className="text-lg font-bold text-text-primary truncate">
              Today&rsquo;s Gate Transactions
            </h2>
          </div>
          <p className="text-xs text-text-muted mt-1 min-w-0">
            {data?.data?.gateScoped
              ? "Scoped to your assigned gate · Asia/Kolkata day"
              : "All active gates · Asia/Kolkata day"}
            {" · "}
            {counts ? `${counts.total} records` : "loading"}
          </p>
        </div>
      </div>

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">Transactions unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card min-h-11 inline-flex items-center justify-center px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      <OperatorWidgetBoundary title="Movement Log">
        <div className="rounded-xl border border-border bg-bg-elevated overflow-hidden min-w-0">
          {/* Counts strip */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px border-b border-border">
            {[
              { label: "Total", value: counts?.total ?? 0, tone: "text-text-primary" },
              { label: "Entries", value: counts?.entries ?? 0, tone: "text-action-success" },
              { label: "Exits", value: counts?.exits ?? 0, tone: "text-action-danger" },
              { label: "Manual", value: counts?.manual ?? 0, tone: "text-action-warning" },
            ].map((s) => (
              <div key={s.label} className="px-4 py-3 min-w-0">
                <p className="text-xs font-bold uppercase tracking-wider text-text-muted">
                  {s.label}
                </p>
                <p className={`text-xl font-bold tabular-nums mt-0.5 ${s.tone}`}>
                  {busy ? "—" : s.value}
                </p>
              </div>
            ))}
          </div>

          {/* Direction filter */}
          <div className="surface-card flex flex-wrap items-center gap-2 px-3 py-2 min-w-0">
            {(["ALL", "IN", "OUT"] as DirectionFilter[]).map((f) => (
              <button
                key={f}
                type="button"
                onClick={() => setFilter(f)}
                className={`min-h-11 inline-flex items-center justify-center rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors shrink-0 ${
                  filter === f
                    ? "bg-action-primary/15 text-action-primary"
                    : "text-text-muted hover:text-text-primary"
                }`}
              >
                {f === "ALL" ? "All" : f === "IN" ? "Entries" : "Exits"}
              </button>
            ))}
            <span className="ml-auto text-xs text-text-muted shrink-0">
              {busy ? "…" : `${filtered.length} shown`}
            </span>
          </div>

          {busy ? (
            <div className="p-4 flex flex-wrap items-center justify-between gap-2 text-sm text-text-muted min-w-0" role="status" aria-busy="true">
              <span className="flex items-center gap-2 min-w-0">
                <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" />
                {slowLoading
                  ? "Still loading — this is taking longer than usual."
                  : "Loading today\u2019s movements\u2026"}
              </span>
              {slowLoading && (
                <button
                  type="button"
                  onClick={() => void refreshAll()}
                  className="surface-card min-h-11 inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold hover:bg-bg-elevated/40 shrink-0"
                >
                  <Clock className="w-3.5 h-3.5 shrink-0" />
                  Retry
                </button>
              )}
            </div>
          ) : filtered.length === 0 ? (
            <div className="p-6 text-center min-w-0 space-y-3">
              <Inbox className="w-5 h-5 text-text-muted mx-auto mb-2" />
              {counts && counts.total > 0 ? (
                <>
                  <p className="text-sm text-text-muted">
                    No {filter === "ALL" ? "" : filter === "IN" ? "entry" : "exit"} transactions in this view.
                  </p>
                  <button
                    type="button"
                    onClick={() => setFilter("ALL")}
                    className="text-xs font-semibold text-action-primary underline underline-offset-2"
                  >
                    Show all {counts.total} today
                  </button>
                </>
              ) : (
                <>
                  <p className="text-sm text-text-muted">
                    No transactions recorded yet today.
                  </p>
                  <p className="text-xs text-text-muted">
                    New scans from your gate desk will appear here as they happen.{" "}
                    <Link href="/operator/exceptions" className="font-semibold text-action-primary underline underline-offset-2">
                      Flag or review exceptions
                    </Link>{" "}
                    in the meantime.
                  </p>
                </>
              )}
            </div>
          ) : (
            <>
              {/* Mobile: stacked cards — no horizontal scroll */}
              <ul className="sm:hidden divide-y divide-border">
                {filtered.map((r) => (
                  <li
                    key={r.id}
                    className="px-3 py-3 space-y-1.5 cursor-pointer hover:bg-bg-surface/40 transition-colors"
                    onClick={() => setActiveTxn(r)}
                  >
                    <div className="flex items-center justify-between gap-2 min-w-0">
                      <div className="min-w-0">
                        <p className="text-sm font-semibold text-text-primary truncate">
                          {r.name || "—"}
                          {r.roll && (
                            <span className="ml-1.5 font-mono text-xs text-text-muted">{r.roll}</span>
                          )}
                        </p>
                        <p className="text-xs text-text-muted mt-0.5">
                          {fmtTime(r.timestamp)} · {r.gate_name || r.gate_id || "—"}
                        </p>
                      </div>
                      <div className="flex items-center gap-1.5 shrink-0">
                        {r.direction === "IN" ? (
                          <span className="inline-flex items-center gap-1 text-action-success text-xs font-semibold">
                            <ArrowDownLeft className="w-3.5 h-3.5" /> In
                          </span>
                        ) : (
                          <span className="inline-flex items-center gap-1 text-action-danger text-xs font-semibold">
                            <ArrowUpRight className="w-3.5 h-3.5" /> Out
                          </span>
                        )}
                        {r.scan_type ? (
                          <span className="surface-card bg-amber-400/10 px-1.5 py-0.5 text-xs text-action-warning">Manual</span>
                        ) : r.is_correction ? (
                          <span className="surface-card bg-rose-400/10 px-1.5 py-0.5 text-xs text-action-danger">Correction</span>
                        ) : null}
                      </div>
                    </div>
                    {r.reason && <p className="text-xs text-text-muted">Reason: {r.reason}</p>}
                  </li>
                ))}
              </ul>

              {/* Desktop: table */}
              <div className="hidden sm:block overflow-x-auto min-w-0">
                <table className="w-full text-sm min-w160">
                  <thead>
                    <tr className="border-b border-border text-text-muted text-xs uppercase tracking-wide">
                      <th className="text-left px-3 py-2 font-semibold">Time</th>
                      <th className="text-left px-3 py-2 font-semibold">Person</th>
                      <th className="text-left px-3 py-2 font-semibold">Direction</th>
                      <th className="text-left px-3 py-2 font-semibold">Reason</th>
                      <th className="text-left px-3 py-2 font-semibold">Gate</th>
                      <th className="text-left px-3 py-2 font-semibold">Type</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-border">
                    {filtered.map((r) => (
                      <tr
                        key={r.id}
                        className="hover:bg-bg-surface transition-colors cursor-pointer"
                        onClick={() => setActiveTxn(r)}
                      >
                        <td className="px-3 py-2.5 text-text-muted text-xs whitespace-nowrap">
                          {fmtTime(r.timestamp)}
                        </td>
                        <td className="px-3 py-2.5 text-text-primary min-w-0">
                          <span className="font-semibold">{r.name || "—"}</span>
                          {r.roll && (
                            <span className="ml-1.5 font-mono text-xs text-text-muted">
                              {r.roll}
                            </span>
                          )}
                          {r.person_type && (
                            <span className="surface-card ml-1.5 px-1.5 py-0.5 text-xs text-text-muted uppercase">
                              {r.person_type}
                            </span>
                          )}
                        </td>
                        <td className="px-3 py-2.5 whitespace-nowrap">
                          {r.direction === "IN" ? (
                            <span className="inline-flex items-center gap-1 text-action-success text-xs font-semibold">
                              <ArrowDownLeft className="w-3.5 h-3.5" /> Entry
                            </span>
                          ) : (
                            <span className="inline-flex items-center gap-1 text-action-danger text-xs font-semibold">
                              <ArrowUpRight className="w-3.5 h-3.5" /> Exit
                            </span>
                          )}
                        </td>
                        <td className="px-3 py-2.5 text-text-muted text-xs">
                          {r.reason || "—"}
                        </td>
                        <td className="px-3 py-2.5 text-text-muted text-xs">
                          {r.gate_name || r.gate_id || "—"}
                        </td>
                        <td className="px-3 py-2.5 text-xs">
                          {r.scan_type ? (
                            <span className="surface-card bg-amber-400/10 px-2 py-0.5 text-action-warning font-medium">
                              Manual
                            </span>
                          ) : r.is_correction ? (
                            <span className="surface-card bg-rose-400/10 px-2 py-0.5 text-action-danger font-medium">
                              Correction
                            </span>
                          ) : (
                            <span className="text-text-muted">Scan</span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div className="surface-card px-3 py-2.5 text-xs text-text-muted flex items-center gap-1.5 min-w-0">
                <Clock className="w-3.5 h-3.5 shrink-0" />
                Auto-refreshes every 30 seconds.
              </div>
            </>
          )}
        </div>
      
      <EntityInspector inspection={activeTxn ? scanInspection(activeTxn) : null} onClose={() => setActiveTxn(null)} />
</OperatorWidgetBoundary>

      {reclassReceipt ? (
        <WhatHappenedReceipt
          summary={reclassReceipt}
          onDismiss={() => setReclassReceipt(null)}
        />
      ) : null}

      {activeTxn ? (
        <div className="border-t border-border pt-4 space-y-3">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <p className="text-sm font-semibold text-text-primary">
              Quick Reclassify Scan: {activeTxn.name || activeTxn.roll || activeTxn.id}
            </p>
            <button
              type="button"
              onClick={() => { setActiveTxn(null); setReclassError(null); }}
              className="text-xs text-text-muted hover:text-text-primary"
            >
              Close
            </button>
          </div>
          {reclassError ? (
            <p role="alert" className="text-xs text-action-danger">{reclassError}</p>
          ) : null}
          <div className="flex flex-wrap items-center gap-2">
            <select
              value={reclassCategory}
              onChange={(e) => setReclassCategory(e.target.value)}
              aria-label="Scan category"
              className="px-2.5 py-1.5 border-b border-border bg-transparent text-xs text-text-primary"
            >
              <option value="REGULAR">REGULAR</option>
              <option value="DAY_OUT">DAY_OUT</option>
              <option value="LEAVE">LEAVE</option>
              <option value="EMERGENCY">EMERGENCY</option>
              <option value="CORRECTION">CORRECTION</option>
            </select>
            <input
              type="text"
              value={reclassReason}
              onChange={(e) => setReclassReason(e.target.value)}
              placeholder="Mandatory audit reason..."
              aria-label="Reclassification reason"
              className="flex-1 min-w-[180px] px-2.5 py-1.5 border-b border-border bg-transparent text-xs text-text-primary"
            />
            <button
              type="button"
              disabled={reclassBusy}
              onClick={handleReclassify}
              className="px-3 py-1.5 rounded-lg bg-action-primary text-white text-xs font-semibold disabled:opacity-50"
            >
              {reclassBusy ? "Saving..." : "Reclassify Scan"}
            </button>
          </div>
        </div>
      ) : null}

    </div>
  );
}

export default function OperatorTransactionsPage() {
  return (
    <Suspense fallback={<OperatorPageLoading />}>
      <OperatorTransactionsInner />
    </Suspense>
  );
}
