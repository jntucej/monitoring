<file path="src/app/api/operator/stats/exit-reasons/route.ts">
/**
 * GET /api/operator/stats/exit-reasons
 *
 * Per-reason exit counts for a period + gate breakdown.
 *
 * Query params:
 *   period — "today" | "this-week" | "last-week" | "this-month" | "last-month" | "all"
 *   gateId — optional
 */

import { NextRequest } from "next/server";
import { withApiChain } from "@/lib/api-chain";
import { query } from "@/lib/postgres";
import { withAuthorization } from "@/middleware/authorization";
import { withRateLimit } from "@/lib/rate-limit";
import { ok, fail } from "@/server/http/response";
import { TIER } from "@/server/policy/roles";
import type { AuthContext } from "@/lib/authContext";

function periodBounds(period: string, now = new Date()): { from: string; to: string } {
  const d = (x: Date) => x.toISOString().slice(0, 10);
  const today = d(now);
  switch (period) {
    case "this-week": {
      const start = new Date(now);
      start.setDate(now.getDate() - ((now.getDay() + 6) % 7));
      return { from: d(start), to: today };
    }
    case "last-week": {
      const start = new Date(now);
      start.setDate(now.getDate() - ((now.getDay() + 6) % 7) - 7);
      const end = new Date(start);
      end.setDate(start.getDate() + 6);
      return { from: d(start), to: d(end) };
    }
    case "this-month":
      return { from: d(new Date(now.getFullYear(), now.getMonth(), 1)), to: today };
    case "last-month":
      return {
        from: d(new Date(now.getFullYear(), now.getMonth() - 1, 1)),
        to: d(new Date(now.getFullYear(), now.getMonth(), 0)),
      };
    default:
      return { from: today, to: today };
  }
}

async function implGet(req: NextRequest, { auth }: { auth: AuthContext }) {
  const sp = req.nextUrl.searchParams;
  const period = sp.get("period") ?? "today";
  const gateId = sp.get("gateId");
  const { from, to } = periodBounds(period);

  const gateWhere = gateId ? "AND m.gate_id = $3::uuid" : "";
  const params: unknown[] = [from, to];
  if (gateId) params.push(gateId);

  const reasonR = await query<{ reason: string; count: string }>(
    `SELECT m.reason AS reason, COUNT(*)::text AS count
       FROM movement_logs m
      WHERE m.direction = 'OUT'
        AND m.timestamp::date >= $1::date AND m.timestamp::date <= $2::date
        ${gateId ? "AND m.gate_id = $3::uuid" : ""}
      GROUP BY m.reason
      ORDER BY COUNT(*) DESC`,
    params
  );

  const perGateR = await query<{ gate_name: string; reason: string; count: string }>(
    `SELECT m.gate_name AS gate_name, m.reason AS reason, COUNT(*)::text AS count
       FROM movement_logs m
      WHERE m.direction = 'OUT'
        AND m.timestamp::date >= $1::date AND m.timestamp::date <= $2::date
        ${gateId ? "AND m.gate_id = $3::uuid" : ""}
      GROUP BY m.gate_name, m.reason
      ORDER BY m.gate_name, COUNT(*) DESC`,
    params
  );

  const total = reasonR.rows.reduce((s, r) => s + Number(r.count), 0);
  const lastWeek = period === "this-week" ? "last-week" : "last-month";
  const { from: pFrom, to: pTo } = periodBounds(lastWeek);
  const prevR = await query<{ total: string }>(
    `SELECT COUNT(*)::text AS total
       FROM movement_logs
      WHERE direction = 'OUT'
        AND timestamp::date >= $1::date AND timestamp::date <= $2::date`,
    [pFrom, pTo]
  );
  const prevTotal = Number(prevR.rows[0]?.total ?? 0);

  return ok({
    period,
    range: { from, to },
    total,
    prevTotal,
    delta: total - prevTotal,
    byReason: reasonR.rows.map((r) => ({
      reason: r.reason || "UNKNOWN",
      count: Number(r.count),
      pct: total > 0 ? Math.round((Number(r.count) / total) * 100) : 0,
    })),
    byGate: perGateR.rows.map((r) => ({
      gate: r.gate_name,
      reason: r.reason || "UNKNOWN",
      count: Number(r.count),
    })),
  });
}

export const GET = withApiChain(implGet, {
  route: "/api/operator/stats/exit-reasons",
  auth: "user",
  requiredRole: TIER.OPERATOR,
  rateLimit: { keyPrefix: "operator-exit-reasons", maxRequests: 30, windowMs: 60_000 },
});
</file>

<file path="src/app/api/operator/stats/weekly/route.ts">
/**
 * GET /api/operator/stats/weekly
 *
 * Operator's weekly shift stats: hours on shift, shift-wise breakdown,
 * last-week compare delta. For the operator's own console.
 *
 * Query params:
 *   week — "this" | "last" (default "this")
 */

import { NextRequest } from "next/server";
import { query } from "@/lib/postgres";
import { withAuthorization } from "@/middleware/authorization";
import { withRateLimit } from "@/lib/rate-limit";
import { ok } from "@/server/http/response";
import { TIER } from "@/server/policy/roles";
import type { AuthContext } from "@/lib/authContext";

function weekRange(which: "this" | "last", now = new Date()): { from: string; to: string } {
  const day = now.getDay(); // 0=Sun
  const diff = day === 0 ? -6 : 1 - day; // Monday
  const start = new Date(now);
  start.setDate(now.getDate() + diff);
  const end = new Date(start);
  end.setDate(start.getDate() + 6);
  const from = start.toISOString().slice(0, 10);
  const to = end.toISOString().slice(0, 10);
  if (which === "last") {
    const ls = new Date(start);
    ls.setDate(start.getDate() - 7);
    const le = new Date(ls);
    le.setDate(ls.getDate() + 6);
    return { from: ls.toISOString().slice(0, 10), to: le.toISOString().slice(0, 10) };
  }
  return { from, to };
}

export const GET = withAuthorization(
  async (req: NextRequest, { auth }: { auth: AuthContext }) => {
    const which = req.nextUrl.searchParams.get("week") === "last" ? "last" : "this";
    const { from, to } = weekRange(which);

    // Hours on shift from movement_logs (operator's own in/out)
    const hoursR = await query<{ hours: string; shifts: string }>(
      `WITH daily_moves AS (
         SELECT (timestamp AT TIME ZONE 'Asia/Kolkata')::date AS entry_date,
                MIN(timestamp) FILTER (WHERE direction = 'IN') AS entry_time,
                MAX(timestamp) FILTER (WHERE direction = 'OUT') AS exit_time
           FROM public.movement_logs
          WHERE user_id = $1::uuid
            AND (timestamp AT TIME ZONE 'Asia/Kolkata')::date >= $2::date
            AND (timestamp AT TIME ZONE 'Asia/Kolkata')::date <= $3::date
          GROUP BY (timestamp AT TIME ZONE 'Asia/Kolkata')::date
       )
       SELECT COALESCE(SUM(GREATEST(0, EXTRACT(EPOCH FROM (COALESCE(exit_time, entry_time) - entry_time)) / 3600)), 0)::text AS hours,
              COUNT(DISTINCT entry_date)::text AS shifts
         FROM daily_moves`,
      [auth.userId, from, to]
    );

    const hours = Math.round(Number(hoursR.rows[0]?.hours ?? 0) * 10) / 10;
    const shifts = Number(hoursR.rows[0]?.shifts ?? 0);

    // Per-day breakdown
    const dailyR = await query<{ day: string; hours: string }>(
      `WITH daily_moves AS (
         SELECT (timestamp AT TIME ZONE 'Asia/Kolkata')::date AS entry_date,
                MIN(timestamp) FILTER (WHERE direction = 'IN') AS entry_time,
                MAX(timestamp) FILTER (WHERE direction = 'OUT') AS exit_time
           FROM public.movement_logs
          WHERE user_id = $1::uuid
            AND (timestamp AT TIME ZONE 'Asia/Kolkata')::date >= $2::date
            AND (timestamp AT TIME ZONE 'Asia/Kolkata')::date <= $3::date
          GROUP BY (timestamp AT TIME ZONE 'Asia/Kolkata')::date
       )
       SELECT to_char(entry_date, 'YYYY-MM-DD') AS day,
              COALESCE(SUM(GREATEST(0, EXTRACT(EPOCH FROM (COALESCE(exit_time, entry_time) - entry_time)) / 3600)), 0)::text AS hours
         FROM daily_moves
        GROUP BY entry_date
        ORDER BY entry_date`,
      [auth.userId, from, to]
    );

    // Last week for delta
    const lw = weekRange("last");
    const lwR = await query<{ hours: string; shifts: string }>(
      `WITH daily_moves AS (
         SELECT (timestamp AT TIME ZONE 'Asia/Kolkata')::date AS entry_date,
                MIN(timestamp) FILTER (WHERE direction = 'IN') AS entry_time,
                MAX(timestamp) FILTER (WHERE direction = 'OUT') AS exit_time
           FROM public.movement_logs
          WHERE user_id = $1::uuid
            AND (timestamp AT TIME ZONE 'Asia/Kolkata')::date >= $2::date
            AND (timestamp AT TIME ZONE 'Asia/Kolkata')::date <= $3::date
          GROUP BY (timestamp AT TIME ZONE 'Asia/Kolkata')::date
       )
       SELECT COALESCE(SUM(GREATEST(0, EXTRACT(EPOCH FROM (COALESCE(exit_time, entry_time) - entry_time)) / 3600)), 0)::text AS hours,
              COUNT(DISTINCT entry_date)::text AS shifts
         FROM daily_moves`,
      [auth.userId, lw.from, lw.to]
    );
    const lastWeekHours = Math.round(Number(lwR.rows[0]?.hours ?? 0) * 10) / 10;
    const lastWeekShifts = Number(lwR.rows[0]?.shifts ?? 0);

    return ok({
      week: which,
      range: { from, to },
      hours,
      shifts,
      lastWeekHours,
      lastWeekShifts,
      hoursDelta: Math.round((hours - lastWeekHours) * 10) / 10,
      daily: dailyR.rows.map((r) => ({
        day: r.day,
        hours: Math.round(Number(r.hours) * 10) / 10,
      })),
    });
  },
  { requiredRole: TIER.OPERATOR }
);
</file>

<file path="src/app/api/operator/transactions/route.ts">
import { NextRequest, NextResponse } from "next/server";
import { withApiChain } from "@/lib/api-chain";
import { query } from "@/lib/postgres";
import { withAuthorization } from "@/middleware/authorization";
import { withRateLimit } from "@/lib/rate-limit";
import { TIER } from "@/server/policy/roles";
import type { AuthContext } from "@/lib/authContext";

/**
 * GET /api/operator/transactions
 *
 * Thin, read-only endpoint for the operator desk's "Transactions" section.
 *
 * Returns today's gate movement logs (Asia/Kolkata calendar day), optionally
 * scoped to the caller's assigned gate:
 *
 *   {
 *     success: true,
 *     data: {
 *       transactions: [{ id, roll, name, person_type, direction, reason,
 *                        gate_id, gate_name, timestamp, scan_type, created_at }],
 *       counts: { total, entries, exits, manual, flagged },
 *       gateScoped: boolean
 *     }
 *   }
 *
 * Operator-tier only — a gate operator must not pull another gate's flow.
 * Pure read: no writes, no mutations.
 */
interface TransactionRow {
  id: string;
  roll: string | null;
  name: string | null;
  person_type: string | null;
  direction: string;
  reason: string | null;
  gate_id: string | null;
  gate_name: string | null;
  timestamp: string;
  scan_type: string | null;
  created_at: string | null;
}

async function handleGet(req: NextRequest, { auth }: { auth: AuthContext }) {
  try {
    // Role gate: operator-tier roles only.
    if (!TIER.OPERATOR.includes(auth.role)) {
      return NextResponse.json(
        {
          success: false,
          error: { code: "FORBIDDEN", message: "Operator transactions are only available to operator-tier roles." },
        },
        { status: 403 }
      );
    }

    // Scoped to the caller's assigned gate when one exists.
    const callerGateId = auth.gateId || null;
    const isOperatorRole = auth.role === "operator";

    const params: unknown[] = [];
    let where = "(ml.timestamp AT TIME ZONE 'Asia/Kolkata')::date = (now() AT TIME ZONE 'Asia/Kolkata')::date";
    if (callerGateId && isOperatorRole) {
      where += " AND ml.gate_id = $1";
      params.push(callerGateId);
    }

    const rows: TransactionRow[] = (
      await query<TransactionRow>(
        `SELECT ml.id,
                u.unique_id   AS roll,
                u.name,
                u.role        AS person_type,
                ml.direction,
                ml.reason,
                ml.gate_id,
                ml.gate_name,
                ml.timestamp,
                ml.is_manual AS scan_type,
                ml.is_correction AS is_correction,
                ml.timestamp AS created_at
           FROM movement_logs ml
           LEFT JOIN users u ON u.id = ml.user_id
          WHERE ${where}
          ORDER BY ml.timestamp DESC
          LIMIT 200`,
        params
      )
    ).rows;

    const total = rows.length;
    const counts = {
      total,
      entries: rows.filter((r) => r.direction === "IN").length,
      exits: rows.filter((r) => r.direction === "OUT").length,
      manual: rows.filter((r) => r.scan_type === "manual" || r.scan_type === "MANUAL").length,
      // Flagged = correction scans or explicitly flagged reasons recorded today.
      flagged: rows.filter(
        (r) =>
          r.scan_type === "correction" ||
          r.scan_type === "CORRECTION" ||
          (r.reason && /flagged|hold|violation|blocked/i.test(String(r.reason)))
      ).length,
    };

    return NextResponse.json({
      success: true,
      data: {
        transactions: rows,
        counts,
        gateScoped: Boolean(callerGateId && isOperatorRole),
        gateId: callerGateId,
      },
    });
  } catch (error) {
    console.error("Operator transactions fetch error:", error);
    return NextResponse.json(
      {
        success: false,
        error: { code: "INTERNAL_ERROR", message: "Failed to fetch gate transactions." },
      },
      { status: 500 }
    );
  }
}

export const GET = withApiChain(handleGet, {
  route: "/api/operator/transactions",
  auth: "user",
  requiredRole: TIER.OPERATOR,
  rateLimit: { keyPrefix: "operator_transactions", maxRequests: 60 },
});

export const dynamic = "force-dynamic";
</file>

