          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 min-w-0">
            <div className="space-y-1.5 min-w-0">
              <label htmlFor="lookup-id" className="text-xs font-semibold text-text-primary uppercase tracking-wide">
                Roll / Employee / ID Number <span className="text-action-danger" aria-label="required">*</span>
              </label>
              <p className="text-xs text-text-muted -mt-1">Required — this is what the search looks up.</p>
              <input
                id="lookup-id"
                type="text"
                value={idNumber}
                onChange={(e) => setIdNumber(e.target.value.toUpperCase())}
                onKeyDown={(e) => { if (e.key === "Enter") void runLookup(); }}
                placeholder="e.g. 24JJ1A0501"
                aria-label="Roll, employee, or ID number to look up (required)"
                required
                className="surface-card w-full min-h-11 px-3 py-2.5 bg-bg-base font-mono text-sm text-text-primary uppercase placeholder-[var(--text-muted)] focus:ring-2 focus:ringfocus-ring outline-none"
              />
            </div>
            <div className="space-y-1.5 min-w-0">
              <label htmlFor="lookup-name" className="text-xs font-semibold text-text-muted uppercase tracking-wide">
                Name on ID <span className="text-text-muted/70 normal-case font-normal">(optional)</span>
              </label>
              <input
                id="lookup-name"
                type="text"
                value={name}
                onChange={(e) => setName(e.target.value)}
                placeholder="e.g. Aditi Sharma"
                aria-label="Name on the ID, optional"
                className="surface-card w-full min-h-11 px-3 py-2.5 bg-bg-base text-sm text-text-primary placeholder-[var(--text-muted)] focus:ring-2 focus:ringfocus-ring outline-none"
              />
            </div>
          </div>
          <button
            type="button"
            onClick={() => void runLookup()}
            disabled={lookupState === "loading" || !idNumber.trim()}
            className="surface-card w-full sm:w-auto inline-flex min-h-11 items-center justify-center gap-2 bg-action-primary px-4 py-2.5 text-sm font-bold text-black hover:brightness-110 disabled:opacity-40 transition disabled:cursor-not-allowed"
          >
            {lookupState === "loading" ? (
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none" />
            ) : (
              <Search className="w-4 h-4" />
            )}
            Look Up Person
          </button>
          <p className="text-xs text-text-muted" role="note">
            Look up by the ID number. The name is optional context — you don&#39;t need it to search.
          </p>
        </div>
      </OperatorWidgetBoundary>

      {/* Results */}
      {lookupState === "loading" && (
        <div className="surface-card bg-bg-elevated p-5 flex items-center gap-3 text-sm text-text-muted min-w-0">
          <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" />
          Looking up {lastQuery}…
        </div>
      )}

      {lookupState === "error" && (
        <div className="surface-card bg-rose-500/10 p-4 flex items-start gap-3 text-sm text-action-danger min-w-0">
          <AlertTriangle className="w-5 h-5 shrink-0 mt-0.5" />
          <div className="min-w-0">
            <p className="font-semibold">Lookup failed</p>
            <p className="text-xs mt-1">{lookupError}</p>
          </div>
        </div>
      )}

      {lookupState === "notfound" && (
        <div className="surface-card bg-amber-500/10 p-4 flex items-start gap-3 text-sm min-w-0">
          <XCircle className="w-5 h-5 text-action-warning shrink-0 mt-0.5" />
          <div className="min-w-0">
            <p className="font-semibold text-action-warning">No match for <span className="font-mono">{lastQuery}</span></p>
            <p className="text-xs text-text-muted mt-1">Double-check the number, or deny entry and log the incident.</p>
          </div>
        </div>
      )}

      {lookupState === "found" && result && (
        <>
          <div className={`rounded-xl border p-4 min-w-0 ${
            result.status === "ACTIVE" ? "border-emerald-500/30 bg-emerald-500/10" : "border-rose-500/40 bg-rose-500/10"
          }`}>
            <div className="flex items-start gap-3 min-w-0">
              <span className={`shrink-0 ${result.status === "ACTIVE" ? "text-action-success" : "text-action-danger"}`}>
                {result.status === "ACTIVE" ? <CheckCircle2 className="w-5 h-5" /> : <XCircle className="w-5 h-5" />}
              </span>
              <div className="min-w-0 flex-1">
                <div className="flex flex-wrap items-center gap-2 min-w-0">
                  <p className="text-sm font-bold text-text-primary">{result.name}</p>
                  <StatusBadge status={result.status} />
                  {/* L1: open the frontline subject sheet from the lookup result */}
                  <div className="ml-auto flex items-center gap-2">
                    <Link
                      href={`/operator/manual-entry?id=${encodeURIComponent(result.uniqueId)}`}
