                  </span>
                ) : (
                  <>
                    <p className="text-xs font-bold tabular-nums text-action-warning">{fmtDuration(e.minutesGone)} gone</p>
                    <p className="text-xs text-text-muted">
                      {fmtDuration(Math.max(0, e.limitMinutes - e.minutesGone))} left
