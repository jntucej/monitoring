import { DrawerItem } from "./DrawerItem";
import type { DrawerCategoryDef } from "./OperatorDrawer";

interface DrawerCategoryProps {
  category: DrawerCategoryDef;
  isOpen: boolean;
  onToggle: () => void;
}

export function DrawerCategory({ category, isOpen, onToggle }: DrawerCategoryProps) {
  const handleToggle = useCallback(() => {
    onToggle();
  }, [onToggle]);

  return (
    <div className="border-b border-border last:border-b-0">
      <button
        type="button"
        onClick={handleToggle}
        className={cn(
          "w-full min-h-11 flex items-center justify-between px-4 py-3 text-xs font-bold uppercase tracking-wider",
          "text-text-muted hover:text-text-primary hover:bg-bg-elevated",
          "transition-colors select-none"
