<file path="src/app/api/operator/claim-gate/route.ts">
import { NextRequest, NextResponse } from "next/server";
import { query } from "@/lib/postgres";
import { withMutationGuard } from "@/server/http/mutation-guard";
import { addAudit } from "@/lib/db";
import { invalidateAuthCache } from "@/lib/authContext";
import { RATE_LIMITS } from "@/config/app-constants";
import type { RateLimitConfig } from "@/lib/rate-limit";
import type { AuthContext } from "@/lib/authContext";
import type { Role } from "@/lib/types";
import { hashClaimCode, normalizeClaimCode } from "@/lib/claim-codes";

/**
 * Operator gate claim.
 *
 * POST /api/operator/claim-gate { code }
 *   An operator with NO assigned gate enters the claim string a supervisor
 *   generated (via /api/supervisor/claim-codes). The code is hashed, matched
 *   against an active / unexpired / unused / unrevoked row, and on a match the
 *   operator's users.gate_id is bound to that gate. One-use: the code row is
 *   marked used_at/used_by and cannot be replayed.
 *
 * On success the operator's auth row cache is evicted so the very next request
 * (and the in-memory auth store) sees the freshly-assigned gate_id.
 */

const limit: RateLimitConfig = { ...RATE_LIMITS.admin, keyPrefix: "operator_claim_gate" };

async function handlePost(req: NextRequest, ctx: { auth: AuthContext }): Promise<Response> {
  const body = await req.json().catch(() => ({}));
  const codeRaw = typeof body.code === "string" ? body.code : "";
  if (!normalizeClaimCode(codeRaw)) {
    return NextResponse.json(
      { success: false, error: { code: "CODE_REQUIRED", message: "Enter the gate-claim code your supervisor gave you." } },
      { status: 400 }
    );
  }

  const auth = ctx.auth;

  // Already assigned a gate? Claim is only for unassigned operators.
  if (auth.gateId) {
    return NextResponse.json(
      {
        success: false,
        error: {
          code: "ALREADY_ASSIGNED",
          message: `You already have a gate assigned (${auth.gateId}). Ask a supervisor to move you instead of claiming.`,
        },
      },
      { status: 409 }
    );
  }

  const codeHash = hashClaimCode(codeRaw);

  // Find the matching active claim row (scoped to active, unexpired, unused).
  const res = await query<{
    id: string;
    gate_id: string;
    gate_name: string;
    expires_at: string;
  }>(
    `SELECT c.id, c.gate_id, g.name AS gate_name, c.expires_at
       FROM public.gate_claim_codes c
       JOIN public.gates g ON g.id = c.gate_id
      WHERE c.code_hash = $1
        AND c.revoked = FALSE
        AND c.used_at IS NULL
        AND c.expires_at > NOW()
        AND g.is_active = TRUE
      LIMIT 1`,
    [codeHash]
  );

  const row = res.rows[0];
  if (!row) {
    return NextResponse.json(
      {
        success: false,
        error: {
          code: "CLAIM_CODE_INVALID",
          message: "That claim code is not valid (expired, already used, revoked, or not found). Ask your supervisor for a fresh code.",
        },
      },
      { status: 404 }
    );
  }

  // Bind the gate to this operator and mark the code used, in one statement
  // so a partial state can't be observed.
  await query(
    `UPDATE public.users SET gate_id = $1 WHERE id = $2`,
    [row.gate_id, auth.userId]
  );
  await query(
    `UPDATE public.gate_claim_codes
        SET used_at = NOW(), used_by = $2
      WHERE id = $1`,
    [row.id, auth.userId]
  );

  // Evict the cached user row so the next authenticated request carries the
  // fresh gate_id (and so any in-flight UI re-check sees the assignment).
  invalidateAuthCache(auth.userId);

  await addAudit({
    action: "GATE_CLAIMED",
    userId: auth.userId,
    userName: auth.email,
    role: auth.role as Role,
    details: JSON.stringify({ claimCodeId: row.id, gateId: row.gate_id, gateName: row.gate_name }),
  });

  return NextResponse.json({
    success: true,
    data: {
      gateId: row.gate_id,
      gateName: row.gate_name,
      note: "Gate assigned. You can now start at that gate.",
    },
  });
}

export const POST = withMutationGuard(handlePost, {requiredRole: ["operator", "supervisor", "sysadmin"], rateLimit: limit});
</file>

<file path="src/app/api/operator/gate/device-health/route.ts">
// /api/operator/gate/device-health/route.ts
// Operator one-click "device down" report. Writes an alert so the
// supervisor sees it in gate-live; marks the gate's device degraded in
// gate_logs context.

import { NextRequest } from "next/server";
import { withAuthorization } from "@/middleware/authorization";
import { withMutationGuard } from "@/server/http/mutation-guard";
import { ok, fail } from "@/server/http/response";
import { query } from "@/lib/postgres";
import type { AuthContext } from "@/lib/authContext";
import { recordMutationAudit } from "@/middleware/entityAuthorization";

async function implPost(req: NextRequest, ctx: { auth: AuthContext }) {
  const { auth } = ctx;
  const body = (await req.json().catch(() => null)) as {
    gateId?: string;
    device?: string;
    status?: string;   // DOWN | DEGRADED | RECOVERED
    note?: string;
  } | null;
  if (!body?.gateId || !body.status) {
    return fail("VALIDATION_ERROR", "gateId and status (DOWN|DEGRADED|RECOVERED) required", 400);
  }
  const status = body.status.toUpperCase();
  if (!["DOWN", "DEGRADED", "RECOVERED"].includes(status)) {
    return fail("VALIDATION_ERROR", "status must be DOWN | DEGRADED | RECOVERED", 400);
  }

  if (status === "RECOVERED") {
    // Resolve open device alerts for this gate.
    await query(
      `UPDATE public.alerts SET resolved = TRUE, resolved_at = now(), resolved_by = $3
        WHERE resource_type = 'gate_device' AND resource_id = $1 AND resolved = FALSE`,
      [body.gateId, null, auth.userId],
    );
  } else {
    const res = await query(
      `INSERT INTO public.alerts (severity, resource_type, resource_id, title, detail, created_by)
       VALUES ($1, 'gate_device', $2, $3, $4, $5)
       RETURNING id`,
      [status === "DOWN" ? "high" : "medium", body.gateId,
       `Gate device ${body.device ?? "unknown"} ${status.toLowerCase()}`,
       body.note?.trim() || null, auth.userId],
    );
  }

  await recordMutationAudit({
    actorId: auth.userId, roleContext: auth.role, action: "gate_device_health",
    resource: "gate", resourceId: body.gateId,
    afterState: { device: body.device ?? null, status, note: body.note ?? null },
  });
  return ok({ gateId: body.gateId, status });
}

export const POST = withMutationGuard(implPost, {
  requiredRole: ["operator", "supervisor", "admin", "sysadmin"],
  rateLimit: { keyPrefix: "gate-device-health", maxRequests: 10 },
});
</file>

<file path="src/app/api/operator/kiosk-session/route.ts">
import { NextRequest, NextResponse } from "next/server";
import { withRateLimit, rateLimitByKey, extractClientIp } from "@/lib/rate-limit";
import { signAccessToken, signRefreshToken } from "@/lib/auth-token";
import crypto from "crypto";
import { addAudit } from "@/lib/db";
import { assertCsrf } from "@/lib/csrf";
import {findKioskDefaultOperators, resolveKioskGateIdForOperator, verifyKioskPin}  from "@/lib/kiosk-operator";
import type { Role } from "@/lib/types";

/**
 * Kiosk session auth gate.
 *
 * This route mints an operator-scoped JWT for the designated kiosk default
 * operator. Because it grants OPERATOR without a login (no password, no
 * device attestation), access must be restricted to one of three modes:
 *
 *   1. TRUSTED_IP   — TRUSTED_KIOSK_IPS set (non-empty). The request client IP
 *                     must be in the comma-separated list, else 403
 *                     KIOSK_IP_NOT_TRUSTED. Fast-fails before rate limiting.
 *   2. PIN_REQUIRED — TRUSTED_KIOSK_IPS unset AND KIOSK_SESSION_REQUIRE_PIN
 *                     === 'true'. 426 UPGRADE_REQUIRED: the kiosk client must
 *                     collect a PIN from the operator before retrying.
 *   3. OPEN         — both env vars unset. Backwards-compatible open mode;
 *                     logs a one-time console.warn and allows the session.
 *
 * Modes 1 and 2 run BEFORE the rate-limit and audit paths so that
 * unauthorized callers cannot burn rate-limit quota.
 */
const KIOSK_AUTH_WARNED = { current: false };

export type KioskGateDecision =
  | { kind: "pass" }
  | { kind: "pin_missing" }
  | { kind: "pin_invalid"; pin: string }
  | { kind: "ip_not_trusted" }
  | { kind: "open" }
  | { kind: "open_refused" };

/**
 * Determine which gate applies. Does NOT verify the PIN — that happens in
 * `handleKioskSession` after the operator row is resolved, so we can
 * compare against `operator.password_hash`.
 */
async function kioskGateDecision(
  req: NextRequest,
  bodyPin?: string | null
): Promise<KioskGateDecision> {
  const trusted = (process.env.TRUSTED_KIOSK_IPS ?? "")
    .split(",")
    .map((s) => s.trim())
    .filter(Boolean);

  // Mode 1: TRUSTED_KIOSK_IPS allowlist
  if (trusted.length > 0) {
    const ip = extractClientIp(req);
    if (!trusted.includes(ip)) {
      return { kind: "ip_not_trusted" };
    }
    return { kind: "pass" };
  }

  // Mode 2: KIOSK_SESSION_REQUIRE_PIN=true → PIN must be supplied.
  // The actual bcrypt verification happens after operator resolution, because
  // we need the operator's password_hash to compare against.
  const requirePin = process.env.KIOSK_SESSION_REQUIRE_PIN === "true";
  if (requirePin) {
    if (bodyPin === undefined || bodyPin === null || bodyPin === "") {
      return { kind: "pin_missing" };
    }
    return { kind: "pin_invalid", pin: bodyPin };
  }

  // Mode 3: open (backwards compat). In production this is refused outright —
  // an open kiosk session is a privilege-escalation hole (any caller mints
  // operator tokens). Require TRUSTED_KIOSK_IPS or KIOSK_SESSION_REQUIRE_PIN.
  if (process.env.NODE_ENV === "production") {
    return { kind: "open_refused" };
  }
  if (!KIOSK_AUTH_WARNED.current) {
    KIOSK_AUTH_WARNED.current = true;
    console.warn(
      "[kiosk-session] No trusted IP or PIN requirement configured; kiosk session is open to any caller"
    );
  }
  return { kind: "open" };
}

function misconfiguredResponse(count: number) {
  return NextResponse.json(
    {
      success: false,
      error: {
        code: "KIOSK_MISCONFIGURED",
        message:
          count === 0
            ? "No kiosk default operator configured"
            : "Multiple kiosk default operators configured — exactly one is required",
      },
    },
    { status: 500 }
  );
}

/**
 * Mint an operator-scoped kiosk session for the designated kiosk default
 * operator. Auth modes (see kioskAuthGate above):
 *   TRUSTED_IP  — 403 unless client IP in TRUSTED_KIOSK_IPS
 *   PIN_REQUIRED — 426 unless operator PIN supplied
 *   OPEN        — backwards compat, warns once in logs
 *
 * Both GET and POST run the same handler. GET reads ?gateId and ?pin from
 * the query string; POST reads { gateId, pin } from the JSON body.
 */
async function handleKioskSession(
  req: NextRequest,
  bodyGateId?: string | null,
  bodyPin?: string | null
): Promise<Response> {
  const csrf = assertCsrf(req);
  if (csrf) return csrf;

  // Fail fast: IP allowlist / PIN gate BEFORE the rate-limit path so an
  // unauthorized caller cannot consume rate-limit quota.
  const decision = await kioskGateDecision(req, bodyPin ?? null);

  switch (decision.kind) {
    case "ip_not_trusted":
      return NextResponse.json(
        {
          success: false,
          error: {
            code: "KIOSK_IP_NOT_TRUSTED",
            message: "Client IP is not in TRUSTED_KIOSK_IPS",
          },
        },
        { status: 403 }
      );
    case "pin_missing":
      return NextResponse.json(
        {
          success: false,
          error: {
            code: "PIN_REQUIRED",
            message:
              "A kiosk operator PIN is required to mint a kiosk session. Show the operator PIN entry UI and retry with ?pin=<operator-pin>.",
          },
          upgradesRequired: true,
        },
        { status: 426 }
      );
    case "open":
      break; // open mode (non-production only) — proceed to session mint.
    case "open_refused":
      return NextResponse.json(
        {
          success: false,
          error: {
            code: "KIOSK_OPEN_REFUSED",
            message:
              "Kiosk open mode is disabled in production. Set KIOSK_SESSION_REQUIRE_PIN=true or TRUSTED_KIOSK_IPS to enable kiosk sessions.",
          },
          upgradesRequired: true,
        },
        { status: 426 }
      );
    case "pass":
      break; // trusted IP — proceed to session mint.
    case "pin_invalid":
      break; // verified after operator resolution below.
  }

  const ip = extractClientIp(req);
  const rl = await rateLimitByKey(`kiosk-session:${ip}`, {
    windowMs: 60_000,
    maxRequests: 6,
  });
  if (rl.limited) {
    return NextResponse.json(
      { success: false, error: { code: "RATE_LIMITED", message: "Too many kiosk mints" } },
      { status: 429, headers: { "Retry-After": String(rl.retryAfter ?? 60) } }
    );
  }

  const operators = await findKioskDefaultOperators();
  if (operators.length !== 1) return misconfiguredResponse(operators.length);

  const op = operators[0];
  if (op.status !== "ACTIVE") {
    return NextResponse.json(
      { success: false, error: { code: "ACCOUNT_INACTIVE", message: "Kiosk operator is not active" } },
      { status: 403 }
    );
  }

  // In PIN_REQUIRED mode, verify the supplied PIN against the operator's
  // stored password (bcrypt). The kiosk PIN is the operator's password in
  // the password-only auth model. A wrong or missing hash → reject.
  if (decision.kind === "pin_invalid") {
    const pinOk = await verifyKioskPin(op, decision.pin);
    if (!pinOk) {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: "PIN_INVALID",
            message: "Kiosk operator PIN is incorrect. Please retry.",
          },
        },
        { status: 401 }
      );
    }
  }

  const gateResolution = await resolveKioskGateIdForOperator(op, bodyGateId ?? null);

  // When the kiosk operator has NO assigned gate (and no valid hint), we
  // still mint the session — but with `noGate: true` so the client knows to
  // show the "Register / enter a claim code" panel instead of trying to
  // start scanning at a gate that doesn't exist yet.
  const noGate = !gateResolution || "error" in gateResolution;

  const jti = crypto.randomUUID();
  const access = await signAccessToken({
    sub: op.id,
    email: op.email ?? undefined,
    role: op.role as Role,
    account_status: op.status,
    name: op.name,
    session_version: op.session_version,
    kiosk: true,
    jti,
  });
  const refresh = await signRefreshToken({
    sub: op.id,
    email: op.email ?? undefined,
    role: op.role as Role,
    jti,
  });

  await addAudit({
    action: "OPERATOR_KIOSK_SESSION",
    userId: op.id,
    userName: op.name,
    role: op.role as Role,
    details: JSON.stringify({
      ip,
      gateId: noGate ? null : gateResolution!.gateId,
      requestedGateId: bodyGateId ?? null,
      noGate,
    }),
  });

  return NextResponse.json({
    success: true,
    data: {
      accessToken: access,
      refreshToken: refresh,
      gateId: noGate ? null : gateResolution!.gateId,
      noGate,
      operator: {
        id: op.id,
        name: op.name,
        uniqueId: op.unique_id,
        role: op.role,
      },
      expiresIn: 900,
    },
  });
}

export const POST = withRateLimit(
  async (req: NextRequest) => {
    let gateId: string | null = null;
    let pin: string | null = null;
    try {
      const body = (await req.json()) as Record<string, unknown>;
      gateId = typeof body.gateId === "string" ? body.gateId : null;
      pin = typeof body.pin === "string" ? body.pin : null;
    } catch {
      // No JSON body — fine, gateId/pin stay null.
    }
    return handleKioskSession(req, gateId, pin);
  },
  { windowMs: 60_000, maxRequests: 10 }
);

export const GET = withRateLimit(
  (req: NextRequest) => {
    const url = new URL(req.url);
    const gateId = url.searchParams.get("gateId");
    const pin = url.searchParams.get("pin");
    return handleKioskSession(req, gateId, pin);
  },
  { windowMs: 60_000, maxRequests: 10 }
);
</file>

