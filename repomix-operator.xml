"use client";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { Suspense, useCallback, useEffect, useState } from "react";
import { OperatorWidgetBoundary } from "@/components/operator/shared/OperatorWidgetBoundary";
import { OperatorPageLoading } from "@/components/operator/shared/OperatorLoading";

import { useAuthStore } from "@/stores/authStore";
import { usePolling } from "@/hooks/usePolling";
import { getAuthHeaders } from "@/lib/utils";
import {
  Loader2,
  Megaphone,
  Calendar,
  Clock,
  AlertTriangle,
  Inbox,
} from "lucide-react";

interface Announcement {
  id: string;
  title: string;
  body?: string;
  audience?: string;
  expires_at?: string;
  created_at?: string;
}

function OperatorAnnouncementsInner() {
  const user = useAuthStore((s) => s.user);
  const [announcements, setAnnouncements] = useState<Announcement[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const loadAnnouncements = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch("/api/announcements/active", {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const json = await res.json();
      if (res.ok && json.success) {
        setAnnouncements(json.data || []);
      } else {
        setError(json.error?.message || "Could not load announcements");
        setAnnouncements([]);
      }
    } catch {
      setError("Network error");
      setAnnouncements([]);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void loadAnnouncements(); }, [loadAnnouncements]);
  usePolling(loadAnnouncements, { intervalMs: 60_000, enabled: !!user });

  const fmtDate = (iso: string | undefined) =>
    iso ? new Date(iso).toLocaleDateString([], { month: "short", day: "numeric", year: "numeric" }) : "—";

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-5 py-6 min-w-0">
      <ContextSituationBar
        roleLabel="Gate Operator"
        purpose="Receive urgent security advisories, campus transit notices, and supervisory directives"
        contextLabel="Operational Bulletins"
        statusSummary="Review active administrative circulars, perimeter announcements, and emergency notices."
        why="Advisories dictate immediate protocol shifts such as temporary lockdowns, heightened visitor scrutiny, or event traffic rules."
        primaryAction={{ label: "Notifications Feed", href: "/operator/notifications" }}
        secondaryAction={{ label: "Gate Desk", href: "/operator" }}
      />
      <div className="flex items-center justify-between min-w-0">
        <div className="min-w-0">
          <div className="flex items-center gap-2 min-w-0">
            <Megaphone className="w-4 h-4 text-action-primary shrink-0" />
            <h2 className="text-lg font-bold text-text-primary truncate">Announcements</h2>
          </div>
          <p className="text-xs text-text-muted mt-1 min-w-0">
            Active campus announcements visible to your role.
          </p>
        </div>
        <button
          type="button"
          onClick={() => void loadAnnouncements()}
          disabled={loading}
          className="surface-card min-h-11 inline-flex items-center justify-center px-3 py-1.5 text-xs font-semibold text-text-primary hover:bg-bg-elevated transition shrink-0 disabled:opacity-50"
        >
          {loading ? (
            <span className="flex items-center gap-1.5"><Loader2 className="size-3.5 animate-spin" />Loading</span>
          ) : "Refresh"}
        </button>
      </div>

      {error && (
        <div className="surface-card bg-rose-500/10 p-3 text-sm text-action-danger flex items-center gap-2 min-w-0">
          <AlertTriangle className="w-4 h-4 shrink-0" />
          <span className="truncate">{error}</span>
        </div>
      )}

      <OperatorWidgetBoundary title="Active Announcements">
        <div className="rounded-xl border border-border bg-bg-elevated overflow-hidden min-w-0">
          {loading ? (
            <div className="p-6 flex items-center justify-center text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none mr-2 shrink-0" />
              Loading announcements…
            </div>
          ) : announcements.length === 0 ? (
            <div className="p-8 text-center min-w-0">
              <Inbox className="w-4 h-4 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No active announcements at this time.</p>
            </div>
          ) : (
            <ul className="divide-y divide-border min-w-0">
              {announcements.map((a) => (
                <li key={a.id} className="px-4 py-4 min-w-0">
                  <div className="flex items-start gap-3 min-w-0">
                    <Megaphone className="w-4 h-4 text-action-primary shrink-0 mt-0.5" />
                    <div className="min-w-0 flex-1">
                      <p className="text-sm font-semibold text-text-primary">{a.title}</p>
                      {a.body && <p className="text-xs text-text-muted mt-1 line-clamp-3">{a.body}</p>}
                      <div className="flex items-center gap-3 mt-2 text-xs text-text-muted">
                        {a.audience && (
                          <span className="surface-card px-1.5 py-0.5 uppercase">
                            {a.audience}
                          </span>
                        )}
                        <span className="flex items-center gap-1">
                          <Calendar className="size-3.5" />
                          {fmtDate(a.created_at)}
                        </span>
                        {a.expires_at && (
                          <span className="flex items-center gap-1">
                            <Clock className="size-3.5" />
                            Expires {fmtDate(a.expires_at)}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      </OperatorWidgetBoundary>

    </div>
  );
}

export default function OperatorAnnouncementsPage() {
  return (
    <Suspense fallback={<OperatorPageLoading />}>
      <OperatorAnnouncementsInner />
    </Suspense>
  );
}
