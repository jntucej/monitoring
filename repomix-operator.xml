"use client";
import React, { useState, memo } from "react";
import { User, ArrowDownLeft, ArrowUpRight, ChevronRight, ShieldCheck } from "lucide-react";
import { motion } from "framer-motion";
import type { Scan } from "@/lib/types";


interface RecentScansProps {
  scans: Scan[];
  onSelect?: (scan: Scan) => void;
}

type ScanFilter = "ALL" | "IN" | "OUT" | "FLAGGED";

/**
 * Memoized scan row. Stable reference so re-renders of the list don't
 * re-render every row — only the one whose props actually changed.
 * No motion wrapper inside: the animation is applied externally on the
 * newest row only.
 */
const Row = memo(function Row({
  scan,
  onSelect,
}: {
  scan: Scan;
  onSelect?: (scan: Scan) => void;
}) {
  return (
    <button
      type="button"
      onClick={() => onSelect?.(scan)}
      className="surface-card w-full flex items-center justify-between text-xs py-3 px-2 last: hover:bg-bg-base transition-colors text-left min-h-11"
    >
      <div className="flex items-center gap-3 min-w-0">
        <div className={`size-6 rounded-xl flex items-center justify-center shrink-0 ${scan.direction === "IN" ? "bg-emerald-500/10 text-action-success" : "bg-action-danger/10 text-action-danger"}`}>
          <User className="size-4" />
        </div>
        <div className="min-w-0">
          <p className="font-bold text-text-primary truncate">{scan.name}</p>
          <p className="text-xs text-text-muted font-mono">{scan.roll}</p>
          {scan.operatorName ? (
            <p className="text-xs text-text-secondary inline-flex items-center gap-1">
              <ShieldCheck className="size-3.5" /> by {scan.operatorName}
            </p>
          ) : null}
        </div>
      </div>
      <div className="flex items-center gap-2 shrink-0">
        <div className="text-right">
          <div className={`flex items-center gap-1 text-xs font-bold ${scan.direction === "IN" ? "text-action-success" : "text-action-danger"}`}>
            {scan.direction === "IN" ? (
              <>
                <ArrowDownLeft className="w-3.5 h-3.5" />
                <span>ENTRY</span>
              </>
            ) : (
              <>
                <ArrowUpRight className="w-3.5 h-3.5" />
                <span>EXIT</span>
              </>
            )}
          </div>
          <p className="text-xs text-text-muted">
            {new Date(scan.timestamp).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" })}
          </p>
        </div>
        <ChevronRight className="w-4 h-4 text-text-muted" />
      </div>
    </button>
  );
});

export function RecentScans({ scans, onSelect }: RecentScansProps) {

  const [filter, setFilter] = useState<ScanFilter>("ALL");

  const filteredScans = (scans || []).filter((scan) => {
    if (filter === "IN") return scan.direction === "IN";
    if (filter === "OUT") return scan.direction === "OUT";
    if (filter === "FLAGGED") {
      return scan.isCorrection === true || scan.isManual === true;
    }
    return true;
  });

  // Only animate the newest row (index 0); the rest are static <Row> — zero
  // per-row motion work on every stats poll.
  const newestId = filteredScans[0]?.id;

  return (
    <div className="surface-card bg-bg-surface p-5 space-y-4">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h3 className="font-semibold text-sm text-text-primary">Recent Access Activity</h3>
          <p className="text-xs text-text-muted mt-0.5">Tap any record to open the person overview.</p>
        </div>

        {/* Live Filter Stream */}
        <div className="surface-card flex items-center gap-1 bg-bg-elevated p-1 self-start sm:self-auto overflow-x-auto max-w-full no-scrollbar">
          {(["ALL", "IN", "OUT", "FLAGGED"] as ScanFilter[]).map((tab) => {
            const isActive = filter === tab;
            return (
              <button
                key={tab}
                type="button"
                onClick={() => setFilter(tab)}
                className={`px-2.5 py-1 rounded-lg text-xs font-bold tracking-wider transition-all ${
                  isActive
                    ? tab === "IN"
                      ? "bg-emerald-500/20 text-action-success border border-emerald-500/30"
                      : tab === "OUT"
                      ? "bg-rose-500/20 text-action-danger border border-rose-500/30"
                      : tab === "FLAGGED"
                      ? "bg-amber-500/20 text-action-warning border border-amber-500/30"
                      : "bg-action-primary text-white"
                    : "text-text-muted hover:text-text-primary"
                }`}
              >
                {tab}
              </button>
            );
          })}
        </div>
      </div>

      <div className="space-y-3.5 overscroll-y-contain max-h105 overflow-y-auto custom-scrollbar">
        {filteredScans.length > 0 ? (
          filteredScans.map((scan) =>
            scan.id === newestId ? (
              <motion.div
                key={scan.id}
                initial={{ opacity: 0, y: -8 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.18 }}
              >
                <Row scan={scan} onSelect={onSelect} />
              </motion.div>
            ) : (
              <Row key={scan.id} scan={scan} onSelect={onSelect} />
            )
          )
        ) : (
          <div className="text-center py-6 text-text-muted text-xs">
            No gate scans registered for filter &quot;{filter}&quot;.
          </div>
        )}
      </div>
    </div>
  );
}
</file>

