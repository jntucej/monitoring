<file path="src/app/(operator)/operator/pass-verification/page.tsx">
"use client";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { Suspense, useCallback, useState } from "react";
import { OperatorWidgetBoundary } from "@/components/operator/shared/OperatorWidgetBoundary";
import { OperatorPageLoading } from "@/components/operator/shared/OperatorLoading";

import { useAuthStore } from "@/stores/authStore";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { getAuthHeaders } from "@/lib/utils";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { passTicketInspection, useRoleInspectorHost } from "@/components/shared/roleInspectors";
import {
  Check,
  X,
  Loader2,
  Clock,
  AlertTriangle,
  Inbox,
} from "lucide-react";

/* ── response shapes (mirror /api/permissions) ── */

interface PermissionRow {
  id: string;
  ticket_number?: string;
  workflow_type?: string;
  current_stage?: string;
  status?: string;
  sla_deadline?: string | null;
  stage_history?: unknown;
  student?: {
    name?: string;
    unique_id?: string;
    student_details?: { roll?: string; year?: number; hostel_block?: string } | null;
  } | null;
  [key: string]: unknown;
}

interface PermissionsResponse {
  success: boolean;
  data: PermissionRow[];
  total?: number;
}

function safeText(v: string | number | null | undefined, fallback = "—"): string {
  const s = String(v ?? "").trim();
  if (!s || s === "undefined" || s === "NaN" || s.toLowerCase() === "null") return fallback;
  return s;
}

function PassVerificationInner() {
  const user = useAuthStore((s) => s.user);
  const { inspection, inspect, closeInspection, role } = useRoleInspectorHost();
  const [actingTicket, setActingTicket] = useState<string | null>(null);
  const [rejectingTicket, setRejectingTicket] = useState<string | null>(null);
  const [rejectComment, setRejectComment] = useState("");

  // Only hostel workflow at main_gate stage (what the operator can verify)
  const queueUrl = "/api/permissions?workflow_type=hostel&stage=main_gate&status=PENDING";

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<PermissionsResponse>(queueUrl, { ttlMs: 30_000 });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const rows = data?.data ?? [];
  const busy = loading && !data;

  const act = useCallback(
    async (ticket: string, action: "APPROVE" | "REJECT", comment?: string) => {
      const key = `${ticket}:${action}`;
      setActingTicket(key);
      try {
        const res = await fetch(`/api/permissions/${encodeURIComponent(ticket)}`, {
          method: "PATCH",
          headers: getAuthHeaders(),
          body: JSON.stringify({ action, comment }),
        });
        const json = await res.json();
        if (json.success) {
          refreshAll();
        } else {
          console.error("Pass action failed:", json.error?.message ?? json.error);
        }
      } catch (err) {
        console.error("Pass action failed:", err);
      } finally {
        setActingTicket(null);
      }
    },
    [refreshAll]
  );

  const handleRejectConfirm = (ticket: string) => {
    if (!rejectComment.trim()) return;
    void act(ticket, "REJECT", rejectComment.trim());
    setRejectingTicket(null);
    setRejectComment("");
  };

  const openPass = useCallback(
    (row: PermissionRow) => {
      const ticket = row.ticket_number ?? row.id;
      inspect(
        passTicketInspection(row, {
          role,
          onVerify: () => {
            void act(ticket, "APPROVE");
          },
          onReject: () => {
            setRejectingTicket(ticket);
            setRejectComment("");
          },
        }),
      );
    },
    [inspect, role, act],
  );

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-5 py-6 min-w-0">
      <ContextSituationBar
        roleLabel="Gate Operator"
        purpose="Verify student and visitor gate passes, approval signatures, and validity windows"
        contextLabel="Pass Verification Desk"
        statusSummary="Inspect QR digital passes, check active validity windows, and verify approver cryptographic signatures."
        why="Validating pass authenticity ensures students and visitors only cross perimeter points within their authorized time slots and designated gates."
        primaryAction={{ label: "Search Pass", href: "/operator/lookup" }}
        secondaryAction={{ label: "Daily Transactions", href: "/operator/transactions" }}
      />
      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">Queue unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card min-h-11 inline-flex items-center justify-center px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      <OperatorWidgetBoundary title="Verification Queue">
        <div className="rounded-xl border border-border bg-bg-elevated overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <span className="text-sm font-semibold text-text-primary min-w-0">
              Pending tickets
            </span>
            <span className="text-xs text-text-muted shrink-0">
              {busy ? "…" : `${rows.length} in queue`}
            </span>
          </div>

          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" />
              Loading verification queue…
            </div>
          ) : rows.length === 0 ? (
            <div className="p-6 text-center min-w-0">
              <Inbox className="w-5 h-5 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">
                Verification queue is clear — no pending passes at this stage.
              </p>
            </div>
          ) : (
            <ul className="divide-y divide-border min-w-0">
              {rows.map((row) => {
                const ticket = row.ticket_number ?? row.id;
                const key = `${ticket}:APPROVE`;
                const rejectKey = `${ticket}:REJECT`;
                const roll = row.student?.student_details?.roll;
                const sla = row.sla_deadline
                  ? new Date(row.sla_deadline)
                  : null;
                const slaBreached = sla ? sla.getTime() < Date.now() : false;
                return (
                  <li
                    key={row.id}
                    className="px-4 py-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between min-w-0 cursor-pointer hover:bg-bg-surface/40 transition-colors"
                    onClick={() => openPass(row)}
                  >
                    <div className="min-w-0 flex-1">
                      <p className="text-sm font-semibold text-text-primary truncate">
                        {row.student?.name || safeText(row.student?.unique_id, "Unknown applicant")}
                        {roll && (
                          <span className="ml-1.5 font-mono text-xs text-text-muted">
                            {roll}
                          </span>
                        )}
                      </p>
                      <p className="text-xs text-text-muted mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 min-w-0">
                        <span className="font-mono">{ticket}</span>
                        <span className="uppercase">
                          {safeText(row.workflow_type).replace(/_/g, " ")}
                        </span>
                        {sla && (
                          <span className={slaBreached ? "text-action-danger font-semibold" : ""}>
                            SLA {new Date(sla).toLocaleString([], { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })}
                            {slaBreached ? " · breached" : ""}
                          </span>
                        )}
                      </p>
                    </div>

                    {rejectingTicket === ticket ? (
                      <div className="flex flex-col gap-2 sm:flex-row sm:items-center w-full sm:w-auto min-w-0" onClick={(e) => e.stopPropagation()}>
                        <input
                          type="text"
                          value={rejectComment}
                          onChange={(e) => setRejectComment(e.target.value)}
                          placeholder="Reason for rejection (required)"
                          className="surface-card w-full sm:w-56 min-h-11 bg-bg-base px-2.5 py-1.5 text-xs text-text-primary placeholder-[var(--text-muted)] focus:ring-2 focus:ring-rose-500/40 outline-none"
                        />
                        <div className="flex flex-wrap items-center gap-2">
                          <button
                            type="button"
                            onClick={() => handleRejectConfirm(ticket)}
                            disabled={!rejectComment.trim() || actingTicket === rejectKey}
                            className="surface-card inline-flex min-h-11 items-center gap-1.5 bg-action-danger px-3 py-1.5 text-xs font-bold text-white hover:bg-action-danger disabled:opacity-50 transition-colors"
                          >
                            {actingTicket === rejectKey ? (
                              <Loader2 className="size-3.5 animate-spin motion-reduce:animate-none" />
                            ) : (
                              <X className="size-3.5" />
                            )}
                            Reject
                          </button>
                          <button
                            type="button"
                            onClick={() => {
                              setRejectingTicket(null);
                              setRejectComment("");
                            }}
                            className="surface-card min-h-11 inline-flex items-center px-3 py-1.5 text-xs font-semibold text-text-muted hover:text-text-primary transition-colors"
                          >
                            Cancel
                          </button>
                        </div>
                      </div>
                    ) : (
                      <div className="flex flex-wrap items-center gap-2 shrink-0" onClick={(e) => e.stopPropagation()}>
                        <button
                          type="button"
                          onClick={() => void act(ticket, "APPROVE")}
                          disabled={actingTicket === key}
                          className="surface-card inline-flex min-h-11 items-center gap-1.5 bg-action-success px-3 py-1.5 text-xs font-bold text-black hover:bg-action-success disabled:opacity-50 transition-colors"
                        >
                          {actingTicket === key ? (
                            <Loader2 className="size-3.5 animate-spin motion-reduce:animate-none" />
                          ) : (
                            <Check className="size-3.5" />
                          )}
                          Verify &amp; Approve
                        </button>
                        <button
                          type="button"
                          onClick={() => {
                            setRejectingTicket(ticket);
                            setRejectComment("");
                          }}
                          className="surface-card inline-flex min-h-11 items-center gap-1.5 bg-rose-500/10 px-3 py-1.5 text-xs font-semibold text-action-danger hover:bg-rose-500/20 transition-colors"
                        >
                          <X className="size-3.5" />
                          Reject
                        </button>
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          )}

          {!busy && rows.length > 0 && (
            <div className="surface-card px-4 py-2.5 text-xs text-text-muted flex items-center gap-1.5 min-w-0">
              <Clock className="w-3.5 h-3.5 shrink-0" />
              Auto-refreshes every 30 seconds. Tap a ticket to inspect before acting.
            </div>
          )}
        </div>
      </OperatorWidgetBoundary>

      <EntityInspector inspection={inspection} onClose={closeInspection} />
    </div>
  );
}

export default function PassVerificationPage() {
  return (
    <Suspense fallback={<OperatorPageLoading />}>
      <PassVerificationInner />
    </Suspense>
  );
}
