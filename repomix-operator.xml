import { NextRequest, NextResponse } from "next/server";
import { withApiChain } from "@/lib/api-chain";
import { withAuthorization } from "@/middleware/authorization";
import { withRateLimit } from "@/lib/rate-limit";
import { query } from "@/lib/postgres";

/**
 * GET /api/operator/last-scan?userId=<uuid>
 * The most recent movement log for a looked-up person, so the lookup
 * screen can show "last seen IN at Main Gate 2h ago" without a separate
 * round trip per person.
 */
async function handleGet(req: NextRequest) {
  const { searchParams } = new URL(req.url);
  const userId = searchParams.get("userId");
  if (!userId) {
    return NextResponse.json(
      { success: false, error: { code: "BAD_REQUEST", message: "userId is required." } },
      { status: 400 }
    );
  }
  // movement_logs.user_id is a uuid; the lookup form may pass a roll number
  // or a uuid — resolve to the user row first.
  const isUuid = /^[0-9a-f-]{36}$/i.test(userId);
  const { rows } = await query(
    isUuid
      ? `SELECT u.id AS user_uuid FROM users u WHERE u.id = $1 LIMIT 1`
      : `SELECT u.id AS user_uuid FROM users u WHERE u.unique_id = $1 OR u.handle = $1 OR u.login_identifier = $1 LIMIT 1`,
    [userId]
  );
  const uid = rows[0]?.user_uuid;
  if (!uid) return NextResponse.json({ success: true, data: null });
  const { rows: scan } = await query(
    `SELECT ml.id, ml.direction, ml.gate_id, ml.is_manual, ml.timestamp,
            g.name AS gate_name
       FROM movement_logs ml
       LEFT JOIN gates g ON g.id = ml.gate_id
      WHERE ml.user_id = $1
      ORDER BY ml.timestamp DESC
      LIMIT 1`,
    [uid]
  );
  const r = scan[0];
  return NextResponse.json({
    success: true,
    data: r
      ? {
          direction: r.direction,
          gateName: r.gate_name ?? null,
          gateId: r.gate_id,
          isManual: r.is_manual,
          at: r.timestamp,
        }
      : null,
  });
}

export const GET = withApiChain(handleGet, {
  route: "/api/operator/last-scan",
  auth: "user",
  requiredRole: ["operator", "supervisor", "admin", "sysadmin"],
  rateLimit: { keyPrefix: "operator_last_scan", maxRequests: 60 },
});
</file>

<file path="src/app/api/operator/lookup/route.ts">
import { NextRequest, NextResponse } from "next/server";
import { withApiChain } from "@/lib/api-chain";
import { findPersonByUniqueId } from "@/lib/db";
import { withAuthorization } from "@/middleware/authorization";
import { withRateLimit } from "@/lib/rate-limit";
import { TIER } from "@/server/policy/roles";
import type { AuthContext } from "@/lib/authContext";

/**
 * GET /api/operator/lookup?id=24JJ1A0501
 *
 * Thin, read-only lookup endpoint for the operator desk's "Manual Entry"
 * section: resolves a name / roll / employee id against the users +
 * student_details + employee_details tables so the operator can display a
 * verification result card without needing the scan flow.
 *
 * Operator-tier only — mirrors the sibling operator routes.
 * Pure read: no writes, no mutations.
 */
async function handleGet(req: NextRequest, { auth }: { auth: AuthContext }) {
  try {
    // Role gate: operator-tier roles only.
    if (!TIER.OPERATOR.includes(auth.role)) {
      return NextResponse.json(
        {
          success: false,
          error: { code: "FORBIDDEN", message: "Lookup is only available to operator-tier roles." },
        },
        { status: 403 }
      );
    }

    const rawId = req.nextUrl.searchParams.get("id")?.trim() || "";
    if (!rawId) {
      return NextResponse.json(
        {
          success: false,
          error: { code: "BAD_REQUEST", message: "Query param ?id is required." },
        },
        { status: 400 }
      );
    }

    const person = await findPersonByUniqueId(rawId);
    if (!person) {
      return NextResponse.json(
        {
          success: true,
          data: { found: false, id: rawId.toUpperCase() },
        },
        { status: 200 }
      );
    }

    const studentDetails = person.studentDetails ?? null;
    const employeeDetails = person.employeeDetails ?? null;

    return NextResponse.json({
      success: true,
      data: {
        found: true,
        id: rawId.toUpperCase(),
        person: {
          id: person.id,
          name: person.fullName || person.name || "Unknown",
          uniqueId: person.uniqueId,
          personType: person.personType,
          status: person.status,
          department: studentDetails?.hostelBlock || person.department || null,
          year: studentDetails?.year ?? null,
          roomNumber: studentDetails?.roomNumber ?? null,
          designation: employeeDetails?.designation ?? null,
          onCampus: Boolean(person.checkedInAt && !person.checkedOutAt),
        },
      },
    });
  } catch (error) {
    console.error("Operator lookup error:", error);
    return NextResponse.json(
      {
        success: false,
        error: { code: "INTERNAL_ERROR", message: "Failed to look up person." },
      },
      { status: 500 }
    );
  }
}

export const GET = withApiChain(handleGet, {
  route: "/api/operator/lookup",
  auth: "user",
  requiredRole: TIER.OPERATOR,
  rateLimit: { keyPrefix: "operator_lookup", maxRequests: 30 },
});

export const dynamic = "force-dynamic";
