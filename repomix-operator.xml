                  className="min-h-11 rounded-lg bg-bg-elevated px-2.5 py-1.5 text-xs text-text-primary"
                >
                  <option value="REGULAR">Regular Entry</option>
                  <option value="RETURN">Pass Return</option>
                  <option value="LATE">Late Entry</option>
                </select>
              )}
              <input
                type="text"
                value={quickReason}
                onChange={(e) => setQuickReason(e.target.value)}
                placeholder="Reason (optional)…"
                aria-label="Scan reason"
                className="min-h-11 flex-1 min-w-[140px] rounded-lg bg-bg-elevated px-3 py-1.5 text-xs text-text-primary"
              />
              <button
                type="button"
                disabled={Boolean(quickBusy)}
                onClick={() => void handleQuickRecord("IN")}
                className="min-h-11 rounded-lg bg-action-success px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50"
              >
                {quickBusy === "IN" ? "Recording…" : "Record IN"}
              </button>
              <button
                type="button"
                disabled={Boolean(quickBusy)}
                onClick={() => void handleQuickRecord("OUT")}
                className="min-h-11 rounded-lg bg-action-danger px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50"
              >
                {quickBusy === "OUT" ? "Recording…" : "Record OUT"}
              </button>
            </div>
            {quickFeedback && (
              <p className="text-xs font-medium text-action-primary">{quickFeedback}</p>
            )}
          </div>

          {/* Last scan + gate status */}
          <OperatorWidgetBoundary title="Last Scan & Gate Status">
            <div className="rounded-xl border border-border bg-bg-elevated overflow-hidden min-w-0">
              {lastScanLoading ? (
                <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
                  <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" />
                  Loading scan history…
                </div>
              ) : lastScanError ? (
                <div className="p-4 text-sm text-action-danger min-w-0">Could not load scan history.</div>
              ) : lastScanData?.data ? (
                <div className="p-4 space-y-2 min-w-0">
                  <div className="flex items-center justify-between gap-2 min-w-0">
                    <div className="min-w-0">
                      <div className="flex items-center gap-2">
                        {lastScanData.data.direction === "IN" ? (
                          <ArrowDownLeft className="w-4 h-4 text-action-success shrink-0" />
                        ) : (
                          <ArrowUpRight className="w-4 h-4 text-action-danger shrink-0" />
                        )}
                        <p className="text-sm font-semibold text-text-primary">
                          {lastScanData.data.direction === "IN" ? "Entry" : "Exit"} · {fmtTime(lastScanData.data.timestamp)}
                        </p>
                      </div>
                      <p className="text-xs text-text-muted mt-0.5">{lastScanData.data.gate_name || "—"}</p>
                    </div>
                    <div className="flex items-center gap-1.5 shrink-0">
                      <Clock className="w-3.5 h-3.5 text-text-muted" />
                      <span className="text-xs text-text-muted">
                        {new Date(lastScanData.data.timestamp).toLocaleDateString([], { month: "short", day: "numeric" })}
                      </span>
                    </div>
                  </div>
                  {lastScanData.data.reason && (
                    <p className="text-xs text-text-muted">
                      Reason: <SmartTextRef text={lastScanData.data.reason} currentPath="/operator/lookup" />
                    </p>
                  )}
                </div>
              ) : (
                <div className="p-6 text-center min-w-0">
                  <Clock className="w-5 h-5 text-text-muted mx-auto mb-2" />
                  <p className="text-sm text-text-muted">No scan history for this person.</p>
                </div>
              )}
            </div>
          </OperatorWidgetBoundary>
        </>
      )}

      {/* L1 FrontlinePivot: duty-scoped subject sheet */}
      <FrontlineSubjectSheet
        subject={frontlineSubject}
        onClose={() => setFrontlineSubject(null)}
      />
    </div>
  );
}

export default function OperatorLookupPage() {
  return (
    <Suspense fallback={<OperatorPageLoading />}>
      <OperatorLookupInner />
    </Suspense>
  );
