"use client";

import { useEffect } from "react";
import { AlertTriangle, RefreshCw } from "lucide-react";
import { reportClientError } from "@/lib/monitoring";

export default function OperatorError({
  error,
  reset,
}: {
  error: Error & { digest?: string };
  reset: () => void;
}) {
  useEffect(() => {
    reportClientError(error, { route: "operator", component: "OperatorError", digest: error.digest });
  }, [error]);

  return (
    <div className="flex min-h-[60vh] items-center justify-center p-6">
      <div className="surface-card max-w-md w-full p-6 text-center space-y-4">
        <div className="mx-auto size-6 rounded-full bg-action-danger/10 flex items-center justify-center">
          <AlertTriangle className="w-6 h-6 text-action-danger" />
        </div>
        <h2 className="text-lg font-semibold text-text-primary">Something went wrong</h2>
        <p className="text-sm text-text-secondary">
          {error.message || "An unexpected error occurred in this workspace."}
        </p>
        {error.digest ? (
          <p className="text-xs text-text-muted font-mono">ref: {error.digest}</p>
        ) : null}
        <button
          type="button"
          onClick={reset}
          className="surface-card inline-flex items-center gap-2 bg-action-primary px-4 py-2 text-sm font-medium text-white hover:opacity-90"
        >
          <RefreshCw className="w-4 h-4" />
          Try again
        </button>
      </div>
    </div>
  );
}
