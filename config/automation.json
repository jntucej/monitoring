{
  "project": {
    "name": "Gate Monitor",
    "key": "GATE",
    "type": "software"
  },
  "generation": {
    "create_only_if_missing": true,
    "overwrite_existing": false,
    "output_fields": [
      "Summary",
      "Description",
      "Issue Type",
      "Priority",
      "Status",
      "Labels"
    ]
  },
  "paths": {
    "config_dir": "config",
    "issues": "data",
    "data_dir": "data",
    "roles_schema": "team/roles_schema.csv",
    "jira_schema": "config/jira/jira-schema.json",
    "jira_import_dir": "jira/import",
    "automation": "jira/import"
  },
  "files": {
    "issue_pattern": "*.csv"
  }
}
