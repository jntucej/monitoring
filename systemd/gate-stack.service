[Unit]
Description=Gate Monitor Containerized Application Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
MemoryHigh=4G
MemoryMax=6G
CPUQuota=200%
IOWeight=100
TasksMax=4096
KillMode=control-group
WorkingDirectory=/opt/monitoring/compose
ExecStart=/usr/bin/docker compose --file /opt/monitoring/compose/docker-compose.yml --env-file /opt/monitoring/env/production.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --file /opt/monitoring/compose/docker-compose.yml --env-file /opt/monitoring/env/production.env down
ExecReload=/usr/bin/docker compose --file /opt/monitoring/compose/docker-compose.yml --env-file /opt/monitoring/env/production.env pull && /usr/bin/docker compose --file /opt/monitoring/compose/docker-compose.yml --env-file /opt/monitoring/env/production.env up -d --remove-orphans
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
