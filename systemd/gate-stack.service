[Unit]
Description=Gate Monitor base stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/akarsh/gate-monitor
ExecStart=/usr/bin/docker compose -f docker-compose.base.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.base.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
