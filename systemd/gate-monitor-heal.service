[Unit]
Description=Gate Monitor Auto-Heal Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=gate-monitor
WorkingDirectory=/opt/monitoring/compose
EnvironmentFile=/etc/gate-monitor/gate-monitor.env
ExecStart=/bin/bash /opt/monitoring/compose/scripts/auto-heal-agent.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
