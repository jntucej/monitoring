# CIS Ubuntu 22.04 LTS v3.0.0 Benchmark - Auditd Rules for Gate Monitor
# Destination: /etc/audit/rules.d/gate-monitor.rules

# Identity and auth
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/sudoers -p wa -k sudoers
-w /etc/ssh/sshd_config -p wa -k sshd

# App secrets & configuration
-w /opt/monitoring/compose/.env -p rwa -k app_secrets

# Backups (tamper detection)
-w /opt/monitoring/backups/ -p wd -k backup_tamper

# Docker configuration & state
-w /etc/docker/daemon.json -p wa -k docker
-w /var/lib/docker/ -p wd -k docker_data

# Privilege escalation via root execve
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=-1 -k root_exec
