{
    admin off
    log {
        output stdout
        format json
    }
    # Cap the maximum request body size for the whole instance (default is
    # unbounded — a client can send multi-GB bodies and exhaust disk/memory
    # before Next.js or the API route sees it). 250 MB covers the largest
    # legitimate upload (bulk-import CSVs, permission documents).
    request_body {
        max 250mb
    }
}

:80 {
    log {
        output stdout
        format json
    }

    # L3 — CVE-2025-29927 belt-and-braces: strip any client-supplied
    # middleware-subrequest header before it reaches Next.js. Next.js sets
    # this header internally to bypass its own middleware on sub-requests;
    # a client must NEVER be able to set it. Next 14.2.25+/15.2.3+ patched
    # the framework, but defense-in-depth strips it at the proxy layer so
    # a future middleware variant can't be walked past by a future client.
    @bypass_hdr header x-middleware-subrequest *
    respond @bypass_hdr "Bad Request" 400

    header {
        X-Frame-Options        "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy        "strict-origin-when-cross-origin"
        Permissions-Policy     "camera=(self), microphone=(self), geolocation=(self)"
        # L2: CSP is now set per-request by the Next.js edge middleware
        # (nonce + strict-dynamic, see src/middleware.ts). Caddy must not
        # add its own static CSP header here — two CSP headers conflict and
        # the browser enforces the strictest one, blocking all chunks.
        # Other security headers remain in Caddy; the CSP header is
        # excluded (stripped below) so only the per-request one from the
        # web server reaches the browser.
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        -Server
        -X-Powered-By
        -X-Client-IP
        -X-Forwarded-For
        -X-Real-IP
        -X-Auth-User
        -X-Auth-Timestamp
        -X-Auth-Signature
        # L3: strip the middleware bypass header (case-insensitive)
        -X-Middleware-Subrequest
        # Strip client-supplied forwarding headers so a malicious client over
        # HTTP cannot forge X-Forwarded-Proto and leak Secure-flag cookies.
        -X-Forwarded-Proto
        -X-Forwarded-Host
    }

    # DR §7: /status is the one page that must NEVER depend on Next.js.
    # Caddy serves the static fallback page directly. The page fetches
    # /api/status (live) and falls back to /status-last.json (last known
    # good, written by the worker's infra-snapshot job every 60s).
    handle /status {
        root * /usr/share/status
        try_files /status.html
        file_server
    }

    handle /status-last.json {
        root * /usr/share/status
        file_server
    }

    handle {
        reverse_proxy web:3000 {
            flush_interval -1
            header_up X-Client-IP {remote_host}
            header_up X-Real-IP   {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}
