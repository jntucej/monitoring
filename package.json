{
  "name": "mycampus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/validate-env.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node worker/index.mjs",
    "start:worker": "node worker/index.mjs",
    "typecheck": "tsc --noEmit",
    "verify:phase2": "node scripts/verify-layering.js",
    "verify:admin-independence": "bash scripts/check-admin-independence.sh",
    "verify:admin-layers": "npm run verify:admin-independence && npm run verify:phase2",
    "test:ci": "bash scripts/check-tests-nonempty.sh",
    "test:unit": "npx tsx scripts/run_system_tests.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/login-success.spec.ts",
    "test:e2e:smoke:auth": "SMOKE_USER=admin SMOKE_PASS=123456 playwright test tests/login-success.spec.ts",
    "lint": "eslint src",
    "kb:ingest": "node scripts/ingest-kb.mjs",
    "kb:ingest:warden": "node scripts/ingest-kb.mjs --dir docs/kb/warden --role warden,admin,sysadmin",
    "verify:permission-workflow": "npx tsx scripts/verify-permission-workflow.ts",
    "scaffold:panel": "node scripts/scaffold-panel.mjs",
    "dash:audit": "node scripts/dashboard-doctor.mjs audit",
    "dash:report": "node scripts/dashboard-doctor.mjs report > DASHBOARDS.md",
    "dash:fix": "node scripts/dashboard-doctor.mjs fix --all --write",
    "dash:routes": "node scripts/dashboard-doctor.mjs routes",
    "dash:dead": "node scripts/dashboard-doctor.mjs dead",
    "dash:ci": "node scripts/check-dashboards.mjs",
    "test:gate": "jest --config tests/gate/jest.config.mjs",
    "test:gate:node": "jest --config tests/gate/jest.config.mjs --selectProjects node",
    "test:gate:ui": "jest --config tests/gate/jest.config.mjs --selectProjects ui",
    "test:gate:e2e": "jest --config tests/gate/jest.config.mjs tests/gate/e2e",
    "test:gate:ci": "jest --config tests/gate/jest.config.mjs --ci --coverage",
    "test:gate:watch": "jest --config tests/gate/jest.config.mjs --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@remotion/player": "^4.0.518",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@supabase/supabase-js": "^2.112.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.0",
    "jose": "^6.2.12",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.8",
    "nodemailer": "^6.9.16",
    "node-cron": "^4.6.0",
    "p-limit": "^3.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "rate-limiter-flexible": "^11.2.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-qrcode-logo": "^4.1.0",
    "recharts": "^3.10.1",
    "remotion": "^4.0.518",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "typescript": "^5"
  }
}
