/Caddyfile                     @jntucej/platform

# Database
/database/                     @jntucej/database
/scripts/check-migrations.sh   @jntucej/database
/scripts/check-rls*.sh         @jntucej/database
/scripts/check-audit*.sh       @jntucej/database

# Security scanning config
