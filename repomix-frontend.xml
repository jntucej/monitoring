<file path="src/components/admin/PassTypesForm.tsx">
"use client";

import { useEffect, useState } from "react";
import { FileBadge, Save, Loader2, Plus, Trash2, CheckCircle2, AlertCircle } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";

interface PassType {
  code: string;
  name: string;
  requiresApproval: boolean;
  approvalFlow: string;
  isActive: boolean;
}

const EMPTY_TYPE: PassType = {
  code: "",
  name: "",
  requiresApproval: true,
  approvalFlow: "principal",
  isActive: true,
};

export function PassTypesForm() {
  const [data, setData] = useState<PassType[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState<{ type: "success" | "error"; text: string } | null>(null);

  const fetchPassTypes = async () => {
    try {
      const res = await fetch("/api/config/pass-types", { headers: getAuthHeaders() });
      const json = await res.json();
      if (json.success && Array.isArray(json.data)) {
        setData(
          json.data.map((item: any) => ({
            code: item.code ?? "",
            name: item.name ?? "",
            requiresApproval: item.requiresApproval ?? item.requires_approval ?? true,
            approvalFlow: item.approvalFlow ?? item.approval_flow ?? "principal",
            isActive: item.isActive ?? item.is_active ?? true,
          }))
        );
      }
    } catch {
      // keep empty on fetch error
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    void fetchPassTypes();
  }, []);

  const updateType = (index: number, key: keyof PassType, value: string | boolean) => {
    setData((prev) =>
      prev.map((item, i) => (i === index ? { ...item, [key]: value } : item))
    );
  };

  const addType = () => {
    setData((prev) => [...prev, { ...EMPTY_TYPE }]);
  };

  const removeType = (index: number) => {
    setData((prev) => prev.filter((_, i) => i !== index));
  };

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    setSaving(true);
    setMessage(null);
    try {
      const res = await fetch("/api/config/pass-types", {
        method: "PATCH",
        headers: getAuthHeaders(),
        body: JSON.stringify(
          data
            .filter((item) => item.code.trim() && item.name.trim())
            .map((item) => ({
              code: item.code,
              name: item.name,
              requiresApproval: item.requiresApproval,
              approvalFlow: item.approvalFlow,
            }))
        ),
      });
      const json = await res.json();
      if (json.success) {
        setMessage({ type: "success", text: "Pass types saved." });
      } else {
        setMessage({ type: "error", text: json.error?.message || "Failed to save pass types." });
      }
    } catch {
      setMessage({ type: "error", text: "An error occurred while saving." });
    } finally {
      setSaving(false);
    }
  };

  if (loading) {
    return (
      <div className="surface-card bg-bg-surface p-6">
        <h3 className="font-semibold flex items-center gap-2 mb-4">
          <FileBadge className="w-5 h-5 text-action-primary" />
          Pass Types
        </h3>
        <div className="flex justify-center p-6">
          <Loader2 className="w-5 h-5 animate-spin text-text-muted" />
        </div>
      </div>
    );
  }

  const inputCls =
    "w-full px-2 py-1.5 bg-bg-base border border-border rounded text-xs text-text-primary";

  return (
    <form
      onSubmit={handleSave}
      className="surface-card bg-bg-surface p-6 flex flex-col h-full"
    >
      <div className="flex justify-between items-center mb-4">
        <h3 className="font-semibold flex items-center gap-2">
          <FileBadge className="w-5 h-5 text-action-primary" />
          Pass Types
        </h3>
        <button
          type="button"
          onClick={addType}
          className="surface-card text-xs flex items-center gap-1 bg-bg-base px-2 py-1 hover:bg-[var(--bg-surface-hover)] text-text-primary"
        >
          <Plus className="size-3.5" /> Add Type
        </button>
      </div>

      <div className="space-y-3 flex-1">
        {data.length === 0 && (
          <p className="text-xs text-text-muted text-center py-4">No pass types configured.</p>
        )}

        {data.map((item, i) => (
          <div
            key={i}
            className="surface-card grid grid-cols-1 md:grid-cols-12 gap-3 items-center p-3 bg-bg-base"
          >
            <div className="md:col-span-3">
              <label className="block text-xs uppercase text-text-muted mb-1" htmlFor="code">Code</label>
              <input id="code"
                type="text"
                value={item.code}
                onChange={(e) => updateType(i, "code", e.target.value)}
                className={inputCls}
                required
              />
            </div>
            <div className="md:col-span-3">
              <label className="block text-xs uppercase text-text-muted mb-1" htmlFor="name">Name</label>
              <input id="name"
                type="text"
                value={item.name}
                onChange={(e) => updateType(i, "name", e.target.value)}
                className={inputCls}
                required
              />
            </div>
            <div className="md:col-span-2">
              <label className="block text-xs uppercase text-text-muted mb-1" htmlFor="approval-flow">Approval Flow</label>
              <input id="approval-flow"
                type="text"
                value={item.approvalFlow}
                onChange={(e) => updateType(i, "approvalFlow", e.target.value)}
                className={inputCls}
              />
            </div>
            <div className="md:col-span-3 flex items-center gap-4 pt-4">
              <label className="text-xs flex items-center gap-1 text-text-primary">
                <input
                  type="checkbox"
                  checked={item.requiresApproval}
                  onChange={(e) => updateType(i, "requiresApproval", e.target.checked)}
                  className="accent-[var(--action-primary)]"
                />
                Requires Approval
              </label>
              <label className="text-xs flex items-center gap-1 text-text-primary">
                <input
                  type="checkbox"
                  checked={item.isActive}
                  onChange={(e) => updateType(i, "isActive", e.target.checked)}
                  className="accent-[var(--action-primary)]"
                />
                Active
              </label>
            </div>
            <div className="md:col-span-1 pt-4 text-right">
              <button
                type="button"
                onClick={() => removeType(i)}
                className="text-action-danger hover:text-action-danger p-1"
                aria-label="Remove pass type"
              >
                <Trash2 className="w-4 h-4" />
              </button>
            </div>
          </div>
        ))}

        {message && (
          <div
            className={`flex items-center gap-2 text-sm font-medium ${
              message.type === "success" ? "text-action-success" : "text-action-danger"
            }`}
          >
            {message.type === "success" ? (
              <CheckCircle2 className="w-4 h-4" />
            ) : (
              <AlertCircle className="w-4 h-4" />
            )}
            {message.text}
          </div>
        )}
      </div>

      <div className="surface-card flex justify-end mt-4 pt-4">
        <button
          type="submit"
          disabled={saving}
          className="surface-card inline-flex items-center gap-2 px-4 py-2 bg-action-primary text-white font-medium hover:brightness-110 disabled:opacity-50"
        >
          {saving ? <Loader2 className="w-4 h-4 animate-spin" /> : <Save className="w-4 h-4" />}
          Save Pass Types
        </button>
      </div>
    </form>
  );
}
</file>

<file path="src/components/admin/PersonList.tsx">
"use client";
import { useEffect, useState } from "react";
import { User, Search } from "lucide-react";
import type { Person } from "@/lib/types";
import { PersonBadge } from "@/components/shared/PersonBadge";

export function PersonList() {
  const [persons, setPersons] = useState<Person[]>([]);
  const [query, setQuery] = useState("");
  const [typeFilter, setTypeFilter] = useState<string>("all");
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    let cancelled = false;
    const load = async () => {
      try {
        const params = new URLSearchParams();
        if (query.trim()) params.append("q", query.trim());
        if (typeFilter !== "all") params.append("type", typeFilter);

        const url = `/api/persons?${params.toString()}`;
        const res = await fetch(url, { cache: "no-store" });
        const json = await res.json();
        if (!cancelled) {
          setPersons(Array.isArray(json.data) ? json.data : []);
          setLoading(false);
        }
      } catch {
        if (!cancelled) setLoading(false);
      }
    };
    setLoading(true);
    const t = setTimeout(load, 250);
    return () => {
      cancelled = true;
      clearTimeout(t);
    };
  }, [query, typeFilter]);

  return (
    <div className="bg-bg-surface rounded-xl border border-border">
      <div className="surface-card p-4 flex flex-wrap justify-between items-center gap-3">
        <div>
          <h3 className="font-semibold text-white">Campus Directory</h3>
          <p className="text-xs text-text-muted">
            {query || typeFilter !== "all" ? "Filtered results" : `Total Registered: ${persons.length}`}
          </p>
        </div>
        <div className="flex items-center gap-2">
          <select
            value={typeFilter}
            onChange={(e) => setTypeFilter(e.target.value)}
            className="surface-card px-3 py-2 bg-bg-base text-sm text-text-primary"
          >
            <option value="all">All Types</option>
            <option value="student">Student</option>
            <option value="faculty">Faculty</option>
            <option value="staff">Staff</option>
            <option value="worker">Worker</option>
            <option value="visitor">Visitor</option>
            <option value="parent">Parent</option>
          </select>
          <div className="relative">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" />
            <input
              type="text"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search by ID, name, dept..."
              className="surface-card pl-9 pr-4 py-2 w-6 bg-bg-base text-sm"
            />
          </div>
        </div>
      </div>

      <div className="p-4 space-y-2 max-h-6 overflow-y-auto">
        {loading ? (
          <div className="text-center py-8 text-text-muted text-sm">Loading...</div>
        ) : persons.length === 0 ? (
          <div className="text-center py-8 text-text-muted text-sm">
            {query || typeFilter !== "all" ? "No matching records found" : "No persons registered"}
          </div>
        ) : (
          persons.slice(0, 40).map((person) => {
            return (
              <div
                key={person.id}
                className="surface-card flex items-center justify-between p-2.5 hover:bg-white/5 hover: transition-all"
              >
                <div className="flex items-center gap-3">
                  <div className="size-6 rounded-full bg-bg-elevated flex items-center justify-center border border-border">
                    <User className="w-6 h-6 text-text-secondary" />
                  </div>
                  <div>
                    <div className="flex items-center gap-2">
                      <p className="font-medium text-white">{person.fullName || person.name}</p>
                      <PersonBadge type={person.personType} />
                    </div>
                    <p className="text-xs text-text-muted font-mono">{person.uniqueId || person.roll}</p>
                  </div>
                </div>
                <div className="text-right">
                  <p className="text-xs text-text-secondary">{person.department || person.designation || "N/A"}</p>
                  <span className={`text-xs uppercase font-semibold px-2 py-0.5 rounded ${
                    person.status === "active" ? "bg-emerald-500/10 text-action-success" : "bg-rose-500/10 text-action-danger"
                  }`}>
                    {person.status}
                  </span>
                </div>
              </div>
            );
          })
        )}
      </div>
    </div>
  );
}

export { PersonList as StudentList };
</file>

<file path="src/components/admin/PredictiveAnalytics.tsx">
"use client";

import React, { useState, useEffect } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { Brain, AlertTriangle, RefreshCw, Activity, TrendingUp, CheckCircle } from "lucide-react";

interface PredictionItem {
  type: string;
  target: string;
  predicted_value: number;
  confidence_interval_low: number;
  confidence_interval_high: number;
  timestamp: string;
  model_version: string;
}

interface AnomalyEvent {
  id: string;
  metric: string;
  actual_value: number;
  expected_value: number;
  z_score: number;
  severity: "low" | "medium" | "high" | "critical";
  timestamp: string;
  message: string;
}

export function PredictiveAnalytics() {
  const { token } = useAuthStore();
  const { addToast } = useUIStore();
  const [predictions, setPredictions] = useState<PredictionItem[]>([]);
  const [anomalies, setAnomalies] = useState<AnomalyEvent[]>([]);
  const [metrics, setMetrics] = useState({ mape: "4.2%", rmse: 8.7, model_version: "v1.2-exp-smooth" });
  const [loading, setLoading] = useState(true);
  const [retraining, setRetraining] = useState(false);

  const fetchData = async () => {
    setLoading(true);
    try {
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers["Authorization"] = `Bearer ${token}`;

      const res = await fetch("/api/analytics/predictions", { headers });
      const result = await res.json();
      if (result.success && result.data) {
        setPredictions(result.data.predictions || []);
        setAnomalies(result.data.anomalies || []);
        if (result.data.metrics) setMetrics(result.data.metrics);
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to fetch predictions data" });
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const handleRetrain = async () => {
    setRetraining(true);
    try {
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers["Authorization"] = `Bearer ${token}`;

      const res = await fetch("/api/analytics/predictions/retrain", { method: "POST", headers });
      const result = await res.json();
      if (result.success) {
        addToast({ variant: "success", title: "Retrained", message: "Models successfully retrained" });
        fetchData();
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to retrain models" });
    } finally {
      setRetraining(false);
    }
  };

  if (loading) {
    return <div className="p-8 text-center text-xs text-text-secondary">Loading AI Predictive Models...</div>;
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <p className="text-xl font-bold flex items-center gap-2">
            <Brain className="h-6 w-6 text-unit-c" />
            AI Predictive Analytics & Anomaly Engine
          </p>
          <p className="text-xs text-text-secondary">
            Hourly time-series forecasting (ARIMA / Exponential Smoothing) with Z-Score anomaly detection.
          </p>
        </div>
        <Button variant="primary" size="sm" onClick={handleRetrain} disabled={retraining} className="gap-2">
          <RefreshCw className={`h-4 w-4 ${retraining ? "animate-spin" : ""}`} />
          {retraining ? "Retraining..." : "Retrain AI Models"}
        </Button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <Card className="p-4 flex items-center gap-3">
          <TrendingUp className="size-6 text-action-success" />
          <div>
            <div className="text-xs text-text-secondary">Model Accuracy (MAPE)</div>
            <div className="text-xl font-bold text-text-primary">{metrics.mape}</div>
          </div>
        </Card>
        <Card className="p-4 flex items-center gap-3">
          <Activity className="size-6 text-action-primary" />
          <div>
            <div className="text-xs text-text-secondary">Root Mean Square Error (RMSE)</div>
            <div className="text-xl font-bold text-text-primary">{metrics.rmse}</div>
          </div>
        </Card>
        <Card className="p-4 flex items-center gap-3">
          <CheckCircle className="size-6 text-unit-c" />
          <div>
            <div className="text-xs text-text-secondary">Active Model Version</div>
            <div className="text-base font-bold text-text-primary">{metrics.model_version}</div>
          </div>
        </Card>
      </div>

      <Card>
        <CardHeader>
          <CardTitle className="text-base flex items-center gap-2">
            <AlertTriangle className="h-6 w-6 text-action-warning" />
            Real-Time Anomaly Detections (&gt;2.0σ Deviation)
          </CardTitle>
        </CardHeader>
        <CardContent className="space-y-3">
          {anomalies.length === 0 ? (
            <p className="text-xs text-text-secondary">No active statistical anomalies detected.</p>
          ) : (
            anomalies.map((anom) => (
              <div key={anom.id} className="surface-card p-3 bg-[var(--bg-surface-elevated)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                <div className="space-y-1">
                  <div className="flex items-center gap-2">
                    <Badge variant={anom.severity === "critical" ? "error" : "offline"} className="text-xs">
                      {anom.severity.toUpperCase()} ({anom.z_score}σ)
                    </Badge>
                    <span className="font-semibold text-sm">{anom.metric}</span>
                  </div>
                  <p className="text-xs text-text-secondary">{anom.message}</p>
                </div>
                <div className="text-xs text-text-secondary font-mono whitespace-nowrap">
                  Expected: {anom.expected_value} | Actual: {anom.actual_value}
                </div>
              </div>
            ))
          )}
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle className="text-base">Predicted Operational Volume (Next 6 Hours)</CardTitle>
        </CardHeader>
        <CardContent>
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead>
                <tr className="border-b border-border text-text-secondary">
                  <th className="p-2">Metric / Target</th>
                  <th className="p-2">Forecast Timestamp</th>
                  <th className="p-2">Predicted Value</th>
                  <th className="p-2">Confidence Interval (95%)</th>
                  <th className="p-2">Model</th>
                </tr>
              </thead>
              <tbody>
                {predictions.map((p, idx) => (
                  <tr key={idx} className="border-b border-border hover:bg-[var(--bg-surface-elevated)]">
                    <td className="p-2 font-medium">{p.type.toUpperCase()} ({p.target})</td>
                    <td className="p-2 text-text-secondary">{new Date(p.timestamp).toLocaleTimeString()}</td>
                    <td className="p-2 font-bold text-action-success">{p.predicted_value}</td>
                    <td className="p-2 font-mono text-text-secondary">
                      [{p.confidence_interval_low} - {p.confidence_interval_high}]
                    </td>
                    <td className="p-2 text-text-secondary">{p.model_version}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}
</file>

<file path="src/components/admin/SmartSchedulingAssistant.tsx">
"use client";

import React, { useState, useEffect } from "react";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { ScheduleSuggestion } from "@/lib/scheduling-assistant";
import { Sparkles, Check } from "lucide-react";

export function SmartSchedulingAssistant() {
  const { token } = useAuthStore();
  const { addToast } = useUIStore();
  const [suggestions, setSuggestions] = useState<ScheduleSuggestion[]>([]);
  const [loading, setLoading] = useState(true);
  const [applyingId, setApplyingId] = useState<string | null>(null);

  const fetchSuggestions = async () => {
    setLoading(true);
    try {
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers["Authorization"] = `Bearer ${token}`;

      const res = await fetch("/api/admin/scheduling/suggestions", { headers });
      const result = await res.json();
      if (result.success && result.data) {
        setSuggestions(result.data);
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to fetch smart suggestions" });
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchSuggestions();
  }, []);

  const handleApply = async (id: string) => {
    setApplyingId(id);
    try {
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers["Authorization"] = `Bearer ${token}`;

      const res = await fetch("/api/admin/scheduling/apply", {
        method: "POST",
        headers,
        body: JSON.stringify({ suggestionId: id }),
      });
      const result = await res.json();
      if (result.success) {
        addToast({ variant: "success", title: "Applied", message: result.message });
        setSuggestions((prev) => prev.filter((s) => s.id !== id));
      } else {
    addToast({ variant: "error", title: "Not applied", message: result.error || "Failed to apply recommendation" });
  }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to apply recommendation" });
    } finally {
      setApplyingId(null);
    }
  };

  if (loading) return <div className="p-4 text-xs text-text-secondary">Analyzing historical scan data for smart schedule optimizations...</div>;

  return (
    <div className="space-y-4">
      <div className="flex items-center gap-2">
        <Sparkles className="h-5 w-5 text-action-warning" />
        <h2 className="text-base font-bold">AI Smart Scheduling Recommendations</h2>
      </div>

      <div className="space-y-3">
        {suggestions.length === 0 ? (
          <Card className="p-4 text-xs text-text-secondary">All smart schedule optimizations applied.</Card>
        ) : (
          suggestions.map((sug) => (
            <Card key={sug.id} className="surface-card p-4 space-y-3">
              <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                <div className="space-y-1">
                  <div className="flex items-center gap-2">
                    <Badge variant="success" className="text-xs">
                      Impact Score: {sug.impact_score}/100
                    </Badge>
                    <h3 className="font-bold text-sm">{sug.title}</h3>
                  </div>
                  <p className="text-xs text-text-primary">{sug.recommendation}</p>
                </div>
                <Button
                  variant="primary"
                  size="sm"
                  onClick={() => handleApply(sug.id)}
                  disabled={applyingId === sug.id}
                  className="gap-1 text-xs whitespace-nowrap"
                >
                  <Check className="h-3.5 w-3.5" />
                  {applyingId === sug.id ? "Applying..." : "Apply Recommendation"}
                </Button>
              </div>

              <p className="surface-card text-xs text-text-secondary bg-[var(--bg-surface-elevated)] p-2.5">
                💡 <span className="font-semibold">Data Insight:</span> {sug.reasoning}
              </p>
            </Card>
          ))
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/admin/StaffMonthlyReviewPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  Briefcase,
  AlertTriangle,
  FileDown,
  RefreshCw,
} from "lucide-react";
import { usePeriod } from "@/hooks/usePeriod";
import { useExport } from "@/hooks/useExport";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { EditableField } from "@/components/shared/EditableField";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface StaffRow {
  id: string;
  name: string;
  department: string;
  designation: string;
  hoursOnCampus: number;
  lateCount: number;
  daysPresent: number;
  onTimeRate: number;
}

interface MonthlyPayload {
  data: {
    period: string;
    range: { from: string; to: string };
    staff: StaffRow[];
    summary: {
      totalHours: number;
      lastMonthHours: number;
      hoursDelta: number;
      staffCount: number;
    };
  };
}

// ── Component ─────────────────────────────────────────────────────────────

export function StaffMonthlyReviewPanel() {
  const { period, setPeriod } = usePeriod("this-month");
  const { exportCSV } = useExport();
  const [data, setData] = useState<MonthlyPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/admin/staff-tracking/monthly?period=${period.key === "all-time" ? "this-month" : period.key}`,
        { headers: getAuthHeaders(), cache: "no-store" }
      );
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load");
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [period.key]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      data.staff.map((s) => ({
        name: s.name,
        department: s.department,
        designation: s.designation,
        hours: s.hoursOnCampus,
        late: s.lateCount,
        days: s.daysPresent,
        onTimeRate: s.onTimeRate,
      })),
      [
        { key: "name", header: "Staff" },
        { key: "department", header: "Department" },
        { key: "designation", header: "Designation" },
        { key: "hours", header: "Hours" },
        { key: "late", header: "Late" },
        { key: "days", header: "Days" },
        { key: "onTimeRate", header: "On-time %" },
      ],
      `staff_${data.period.replace(/\s/g, "_")}.csv`
    );
  };

  const s = data?.summary;

  return (
    <WidgetBoundary name="StaffMonthlyReviewPanel" resetKey={period.key}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <div className="p-2 rounded-xl bg-action-warning/10 text-action-warning">
              <Briefcase className="h-4 w-4" />
            </div>
            <div>
              <h2 className="text-sm font-semibold text-text-primary">Staff Monthly Review</h2>
              <p className="text-xs text-text-muted">Shift adherence, late arrivals, hours on campus</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              disabled={!data}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
            <button
              type="button"
              onClick={() => void load()}
              className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-surface"
            >
              <RefreshCw className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        <PeriodPicker value={period} onChange={setPeriod} allowCustom={false} />

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <Skeleton className="h-14 rounded-xl" />
            {Array.from({ length: 3 }).map((_, i) => (
              <Skeleton key={i} className="h-12 rounded-xl" />
            ))}
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-rose-500/10 p-4 text-sm text-rose-600">
            <AlertTriangle className="h-4 w-4 inline mr-1" /> {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {data && !loading && (
          <>
            {/* Summary */}
            <div className="flex items-center justify-between rounded-xl border border-border bg-bg-elevated px-5 py-3">
              <div className="flex items-center gap-4">
                <div>
                  <p className="text-xs text-text-muted">Total hours</p>
                  <div className="flex items-center gap-1.5">
                    <span className="text-xl font-bold text-text-primary tabular-nums">{s?.totalHours}</span>
                    {s && s.lastMonthHours > 0 && (
                      <DeltaBadge value={s.totalHours} reference={s.lastMonthHours} label="vs LM" />
                    )}
                  </div>
                </div>
                <div>
                  <p className="text-xs text-text-muted">Staff</p>
                  <span className="text-xl font-bold text-text-primary tabular-nums">{data.staff.length}</span>
                </div>
              </div>
              <span className="text-xs text-text-muted">{data.period}</span>
            </div>

            {/* Staff list */}
            {data.staff.length === 0 ? (
              <EmptyState title="No staff records in this period" />
            ) : (
              <div className="space-y-1.5">
                {data.staff.map((st) => (
                  <div
                    key={st.id}
                    className="flex items-center justify-between rounded-xl border border-border bg-bg-elevated px-4 py-2.5"
                  >
                    <div className="flex items-center gap-3 min-w-0 flex-1">
                      <div className="p-1.5 rounded-lg bg-action-warning/10 text-action-warning shrink-0">
                        <Briefcase className="h-3.5 w-3.5" />
                      </div>
                      <div className="min-w-0">
                        <p className="text-sm font-medium text-text-primary truncate">{st.name}</p>
                        <p className="text-xs text-text-muted">
                          {st.department} · {st.designation}
                        </p>
                      </div>
                    </div>

                    <div className="flex items-center gap-4 text-xs shrink-0">
                      <div className="text-right">
                        <p className="font-semibold text-text-primary tabular-nums">{st.hoursOnCampus}h</p>
                        <p className="text-text-muted tabular-nums">{st.daysPresent} days</p>
                      </div>
                      <div className="text-right w-14">
                        <p className={cn("font-semibold tabular-nums", st.onTimeRate >= 90 ? "text-emerald-500" : st.onTimeRate >= 70 ? "text-amber-500" : "text-rose-500")}>
                          {st.onTimeRate}%
                        </p>
                        <p className="text-text-muted">on-time</p>
                      </div>
                      <div className="text-right w-10">
                        <p className={cn("font-semibold tabular-nums", st.lateCount > 0 ? "text-rose-500" : "text-emerald-500")}>
                          {st.lateCount}
                        </p>
                        <p className="text-text-muted">late</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

