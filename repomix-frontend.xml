"use client";
import { useCallback, useEffect, useMemo, useState } from "react";
import { ArrowRight, ArrowLeft, Loader2, FileDown, EyeOff, Eye, SlidersHorizontal } from "lucide-react";
import type { Scan } from "@/lib/types";
import { getAuthHeaders } from "@/lib/utils";
import { usePolling } from "@/hooks/usePolling";
import { useExport } from "@/hooks/useExport";

type DirFilter = "all" | "IN" | "OUT";

/**
 * Self-service gate activity feed. Works for every account type with a
 * uniqueId (student, faculty, staff, worker) via /api/persons/:id/history.
 */
export function RecentActivity() {
  const [activities, setActivities] = useState<Scan[]>([]);
  const [loading, setLoading] = useState(true);
  const [dirFilter, setDirFilter] = useState<DirFilter>("all");
  const [hideSensitive, setHideSensitive] = useState(false);
  const { exportCSV } = useExport();

  const load = useCallback(async () => {
    try {
      const authRaw = sessionStorage.getItem("gate-monitor-auth");
      const auth = authRaw ? JSON.parse(authRaw) : null;
      const uniqueId = auth?.state?.user?.uniqueId ?? auth?.state?.user?.roll ?? auth?.user?.uniqueId ?? auth?.user?.roll;
      if (!uniqueId) {
        setLoading(false);
        return;
      }
      const res = await fetch(`/api/persons/${encodeURIComponent(uniqueId)}/history?limit=5`, {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const json = await res.json();
      const history = json?.data?.history;
      setActivities(Array.isArray(history) ? history : []);
      setLoading(false);
    } catch {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load().catch(() => {}); }, [load]);
  usePolling(load, { intervalMs: 30_000 });

  const filtered = useMemo(
    () => activities
      .filter((a) => dirFilter === "all" || a.direction === dirFilter)
      .map((a) =>
        hideSensitive
          ? { ...a, gateName: "—", operatorName: "—", name: "—", student_photo: undefined }
          : a
      ),
    [activities, dirFilter, hideSensitive]
  );

  const handleExport = () => {
    exportCSV(
      filtered.map((a) => ({
        direction: a.direction,
        gate: a.gateName,
        timestamp: a.timestamp,
        isManual: a.isManual ? "yes" : "no",
      })),
      [
        { key: "direction", header: "Direction" },
        { key: "gate", header: "Gate" },
        { key: "timestamp", header: "Time" },
        { key: "isManual", header: "Manual?" },
      ],
      "recent_activity.csv"
    );
  };

  return (
    <div className="surface-card bg-bg-surface p-6">
      <h3 className="font-semibold mb-4">Recent Activity</h3>
      <div className="space-y-4">
        {loading ? (
          <div className="flex items-center gap-2 text-sm text-text-muted">
            <Loader2 className="w-4 h-4 animate-spin" /> Loading…
          </div>
        ) : activities.length === 0 ? (
          <p className="text-sm text-text-muted text-center py-4">No activity yet.</p>
        ) : (
          activities.map((a) => {
            const isIn = a.direction === "IN";
            // Tap-to-act: a gate exit links to the live pass tracker; an
            // entry links to today's status. The action is the deep-link.
            const actionHref = isIn ? "/student" : "/student/passes";
            const actionLabel = isIn ? "Today's status" : "Track pass";
            return (
              <a
                key={a.id}
                href={actionHref}
                className="flex items-center justify-between rounded-lg p-2 -mx-2 hover:bg-bg-elevated transition-colors"
              >
                <div className={`flex items-center gap-2 font-medium ${isIn ? "text-action-success" : "text-action-danger"}`}>
                  {isIn ? <ArrowRight className="w-5 h-5" /> : <ArrowLeft className="w-5 h-5" />}
                  <span className="capitalize">{isIn ? "Entry" : "Exit"}</span>
                </div>
                <div className="text-right">
                  <p className="text-sm">
                    {new Date(a.timestamp).toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })}
                  </p>
                  <p className="text-xs text-text-muted">
                    {a.gateName} · <span className="text-action-primary/70">{actionLabel}</span>
                  </p>
                </div>
              </a>
            );
          })
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/student/SakugaConsole.tsx">
"use client";

// SakugaConsole — a compact "console" strip rendered at the TOP of the student
// home dashboard, ONLY when the active theme is sakuga. It puts the sakuga-VFX
// custom elements to real use on the main dashboard (not just the profile page),
// so the themed "girls' dashboard" visibly demonstrates the anime controls:
// button, tabs, rating, slider, toggle, progress, tooltip.
//
// Graphite users never see it (gated on data-theme === "sakuga"), so it adds
// zero nodes to the non-themed path. If a VFX script fails to register, the
// <sakuga-*> tags degrade to inert shells and the native fallbacks inside keep
// the panel usable.

import { useEffect, useState, type ReactNode } from "react";
import { Sparkles } from "lucide-react";
import { SakuraDualThemeControl } from "@/components/nav/SakuraDualThemeControl";

type SakugaProps = Record<string, unknown> & { children?: ReactNode };
declare module "react" {
  // eslint-disable-next-line @typescript-eslint/no-namespace
  namespace JSX {
    interface IntrinsicElements {
      "sakuga-button": SakugaProps;
      "sakuga-tabs": SakugaProps;
      "sakuga-toast": SakugaProps;
      "sakuga-slider": SakugaProps;
      "sakuga-input": SakugaProps;
      "sakuga-rating": SakugaProps;
      "sakuga-tooltip": SakugaProps;
      // (sakuga-progress is declared in SakugaLoadingSplash.tsx with its own
      // set()/value typing — omitted here to avoid a TS2717 tag conflict.)
    }
  }
}

function useIsSakuga(): boolean {
  const [on, setOn] = useState(false);
  useEffect(() => {
    let tries = 0;
    let timer: ReturnType<typeof setTimeout>;
    let observer: MutationObserver | undefined;
    const read = () => document.documentElement.getAttribute("data-theme") === "sakuga";
    const check = () => {
      setOn(read());
      if (!read() && ++tries < 6) timer = setTimeout(check, 400);
    };
    check();
    observer = new MutationObserver(() => setOn(read()));
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    return () => {
      clearTimeout(timer);
      observer?.disconnect();
    };
  }, []);
  return on;
}

export function SakugaConsole() {
  const isSakuga = useIsSakuga();
  const [tab, setTab] = useState<"today" | "passes" | "mess">("today");

  if (!isSakuga) return null;

  return (
    <section
      aria-label="Console (sakuga effects)"
      className="surface-card p-3 md:p-4"
    >
      <div className="mb-3 flex items-center gap-2">
        <Sparkles className="h-4 w-4 text-action-primary" />
        <p className="text-xs font-bold uppercase tracking-wider text-text-muted">
          Console effects
        </p>
        <span className="ml-auto text-xs text-text-muted">anime controls</span>
      </div>

      <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {/* Tabs: switch the dashboard focus */}
        <div>
          <p className="mb-1.5 text-xs text-text-muted">Focus</p>
          <sakuga-tabs
            activeTab={tab}
            onChange={((e: unknown) => {
              const v = (e as any).target?.getAttribute?.("value");
              setTab(v === "passes" || v === "mess" ? v : "today");
            }) as any}
          >
            <button type="button" value="today" className="text-xs">Today</button>
            <button type="button" value="passes" className="text-xs">Passes</button>
            <button type="button" value="mess" className="text-xs">Mess</button>
          </sakuga-tabs>
        </div>

        {/* Rating */}
        <div>
          <p className="mb-1.5 text-xs text-text-muted">Mood</p>
          <sakuga-rating value={4} label="mood">★</sakuga-rating>
        </div>

        {/* Slider */}
        <div>
          <p className="mb-1.5 text-xs text-text-muted">Volume</p>
          <sakuga-slider min="0" max="100" value="60" label="volume" unit="%" />
        </div>

        {/* Buttons + tooltip + toast demo */}
        <div className="flex flex-col gap-2 sm:items-end">
          <div className="flex flex-wrap items-center gap-2">
            <sakuga-button variant="secondary" label="dismiss">Dismiss</sakuga-button>
