          {reason && <div className="mt-2 line-clamp-2 text-xs text-text-muted">{reason}</div>}
        </button>
      </div>
      <div className="flex shrink-0 items-center gap-1">
        {onApprove && (
          <button onClick={onApprove} disabled={busy}
