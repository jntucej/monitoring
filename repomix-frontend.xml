"use client";

import React, { useCallback, useEffect, useState } from "react";
import { useAuthStore } from "@/stores/authStore";
import { Button } from "@/components/ui/button";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Compass, CheckCircle, X } from "lucide-react";

interface Step {
  id: string;
  title: string;
  description: string;
  targetPath: string;
}

export function OnboardingTour() {
  const { token } = useAuthStore();
  const [nextStep, setNextStep] = useState<Step | null>(null);
  const [dismissed, setDismissed] = useState(false);

  const fetchNext = useCallback(async () => {
    if (!token) return;
    try {
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers["Authorization"] = `Bearer ${token}`;

      const res = await fetch("/api/onboarding/next", { headers, credentials: "include" });
      const result = await res.json();
      if (result.success && result.data?.step) {
        setNextStep(result.data.step);
      } else if (result.success && result.data?.allComplete) {
        setDismissed(true);
      }
    } catch {}
  }, [token]);

  useEffect(() => {
    void fetchNext();
  }, [fetchNext]);

  const handleComplete = async () => {
    if (!nextStep) return;
    try {
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers["Authorization"] = `Bearer ${token}`;

      await fetch("/api/onboarding/complete", {
        method: "POST",
        headers,
        credentials: "include",
        body: JSON.stringify({ step: nextStep.id }),
      });
      // Re-poll: if all steps are done the next call reports allComplete
      // and the tour dismisses itself.
      void fetchNext();
    } catch {}
  };

  if (!nextStep || dismissed) return null;

  return (
    <Card className="border-cyan-500/30 bg-cyan-950/20 mb-6 relative overflow-hidden">
      <CardHeader className="flex flex-row items-center justify-between pb-2">
        <div className="flex items-center gap-2 text-cyan-600">
          <Compass className="h-5 w-5 animate-pulse" />
          <CardTitle className="text-sm font-semibold text-cyan-700">
            Interactive Onboarding: {nextStep.title}
          </CardTitle>
        </div>
        <button onClick={() => setDismissed(true)} className="text-secondary hover:text-white">
          <X className="h-4 w-4" />
        </button>
      </CardHeader>
      <CardContent className="space-y-3">
        <p className="text-xs text-secondary">{nextStep.description}</p>
        <div className="flex items-center gap-2">
          <Button variant="primary" size="sm" onClick={handleComplete} className="gap-1 text-xs">
            <CheckCircle className="h-3.5 w-3.5" />
            Mark Step Completed
          </Button>
          <Button variant="ghost" size="sm" onClick={() => setDismissed(true)} className="text-xs">
            Skip Tour
          </Button>
        </div>
      </CardContent>
    </Card>
  );
}
</file>

<file path="src/components/shared/PageHeader.tsx">
"use client";

import { RefreshCw } from "lucide-react";
import { ReactNode, useEffect } from "react";



export interface PageHeaderProps {
  title: string;
  subtitle?: string;
  onRefresh?: () => void;
  refreshing?: boolean;
  actions?: ReactNode;
  breadcrumb?: { label: string; href: string }[];
  /** Optional explicit path to look up metadata. Defaults to current pathname. */
  pathOverride?: string;
  /** Render a visible mobile title bar even when the desktop shell hides one. */
  showMobileTitle?: boolean;
}

/**
 * PageHeader — renders a compact mobile-only title bar (below the standalone
 * shell top chrome) so students/parents on phones always see the page name.
 * On md+ the console chrome already identifies the page, so nothing renders.
 * Also owns the document-title side effect; all existing call sites keep
 * working unchanged.
 *
 * An <h1> is always emitted (visually hidden on md+) so every page has a
 * single accessible heading for screen readers and deep-link clarity.
 */
export function PageHeader({
  title,
  subtitle,
  onRefresh,
  refreshing,
  actions,
  breadcrumb,
  pathOverride,
  showMobileTitle = true,
}: PageHeaderProps) {
  useEffect(() => {
    if (title && typeof document !== "undefined") {
      document.title = `${title} | Gate Monitor`;
    }
  }, [title]);

  // Keep unused-destructure lint clean without a no-op render.
  void [subtitle, onRefresh, refreshing, actions, breadcrumb, pathOverride];

  if (!title) return null;

  return (
    <div className="space-y-0.5 pb-1">
      <h1 className="text-lg md:text-xl font-bold text-text-primary truncate">{title}</h1>
      {subtitle && <p className="text-xs md:text-sm text-text-muted">{subtitle}</p>}
    </div>
  );
}

const _refreshIcon = RefreshCw;

export default PageHeader;
</file>

<file path="src/components/shared/passInspection.model.tsx">
import type { EntityInspection } from "@/components/shared/EntityInspector";
import { KVPairs, Timeline, InspectorButton } from "@/components/shared/EntityInspector";
import { ExternalLink } from "lucide-react";


// ── gate pass (GatePass) ─────────────────────────────────────────────

export interface PassModel {
  id: string;
  roll: string;
  studentName: string;
  department: string;
  reason: string;
  from: string;
  to: string;
  description?: string;
  requestedByName?: string;
  requestedAt?: string;
  parentStatus: string;
  adminStatus: string;
  finalStatus: string;
  parentComment?: string;
  adminComment?: string;
}

/** Standardized inspection for a gate pass: overview → approval loop → timeline. */
export function passInspection(pass: PassModel): EntityInspection {
  const active = !/rejected|completed|expired|cancelled/i.test(pass.finalStatus);
  return {
    kind: "gate pass",
    title: pass.studentName || pass.roll,
    subtitle: pass.roll,
    status: (
      <span
        className={`text-[10px] font-bold uppercase px-1.5 py-0.5 rounded ${
          active
            ? "bg-emerald-500/15 text-action-success"
            : /rejected|denied/i.test(pass.finalStatus)
              ? "bg-rose-500/15 text-action-danger"
              : "bg-bg-elevated text-text-muted"
        }`}
      >
        {pass.finalStatus}
      </span>
    ),
    sections: [
      {
        title: "Overview",
        content: (
          <KVPairs
            items={[
              { label: "Reason", value: pass.reason },
              { label: "Department", value: pass.department },
              ...(pass.description ? [{ label: "Note", value: pass.description }] : []),
              {
                label: "Valid",
                value: `${new Date(pass.from).toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })} → ${new Date(pass.to).toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })}`,
              },
            ]}
          />
        ),
      },
      {
        title: "Approval loop",
        content: (
          <KVPairs
            items={[
              {
                label: "Parent",
                value: (
                  <span className={`font-bold ${pass.parentStatus === "APPROVED" ? "text-action-success" : "text-action-warning"}`}>
                    {pass.parentStatus}
                  </span>
                ),
              },
              {
                label: "Admin",
                value: (
                  <span className={`font-bold ${pass.adminStatus === "APPROVED" ? "text-action-success" : "text-action-warning"}`}>
                    {pass.adminStatus}
                  </span>
                ),
              },
              ...(pass.parentComment ? [{ label: "Parent note", value: pass.parentComment }] : []),
              ...(pass.adminComment ? [{ label: "Admin note", value: pass.adminComment }] : []),
            ]}
          />
        ),
      },
      {
        title: "Timeline",
        collapsible: true,
        content: (
          <Timeline
            items={[
              {
                label: `Requested by ${pass.requestedByName ?? "unknown"}`,
