        <SmartCrossLinkChip href="/mess/operational-requests" label="Operational Requests" tone="info" />
      </div>

      <LivePulseStrip
        items={[
          { id: "total", label: "Active Items", valueLabel: String(d?.total ?? 0), tone: "ok", benchmark: "Catalog items in rotation" },
