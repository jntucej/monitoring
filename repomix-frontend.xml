"use client";

import { useCallback, useEffect, useState } from "react";
import {
  CalendarDays,
} from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { EmptyState } from "@/components/admin/shared/EmptyState";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface EventRow {
  id: string;
  title: string;
  description: string | null;
  category: string | null;
  location: string | null;
  startsAt: string | null;
  endsAt: string | null;
  capacity: number | null;
  registrations: number;
}

/**
 * Sysadmin Campus Events — upcoming campus events + registration volume.
 * Backend: /api/campus/events (open GET).
 */
function SysadminEventsInner() {
  const [rows, setRows] = useState<EventRow[]>([]);
  const [loading, setLoading] = useState(true);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const res = await fetch("/api/campus/events", { headers: getAuthHeaders() });
      const body = await res.json();
      const raw = body?.data ?? body;
      const rows = Array.isArray(raw) ? raw : (raw?.events ?? []);
      setRows(rows as EventRow[]);
    } catch (e) {
      console.error("events", e);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  if (loading) {
    return (
      <div className="space-y-4 p-4 md:p-6">
        <Skeleton className="h-10 w-48" />
        <Skeleton className="h-72 rounded-2xl" />
      </div>
    );
  }

  return (
    <div className="space-y-6 p-4 md:p-6">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Campus Events & Registrations"
        purpose="Review upcoming campus event registrations, venue capacity thresholds, and temporary visitor attendance volumes."
        statusSummary={`${rows.length} scheduled campus events with ${rows.reduce((acc, r) => acc + (r.registrations || 0), 0)} total attendee registrations recorded.`}
        why="Large campus gatherings require security gate coordination to permit registered outside attendees and prevent entrance surges."
        primaryAction={{ label: "Gate Schedule", href: "/sysadmin/gate-schedule" }}
        secondaryAction={{ label: "Communities", href: "/sysadmin/communities" }}
      />
      <PageHeader
        title="Campus Events"
        subtitle="Upcoming campus events and registration volume"
        onRefresh={load}
      />

      <WidgetBoundary title="Events">
        <div className="glass-card">
          {rows.length === 0 ? (
            <EmptyState
              icon={<CalendarDays className="w-6 h-6" />}
              title="No events scheduled"
              description="Campus events appear here once they are published."
            />
          ) : (
            <div className="divide-y divide-border">
              {rows.map((r) => (
                <div key={r.id} className="p-4 flex items-start gap-3">
                  <div className="size-6 rounded-xl bg-bg-elevated flex items-center justify-center text-text-secondary shrink-0">
                    <CalendarDays className="w-4 h-4" />
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 flex-wrap">
                      <p className="text-sm font-semibold text-text-primary">{r.title}</p>
                      {r.category && (
                        <span className="surface-card px-2 py-0.5 text-xs bg-action-primary/10 text-action-primary">{r.category}</span>
                      )}
                    </div>
                    <p className="text-xs text-text-muted mt-0.5">
                      {r.location ? `${r.location} · ` : ""}
                      {r.startsAt ? new Date(r.startsAt).toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" }) : ""}
                    </p>
                    {r.description && <p className="text-xs text-text-secondary mt-1.5 line-clamp-2">{r.description}</p>}
                  </div>
                  <div className="text-right shrink-0">
                    <p className="text-xs text-text-muted">{r.registrations}/{r.capacity ?? "∞"} registered</p>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </WidgetBoundary>
    </div>
  );
}

export default function SysadminEventsPage() {
  return (
    <AuthGuard allowedRoles={["admin", "sysadmin"]}>
      <SysadminEventsInner />
    </AuthGuard>
  );
}
