<file path="src/app/(sysadmin)/sysadmin/app-map/page.tsx">
// /sysadmin/app-map — a flat, readable map of the whole application.
//
// This is a DEVELOPER aid, not a product surface: it lists every page, who
// sees it, what data it loads, and what each button does — in plain English.
// It reads the generated .app-map.json (regenerated by `npm run app-map`),
// which is itself a heuristic scan of src/app/**/page.tsx. The map stays
// current automatically; it becomes one fewer thing to maintain by hand.
//
// Access: this route group is wrapped in AuthGuard allowedRoles=["sysadmin"],
// so only sysadmin can open it. The page is intentionally plain HTML (no
// rich UI) — it is meant to be scanned, not polished.
"use client";

import { Suspense, useCallback, useEffect, useMemo, useState } from "react";
import { PageHeader } from "@/components/shared/PageHeader";
import { PageLoading } from "@/components/shared/LoadingStates";
import { useApiResource } from "@/hooks/useApiResource";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface ButtonEntry {
  label: string;
  handler: string | null;
  action: string | null;
  capability: string | null;
}
interface FetchCall {
  method: string;
  url: string;
}
interface PageEntry {
  route: string;
  file: string;
  title: string | null;
  subtitle: string | null;
  role: string | null;
  fetches: FetchCall[];
  buttons: ButtonEntry[];
  capabilities: string[];
  navEntry: { label: string; href: string } | null;
}
interface AppMap {
  generatedAt: string;
  pageCount: number;
  pages: PageEntry[];
}

const ROLE_LABELS: Record<string, string> = {
  student: "Students",
  supervisor: "Supervisors",
  operator: "Gate Operators",
  principal: "Principal / Warden",
  hod: "HODs / Academics",
  faculty: "Faculty",
  staff: "Staff",
  visitor: "Visitors",
  worker: "Workers",
  guardian: "Guardians / Parents",
  mess: "Mess",
  approver: "Approvers",
  sysadmin: "SysAdmin",
  admin: "SysAdmin",
  exam: "Examinations",
  "exam-branch": "Exam Branch",
  "exam-superintendent": "Exam Superintendent",
};

function roleLabel(role: string | null): string {
  if (!role) return "Unassigned";
  return ROLE_LABELS[role] ?? role;
}

function AppMapInner() {
  const { data, error, loading } = useApiResource<AppMap>("/api/dev/app-map", {
    ttlMs: 3600_000,
  });
  const [filterRole, setFilterRole] = useState<string>("all");
  const [query, setQuery] = useState("");

  const roles = useMemo(() => {
    const s = new Set<string>();
    for (const p of data?.pages ?? []) if (p.role) s.add(p.role);
    return [...s].sort();
  }, [data]);

  const filtered = useMemo(() => {
    if (!data) return [];
    return data.pages.filter((p) => {
      if (filterRole !== "all" && p.role !== filterRole) return false;
      if (query) {
        const q = query.toLowerCase();
        return (
          p.route.toLowerCase().includes(q) ||
          (p.title ?? "").toLowerCase().includes(q) ||
          p.file.toLowerCase().includes(q)
        );
      }
      return true;
    });
  }, [data, filterRole, query]);

  // Group by role, preserving role order.
  const grouped = useMemo(() => {
    const map = new Map<string, PageEntry[]>();
    for (const p of filtered) {
      const key = p.role ?? "unassigned";
      if (!map.has(key)) map.set(key, []);
      map.get(key)!.push(p);
    }
    return map;
  }, [filtered]);

  const handleRegen = useCallback(async () => {
    // Trigger a fresh scan (best-effort; the committed JSON is the source of
    // truth until the next build). We revalidate the cache via the query param.
    const res = await fetch("/api/dev/app-map?bust=" + Date.now());
    if (res.ok) {
      const fresh = (await res.json()) as AppMap;
      // Refetch via the hook's cache-bust is not available; reload is the
      // simplest, most reliable path for a dev aid.
      window.location.reload();
      void fresh;
    }
  }, []);

  return (
    <div className="max-w-4xl mx-auto px-4 py-6 space-y-6">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Application Route Architecture"
        purpose="Inspect the live route map, verify RBAC authorization boundaries, and trace client-side API contracts across all views."
        statusSummary={`${data?.pageCount ?? 0} application routes cataloged across student, approver, operator, and administrative domains.`}
        why="Auditing route trees and permission scopes ensures no unprotected endpoints or broken navigation pathways exist in production."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "Audit Logs", href: "/sysadmin/audit" }}
      />
      <PageHeader
        title="Application Map"
        subtitle={`A flat, readable view of every page · ${data?.pageCount ?? 0} pages · generated ${data?.generatedAt ? new Date(data.generatedAt).toLocaleString() : "…"}`}
      />

      {loading ? (
        <PageLoading />
      ) : error ? (
        <div className="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
          Map not available: {String(error)}
          <div className="mt-2 text-xs text-amber-600">
            Run <code className="font-mono">npm run app-map</code> to regenerate{" "}
            <code className="font-mono">.app-map.json</code>, then rebuild.
          </div>
        </div>
      ) : (
        <>
          <div className="flex flex-wrap items-center gap-2 text-sm">
            <label className="text-text-primary font-medium">Role:</label>
            <select
              value={filterRole}
              onChange={(e) => setFilterRole(e.target.value)}
              className="rounded-md border border-border bg-background px-2 py-1 text-sm"
            >
              <option value="all">All roles</option>
              {roles.map((r) => (
                <option key={r} value={r}>
                  {roleLabel(r)}
                </option>
              ))}
            </select>
            <input
              type="search"
              placeholder="Filter by route / title / file…"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              className="w-64 rounded-md border border-border bg-background px-2 py-1 text-sm"
            />
            <button
              type="button"
              onClick={handleRegen}
              className="ml-auto rounded-md border border-border bg-action-primary px-3 py-1 text-sm text-white hover:bg-action-primary-hover"
            >
              Re-read map
            </button>
          </div>

          {[...grouped.entries()].map(([role, pages]) => (
            <section key={role} className="space-y-3">
              <h2 className="text-xs font-semibold uppercase tracking-wider text-action-primary">
                {roleLabel(role)}{" "}
                <span className="font-normal text-text-muted">
                  ({pages.length})
                </span>
              </h2>
              <div className="space-y-2">
                {pages.map((p) => (
                  <article
                    key={p.route}
                    className="rounded-lg border border-border bg-card p-3 text-sm"
                  >
                    <div className="flex items-center justify-between gap-2">
                      <div className="font-medium">{p.title ?? p.route}</div>
                      <code className="text-xs text-muted-foreground">{p.route}</code>
                    </div>
                    {p.subtitle && (
                      <div className="mt-0.5 text-xs text-muted-foreground">
                        {p.subtitle}
                      </div>
                    )}
                    <div className="mt-2 space-y-1 text-xs">
                      <div>
                        <span className="text-text-secondary">file: </span>
                        <code className="text-text-muted">{p.file}</code>
                      </div>
                      {p.fetches.length > 0 && (
                        <div>
                          <span className="text-text-secondary">loads: </span>
                          <span className="text-text-muted">
                            {p.fetches
                              .map((f) => `${f.method} ${f.url}`)
                              .join(" · ")}
                          </span>
                        </div>
                      )}
                      {p.capabilities.length > 0 && (
                        <div>
                          <span className="text-text-secondary">gates: </span>
                          <span className="text-text-muted">
                            {p.capabilities.join(", ")}
                          </span>
                        </div>
                      )}
                      {p.buttons.length > 0 && (
                        <div>
                          <span className="text-text-secondary">actions: </span>
                          <span className="text-text-muted">
                            {p.buttons
                              .map((b) =>
                                b.action
                                  ? `${b.label} → ${b.action}`
                                  : `${b.label} (describe me)`,
                              )
                              .join(" · ")}
                          </span>
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </>
      )}
    </div>
  );
}

export default function AppMapPage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <AppMapInner />
    </Suspense>
  );
}
</file>

<file path="src/app/(sysadmin)/sysadmin/application-health/page.tsx">
"use client";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { Activity, AlertTriangle } from "lucide-react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface HealthData {
  status: "healthy" | "degraded" | "unhealthy";
  timestamp: string;
  uptimeSeconds: number;
  metrics: {
    activeUsers: number;
    activeSessions: number;
    requestsPerMinute: number;
    errorRate: number;
    avgResponseTime: number;
  };
  services: Record<string, unknown>;
  database: { status: string; latencyMs: number };
  gateways: { status: string; online: number; offline: number; total: number };
  recentAlerts: Array<{ id: string; severity: string; message: string; timestamp: string }>;
}

function formatUptime(s: number): string {
  const d = Math.floor(s / 86400);
  const h = Math.floor((s % 86400) / 3600);
  const m = Math.floor((s % 3600) / 60);
  if (d > 0) return `${d}d ${h}h ${m}m`;
  if (h > 0) return `${h}h ${m}m`;
  return `${m}m`;
}

function ApplicationHealthInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "sysadmin") as Role;

  const { data, loading, error, refresh } = useApiResource<
    { success: boolean; data: HealthData }
  >("/api/sysadmin/application-health", { ttlMs: 30_000 });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const health: HealthData | undefined = (data as { success: boolean; data: HealthData } | null)?.data;
  const safeHealth = health ?? { status: "degraded", uptimeSeconds: 0, metrics: { activeUsers: 0, activeSessions: 0, requestsPerMinute: 0, errorRate: 0, avgResponseTime: 0 }, recentAlerts: [] };

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-4 sm:py-6 min-w-0">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Application Health & Latency"
        purpose="Monitor real-time application throughput, request latencies, active user sessions, and service response health."
        statusSummary={`${data?.data?.status ?? "System"} operational with ${data?.data?.metrics?.requestsPerMinute ?? 0} rpm and ${data?.data?.metrics?.errorRate ?? 0}% error rate.`}
        why="Tracking runtime latency and API failure rates detects performance degradation before it impacts gate turnaround times."
        primaryAction={{ label: "Database Health", href: "/sysadmin/database-health" }}
        secondaryAction={{ label: "Docker Services", href: "/sysadmin/docker-services" }}
      />
      <div>
        <p className="text-2xl font-bold text-text-primary flex items-center gap-2">
          <Activity className="w-6 h-6 text-action-danger" />
          Application Health
        </p>
        <p className="text-xs text-text-muted mt-1">
          App-level process health, request metrics and service checks. Host &amp; container
          telemetry lives under Docker and Service Status.
        </p>
      </div>

      <div className="flex items-center justify-between">
        <p className="text-sm text-text-muted">
          Signed in as <span className="font-mono text-text-secondary">{role}</span>
        </p>
      </div>

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning">
          <AlertTriangle className="w-4 h-4 inline mr-2" />
          Application health data unavailable: {error}
        </div>
      )}

      <WidgetBoundary title="Application Health">
        {!busy && !health ? (
          <div className="surface-card bg-bg-base p-8 text-center min-w-0">
            <p className="text-sm text-text-muted">No application health data available.</p>
          </div>
        ) : (
          <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
            <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2">
              <span className="text-sm font-semibold text-white">Process &amp; Request Metrics</span>
              <span
                className={`text-xs font-bold px-2 py-0.5 rounded-full ${
                  health?.status === "healthy"
                    ? "bg-emerald-500/20 text-action-success"
                    : health?.status === "degraded"
                      ? "bg-amber-500/20 text-action-warning"
                      : "bg-rose-500/20 text-action-danger"
                }`}
              >
                {health?.status ?? "loading"}
              </span>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 p-4 min-w-0">
              {busy ? (
                Array.from({ length: 6 }).map((_, i) => (
                  <div key={i} className="h-14 animate-pulse rounded-lg bg-bg-elevated/40" />
                ))
              ) : (
                <>
                  <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                    <p className="text-xs text-text-muted uppercase">Uptime</p>
                    <p className="text-lg font-bold text-action-info">{formatUptime(safeHealth.uptimeSeconds)}</p>
                  </div>
                  <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                    <p className="text-xs text-text-muted uppercase">Active Users</p>
                    <p className="text-lg font-bold text-action-success">{safeHealth.metrics.activeUsers}</p>
                  </div>
                  <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                    <p className="text-xs text-text-muted uppercase">Active Sessions</p>
                    <p className="text-lg font-bold text-action-success">{safeHealth.metrics.activeSessions}</p>
                  </div>
                  <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                    <p className="text-xs text-text-muted uppercase">Req/min</p>
                    <p className="text-lg font-bold text-white">{safeHealth.metrics.requestsPerMinute}</p>
                  </div>
                  <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                    <p className="text-xs text-text-muted uppercase">Error Rate</p>
                    <p className={`text-lg font-bold ${safeHealth.metrics.errorRate > 5 ? "text-action-danger" : "text-action-success"}`}>
                      {safeHealth.metrics.errorRate}%
                    </p>
                  </div>
                  <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                    <p className="text-xs text-text-muted uppercase">Avg Response</p>
                    <p className="text-lg font-bold text-white">{safeHealth.metrics.avgResponseTime}ms</p>
                  </div>
                </>
              )}
            </div>
            {!busy && safeHealth.recentAlerts.length > 0 && (
              <div className="px-4 pb-4 min-w-0">
                <p className="text-xs font-semibold uppercase text-text-muted mb-2">Recent Alerts</p>
                <div className="space-y-2 min-w-0">
                  {safeHealth.recentAlerts.slice(0, 5).map((a) => (
                    <div key={a.id} className="surface-card bg-bg-surface/40 p-3 flex items-center justify-between gap-2">
                      <span className="text-sm text-text-secondary truncate">{a.message}</span>
                      <span
                        className={`text-xs font-bold uppercase px-2 py-0.5 rounded-full shrink-0 ${
                          a.severity === "critical"
                            ? "bg-rose-500/20 text-action-danger"
                            : a.severity === "warning"
                              ? "bg-amber-500/20 text-action-warning"
                              : "bg-bg-elevated/40 text-text-muted"
                        }`}
                      >
                        {a.severity}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </WidgetBoundary>

    </div>
  );
}

export default function ApplicationHealthPage() {
  return (
    <AuthGuard allowedRoles={["sysadmin", "admin"]}>
      <Suspense fallback={<PageLoading />}>
        <ApplicationHealthInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(sysadmin)/sysadmin/attendance/page.tsx">
"use client";
import { errMsg } from "@/lib/err-msg";
import { useEffect, useState } from "react";
import { DataTable } from "@/components/ui/DataTable";
import { EntityInspector, KVPairs, ActionRow, InspectorButton } from "@/components/shared/EntityInspector";
import { CalendarDays, CheckCircle2, XCircle, Clock } from "lucide-react";
import type { Scan, Student } from "@/lib/types";
import { useApi } from "@/hooks/useApi";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface Row {
  roll: string;
  name: string;
  department: string;
  timeIn: string | null;
  timeOut: string | null;
  status: "present" | "absent" | "late";
  lastTimestamp: string | null;
}

function fmtTime(iso: string | null) {
  if (!iso) return "—";
  return new Date(iso).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
}

/**
 * SysAdmin Attendance — ported from the admin console so the root operator can
 * review daily student attendance (present/late/absent by date).
 */
export default function SysAdminAttendancePage() {
  const api = useApi();
  const [rows, setRows] = useState<Row[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [date, setDate] = useState(new Date().toISOString().slice(0, 10));
  const [active, setActive] = useState<Row | null>(null);

  useEffect(() => {
    let cancelled = false;
    const load = async () => {
      setLoading(true);
      setError(null);
      try {
        const [logsRes, stuRes] = await Promise.all([
          fetch(`/api/gate/logs?date=${date}&limit=1000`, { headers: api.getHeaders(), cache: "no-store" }),
          fetch(`/api/students`, { headers: api.getHeaders(), cache: "no-store" }),
        ]);
        if (!logsRes.ok || !stuRes.ok) throw new Error("Failed to fetch attendance logs or student list");
        const logsJson = await logsRes.json();
        const stuJson = await stuRes.json();
        if (cancelled) return;
        const logs: Scan[] = logsJson?.data?.logs ?? [];
        const students: Student[] = stuJson?.data ?? [];

        const byRoll: Record<string, Row> = {};
        for (const s of students) {
          const key = s.uniqueId || s.roll || "";
          if (!key) continue;
          byRoll[key] = { roll: key, name: s.fullName || s.name || "", department: s.department || "", timeIn: null, timeOut: null, status: "absent", lastTimestamp: null };
        }
        for (const log of logs) {
          const row = (byRoll[log.roll] ??= { roll: log.roll, name: log.name, department: log.department || "", timeIn: null, timeOut: null, status: "absent", lastTimestamp: null });
          if (log.direction === "IN") { if (!row.timeIn) row.timeIn = log.timestamp; }
          else if (log.direction === "OUT") { row.timeOut = log.timestamp; }
          row.lastTimestamp = log.timestamp;
        }
        for (const r of Object.values(byRoll)) {
          if (!r.timeIn) r.status = "absent";
          else {
            const inTime = new Date(r.timeIn);
            const cutoff = new Date(r.timeIn);
            cutoff.setHours(9, 15, 0, 0);
            r.status = inTime > cutoff ? "late" : "present";
          }
        }
        const present = Object.values(byRoll).filter((r) => r.timeIn || r.timeOut);
        const absent = Object.values(byRoll).filter((r) => !r.timeIn && !r.timeOut).slice(0, 50);
        setRows([...present, ...absent]);
      } catch (err) {
        console.error("Failed to load attendance data:", err);
        if (!cancelled) setError(errMsg(err) || "Failed to load attendance data");
      } finally {
        if (!cancelled) setLoading(false);
      }
    };
    load();
    return () => { cancelled = true; };
  }, [date, api]);

  const stats = {
    present: rows.filter((r) => r.status === "present").length,
    late: rows.filter((r) => r.status === "late").length,
    absent: rows.filter((r) => r.status === "absent").length,
  };

  return (
    <AuthGuard allowedRoles={["admin", "sysadmin"]}>
      <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Student Daily Attendance"
        purpose="Audit campus-wide daily student check-ins, resolve time-in/time-out discrepancies, and verify presence rosters."
        statusSummary={`${rows.length} total student attendance records loaded for date ${date} with ${rows.filter((r) => r.status === "present").length} verified present.`}
        why="Accurate attendance logs substantiate curfew adherence, satisfy university compliance mandates, and feed outpass decision workflows."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "Analytics", href: "/sysadmin/analytics" }}
      />
        <PageHeader title="Attendance" subtitle="Daily student attendance records" />
        <div className="flex items-center justify-between flex-wrap gap-2">
          <div className="flex items-center gap-2">
            <input
              type="date"
              value={date}
              onChange={(e) => setDate(e.target.value)}
              className="surface-card px-3 py-1.5 min-h-11 bg-bg-surface text-sm"
            />
          </div>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div className="surface-card bg-bg-surface p-4 text-center">
            <p className="text-2xl font-bold text-action-success">{stats.present}</p>
            <p className="text-xs text-text-muted">Present</p>
          </div>
          <div className="surface-card bg-bg-surface p-4 text-center">
            <p className="text-2xl font-bold text-action-warning">{stats.late}</p>
            <p className="text-xs text-text-muted">Late</p>
          </div>
          <div className="surface-card bg-bg-surface p-4 text-center">
            <p className="text-2xl font-bold text-action-danger">{stats.absent}</p>
            <p className="text-xs text-text-muted">Absent</p>
          </div>
        </div>

        <div className="bg-bg-surface rounded-xl border border-border">
          <div className="surface-card p-4 flex items-center justify-between">
            <h3 className="font-semibold flex items-center gap-2">
              <CalendarDays className="w-5 h-5 text-action-primary" />
              {new Date(date).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" })}
            </h3>
            <span className="text-sm text-text-muted">
              {loading ? "Loading…" : `${rows.length} record${rows.length === 1 ? "" : "s"}`}
            </span>
          </div>
          <DataTable
            mobileLayout="cards"
            onRowClick={(r) => setActive(r)}
            columns={[
              { header: "Student", accessor: (r) => r.name, className: "font-medium" },
              { header: "Roll No", accessor: (r) => r.roll, className: "font-mono text-text-muted" },
              {
                header: "Status",
                accessor: (r) => (
                  <span className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium ${
                    r.status === "present" ? "bg-emerald-500/10 text-action-success" :
                    r.status === "absent" ? "bg-rose-500/10 text-action-danger" :
                    "bg-amber-500/10 text-action-warning"
                  }`}>
                    {r.status === "present" ? <CheckCircle2 className="w-3.5 h-3.5" /> :
                     r.status === "absent" ? <XCircle className="w-3.5 h-3.5" /> :
                     <Clock className="w-3.5 h-3.5" />}
                    <span className="capitalize">{r.status}</span>
                  </span>
                ),
              },
              { header: "Time In", accessor: (r) => fmtTime(r.timeIn), className: "text-text-muted" },
              { header: "Time Out", accessor: (r) => fmtTime(r.timeOut), className: "text-text-muted" },
            ]}
            data={rows}
            loading={loading}
            error={error}
            emptyMessage="No attendance records for this date."
            keyExtractor={(r) => r.roll}
          />
        </div>

        <EntityInspector
          inspection={active ? {
            kind: "attendance",
            title: active.name,
            subtitle: active.roll,
            status: (
              <span
                className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium capitalize ${
                  active.status === "present"
                    ? "bg-emerald-500/10 text-action-success"
                    : active.status === "absent"
                    ? "bg-rose-500/10 text-action-danger"
                    : "bg-amber-500/10 text-action-warning"
                }`}
              >
                {active.status}
              </span>
            ),
            sections: [
              {
                title: "Overview",
                content: (
                  <KVPairs
                    items={[
                      { label: "Roll", value: <span className="font-mono text-xs">{active.roll}</span> },
                      { label: "Department", value: active.department || "—" },
                      { label: "Time in", value: fmtTime(active.timeIn) },
                      { label: "Time out", value: fmtTime(active.timeOut) },
                    ]}
                  />
                ),
              },
              {
                title: "Context",
                content: (
                  <p className="text-xs text-text-muted">Daily student attendance record — {date}.</p>
                ),
              },
              {
                title: "Actions",
                content: (
                  <ActionRow>
                    <InspectorButton
                      variant="ghost"
                      href="/sysadmin/students"
                    >
                      View student directory
                    </InspectorButton>
                  </ActionRow>
                ),
              },
            ],
          } : null}
          onClose={() => setActive(null)}
        />
      </div>
    </AuthGuard>
  );
}
