<file path="src/components/principal/shared/StoryChart.tsx">
"use client";

/* ── StoryChart ── */
/* A compact weekly-trend "story" behind a KPI. Thin wrapper over the shared
 * ChartRenderer (area, 7 points). No business logic — pure projection.
 * Composes the emerald/mint success accent so "improving" reads green.
 */

import { memo } from "react";
import {
  ChartRenderer,
  type SeriesDef,
} from "@/components/shared/ChartRenderer";

export function StoryChart({
  points,
  xKey = "day",
  valueKey = "value",
  label = "Last 7 days",
  onPointClick,
}: {
  /** 7 (or fewer) points, oldest → newest: [{ day: "Mon", value: 12 }, ...] */
  points: Array<Record<string, number | string>>;
  xKey?: string;
  valueKey?: string;
  label?: string;
  /** §12 drilldown: surface the records behind a data point when the caller
   * provides it. Omitted for display-only stories (no invented drill). */
  onPointClick?: (row: Record<string, number | string>) => void;
}) {
  const series: SeriesDef[] = [
    { key: valueKey, label: label, color: "var(--action-success)" },
  ];

  // Accessible text summary of the series (a chart needs a non-visual
  // representation). Honest: derived only from the points actually passed.
  const values = points
    .map((p) => Number(p[valueKey]))
    .filter((n) => Number.isFinite(n));
  const summary =
    values.length === 0
      ? "no numeric values"
      : (() => {
          const min = Math.min(...values);
          const max = Math.max(...values);
          const latest = values[values.length - 1];
          return `range ${min} to ${max}, latest ${latest}.`;
        })();

  return (
    <div className="surface-card bg-bg-surface p-4 flex flex-col gap-2">
      <span className="text-xs font-semibold uppercase tracking-wide text-text-muted">
        {label}
      </span>
      {points.length === 0 ? (
        <div className="h-[120px] flex items-center justify-center text-xs text-text-muted">
          No data yet
        </div>
      ) : (
        // Accessible representation: a chart is only screen-reader-meaningful
        // with a text description (the a11y rule for charts). The wrapper
        // announces it as a labelled image whose alt text summarizes the
        // series, so a non-sighted user gets the data, not a blank canvas.
        <div
          role="img"
          aria-label={`${label}: ${points.length}-point trend. ${summary}${onPointClick ? ". Click a point to see the records behind it." : ""}`}
        >
          <ChartRenderer
            type="area"
            data={points}
            series={series}
            xKey={xKey}
            height={120}
            onPointClick={onPointClick as ((row: any) => void) | undefined}
          />
        </div>
      )}
    </div>
  );
}

export default memo(StoryChart);
</file>

<file path="src/components/principal/shared/SynchronizationIndicator.tsx">
"use client";

/**
 * SynchronizationIndicator — PR-14. The honest "what is the state of this
 * data" line for a panel fed by useSynchronization. It NEVER shows a live
 * dot: the mode is always "refresh" (polling), and the indicator says so.
 * Stale data is visually distinguishable from fresh data (protocol §2.6).
 */
import type { SynchronizationState } from "@/hooks/useSynchronization";

export function SynchronizationIndicator({
  sync,
  className,
  /** Wall-clock ms to render "N ago" against (parent-provided for purity;
   *  defaults to a stable 0 → shows "never" until a real now is passed). */
  nowMs = 0,
}: {
  sync: SynchronizationState;
  className?: string;
  nowMs?: number;
}) {
  const when =
    sync.lastUpdated != null
      ? nowMs > 0
        ? `${Math.max(0, Math.round((nowMs - sync.lastUpdated) / 1000))}s ago`
        : "just now"
      : "never";

  // Honest state line. No "LIVE" badge — the transport is refresh/polling.
  const status = sync.error
    ? "refresh failed"
    : sync.syncing
      ? "refreshing"
      : sync.stale
        ? "stale"
        : "refreshed";

  return (
    <span
      className={className}
      aria-live="off"
      title={sync.error ?? "Data is refreshed on a polling cadence; not live."}
    >
      <span className="text-[11px] text-text-muted">
        <span
          className={
            "mr-1 inline-block size-1.5 rounded-full " +
            (sync.error
              ? "bg-action-danger"
              : sync.stale
                ? "bg-action-warning"
                : "bg-action-success")
          }
          aria-hidden="true"
        />
        {sync.mode === "refresh" ? "Refreshed" : sync.mode} {when}
        {" · "}
        {status}
        {sync.connection === "offline" ? " · offline" : null}
      </span>
      {sync.error ? (
        <span className="ml-1 text-[11px] text-action-danger" role="alert">
          — {sync.error}
        </span>
      ) : null}
    </span>
  );
}

export default SynchronizationIndicator;
</file>

<file path="src/components/principal/InboxReviewPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  Inbox,
  CheckCircle,
  XCircle,
  Forward,
  Clock,
  TrendingUp,
  TrendingDown,
  Minus,
  AlertTriangle,
  FileDown,
  RefreshCw,
} from "lucide-react";
import { usePeriod } from "@/hooks/usePeriod";
import { useExport } from "@/hooks/useExport";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface ReviewPayload {
  data: {
    period: string;
    range: { from: string; to: string };
    summary: {
      total: number;
      approved: number;
      rejected: number;
      forwarded: number;
      approvalRate: number;
      avgResolutionHours: number;
      lastMonthTotal: number;
      lastMonthApprovalRate: number | null;
      totalDelta: number;
      approvalRateDelta: number | null;
    };
  };
}

// ── Component ─────────────────────────────────────────────────────────────

export function PrincipalInboxReviewPanel() {
  const { period, setPeriod } = usePeriod("this-month");
  const { exportCSV } = useExport();
  const [data, setData] = useState<ReviewPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/principal/inbox/review?period=${period.key === "all-time" ? "this-month" : period.key}`,
        { headers: getAuthHeaders(), cache: "no-store" }
      );
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load");
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [period.key]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleExport = () => {
    if (!data) return;
    const s = data.summary;
    exportCSV(
      [
        { metric: "Total decisions", value: s.total },
        { metric: "Approved", value: s.approved },
        { metric: "Rejected", value: s.rejected },
        { metric: "Forwarded", value: s.forwarded },
        { metric: "Approval rate (%)", value: s.approvalRate },
        { metric: "Avg resolution (hours)", value: s.avgResolutionHours },
        { metric: "Last month total", value: s.lastMonthTotal },
        { metric: "Last month approval rate (%)", value: s.lastMonthApprovalRate ?? "n/a" },
      ],
      [
        { key: "metric", header: "Metric" },
        { key: "value", header: "Value" },
      ],
      `principal_decisions_${data.period.replace(/\s/g, "_")}.csv`
    );
  };

  const s = data?.summary;

  return (
    <WidgetBoundary name="PrincipalInboxReviewPanel" resetKey={period.key}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <Inbox className="h-4 w-4 text-action-primary shrink-0" />
            <div>
              <h2 className="text-sm font-semibold text-text-primary">Decision Review</h2>
              <p className="text-xs text-text-muted">Monthly decision stats & last-month compare</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              disabled={!data}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
            <button
              type="button"
              onClick={() => void load()}
              className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-surface"
            >
              <RefreshCw className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        <PeriodPicker value={period} onChange={setPeriod} allowCustom={false} />

        {/* Loading */}
        {loading && !data && (
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {Array.from({ length: 4 }).map((_, i) => (
              <Skeleton key={i} className="h-20 rounded-xl" />
            ))}
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-action-danger/10 p-4 text-sm text-action-danger">
            <AlertTriangle className="h-4 w-4 inline mr-1" /> {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {s && !loading && (
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {/* Total */}
            <div className="rounded-xl border border-border bg-bg-elevated p-4">
              <p className="text-xs text-text-muted">Decisions</p>
              <div className="flex items-center gap-1.5 mt-1">
                <span className="text-2xl font-bold text-text-primary tabular-nums">{s.total}</span>
                {s.lastMonthTotal > 0 && (
                  <DeltaBadge
                    value={s.total}
                    reference={s.lastMonthTotal}
                    label="vs LM"
                  />
                )}
              </div>
            </div>

            {/* Approval rate */}
            <div className="rounded-xl border border-border bg-bg-elevated p-4">
              <p className="text-xs text-text-muted">Approval rate</p>
              <div className="flex items-center gap-1.5 mt-1">
                <span className="text-2xl font-bold text-text-primary tabular-nums">{s.approvalRate}%</span>
                {s.lastMonthApprovalRate !== null && (
                  <DeltaBadge
                    value={s.approvalRate}
                    reference={s.lastMonthApprovalRate}
                    label="vs LM"
                  />
                )}
              </div>
            </div>

            {/* Avg resolution */}
            <div className="rounded-xl border border-border bg-bg-elevated p-4">
              <p className="text-xs text-text-muted">Avg resolution</p>
              <div className="flex items-center gap-1 mt-1">
                <Clock className="h-4 w-4 text-text-muted" />
                <span className="text-2xl font-bold text-text-primary tabular-nums">{s.avgResolutionHours}h</span>
              </div>
            </div>

            {/* Breakdown */}
            <div className="rounded-xl border border-border bg-bg-elevated p-4">
              <p className="text-xs text-text-muted">Breakdown</p>
              <div className="mt-1 flex items-center gap-2 text-xs">
                <span className="flex items-center gap-0.5 text-action-success">
                  <CheckCircle className="h-3 w-3" />{s.approved}
                </span>
                <span className="flex items-center gap-0.5 text-action-danger">
                  <XCircle className="h-3 w-3" />{s.rejected}
                </span>
                <span className="flex items-center gap-0.5 text-action-warning">
                  <Forward className="h-3 w-3" />{s.forwarded}
                </span>
              </div>
            </div>
          </div>
        )}

        {s && s.total === 0 && !loading && (
          <EmptyState title="No decisions in this period" description="Decisions will appear once tickets are processed." />
        )}
      </div>
    </WidgetBoundary>
  );
}

export default PrincipalInboxReviewPanel;
</file>

