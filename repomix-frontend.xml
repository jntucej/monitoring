"use client";
// src/app/(student)/student/anti-ragging/page.tsx
"use client";

import { useState } from "react";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { AntiRaggingProgress } from "@/components/student/AntiRaggingProgress";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

export default function AntiRaggingPage() {
  const [form, setForm] = useState({
    isAnonymous: true,
    category: "ragging",
    severity: "high",
    narrative: "",
    location: "",
    occurredAt: "",
    accusedInfo: "",
    witnessInfo: "",
  });
  const [busy, setBusy] = useState(false);
  const [caseNumber, setCaseNumber] = useState<string | null>(null);
  const addToast = useUIStore((s) => s.addToast);

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    setBusy(true);
    const r = await fetch("/api/anti-ragging/report", {
      method: "POST",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify(form),
    });
    const j = await r.json();
    setBusy(false);
    if (j.success) {
      setCaseNumber(j.data.caseNumber);
      addToast({ variant: "success", message: "Case filed successfully" });
    } else {
      addToast({ variant: "error", message: j.error?.message ?? "Failed" });
    }
  };

  if (caseNumber) {
    return (
      <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-6">
        <ContextSituationBar
          roleLabel="Student"
          purpose="Confidential reporting channel for ragging, bullying, and harassment incidents"
          contextLabel="Confidential Protection"
          severity="ok"
          statusPill={`Case #${caseNumber}`}
          statusSummary="Your report has been lodged directly with the Principal's office."
          why="Anti-ragging filings bypass routine department triage to protect student privacy and ensure immediate executive review."
          primaryAction={{ label: "View Complaints", href: "/student/complaints" }}
          secondaryAction={{ label: "Student Home", href: "/student" }}
        />
        <div className="space-y-4">
          <h1 className="text-2xl font-semibold text-emerald-700">Case filed successfully</h1>
          <p className="text-sm">
            Your confidential case number is <strong className="font-mono">{caseNumber}</strong>.
          </p>
          <p className="text-sm text-text-muted">
            Only the Principal&apos;s office will see this report. You may be contacted via the secure channels you provided.
          </p>
          <div className="surface-card pt-4 space-y-2">
            <p className="text-sm font-medium">Helpline references:</p>
            <ul className="text-sm list-disc pl-5 text-text-muted space-y-1">
              <li>UGC Anti-Ragging Helpline: 1800-180-5522</li>
              <li>AICTE Anti-Ragging: 1800-425-2248</li>
              <li>Campus Security Desk: 24/7 Helpline</li>
            </ul>
          </div>
        </div>
        {/* Show the live progress of this + your other cases (who it was
            assigned to, which stage, committee notes). */}
        <AntiRaggingProgress />
      </div>
    );
  }

  return (
    <form onSubmit={submit} className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-4 py-6">
      <div>
        <h1 className="text-2xl font-semibold text-action-danger">Anti-Ragging / Harassment Report</h1>
        <p className="text-sm text-text-muted mt-1">
          This is a confidential, restricted channel. Only the Principal&apos;s office will see this filing.
        </p>
      </div>

      <ContextSituationBar
        roleLabel="Student"
        purpose="Confidential reporting channel for ragging, bullying, and harassment incidents"
        contextLabel="Safety Escalation"
        severity="critical"
        statusPill="Confidential Channel"
        statusSummary="Direct, restricted intake reviewed exclusively by the Principal's office. Anonymous filing supported."
        why="Incidents are treated with strict confidentiality under UGC and campus safety guidelines to guarantee student protection."
        primaryAction={{ label: "General Complaints", href: "/student/complaints" }}
        secondaryAction={{ label: "Campus Safety Helpline", href: "tel:18001805522" }}
      />

      <div>
        <label className="block text-sm font-medium text-text-muted mb-1" htmlFor="category">Category</label>
        <select id="category"
          value={form.category}
          onChange={(e) => setForm({ ...form, category: e.target.value })}
          className="surface-card w-full min-h-11 p-2 text-sm"
        >
          <option value="ragging">Ragging</option>
          <option value="harassment">Harassment</option>
          <option value="bullying">Bullying</option>
          <option value="sexual_harassment">Sexual harassment</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div>
        <label className="block text-sm font-medium text-text-muted mb-1" htmlFor="narrative">Narrative</label>
        <textarea id="narrative"
          required
          rows={6}
          placeholder="Describe what happened in detail…"
          value={form.narrative}
          onChange={(e) => setForm({ ...form, narrative: e.target.value })}
          className="surface-card w-full p-2 text-sm"
        />
      </div>

      <div>
        <label className="block text-sm font-medium text-text-muted mb-1" htmlFor="location-optional">Location (optional)</label>
        <input id="location-optional"
          placeholder="e.g. Hostel B Mess, Corridor 2"
          value={form.location}
          onChange={(e) => setForm({ ...form, location: e.target.value })}
          className="surface-card w-full min-h-11 p-2 text-sm"
        />
      </div>

      <button type="submit" disabled={busy} className="surface-card inline-flex min-h-11 items-center justify-center px-4 py-2 bg-action-danger text-white text-sm font-medium disabled:opacity-50">
        {busy ? "Filing confidential report..." : "Submit Confidential Report"}
      </button>

      {/* Existing cases + their progress (who it's with, which stage). */}
      <AntiRaggingProgress />
    </form>
  );
}
