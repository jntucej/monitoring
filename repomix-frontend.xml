function fmtRange(l: VisitorLogRow): string {
  const inAt = l.check_in_at
    ? new Date(l.check_in_at).toLocaleString("en-IN", {
        day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit",
      })
    : "—";
  const outAt = l.check_out_at
    ? new Date(l.check_out_at).toLocaleString("en-IN", {
        day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit",
      })
    : "in progress";
  return `${inAt} → ${outAt}`;
}

function VisitorHistoryInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "visitor") as Role;
  const tier = getRoleTier(role);

  const [
    inspection,
    setInspection,
  ] = useState<EntityInspection | null>(null);

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<VisitorsMineResponse>("/api/visitors/mine", { ttlMs: 30_000 });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const history = data?.data?.history ?? [];

  return (
    <div className="mx-auto max-w-7xl space-y-6 px-4 py-6 md:px-6 min-w-0">
      <Link
        href="/visitor"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Visitor Portal
      </Link>

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <h1 className="text-base font-semibold text-white">History</h1>
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Campus Visitor"
        purpose="Review past campus visits, check-in timestamps, hosts visited, and exit records."
        contextLabel="Visit History Log"
        statusTone="info"
        statusPill={`${history.length} Visit${history.length === 1 ? "" : "s"}`}
        statusSummary={
          history.length > 0
            ? `You have ${history.length} recorded campus visit${history.length === 1 ? "" : "s"}. Click any entry to inspect details.`
            : "No previous campus visits on record yet. Logged visits will be archived here."
        }
        primaryAction={{ label: "Visit & Check-In", href: "/visitor/visit" }}
        secondaryAction={{ label: "Request Visit", href: "/visitor/request" }}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">History unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      <WidgetBoundary title="History">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <History className="w-4 h-4 text-action-info shrink-0" />
              <span className="text-sm font-semibold text-white truncate">Completed visits</span>
              <HelpTip text="Historical visitor records are archived and kept for campus audit and compliance." />
            </div>
            <span className="text-xs text-text-muted shrink-0">{history.length} visit(s)</span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" /> Loading…
            </div>
          ) : history.length === 0 ? (
            <div className="p-6 min-w-0 text-center space-y-2">
              <p className="text-sm font-medium text-text-secondary">No completed visits yet</p>
              <p className="text-xs text-text-muted">Your visit history will appear here once you complete a campus visit.</p>
              <div className="pt-2">
                <Link
                  href="/visitor/request"
                  className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-action-primary text-white hover:opacity-90 transition-opacity"
                >
                  Request a Visit
                </Link>
              </div>
            </div>
          ) : (
            <div className="divide-y divide-slate-800 min-w-0">
              {history.map((l) => (
                <button
                  key={l.id}
                  type="button"
                  onClick={() => setInspection(visitorVisitInspection(l))}
                  className="w-full text-left px-4 py-3 flex flex-wrap items-center gap-3 min-w-0 hover:bg-bg-elevated/30 transition-colors focus-visible:ring-2 focus-visible:ring-action-primary focus-visible:outline-none"
                >
                  <span className="text-xs text-text-muted w-40 shrink-0">{fmtRange(l)}</span>
                  <div className="flex-1 min-w-0">
                    {l.host?.name ? (
                      <p className="text-sm text-text-secondary truncate">Visiting <span className="font-semibold">{l.host.name}</span></p>
                    ) : (
                      <p className="text-sm text-text-muted">Host not recorded</p>
                    )}
                    {l.purpose && (
                      <p className="text-xs text-text-muted truncate">Purpose: {l.purpose}</p>
                    )}
                  </div>
                  <span className="surface-card px-2 py-0.5 text-xs bg-bg-elevated/40 text-text-secondary shrink-0">{l.check_out_at ? "completed" : "active"}</span>
                  <Search className="size-3.5 text-text-muted shrink-0" aria-hidden="true" />
                </button>
              ))}
            </div>
          )}
        </div>
      </WidgetBoundary>

      {/* Read-only inspection drawer: inspect + context only (no write
          actions — a visitor cannot act on their own visit records). */}
      {inspection ? (
        <EntityInspector inspection={inspection} onClose={() => setInspection(null)} />
      ) : null}
    </div>
  );
}

export default function VisitorHistoryPage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <VisitorHistoryInner />
    </Suspense>
  );
}
</file>

