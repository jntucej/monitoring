<file path="src/components/faculty/AssignmentsCard.tsx">
"use client";

/**
 * AssignmentsCard — a faculty "My assignments" summary card (Flow B).
 *
 * Lists the faculty's own assignments with submitted/total counts + a
 * "needs confirmation" flag (pending > 0), so the real pain point — "are all
 * done?" — is one glance on the faculty dashboard instead of 40 individual
 * checks. Each row links into the class detail (faculty/class/[id]) where the
 * confirm-complete + bulk-grade affordances live. Gated by the
 * `assignment.view` capability (renders nothing unless the role grants it).
 */

import { useApiResource } from "@/hooks/useApiResource";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";
import { ListChecks, CircleCheck, Clock } from "lucide-react";
import Link from "next/link";
import { AssignmentConfirmationBar } from "@/components/nav/AssignmentConfirmationBar";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";

interface AssignmentRow {
  id: string;
  classId: string;
  title: string;
  dueAt: string;
  submitted: number;
  total: number;
}
interface AssignmentsResp {
  data: { assignments: AssignmentRow[] };
}

function AssignmentsCardInner() {
  const role = useAuthStore((s) => s.user?.role);
  const addToast = useUIStore((s) => s.addToast);
  const { data, error, loading } = useApiResource<AssignmentsResp>(
    "/api/assignments?scope=faculty",
    { ttlMs: 300_000 },
  );
  const rows = data?.data?.assignments ?? [];
  const open = rows.filter((r) => r.submitted < r.total).length;

  if (loading) {
    return (
      <WidgetBoundary name="AssignmentsCard" title="My assignments" capability="assignment.view">
        <PageLoading />
      </WidgetBoundary>
    );
  }
  if (error) {
    return (
      <WidgetBoundary name="AssignmentsCard" title="My assignments" capability="assignment.view">
        <div className="surface-card bg-bg-surface p-4 text-sm text-text-muted">
          Assignments unavailable{error ? `: ${String(error)}` : ""}.
        </div>
      </WidgetBoundary>
    );
  }

  return (
    <WidgetBoundary name="AssignmentsCard" title="My assignments" capability="assignment.view">
      <div className="surface-card bg-bg-surface p-4 space-y-3">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <ListChecks className="h-4 w-4 text-action-primary" />
            <h3 className="text-sm font-semibold text-text-primary">My assignments</h3>
          </div>
          {open > 0 && (
            <span className="text-xs text-amber-500">{open} needs confirmation</span>
          )}
        </div>

        {rows.length === 0 ? (
          <p className="text-sm text-text-muted">
            No assignments yet. Create one from your class view.
          </p>
        ) : (
          <div className="space-y-2">
            {rows.slice(0, 6).map((a) => {
              const done = a.submitted >= a.total;
              return (
                <div key={a.id} className="space-y-2">
                  <Link
                    href={`/faculty/class/${a.classId}`}
                    className="flex items-center justify-between gap-3 rounded-lg bg-bg-elevated p-2.5 hover:bg-bg-elevated/70"
                  >
                    <div className="min-w-0">
                      <div className="text-sm font-medium text-text-primary truncate">{a.title}</div>
                      <div className="flex items-center gap-1.5 text-xs text-text-muted">
                        <Clock className="h-3 w-3" />
                        Due {new Date(a.dueAt).toLocaleDateString(undefined, { day: "numeric", month: "short" })}
                      </div>
                    </div>
                    <div className="flex items-center gap-2 text-xs">
                      {done ? (
                        <span className="inline-flex items-center gap-1 text-emerald-500">
                          <CircleCheck className="h-3.5 w-3.5" /> {a.submitted}/{a.total}
                        </span>
                      ) : (
                        <span className="text-text-muted tabular-nums">
                          {a.submitted}/{a.total} submitted
                        </span>
                      )}
                    </div>
                  </Link>
                  <AssignmentConfirmationBar
                    assignment={{
                      id: a.id,
                      title: a.title,
                      dueDate: new Date(a.dueAt).toLocaleDateString(undefined, { day: "numeric", month: "short" }),
                      verifiedByFaculty: done,
                    }}
                    role={role ?? "faculty"}
                    onAction={(act, note) => {
                      addToast({
                        message: `${act.label} recorded for ${a.title}${note ? `: ${note}` : ""}`,
                        variant: "success",
                      });
                    }}
                  />
                </div>
              );
            })}
          </div>
        )}
      </div>
    </WidgetBoundary>
  );
}

export function AssignmentsCard() {
  return <AssignmentsCardInner />;
}
</file>

<file path="src/components/faculty/ClassConfirmCard.tsx">
"use client";

/**
 * ClassConfirmCard — the faculty "Confirm my classes today" card (Flow A).
 *
 * Lists the faculty's scheduled sessions for today, each with its current
 * confirmation state (PENDING / CONFIRMED / NO_SHOW / SUBSTITUTED) + a
 * Confirm button, plus a "Confirm all my classes today" bulk button at the
 * top (the /api/class-sessions/confirm-bulk action). Gated by the
 * `class.confirm` capability (the single resolver) — renders nothing unless
 * the role grants it.
 *
 * Confirmation is intent; attendance is evidence. A green "confirmed" tick
 * here is the pre-class prompt's answer, not a record that the class
 * happened (the HOD no-show alert is what surfaces the real miss).
 */

import { useState } from "react";
import { useApiResource } from "@/hooks/useApiResource";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";
import { Check, Clock, CheckCheck, UserMinus } from "lucide-react";

interface TodaySession {
  sessionId: string;
  classId: string;
  className: string;
  subjectCode: string | null;
  periodNo: number;
  sessionDate: string;
  startTime: string;
  facultyId: string | null;
  confirmationState: string;
  confirmedAt: string | null;
  substitute: string | null;
  minutesToStart: number;
}
interface TodayResp {
  data: { sessions: TodaySession[]; pendingToday: number; canConfirmAll: boolean; date: string };
}

// Same-origin browser fetch: assertCsrf validates the Origin header, which a
// same-origin app request always carries — no token needed. Credentials are
// "include" so the HttpOnly access_token cookie rides the POST.
async function postJson(url: string, body: unknown) {
  const res = await fetch(url, {
    method: "POST",
    credentials: "include",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  return res.json();
}

function ClassConfirmCardInner() {
  const { data, error, loading, refresh } = useApiResource<TodayResp>(
    "/api/class-sessions/confirmations/today",
    { ttlMs: 120_000 },
  );
  const [busy, setBusy] = useState(false);
  const [bulkBusy, setBulkBusy] = useState(false);
  const [result, setResult] = useState<string | null>(null);
  const sessions = data?.data?.sessions ?? [];
  const canConfirmAll = data?.data?.canConfirmAll ?? false;

  async function confirmOne(s: TodaySession) {
    setBusy(true);
    setResult(null);
    const res = await postJson(`/api/class-sessions/${s.sessionId}/confirm`, {
      action: "confirm",
      classId: s.classId,
      periodNo: s.periodNo,
      sessionDate: s.sessionDate,
    });
    setBusy(false);
    setResult(res?.success ? "Confirmed." : `Couldn’t confirm: ${JSON.stringify(res?.error ?? res)}`);
    refresh?.();
  }

  async function confirmAll() {
    setBulkBusy(true);
    setResult(null);
    const items = sessions
      .filter((s) => s.confirmationState === "PENDING" || s.confirmationState === "NOT_SCHEDULED")
      .map((s) => ({
        sessionId: s.sessionId,
        classId: s.classId,
        periodNo: s.periodNo,
        sessionDate: s.sessionDate,
      }));
    const res = await postJson("/api/class-sessions/confirm-bulk", {
      action: "confirm",
      items,
    });
    setBulkBusy(false);
    if (res?.success) {
      const okCount = res.data?.confirmed?.length ?? 0;
      const failed = res.data?.failed?.length ?? 0;
      setResult(failed === 0 ? `Confirmed ${okCount} class(es).` : `Confirmed ${okCount}, ${failed} failed.`);
    } else {
      setResult(`Couldn’t confirm all: ${JSON.stringify(res?.error ?? res)}`);
    }
    refresh?.();
  }

  if (loading) {
    return (
      <WidgetBoundary name="ClassConfirmCard" title="Confirm my classes today" capability="class.confirm">
        <PageLoading />
      </WidgetBoundary>
    );
  }
  if (error || sessions.length === 0) {
    return (
      <WidgetBoundary name="ClassConfirmCard" title="Confirm my classes today" capability="class.confirm">
        <div className="surface-card bg-bg-surface p-4 text-sm text-text-muted">
          {error ? "Confirmations unavailable." : "No classes scheduled today — nothing to confirm."}
        </div>
      </WidgetBoundary>
    );
  }

  return (
    <WidgetBoundary name="ClassConfirmCard" title="Confirm my classes today" capability="class.confirm">
      <div className="surface-card bg-bg-surface p-4 space-y-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <CheckCheck className="h-4 w-4 text-action-primary" />
            <h3 className="text-sm font-semibold text-text-primary">Confirm my classes today</h3>
          </div>
          {canConfirmAll && (
            <button
              type="button"
              onClick={confirmAll}
              disabled={bulkBusy || busy}
              className="inline-flex items-center gap-1.5 rounded-md bg-action-primary px-3 py-1.5 text-xs font-medium text-white disabled:opacity-50"
            >
              {bulkBusy ? "Confirming…" : "Confirm all today"}
            </button>
          )}
        </div>

        {result && <div className="text-xs text-action-primary">{result}</div>}

        <div className="space-y-2">
          {sessions.map((s) => {
            const state = s.confirmationState;
            const isPending = state === "PENDING" || state === "NOT_SCHEDULED";
            return (
              <div key={s.sessionId} className="flex items-center justify-between gap-3 rounded-lg bg-bg-elevated p-2.5">
                <div className="min-w-0">
                  <div className="text-sm font-medium text-text-primary truncate">
                    {s.className} · P{s.periodNo}
                  </div>
                  <div className="flex items-center gap-1.5 text-xs text-text-muted">
                    <Clock className="h-3 w-3" />
                    {s.startTime}
                    {state === "CONFIRMED" && <span className="text-emerald-500">· confirmed</span>}
                    {state === "NO_SHOW" && <span className="text-rose-500">· no-show</span>}
                    {state === "SUBSTITUTED" && (
                      <span className="text-amber-500">· substituted{s.substitute ? "" : ""}</span>
                    )}
                  </div>
                </div>
                {isPending ? (
                  <button
                    type="button"
                    onClick={() => confirmOne(s)}
                    disabled={busy}
                    className="inline-flex items-center gap-1 rounded-md border border-action-primary/40 px-2.5 py-1 text-xs font-medium text-action-primary hover:bg-action-primary/10 disabled:opacity-50"
                  >
                    <Check className="h-3.5 w-3.5" />
                    {busy ? "…" : "Confirm"}
                  </button>
                ) : state === "SUBSTITUTED" ? (
                  <span className="inline-flex items-center gap-1 text-xs text-amber-500">
                    <UserMinus className="h-3.5 w-3.5" /> Sub
                  </span>
                ) : (
                  <span className="inline-flex items-center gap-1 text-xs text-emerald-500">
                    <CheckCheck className="h-3.5 w-3.5" /> Done
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </WidgetBoundary>
  );
}

export function ClassConfirmCard() {
  return <ClassConfirmCardInner />;
}
</file>

<file path="src/components/faculty/ClassReviewsWidget.tsx">
"use client";

/**
 * ClassReviewsWidget — a faculty "My class reviews" dashboard card.
 *
 * Shows the faculty's aggregate class-session review stats (total, average,
 * by-rating histogram, most recent sessions) + a link into the detail.
 * Gated by the `class.review.view` capability (the single resolver), so it
 * renders nothing unless the role grants it. Data comes from
 * /api/class-sessions/reviews/summary?facultyId=me (the mess-review shape).
 */

import { useEffect, useState } from "react";
import { Star, BarChart3, ListChecks, ArrowUpRight } from "lucide-react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { useApiResource } from "@/hooks/useApiResource";
import { PageLoading } from "@/components/shared/LoadingStates";
import Link from "next/link";

interface Summary {
  total: number;
  averageRating: number | null;
  byRating: Record<string, number>;
  bySession: Array<{ sessionId: string; sessionDate: string; period: number; count: number; avg: number }>;
}
interface SummaryResp {
  data: Summary & { facultyId: string };
}

function starBurst(avg: number | null): string {
  if (avg == null) return "—";
  return (Math.round(avg * 10) / 10).toString();
}

function ClassReviewsWidgetInner() {
  const { data, error, loading, refresh } = useApiResource<SummaryResp>(
    "/api/class-sessions/reviews/summary?facultyId=me",
    { ttlMs: 300_000 },
  );
  const s = data?.data;
  const [busy, setBusy] = useState(false);

  const ratings = s ? [5, 4, 3, 2, 1].map((r) => ({ star: r, n: s.byRating?.[String(r)] ?? 0 })) : [];
  const maxBar = Math.max(1, ...ratings.map((r) => r.n));

  if (loading) {
    return (
      <WidgetBoundary name="ClassReviewsWidget" title="My class reviews" capability="class.review.view">
        <PageLoading />
      </WidgetBoundary>
    );
  }
  if (error || !s) {
    return (
      <WidgetBoundary name="ClassReviewsWidget" title="My class reviews" capability="class.review.view">
        <div className="surface-card bg-bg-surface p-4 text-sm text-text-muted">
          Reviews unavailable{error ? `: ${String(error)}` : ""}.
          <button type="button" onClick={() => refresh?.()} className="ml-2 text-action-primary underline">
            retry
          </button>
        </div>
      </WidgetBoundary>
    );
  }

  return (
    <WidgetBoundary name="ClassReviewsWidget" title="My class reviews" capability="class.review.view">
      <div className="surface-card bg-bg-surface p-4 space-y-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <Star className="h-4 w-4 text-amber-500" />
            <h3 className="text-sm font-semibold text-text-primary">My class reviews</h3>
          </div>
          <span className="text-xs text-text-muted">{s.total} total</span>
        </div>

        {s.total === 0 ? (
          <p className="text-sm text-text-muted">
            No class reviews yet. When students review your sessions, their feedback lands here.
          </p>
        ) : (
          <>
            {/* Average + histogram */}
            <div className="flex items-center gap-4">
              <div className="flex items-baseline gap-1">
                <span className="text-2xl font-bold text-text-primary tabular-nums">{starBurst(s.averageRating)}</span>
                <span className="text-xs text-text-muted">/ 5</span>
              </div>
              <div className="flex-1 space-y-1">
                {ratings.map((r) => (
                  <div key={r.star} className="flex items-center gap-2 text-xs">
                    <span className="w-3 text-text-muted">{r.star}</span>
                    <div className="flex-1 h-1.5 rounded-full bg-bg-elevated overflow-hidden">
                      <div
                        className="h-full rounded-full bg-amber-400"
                        style={{ width: `${(r.n / maxBar) * 100}%` }}
                      />
                    </div>
                    <span className="w-6 text-right text-text-muted tabular-nums">{r.n}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* Most recent sessions */}
            {s.bySession.length > 0 && (
              <div className="space-y-1.5">
                <div className="flex items-center gap-1.5 text-xs text-text-muted">
                  <ListChecks className="h-3.5 w-3.5" /> Recent sessions
                </div>
                {s.bySession.slice(0, 5).map((b) => (
                  <div key={b.sessionId} className="flex items-center justify-between text-xs">
                    <span className="text-text-secondary">
                      {new Date(b.sessionDate).toLocaleDateString(undefined, { day: "numeric", month: "short" })}
                      {" · "}Period {b.period}
                    </span>
                    <span className="flex items-center gap-1 text-text-muted">
                      <BarChart3 className="h-3 w-3" />
                      {b.count} · avg {b.avg}
                    </span>
                  </div>
                ))}
              </div>
            )}

            <div className="flex justify-end">
              <Link
                href="/faculty/reports"
                className="inline-flex items-center gap-1 text-xs text-action-primary hover:underline"
              >
                Open reports <ArrowUpRight className="h-3 w-3" />
              </Link>
            </div>
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export function ClassReviewsWidget() {
  return <ClassReviewsWidgetInner />;
}
</file>

<file path="src/components/faculty/ClassRoster.tsx">
"use client";

/**
 * ClassRoster — 1.12 extracted roster component for the faculty subject drilldown.
 *
 * Renders the class header (year/section + today's counts) and the roster as a
 * responsive card grid (no horizontal scroll). Selecting a student calls
 * `onSelect` with that student's row; the parent owns the selection state so
 * the RoleConsole shell never re-mounts on a roster click.
 */

import { useCallback } from "react";
import {
  GraduationCap,
  BookOpen,
  Users,
  CheckCircle2,
  XCircle,
  ShieldCheck,
  ArrowRight,
  Loader2,
  AlertTriangle,
} from "lucide-react";
import { PageLoading } from "@/components/shared/LoadingStates";
import { EmptyState } from "@/components/shared/EmptyState";
import { useApiResource } from "@/hooks/useApiResource";
import type { ClassOverview } from "@/contracts/classes";

interface OverviewResponse {
  success: boolean;
  data: ClassOverview;
  error?: { code: string; message: string };
}

export function ClassRoster({
  classId,
  subject,
  onSelect,
}: {
  classId: string;
  subject: string | null;
  onSelect: (studentId: string) => void;
}) {
  const source = `/api/faculty/my-class/${classId}`;
  const { data, loading, error, refresh } = useApiResource<OverviewResponse>(source, {
    ttlMs: 15_000,
  });

  const overview = data?.data ?? null;
  const forbidden = data?.success === false && data?.error?.code === "FORBIDDEN";

  const handleSelect = useCallback(
    (stu: ClassOverview["students"][number]) => {
      onSelect(stu.id);
    },
    [onSelect],
  );

  if (loading && !overview) {
    return (
      <div className="flex items-center justify-center gap-2 py-12 text-sm text-text-muted">
        <Loader2 className="w-4 h-4 animate-spin" /> Loading class&hellip;
      </div>
    );
  }

  if (forbidden || (data && !data.success && !loading)) {
    const msg = data?.error?.message || "You are not assigned to this class";
    return (
      <div className="p-4 space-y-3">
        {forbidden ? (
          <EmptyState
            icon={<ShieldCheck className="w-6 h-6" />}
            title="Not assigned to this class"
            description={msg}
          />
        ) : (
          <div className="surface-card py-4 px-3 text-xs text-action-warning bg-amber-400/10">
            Failed to load this class: {msg}
            <button
              type="button"
              onClick={() => void refresh()}
              className="surface-card ml-3 bg-bg-elevated px-2 py-0.5 text-xs text-text-secondary hover:text-text-primary"
            >
              Retry
            </button>
          </div>
        )}
      </div>
    );
  }

  if (!overview) {
    return (
      <EmptyState
        title="No class data"
        description="The class overview is empty or unavailable."
      />
    );
  }

  const roster = overview.students;
  const present = overview.todayPresent;
  const absent = overview.todayAbsent;
  const total = overview.totalStudents;
  const cls = overview.classRow;

  void error;

  return (
    <div className="space-y-4 p-4 min-w-0">
      {/* Class header */}
      <div className="flex flex-wrap items-center justify-between gap-3 text-xs">
        <div className="flex items-center gap-2 min-w-0">
          <GraduationCap className="w-4 h-4 text-action-primary shrink-0" />
          <span className="font-mono font-semibold text-text-primary truncate">
            {`Y${cls.year}-${cls.section}`}
            {cls.name ? ` · ${cls.name}` : ""}
          </span>
          {subject ? (
            <span className="inline-flex items-center gap-1 text-text-muted">
              <BookOpen className="w-3.5 h-3.5" />
              <span className="font-mono">{subject}</span>
            </span>
          ) : null}
        </div>
        <div className="flex items-center gap-3 text-text-muted">
          <span className="inline-flex items-center gap-1">
            <CheckCircle2 className="w-3.5 h-3.5 text-action-success" />
            <span className="tabular-nums text-action-success font-bold">{present}</span> present
          </span>
          <span className="inline-flex items-center gap-1">
            <XCircle className="w-3.5 h-3.5 text-action-danger" />
            <span className="tabular-nums text-action-danger font-bold">{absent}</span> absent
          </span>
          <span className="tabular-nums">/ {total}</span>
        </div>
      </div>

      {/* Today's attendance note for the caller's subject */}
      <div className="surface-card bg-bg-elevated px-3 py-2 text-xs text-text-muted">
        Today&apos;s attendance for{" "}
        <span className="font-mono font-semibold text-action-primary">
          {subject ?? "your subject"}
        </span>
        : {present} present, {absent} absent of {total} students.
        {overview.weekPresent != null && (
          <span className="ml-1 text-text-muted">
            · This week: {overview.weekPresent} present / {overview.weekAbsent ?? 0} absent
          </span>
        )}
      </div>

      {/* Open disputes this week */}
      {overview.disputesThisWeek && overview.disputesThisWeek.length > 0 && (
        <div className="rounded-lg border border-amber-500/20 bg-amber-500/5 px-3 py-2 space-y-1.5">
          <p className="text-xs font-semibold text-amber-600 flex items-center gap-1.5">
            <AlertTriangle className="w-3.5 h-3.5" /> Open disputes this week
          </p>
          {overview.disputesThisWeek.map((d, i) => (
            <p key={i} className="text-xs text-text-secondary">
              <span className="font-medium text-text-primary">{d.studentName}</span> · {d.date} — {d.reason}
              <span className="text-text-muted ml-1">({d.status})</span>
            </p>
          ))}
        </div>
      )}

      {/* Roster — cards, no horizontal scroll */}
      <div className="grid grid-cols-1 gap-2">
        {roster.length === 0 ? (
          <EmptyState
            icon={<Users className="w-6 h-6" />}
            title="No students in this class"
            description="The roster is empty for the selected class."
          />
        ) : (
          roster.map((stu) => (
            <button
              key={stu.id}
              type="button"
              onClick={() => handleSelect(stu)}
              className="surface-card flex items-center justify-between gap-3 bg-bg-elevated px-3 py-2 min-w-0 text-left hover: transition-colors"
            >
              <div className="min-w-0">
                <p className="text-sm font-semibold truncate text-text-primary">
                  {stu.name || "Unnamed student"}
                </p>
                <p className="text-xs font-mono text-text-muted">
                  Roll {stu.roll || "—"}
                  {stu.year != null ? ` · Y${stu.year}` : ""}
                  {stu.section ? ` · ${stu.section}` : ""}
                </p>
              </div>
              <ArrowRight className="w-3.5 h-3.5 shrink-0 text-text-muted" />
            </button>
          ))
        )}
      </div>
    </div>
  );
}

export { PageLoading };
</file>

<file path="src/components/faculty/FacultyRosterPanel.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import {
  GraduationCap,
  Users,
  Clock,
  AlertTriangle,
  CheckCircle2,
  XCircle,
  FileDown,
  Pencil,
  ChevronRight,
  TrendingUp,
} from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { usePeriod } from "@/hooks/usePeriod";
import { useExport } from "@/hooks/useExport";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { EditableField } from "@/components/shared/EditableField";
import { RaiseIssueButton } from "@/components/shared/RaiseIssueButton";
import { ScheduleStrip, type ScheduleItem } from "@/components/shared/ScheduleStrip";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface RosterStudent {
  id: string;
  name: string;
  uniqueId: string;
  present: number;
  absent: number;
  unmarked: number;
  total: number;
  pct: number;
}

interface RosterPayload {
  data: {
    classId: string;
    classLabel: string;
    period: string;
    summary: {
      total: number;
      present: number;
      absent: number;
      unmarked: number;
      pct: number;
      lastMonthPct: number | null;
    };
    students: RosterStudent[];
    upcoming: Array<{
      date: string;
      timeIn: string | null;
      timeOut: string | null;
    }>;
    disputes: Array<{
      id: string;
      studentName: string;
      date: string;
      reason: string;
      status: string;
    }>;
  };
}

// ── Sub-components ────────────────────────────────────────────────────────

function StudentRow({
  student,
  onEditPresent,
  onEditAbsent,
}: {
  student: RosterStudent;
  onEditPresent: (id: string, val: string, reason: string) => Promise<void>;
  onEditAbsent: (id: string, val: string, reason: string) => Promise<void>;
}) {
  const tone =
    student.pct >= 75 ? "text-emerald-500" : student.pct >= 60 ? "text-amber-500" : "text-rose-500";

  return (
    <div className="flex items-center justify-between rounded-xl border border-border bg-bg-elevated px-4 py-3">
      {/* Name */}
      <div className="flex items-center gap-3 min-w-0 flex-1">
        <Users className="h-4 w-4 text-text-muted shrink-0" />
        <div className="min-w-0">
          <p className="text-sm font-medium text-text-primary truncate">{student.name}</p>
          <p className="text-xs text-text-muted">{student.uniqueId}</p>
        </div>
      </div>

      {/* Stats */}
      <div className="flex items-center gap-4 shrink-0">
        <div className="text-right">
          <p className="text-xs text-action-success tabular-nums">
            <CheckCircle2 className="h-4 w-4 inline mr-0.5" />
            {student.present}
          </p>
          <p className="text-xs text-action-danger tabular-nums">
            <XCircle className="h-4 w-4 inline mr-0.5" />
            {student.absent}
          </p>
        </div>
        <div className={cn("text-lg font-bold tabular-nums w-12 text-right", tone)}>
          {student.pct}%
        </div>
      </div>
    </div>
  );
}

// ── Main panel ────────────────────────────────────────────────────────────

export function FacultyRosterPanel({ classId }: { classId: string }) {
  const { period, setPeriod } = usePeriod("this-month");
  const { exportCSV } = useExport();

  const [data, setData] = useState<RosterPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [editingStudent, setEditingStudent] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/faculty/attendance/roster?classId=${classId}&period=${period.key === "all-time" ? "all-time" : period.key}`,
        { headers: getAuthHeaders(), cache: "no-store" }
      );
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) {
        throw new Error(body?.message ?? "Failed to load roster");
      }
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [classId, period.key]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleEditPresent = async (studentId: string, val: string, reason: string) => {
    await fetch(`/api/faculty/attendance/roster/${studentId}`, {
      method: "PATCH",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({ field: "present", value: val, reason }),
    });
    setEditingStudent(null);
    void load();
  };

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      data.students.map((s) => ({
        name: s.name,
        uniqueId: s.uniqueId,
        present: s.present,
        absent: s.absent,
        pct: s.pct,
      })),
      [
        { key: "name", header: "Name" },
        { key: "uniqueId", header: "UID" },
        { key: "present", header: "Present" },
        { key: "absent", header: "Absent" },
        { key: "pct", header: "Percent" },
      ],
      `roster_${data.classLabel?.replace(/\s/g, "_") ?? "class"}.csv`
    );
  };

  const upcomingItems: ScheduleItem[] = (data?.upcoming ?? []).map((u, i) => ({
    id: `${u.date}-${i}`,
    title: `${data?.classLabel ?? "Class"}`,
    subtitle: u.timeIn ? `${u.timeIn}–${u.timeOut}` : undefined,
    start: `${u.date}T${u.timeIn ?? "09:00:00"}`,
    end: `${u.date}T${u.timeOut ?? "10:00:00"}`,
  }));

  return (
    <WidgetBoundary name="FacultyRosterPanel" resetKey={period.key}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <div className="p-2 rounded-xl bg-action-primary/10 text-action-primary">
              <GraduationCap className="h-4 w-4" />
            </div>
            <div>
              <h2 className="text-sm font-semibold text-text-primary">
                {data?.classLabel ?? "Class Roster"}
              </h2>
              <p className="text-xs text-text-muted">
                {data ? `${data.students.length} students` : "Loading…"}
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={handleExport}
            disabled={!data}
            className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
          >
            <FileDown className="h-3.5 w-3.5" /> Export
          </button>
        </div>

        {/* Period picker */}
        <PeriodPicker value={period} onChange={setPeriod} allowCustom={false} />

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <Skeleton className="h-14 rounded-xl" />
            {Array.from({ length: 4 }).map((_, i) => (
              <Skeleton key={i} className="h-12 rounded-xl" />
            ))}
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-rose-500/10 p-4 text-sm text-rose-600">
            <AlertTriangle className="h-4 w-4 inline mr-1" />
            {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {data && !loading && (
          <>
            {/* Summary bar */}
            <div className="flex items-center justify-between rounded-xl border border-border bg-bg-elevated px-5 py-3">
              <div className="flex items-center gap-4">
                <DeltaBadge
                  value={data.summary.pct}
                  reference={data.summary.lastMonthPct}
                  label="vs last month"
                />
                <span className="text-2xl font-bold text-text-primary tabular-nums">
                  {data.summary.pct}%
                </span>
                <span className="text-xs text-text-muted">
                  {data.summary.present}p · {data.summary.absent}a · {data.summary.unmarked}u
                </span>
              </div>
              <span className="text-xs text-text-muted">{data.period}</span>
            </div>

            {/* Upcoming */}
            {upcomingItems.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">Next classes</p>
                <ScheduleStrip items={upcomingItems} />
              </div>
            )}

            {/* Disputes */}
            {data.disputes.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">Dispute queue</p>
                <div className="space-y-1.5">
                  {data.disputes.map((d) => (
                    <div
                      key={d.id}
                      className="flex items-center gap-2 rounded-lg bg-rose-500/5 border border-rose-500/15 px-3 py-2 text-xs"
                    >
                      <AlertTriangle className="h-3.5 w-3.5 text-rose-500 shrink-0" />
                      <span className="font-medium text-text-primary">{d.studentName}</span>
                      <span className="text-text-secondary flex-1 truncate">{d.reason}</span>
                      <span className="text-text-muted tabular-nums shrink-0">{d.date}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Student list */}
            <div className="space-y-1.5">
              {data.students.length === 0 ? (
                <EmptyState title="No students in this class" />
              ) : (
                data.students.map((s) => (
                  <StudentRow
                    key={s.id}
                    student={s}
                    onEditPresent={(sid, val, reason) => handleEditPresent(sid, val, reason)}
                    onEditAbsent={(sid, val, reason) => handleEditPresent(sid, val, reason)}
                  />
                ))
              )}
            </div>
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default FacultyRosterPanel;
</file>

