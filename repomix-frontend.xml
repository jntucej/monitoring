}

function DelegationBadge({ active, loading }: { active: boolean; loading: boolean }) {
  if (loading) {
    return (
      <span className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1 text-xs text-text-muted">
        <Loader2 className="size-3.5 animate-spin motion-reduce:animate-none" /> Checking delegation…
      </span>
    );
  }
  return active ? (
    <span className="surface-card inline-flex items-center gap-1.5 bg-emerald-400/10 px-2.5 py-1 text-xs font-semibold text-action-success">
      <Gavel className="size-3.5" /> Within delegated scope — approval actions enabled
    </span>
  ) : (
    <span className="surface-card inline-flex items-center gap-1.5 bg-bg-elevated/30 px-2.5 py-1 text-xs font-semibold text-text-secondary">
      <Gavel className="size-3.5" /> Read-only — no delegation data recorded yet
    </span>
  );
}

/* main content */

function DeputyWardenDelegatedApprovalsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "deputy_warden") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();
  const [stageItem, setStageItem] = useState<StagePivotItem | null>(null);

  const inspectFirstBreached = () => {
    const first = rows.find((r) => {
      if (!r.sla_deadline) return false;
      const ts = new Date(r.sla_deadline).getTime();
      return !Number.isNaN(ts) && ts < Date.now();
    });
    if (first) {
      inspect(
        escalationInspection({
          id: first.id,
          ticket_number: first.ticket_number,
          workflow_type: first.workflow_type,
          current_stage: first.current_stage,
          status: first.status,
          sla_deadline: first.sla_deadline ?? null,
          created_at: null,
        } satisfies VPPermissionRow),
      );
    }
  };

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<PermissionsResponse>(
    "/api/permissions?workflow_type=hostel&status=PENDING&stage=deputy_warden",
    { ttlMs: 30_000 }
  );
  const {
    data: delegation,
    loading: delegationLoading,
    refresh: refreshDelegation,
  } = useApiResource<DelegationStatusResponse>("/api/deputy-warden/delegation", {
    ttlMs: 30_000,
  });

  const refreshAll = useCallback(async () => {
    clearCache();
    await Promise.all([refresh(), refreshDelegation()]);
  }, [refresh, refreshDelegation]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = (loading && !data) || (delegationLoading && !delegation);
  const delegationActive = Boolean(delegation?.data?.active);
  const rows = data?.data ?? [];
  const total = data?.total ?? rows.length;

  const slaBreached = useMemo(
    () =>
      rows.filter((r) => {
        if (!r.sla_deadline) return false;
        const ts = new Date(r.sla_deadline).getTime();
        return !Number.isNaN(ts) && ts < Date.now();
      }).length,
    [rows]
  );

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      {/* Back link */}
      <Link
        href="/deputy-warden/daily-overview"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Daily Overview
      </Link>

      {/* Page toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
          <p className="text-xs text-text-muted mt-1 min-w-0">
            Authority: the deputy warden acts only within the explicit delegation or standing policy
            scope of the principal/warden. Delegation data drives the badge below.
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Deputy Warden"
        purpose="Review permission requests within explicit warden delegation scope and escalate out-of-scope requests"
        why="Acting under delegation allows swift movement approval while safeguarding institutional policies and limits."
        contextLabel={`Delegated Scope · ${delegationActive ? "Active" : "Read-only"}`}
        statusSummary={
          delegationActive
            ? `${total} pending request${total === 1 ? "" : "s"} within your active delegation scope.${slaBreached > 0 ? ` ${slaBreached} past SLA deadline.` : ""}`
            : "No active delegation recorded. Requests viewable in read-only mode and require warden escalation."
        }
        severity={slaBreached > 0 ? "warn" : delegationActive ? "info" : "ok"}
        primaryAction={{ label: "Outpass Queue", href: "/deputy-warden" }}
        secondaryActions={[
          { label: "Leave Requests", href: "/deputy-warden/leave-requests" },
          { label: "Daily Overview", href: "/deputy-warden/daily-overview" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">Approvals data unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      {/* KPI row */}
      <WidgetBoundary title="Delegated Approvals">
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 min-w-0">
          <StatCard
            icon={Inbox}
            label="Pending at Warden Stage"
            value={total}
            sub="Hostel / outpass requests awaiting principal review"
            accent="text-action-warning"
            loading={loading && !data}
          />
          <StatCard
            icon={AlertTriangle}
            label="SLA Breached"
            value={slaBreached}
            sub="Requests past their 48h deadline"
            accent="text-action-danger"
            loading={loading && !data}
          />
          <StatCard
            icon={UserCheck}
            label="Delegation"
            value={delegationActive ? "Active" : "Not recorded"}
            sub={
              delegationActive
                ? "Approval actions enabled within delegated scope"
                : "No delegation data — this view is read-only"
            }
            accent={delegationActive ? "text-action-success" : "text-text-secondary"}
            loading={delegationLoading && !delegation}
          />
        </div>
      </WidgetBoundary>

      {/* Delegation status banner */}
      <div
        className="surface-card bg-bg-base p-4 flex flex-wrap items-center gap-3 min-w-0 cursor-pointer hover:bg-bg-elevated/30 transition-colors"
        onClick={() =>
          inspect(
            delegationStatusInspection({
              active: delegationActive,
              scopes: delegation?.data?.scopes ?? [],
              delegatedBy: delegation?.data?.delegatedBy,
              note: delegation?.data?.note,
            }),
          )
        }
      >
        <DelegationBadge active={delegationActive} loading={delegationLoading && !delegation} />
        <p className="text-xs text-text-muted min-w-0">
          {delegation?.data?.note ??
            "Delegation data is read from the principal/warden policy ledger; until a delegation is recorded, decisions here are logged as review notes and escalated to the warden stage."}
        </p>
      </div>

      {/* Queue — actionable when delegation is recorded; the shared
          PermissionList carries per-row Approve / Reject / Forward (1.13). */}
      {busy ? (
        <WidgetBoundary title="Approval Queue">
          <div className="mx-auto max-w-7xl px-4 py-6 md:px-6">
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" />{" "}
              Loading delegated-approval queue…
            </div>
          </div>
        </WidgetBoundary>
      ) : rows.length === 0 ? (
        <WidgetBoundary title="Approval Queue">
          <div className="mx-auto max-w-7xl px-4 py-6 md:px-6">
            <div className="p-6 text-center min-w-0">
              <Inbox className="w-4 h-4 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">
                No pending items at the deputy-warden stage. The queue is clear.
              </p>
            </div>
          </div>
        </WidgetBoundary>
      ) : (
        <WidgetBoundary title="Approval Queue">
          <div className="mx-auto max-w-7xl space-y-4 px-4 py-6 md:px-6 min-w-0">
            <PermissionList
              title="Delegated approval queue"
              subtitle="Act within the recorded delegation scope; forward anything outside it to the warden stage."
              workflowType="hostel"
              currentStage="deputy_warden"
              fetchUrl="/api/permissions?workflow_type=hostel&status=PENDING&stage=deputy_warden"
              allowForward
            />
          </div>
        </WidgetBoundary>
      )}

      <EntityInspectorPanel
        inspection={inspection}
        onClose={() => {
          closeInspection();
          setStageItem(null);
        }}
      />
      <ApproverStageDrawer item={stageItem} onClose={() => setStageItem(null)} />
    </div>
  );
}
export default function DeputyWardenDelegatedApprovalsPage() {
  return (
    <AuthGuard allowedRoles={['deputy_warden', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <DeputyWardenDelegatedApprovalsInner />
      </Suspense>
    </AuthGuard>
  );
}
