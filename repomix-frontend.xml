<file path="src/app/(supervisor)/supervisor/_retention/GateWall.tsx">
"use client";

import Link from "next/link";
import { DoorOpen, DoorClosed, Users, AlertTriangle } from "lucide-react";

export interface Gate {
  id: string;
  name: string;
  isActive: boolean;
  onPost: number;
  lastActivity: string | null;
}

function fmtLastActivity(iso: string | null): string {
  if (!iso) return "no activity";
  const m = Math.floor((Date.now() - new Date(iso).getTime()) / 60_000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.floor(h / 24)}d ago`;
}

export function GateWall({ gates }: { gates: Gate[] }) {
  if (gates.length === 0) {
    return (
      <section className="surface-card bg-bg-surface p-4 sm:p-5">
