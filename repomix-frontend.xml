<file path="src/components/approver/PrincipalDashboardPanel.tsx">
"use client";

/**
 * PrincipalDashboardPanel — top-priority items panel for the Principal console.
 *
 * Desktop: a side panel (rendered by RoleConsole alongside the board).
 * Mobile: full-width section below the board. No horizontal scroll.
 *
 * Reads GET /api/principal/dashboard. The endpoint exposes
 * `data.pendingApprovals` (count of PENDING exam permissions at the principal
 * stage) and `data.recentAlerts` (the 5 newest unresolved alerts, newest
 * first). Each recent alert is a live incident entity: clicking it opens the
 * standardized incident inspection (overview → context → timeline → actions)
 * in place, without navigating away from the console.
 */

import { useMemo, useState } from "react";
import { Radio, Loader2, ShieldAlert } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { useRoleContext } from "@/hooks/useRoleContext";
import { EmptyState } from "@/components/shared/EmptyState";
import { EntityInspector } from "@/components/shared/EntityInspector";
import {
  buildIncidentInspection,
  type IncidentRecord,
  type RoleGate,
} from "@/app/(approver)/principal/_shared/entityInspectionModels";

interface AlertRow {
  id: string;
  severity: string;
  title: string;
  message?: string;
  gate_id?: string | null;
  gate_name?: string | null;
  timestamp: string;
  resolved?: boolean;
}

interface PrincipalDashboardResponse {
  success?: boolean;
  data: {
    pendingApprovals?: number;
    recentAlerts?: AlertRow[];
    campusOccupancy?: string;
  };
}

function severityTone(severity: string): string {
  const s = (severity || "").toLowerCase();
  if (s === "critical") return "text-action-danger";
  if (s === "high") return "text-action-warning";
  return "text-text-secondary";
}

function fmtTime(iso: string | null | undefined): string {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleString([], {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return "—";
  }
}

export function PrincipalDashboardPanel() {
  const { data, loading } = useApiResource<PrincipalDashboardResponse>(
    "/api/principal/dashboard",
    { ttlMs: 30_000 },
  );

  const alerts = useMemo(() => {
    const raw = data?.data?.recentAlerts;
    return Array.isArray(raw) ? raw : [];
  }, [data]);

  const pendingApprovals = data?.data?.pendingApprovals ?? 0;

  const role = useRoleContext();
  const gate: RoleGate = {
    isPrincipal: role.isPrincipal,
    isFaculty: role.isFaculty,
    role: role.role ?? null,
  };
  const [inspection, setInspection] = useState<
    ReturnType<typeof buildIncidentInspection> | null
  >(null);
  const inspect = (a: AlertRow) =>
    setInspection(
      buildIncidentInspection(
        {
          id: a.id,
          title: a.title,
          message: a.message,
          severity: a.severity,
          created_at: a.timestamp,
          status: a.resolved ? "RESOLVED" : "OPEN",
        } as IncidentRecord,
        gate
      )
    );

  return (
    <section className="surface-card bg-bg-surface/60 p-4 min-w-0">
      {/* Header */}
      <div className="flex items-center justify-between gap-2 mb-3">
        <div className="flex items-center gap-2 min-w-0">
          <Radio className="w-4 h-4 text-action-primary shrink-0" />
          <span className="text-sm font-bold text-text-primary truncate">
            Principal Dashboard
          </span>
        </div>
        <span className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold bg-bg-elevated text-text-secondary">
          <span className="size-2 rounded-full bg-action-warning" />
          {pendingApprovals} pending
        </span>
      </div>

      {/* Body: recent alerts (top-priority items) or EmptyState */}
      {loading ? (
        <div className="flex items-center gap-2 text-xs text-text-muted py-3">
          <Loader2 className="w-4 h-4 animate-spin" />
          Loading dashboard…
        </div>
      ) : alerts.length > 0 ? (
        <ul className="space-y-1.5 max-h55 overflow-y-auto custom-scrollbar pr-1">
          {alerts.map((a) => (
            <li
              key={a.id}
              className="surface-card flex items-start justify-between gap-2 bg-bg-elevated px-2.5 py-1.5 min-w-0 cursor-pointer hover:bg-bg-surface transition-colors"
              role="button"
              tabIndex={0}
              onClick={() => inspect(a)}
              onKeyDown={(e) => {
                if (e.key === "Enter" || e.key === " ") inspect(a);
              }}
            >
              <div className="min-w-0 flex-1">
                <p className="text-xs font-semibold text-text-primary truncate">
                  {a.title || a.message || "Alert"}
                </p>
                <p className="text-xs font-mono text-text-muted truncate">
                  {a.gate_name || a.gate_id || "campus"} · {a.severity}
                </p>
              </div>
              <div className="shrink-0 text-right">
                <span className={`text-xs font-mono font-bold uppercase ${severityTone(a.severity)}`}>
                  {a.severity}
                </span>
                <p className="text-xs font-mono text-text-muted">
                  {fmtTime(a.timestamp)}
                </p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          className="mb-0"
          title="No active alerts"
          description="Top-priority items will appear here when alerts are raised."
          icon={<ShieldAlert className="w-4 h-4 text-text-muted" />}
        />
      )}

      <EntityInspector inspection={inspection} onClose={() => setInspection(null)} />
    </section>
  );
}

export default PrincipalDashboardPanel;
