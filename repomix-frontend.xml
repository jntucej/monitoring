<file path="src/app/(mess)/mess/consumption-reports/page.tsx">
"use client";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import {
  TrendingUp,
  ScanLine,
  Loader2,
  AlertTriangle,
  Inbox,
} from "lucide-react";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { mealDayInspection } from "@/components/approver/wardenConsoleModels";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface ConsumptionDay {
  messDayId: string;
  mealDate: string;
  mealType: string;
  isActive: boolean;
  servedTotal: number;
  viaToken: number;
  viaManual: number;
  veg: number;
  nonVeg: number;
  firstServedAt: string | null;
  lastServedAt: string | null;
}

interface ConsumptionResponse {
  success: boolean;
  data: {
    days: number;
    trend: ConsumptionDay[];
    totals: {
      served: number;
      viaToken: number;
      viaManual: number;
      veg: number;
      nonVeg: number;
    };
    avgPerDay: number;
  };
}

function fmtTime(d: string | null | undefined): string {
  if (!d) return "—";
  try {
    return new Date(d).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
  } catch {
    return d;
  }
}

function fmtDate(d: string | null | undefined): string {
  if (!d) return "—";
  try {
    return new Date(`${d}T00:00:00`).toLocaleDateString("en-IN", {
      day: "numeric",
      month: "short",
      year: "numeric",
    });
  } catch {
    return d;
  }
}

function WidgetError({ message, onRetry }: { message: string; onRetry: () => void }) {
  return (
    <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
      <span className="flex items-center gap-2 min-w-0">
        <AlertTriangle className="w-4 h-4 shrink-0" />
        <span className="truncate">{message}</span>
      </span>
      <button
        type="button"
        onClick={onRetry}
        className="surface-card min-h-11 inline-flex items-center justify-center px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
      >
        Retry
      </button>
    </div>
  );
}

function MessConsumptionReportsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "mess_incharge") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const {
    data: report,
    loading,
    error,
    refresh,
  } = useApiResource<ConsumptionResponse>("/api/mess/consumption?days=14", { ttlMs: 30_000 });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !report;
  const d = report?.data;
  const trend = d?.trend ?? [];
  const maxServed = trend.reduce((m, r) => Math.max(m, r.servedTotal), 0);

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-5 py-6 min-w-0">
      <Link
        href="/mess"
        className="inline-flex min-h-11 items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        Back to Mess Overview
      </Link>

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Mess In-Charge"
        purpose="Analyze historical dining trends, reconcile token vs manual servings, and prevent kitchen food waste"
        contextLabel={`Meal Consumption Trends · Last ${d?.days ?? 14} Days`}
        statusSummary={
          d
            ? `${d.totals?.served ?? 0} total meals served (${d.avgPerDay ?? 0} avg/day) across the monitored window.`
            : "Review meal serving distributions, scan methods, and dining trends across active mess days."
        }
        why="Multi-day consumption analysis forecasts meal preparation batches accurately and mitigates raw food waste."
        severity="info"
        primaryAction={{ label: "Token Scanner", href: "/mess/scan" }}
        secondaryActions={[
          { label: "Daily Meal Counts", href: "/mess/daily-meal-counts" },
          { label: "Meal Attendance", href: "/mess/meal-attendance" },
          { label: "Mess Overview", href: "/mess" },
        ]}
      />

      {error && (
        <WidgetError message={`Consumption report unavailable: ${error}`} onRetry={() => void refreshAll()} />
      )}

      <WidgetBoundary title="Consumption Reports">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex items-center gap-2 min-w-0">
            <TrendingUp className="w-4 h-4 text-action-success shrink-0" />
            <span className="text-sm font-semibold text-white truncate">Consumption Reports</span>
            <span className="ml-auto text-xs text-text-muted shrink-0">last {d?.days ?? 14} days</span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" />
              Loading consumption report…
            </div>
          ) : trend.length > 0 ? (
            <div className="p-4 min-w-0 space-y-4">
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 min-w-0">
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Total Served</p>
                  <p className="mt-1 text-lg font-bold text-action-success">{d?.totals?.served}</p>
                  <p className="text-xs text-text-muted">{d?.avgPerDay} avg/day</p>
                </div>
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Via Token Scan</p>
                  <p className="mt-1 text-lg font-bold text-action-info">{d?.totals?.viaToken}</p>
                  <p className="text-xs text-text-muted">{d?.totals?.viaManual} manual confirmations</p>
                </div>
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
