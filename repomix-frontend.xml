<file path="src/app/(student)/student/profile-security/sessions/page.tsx">
"use client";
import { useRouter } from "next/navigation";

import { useEffect, useState } from "react";
import { PageLoading } from "@/components/shared/LoadingStates";
import { Button } from "@/components/ui/button";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { getAuthHeaders } from "@/lib/utils";

/**
 * S3: Active sessions — reads /api/me/access-log (real endpoint) and offers
 * a sign-out-all CTA. The "Active sessions" card on /student/profile-security
 * links here, not to the decorative /security posture infographic.
 */
export default function SessionsPage() {
  const router = useRouter();
  const [rows, setRows] = useState<Array<Record<string, unknown>> | null>(null);
  const [signingOut, setSigningOut] = useState(false);

  useEffect(() => {
    let cancelled = false;
    fetch("/api/me/access-log", { headers: getAuthHeaders() })
      .then((r) => (r.ok ? r.json() : { data: [] }))
      .then((j) => { if (!cancelled) setRows(j.data ?? []); })
      .catch(() => { if (!cancelled) setRows([]); });
    return () => { cancelled = true; };
  }, []);

  const signOutAll = async () => {
    setSigningOut(true);
    try {
      await fetch("/api/auth/logout-all", { method: "POST", headers: getAuthHeaders() });
    } finally {
      router.push("/login");
    }
  };

  if (!rows) return <PageLoading />;

  return (
    <div className="space-y-3 p-4">
      <h1 className="text-lg font-semibold">Active sessions</h1>
      <ContextSituationBar
        roleLabel="Student"
        purpose="Audit active browser sessions, IP addresses, user agents, and terminate untrusted sessions"
        contextLabel="Active Device Sessions"
        severity={rows.length > 3 ? "warn" : "ok"}
        statusPill={`${rows.length} session${rows.length === 1 ? "" : "s"}`}
        statusSummary={
          rows.length > 0
            ? `You are signed in on ${rows.length} device${rows.length === 1 ? "" : "s"}. Sign out unfamiliar sessions.`
            : "No active device sessions detected."
        }
        why="Terminating unrecognized sessions revokes cached portal tokens on those devices and requires re-authentication."
        primaryAction={{ label: "Profile & Security", href: "/student/profile-security" }}
        secondaryAction={{ label: "Student Home", href: "/student" }}
      />
      <ul className="space-y-2">
        {rows.length === 0 ? (
          <li className="text-sm text-muted">No recorded sessions.</li>
        ) : (
          rows.map((r, i) => (
