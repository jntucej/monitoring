"use client";
import { useEffect, useState, useRef, useCallback } from "react";
import { QrCode, Loader2, AlertCircle, Download, RotateCw, ShieldAlert, Phone } from "lucide-react";
import { QRCode } from "react-qrcode-logo";
import { parseRollNumber } from "@/lib/rollNumber";
import { useApi } from "@/hooks/useApi";
import { useAuthStore } from "@/stores/authStore";
import type { Student } from "@/lib/types";

interface MessToken {
  id: string;
  token_code: string;
  manualCode?: string;
  expires_at: string;
  kind: string;
}

export function DigitalIdCard() {
const api = useApi();

  const [student, setStudent] = useState<Student | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [downloading, setDownloading] = useState(false);
  const qrRef = useRef<HTMLDivElement | null>(null);

  // P0: signed short-lived QR token (replaces the raw roll value above).
  // /api/students/qr-token returns { data: { qrToken } }; the scanner's
  // normalizeScannedPayload accepts the signed 3-segment form.
  const [qrToken, setQrToken] = useState<string | null>(null);
  const [reissuing, setReissuing] = useState(false);

  const reissueQR = useCallback(async () => {
    setReissuing(true);
    try {
      const res = await fetch("/api/students/qr-token", { cache: "no-store" });
      const json = await res.json();
      if (json?.data?.qrToken) setQrToken(json.data.qrToken);
    } catch {}
    finally { setReissuing(false); }
  }, []);

  useEffect(() => {
    let cancelled = false;
    const load = () => {
      fetch("/api/students/qr-token", { cache: "no-store" })
        .then((r) => (r.ok ? r.json() : null))
        .then((json) => {
          if (!cancelled && json?.data?.qrToken) setQrToken(json.data.qrToken);
        })
        .catch(() => {});
    };
    load();
    // 15-min token TTL; refresh at 14 min.
    const id = setInterval(load, 14 * 60_000);
    return () => {
      cancelled = true;
      clearInterval(id);
    };
  }, []);

  // Mess token for today's mess code
  const [messToken, setMessToken] = useState<MessToken | null>(null);
  const [_messError, setMessError] = useState<string | null>(null);

  useEffect(() => {
    let cancelled = false;
    const load = async () => {
      try {
        const auth = useAuthStore.getState();
        const roll = auth?.user?.uniqueId;
        if (!roll) {
          if (!cancelled) {
            setError("No student roll number found in session. Please log in again.");
            setLoading(false);
          }
          return;
        }
        const res = await fetch(`/api/students/${encodeURIComponent(roll)}`, { headers: api.getHeaders(), cache: "no-store" });
        const json = await res.json();
        if (!cancelled) {
          if (res.ok && json.success) {
            setStudent(json.data?.student ?? json.data ?? null);
          } else {
            setError(json.error?.message || "Failed to load student record.");
          }
          setLoading(false);
        }
      } catch {
        if (!cancelled) {
          setError("Network error loading student data.");
          setLoading(false);
        }
      }
    };
    load();
    return () => {
      cancelled = true;
    };
  }, []);

  // Fetch today's mess token
  useEffect(() => {
    let cancelled = false;
    const loadMess = async () => {
      try {
        const res = await fetch("/api/mess/my-token", {
          headers: api.getHeaders(),
          cache: "no-store",
        });
        const json = await res.json();
        if (!cancelled) {
          if (res.ok && json.success && json.data?.tokens?.length > 0) {
            const active = json.data.tokens.find((t: MessToken) => {
              const exp = new Date(t.expires_at).getTime();
              return exp > Date.now();
            });
            if (active) {
              setMessToken(active);
            }
          }
        }
      } catch {
        if (!cancelled) {
          setMessError(null);
        }
      }
    };
    loadMess();
    return () => { cancelled = true; };
  }, []);

  if (loading) {
    return (
      <div className="surface-card bg-bg-surface p-8 flex items-center gap-2 text-text-muted text-sm">
        <Loader2 className="w-4 h-4 animate-spin" /> Loading ID…
      </div>
    );
  }

  if (error || !student) {
    return (
      <div className="surface-card bg-bg-surface p-8 text-center space-y-2">
        <AlertCircle className="size-4 text-action-danger mx-auto opacity-60" />
        <p className="text-sm font-semibold text-text-primary">Unable to Load ID Card</p>
        <p className="text-xs text-text-muted">{error || "Student record not found."}</p>
      </div>
    );
  }

  const downloadQR = () => {
    if (!student) return;
    setDownloading(true);
    const container = qrRef.current;
    const canvas = container?.querySelector("canvas");
    if (canvas) {
      const url = canvas.toDataURL("image/png");
      const a = document.createElement("a");
      a.href = url;
      a.download = `gate-id-${student.roll || "student"}.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }
    setTimeout(() => setDownloading(false), 500);
  };

  const decoded = parseRollNumber(student.roll);
  const photoSrc = student.photo || "/avatar-placeholder.png";

  return (
    <div className="surface-card bg-bg-surface p-3 sm:p-4 md:p-6 lg:p-8 flex flex-col items-center">
      {/* Student Photo */}
      <div className="relative w-[112px] h-[112px] rounded-full mb-3 sm:mb-4 border-4 border-action-info overflow-hidden">
        <img src={photoSrc} alt={student.name} className="rounded-full w-full h-full object-cover" />
      </div>

      {/* Basic Info */}
      <h2 className="text-lg sm:text-xl md:text-2xl font-bold text-center">{student.name}</h2>
      <p className="text-sm sm:text-base md:text-lg font-mono">{student.roll}</p>

      {decoded && (
        <div className="surface-card mt-2 sm:mt-3 px-3 sm:px-4 py-1.5 sm:py-2 bg-bg-base/50 text-center">
          <p className="text-xs sm:text-sm font-medium text-text-primary">
            {decoded.departmentFullName}
          </p>
          <p className="text-xs sm:text-xs text-text-muted">
            {decoded.entryMode} • Batch {decoded.admissionYear}
          </p>
        </div>
      )}

      {/* Extended info: hostel, validity, emergency */}
      <div className="mt-3 sm:mt-4 w-full max-w-sm space-y-2">
        {student.hostelBlock && (
          <div className="rounded-lg bg-bg-elevated border border-border px-3 py-2 flex items-center gap-2">
            <ShieldAlert className="h-4 w-4 text-action-warning shrink-0" />
            <div>
              <p className="text-xs font-medium text-text-primary">Hostel — Block {student.hostelBlock}</p>
              {student.hostelCurfewTime && (
                <p className="text-[10px] text-text-muted">Curfew {student.hostelCurfewTime}</p>
              )}
            </div>
          </div>
        )}
        <div className="rounded-lg bg-bg-elevated border border-border px-3 py-2 flex items-center gap-2">
          <Phone className="h-4 w-4 text-action-info shrink-0" />
          <div>
            <p className="text-xs font-medium text-text-primary">Emergency Contact</p>
            <p className="text-[10px] text-text-muted">{student.phone ?? "—"}</p>
          </div>
        </div>
      </div>

      {/* Roll Number Breakdown */}
      <div className="mt-4 sm:mt-6 w-full max-w-sm">
        <div className="flex items-center justify-between mb-2">
          <span className="text-xs sm:text-xs font-medium text-text-muted uppercase">Roll Number Breakdown</span>
        </div>
        <div className="grid grid-cols-5 gap-px bgborder rounded-lg overflow-hidden">
          <div className="bg-bg-base p-1 sm:p-1.5 sm:p-2 text-center">
            <div className="text-xs sm:text-xs text-text-muted">Year</div>
            <div className="font-mono text-xs sm:text-xs sm:text-sm font-medium text-text-primary">{decoded?.yearCode ?? "—"}</div>
          </div>
          <div className="bg-bg-base p-1 sm:p-1.5 sm:p-2 text-center">
            <div className="text-xs sm:text-xs text-text-muted">College</div>
            <div className="font-mono text-xs sm:text-xs sm:text-sm font-medium text-text-primary">{decoded?.collegeCode ?? "—"}</div>
          </div>
          <div className="bg-bg-base p-1 sm:p-1.5 sm:p-2 text-center">
            <div className="text-xs sm:text-xs text-text-muted">Entry</div>
            <div className="font-mono text-xs sm:text-xs sm:text-sm font-medium text-text-primary">{decoded?.entryModeCode ?? "—"}</div>
          </div>
          <div className="bg-bg-base p-1 sm:p-1.5 sm:p-2 text-center">
            <div className="text-xs sm:text-xs text-text-muted">Dept</div>
            <div className="font-mono text-xs sm:text-xs sm:text-sm font-medium text-text-primary">{decoded?.departmentCode ?? "—"}</div>
          </div>
          <div className="bg-bg-base p-1 sm:p-1.5 sm:p-2 text-center">
            <div className="text-xs sm:text-xs text-text-muted">Serial</div>
            <div className="font-mono text-xs sm:text-xs sm:text-sm font-medium text-text-primary">{decoded?.serial ?? "—"}</div>
          </div>
        </div>
      </div>

      {/* Signed QR Code — short-lived token, not the raw roll */}
      <div ref={qrRef} className="surface-card mt-4 sm:mt-6 p-3 sm:p-4 bg-white flex flex-col items-center relative">
        {qrToken ? (
          <QRCode
            value={qrToken}
            size={140}
            style={{ width: "100%", maxWidth: 140, height: "auto" }}
          />
        ) : (
          <div className="h35 w35 flex items-center justify-center">
            <Loader2 className="w-4 h-4 animate-spin text-text-muted" />
          </div>
        )}
        <div className="surface-card mt-1.5 sm:mt-2 text-xs sm:text-xs font-bold text-text-muted font-mono flex items-center gap-1 sm:gap-1.5 bg-bg-elevated px-2 sm:px-2.5 py-0.5 sm:py-1">
          <span className="size-4 rounded-full bg-action-success" />
          Gate Verification QR
        </div>
        <button
          onClick={downloadQR}
          disabled={downloading || !qrToken}
          className="surface-card mt-2.5 flex items-center gap-1.5 px-3 py-1.5 bg-bg-surface text-white text-xs font-bold hover:bg-bg-elevated disabled:opacity-50 transition"
        >
          <Download className="w-3.5 h-3.5" />
          {downloading ? "Saving…" : "Save QR as PNG"}
        </button>
        <button
          onClick={() => void reissueQR()}
          disabled={reissuing}
          className="mt-1.5 flex items-center gap-1 text-[11px] text-text-muted hover:text-action-primary disabled:opacity-50"
        >
          <RotateCw className="w-4 h-4" />
          {reissuing ? "Re-issuing…" : "Re-issue QR"}
        </button>
      </div>
      <p className="mt-1.5 sm:mt-2 text-xs sm:text-sm text-text-muted flex items-center gap-1">
        <QrCode className="w-4 h-4 text-action-primary" />
        Signed token — refreshes automatically
      </p>

      {/* Today's Mess Code */}
      {messToken && (
        <div className="surface-card mt-4 sm:mt-6 w-full max-w-sm bg-emerald-500/10 p-4">
          <p className="text-xs font-semibold text-action-success uppercase tracking-wide mb-1">
            Today&apos;s Mess Code
          </p>
          <p className="text-xs text-emerald-700/80 mb-2">
            Show this code at the mess counter
          </p>
          <div className="font-mono text-3xl font-black tracking-[0.35em] text-action-success text-center py-2">
            {messToken.manualCode || messToken.token_code || "—"}
          </div>
          <p className="text-xs text-emerald-400/60 text-center mt-1">
            Expires {new Date(messToken.expires_at).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}
          </p>
        </div>
      )}
    </div>
  );
}
