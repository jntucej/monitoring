<file path="src/components/sysadmin/domains/identity/PeopleContent.tsx">
"use client";
// src/components/sysadmin/domains/identity/PeopleContent.tsx
// PEOPLE faceted-table dashboard content: facet FilterBar (role + state),
// faceted table (row click opens the drawer, no route change), a KPI strip
// with sparklines, and the signature cohort-retention HeatMatrix.
//
// "use client"; CSS vars only; cn from @/lib/utils; viz from kit/viz;
// minis from kit/sidebar.

import { useMemo, useState } from "react";
import { cn } from "@/lib/utils";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { HoverPreview, MetricPreview } from "@/components/shared/HoverPreview";
import { HeatMatrix } from "@/components/sysadmin/kit/viz";
import { MiniSparkline } from "@/components/sysadmin/kit/sidebar";
import type {PeopleData} from "@/components/sysadmin/domains/identity/types";

interface Props {
  data: PeopleData | null;
  loading?: boolean;
  error?: string | null;
  /** Called with the person id when a table row is clicked. */
  onRowClick: (id: string) => void;
}

/** Derive the discrete facet option lists from the roleState facet. */
function useFacets(data: PeopleData | null) {
  return useMemo(() => {
    const roles = data ? Object.keys(data.roleState).sort((a, b) => a.localeCompare(b)) : [];
    const states = new Set<string>();
    if (data) {
      for (const map of Object.values(data.roleState)) {
        for (const s of Object.keys(map)) states.add(s);
      }
    }
    return { roles, states: Array.from(states).sort((a, b) => a.localeCompare(b)) };
  }, [data]);
}

function Facet({
  label,
  options,
  selected,
  onToggle,
}: {
  label: string;
  options: string[];
  selected: string[];
  onToggle: (opt: string) => void;
}) {
  return (
    <div className="flex flex-wrap items-center gap-2">
      <span className="text-xs font-medium uppercase tracking-wide text-text-muted">
        {label}
      </span>
      {options.map((o) => {
        const on = selected.includes(o);
        return (
          <button
            key={o}
            type="button"
            aria-pressed={on}
            onClick={() => onToggle(o)}
            className={cn(
              "rounded-full border px-2.5 py-0.5 text-xs transition",
              on
                ? "border-action-primary bg-action-primary text-white"
                : "border-border bg-bg-base text-text-secondary hover:border-action-primary",
            )}
          >
            {o}
          </button>
        );
      })}
    </div>
  );
}

export function PeopleContent({ data, loading, error, onRowClick }: Props) {
  const { roles, states } = useFacets(data);
  const [roleFilter, setRoleFilter] = useState<string[]>([]);
  const [stateFilter, setStateFilter] = useState<string[]>([]);

  const toggle =
    (set: React.Dispatch<React.SetStateAction<string[]>>) => (opt: string) =>
      set((prev) =>
        prev.includes(opt) ? prev.filter((v) => v !== opt) : [...prev, opt],
      );

  const filteredRows = useMemo(() => {
    if (!data) return [];
    return data.rows.filter((r) => {
      const roleOk = roleFilter.length === 0 || roleFilter.includes(r.role);
      const stateOk = stateFilter.length === 0 || stateFilter.includes(r.state);
      return roleOk && stateOk;
    });
  }, [data, roleFilter, stateFilter]);

  const cohortGrid = data?.cohortGrid ?? null;

  if (loading && !data) {
    return (
      <WidgetBoundary>
        <div className="space-y-4 p-4">
          <div className="h-4 w-40 animate-pulse rounded bg-bg-base" />
          <div className="h-40 w-full animate-pulse rounded bg-bg-base" />
        </div>
      </WidgetBoundary>
    );
  }

  if (error && !data) {
    return (
      <WidgetBoundary>
        <div className="surface-card bg-action-danger/10 p-4 text-sm text-action-danger">
          Failed to load people: {error}
        </div>
      </WidgetBoundary>
    );
  }

  const d = data!;
  const activePct = d.activePct != null ? Math.round(d.activePct * 100) : 0;
  const kpiSpark = (seed: number): number[] =>
    Array.from({ length: 8 }, (_, i) => Math.max(0, seed + i * 0.3 + (i % 3) * 0.2));

  const hasCohort =
    cohortGrid != null && cohortGrid.years.length > 0 && cohortGrid.data.length > 0;

  return (
    <WidgetBoundary>
      <div className="space-y-6 p-4 sm:p-6">
        <div>
          <h1 className="text-2xl font-bold tracking-tight text-text-primary">
            People &amp; Identity
          </h1>
          <p className="mt-1 text-sm text-text-secondary">
            Faceted directory of every account with role, state, and
            cohort retention. Click a row to open the detail drawer.
          </p>
        </div>

        {/* KPI strip */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          <Kpi label="Total" value={String(d.total)} spark={kpiSpark(d.total)} tone="neutral" />
          <Kpi label="Active %" value={`${activePct}%`} spark={kpiSpark(activePct * 2)} tone="ok" />
          <Kpi
            label="New this week"
            value={String(d.newThisWeek)}
            spark={kpiSpark(Math.max(1, d.newThisWeek))}
            tone="info"
          />
          <Kpi
            label="Suspended"
            value={String(d.suspended)}
            spark={kpiSpark(Math.max(1, d.suspended))}
            tone="error"
          />
        </div>

        {/* Facet FilterBar */}
        <div className="surface-card flex flex-col gap-3 bg-bg-base p-4">
          <div className="flex items-center gap-2 text-sm font-semibold text-text-primary">
            <span>Filters</span>
            {(roleFilter.length > 0 || stateFilter.length > 0) && (
              <button
                type="button"
                onClick={() => {
                  setRoleFilter([]);
                  setStateFilter([]);
                }}
                className="ml-auto text-xs text-text-muted hover:text-text-primary"
              >
                Clear all
              </button>
            )}
          </div>
          <Facet label="Role" options={roles} selected={roleFilter} onToggle={toggle(setRoleFilter)} />
          <Facet label="State" options={states} selected={stateFilter} onToggle={toggle(setStateFilter)} />
        </div>

        {/* Signature visual: cohort retention HeatMatrix */}
        {hasCohort && cohortGrid ? (
          <div className="surface-card bg-bg-base p-4">
            <h2 className="mb-3 text-sm font-semibold text-text-primary">
              Cohort retention — admission year × semester
            </h2>
            <HeatMatrix
              rows={cohortGrid.years}
              cols={cohortGrid.semesters}
              data={cohortGrid.data}
              label="Cohort retention, % active per cohort cell"
              cellSize={22}
            />
            <p className="mt-2 text-xs text-text-muted">
              Cell intensity = % of users in that admission-year cohort still ACTIVE.
            </p>
          </div>
        ) : null}

        {/* Faceted table */}
        <div className="overflow-x-auto rounded-xl border border-border bg-bg-base">
          <table className="w-full min-w180 border-collapse text-sm">
            <thead>
              <tr className="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
                <th className="px-3 py-2 font-medium">Name</th>
                <th className="px-3 py-2 font-medium">Email</th>
                <th className="px-3 py-2 font-medium">Role</th>
                <th className="px-3 py-2 font-medium">State</th>
                <th className="px-3 py-2 font-medium">Cohort active</th>
                <th className="px-3 py-2 font-medium">Created</th>
              </tr>
            </thead>
            <tbody>
              {filteredRows.length === 0 ? (
                <tr>
                  <td colSpan={6} className="px-3 py-6 text-center text-text-muted">
                    No people match the current filters.
                  </td>
                </tr>
              ) : (
                filteredRows.map((r) => (
                  <tr
                    key={r.id}
                    onClick={() => onRowClick(r.id)}
                    className="cursor-pointer border-b border-border transition last:border-0 hover:bg-[var(--surface-raised)]"
                  >
                    <td className="px-3 py-2 font-medium text-text-primary">{r.name}</td>
                    <td className="px-3 py-2 text-text-secondary">{r.email}</td>
                    <td className="px-3 py-2">
                      <span className="surface-card px-2 py-0.5 text-xs">
                        {r.role}
                      </span>
                    </td>
                    <td className="px-3 py-2">
                      <StatusPill status={r.state} />
                    </td>
                    <td className="px-3 py-2 text-text-secondary">
                      {r.cohort_active_pct > 0 ? `${r.cohort_active_pct}%` : "—"}
                    </td>
                    <td className="px-3 py-2 text-text-muted">
                      {r.created_at ? new Date(r.created_at).toLocaleDateString() : "—"}
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
    </WidgetBoundary>
  );
}

function Kpi({
  label,
  value,
  spark,
  tone,
  hint,
}: {
  label: string;
  value: string;
  spark: number[];
  tone: "neutral" | "ok" | "info" | "error";
  hint?: string;
}) {
  const color =
    tone === "ok"
      ? "var(--action-ok)"
      : tone === "info"
        ? "var(--action-info)"
        : tone === "error"
          ? "var(--action-danger)"
          : "var(--action-primary)";

  const card = (
    <div className="surface-card flex items-center justify-between bg-bg-base p-4">
      <div>
        <div className="text-xs uppercase tracking-wide text-text-muted">{label}</div>
        <div className="mt-1 text-2xl font-bold text-text-primary">{value}</div>
        {hint ? <div className="text-xs text-text-muted -mt-0.5">{hint}</div> : null}
      </div>
      <MiniSparkline label={label} values={spark} color={color} />
    </div>
  );

  // Every KPI tile is a hover-preview entry point (the quick layer of the
  // inspection hierarchy); the value itself is the preview's payload.
  return (
    <HoverPreview preview={<MetricPreview label={label} value={value} hint={hint} />}>
      {card}
    </HoverPreview>
  );
}

function StatusPill({ status }: { status: string }) {
  const map: Record<string, string> = {
    ACTIVE: "var(--action-ok)",
    SUSPENDED: "var(--action-danger)",
    LOCKED: "var(--action-warning)",
    DISABLED: "var(--text-muted)",
    DEPROVISIONED: "var(--text-muted)",
  };
  const c = map[status] ?? "var(--text-muted)";
  return (
    <span
      className="surface-card px-2 py-0.5 text-xs font-medium"
      style={{ color: c, backgroundColor: `color-mix(in srgb, ${c} 12%, transparent)` }}
    >
      {status}
    </span>
  );
}
</file>

<file path="src/components/sysadmin/domains/identity/PeopleDrawer.tsx">
"use client";
// src/components/sysadmin/domains/identity/PeopleDrawer.tsx
// PEOPLE deepest layer: fetches the single-person payload from
// /api/admin/people/<id> and renders it through the shared EntityInspector
// (kind `person`). The progressive-disclosure hierarchy is the same as
// every other record in the app: overview → roles → sessions → audit →
// links (server-authorized mutation routes).
// Loading / error / not-found states are exposed through the
// inspector's built-in state placeholders (design rule 31).

import { useEffect, useState } from "react";
import { ChevronRight } from "lucide-react";
import { EntityInspector, KVPairs, InspectorButton, Timeline, type EntityInspection } from "@/components/shared/EntityInspector";
import type {
  PersonDetail,
  PersonRow,
} from "@/components/sysadmin/domains/identity/types";

interface Props {
  /** The row that was clicked; drives which person to fetch. Null = closed. */
  row?: PersonRow | null;
  /** Sibling-surface convenience: open by id only (a minimal PersonRow is built). */
  personId?: string | null;
  onClose: () => void;
}

type LoadState = "idle" | "loading" | "ready" | "error";

function stateTone(state: string): "ok" | "warn" | "danger" | "neutral" {
  const s = state.toUpperCase();
  if (s === "ACTIVE") return "ok";
  if (s === "SUSPENDED" || s === "LOCKED") return "danger";
  if (s === "DISABLED" || s === "DEPROVISIONED") return "neutral";
  return "warn";
}

function stateClass(tone: "ok" | "warn" | "danger" | "neutral"): string {
  switch (tone) {
    case "ok":
      return "bg-emerald-500/15 text-action-success";
    case "warn":
      return "bg-amber-500/15 text-action-warning";
    case "danger":
      return "bg-rose-500/15 text-action-danger";
    default:
      return "bg-bg-elevated text-text-muted";
  }
}

/** Build the standardized `EntityInspection` model for a person record. */
function personInspectionModel(
  row: PersonRow,
  detail: PersonDetail | null,
): EntityInspection {
  const name = detail?.name ?? row.name;
  const email = detail?.email ?? row.email;
  const role = detail?.role ?? row.role;
  const state = detail?.state ?? row.state;
  const tone = stateTone(state);

  const sections: EntityInspection["sections"] = [
    {
      title: "Overview",
      content: (
        <KVPairs
          items={[
            { label: "Email", value: email },
            { label: "Role", value: role },
            { label: "State", value: state },
            {
              label: "MFA",
              value: (detail?.two_factor_enabled ?? row.two_factor_enabled)
                ? "Enabled"
                : "Disabled",
            },
            {
              label: "Created",
              value: new Date(detail?.created_at ?? row.created_at).toLocaleDateString("en-IN"),
            },
          ]}
        />
      ),
    },
    ...(detail
      ? [
          {
            title: `Roles (${detail.roles.length})`,
            collapsible: true,
            content:
              detail.roles.length === 0 ? (
                <p className="text-xs text-text-muted">No roles recorded.</p>
              ) : (
                <Timeline
                  items={detail.roles.map((r) => ({
                    label: r.role,
                    time: new Date(r.granted_at).toLocaleDateString("en-IN"),
                    detail: "granted",
                    tone: "neutral" as const,
                  }))}
                />
              ),
          },
          {
            title: `Sessions (${detail.sessionsCount})`,
            collapsible: true,
            content:
              detail.sessions.length === 0 ? (
                <p className="text-xs text-text-muted">No sessions.</p>
              ) : (
                <Timeline
                  items={detail.sessions.map((s) => ({
                    label: s.revoked_at ? "Session revoked" : "Active session",
                    time: s.last_seen_at
                      ? new Date(s.last_seen_at).toLocaleString("en-IN")
                      : undefined,
                    detail: [s.ip_address, s.user_agent].filter(Boolean).join(" · "),
                    tone: s.revoked_at ? ("neutral" as const) : ("ok" as const),
                  }))}
                />
              ),
          },
          {
            title: "Recent audit",
            collapsible: true,
            content:
              detail.audit.length === 0 ? (
                <p className="text-xs text-text-muted">No audit entries.</p>
              ) : (
                <Timeline
                  items={detail.audit.map((a) => ({
                    label: a.action,
                    time: new Date(a.timestamp).toLocaleString("en-IN"),
                    detail: a.ip_address ?? undefined,
                    tone: "neutral" as const,
                  }))}
                />
              ),
          },
        ]
      : []),
    {
      title: "Actions",
      content: (
        <div className="flex flex-wrap gap-2">
          {detail ? (
            <>
              <InspectorButton href={detail.links.users} variant="ghost">
                <ChevronRight className="size-3.5" /> User record
              </InspectorButton>
              <InspectorButton href={detail.links.userRoles} variant="ghost">
                <ChevronRight className="size-3.5" /> Roles
              </InspectorButton>
              <InspectorButton href={detail.links.roleRequests} variant="ghost">
                <ChevronRight className="size-3.5" /> Role requests
              </InspectorButton>
              <InspectorButton href={detail.links.auditLogs} variant="ghost">
                <ChevronRight className="size-3.5" /> Audit logs
              </InspectorButton>
            </>
          ) : (
            <p className="text-xs text-text-muted">
              Open a role mutation (grant / revoke / suspend) from the sysadmin
              role console — the server authorizes these routes.
            </p>
          )}
        </div>
      ),
    },
  ];

  return {
    kind: "person",
    title: name,
    subtitle: email,
    status: (
      <span className={`text-[10px] font-bold uppercase px-1.5 py-0.5 rounded ${stateClass(tone)}`}>
        {state.toUpperCase()}
      </span>
    ),
    sections,
    detailHref: "/sysadmin/people",
    detailLabel: "People directory",
  };
}

export function PeopleDrawer({ row, personId, onClose }: Props) {
  // Normalize to a single "active" row: prefer `row`; else build one from
  // `personId` (sibling pages that pass only the id).
  const activeRow = row ?? (personId ? { id: personId } as PersonRow : null);
  const [detail, setDetail] = useState<PersonDetail | null>(null);
  const [state, setState] = useState<LoadState>("idle");
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (!activeRow) {
      setDetail(null);
      setState("idle");
      return;
    }
    let cancelled = false;
    setState("loading");
    setError(null);
    fetch(`/api/admin/people/${encodeURIComponent(activeRow.id)}`, {
      credentials: "include",
    })
      .then(async (res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = await res.json();
        if (cancelled) return;
        setDetail(json.data as PersonDetail);
        setState("ready");
      })
      .catch((e: unknown) => {
        if (cancelled) return;
        setError(e instanceof Error ? e.message : "Failed to load");
        setState("error");
      });
    return () => {
      cancelled = true;
    };
  }, [activeRow?.id, activeRow]);

  if (!activeRow) return null;

  // While the person detail is still in flight or failed, surface the state
  // through the inspector's built-in placeholder so the panel never renders
  // blank (design rule 31).
  if (error) {
    return (
      <EntityInspector
        inspection={null}
        onClose={onClose}
        state="error"
        errorMessage={error}
      />
    );
  }
  if (state === "loading" || state === "idle" || !detail) {
    return (
      <EntityInspector inspection={null} onClose={onClose} state="loading" />
    );
  }

  const model = personInspectionModel(activeRow, detail);
  return <EntityInspector inspection={model} onClose={onClose} />;
}
