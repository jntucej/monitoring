"use client";

import { useCallback, useEffect, useState } from "react";

interface LivePayload {
  session: { id: string; meal_date: string; meal_type: string; window_opens_at: string; window_closes_at: string };
  total_expected: number;
  total_served: number;
  counters: Array<{ id: string; name: string; served: number; capacity: number | null }>;
  specials: Array<{ id: string; item_name: string; counter_name: string; served_count: number; expected_count: number; status: string }>;
  anomalies: Array<{ id: string; roll_no: string; student_name: string; outcome: string; reason_text: string | null; scanned_at: string }>;
}

export default function MessLivePage() {
  const [data, setData] = useState<LivePayload | null>(null);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(() => {
    fetch("/api/mess/live")
      .then((r) => r.json())
      .then((j) => {
        if (j?.data) setData(j.data);
        else setError(j?.error?.message ?? "No active session");
      })
      .catch(() => setError("Failed to load live control room"));
  }, []);

  useEffect(() => {
    load();
    const id = setInterval(load, 5000);
    return () => clearInterval(id);
  }, [load]);

  if (error) return <div className="p-6 text-sm text-destructive">{error}</div>;
  if (!data) return <div className="p-6 text-sm text-foreground">Loading live control room...</div>;

  const pct = data.total_expected > 0 ? Math.round((data.total_served / data.total_expected) * 100) : 0;

  return (
    <div className="mx-auto max-w-5xl space-y-6 p-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-xl font-bold uppercase text-foreground">
            {data.session.meal_type} • {data.session.meal_date}
          </h1>
          <p className="text-sm text-foreground">
            Expected: {data.total_expected} • Served: {data.total_served} ({pct}%) • Remaining:{" "}
            {Math.max(0, data.total_expected - data.total_served)}
          </p>
        </div>
        <button
          type="button"
          onClick={load}
          className="rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-medium text-foreground"
        >
          Refresh
        </button>
      </div>

      <div className="grid gap-4 sm:grid-cols-3">
        {data.counters.map((c) => (
          <div key={c.id} className="rounded-xl border border-border bg-card p-4">
            <div className="text-sm font-semibold text-foreground">{c.name}</div>
            <div className="mt-1 text-2xl font-bold tabular-nums text-foreground">
              {c.served}
              {c.capacity ? <span className="text-sm font-normal text-muted-foreground"> / {c.capacity}</span> : null}
            </div>
          </div>
        ))}
      </div>

      {data.specials.length > 0 && (
        <div className="rounded-xl border border-border bg-card p-4">
          <h2 className="text-sm font-semibold text-foreground">Special Items</h2>
          <div className="mt-2 space-y-2">
            {data.specials.map((s) => (
              <div key={s.id} className="flex items-center justify-between text-sm text-foreground">
                <span>
                  {s.item_name} ({s.counter_name})
                </span>
                <span className="font-mono">
                  {s.served_count}/{s.expected_count} • {s.status}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      <div className="rounded-xl border border-border bg-card p-4">
        <h2 className="text-sm font-semibold text-foreground">Live Anomalies</h2>
        {data.anomalies.length === 0 ? (
          <p className="mt-2 text-xs text-muted-foreground">No anomalies in this session.</p>
        ) : (
          <ul className="mt-2 space-y-1 text-xs text-foreground">
            {data.anomalies.map((a) => (
              <li key={a.id} className="flex justify-between">
                <span>
                  {a.roll_no} ({a.student_name}) — {a.outcome}
                </span>
                <span className="text-muted-foreground">{new Date(a.scanned_at).toLocaleTimeString()}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/app/(mess)/mess/meal-attendance/page.tsx">
"use client";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { MessEligibilityCard } from "@/components/mess/MessEligibilityCard";
import Link from "next/link";
import {Users, AlertTriangle, Loader2, Inbox, Building2}  from "lucide-react";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { hostelBlockInspection, type HostelBlockOccupancy } from "@/components/approver/wardenConsoleModels";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface AttendanceBlockRow {
  hostelBlock: string;
  declared: number;
  confirmed: number;
  veg: number;
  nonVeg: number;
  attendanceRate: number;
}

interface AttendanceResponse {
  success: boolean;
  data: {
    messDayId: string | null;
    mealDate: string | null;
    byHostelBlock: AttendanceBlockRow[];
    totals: {
      declared: number;
      confirmed: number;
      veg: number;
      nonVeg: number;
      attendanceRate: number;
    };
  };
}

function WidgetError({ message, onRetry }: { message: string; onRetry: () => void }) {
  return (
    <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
      <span className="flex items-center gap-2 min-w-0">
        <AlertTriangle className="w-4 h-4 shrink-0" />
        <span className="truncate">{message}</span>
      </span>
      <button
        type="button"
        onClick={onRetry}
        className="surface-card min-h-11 inline-flex items-center justify-center px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
      >
        Retry
      </button>
    </div>
  );
}

function rateColor(rate: number): string {
  if (rate >= 80) return "text-action-success";
  if (rate >= 50) return "text-action-warning";
  return "text-action-danger";
}

function fmtDate(d: string | null | undefined): string {
  if (!d) return "No meal day scheduled";
  try {
    return new Date(`${d}T00:00:00`).toLocaleDateString("en-IN", {
      weekday: "long",
      day: "numeric",
      month: "short",
      year: "numeric",
    });
  } catch {
    return d;
  }
}

function MessMealAttendanceInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "mess_incharge") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const inspectBlock = (b: AttendanceBlockRow) => {
    inspect(
      hostelBlockInspection({
        block: b.hostelBlock,
        total: b.declared,
        occupied: b.confirmed,
      } satisfies HostelBlockOccupancy),
    );
  };

  const {
    data: attendance,
    loading,
    error,
    refresh,
  } = useApiResource<AttendanceResponse>("/api/mess/attendance", { ttlMs: 30_000 });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !attendance;
  const d = attendance?.data;
  const blocks = d?.byHostelBlock ?? [];

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-5 py-6 min-w-0">
      <Link
        href="/mess"
        className="inline-flex min-h-11 items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        Back to Mess Overview
      </Link>

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Mess In-Charge"
        purpose="Monitor live hostel block meal turnout, verify dietary breakdowns, and reconcile scan completions"
        contextLabel={`Meal Attendance · ${d ? fmtDate(d.mealDate) : "Attendance"}`}
        statusSummary={
          d && d.totals
            ? `${d.totals.confirmed} meals confirmed served out of ${d.totals.declared} declared present (${d.totals.attendanceRate}% turnout).`
            : "Reconcile expected dining headcounts against confirmed scans across hostel blocks."
        }
        why="Block-by-block turnout tracking ensures hostel dining allocations match real student headcounts and verifies billing rosters."
        severity="info"
        primaryAction={{ label: "Token Scanner", href: "/mess/scan" }}
        secondaryActions={[
          { label: "Daily Meal Counts", href: "/mess/daily-meal-counts" },
          { label: "Consumption Reports", href: "/mess/consumption-reports" },
          { label: "Mess Overview", href: "/mess" },
        ]}
      />

      {error && !/404|no mess day/i.test(error) && (
        <WidgetError message={`Meal attendance unavailable: ${error}`} onRetry={() => void refreshAll()} />
      )}

      {/* Mess eligibility reconciliation (PR4): expected/issued/served/no-show
          + excluded-by-reason. Gated by mess.eligibility.view. */}
      <MessEligibilityCard />

      <WidgetBoundary title="Meal Attendance">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <Users className="w-4 h-4 text-action-success shrink-0" />
              <span className="text-sm font-semibold text-white truncate">Meal Attendance</span>
            </div>
            <span className="text-xs text-text-muted shrink-0">{d ? fmtDate(d.mealDate) : "—"}</span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" />
              Loading meal attendance…
            </div>
          ) : blocks.length > 0 ? (
            <div className="min-w-0">
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 p-4 min-w-0">
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Declared Present</p>
                  <p className="mt-1 text-lg font-bold text-action-info">{d?.totals?.declared}</p>
                </div>
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Confirmed Served</p>
                  <p className="mt-1 text-lg font-bold text-action-success">{d?.totals?.confirmed}</p>
                </div>
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Veg / Non-Veg</p>
                  <p className="mt-1 text-lg font-bold text-white">
                    {d?.totals?.veg} / {d?.totals?.nonVeg}
                  </p>
                </div>
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Attendance Rate</p>
                  <p className={`mt-1 text-lg font-bold ${rateColor(d?.totals?.attendanceRate ?? 0)}`}>
                    {d?.totals?.attendanceRate}%
                  </p>
                </div>
              </div>

              <div className="overflow-x-auto min-w-0">
                <table className="w-full text-sm min-w140">
                  <thead>
                    <tr className="border-b border-border text-text-muted text-xs uppercase tracking-wide">
                      <th className="text-left px-4 py-2.5">Hostel Block</th>
                      <th className="text-left px-4 py-2.5">Declared</th>
                      <th className="text-left px-4 py-2.5">Confirmed</th>
                      <th className="text-left px-4 py-2.5">Veg / Non-Veg</th>
                      <th className="text-left px-4 py-2.5">Rate</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60">
                    {blocks.map((b) => (
                      <tr key={b.hostelBlock} className="hover:bg-bg-elevated/30 transition-colors cursor-pointer" onClick={() => inspectBlock(b)}>
                        <td className="px-4 py-3 text-text-secondary font-medium whitespace-nowrap flex items-center gap-2 min-w-0">
                          <Building2 className="w-3.5 h-3.5 text-text-muted shrink-0" />
                          <span className="truncate">{b.hostelBlock}</span>
                        </td>
                        <td className="px-4 py-3 text-text-muted">{b.declared}</td>
                        <td className="px-4 py-3 text-action-success font-medium">{b.confirmed}</td>
                        <td className="px-4 py-3 text-text-muted whitespace-nowrap">
                          {b.veg} / {b.nonVeg}
                        </td>
                        <td className={`px-4 py-3 font-semibold whitespace-nowrap ${rateColor(b.attendanceRate)}`}>
                          {b.attendanceRate}%
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div className="surface-card px-4 py-3 text-xs text-text-muted min-w-0">
                Attendance is computed from mess preferences (declared present) vs confirmed
                servings recorded at the{" "}
                <Link href="/mess/scan" className="text-action-success hover:underline">
                  Token Scanner
                </Link>
                .
              </div>
            </div>
          ) : (
            <div className="p-8 text-center">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted max-w-md mx-auto">
                No attendance data for this meal day. Records appear once students declare
                attendance and meals are confirmed.
              </p>
            </div>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}

export default function MessMealAttendancePage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <MessMealAttendanceInner />
    </Suspense>
  );
}
</file>

