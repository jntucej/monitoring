                          {a.severity}
                        </span>
                      </td>
                      <td className="py-2 pr-4 text-text-muted">{a.status}</td>
                      <td className="py-2 text-text-muted">
                        {a.created_at ? new Date(a.created_at).toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" }) : "—"}
                      </td>
