"use client";

import { useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { useHodRetention } from "@/stores/hodRetentionStore";

/**
 * Fires a small celebration when the queue hits zero AFTER at least one
 * decision this session. Not on the initial empty state — only after a
 * transition from >0 to 0.
 */
export function CelebrateOverlay({ queueEmpty }: { queueEmpty: boolean }) {
  const celebrating = useHodRetention((s) => s.celebrating);
  const sessionDecisions = useHodRetention((s) => s.sessionDecisions);
  const markCelebrated = useHodRetention((s) => s.markCelebrated);

  // Trigger celebration when the queue transitions to empty with decisions
  useEffect(() => {
    if (queueEmpty && sessionDecisions > 0) {
      useHodRetention.setState({ celebrating: true });
      const t = setTimeout(markCelebrated, 1800);
      return () => clearTimeout(t);
    }
  }, [queueEmpty, sessionDecisions, markCelebrated]);

  return (
    <AnimatePresence>
      {celebrating && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          className="pointer-events-none fixed inset-0 z-40 flex items-center justify-center"
        >
          <motion.div
            initial={{ scale: 0.5, opacity: 0 }}
            animate={{ scale: 1, opacity: 1 }}
            exit={{ scale: 0.9, opacity: 0 }}
            transition={{ type: "spring", stiffness: 260, damping: 20 }}
            className="surface-card bg-bg-surface px-8 py-6 text-center"
          >
            <p className="text-2xl font-bold text-action-primary">Queue cleared</p>
            <p className="mt-1 text-sm text-text-muted border-0">
              {sessionDecisions} decision{sessionDecisions === 1 ? "" : "s"} this session
            </p>
          </motion.div>

          {/* Confetti dots */}
          {Array.from({ length: 20 }).map((_, i) => (
            <motion.span
              key={i}
              initial={{
                x: 0,
                y: 0,
                opacity: 1,
                scale: 1,
              }}
              animate={{
                x: (Math.random() - 0.5) * 400,
                y: (Math.random() - 0.5) * 300,
                opacity: 0,
                scale: 0.3,
              }}
              transition={{ duration: 1.4, delay: i * 0.02 }}
              className="absolute size-2 rounded-full"
              style={{
                backgroundColor:
                  i % 3 === 0
                    ? "var(--action-primary)"
                    : i % 3 === 1
                    ? "var(--action-warning)"
                    : "var(--action-info)",
              }}
            />
          ))}
        </motion.div>
      )}
    </AnimatePresence>
  );
}
</file>

<file path="src/app/(approver)/hod/_retention/DepartmentPulse.tsx">
"use client";

import { TrendingUp, TrendingDown, Minus } from "lucide-react";

export function DepartmentPulse({
  myRate,
  collegeAvg,
  myRank,
  totalDepts,
}: {
  myRate: number;
  collegeAvg: number;
  myRank: number;
  totalDepts: number;
}) {
  if (totalDepts === 0) return null;

  const delta = myRate - collegeAvg;
  const rankLabel =
    myRank === 1
      ? "Top department today"
      : myRank <= 3
      ? "Top 3 today"
      : `${ordinal(myRank)} of ${totalDepts}`;
  const TrendIcon = delta > 1 ? TrendingUp : delta < -1 ? TrendingDown : Minus;
  const trendClass =
    delta > 1
      ? "text-action-primary"
      : delta < -1
      ? "text-action-warning"
      : "text-text-muted";

  return (
    <section className="surface-card bg-bg-surface p-4 sm:p-5">
      <header className="mb-3 flex items-center justify-between">
        <h2 className="text-sm font-semibold text-text-primary">
          Department pulse
        </h2>
        <span className="text-xs uppercase tracking-wider text-text-muted">
          today
        </span>
      </header>

      <div className="flex items-baseline gap-2">
        <p className="text-3xl font-semibold tabular-nums text-text-primary">
          {myRate}%
        </p>
        <span className="flex items-center gap-0.5 text-xs">
          <TrendIcon className={`size-3.5 ${trendClass}`} />
          <span className={trendClass}>
            {delta === 0
              ? "on par"
              : `${delta > 0 ? "+" : ""}${delta.toFixed(1)}% vs college`}
          </span>
        </span>
      </div>

      <p className="mt-1 text-xs text-text-secondary">
        {rankLabel} · college average {collegeAvg}%
      </p>

      {myRank <= 3 && (
        <p className="surface-card mt-3 bg-action-primary/10 px-2.5 py-1.5 text-xs text-action-primary">
          {myRank === 1
            ? "Your department has the best attendance in the college today. Keep it up."
            : `You're in the top ${myRank} departments. Students feel it.`}
        </p>
      )}
    </section>
  );
}

function ordinal(n: number): string {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
}
</file>

