      state: "ACTIVE" | "COMPLETED" | "NONE";
      checkedInAt: string | null;
      purpose: string | null;
    };
    visitDetails: {
      purpose: string | null;
      hostName: string | null;
      checkedInAt: string | null;
      checkedOutAt: string | null;
      status: string | null;
    };
    hostInfo: { name: string | null; uniqueId: string | null; role: string | null };
  };
}

export default function VisitorVisitPage() {
  const { data, loading, refresh } = useApiResource<VisitorsMineResponse>("/api/visitors/mine", {
    ttlMs: 30_000,
  });
  const [acting, setActing] = useState(false);
  const [msg, setMsg] = useState<string | null>(null);
  const [inspection, setInspection] = useState<EntityInspection | null>(null);

  if (loading) return <PageLoading />;
  const d = data?.data;
  const state = d?.approvalStatus.state;

  if (!d || state === "NONE") {
    return (
      <WidgetBoundary name="visitor-visit">
        <div className="mx-auto max-w-md p-4 space-y-4">
          <ContextSituationBar
            roleLabel="Campus Visitor"
            purpose="Campus visit clearance and security gate check-in/out."
            contextLabel="Visit Status"
            statusTone="info"
            statusPill="No Visit Today"
            statusSummary="No scheduled visit record found for today. Submit a visit request to get security gate clearance."
            primaryAction={{ label: "Request Visit", href: "/visitor/request" }}
            secondaryAction={{ label: "Visitor Portal", href: "/visitor" }}
          />
          <EmptyState
            title="No active visit"
            description="You don't have an active visit today. Request one from your host or return to the visitor portal."
            action={
              <Link
                href="/visitor/request"
                className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-action-primary text-white hover:opacity-90 transition-opacity"
              >
                Request Visit
              </Link>
            }
          />
        </div>
      </WidgetBoundary>
    );
  }

  const isActive = state === "ACTIVE" && !!d.active;
  const action = {
    label: isActive ? "Check out" : "Check in",
    endpoint: isActive ? "/api/visitors/me/check-out" : "/api/visitors/me/check-in",
  };

  const act = async () => {
    setActing(true);
    setMsg(null);
    try {
      const res = await fetch(action.endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        body: JSON.stringify({}),
      });
      if (res.ok) {
        refresh();
        setMsg(isActive ? "Checked out. Safe travels." : "Checked in. Enjoy your visit.");
      } else {
        const j = (await res.json().catch(() => ({}))) as { error?: { message?: string } };
        setMsg(j.error?.message ?? "Action failed. Please try again.");
      }
    } catch {
      setMsg("Network error. Please try again.");
    } finally {
      setActing(false);
    }
  };

  return (
    <WidgetBoundary name="visitor-visit">
      <div className="mx-auto max-w-md space-y-4 p-4">
        <ContextSituationBar
          roleLabel="Campus Visitor"
          purpose="Perform gate check-in upon arrival and gate check-out upon departure."
          contextLabel="Active Visit Pass"
          statusTone={isActive ? "ok" : "info"}
          statusPill={isActive ? "Checked In" : "Ready for Check-In"}
          statusSummary={
            isActive
              ? `Currently on campus with ${d.hostInfo.name ?? "host"}. Use check out when leaving.`
              : `Visit approved with ${d.hostInfo.name ?? "host"}. Ready to check in at security.`
          }
          primaryAction={{
            label: action.label,
            onClick: act,
            loading: acting,
          }}
          secondaryAction={{ label: "Visitor Portal", href: "/visitor" }}
        />
        <h1 className="text-lg font-semibold">Your visit</h1>
        <div className="surface-card space-y-2 bg-bg-surface p-4">
          <div className="flex items-center justify-between">
            <p className="text-sm text-text-secondary">
              Host: <strong>{d.hostInfo.name ?? "—"}</strong>
            </p>
            <HelpTip text="The designated sponsor hosting your campus visit." />
          </div>
          <p className="text-sm text-text-secondary">
            Purpose: {d.visitDetails.purpose ?? "—"}
          </p>
          <div className="flex items-center justify-between">
            <p className="text-sm text-text-secondary">
              Status: {state === "ACTIVE" ? "Checked in" : "Completed"}
              {d.approvalStatus.checkedInAt && (
                <span className="ml-2 inline-flex items-center gap-1 text-xs text-text-muted">
                  <Clock className="size-3.5" />
                  {new Date(d.approvalStatus.checkedInAt).toLocaleString()}
                </span>
              )}
            </p>
            <HelpTip text="Checked In indicates you are physically recorded inside the gate perimeter." />
          </div>
        </div>
        <button
          onClick={act}
          disabled={acting}
          className="surface-card flex w-full items-center justify-center gap-2 bg-action-primary px-4 py-3 text-sm font-semibold text-white disabled:opacity-60"
        >
          {acting ? <Loader2 className="h-4 w-4 animate-spin" /> : <MapPin className="h-4 w-4" />}
          {action.label}
        </button>
        {d.active ? (
          <button
            type="button"
            onClick={() => setInspection(visitorVisitInspection(d.active!.log as unknown as VisitorLogRow))}
            className="flex w-full items-center justify-center gap-1.5 text-xs font-semibold text-action-primary hover:underline focus-visible:ring-2 focus-visible:ring-action-primary focus-visible:outline-none rounded"
          >
            <Search className="size-3.5" />
            Inspect visit details
          </button>
        ) : null}
        {msg && <p className="text-center text-xs text-text-muted">{msg}</p>}
      </div>
      {inspection ? (
        <EntityInspector inspection={inspection} onClose={() => setInspection(null)} />
      ) : null}
    </WidgetBoundary>
  );
}
</file>

