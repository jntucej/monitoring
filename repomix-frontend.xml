            ? "bg-amber-500/15 text-action-warning"
            : /approved|granted/i.test(t.status)
              ? "bg-emerald-500/15 text-action-success"
              : /rejected|denied/i.test(t.status)
                ? "bg-rose-500/15 text-action-danger"
                : "bg-bg-elevated text-text-muted"
        }`}
      >
        {t.status}
