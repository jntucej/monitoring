"use client";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { buildStudentDirectoryInspection, type StudentDirectoryRecord } from "@/lib/role-registers/studentDirectoryInspection";
import {
  ShieldCheck,
  Loader2,
  ArrowRight,
  AlertTriangle,
  Inbox,
} from "lucide-react";

interface StudentRow {
  id: string;
  name: string;
  roll?: string;
  uniqueId?: string;
  department?: string;
  year?: number;
  section?: string;
  status?: string;
}

interface StudentsResponse {
  success: boolean;
  data: StudentRow[];
}

function FacultyStudentDirectoryInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "faculty") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<StudentsResponse>("/api/students", { ttlMs: 30_000 });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const students: StudentRow[] = Array.isArray(data?.data) ? data.data : [];

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      <Link
        href="/faculty"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Faculty Overview
      </Link>

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Faculty · Students"
        purpose="Search and inspect student academic standings, contact records, and roll details."
        why="Student lookups provide verified roll numbers, mentor mappings, and academic standing history."
        contextLabel="Student Directory"
        statusTone="info"
        statusPill={`${students.length} students`}
        statusSummary={`Directory of ${students.length} students. Inspect records or jump to class roster.`}
        primaryAction={{ label: "Faculty Home", href: "/faculty" }}
        secondaryActions={[
          { label: "Class Roster", href: "/faculty/class" },
          { label: "My Classes", href: "/faculty/my-classes" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">Student Directory data unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      <WidgetBoundary title="Student Directory">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <ShieldCheck className="w-4 h-4 text-action-success shrink-0" />
              <span className="text-sm font-semibold text-white truncate">Student Directory</span>
            </div>
            <span className="text-xs text-text-muted shrink-0">
              {students.length} student(s)
            </span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" /> Loading students…
            </div>
          ) : students.length === 0 ? (
            <div className="p-6 text-center min-w-0">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No students match your department scope.</p>
            </div>
          ) : (
            <div className="overflow-x-auto min-w-0">
              <table className="w-full text-sm min-w140">
                <thead>
                  <tr className="border-b border-border text-left text-xs text-text-muted">
                    <th className="py-2 pr-4 px-4">Name</th>
                    <th className="py-2 pr-4 px-4">Roll</th>
                    <th className="py-2 pr-4 px-4">Department</th>
                    <th className="py-2 px-4">Year / Section</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800/50">
                  {students.map((s) => (
                    <tr
                      key={s.id}
                      onClick={() => inspect(buildStudentDirectoryInspection(s))}
                      onKeyDown={(e) => {
                        if (e.key === "Enter" || e.key === " ") {
                          e.preventDefault();
                          inspect(buildStudentDirectoryInspection(s));
                        }
                      }}
                      tabIndex={0}
                      role="button"
                      aria-label={`Inspect student ${s.name}`}
                      className="cursor-pointer hover:bg-bg-elevated/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary"
                    >
                      <td className="py-2.5 pr-4 px-4 text-text-secondary">{s.name}</td>
                      <td className="py-2.5 pr-4 px-4 font-mono text-xs text-text-secondary">{s.roll ?? s.uniqueId ?? "—"}</td>
                      <td className="py-2.5 pr-4 px-4 text-text-muted">{s.department ?? "—"}</td>
                      <td className="py-2.5 px-4 text-text-muted">
                        {s.year != null ? `Y${s.year}` : "—"} / {s.section ?? "—"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}

export default function FacultyStudentDirectoryPage() {
  return (
    <AuthGuard allowedRoles={["faculty", "hod", "admin", "sysadmin"]}>
      <Suspense fallback={<PageLoading />}>
        <FacultyStudentDirectoryInner />
      </Suspense>
    </AuthGuard>
