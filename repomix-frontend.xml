<file path="src/components/approver/StageQueuePanel.tsx">
"use client";
// src/components/approver/StageQueuePanel.tsx
// SCAFFOLD:QUEUE — stage-aware queue with read-only cross-stage visibility.
//
// Behaviour:
//   • Rows whose current_stage === myStage && status === "PENDING" → action buttons
//   • Rows in any other chain stage → read-only "View only" badge
//   • Rows outside the chain → hidden entirely (never rendered)
//   • Uses useDashboardData (single fetch, cache + polling, refreshKey)
//   • Structured error codes via apiErrors (repo envelope { success, error:{code} })
//   • WidgetBoundary keyed on refreshKey → no stale rows after an action
//
// The root cause of "not allowed to act at stage X": the old list rendered
// Approve/Reject on every row it received, and the API only returned rows for
// the caller's own stage — so a stale cached payload (or an undated
// initialPermissions prop) showed buttons that the server then rejected with
// FORBIDDEN. Buttons are now derived from the row itself, never from the feed.

import { useCallback, useMemo, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { EmptyState } from "@/components/shared/EmptyState";
import { FlagBadge } from "@/components/shared/FlagBadge";
import { useDashboardData } from "@/hooks/useDashboardData";
import { friendlyApiError, readApiError } from "@/lib/apiErrors";
import { getAuthHeaders } from "@/lib/utils";
import { POLL_INTERVALS } from "@/config/app-constants";
import { Check, Eye, Loader2, RefreshCw, X } from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import type { FlagLevel } from "@/lib/permission-model";
import {
  LevelBadge,
  ForwardedFromChip,
  DirectBadge,
  sortHostelTickets,
} from "./HostelTicketBadges";

/** Row shape shared by every queue feed (mirrors /api/permissions). */
export interface StageQueueRow {
  id: string;
  ticket_number: string;
  workflow_type: string;
  current_stage: string;
  status: string;
  sla_deadline?: string | null;
  created_at?: string;
  student?: {
    id?: string;
    name?: string | null;
    student_details?: { roll?: string | null; hostel_block?: string | null } | null;
    conductFlag?: string | null;
    conductFlagReason?: string | null;
  } | null;
  /** Current hostel level the ticket is routed to (forward target / stage). */
  routed_to_role?: string | null;
  /** Set when this ticket was forwarded from a lower level. */
  forwarded_from_role?: string | null;
  /** Forwarder's comment explaining the handoff. */
  forward_comment?: string | null;
  /** True when the pass was generated directly (bypassed the chain). */
  direct_generated?: boolean;
  [k: string]: unknown;
}

export type QueueAction = "APPROVE" | "REJECT" | "FORWARD" | "ESCALATE";

export interface StageQueuePanelProps {
  /** Route returning { success, data: StageQueueRow[], total? }. */
  url: string;
  /** The stage THIS actor is authorized to act at. */
  myStage: string;
  /** Every stage in the workflow chain (for read-only visibility). */
  chain: string[];
  /** Called when an action button is pressed. Must throw on failure. */
  onAction?: (row: StageQueueRow, action: QueueAction, comment: string) => Promise<void>;
  title?: string;
  /** Render the FORWARD / ESCALATE secondary actions (default true). */
  allowForward?: boolean;
  pollMs?: number;
  ttlMs?: number;
}

/** PATCH /api/permissions/[ticket] is the single write surface for the workflow. */
export async function actOnTicket(
  ticket: string,
  action: QueueAction,
  comment = ""
): Promise<void> {
  const res = await fetch(`/api/permissions/${encodeURIComponent(ticket)}`, {
    method: "PATCH",
    headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
    body: JSON.stringify({ action, comment: comment.trim() || undefined }),
  });
  if (!res.ok) {
    const { code, message } = await readApiError(res);
    // Surface the exact stage/state reason instead of a blank banner.
    throw new Error(friendlyApiError(code, message));
  }
  const body = (await res.json().catch(() => null)) as { success?: boolean } | null;
  if (body && body.success === false) {
    throw new Error(friendlyApiError(undefined, "Action was not accepted."));
  }
}

export function StageQueuePanel({
  url,
  myStage,
  chain,
  onAction,
  title = "Queue",
  allowForward = true,
  pollMs = POLL_INTERVALS.normal,
  ttlMs = 5_000,
}: StageQueuePanelProps) {
  const { data, loading, error, refresh, refreshKey } = useDashboardData<{
    success: boolean;
    data: StageQueueRow[];
    total?: number;
  }>(url, { ttlMs, pollMs });

  const viewerRole = useAuthStore((s) => s.role);

  const [busyId, setBusyId] = useState<string | null>(null);
  const [actionError, setActionError] = useState<string | null>(null);

  // A row is actionable only when the server's own state says the caller is
  // the owner of this stage AND it is still pending. Everything else renders
  // read-only — so a 403 is structurally impossible from this component.
  const canAct = useCallback(
    (row: StageQueueRow) =>
      row.current_stage === myStage && row.status === "PENDING" && Boolean(onAction),
    [myStage, onAction],
  );

  const visibleRows = useMemo(
    () => {
      const rows = (data?.data ?? []).filter((r) => chain.includes(r.current_stage));
      // Pinned (forwarded to me) -> SLA-overdue -> rest.
      return sortHostelTickets(rows, viewerRole);
    },
    [data, chain, viewerRole],
  );

  const handle = useCallback(
    async (row: StageQueueRow, action: QueueAction) => {
      if (!onAction) return;
      setBusyId(row.ticket_number);
      setActionError(null);
      try {
        await onAction(row, action, "");
        await refresh();
      } catch (e) {
        setActionError(e instanceof Error ? e.message : "Action failed");
      } finally {
        setBusyId(null);
      }
    },
    [onAction, refresh],
  );

  const retry = useCallback(() => {
    setActionError(null);
    void refresh();
  }, [refresh]);

  return (
    <section className="surface-card bg-bg-surface p-4">
      <header className="mb-3 flex items-center justify-between gap-2">
        <h2 className="text-sm font-semibold text-text-primary">{title}</h2>
        <button
          type="button"
          onClick={retry}
          disabled={loading}
          className="surface-card p-1.5 text-text-secondary transition-colors hover:bg-bg-elevated hover:text-text-primary disabled:opacity-50"
          aria-label="Refresh queue"
          title="Refresh queue"
        >
          {loading ? (
            <Loader2 className="h-4 w-4 animate-spin" aria-hidden />
          ) : (
            <RefreshCw className="h-4 w-4" aria-hidden />
          )}
        </button>
      </header>

      {error && (
        <div
          role="alert"
          className="surface-card mb-3 bg-action-danger/10 p-2 text-xs text-action-danger"
        >
          {error}
        </div>
      )}
      {actionError && (
        <div
          role="alert"
          className="surface-card mb-3 bg-action-warning/10 p-2 text-xs text-action-warning"
        >
          {actionError}
        </div>
      )}

      {visibleRows.length === 0 && !loading ? (
        <EmptyState
          title="No items in this queue"
          description="Anything pending at your stage will appear here."
        />
      ) : (
        <WidgetBoundary key={refreshKey} title={`${title} list`}>
          <ul className="divide-y divide-border">
            {visibleRows.map((row) => {
              const actionable = canAct(row);
              const busy = busyId === row.ticket_number;
              return (
                <li key={row.id} className="flex items-center gap-3 py-2">
                  <div className="min-w-0 flex-1">
                    <div className="flex items-center gap-2">
                      <div className="truncate font-mono text-xs text-text-muted">
                        {row.ticket_number}
                      </div>
                      <LevelBadge row={row} fallbackStage={row.current_stage} />
                      <ForwardedFromChip row={row} />
                      <DirectBadge row={row} />
                    </div>
                    <div className="truncate text-sm text-text-primary">
                      {row.student?.name ?? "—"}
                      {row.student?.student_details?.roll
                        ? ` · ${row.student.student_details.roll}`
                        : ""}
                      {row.student?.conductFlag &&
                        row.student.conductFlag !== "clear" && (
                          <FlagBadge
                            flag={row.student.conductFlag as FlagLevel}
                            reason={row.student.conductFlagReason ?? undefined}
                            className="ml-1.5"
                          />
                        )}
                    </div>
                    <div className="text-xs text-text-muted">
                      Stage: {row.current_stage}
                      {!actionable ? " · view only" : ""}
                    </div>
                  </div>

                  {actionable ? (
                    <div className="flex shrink-0 items-center gap-1">
                      <button
                        type="button"
                        disabled={busy}
                        onClick={() => void handle(row, "APPROVE")}
                        className="surface-card bg-action-primary px-2 py-1 text-xs text-white disabled:opacity-50"
                        aria-label={`Approve ${row.ticket_number}`}
                        title="Approve"
                      >
                        {busy ? (
                          <Loader2 className="size-3.5 animate-spin" aria-hidden />
                        ) : (
                          <Check className="size-3.5" aria-hidden />
                        )}
                      </button>
                      <button
                        type="button"
                        disabled={busy}
                        onClick={() => void handle(row, "REJECT")}
                        className="surface-card bg-action-danger px-2 py-1 text-xs text-white disabled:opacity-50"
                        aria-label={`Reject ${row.ticket_number}`}
                        title="Reject"
                      >
                        <X className="size-3.5" aria-hidden />
                      </button>
                      {allowForward && (
                        <button
                          type="button"
                          disabled={busy}
                          onClick={() => void handle(row, "FORWARD")}
                          className="surface-card bg-bg-elevated px-2 py-1 text-xs text-text-secondary disabled:opacity-50"
                          aria-label={`Forward ${row.ticket_number}`}
                          title="Forward to next stage"
                        >
                          Forward
                        </button>
                      )}
                    </div>
                  ) : (
                    <span className="surface-card flex shrink-0 items-center gap-1 bg-bg-elevated px-2 py-1 text-xs text-text-muted">
                      <Eye className="size-3.5" aria-hidden /> View only
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </WidgetBoundary>
      )}
    </section>
  );
}

export default StageQueuePanel;
</file>

<file path="src/components/approver/SupervisorCommandBar.tsx">
"use client";

/**
 * SupervisorCommandBar — Cmd/Ctrl+K command palette for the Supervisor console.
 *
 * 5-command free-text parser:
 *   approve <ticket>              PATCH /api/permissions/<ticket> { action: APPROVE }
 *   escalate <ticket> to <role>  PATCH /api/permissions/<ticket> { action: ESCALATE, targetRole }
 *   assign <alert> to <user>     POST /api/alerts/assign { alert_id, assignee_user_id }
 *   resolve <alert>              PATCH /api/alerts/<alert>
 *   handover shift <text>        POST /api/campus-extra/handover { toRole, items, notes }
 *
 * Keyboard: up/down to navigate, Enter to execute, Escape to close.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  CheckCircle,
  AlertTriangle,
  UserPlus,
  ShieldCheck,
  ArrowRight,
  Search,
  ChevronRight,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { getConsoleConfig } from "@/config/consoles";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
}

const COMMAND_DEFS: CommandDef[] = [
  {
    id: "approve",
    label: "Approve a ticket",
    hint: "approve <ticket> — Approve a pending escalation ticket",
    icon: CheckCircle,
  },
  {
    id: "escalate",
    label: "Escalate a ticket",
    hint: "escalate <ticket> to <role> — Escalate to a target role",
    icon: AlertTriangle,
  },
  {
    id: "assign",
    label: "Assign an alert",
    hint: "assign <alert> to <user> — Assign an alert to an operator",
    icon: UserPlus,
  },
  {
    id: "resolve",
    label: "Resolve an alert",
    hint: "resolve <alert> — Resolve an active alert",
    icon: ShieldCheck,
  },
  {
    id: "handover",
    label: "Shift handover",
    hint: "handover shift <text> — Create a shift handover note",
    icon: ArrowRight,
  },
];

type Action =
  | "APPROVE"
  | "ESCALATE"
  | "ASSIGN"
  | "RESOLVE"
  | "HANDOVER"
  | "UNKNOWN";

interface ParsedCommand {
  action: Action;
  /** Ticket number (approve / escalate). */
  ticket: string;
  /** Alert ID (assign / resolve). */
  alertId: string;
  /** Target role for escalate. */
  targetRole: string;
  /** Assignee user id for assign. */
  assignee: string;
  /** Free-text handover note. */
  handoverText: string;
}

/**
 * Parse a supervisor free-text command.
 *
 *   approve <ticket>
 *   escalate <ticket> to <role>
 *   assign <alert> to <user>
 *   resolve <alert>
 *   handover shift <text...>
 */
function parseCommand(input: string): ParsedCommand {
  const tokens = input.trim().split(/\s+/);
  const first = (tokens[0] || "").toLowerCase();
  const empty: ParsedCommand = {
    action: "UNKNOWN",
    ticket: "",
    alertId: "",
    targetRole: "",
    assignee: "",
    handoverText: "",
  };

  if (first === "approve") {
    return { ...empty, action: "APPROVE", ticket: tokens[1] ?? "" };
  }

  if (first === "escalate") {
    // escalate <ticket> to <role>
    const ticket = tokens[1] ?? "";
    // Find "to" token and take the next token as the target role.
    const toIdx = tokens.findIndex((t) => t.toLowerCase() === "to");
    const targetRole = toIdx >= 0 ? (tokens[toIdx + 1] ?? "") : "";
    return { ...empty, action: "ESCALATE", ticket, targetRole };
  }

  if (first === "assign") {
    // assign <alert> to <user>
    const alertId = tokens[1] ?? "";
    const toIdx = tokens.findIndex((t, i) => i > 0 && t.toLowerCase() === "to");
    const assignee = toIdx >= 0 ? (tokens[toIdx + 1] ?? "") : "";
    return { ...empty, action: "ASSIGN", alertId, assignee };
  }

  if (first === "resolve") {
    return { ...empty, action: "RESOLVE", alertId: tokens[1] ?? "" };
  }

  if (first === "handover") {
    // handover shift <text...>
    // Drop "handover" and "shift" keywords, keep the rest as the note.
    const noteTokens = tokens.slice(1);
    // Skip a leading "shift" token if present.
    const startIdx =
      noteTokens[0]?.toLowerCase() === "shift" ? 1 : 0;
    const handoverText = noteTokens.slice(startIdx).join(" ");
    return { ...empty, action: "HANDOVER", handoverText };
  }

  return { ...empty, action: "UNKNOWN" };
}

export interface SupervisorCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function SupervisorCommandBar({ role, open, onClose }: SupervisorCommandBarProps) {
  const addToast = useUIStore((s) => s.addToast);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const [busy, setBusy] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id));
  }, [role]);

  const filtered = useMemo(() => {
    if (!query.trim()) return available;
    const q = query.toLowerCase();
    return available.filter(
      (c) => c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q)
    );
  }, [query, available]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  const executeCommand = useCallback(
    async (parsed: ParsedCommand) => {
      if (parsed.action === "UNKNOWN") {
        addToast({ variant: "error", message: "Unknown command. Type a command from the list below." });
        return;
      }

      setBusy(true);
      try {
        /* ── approve: PATCH /api/permissions/<ticket> ─────────────── */
        if (parsed.action === "APPROVE") {
          if (!parsed.ticket) {
            addToast({ variant: "error", message: "Usage: approve <ticket>" });
            return;
          }
          const res = await fetch(
            `/api/permissions/${encodeURIComponent(parsed.ticket)}`,
            {
              method: "PATCH",
              headers: getAuthHeaders(),
              body: JSON.stringify({ action: "APPROVE" }),
            }
          );
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            addToast({ variant: "success", message: `Approved ${parsed.ticket}` });
            onClose();
          } else {
            addToast({ variant: "error", message: json?.error?.message || `Failed to approve ${parsed.ticket}` });
          }
          return;
        }

        /* ── escalate: PATCH /api/permissions/<ticket> ────────────── */
        if (parsed.action === "ESCALATE") {
          if (!parsed.ticket) {
            addToast({ variant: "error", message: "Usage: escalate <ticket> to <role>" });
            return;
          }
          const body: Record<string, string> = { action: "ESCALATE" };
          if (parsed.targetRole) body.targetRole = parsed.targetRole;
          const res = await fetch(
            `/api/permissions/${encodeURIComponent(parsed.ticket)}`,
            {
              method: "PATCH",
              headers: getAuthHeaders(),
              body: JSON.stringify(body),
            }
          );
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            addToast({
              variant: "success",
              message: `Escalated ${parsed.ticket}${parsed.targetRole ? ` to ${parsed.targetRole}` : ""}`,
            });
            onClose();
          } else {
            addToast({ variant: "error", message: json?.error?.message || `Failed to escalate ${parsed.ticket}` });
          }
          return;
        }

        /* ── assign: POST /api/alerts/assign ──────────────────────── */
        if (parsed.action === "ASSIGN") {
          if (!parsed.alertId || !parsed.assignee) {
            addToast({ variant: "error", message: "Usage: assign <alert> to <user>" });
            return;
          }
          const res = await fetch("/api/alerts/assign", {
            method: "POST",
            headers: getAuthHeaders(),
            body: JSON.stringify({
              alert_id: parsed.alertId,
              assignee_user_id: parsed.assignee,
            }),
          });
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            addToast({ variant: "success", message: `Assigned alert ${parsed.alertId} to ${parsed.assignee}` });
            onClose();
          } else {
            addToast({ variant: "error", message: json?.error?.message || `Failed to assign alert ${parsed.alertId}` });
          }
          return;
        }

        /* ── resolve: PATCH /api/alerts/<alert> ───────────────────── */
        if (parsed.action === "RESOLVE") {
          if (!parsed.alertId) {
            addToast({ variant: "error", message: "Usage: resolve <alert>" });
            return;
          }
          const res = await fetch(
            `/api/alerts/${encodeURIComponent(parsed.alertId)}`,
            {
              method: "PATCH",
              headers: getAuthHeaders(),
            }
          );
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            addToast({ variant: "success", message: `Resolved alert ${parsed.alertId}` });
            onClose();
          } else {
            addToast({ variant: "error", message: json?.error?.message || `Failed to resolve alert ${parsed.alertId}` });
          }
          return;
        }

        /* ── handover: POST /api/campus-extra/handover ────────────── */
        if (parsed.action === "HANDOVER") {
          const res = await fetch("/api/campus-extra/handover", {
            method: "POST",
            headers: getAuthHeaders(),
            body: JSON.stringify({
              toRole: "operator",
              items: [
                {
                  type: "shift_note",
                  title: "Shift handover",
                  details: parsed.handoverText || "(no note)",
                },
              ],
              notes: parsed.handoverText || undefined,
            }),
          });
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            addToast({ variant: "success", message: "Shift handover created" });
            onClose();
          } else {
            addToast({ variant: "error", message: json?.error?.message || "Failed to create handover" });
          }
          return;
        }
      } catch {
        addToast({ variant: "error", message: "Network error while processing command" });
      } finally {
        setBusy(false);
      }
    },
    [addToast, onClose]
  );

  const handleSelect = useCallback((cmd: CommandDef) => {
    setQuery(cmd.id);
    inputRef.current?.focus();
  }, []);

  const handleEnter = useCallback(() => {
    const parsed = parseCommand(query);
    const first = query.trim().toLowerCase();
    // Bare keywords that need more tokens: keep focus so the user can finish.
    if (["approve", "escalate", "assign", "resolve"].includes(first)) {
      if (parsed.action === "UNKNOWN") {
        inputRef.current?.focus();
        return;
      }
      // For assign, require both alert and user.
      if (parsed.action === "ASSIGN" && (!parsed.alertId || !parsed.assignee)) {
        inputRef.current?.focus();
        return;
      }
      // For escalate, ticket is required; targetRole is optional.
      if (parsed.action === "ESCALATE" && !parsed.ticket) {
        inputRef.current?.focus();
        return;
      }
      // For approve / resolve, the id is required.
      if (parsed.action === "APPROVE" && !parsed.ticket) {
        inputRef.current?.focus();
        return;
      }
      if (parsed.action === "RESOLVE" && !parsed.alertId) {
        inputRef.current?.focus();
        return;
      }
    }
    executeCommand(parsed);
  }, [executeCommand, query]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!query.trim()) {
          if (filtered[active]) handleSelect(filtered[active]);
        } else {
          handleEnter();
        }
      }
    },
    [filtered, active, handleSelect, handleEnter, query]
  );

  if (!open) return null;

  const parsedPreview = query.trim() ? parseCommand(query) : null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="Supervisor command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={`Supervisor command (role: ${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="Supervisor command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Parsed-command preview */}
        {parsedPreview && parsedPreview.action !== "UNKNOWN" ? (
          <div className="surface-card px-4 py-2 bg-bg-elevated text-xs text-text-secondary">
            <span className="font-mono font-bold text-action-primary">
              {parsedPreview.action}
            </span>
            {parsedPreview.action === "APPROVE" ? (
              parsedPreview.ticket ? (
                <span className="ml-1.5 font-mono">{parsedPreview.ticket}</span>
              ) : (
                <span className="ml-1.5 text-text-muted italic">[ticket required]</span>
              )
            ) : null}
            {parsedPreview.action === "ESCALATE" ? (
              <>
                {parsedPreview.ticket ? (
                  <span className="ml-1.5 font-mono">{parsedPreview.ticket}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[ticket required]</span>
                )}
                {parsedPreview.targetRole ? (
                  <span className="ml-1.5 text-text-muted">to {parsedPreview.targetRole}</span>
                ) : null}
              </>
            ) : null}
            {parsedPreview.action === "ASSIGN" ? (
              <>
                {parsedPreview.alertId ? (
                  <span className="ml-1.5 font-mono">{parsedPreview.alertId}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[alert required]</span>
                )}
                {parsedPreview.assignee ? (
                  <span className="ml-1.5 text-text-muted">to {parsedPreview.assignee}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[user required]</span>
                )}
              </>
            ) : null}
            {parsedPreview.action === "RESOLVE" ? (
              parsedPreview.alertId ? (
                <span className="ml-1.5 font-mono">{parsedPreview.alertId}</span>
              ) : (
                <span className="ml-1.5 text-text-muted italic">[alert required]</span>
              )
            ) : null}
            {parsedPreview.action === "HANDOVER" ? (
              parsedPreview.handoverText ? (
                <span className="ml-1.5 text-text-muted italic truncate">
                  &ldquo;{parsedPreview.handoverText}&rdquo;
                </span>
              ) : (
                <span className="ml-1.5 text-text-muted italic">[shift note]</span>
              )
            ) : null}
            {busy ? <span className="ml-2 text-text-muted">processing…</span> : null}
          </div>
        ) : null}

        {/* Command list */}
        <ul role="listbox" aria-label="Supervisor commands" className="max-h-64 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors disabled:opacity-50 ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>
      </div>
    </div>
  );
}

export default SupervisorCommandBar;
</file>

<file path="src/components/approver/SupervisorStatusBar.tsx">
"use client";

/**
 * SupervisorStatusBar — bottom status strip for the Supervisor console.
 *
 * Renders the compact gate/escalation summary:
 *   ● N gates online · M escalations · K incidents · shift <label> active
 *
 * Counts are passed in from RoleConsole, which derives them from the
 * /api/supervisor/escalations fetch. The `/api/gates` route exists but
 * the status bar derives "gates online" from the distinct gate count in
 * the escalation feed (no second network request). Shift label is
 * surfaced when available; "—" when not.
 */

import { Loader2 } from "lucide-react";

export interface SupervisorCounts {
  /** Distinct gate count in the escalation feed. */
  gatesOnline: number;
  /** Number of open escalations (escalated + SLA-breached). */
  escalations: number;
  /** Number of active incidents (active alerts). */
  incidents: number;
  /** Current shift label, or null when not available. */
  shift: string | null;
  /** Number of critical-priority items. */
  critical: number;
}

export interface SupervisorStatusBarProps {
  counts: SupervisorCounts | null;
  /** Timestamp of the last data refresh (ISO). */
  lastScan?: string | null;
  /** Whether a refresh is in progress. */
  refreshing?: boolean;
}

export function SupervisorStatusBar({ counts, lastScan, refreshing = false }: SupervisorStatusBarProps) {
  const fmt = (iso: string | null | undefined) => {
    if (!iso) return "—";
    try {
      return new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
    } catch {
      return "—";
    }
  };

  const shiftLabel = counts?.shift ?? "—";

  return (
    <footer
      className="surface-card flex items-center justify-between gap-4 px-4 py-2 bg-bg-surface/95 backdrop-blur-md text-xs text-text-secondary select-none"
      aria-label="Supervisor status bar"
    >
      {/* Left: gates · escalations · incidents · shift */}
      <div className="flex items-center gap-4 min-w-0">
        {/* Live indicator */}
        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span className={`size-2 rounded-full shrink-0 ${refreshing ? "bg-action-warning animate-pulse" : "bg-action-success"}`} />
          <span className="text-text-muted">
            {counts?.gatesOnline ?? 0} gates online
          </span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span className="text-text-muted">escalations</span>
          <span className="font-mono tabular-nums font-bold text-action-danger">
            {counts?.escalations ?? 0}
          </span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span className="text-text-muted">incidents</span>
          <span className="font-mono tabular-nums font-bold text-action-warning">
            {counts?.incidents ?? 0}
          </span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span className="text-text-muted">shift</span>
          <span className="font-mono tabular-nums font-bold text-text-primary">
            {shiftLabel}
          </span>
          <span className="text-text-muted">active</span>
        </span>

        {/* Critical count shown only when > 0 */}
        {counts && counts.critical > 0 ? (
          <span className="inline-flex items-center gap-1.5 min-w-0">
            <span className="text-text-muted">critical</span>
            <span className="font-mono tabular-nums font-bold text-action-danger">
              {counts.critical}
            </span>
          </span>
        ) : null}
      </div>

      {/* Right: last updated + refresh indicator */}
      <div className="flex items-center gap-3 shrink-0">
        {refreshing ? (
          <Loader2 className="w-3.5 h-3.5 animate-spin text-text-muted" />
        ) : null}
        {lastScan ? (
          <span className="inline-flex items-center gap-1.5">
            <span className="text-text-muted">last updated</span>
            <span className="font-mono tabular-nums text-text-secondary">
              {fmt(lastScan)}
            </span>
          </span>
        ) : null}
      </div>
    </footer>
  );
}

export default SupervisorStatusBar;
</file>

<file path="src/components/approver/SysadminCommandBar.tsx">
"use client";

/**
 * SysadminCommandBar — Cmd/Ctrl+K command palette for the sysadmin console.
 *
 * Mirrors the DeputyWardenCommandBar / MessInchargeCommandBar free-text parser
 * pattern with 5 navigation commands — all five are page navigations (the
 * sysadmin console is a read/monitor surface), each routing to the real
 * sysadmin sub-page under /sysadmin/:
 *   health       → /sysadmin/application-health
 *   services     → /sysadmin/docker-services
 *   deployments  → /sysadmin/deployments
 *   backup       → /sysadmin/backup
 *   audit        → /sysadmin/audit
 *
 * Keyboard: up/down to navigate, Enter to execute, Escape to close.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Activity,
  Boxes,
  Rocket,
  HardDrive,
  ScrollText,
  Search,
  ChevronRight,
} from "lucide-react";
import { useUIStore } from "@/stores/uiStore";
import { getConsoleConfig } from "@/config/consoles";
import adminManifest from "../../../packages/admin-console-kit/manifest/ia.json";
import sysadminManifest from "../../../packages/sysadmin-console-kit/manifest/ia.json";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
  href: string;
}

/** All sysadmin navigation commands (targeting the real sub-page routes). */
const COMMAND_DEFS: CommandDef[] = [
  {
    id: "health",
    label: "Open application health",
    hint: "health — Go to the application-health page",
    icon: Activity,
    href: "/sysadmin/application-health",
  },
  {
    id: "services",
    label: "Open Docker & services",
    hint: "services — Go to the docker-services page",
    icon: Boxes,
    href: "/sysadmin/docker-services",
  },
  {
    id: "deployments",
    label: "Open deployment history",
    hint: "deployments — Go to the deployments page",
    icon: Rocket,
    href: "/sysadmin/deployments",
  },
  {
    id: "backup",
    label: "Open backup status",
    hint: "backup — Go to the backup-status page",
    icon: HardDrive,
    href: "/sysadmin/backup",
  },
  {
    id: "audit",
    label: "Open audit logs",
    hint: "audit — Go to the audit-logs page",
    icon: ScrollText,
    href: "/sysadmin/audit",
  },
];

type Action = "NAVIGATE" | "UNKNOWN";

interface ParsedCommand {
  action: Action;
  commandId: string;
}

/**
 * Parse a sysadmin free-text command. Each of the five keywords routes to its
 * sub-page; anything else is UNKNOWN.
 */
function parseCommand(input: string): ParsedCommand {
  const tokens = input.trim().split(/\s+/);
  const first = (tokens[0] || "").toLowerCase();
  const match = COMMAND_DEFS.find((c) => c.id === first);
  if (match) {
    return { action: "NAVIGATE", commandId: match.id };
  }
  return { action: "UNKNOWN", commandId: "" };
}

export interface SysadminCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function SysadminCommandBar({ role, open, onClose }: SysadminCommandBarProps) {
  const addToast = useUIStore((s) => s.addToast);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const [busy, setBusy] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id));
  }, [role]);

  // 1.10 — two modes: default fuzzy-searches every manifest page; typing ">"
  // switches to the 5 navigation commands. The manifest's `href` values are
  // relative ("overview") or absolute ("/sysadmin/audit"), so normalize them
  // to the console root before filtering.
  const ALL_PAGES = useMemo(() => {
    const manifest = role === "admin" ? adminManifest : sysadminManifest;
    const root = role === "admin" ? "/admin" : "/sysadmin";
    return (manifest.categories ?? []).flatMap((c: { label?: string; pages?: Array<Record<string, unknown>> }) =>
      (c.pages ?? []).map((p) => {
        const raw = String(p.href ?? p.route ?? p.label ?? "");
        const href = raw.startsWith("/") ? raw : `${root}/${raw}`;
        return {
          label: String(p.label ?? p.title ?? raw),
          href,
          category: String(c.label ?? ""),
        };
      }),
    );
  }, [role]);

  const isCommandMode = query.startsWith(">");
  const pageQuery = isCommandMode ? "" : query;

  const filtered = useMemo(() => {
    if (isCommandMode) {
      const q = query.slice(1).trim().toLowerCase();
      return q === ""
        ? available
        : available.filter(
            (c) =>
              c.id.startsWith(q) ||
              c.label.toLowerCase().includes(q) ||
              c.hint.toLowerCase().includes(q),
          );
    }
    const q = pageQuery.trim().toLowerCase();
    if (q === "") return available.slice(0, 12);
    const matched = ALL_PAGES.filter(
      (p) =>
        p.label.toLowerCase().includes(q) ||
        p.href.toLowerCase().includes(q) ||
        p.category.toLowerCase().includes(q),
    ).slice(0, 12);
    // Pages are navigated directly (no parse step); surface them as pseudo-
    // commands so the existing list renderer + Enter handling work unchanged.
    return [
      ...matched.map((p) => ({
        id: `page:${p.href}`,
        label: p.label,
        hint: `${p.category} — ${p.href}`,
        icon: Search,
        href: p.href,
      })),
      ...available.filter((c) =>
        c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q),
      ),
    ];
  }, [query, isCommandMode, available, ALL_PAGES, pageQuery]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  const executeTarget = useCallback(
    (target: { href: string }) => {
      setBusy(true);
      window.location.href = target.href;
      onClose();
    },
    [onClose],
  );

  const handleSelect = useCallback((cmd: CommandDef) => {
    setQuery(cmd.id);
    inputRef.current?.focus();
  }, []);

  const handleEnter = useCallback(() => {
    if (isCommandMode) {
      const parsed = parseCommand(query);
      if (parsed.action === "UNKNOWN") {
        addToast({ variant: "error", message: "Unknown command. Type a command from the list below." });
        return;
      }
      const target = filtered.find((c) => c.id === parsed.commandId);
      if (!target) {
        addToast({ variant: "error", message: "Command not available for this console." });
        return;
      }
      executeTarget(target);
      return;
    }
    // Page-search mode: Enter on an active row navigates directly.
    const target = filtered[active];
    if (!target) return;
    executeTarget(target);
  }, [isCommandMode, query, filtered, active, addToast, executeTarget]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!query.trim()) {
          if (filtered[active]) handleSelect(filtered[active]);
        } else {
          handleEnter();
        }
      }
    },
    [filtered, active, handleSelect, handleEnter, query]
  );

  if (!open) return null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="SysAdmin command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={isCommandMode ? "Command…" : `Search pages or type ">" for commands (${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="SysAdmin command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Command list */}
        <ul role="listbox" aria-label="SysAdmin commands" className="max-h-64 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors disabled:opacity-50 ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>
      </div>
    </div>
  );
}

export default SysadminCommandBar;
</file>

<file path="src/components/approver/SysadminHealthPanel.tsx">
"use client";

/**
 * SysadminHealthPanel — the sysadmin's service-health side panel.
 *
 * Desktop: a side panel (rendered by RoleConsole alongside the board feed).
 * Mobile: a full-width section below the board. No horizontal scroll.
 *
 * Reads service health from GET /api/sysadmin/application-health (the same
 * board source the shell uses, so the app-level service rows are free) and,
 * when reachable, container telemetry from GET /api/sysadmin/services. Each
 * row shows a service name, its status, and the last-check timestamp. When
 * there is nothing to report, an EmptyState is shown.
 */

import { useMemo } from "react";
import { Loader2, Server } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { EmptyState } from "@/components/shared/EmptyState";

/** A single app-level service row as derived from health.components.services. */
interface ServiceRow {
  key: string;
  status: "healthy" | "degraded" | "unhealthy";
  detail?: string;
}

/** A container row as returned by /api/sysadmin/services. */
interface ContainerRow {
  name: string;
  running: boolean;
  cpuPercent: number;
  memoryBytes: number;
  restartsLastHour: number;
}

/** Response shape for /api/sysadmin/application-health. */
interface ApplicationHealthResponse {
  success: boolean;
  data: {
    status: "healthy" | "degraded" | "unhealthy";
    timestamp: string;
    uptimeSeconds: number;
    services: { status: "healthy" | "degraded" | "unhealthy"; [key: string]: unknown };
    database: { status: string; latencyMs: number };
    gateways: { status: string; online: number; offline: number; total: number };
    recentAlerts: Array<{ id: string; severity: string; message: string; timestamp?: string }>;
  };
}

/** Response shape for /api/sysadmin/services. */
interface ServicesResponse {
  success: boolean;
  data: {
    status?: "healthy" | "degraded" | "unhealthy";
    services?: { status: string; [key: string]: unknown };
    database?: { status: string; latencyMs?: number };
    containers: ContainerRow[] | null;
    containersError?: string | null;
  };
}

type HealthStatus = "healthy" | "degraded" | "unhealthy";

const STATUS_TONE: Record<HealthStatus, string> = {
  healthy: "text-action-success bg-emerald-400/10 border-emerald-400/20",
  degraded: "text-action-warning bg-amber-400/10 border-amber-400/20",
  unhealthy: "text-action-danger bg-rose-400/10 border-rose-400/20",
};

const STATUS_LABEL: Record<HealthStatus, string> = {
  healthy: "Up",
  degraded: "Degraded",
  unhealthy: "Down",
};

function normalizeStatus(raw: unknown): HealthStatus {
  const s = String(raw ?? "").toLowerCase();
  if (s === "healthy" || s === "up" || s === "ok") return "healthy";
  if (s === "degraded" || s === "warn" || s === "warning") return "degraded";
  return "unhealthy";
}

function fmtLastCheck(iso: string | null | undefined): string {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleTimeString("en-IN", {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
    });
  } catch {
    return "—";
  }
}

/** Derive a clean, readable detail string for an app-level service row. */
function serviceDetail(entry: unknown): string | undefined {
  if (entry && typeof entry === "object") {
    const e = entry as Record<string, unknown>;
    if (typeof e.error === "string" && e.error) return e.error;
    return undefined;
  }
  return undefined;
}

export function SysadminHealthPanel() {
  const { data: healthData, loading: healthLoading } =
    useApiResource<ApplicationHealthResponse>("/api/sysadmin/application-health", {
      ttlMs: 15_000,
    });
  const { data: servicesData, loading: servicesLoading } =
    useApiResource<ServicesResponse>("/api/sysadmin/services", {
      ttlMs: 15_000,
    });

  // App-level service rows: each named entry under health.data.services that
  // carries its own status (e.g. "auth"). We skip the aggregate "status" key.
  const serviceRows = useMemo<ServiceRow[]>(() => {
    const services = healthData?.data?.services;
    if (!services) return [];
    const rows: ServiceRow[] = [];
    for (const [key, value] of Object.entries(services)) {
      if (key === "status") continue;
      const entry = value as { status?: string };
      if (!entry || typeof entry.status !== "string") continue;
      rows.push({
        key,
        status: normalizeStatus(entry.status),
        detail: serviceDetail(value),
      });
    }
    // Surface the database / gateways components as named rows too.
    if (healthData?.data?.database) {
      rows.push({
        key: "database",
        status: normalizeStatus(healthData.data.database.status),
        detail:
          typeof healthData.data.database.latencyMs === "number"
            ? `${healthData.data.database.latencyMs}ms`
            : undefined,
      });
    }
    if (healthData?.data?.gateways) {
      const g = healthData.data.gateways;
      rows.push({
        key: "gateways",
        status: normalizeStatus(g.status),
        detail: `${g.online}/${g.total} online`,
      });
    }
    return rows;
  }, [healthData]);

  const containers = useMemo<ContainerRow[]>(
    () => (servicesData?.data?.containers ?? []) as ContainerRow[],
    [servicesData]
  );

  const lastCheck = healthData?.data?.timestamp ?? null;
  const loading = healthLoading || servicesLoading;
  const visible = serviceRows.length > 0 ? serviceRows : [];

  return (
    <section className="surface-card bg-bg-surface/60 p-4 min-w-0">
      {/* Header */}
      <div className="flex items-center gap-2 mb-3">
        <Server className="w-4 h-4 text-action-primary shrink-0" />
        <span className="text-sm font-bold text-text-primary truncate">
          Service Health
        </span>
        {lastCheck ? (
          <span className="ml-auto font-mono text-xs text-text-muted shrink-0">
            last check {fmtLastCheck(lastCheck)}
          </span>
        ) : null}
      </div>

      {loading ? (
        <div className="flex items-center gap-2 px-3 py-3 text-text-muted">
          <Loader2 className="w-4 h-4 animate-spin" />
          <span className="text-xs">Loading service health…</span>
        </div>
      ) : visible.length === 0 ? (
        <EmptyState
          title="No service health reported"
          description="The health engine has not reported any services yet."
          icon={<Server className="w-4 h-4" />}
        />
      ) : (
        <ul className="space-y-1.5 max-h60 overflow-y-auto custom-scrollbar pr-1 mb-3">
          {visible.map((row) => (
            <li
              key={row.key}
              className="surface-card flex items-center justify-between gap-2 bg-bg-elevated px-2.5 py-1.5 min-w-0"
            >
              <div className="min-w-0">
                <p className="text-xs font-semibold text-text-primary truncate">
                  {row.key}
                  {row.detail ? (
                    <span className="ml-1.5 font-mono text-xs font-normal text-text-muted">
                      {row.detail}
                    </span>
                  ) : null}
                </p>
              </div>
              <span
                className={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-semibold border shrink-0 ${STATUS_TONE[row.status]}`}
              >
                <span className="size-0 rounded-full bg-current" />
                {STATUS_LABEL[row.status]}
              </span>
            </li>
          ))}
        </ul>
      )}

      {/* Container telemetry (only when Prometheus is reachable). */}
      {containers.length > 0 ? (
        <div>
          <p className="mb-1.5 px-1 text-xs font-bold uppercase tracking-wider text-text-muted">
            Containers
          </p>
          <ul className="space-y-1.5 max-h50 overflow-y-auto custom-scrollbar pr-1">
            {containers.map((c) => (
              <li
                key={c.name}
                className="surface-card flex items-center justify-between gap-2 bg-bg-base/50 px-2.5 py-1.5 min-w-0"
              >
                <div className="min-w-0">
                  <p className="text-xs font-semibold text-text-primary truncate">
                    {c.name}
                  </p>
                  <p className="font-mono text-xs text-text-muted truncate">
                    cpu {c.cpuPercent}% · {Math.round(c.memoryBytes / 1024 / 1024)}MB ·{" "}
                    {c.restartsLastHour} restarts/h
                  </p>
                </div>
                <span
                  className={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-semibold border shrink-0 ${
                    c.running
                      ? "text-action-success bg-emerald-400/10 border-emerald-400/20"
                      : "text-action-danger bg-rose-400/10 border-rose-400/20"
                  }`}
                >
                  <span className="size-0 rounded-full bg-current" />
                  {c.running ? "Running" : "Down"}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ) : null}
    </section>
  );
}

export default SysadminHealthPanel;
</file>

<file path="src/components/approver/SysadminStatusBar.tsx">
"use client";

/**
 * SysadminStatusBar — bottom status strip for the sysadmin console.
 *
 * Renders the compact service summary:
 *   ● SysAdmin: N services up · M degraded · K down
 *
 * Counts are passed in from RoleConsole, which derives them from the
 * /api/sysadmin/application-health fetch (service + database + gateway
 * statuses). The last-check timestamp + refresh indicator are surfaced on the
 * right.
 */

import { Activity, Clock, Loader2 } from "lucide-react";

export interface SysadminCounts {
  /** Services reporting "healthy". */
  up: number;
  /** Services reporting "degraded". */
  degraded: number;
  /** Services reporting "unhealthy" (or the overall status is down). */
  down: number;
}

export interface SysadminStatusBarProps {
  counts: SysadminCounts | null;
  /** Timestamp of the last health check (ISO). */
  lastScan?: string | null;
  /** Whether a refresh is in progress. */
  refreshing?: boolean;
}

export function SysadminStatusBar({
  counts,
  lastScan,
  refreshing = false,
}: SysadminStatusBarProps) {
  const fmt = (iso: string | null | undefined) => {
    if (!iso) return "—";
    try {
      return new Date(iso).toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      });
    } catch {
      return "—";
    }
  };

  const up = counts?.up ?? 0;
  const degraded = counts?.degraded ?? 0;
  const down = counts?.down ?? 0;
  const anyProblem = down > 0 || degraded > 0;

  return (
    <footer
      className="surface-card flex items-center justify-between gap-4 px-4 py-2 bg-bg-surface/95 backdrop-blur-md text-xs text-text-secondary select-none"
      aria-label="SysAdmin status bar"
    >
      {/* Left: service summary */}
      <div className="flex items-center gap-4 min-w-0 overflow-x-auto custom-scrollbar">
        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span
            className={`size-2 rounded-full shrink-0 ${
              anyProblem ? "bg-action-warning" : "bg-action-success"
            }`}
          />
          <span className="text-text-muted">SysAdmin</span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0 shrink">
          <Activity className="w-3.5 h-3.5 text-text-muted" />
          <span className="text-text-muted">
            {up} up · {degraded} degraded · {down} down
          </span>
        </span>
      </div>

      {/* Right: last updated + refresh indicator */}
      <div className="flex items-center gap-3 shrink-0">
        {refreshing ? (
          <Loader2 className="w-3.5 h-3.5 animate-spin text-text-muted" />
        ) : null}
        {lastScan ? (
          <span className="inline-flex items-center gap-1.5">
            <Clock className="w-3.5 h-3.5 text-text-muted" />
            <span className="text-text-muted">last check</span>
            <span className="font-mono tabular-nums text-text-secondary">
              {fmt(lastScan)}
            </span>
          </span>
        ) : null}
      </div>
    </footer>
  );
}

export default SysadminStatusBar;
</file>

<file path="src/components/approver/TodayMealsPanel.tsx">
"use client";

/**
 * TodayMealsPanel — the mess In-charge's "today's meals" side panel.
 *
 * Desktop: a side panel (rendered by RoleConsole alongside the board feed).
 * Mobile: a full-width section below the board. No horizontal scroll.
 *
 * Reads today's service windows from GET /api/mess/days (the same feed the
 * board uses, so there is no second network request for the day rows) and
 * the declared/confirmed meal counts for the active day from
 * GET /api/mess/meal-counts. Each row shows the day name, its service window,
 * and a derived status: "active" when the window is open right now,
 * "upcoming" before it opens, "closed" after it has closed. When there is no
 * scheduled mess day, an EmptyState is shown.
 */

import { useMemo } from "react";
import { CalendarDays, Loader2, UtensilsCrossed } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { EmptyState } from "@/components/shared/EmptyState";

/** A row as returned by /api/mess/days (see days/route.ts SELECT list). */
interface MessDayRow {
  id: string;
  mealDate: string;
  mealType: string;
  dayType: string;
  windowOpensAt: string | null;
  windowClosesAt: string | null;
  tokensLockedAt: string | null;
  tokensRevokedAt: string | null;
  isActive: boolean;
  itemCount: number;
  selections: number;
}

/** Response shape for /api/mess/days. */
interface MessDaysResponse {
  success: boolean;
  data: { days: MessDayRow[] };
}

/** Response shape for /api/mess/meal-counts. */
interface MealCountsResponse {
  success: boolean;
  data: {
    messDayId: string;
    mealDate: string;
    total: number;
    declaredPresent: number;
    veg: number;
    nonVeg: number;
    confirmed: number;
    noShows: number;
  };
}

type MealStatus = "upcoming" | "active" | "closed";

const STATUS_TONE: Record<MealStatus, string> = {
  upcoming: "text-action-info bg-sky-400/10 border-sky-400/20",
  active: "text-action-success bg-emerald-400/10 border-emerald-400/20",
  closed: "text-action-danger bg-rose-400/10 border-rose-400/20",
};

const STATUS_LABEL: Record<MealStatus, string> = {
  upcoming: "Upcoming",
  active: "Active",
  closed: "Closed",
};

function dayName(mealDate: string): string {
  try {
    return new Date(`${mealDate}T00:00:00`).toLocaleDateString("en-IN", {
      weekday: "short",
      day: "numeric",
      month: "short",
    });
  } catch {
    return mealDate;
  }
}

function fmtWindow(iso: string | null): string {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleTimeString("en-IN", {
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return "—";
  }
}

function mealStatus(row: MessDayRow, now: number): MealStatus {
  const opens = row.windowOpensAt ? new Date(row.windowOpensAt).getTime() : null;
  const closes = row.windowClosesAt ? new Date(row.windowClosesAt).getTime() : null;
  if (closes !== null && now > closes) return "closed";
  if (opens !== null && now < opens) return "upcoming";
  // Active: within the window (or no explicit closes).
  return row.isActive ? "active" : "upcoming";
}

export function TodayMealsPanel() {
  const { data: daysData, loading: daysLoading } = useApiResource<MessDaysResponse>(
    "/api/mess/days",
    { ttlMs: 15_000 }
  );

  const days = useMemo<MessDayRow[]>(
    () => (daysData?.data?.days ?? []).slice(0, 7),
    [daysData]
  );

  // The active day is the newest scheduled day (the feed is sorted
  // meal_date DESC). Use it to pull the meal counts for today's service.
  const activeDayId = useMemo(
    () =>
      days.length > 0 && days[0].isActive ? days[0].id : null,
    [days]
  );

  const { data: countsData, loading: countsLoading } = useApiResource<MealCountsResponse>(
    activeDayId ? `/api/mess/meal-counts?dayId=${encodeURIComponent(activeDayId)}` : "/api/mess/meal-counts",
    { ttlMs: 15_000 }
  );

  const now = Date.now();
  const visible = days.length > 0 ? days : [];

  return (
    <section className="surface-card bg-bg-surface/60 p-4 min-w-0">
      {/* Header */}
      <div className="flex items-center gap-2 mb-3">
        <UtensilsCrossed className="w-4 h-4 text-action-primary shrink-0" />
        <span className="text-sm font-bold text-text-primary truncate">
          Today&apos;s Meals
        </span>
      </div>

      {daysLoading || countsLoading ? (
        <div className="flex items-center gap-2 px-3 py-3 text-text-muted">
          <Loader2 className="w-4 h-4 animate-spin" />
          <span className="text-xs">Loading today&apos;s service…</span>
        </div>
      ) : visible.length === 0 ? (
        <EmptyState
          title="No mess days scheduled"
          description="There is no published mess schedule to serve yet."
          icon={<CalendarDays className="w-4 h-4" />}
        />
      ) : (
        <ul className="space-y-1.5 max-h60 overflow-y-auto custom-scrollbar pr-1 mb-3">
          {visible.map((row) => {
            const status = mealStatus(row, now);
            return (
              <li
                key={row.id}
                className="surface-card flex items-center justify-between gap-2 bg-bg-elevated px-2.5 py-1.5 min-w-0"
              >
                <div className="min-w-0">
                  <p className="text-xs font-semibold text-text-primary truncate">
                    {dayName(row.mealDate)}
                    <span className="ml-1.5 font-mono text-xs font-normal text-text-muted">
                      {row.mealType}
                    </span>
                  </p>
                  <p className="text-xs font-mono text-text-muted truncate">
                    {fmtWindow(row.windowOpensAt)} – {fmtWindow(row.windowClosesAt)}
                  </p>
                </div>
                <span
                  className={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-semibold border shrink-0 ${STATUS_TONE[status]}`}
                >
                  <span className="size-0 rounded-full bg-current" />
                  {STATUS_LABEL[status]}
                </span>
              </li>
            );
          })}
        </ul>
      )}

      {/* Today's serving counts (only when an active day has counts). */}
      {countsData?.data ? (
        <div className="grid grid-cols-2 gap-2">
          <div className="surface-card bg-bg-base/50 px-2.5 py-1.5 min-w-0">
            <p className="text-xs text-text-muted">Declared present</p>
            <p className="text-sm font-bold text-text-primary font-mono tabular-nums">
              {countsData.data.declaredPresent}
            </p>
          </div>
          <div className="surface-card bg-bg-base/50 px-2.5 py-1.5 min-w-0">
            <p className="text-xs text-text-muted">Confirmed served</p>
            <p className="text-sm font-bold text-action-success font-mono tabular-nums">
              {countsData.data.confirmed}
            </p>
          </div>
        </div>
      ) : null}
    </section>
  );
}

export default TodayMealsPanel;
</file>

<file path="src/components/approver/VpCommandBar.tsx">
"use client";

/**
 * VpCommandBar — Cmd/Ctrl+K command palette for the Vice Principal console.
 *
 * VP is a delegated/oversight role: the 5 commands are pure navigation to
 * the real sub-pages under /vice-principal/ (no ticket-action verbs).
 *
 *   approvals    → /vice-principal/pending-approvals
 *   delegations  → /vice-principal/delegated-responsibilities
 *   audit        → /vice-principal/decision-history
 *   reports      → /vice-principal/examination-coordination
 *   records      → /vice-principal/records
 *
 * The sub-page routes mirror the on-disk directory names under
 * src/app/(approver)/vice-principal/.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import {
  CheckSquare,
  KeyRound,
  History,
  FileSpreadsheet,
  ClipboardList,
  Search,
  ChevronRight,
} from "lucide-react";
import { useUIStore } from "@/stores/uiStore";
import { getConsoleConfig } from "@/config/consoles";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
  /** Target route the command navigates to. */
  href: string;
}

/** All available VP command definitions (5 nav commands, no Account). */
const COMMAND_DEFS: CommandDef[] = [
  {
    id: "approvals",
    label: "Pending Approvals",
    hint: "approvals — VP-stage approval queue",
    icon: CheckSquare,
    href: "/vice-principal/pending-approvals",
  },
  {
    id: "delegations",
    label: "Delegations",
    hint: "delegations — Delegated duties & authority scope",
    icon: KeyRound,
    href: "/vice-principal/delegated-responsibilities",
  },
  {
    id: "audit",
    label: "Audit",
    hint: "audit — Decision history & audit trail",
    icon: History,
    href: "/vice-principal/decision-history",
  },
  {
    id: "reports",
    label: "Reports",
    hint: "reports — Institutional reports",
    icon: FileSpreadsheet,
    href: "/vice-principal/examination-coordination",
  },
  {
    id: "records",
    label: "Records",
    hint: "records — Records & analytics",
    icon: ClipboardList,
    href: "/vice-principal/analytics",
  },
];

export interface VpCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function VpCommandBar({ role, open, onClose }: VpCommandBarProps) {
  const router = useRouter();
  const addToast = useUIStore((s) => s.addToast);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const inputRef = useRef<HTMLInputElement>(null);

  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id));
  }, [role]);

  const filtered = useMemo(() => {
    if (!query.trim()) return available;
    const q = query.toLowerCase();
    return available.filter(
      (c) => c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q) || c.id.toLowerCase().includes(q),
    );
  }, [query, available]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  /** Navigate to the command's target sub-page. */
  const executeCommand = useCallback(
    (cmd: CommandDef) => {
      router.push(cmd.href);
      onClose();
    },
    [router, onClose],
  );

  const handleSelect = useCallback(
    (cmd: CommandDef) => {
      // Bare navigation commands: execute immediately on selection.
      executeCommand(cmd);
    },
    [executeCommand],
  );

  const handleEnter = useCallback(() => {
    if (!query.trim()) {
      if (filtered[active]) handleSelect(filtered[active]);
      return;
    }
    const q = query.toLowerCase();
    const match = filtered.find((c) => c.id.toLowerCase() === q || c.label.toLowerCase() === q);
    if (match) {
      executeCommand(match);
    } else {
      addToast({ variant: "error", message: "Unknown command. Type one of: approvals, delegations, audit, reports, records." });
    }
  }, [query, filtered, active, handleSelect, executeCommand, addToast]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        handleEnter();
      }
    },
    [filtered, handleEnter],
  );

  if (!open) return null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="Vice Principal command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={`Vice Principal command (role: ${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="Vice Principal command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Command list */}
        <ul role="listbox" aria-label="Vice Principal commands" className="max-h-56 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>

        <p className="surface-card px-4 py-2 text-xs text-text-muted">
          VP scope = delegated oversight. No hostel/branch filter.
        </p>
      </div>
    </div>
  );
}

export default VpCommandBar;
</file>

<file path="src/components/approver/VpDashboardPanel.tsx">
"use client";

/**
 * VpDashboardPanel — desktop right-panel / mobile full-width dashboard panel
 * for the Vice Principal console.
 *
 * Reads GET /api/principal/dashboard (board source, shared with RoleConsole).
 * Response shape:
 *   { success, data: { pendingApprovals: number, recentAlerts: AlertRow[], campusOccupancy: string } }
 *
 * Lists top-priority items: title (from alert message), priority (severity),
 * status, timestamp. Desktop: rendered as a side section below the board.
 * Mobile: full-width, no h-scroll. EmptyState when no alerts.
 */

import { useMemo, useCallback } from "react";
import { Radio, Clock, ShieldAlert, Loader2, CheckCircle, Inbox } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { EmptyState } from "@/components/shared/EmptyState";

interface AlertRow {
  id: string;
  severity: string;
  message: string;
  title?: string;
  gate_id: string | null;
  gate_name: string | null;
  timestamp: string;
  resolved: boolean;
}

interface PrincipalDashboardResponse {
  success?: boolean;
  data: {
    pendingApprovals: number;
    recentAlerts: AlertRow[];
    campusOccupancy: string;
  };
}

interface VpDashboardPanelProps {
  /** Optional refresh callback; called when the panel's fetch completes. */
  onRefresh?: () => void;
}

export function VpDashboardPanel({ onRefresh: _onRefresh }: VpDashboardPanelProps) {
  const { data, loading, refresh } = useApiResource<PrincipalDashboardResponse>(
    "/api/principal/dashboard",
    { ttlMs: 15_000 },
  );

  const alerts = useMemo(() => data?.data?.recentAlerts ?? [], [data]);
  const pendingApprovals = data?.data?.pendingApprovals ?? 0;

  // Top-priority items: sort by severity (critical > high > medium > low)
  // then by timestamp desc. Take top 10.
  const topItems = useMemo(() => {
    const priorityOrder: Record<string, number> = {
      CRITICAL: 0,
      HIGH: 1,
      MEDIUM: 2,
      LOW: 3,
    };
    return [...alerts]
      .sort((a, b) => {
        const pa = priorityOrder[a.severity?.toUpperCase()] ?? 99;
        const pb = priorityOrder[b.severity?.toUpperCase()] ?? 99;
        if (pa !== pb) return pa - pb;
        return new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime();
      })
      .slice(0, 10);
  }, [alerts]);

  const handleRefresh = useCallback(() => {
    void refresh();
  }, [refresh]);

  const fmt = (iso: string | null | undefined) => {
    if (!iso) return "—";
    try {
      return new Date(iso).toLocaleString([], {
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
    } catch {
      return "—";
    }
  };

  return (
    <section
      className="surface-card bg-bg-surface/60 p-4 min-w-0"
      aria-label="VP dashboard panel"
    >
      {/* Header */}
      <div className="flex items-center justify-between gap-2 mb-3">
        <div className="flex items-center gap-2 min-w-0">
          <Inbox className="w-4 h-4 text-action-primary shrink-0" />
          <span className="text-sm font-bold text-text-primary truncate">
            VP Dashboard
          </span>
        </div>
        <button
          type="button"
          onClick={handleRefresh}
          disabled={loading}
          className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-semibold text-text-secondary hover:text-text-primary hover:bg-bg-elevated disabled:opacity-40 disabled:cursor-not-allowed transition-colors shrink-0"
          aria-label="Refresh VP dashboard"
        >
          {loading ? (
            <Loader2 className="size-3.5 animate-spin" />
          ) : (
            <Radio className="size-3.5" />
          )}
          <span>Refresh</span>
        </button>
      </div>

      {/* Counts */}
      <div className="flex flex-wrap gap-3 mb-3 text-xs">
        <span className="surface-card inline-flex items-center gap-1.5 px-2 py-0.5 font-semibold text-action-info bg-sky-400/10">
          <ShieldAlert className="size-3.5" />
          {pendingApprovals} pending
        </span>
        <span className="surface-card inline-flex items-center gap-1.5 px-2 py-0.5 font-semibold text-action-warning bg-amber-400/10">
          <ShieldAlert className="size-3.5" />
          {alerts.length} active alerts
        </span>
        <span className="surface-card inline-flex items-center gap-1.5 px-2 py-0.5 font-semibold text-action-success bg-emerald-400/10">
          <CheckCircle className="size-3.5" />
          {pendingApprovals + alerts.length} records
        </span>
      </div>

      {/* Top-priority items list */}
      {loading && topItems.length === 0 ? (
        <div className="flex items-center gap-2 text-xs text-text-muted py-4 justify-center">
          <Loader2 className="w-4 h-4 animate-spin" />
          <span>Loading VP dashboard…</span>
        </div>
      ) : topItems.length === 0 ? (
        <EmptyState
          title="No active alerts"
          description="The VP dashboard is clear. No pending alerts to triage."
          icon={<CheckCircle className="w-5 h-5 text-action-success" />}
        />
      ) : (
        <ul className="space-y-1.5 max-h70 overflow-y-auto custom-scrollbar pr-1">
          {topItems.map((item) => {
            const priorityTone =
              item.severity?.toUpperCase() === "CRITICAL"
                ? "text-action-danger bg-rose-400/10 border-rose-400/20"
                : item.severity?.toUpperCase() === "HIGH"
                  ? "text-action-warning bg-amber-400/10 border-amber-400/20"
                  : "text-text-muted bg-bg-base border-border";
            return (
              <li
                key={item.id}
                className="surface-card flex items-center justify-between gap-2 bg-bg-elevated px-2.5 py-1.5 min-w-0"
              >
                <div className="min-w-0 flex-1">
                  <div className="flex items-center gap-1.5 min-w-0">
                    <span
                      className={`inline-flex items-center rounded-full px-1.5 py-0.5 text-xs font-mono font-bold border shrink-0 ${priorityTone}`}
                    >
                      {item.severity?.toUpperCase() ?? "—"}
                    </span>
                    <span className="text-xs font-semibold text-text-primary truncate">
                      {item.title ?? item.message ?? item.id}
                    </span>
                  </div>
                  <p className="text-xs font-mono text-text-muted truncate mt-0.5">
                    {item.gate_name ?? "Campus"} · {item.resolved ? "RESOLVED" : "ACTIVE"}
                  </p>
                </div>
                <span className="inline-flex items-center gap-1 shrink-0 text-xs font-mono text-text-muted">
                  <Clock className="size-3.5" />
                  {fmt(item.timestamp)}
                </span>
              </li>
            );
          })}
        </ul>
      )}

      {/* Footer hint */}
      <p className="mt-3 text-xs text-text-muted">
        VP scope = delegated oversight. No hostel/branch filter. Data refreshed every 15s.
      </p>
    </section>
  );
}

export default VpDashboardPanel;
</file>

<file path="src/components/approver/VpStatusBar.tsx">
"use client";

/**
 * VpStatusBar — status strip for the Vice Principal console.
 *
 * Renders: ● Vice Principal: N pending · M active · K records
 *
 * Counts are derived from the /api/principal/dashboard feed response:
 *   pending = data.pendingApprovals
 *   active  = data.recentAlerts (unresolved alerts currently active)
 *   records = total recent alert rows + pending approvals (audit proxy)
 */

import { Loader2 } from "lucide-react";

export interface VpCounts {
  pending: number;
  active: number;
  records: number;
}

export interface VpStatusBarProps {
  counts: VpCounts | null;
  lastScan: string | null;
  refreshing: boolean;
}

export function VpStatusBar({ counts, lastScan, refreshing }: VpStatusBarProps) {
  const pending = counts?.pending ?? 0;
  const active = counts?.active ?? 0;
  const records = counts?.records ?? 0;

  return (
    <div
      className="surface-card flex items-center gap-3 px-4 py-1.5 bg-bg-base/90 backdrop-blur-sm text-xs font-mono min-w-0"
      role="status"
      aria-live="polite"
    >
      <span className="inline-flex items-center gap-1.5 shrink-0">
        <span className="relative flex h-2 w-2">
          <span
            className={`absolute inline-flex h-full w-full rounded-full ${
              refreshing ? "animate-ping bg-emerald-400/60" : "bg-action-success"
            } opacity-75`}
          />
          <span className="relative inline-flex h-2 w-2 rounded-full bg-action-success" />
        </span>
        <span className="text-text-secondary font-semibold">Vice Principal</span>
      </span>

      <span className="flex items-center gap-3 flex-wrap min-w-0">
        <span className="text-text-secondary">
          <span className="text-action-info font-bold">{pending}</span> pending
        </span>
        <span className="text-text-secondary">
          <span className="text-action-warning font-bold">{active}</span> active
        </span>
        <span className="text-text-secondary">
          <span className="text-action-success font-bold">{records}</span> records
        </span>
      </span>

      <span className="ml-auto flex items-center gap-1.5 shrink-0 text-text-muted">
        {refreshing ? (
          <Loader2 className="size-3.5 animate-spin" />
        ) : (
          <span className="text-xs">
            {lastScan ? `scan ${new Date(lastScan).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}` : "no data"}
          </span>
        )}
      </span>
    </div>
  );
}

export default VpStatusBar;
</file>

<file path="src/components/approver/wardenConsoleModels.tsx">
"use client";

/**
 * wardenConsoleModels — standardized EntityInspection builders for the
 * warden / hostel / mess / VP consoles (PR-05E).
 *
 * Design rule: every meaningful record in these consoles goes through the
 * shared EntityInspector. The builders here produce the `EntityInspection`
 * models for the entity kinds used by the hostel / deputy-warden / mess /
 * vice-principal record surfaces:
 *
 *   - permission ticket (rows in outpass / leave / delegated queues)
 *   - hostel block (occupancy)
 *   - gate (presence-matrix movement)
 *   - incident / alert
 *   - shift handover
 *   - menu + stock item (mess)
 *   - meal day (consumption / attendance)
 *   - mess operational request
 *   - academic department + exception (VP)
 *   - VP escalation / decision
 *
 * Actions in the models are only links to routes these roles can actually
 * call (no invented actions): ticket detail via /api/permissions/[ticket],
 * alert resolve via PATCH /api/alerts/[id] (roles in the allow-list keep
 * their existing in-page buttons), and navigation CTAs to the deepest
 * layer (the existing consoles).
 */

import {
  KVPairs,
  Timeline,
  ActionRow,
  InspectorButton,
  type EntityInspection,
  type InspectionSection,
} from "@/components/shared/EntityInspector";
import type { PermissionItem } from "@/components/approver/PermissionRow";
import { formatDateTime } from "@/lib/utils";

/* ── small shared status badge (kept local so the console files don't
     pull in a Badge dependency graph) ─────────────────────────────────── */

function StatusBadge({ text, tone }: { text: string; tone?: "ok" | "warn" | "danger" | "neutral" }) {
  const cls: Record<string, string> = {
    ok: "bg-emerald-500/10 text-action-success border border-emerald-500/20",
    warn: "bg-amber-500/10 text-action-warning border border-amber-500/20",
    danger: "bg-rose-500/10 text-action-danger border border-rose-500/20",
    neutral: "bg-bg-elevated text-text-muted border border-border",
  };
  const t = tone ?? "neutral";
  return (
    <span className={`px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase ${cls[t]}`}>
      {text}
    </span>
  );
}

/* ── helpers ───────────────────────────────────────────────────────────── */

function fmtLocal(iso: string | null | undefined): string {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleString("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return iso;
  }
}

/* ── permission ticket (outpass / leave / delegated / OIE queues) ─────── */

/** The shape KanbanBoard hands back on select — a flattened permission row. */
export interface HMBoardRow {
  id: string;
  roll: string | null;
  name: string | null;
  person_type: string | null;
  direction: string;
  reason: string | null;
  gate_id: string | null;
  gate_name: string | null;
  timestamp: string;
  scan_type: string | null;
  is_correction: boolean | null;
  created_at?: string | null;
}

/**
 * Build an inspection for a permission-ticket row (outpass / hostel /
 * exam / memo queues). Sections: overview → stage history (collapsible)
 * → actions (CTAs only: open the ticket in the deepest layer, the
 * existing consoles that already run the real routes).
 */
export function boardRowTicketInspection(
  row: HMBoardRow,
  opts?: { consoleHref?: string; consoleLabel?: string },
): EntityInspection {
  const status = /pending/i.test(row.direction) ? "PENDING" : row.direction;
  return {
    kind: "permission ticket",
    title: row.name ?? row.roll ?? row.id,
    subtitle: row.roll ? `${row.id} · ${row.roll}` : row.id,
    status: (
      <StatusBadge
        text={status}
        tone={/pending/i.test(status) ? "warn" : /approved|completed/i.test(status) ? "ok" : "danger"}
      />
    ),
    sections: [
      {
        title: "Overview",
        content: (
          <KVPairs
            items={[
              { label: "Ticket", value: row.id },
              { label: "Workflow", value: (row.scan_type ?? "").replace(/_/g, " ") || "—" },
              { label: "Person", value: row.name ?? "—" },
              { label: "Roll", value: row.roll ?? "—" },
              { label: "Status", value: row.direction },
              ...(row.reason ? [{ label: "Reason", value: row.reason }] : []),
              { label: "Recorded", value: fmtLocal(row.timestamp) },
            ]}
          />
        ),
      },
      {
        title: "Actions",
        content: (
          <ActionRow>
            <InspectorButton
              href={`/permissions/${encodeURIComponent(row.id)}`}
              variant="primary"
            >
              Open ticket detail
            </InspectorButton>
            <InspectorButton href={opts?.consoleHref ?? "/"} variant="ghost">
              {opts?.consoleLabel ?? "Back to console"}
            </InspectorButton>
          </ActionRow>
        ),
      },
    ],
    detailHref: opts?.consoleHref ?? `/permissions/${encodeURIComponent(row.id)}`,
    detailLabel: opts?.consoleLabel ?? "Queue",
  };
}

export function ticketRowInspection(
  t: Pick<
    PermissionItem,
    | "ticket_number"
    | "workflow_type"
    | "status"
    | "current_stage"
    | "reason"
    | "created_at"
    | "updated_at"
    | "sla_deadline"
    | "stage_history"
    | "student"
  >,
  opts?: { detailHref?: string; detailLabel?: string; consoleLabel?: string },
): EntityInspection {
  const statusTone: "ok" | "warn" | "danger" | "neutral" =
    t.status === "APPROVED" || t.status === "COMPLETED"
      ? "ok"
      : t.status === "REJECTED" || t.status === "CANCELLED"
        ? "danger"
        : t.status === "ESCALATED"
          ? "warn"
          : "warn";

  const roll = t.student?.student_details?.roll;
  const historyItems = (t.stage_history ?? [])
    .filter((h) => h.actorName || h.action)
    .map((h) => ({
      label: `${h.actorName ?? "System"} ${h.action.toLowerCase()}${h.toStage ? ` → ${h.toStage}` : ""}`,
      time: h.timestamp ? formatDateTime(h.timestamp) : undefined,
      detail: h.comment ?? undefined,
      tone: (h.action === "FORWARDED" || h.action === "ESCALATED" ? "warn" : "neutral") as
        | "warn"
        | "neutral",
    }));

  const sections: InspectionSection[] = [
    {
      title: "Overview",
      content: (
        <KVPairs
          items={[
            { label: "Workflow", value: String(t.workflow_type ?? "").replace(/_/g, " ") || "—" },
            { label: "Current stage", value: (t.current_stage ?? "").replace(/_/g, " ") || "—" },
            { label: "Student", value: t.student?.name ?? "—" },
            { label: "Roll", value: roll ?? "—" },
            { label: "Reason", value: t.reason ?? "—" },
            { label: "Created", value: fmtLocal(t.created_at) },
            {
              label: "SLA deadline",
              value: t.sla_deadline ? (
                new Date(t.sla_deadline).getTime() < Date.now() ? (
                  <span className="text-action-danger font-semibold">Breached · {fmtLocal(t.sla_deadline)}</span>
                ) : (
                  fmtLocal(t.sla_deadline)
                )
              ) : (
                "—"
              ),
            },
          ]}
        />
      ),
    },
  ];

  if (historyItems.length > 0) {
    sections.push({
      title: "Stage history",
      collapsible: true,
      content: <Timeline items={historyItems} />,
    });
  }

  sections.push({
    title: "Actions",
    content: (
      <ActionRow>
        <InspectorButton
          href={`/permissions/${encodeURIComponent(t.ticket_number)}`}
          variant="primary"
        >
          Open ticket detail
        </InspectorButton>
        <InspectorButton
          href={opts?.detailHref ?? "/"}
          variant="ghost"
        >
          {opts?.consoleLabel ?? "Back to console"}
        </InspectorButton>
      </ActionRow>
    ),
  });

  return {
    kind: "permission ticket",
    title: t.student?.name ?? t.ticket_number,
    subtitle: `${t.ticket_number} · ${String(t.workflow_type ?? "").replace(/_/g, " ")}`,
    status: <StatusBadge text={t.status} tone={statusTone} />,
    sections,
    detailHref: opts?.detailHref ?? `/permissions/${encodeURIComponent(t.ticket_number)}`,
    detailLabel: opts?.detailLabel ?? "Full ticket detail",
  };
}

/* ── hostel block (occupancy) ──────────────────────────────────────────── */

export interface HostelBlockOccupancy {
  block: string;
  total: number;
  occupied: number;
}

export function hostelBlockInspection(b: HostelBlockOccupancy): EntityInspection {
  const pct = b.total > 0 ? Math.round((b.occupied / b.total) * 100) : 0;
  const tone: "ok" | "warn" | "danger" = pct >= 95 ? "danger" : pct >= 80 ? "warn" : "ok";
  return {
    kind: "hostel_block",
    title: `Block ${b.block}`,
    subtitle: `occupancy ${pct}%`,
    status: <StatusBadge text={`${b.occupied}/${b.total} occupied`} tone={tone} />,
    sections: [
      {
        title: "Overview",
        content: (
          <KVPairs
            items={[
              { label: "Block", value: b.block },
              { label: "Allocated", value: String(b.total) },
              { label: "Currently in", value: String(b.occupied) },
              {
                label: "Occupancy",
                value: `${pct}%`,
              },
            ]}
          />
        ),
      },
      {
        title: "Context",
        content: (
          <p className="text-xs text-text-muted">
            Block occupancy aggregates campus-occupancy (IN) headcount per
            hostel block. Room-level and resident-level detail is exposed
            in the admin student roster.
          </p>
        ),
      },
      {
        title: "Actions",
        content: (
          <ActionRow>
            <InspectorButton href="/admin/students" variant="ghost">
              Open student roster
            </InspectorButton>
          </ActionRow>
        ),
      },
    ],
    detailHref: "/admin/students",
    detailLabel: "Student roster",
  };
}

