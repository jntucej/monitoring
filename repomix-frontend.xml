<file path="src/components/principal/hostels/HostelCurfew.tsx">
"use client";

import { Clock, Home, Moon } from "lucide-react";
import { PrincipalWidgetBoundary } from "@/components/principal/shared/PrincipalWidgetBoundary";
import { usePolling } from "@/hooks/usePolling";
import { useState } from "react";
import { Skeleton } from "@/components/ui/skeleton";

export interface CurfewRow {
  ticket_number: string;
  name: string;
  roll: string;
  to_date: string;
  minutes: number;
}

export interface ReturnsTimelineData {
  upcoming: CurfewRow[];
  overdue: CurfewRow[];
  summary: { upcomingCount: number; overdueCount: number };
}

function fmtMinutes(min: number): string {
  if (min < 60) return `${Math.round(min)}m`;
  return `${Math.floor(min / 60)}h ${Math.round(min % 60)}m`;
}

/**
 * HostelCurfewRow — single row showing a student's return status.
 */
export function HostelCurfewRow({ row, overdue }: { row: CurfewRow; overdue: boolean }) {
  return (
    <li
      className={`flex items-center gap-2 p-2.5 rounded-lg text-xs ${
        overdue
          ? "bg-rose-500/10 border border-rose-500/20"
          : "bg-bg-elevated border border-border"
      }`}
    >
      {overdue ? (
        <Clock className="w-3.5 h-3.5 text-action-danger shrink-0" />
      ) : (
        <Home className="w-3.5 h-3.5 text-action-success shrink-0" />
      )}
      <span className="font-mono text-text-primary shrink-0">{row.ticket_number}</span>
      <span className="text-text-primary truncate flex-1">{row.name}</span>
      <span className="text-text-muted shrink-0">({row.roll})</span>
      <span
        className={`text-xs font-semibold shrink-0 ${
          overdue ? "text-action-danger" : "text-action-success"
        }`}
      >
        {overdue ? `Overdue ${fmtMinutes(row.minutes)}` : `Back in ${fmtMinutes(row.minutes)}`}
      </span>
    </li>
  );
}

/**
 * HostelCurfew — hostel curfew / returns-timeline board.
 * Fetches /api/hostel/returns-timeline.
 */
export function HostelCurfew() {
  const [data, setData] = useState<ReturnsTimelineData | null>(null);
  const [error, setError] = useState<string | null>(null);

  usePolling(
    async () => {
      try {
        const res = await fetch("/api/hostel/returns-timeline");
        const json = await res.json();
        if (json.success) {
          setData(json.data as ReturnsTimelineData);
        }
        setError(null);
      } catch (e) {
        setError(e instanceof Error ? e.message : "Failed to load");
      }
    },
    { intervalMs: 30_000 },
  );

  return (
    <PrincipalWidgetBoundary title="Hostel Curfew & Returns">
      <div className="surface-card bg-bg-surface p-4 sm:p-5">
        <div className="flex items-center gap-2 text-text-muted mb-3">
          <Moon className="w-4 h-4 text-violet-400" />
          <span className="text-xs font-semibold uppercase tracking-wide">
            Students expected back / overdue
          </span>
        </div>

        {error && <p className="text-xs text-action-danger mb-2">{error}</p>}

        {!data && !error && (
          <div className="space-y-2">
            {[0, 1].map((i) => <Skeleton key={i} className="h-12 w-full" />)}
          </div>
        )}

        {data && (
          <div className="space-y-4">
            <div>
              <h3 className="text-xs font-semibold uppercase tracking-wide text-action-danger mb-2">
                Overdue ({data.summary.overdueCount})
              </h3>
              {data.overdue.length === 0 ? (
                <p className="text-xs text-action-success py-1">All returns on time.</p>
              ) : (
                <ul className="space-y-1.5">
                  {data.overdue.slice(0, 10).map((r) => (
                    <HostelCurfewRow key={r.ticket_number} row={r} overdue />
                  ))}
                </ul>
              )}
            </div>

            <div>
              <h3 className="text-xs font-semibold uppercase tracking-wide text-action-success mb-2">
                Due Back Soon ({data.summary.upcomingCount})
              </h3>
              {data.upcoming.length === 0 ? (
                <p className="text-xs text-text-muted py-1">No returns scheduled in the next 6 hours.</p>
              ) : (
                <ul className="space-y-1.5">
                  {data.upcoming.slice(0, 10).map((r) => (
                    <HostelCurfewRow key={r.ticket_number} row={r} overdue={false} />
                  ))}
                </ul>
              )}
            </div>
          </div>
        )}
      </div>
    </PrincipalWidgetBoundary>
  );
}
</file>

<file path="src/components/principal/hostels/HostelOverview.tsx">
"use client";

import { Building2 } from "lucide-react";
import { PrincipalWidgetBoundary } from "@/components/principal/shared/PrincipalWidgetBoundary";
import { usePolling } from "@/hooks/usePolling";
import { useAuthStore } from "@/stores/authStore";
import { useState } from "react";
import { Skeleton } from "@/components/ui/skeleton";

export interface HostelBlock {
  block: string;
  total: number;
  occupied: number;
}

export interface HostelOverviewData {
  blocks: HostelBlock[];
  summary: { total: number; occupied: number; available: number };
}

/**
 * HostelBlockCard — displays a single hostel block occupancy card.
 */
export function HostelBlockCard({ block }: { block: HostelBlock }) {
  const pct = block.total > 0 ? Math.round((block.occupied / block.total) * 100) : 0;
  return (
    <div className="surface-card bg-bg-surface p-3">
      <div className="flex items-center justify-between mb-2">
        <span className="font-semibold text-sm">{block.block}</span>
        <span className="text-xs text-text-muted">
          {block.occupied}/{block.total}
        </span>
      </div>
      <div className="w-full h-1.5 bg-bg-elevated rounded-full overflow-hidden">
        <div
          className="h-full bg-action-primary rounded-full transition-all"
          style={{ width: `${pct}%` }}
        />
      </div>
    </div>
  );
}

/**
 * HostelBlockDrilldown — shows students in a specific block (optional).
 * Uses /api/hostel/blocks/[block]/students endpoint.
 */
export function HostelBlockDrilldown({ block }: { block: string }) {
  const [students, setStudents] = useState<{ roll: string; name: string }[] | null>(null);
  const [loading, setLoading] = useState(false);

  useAuthStore();
  usePolling(
    async () => {
      setLoading(true);
      try {
        const res = await fetch(`/api/hostel/blocks/${encodeURIComponent(block)}/students`);
        const json = await res.json();
        if (json.success && Array.isArray(json.data)) {
          setStudents(json.data);
        }
      } catch {
        // ignore
      } finally {
        setLoading(false);
      }
    },
    { intervalMs: 60_000 },
  );

  if (loading && !students) {
    return <Skeleton className="h-20 w-full" />;
  }

  if (!students || students.length === 0) {
    return <p className="text-xs text-text-muted py-2">No students found for this block.</p>;
  }

  return (
    <ul className="space-y-1 mt-2">
      {students.slice(0, 20).map((s) => (
        <li key={s.roll} className="text-xs text-text-secondary flex justify-between">
          <span>{s.name}</span>
          <span className="font-mono text-text-muted">{s.roll}</span>
        </li>
      ))}
    </ul>
  );
}

/**
 * HostelOverview — occupancy summary + per-block cards.
 * Fetches /api/hostel/blocks.
 */
export function HostelOverview() {
  const [data, setData] = useState<HostelOverviewData | null>(null);
  const [error, setError] = useState<string | null>(null);

  const [expandedBlock, setExpandedBlock] = useState<string | null>(null);

  usePolling(
    async () => {
      try {
        const res = await fetch("/api/hostel/blocks");
        const json = await res.json();
        if (json.success) {
          const blocks: HostelBlock[] = json.data?.blocks ?? [];
          const summary = {
            total: blocks.reduce((s, b) => s + b.total, 0),
            occupied: blocks.reduce((s, b) => s + b.occupied, 0),
            available: blocks.reduce((s, b) => s + b.total - b.occupied, 0),
          };
          setData({ blocks, summary });
        }
        setError(null);
      } catch (e) {
        setError(e instanceof Error ? e.message : "Failed to load");
      }
    },
    { intervalMs: 60_000 },
  );

  return (
    <PrincipalWidgetBoundary title="Hostel Overview">
      <div className="surface-card bg-bg-surface p-4 sm:p-5">
        <div className="flex items-center gap-2 text-text-muted mb-3">
          <Building2 className="w-4 h-4 text-action-primary" />
          <span className="text-xs font-semibold uppercase tracking-wide">Hostel Occupancy</span>
        </div>

        {error && (
          <p className="text-xs text-action-danger mb-2">{error}</p>
        )}

        {!data && !error && (
          <div className="space-y-2">
            {[0, 1, 2].map((i) => <Skeleton key={i} className="h-12 w-full" />)}
          </div>
        )}

        {data && (
          <>
            <div className="grid grid-cols-3 gap-3 mb-4">
              <div className="text-center">
                <div className="text-2xl font-bold text-text-primary">{data.summary.total}</div>
                <div className="text-xs text-text-muted uppercase">Total</div>
              </div>
              <div className="text-center">
                <div className="text-2xl font-bold text-action-success">{data.summary.occupied}</div>
                <div className="text-xs text-text-muted uppercase">Occupied</div>
              </div>
              <div className="text-center">
                <div className="text-2xl font-bold text-action-primary">{data.summary.available}</div>
                <div className="text-xs text-text-muted uppercase">Available</div>
              </div>
            </div>

            <div className="space-y-2">
              {data.blocks.length === 0 ? (
                <p className="text-xs text-text-muted py-2">No block data available.</p>
              ) : (
                data.blocks.map((b) => (
                  <div key={b.block}>
                    <HostelBlockCard block={b} />
                    {expandedBlock === b.block && <HostelBlockDrilldown block={b.block} />}
                    <button
                      type="button"
                      onClick={() => setExpandedBlock(expandedBlock === b.block ? null : b.block)}
                      className="text-xs text-action-primary hover:underline mt-1"
                    >
                      {expandedBlock === b.block ? "Hide" : "View students"}
                    </button>
                  </div>
                ))
              )}
            </div>
          </>
        )}
      </div>
    </PrincipalWidgetBoundary>
  );
}
</file>

