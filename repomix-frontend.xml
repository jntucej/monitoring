"use client";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { RoleAnalytics } from "@/components/retention/RoleAnalytics";
import Link from "next/link";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { ShieldCheck, AlertTriangle, ArrowRight, FileBarChart } from "lucide-react";

/* response shapes */

interface DataResponse {
  success: boolean;
  data: unknown;
  total?: number;
}

function ExamSuperintendentReportsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "exam_superintendent") as Role;
  const tier = getRoleTier(role);

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<DataResponse>("/api/permissions?workflow_type=exam", { ttlMs: 30_000 });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const allExam: unknown[] = Array.isArray((data as DataResponse | null)?.data)
    ? ((data as DataResponse | null)?.data as unknown[])
    : [];

  /* Simple outcome breakdown */
  const byStatus: Record<string, number> = {};
  for (const row of allExam as Array<Record<string, unknown>>) {
    const s = String(row.status ?? "PENDING");
    byStatus[s] = (byStatus[s] ?? 0) + 1;
  }
  const approved = byStatus.APPROVED ?? 0;
  const pending = byStatus.PENDING ?? 0;
  const rejected = byStatus.REJECTED ?? 0;
  const escalated = byStatus.ESCALATED ?? 0;
  const total = allExam.length;
  const approvalRate = total > 0 ? Math.round((approved / total) * 100) : 0;

  return (
    <div className="mx-auto max-w-7xl space-y-6 px-4 py-6 md:px-6 min-w-0">
      {/* Back link */}
      <Link
        href="/exam/superintendent"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Overview
      </Link>

      {/* Page toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Exam Superintendent"
        purpose="Generate hall occupancy summaries, invigilator duty reports, and session debriefs."
        contextLabel="Superintendent Reports"
        statusTone="info"
        statusSummary="Export session summary metrics, room audit counts, and student attendance logs."
        primaryAction={{ label: "Today Overview", href: "/exam/superintendent/home" }}
        secondaryActions={[
          { label: "Access Desk", href: "/exam/superintendent" },
          { label: "Exam Schedule", href: "/exam/superintendent/schedule" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">Reports data unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      <WidgetBoundary title="Exam Reports">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <FileBarChart className="w-4 h-4 text-action-success shrink-0" />
              <span className="text-sm font-semibold text-white">Examination Reports & Analytics</span>
            </div>
            <span className="text-xs text-text-muted shrink-0">{total} exam record(s)</span>
          </div>

          {/* Outcome breakdown */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 p-4 min-w-0">
            {busy ? (
              Array.from({ length: 4 }).map((_, i) => (
                <div key={i} className="h-14 animate-pulse rounded-lg bg-bg-elevated/40" />
              ))
            ) : (
              <>
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Approval Rate</p>
                  <p className="mt-1 text-lg font-bold text-action-success">{approvalRate}%</p>
                  <p className="text-xs text-text-muted">{approved} approved of {total}</p>
                </div>
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Pending</p>
                  <p className="mt-1 text-lg font-bold text-action-info">{pending}</p>
                  <p className="text-xs text-text-muted">Awaiting clearance</p>
                </div>
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Escalated</p>
                  <p className="mt-1 text-lg font-bold text-action-warning">{escalated}</p>
                  <p className="text-xs text-text-muted">Held for review</p>
                </div>
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted uppercase tracking-wide">Rejected</p>
                  <p className="mt-1 text-lg font-bold text-action-danger">{rejected}</p>
                  <p className="text-xs text-text-muted">Denied clearances</p>
                </div>
              </>
            )}
          </div>

          {/* Data availability note */}
          <div className="px-4 pb-4 min-w-0">
            <p className="text-xs text-text-muted flex items-center gap-2">
              <ShieldCheck className="w-3.5 h-3.5 text-text-muted shrink-0" />
              Outcome counts derived from the live exam workflow queue; auto-refreshes every 30 seconds.
            </p>
          </div>
        </div>
      </WidgetBoundary>

      {/* Role-scoped analytics (exam_superintendent fallback view) */}
      <RoleAnalytics />

    </div>
  );
}

export default function ExamSuperintendentReportsPage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <ExamSuperintendentReportsInner />
    </Suspense>
  );
}
