/**
 * usePeriod — hook that holds a Period and exposes setPeriod + helpers.
 * Pair with <PeriodPicker /> for the UI.
 */
"use client";

import { useCallback, useMemo, useState } from "react";
import { getPeriod, type Period, type PeriodKey } from "@/lib/period";

export interface UsePeriodResult {
  period: Period;
  setPeriod: (p: Period) => void;
  setPeriodKey: (key: PeriodKey) => void;
  /** ISO range strings ready to pass to API query params. */
  range: { from: string; to: string };
}

export function usePeriod(initialKey: PeriodKey = "this-month"): UsePeriodResult {
  const [period, setPeriod] = useState<Period>(() => getPeriod(initialKey));

  const setPeriodKey = useCallback((key: PeriodKey) => {
    setPeriod(getPeriod(key));
  }, []);

  const range = useMemo(() => ({ from: period.from, to: period.to }), [period]);

  return { period, setPeriod, setPeriodKey, range };
}

export default usePeriod;
</file>

<file path="src/hooks/usePersistentQuery.ts">
"use client";
// src/hooks/usePersistentQuery.ts
//
// Persists a filter/search query to sessionStorage so it survives
// offline reloads. The user types "attendance" in a filter, goes
// offline, the page reloads from cache — the filter is still there.
//
// Usage:
//   const [query, setQuery] = usePersistentQuery("gate-admin-students-query");

import { useEffect, useState } from "react";

export function usePersistentQuery(storageKey: string): [string, (v: string) => void] {
  const [query, setQuery] = useState("");
  const [restored, setRestored] = useState(false);

  // Restore on mount (first render only)
  useEffect(() => {
    try {
      const saved = sessionStorage.getItem(storageKey);
      if (saved) setQuery(saved);
      setRestored(true);
    } catch {
      setRestored(true);
    }
  }, [storageKey]);

  // Save on change (skip the initial empty value to avoid clobbering)
  useEffect(() => {
    if (!restored) return;
    try {
      if (query) {
        sessionStorage.setItem(storageKey, query);
      } else {
        sessionStorage.removeItem(storageKey);
      }
    } catch {
      /* sessionStorage unavailable */
    }
  }, [query, restored, storageKey]);

  return [query, setQuery];
}
</file>

<file path="src/hooks/usePersona.ts">
/**
 * hooks/usePersona.ts — derive the current user's persona from auth store.
 *
 * Persona is derived in priority order:
 *   1. Explicit `user.persona` field (set by admin, highest priority)
 *   2. `user.currentEntryType` ("hosteller" / "day_scholar")
 *   3. Residence evidence: `user.hostelBlock` or `user.roomNumber` → hosteller
 *   4. Default: day_scholar
 *
 * No prop threading — every component calls `usePersona()` once.
 */

"use client";

import { useAuthStore } from "@/stores/authStore";
import type { Persona } from "@/lib/pass-types";

/**
 * Read an arbitrary key off a User-shaped object without TypeScript complaining.
 * Casts through `unknown` to silence the index-signature check.
 */
function userField(user: unknown, key: string): unknown {
  return (user as Record<string, unknown> | null)?.[key];
}

export function usePersona(): Persona {
  const user = useAuthStore((s) => s.user);
  if (!user) return "day_scholar";

  // 1. Explicit persona field (future: populated by /api/me)
  const explicit = userField(user, "persona");
  if (explicit === "day_scholar" || explicit === "hosteller") return explicit;

  // 2. currentEntryType from student_details
  const entryType = userField(user, "currentEntryType");
  if (entryType === "hosteller" || entryType === "day_scholar") return entryType;

  // 3. Residence evidence
  const hostelBlock = userField(user, "hostelBlock");
  const roomNumber = userField(user, "roomNumber");
  if (hostelBlock || roomNumber) return "hosteller";

  // 4. Default
  return "day_scholar";
}

export default usePersona;
</file>

<file path="src/hooks/usePersonalization.ts">
// src/hooks/usePersonalization.ts
//
// usePersonalization() — L5: per-user memory and choices.
//
//   pinnedWidgets: string[]        — widgets the user pinned to home
//   widgetOrder: Record<string, string[]>  — custom order per surface
//   savedViews: SavedView[]        — named filter presets
//   recent: Record<string, string[]>  — recently viewed items
//   lastAction: { route: string; at: number }  — "pick up where you left"
//   dismissedNudges: string[]      — nudge IDs the user dismissed
//   streakDays: number             — daily login streak
//
// Persisted to localStorage per user ID. Syncs to the backend for
// saved views and pins (which the campus-extra/saved-views route
// already hints at).

import { useState, useEffect, useCallback } from "react";
import { useAuthStore } from "@/stores/authStore";

export interface SavedView {
  id: string;
  name: string;
  surface: string;
  filters: Record<string, string>;
  createdAt: number;
}

export interface LastAction {
  route: string;
  at: number;
}

interface PersonalizationState {
  pinnedWidgets: string[];
  widgetOrder: Record<string, string[]>;
  savedViews: SavedView[];
  recent: Record<string, string[]>;
  lastAction: LastAction | null;
  dismissedNudges: string[];
  streakDays: number;
  greetingStyle: "formal" | "warm";
}

const DEFAULT_STATE: PersonalizationState = {
  pinnedWidgets: [],
  widgetOrder: {},
  savedViews: [],
  recent: {},
  lastAction: null,
  dismissedNudges: [],
  streakDays: 0,
  greetingStyle: "warm",
};

function storageKey(userId: string) {
  return `personalization-${userId}`;
}

function loadState(userId: string): PersonalizationState {
  try {
    const raw = localStorage.getItem(storageKey(userId));
    if (raw) return { ...DEFAULT_STATE, ...JSON.parse(raw) };
  } catch { /* storage blocked */ }
  return { ...DEFAULT_STATE };
}

export function usePersonalization() {
  const userId = useAuthStore((s) => s.user?.id ?? "anon");
  const [state, setState] = useState<PersonalizationState>(() => loadState(userId));

  // Persist on change
  useEffect(() => {
    try {
      localStorage.setItem(storageKey(userId), JSON.stringify(state));
    } catch { /* storage blocked */ }
  }, [state, userId]);

  const pinWidget = useCallback((widgetId: string) => {
    setState((s) => ({
      ...s,
      pinnedWidgets: s.pinnedWidgets.includes(widgetId)
        ? s.pinnedWidgets
        : [...s.pinnedWidgets, widgetId],
    }));
  }, []);

  const unpinWidget = useCallback((widgetId: string) => {
    setState((s) => ({
      ...s,
      pinnedWidgets: s.pinnedWidgets.filter((id) => id !== widgetId),
    }));
  }, []);

  const setWidgetOrder = useCallback((surface: string, order: string[]) => {
    setState((s) => ({
      ...s,
      widgetOrder: { ...s.widgetOrder, [surface]: order },
    }));
  }, []);

  const addSavedView = useCallback((view: SavedView) => {
    setState((s) => ({
      ...s,
      savedViews: [...s.savedViews, view],
    }));
  }, []);

  const recordLastAction = useCallback((route: string) => {
    setState((s) => ({ ...s, lastAction: { route, at: Date.now() } }));
  }, []);

  const dismissNudge = useCallback((nudgeId: string) => {
    setState((s) => ({
      ...s,
      dismissedNudges: s.dismissedNudges.includes(nudgeId)
        ? s.dismissedNudges
        : [...s.dismissedNudges, nudgeId],
    }));
  }, []);

  const addRecent = useCallback((surface: string, itemId: string) => {
    setState((s) => {
      const existing = s.recent[surface] ?? [];
      const filtered = existing.filter((id) => id !== itemId);
      return {
        ...s,
        recent: {
          ...s.recent,
          [surface]: [itemId, ...filtered].slice(0, 10),
        },
      };
    });
  }, []);

  return {
    ...state,
    pinWidget,
    unpinWidget,
    setWidgetOrder,
    addSavedView,
    recordLastAction,
    dismissNudge,
    addRecent,
  };
}
</file>

<file path="src/hooks/usePolling.ts">
"use client";
// src/hooks/usePolling.ts — patched by scripts/dashboard-fixup.mjs
// Fixes A2 (stable fn via ref, visibility-aware, jitter on mount).

import { useEffect, useRef } from "react";

export function usePolling(
  fn: () => Promise<unknown> | void,
  { intervalMs = 30_000, enabled = true }: { intervalMs?: number; enabled?: boolean } = {},
) {
  // Keep the latest fn in a ref so callers can pass a fresh inline callback
  // (or a memo that re-creates on unrelated state) without restarting the
  // timer. An effect re-run here is NOT harmless: it fires an immediate
  // tick, so an unstable fn turned a "30s poll" into a burst of ~30
  // back-to-back requests and drove the server into 429 rate-limit storms
  // (see /api/admin/overview 429 incident, 2026-10-23). The effect now
  // restarts only when intervalMs/enabled actually change.
  const fnRef = useRef(fn);
  useEffect(() => {
    fnRef.current = fn;
  }, [fn]);

  useEffect(() => {
    if (!enabled) return;

    let cancelled = false;
    let timer: ReturnType<typeof setTimeout> | null = null;
    const tick = async () => {
      if (cancelled) return;
      try { await fnRef.current(); } catch { /* non-fatal */ }
      if (!cancelled) timer = setTimeout(tick, intervalMs);
    };

    const onVis = () => {
      if (document.visibilityState === "hidden") {
        if (timer) { clearTimeout(timer); timer = null; }
      } else if (!timer) {
        void tick();
      }
    };

    // Jittered first tick so mount doesn't collide with the sibling
    // useApiResource fetch that already fired on mount.
    const start = setTimeout(tick, 400 + Math.random() * 400);
    document.addEventListener("visibilitychange", onVis);

    return () => {
      cancelled = true;
      clearTimeout(start);
      if (timer) clearTimeout(timer);
      document.removeEventListener("visibilitychange", onVis);
    };
  }, [intervalMs, enabled]);
}
</file>

<file path="src/hooks/usePrincipalAction.ts">
"use client";

/**
 * usePrincipalAction — PR-10. The client-side ACTION EXECUTION MONITOR.
 *
 * Every consequential principal action (approve / reject / delegate / resolve)
 * runs through this lifecycle instead of a raw button that assumes success:
 *
 *   IDLE → VALIDATING → (CONFIRMATION) → SUBMITTING → PROCESSING
 *        → COMPLETED | FAILED | PARTIAL | UNKNOWN
 *        → REVALIDATION
 *
 * Data-integrity rules (protocol §12.3, §2.5):
 *  - The SERVER is the authority. This hook only reports what the server says.
 *  - A network failure AFTER the server may have processed the action is
 *    reported as UNKNOWN, never as FAILED — the caller offers a safe
 *    refresh/verify path, not a blind retry.
 *  - Duplicate submission is locked while in flight (one in-flight per action).
 *  - The transport is the established client fetch + getAuthHeaders(); no new
 *    fetch system is introduced.
 */
import { useCallback, useRef, useState } from "react";
import { getAuthHeaders } from "@/lib/utils";
import type { PrincipalActionDefinition } from "@/lib/principal/contracts";

/** The execution lifecycle state machine (closed set). */
export type ActionExecutionState =
  | "idle"
  | "validating"
  | "submitting"
  | "processing"
  | "completed"
  | "failed"
  | "partial"
  | "unknown";

export interface ActionResult<T> {
  state: ActionExecutionState;
  /** The authoritative server payload, when the outcome is known. */
  data?: T;
  /** Human-readable failure reason (never a fabricated success). */
  error?: string;
  /** true when the outcome can't be confirmed (network lost post-submit). */
  unknown?: boolean;
}

/**
 * Pure outcome classifier (exported for unit tests; `execute` delegates to it).
 * Encodes the honest-outcome rule: a non-parseable or thrown response after
 * the request was SENT is UNKNOWN (the server may have processed it), never
 * a clean FAILED.
 */
export function classifyOutcome<T>(
  httpOk: boolean,
  jsonParsed: boolean,
  json: T | null,
  httpStatus?: number,
): ActionResult<T> {
  if (httpOk && jsonParsed) return { state: "completed", data: json as T };
  if (jsonParsed && json) {
    const msg =
      (json as { error?: { message?: string } }).error?.message ??
      `request failed (${httpStatus ?? "unknown"})`;
    return { state: "failed", error: msg };
  }
  // Non-parseable body OR unknown transport state: cannot confirm.
  return {
    state: "unknown",
    unknown: true,
    error: `Could not confirm the outcome (HTTP ${httpStatus ?? "?"}). Refresh to verify before retrying.`,
  };
}

export interface UsePrincipalActionOptions<TInput, TOut> {
  /** The action being executed (drives confirmation + correlation). */
  action: PrincipalActionDefinition;
  /** Endpoint to POST to (the server enforces all authorization). */
  endpoint: string;
  /** Build the JSON body. Validated client-side before submission. */
  buildBody: (input: TInput) => unknown;
  /** Client-side validation; return null when valid, an error string otherwise. */
  validate?: (input: TInput) => string | null;
  /** Confirm-before-execute (for consequential, possibly-irreversible actions). */
  confirmationRequired?: boolean;
  /** Called after a known outcome to revalidate dependent data. */
  onCompleted?: (data: TOut) => void;
  /** Called after a known failure. */
  onFailed?: (error: string) => void;
}

export interface UsePrincipalActionReturn<TInput, TOut> {
  /** Drive the lifecycle. Returns the authoritative result. */
  execute: (input: TInput) => Promise<ActionResult<TOut>>;
  /** The confirmation gate state (callers render a confirm dialog when true). */
  needsConfirmation: boolean;
  /** Reset to idle (e.g. after the user closes the workspace). */
  reset: () => void;
  inFlight: boolean;
  state: ActionExecutionState;
}

export function usePrincipalAction<TInput, TOut = unknown>(
  opts: UsePrincipalActionOptions<TInput, TOut>,
): UsePrincipalActionReturn<TInput, TOut> {
  const {
    action,
    endpoint,
    buildBody,
    validate,
    confirmationRequired = false,
    onCompleted,
    onFailed,
  } = opts;

  const [state, setState] = useState<ActionExecutionState>("idle");
  const [inFlight, setInFlight] = useState(false);
  // A lock prevents a second concurrent submit of the same action (duplicate
  // guard is also enforced server-side via withMutationGuard — defense in depth).
  const submitLock = useRef(false);
  // A consequential action needs a confirmation gate when the caller opts in,
  // or when the action definition declares it (e.g. an irreversible decision).
  const confirmNeeded = confirmationRequired || Boolean(action?.confirmationRequired);

  const reset = useCallback(() => {
    submitLock.current = false;
    setInFlight(false);
    setState("idle");
  }, []);

  const execute = useCallback(
    async (input: TInput): Promise<ActionResult<TOut>> => {
      // ── IDLE → VALIDATING ───────────────────────────────────────────
      setState("validating");
      const validationError = validate?.(input);
      if (validationError) {
        setState("idle");
        return { state: "failed", error: validationError };
      }

      // ── duplicate-submission guard ─────────────────────────────────
      if (submitLock.current) {
        return { state: "processing", error: "submission already in flight" };
      }
      submitLock.current = true;
      setInFlight(true);
      setState("submitting");

      // ── SUBMITTING → PROCESSING (server response is authoritative) ─
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", ...getAuthHeaders() },
          body: JSON.stringify(buildBody(input)),
        });

        let json: TOut | null = null;
        let jsonParsed = true;
        try {
          json = (await res.json()) as TOut;
        } catch {
          jsonParsed = false;
        }

        const outcome = classifyOutcome<TOut>(res.ok, jsonParsed, json, res.status);
        setState(outcome.state);
        if (outcome.state === "completed") {
          onCompleted?.(outcome.data as TOut);
        } else if (outcome.state === "failed") {
          onFailed?.(outcome.error ?? "action failed");
        }
        submitLock.current = false;
        setInFlight(false);
        return outcome;
      } catch {
        // Threw (network dropped / aborted) AFTER the request was sent:
        // the server may have processed it. UNKNOWN, never a blind FAILED.
        const outcome: ActionResult<TOut> = {
          state: "unknown",
          unknown: true,
          error:
            "Connection lost during submission. The action may have been recorded — refresh the record to verify before retrying.",
        };
        setState("unknown");
        submitLock.current = false;
        setInFlight(false);
        return outcome;
      }
    },
    [endpoint, buildBody, validate, onCompleted, onFailed],
  );

  return {
    execute,
    needsConfirmation: confirmNeeded,
    reset,
    inFlight,
    state,
  };
}
</file>

