<file path="src/app/support/page.tsx">
"use client";


import { useEffect, useState } from "react";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { LifeBuoy, Plus, Clock, Send, Loader2, HelpCircle } from "lucide-react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { HelpTip } from "@/components/ui/help-tip";

export default function UserSupportPage() {
  const { user, token } = useAuthStore();
  const currentSessionToken = user?.currentSessionToken || token;
  const { addToast } = useUIStore();

  const [tickets, setTickets] = useState<any[]>([]);
  const [showModal, setShowModal] = useState(false);
  const [category, setCategory] = useState("system_issue");
  const [priority, setPriority] = useState("medium");
  const [subject, setSubject] = useState("");
  const [description, setDescription] = useState("");

  // Direct developer message (any user / role)
  const [devMessage, setDevMessage] = useState("");
  const [devSending, setDevSending] = useState(false);

  const sendDevMessage = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!devMessage.trim()) return;
    setDevSending(true);
    try {
      const res = await fetch("/api/dev/contact", {
        method: "POST",
        headers: getHeaders(),
        body: JSON.stringify({ message: devMessage.trim(), channel: "support" }),
      });
      const result = await res.json();
      if (result.success) {
        addToast({
          variant: "success",
          title: "Sent",
          message: result.data?.delivered
            ? "Delivered to the developer via Telegram."
            : "Saved and shared with the developer.",
        });
        setDevMessage("");
      } else if (result.error?.code === "RATE_LIMITED") {
        addToast({ variant: "error", title: "Slow down", message: "You are sending messages too quickly. Try again in a few minutes." });
      } else {
        addToast({ variant: "error", title: "Failed", message: result.error?.message || "Could not send message." });
      }
    } catch {
      addToast({ variant: "error", title: "Failed", message: "Network error while sending." });
    } finally {
      setDevSending(false);
    }
  };

  const getHeaders = () => {
    const h: Record<string, string> = { "Content-Type": "application/json" };
    if (token) h["Authorization"] = `Bearer ${token}`;
    if (currentSessionToken) h["X-Session-Token"] = currentSessionToken;
    return h;
  };

  const fetchTickets = async () => {
    try {
      const res = await fetch("/api/support/tickets", { headers: getHeaders() });
      const data = await res.json();
      if (data.success) setTickets(data.data || []);
    } catch {}
  };

  useEffect(() => { fetchTickets(); }, []);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!subject.trim() || !description.trim()) return;

    try {
      const res = await fetch("/api/support/tickets", {
        method: "POST",
        headers: getHeaders(),
        body: JSON.stringify({ category, priority, subject, description }),
      });
      const result = await res.json();
      if (result.success) {
        addToast({ variant: "success", title: "Submitted", message: `Ticket #${result.data.ticket_number} created.` });
        setSubject(""); setDescription(""); setShowModal(false); fetchTickets();
      }
    } catch {}
  };

  return (
    <div className="max-w-4xl mx-auto p-4 sm:p-6 space-y-4 sm:space-y-6">
      <ContextSituationBar
        roleLabel={user?.role ? user.role.toUpperCase() : "Campus User"}
        purpose="Report turnstile or scanner issues, track support ticket progress, and contact engineering directly."
        contextLabel="Help Desk & Support"
        statusTone={tickets.some((t) => t.status === "open") ? "warn" : "ok"}
        statusPill={tickets.some((t) => t.status === "open") ? `${tickets.filter((t) => t.status === "open").length} Open Ticket(s)` : "All Resolved"}
        statusSummary={
          tickets.some((t) => t.status === "open")
            ? "You have open support tickets being investigated by the administrative or gate operations team."
            : "No active support issues. Raise a ticket or direct developer dispatch if you experience gate pass or hardware problems."
        }
        primaryAction={{
          label: showModal ? "Close Form" : "Raise Ticket",
          onClick: () => setShowModal(!showModal),
        }}
        secondaryAction={{ label: "Settings", href: "/settings" }}
      />

      <div className="flex justify-between items-center">
        <div>
          <p className="font-medium text-text-secondary mb-3">Help & Support</p>
          <p className="text-text-muted">Report gate issues or request support.</p>
        </div>
        <Button onClick={() => setShowModal(!showModal)} className="gap-2">
          <Plus className="w-4 h-4" /> {showModal ? "Cancel" : "Raise Ticket"}
        </Button>
      </div>

      {showModal && (
        <Card className="surface-card p-4 bg-bg-elevated dark:bg-bg-elevated/40">
          <form onSubmit={handleSubmit} className="space-y-4">
            <div className="flex items-center gap-2">
              <h3 className="font-semibold text-lg flex items-center gap-2"><LifeBuoy className="h-4 w-4 text-action-primary" /> New Support Request</h3>
              <HelpTip text="Tickets are dispatched directly to gate supervisors and administrative personnel." />
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <div className="flex items-center gap-1.5 mb-1">
                  <label className="text-xs text-text-muted">Issue Category</label>
                  <HelpTip text="Select gate access, ID scanning, pass questions, or platform bug." />
                </div>
                <select value={category} onChange={(e) => setCategory(e.target.value)} className="w-full p-2 text-sm text-text-primary">
                  <option value="gate_access">Gate Access Issue</option>
                  <option value="id_card">ID Card / Scanner</option>
                  <option value="pass_request">Pass Query</option>
                  <option value="system_issue">System Bug</option>
                </select>
              </div>
              <div>
                <div className="flex items-center gap-1.5 mb-1">
                  <label className="text-xs text-text-muted">Urgency Level</label>
                  <HelpTip text="High priority triggers faster supervisor triage." />
                </div>
                <select value={priority} onChange={(e) => setPriority(e.target.value)} className="w-full p-2 text-sm text-text-primary">
                  <option value="low">Low</option>
                  <option value="medium">Medium</option>
                  <option value="high">High</option>
                </select>
              </div>
            </div>
            <div>
              <label className="text-xs text-text-muted block mb-1">Subject</label>
              <input value={subject} onChange={(e) => setSubject(e.target.value)} required className="w-full p-2 text-sm text-text-primary" placeholder="Short description of the problem" />
            </div>
            <div>
              <label className="text-xs text-text-muted block mb-1">Details & Context</label>
              <textarea value={description} onChange={(e) => setDescription(e.target.value)} required rows={4} className="w-full p-2 text-sm text-text-primary" placeholder="Include gate number, approximate time, and what went wrong..." />
            </div>
            <div className="flex items-center gap-2">
              <Button type="submit" size="sm">Submit Ticket</Button>
              <p className="text-xs text-text-muted">Once submitted, tickets can be monitored in your ticket history below.</p>
            </div>
          </form>
        </Card>
      )}

      <Card className="surface-card p-4">
        <h3 className="font-semibold text-base flex items-center gap-2 mb-1">
          <Send className="w-4 h-4 text-action-success" /> Developer
        </h3>
        <p className="text-text-muted dark:text-text-muted mb-3">
          Suggestion, improvement, or anything that doesn&#39;t fit a ticket? Write it here.
          It goes straight to the developer with your name and role attached.
        </p>
        <form onSubmit={sendDevMessage} className="space-y-3">
          <textarea
            value={devMessage}
            onChange={(e) => setDevMessage(e.target.value)}
            rows={3}
            maxLength={2000}
            required
            className="w-full p-2 text-sm text-text-primary"
            placeholder="e.g. The gate page would load faster if…"
          />
          <div className="flex items-center gap-3">
            <Button type="submit" size="sm" disabled={devSending} className="gap-2">
              {devSending ? <Loader2 className="w-4 h-4 animate-spin" /> : <Send className="w-4 h-4" />}
              {devSending ? "Sending…" : "Send"}
            </Button>
            <span className="text-text-muted">{devMessage.length}/2000</span>
          </div>
        </form>
      </Card>

      <div className="space-y-4">
        {tickets.length === 0 ? (
          <Card className="surface-card p-8 text-center bg-bg-surface">
            <LifeBuoy className="h-4 w-4 text-text-muted mx-auto mb-2" />
            <h4 className="text-sm font-semibold text-text-primary">No support tickets</h4>
            <p className="text-xs text-text-muted mt-1 max-w-sm mx-auto">
              You haven&apos;t raised any tickets yet. If you run into gate access issues or scanning errors, click &ldquo;Raise Ticket&rdquo; above.
            </p>
          </Card>
        ) : (
          tickets.map((t) => (
            <Card key={t.id} className="surface-card p-4">
              <div className="flex justify-between items-start">
                <div>
                  <div className="flex items-center gap-2">
                    <span className="bg-bg-elevated dark:bg-bg-elevated px-2 py-0.5 font-bold text-xs">{t.ticket_number}</span>
                    <h3 className="font-semibold text-base">{t.subject}</h3>
                    <Badge variant={t.status === "open" ? "entry" : "success"} className="capitalize">{t.status}</Badge>
                  </div>
                  <p className="text-text-muted dark:text-text-secondary mt-1">{t.description}</p>
                  <div className="text-text-muted mt-2 flex items-center gap-2">
                    <Clock className="w-3.5 h-3.5" /> {new Date(t.created_at).toLocaleString()}
                  </div>
                </div>
              </div>
            </Card>
          ))
        )}
      </div>
    </div>
  );
}
