"use client";

import { useEffect, useState } from "react";
import { getAuthHeaders } from "@/lib/utils";

import { useUIStore } from "@/stores/uiStore";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

export default function AntiRaggingConfigPage() {
  const [config, setConfig] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const addToast = useUIStore((s) => s.addToast);

  useEffect(() => {
    (async () => {
      const r = await fetch("/api/admin/anti-ragging-alert-config", { headers: getAuthHeaders() });
      const j = await r.json();
      setConfig(j.data?.config ?? { enabled: true, email_roles: ["principal", "supervisor", "admin"], extra_emails: [], sms_roles: ["principal"] });
      setLoading(false);
    })();
  }, []);

  const save = async (e: React.FormEvent) => {
    e.preventDefault();
    const r = await fetch("/api/admin/anti-ragging-alert-config", {
      method: "PATCH",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify(config),
    });
    const j = await r.json();
    if (j.success) addToast({ variant: "success", message: "Saved successfully" });
    else           addToast({ variant: "error",   message: j.error?.message ?? "Failed" });
  };

  if (loading) return <p className="p-6 text-text-muted">Loading…</p>;

  return (
    <div className="max-w-3xl mx-auto p-4 sm:p-6 space-y-4 sm:space-y-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Manage and monitor anti ragging config for campus operations."
        why="Configurations here power the /student/anti-ragging reporting flow and OIE decisioning."
        contextLabel="Anti Ragging Config"
        statusSummary="Review current anti ragging config state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <h1 className="text-2xl font-semibold">Anti-Ragging Alert Configuration</h1>
      <form onSubmit={save} className="surface-card space-y-4 bg-white p-6">
        <label className="flex items-center gap-2">
          <input
            type="checkbox"
            checked={config.enabled}
            onChange={(e) => setConfig({ ...config, enabled: e.target.checked })}
          />
          <span className="font-medium text-sm">Enable anti-ragging email alerts</span>
        </label>
        <div>
          <label className="block text-sm font-medium text-text-muted mb-1" htmlFor="extra-email-addresses-comma-separated">Extra Email Addresses (comma separated)</label>
          <input id="extra-email-addresses-comma-separated"
            type="text"
            value={(config.extra_emails ?? []).join(", ")}
            onChange={(e) => setConfig({ ...config, extra_emails: e.target.value.split(",").map((s) => s.trim()).filter(Boolean) })}
            className="surface-card w-full p-2 text-sm"
          />
        </div>
        <button type="submit" className="surface-card px-4 py-2 bg-bg-surface text-white text-sm font-medium">
          Save Configuration
        </button>
      </form>
    </div>
  );
}
