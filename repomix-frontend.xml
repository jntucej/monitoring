<file path="src/app/bootstrap/page.tsx">
"use client";

import Link from "next/link";
import { Suspense, useCallback, useState, useEffect } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { KeyRound, Lock, User, CheckCircle2, AlertCircle, Loader2, ArrowRight } from "lucide-react";
import { HelpTip } from "@/components/ui/help-tip";

type BootstrapState = "idle" | "submitting" | "success" | "error";

function BootstrapPageInner() {
  const router = useRouter();
  const params = useSearchParams();
  const urlToken = (params?.get("t") ?? "").trim();
  const urlCode = (params?.get("code") ?? "").trim().toUpperCase();

  const [uniqueId, setUniqueId] = useState("");
  const [code, setCode] = useState(urlCode);
  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [state, setState] = useState<BootstrapState>("idle");
  const [error, setError] = useState<string | null>(null);
  const [idLocked, setIdLocked] = useState(false);

  // Pre-fill ID and code from the secure signed token when provided.
  useEffect(() => {
    if (urlToken) {
      const parts = urlToken.split(":");
      if (parts.length === 3) {
        const userId = parts[0];
        // Pre-fill the raw user ID; the API resolves it to the correct user.
        setUniqueId(userId);
        setIdLocked(true);
      }
      setCode("");
    } else if (urlCode && !code) {
      setCode(urlCode);
    }
  }, [urlToken, urlCode, code]);

  const submit = useCallback(
    async (e: React.FormEvent) => {
      e.preventDefault();
      setError(null);

      const cleanId = uniqueId.trim().toUpperCase();
      const cleanCode = code.trim().toUpperCase();

      if (!cleanCode && !urlToken) {
        setError("Please enter the activation code given by your administrator.");
        setState("error");
        return;
      }

      if (password.length < 8) {
        setError("Password must be at least 8 characters long.");
        setState("error");
        return;
      }

      if (password !== confirmPassword) {
        setError("Passwords do not match. Please re-enter.");
        setState("error");
        return;
      }

      setState("submitting");

      try {
        const body: Record<string, unknown> = {
          code: cleanCode || undefined,
          newPassword: password,
        };
        if (cleanId && !idLocked) {
          body.uniqueId = cleanId;
        }
        if (urlToken) {
          body.token = urlToken;
        }

        const res = await fetch("/api/auth/bootstrap", {
          method: "POST",
          credentials: "include",
          cache: "no-store",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });

        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) {
          const errCode = json?.error?.code ?? "UNKNOWN";
          const msg =
            json?.error?.message ??
            (errCode === "ALREADY_ONBOARDED"
              ? "This account has already completed setup. You can log in directly."
              : errCode === "INVALID_TOKEN"
                ? "This activation link is invalid or has expired. Ask your administrator for a new one."
                : "Invalid activation code or ID. Check your details and try again.");
          setError(msg);
          setState("error");
          return;
        }

        setState("success");
        setTimeout(() => router.replace("/login"), 1400);
      } catch {
        setError("Network connection error. Please try again.");
        setState("error");
      }
    },
    [code, confirmPassword, password, router, uniqueId, idLocked, urlToken]
  );

  return (
    <div className="min-h-[100dvh] flex items-center justify-center bg-bg-base p-4 sm:p-8 relative overflow-x-hidden">
      <div className="absolute top-1/2 left-1/4 -translate-y-1/2 h-8 w-8 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none" />
      <div className="w-full max-w-md space-y-5">
        <div className="text-center space-y-1.5">
          <div className="mx-auto flex size-8 items-center justify-center rounded-lg bg-emerald-500/10 text-action-success">
            <KeyRound className="size-4" />
          </div>
          <h1 className="text-2xl font-bold text-text-primary">Activate Your Account</h1>
          <p className="text-xs text-text-muted max-w-sm mx-auto">
            {urlToken
              ? "Follow your personalized activation link to set your password. Your ID is pre-filled and locked."
              : "Enter your university ID and the one-time activation code from your administrator to set your password."}
          </p>
          <ol className="flex flex-wrap items-center justify-center gap-1.5 pt-1 text-[11px] text-text-muted">
            <li className="font-medium text-text-primary">
              1. Verify ID &amp; Code
            </li>
            <span aria-hidden="true">→</span>
            <li className="font-medium text-text-primary">
              2. Set Password
            </li>
            <span aria-hidden="true">→</span>
            <li className="font-medium text-text-primary">
              3. Sign In
            </li>
          </ol>
        </div>

        <div className="surface-card bg-bg-surface p-6 sm:p-8 space-y-5">
          {error && (
            <div className="surface-card flex items-start gap-2.5 p-3.5 bg-rose-500/10 text-xs text-action-danger">
              <AlertCircle className="w-4 h-4 shrink-0 text-action-danger mt-0.5" />
              <span>{error}</span>
            </div>
          )}

          {state === "success" && (
            <div className="surface-card flex items-center gap-2.5 p-3.5 bg-emerald-500/10 text-xs text-action-success font-semibold">
              <CheckCircle2 className="w-4 h-4 shrink-0 text-action-success" />
              <span>Account activated successfully! Redirecting to login…</span>
            </div>
          )}

          <form onSubmit={submit} className="space-y-4">
            {/* Unique ID / Roll */}
            {!idLocked && (
              <div className="space-y-1">
                <div className="flex items-center gap-1.5">
                  <label className="text-xs font-semibold text-text-muted uppercase tracking-wide block" htmlFor="uniqueId">
                    ID / Roll Number *
                  </label>
                  <HelpTip
                    label="ID or roll number help"
                    align="left"
                    text="Enter the exact roll number or employee ID registered by your administrator. Letters are automatically uppercased."
                  />
                </div>
                <div className="relative">
                  <input
                    id="uniqueId"
                    type="text"
                    value={uniqueId}
                    onChange={(e) => setUniqueId(e.target.value.toUpperCase())}
                    placeholder="e.g. 24JJ1A0501 or EMP-001"
                    required
                    autoCapitalize="characters"
                    className="surface-card w-full bg-bg-base px-3.5 py-2.5 pl-10 text-sm text-text-primary placeholder:text-text-muted/50 focus:outline-none focus: font-medium uppercase"
                  />
                  <User className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" />
                </div>
              </div>
            )}

            {/* Locked ID (secure token) */}
            {idLocked && (
              <div className="space-y-1">
                <label className="text-xs font-semibold text-text-muted uppercase tracking-wide block" htmlFor="uniqueId-locked">
                  Your Account ID
                </label>
                <div className="relative">
                  <input
                    id="uniqueId-locked"
                    type="text"
                    value={uniqueId}
                    readOnly
                    className="surface-card w-full bg-bg-elevated px-3.5 py-2.5 pl-10 text-sm text-text-primary/60 font-medium cursor-not-allowed"
                  />
                  <User className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" />
                </div>
                <p className="text-xs text-emerald-400/70">Locked to your personalized activation link. You cannot change this.</p>
              </div>
            )}

            {/* Activation Code */}
            {!urlToken && (
              <div className="space-y-1">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-1.5">
                    <label className="text-xs font-semibold text-text-muted uppercase tracking-wide block" htmlFor="code">
                      Activation Code *
                    </label>
                    <HelpTip
                      label="Activation code help"
                      align="left"
                      text="One-time enrollment code issued by your department or campus administrator. If expired or lost, request a new code."
                    />
                  </div>
                  {urlCode && (
                    <span className="text-xs text-action-success font-medium">Pre-filled from link</span>
                  )}
                </div>
                <div className="relative">
                  <input
                    id="code"
                    type="text"
                    value={code}
                    onChange={(e) => setCode(e.target.value.toUpperCase())}
                    placeholder="e.g. ABCD1234"
                    required
                    maxLength={12}
                    className="surface-card w-full bg-bg-base px-3.5 py-2.5 pl-10 text-sm font-mono tracking-widest text-text-primary placeholder:text-text-muted/50 focus:outline-none focus: font-bold uppercase"
                  />
                  <KeyRound className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" />
                </div>
                <p className="text-[11px] text-text-muted">
                  One-time code from your administrator (up to 12 characters).
                </p>
              </div>
            )}

            {urlToken && (
              <div className="surface-card flex items-center gap-2 p-3 bg-emerald-500/10 text-xs text-action-success">
                <CheckCircle2 className="w-4 h-4 shrink-0 text-action-success" />
                <span>Secure activation link verified. Set your password below to finish.</span>
              </div>
            )}

            {/* New Password */}
            <div className="space-y-1">
              <label className="text-xs font-semibold text-text-muted uppercase tracking-wide block" htmlFor="password">
                New Password *
              </label>
              <div className="relative">
                <input
                  id="password"
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  required
                  minLength={8}
                  placeholder="At least 8 characters"
                  className="surface-card w-full bg-bg-base px-3.5 py-2.5 pl-10 text-sm text-text-primary placeholder:text-text-muted/50 focus:outline-none focus:"
                />
                <Lock className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" />
              </div>
              <p className="text-[11px] text-text-muted">
                Must be at least 8 characters. Avoid using your roll number or activation code.
              </p>
            </div>

            {/* Confirm Password */}
            <div className="space-y-1">
              <label className="text-xs font-semibold text-text-muted uppercase tracking-wide block" htmlFor="confirmPassword">
                Confirm Password *
              </label>
              <div className="relative">
                <input
                  id="confirmPassword"
                  type="password"
                  value={confirmPassword}
                  onChange={(e) => setConfirmPassword(e.target.value)}
                  required
                  minLength={8}
                  placeholder="Re-enter your password"
                  className="surface-card w-full bg-bg-base px-3.5 py-2.5 pl-10 text-sm text-text-primary placeholder:text-text-muted/50 focus:outline-none focus:"
                />
                <Lock className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" />
              </div>
              {confirmPassword.length > 0 && password !== confirmPassword && (
                <p className="text-[11px] text-action-danger">Passwords do not match yet.</p>
              )}
            </div>

            <div className="space-y-1.5">
              <button
                type="submit"
                disabled={state === "submitting" || state === "success"}
                className="surface-card w-full bg-action-success hover:bg-action-success text-white font-bold text-sm transition-all disabled:opacity-50 py-3 flex items-center justify-center gap-2 active:scale-95 mt-2"
              >
                {state === "submitting" ? (
                  <>
                    <Loader2 className="w-4 h-4 animate-spin" />
                    <span>Activating Account…</span>
                  </>
                ) : (
                  <>
                    <span>Activate Account</span>
                    <ArrowRight className="w-4 h-4" />
                  </>
                )}
              </button>
              <p className="text-center text-[11px] text-text-muted">
                Once activated, you&apos;ll be redirected to sign in with your new password.
              </p>
            </div>
          </form>

          <div className="surface-card pt-2 text-center">
            <p className="text-xs text-text-muted">
              Already activated your account?{" "}
              <Link href="/login" className="text-action-success hover:underline font-semibold">
                Sign in here
              </Link>
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}

export default function BootstrapPage() {
  return (
    <Suspense
      fallback={
        <div className="min-h-dvh flex items-center justify-center text-text-muted text-xs">
          Loading…
        </div>
      }
    >
      <BootstrapPageInner />
    </Suspense>
  );
}
</file>

