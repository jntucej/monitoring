<file path="src/app/(approver)/guardian/contact-info/page.tsx">
"use client";

import { Suspense, useEffect, useState } from "react";

import { PageLoading } from "@/components/shared/LoadingStates";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { useAuthStore } from "@/stores/authStore";
import { useApiResource } from "@/hooks/useApiResource";
import { getAuthHeaders } from "@/lib/utils";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { RoleProfileSettingsPanel } from "@/components/nav/RoleProfileSettingsPanel";
import { RoleLogoutButton } from "@/components/shared/RoleLogoutButton";
import {
  ShieldCheck,
  Loader2,
  CheckCircle2,
  AlertCircle,
  User,
  Mail,
  Phone,
  Save
} from "lucide-react";

/* ── shape ── */

interface ProfileData {
  id: string;
  name: string;
  email: string;
  phone: string | null;
  role: string;
  status: string;
  uniqueId?: string;
  twoFactorEnabled?: boolean;
}

interface ProfileResponse {
  success: boolean;
  data: ProfileData;
  error?: string;
}

/* ── main ── */

function ContactInfoInner() {
  const user = useAuthStore((s) => s.user);
  const userId = user?.id ?? "";

  const {
    data: profile,
    loading,
    error,
    refresh,
  } = useApiResource<ProfileResponse>("/api/profile", {
    ttlMs: 60_000,
    enabled: !!userId,
  });

  const [name, setName] = useState("");
  const [phone, setPhone] = useState("");
  const [busy, setBusy] = useState(false);
  const [msg, setMsg] = useState<{ ok: boolean; text: string } | null>(null);

  useEffect(() => {
    if (profile?.data) {
      setName(profile.data.name || "");
      setPhone(profile.data.phone || "");
    }
  }, [profile]);

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    setBusy(true);
    setMsg(null);
    try {
      const res = await fetch("/api/profile", {
        method: "PATCH",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        body: JSON.stringify({ name, phone }),
      });
      const json = await res.json().catch(() => null);
      if (res.ok && json?.success) {
        setMsg({ ok: true, text: "Contact details updated." });
        refresh();
      } else {
        setMsg({ ok: false, text: json?.error || "Failed to update contact details." });
      }
    } catch {
      setMsg({ ok: false, text: "Network error — please retry." });
    } finally {
      setBusy(false);
    }
  };

  const p = profile?.data;

  return (
    <div className="min-w-0 space-y-6">
      <div>
        <p className="text-2xl font-semibold tracking-tight text-white flex items-center gap-2">
          <ShieldCheck className="w-6 h-6 text-action-success" />
          Contact Information
        </p>
        <p className="mt-1 text-sm text-text-muted">
          Your account contact details as registered on the campus portal
        </p>
      </div>

      <ContextSituationBar
        roleLabel="Student Guardian / Parent"
        purpose="Maintain verified guardian contact numbers and account communication settings."
        why="Verified phone numbers and addresses ensure automated SMS and emergency notifications reach guardians immediately."
        contextLabel="Guardian Profile & Contact"
        statusTone="info"
        statusPill={p?.status ? `Account: ${p.status}` : "Verified"}
        statusSummary="Keep your emergency phone number and contact information up to date for campus gate notifications."
        primaryAction={{ label: "Ward Status", href: "/guardian/child-status" }}
        secondaryAction={{ label: "Ward Requests", href: "/guardian/child-requests" }}
      />

      {error && (
        <div className="surface-card bg-rose-500/10 p-3 text-sm text-rose-600 flex items-center gap-2">
          <AlertCircle className="w-4 h-4 shrink-0" />
          {error}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        {/* read-only summary card */}
        <div className="surface-card bg-bg-surface p-4 space-y-4">
          <h2 className="text-sm font-semibold text-text-secondary uppercase tracking-wide">
            Registered details
          </h2>

          {loading ? (
            <div className="flex items-center gap-3 text-sm text-text-muted py-4">
              <Loader2 className="w-4 h-4 animate-spin" /> Loading profile…
            </div>
          ) : p ? (
            <dl className="space-y-3">
              {[
                { icon: User, label: "Full name", value: p.name || "—" },
                { icon: Mail, label: "Email", value: p.email || "—" },
                { icon: Phone, label: "Phone", value: p.phone || "Not set" },
                { icon: ShieldCheck, label: "Role", value: p.role || "—" },
              ].map((row) => (
                <div key={row.label} className="flex items-center gap-3">
                  <div className="size-6 rounded-lg bg-bg-elevated border border-border flex items-center justify-center shrink-0">
                    <row.icon className="w-4 h-4 text-action-success" />
                  </div>
                  <div className="min-w-0">
                    <dt className="text-xs text-text-muted">{row.label}</dt>
                    <dd className="text-sm text-text-primary truncate">{row.value}</dd>
                  </div>
                </div>
              ))}
            </dl>
          ) : (
            <p className="text-sm text-text-muted">No profile data available.</p>
          )}

          <p className="text-xs text-text-muted">
            Email changes, password resets, PIN changes and role changes must go through the
            dedicated account endpoints or the campus admin office.
          </p>
        </div>

        {/* update form */}
        <form
          onSubmit={submit}
          className="surface-card bg-bg-surface p-4 space-y-4"
        >
          <h2 className="text-sm font-semibold text-text-secondary uppercase tracking-wide">
            Update name &amp; phone
          </h2>

          <div>
            <label htmlFor="contactName" className="block text-xs font-medium text-text-secondary mb-1">
              Full name
            </label>
            <input
              id="contactName"
              type="text"
              value={name}
              onChange={(e) => setName(e.target.value)}
              disabled={busy || loading}
              required
              minLength={2}
              maxLength={100}
              className="surface-card w-full bg-bg-elevated px-3 py-2 text-sm text-text-primary focus:outline-none focus:disabled:opacity-50"
            />
          </div>

          <div>
            <label htmlFor="contactPhone" className="block text-xs font-medium text-text-secondary mb-1">
              Phone
            </label>
            <input
              id="contactPhone"
              type="tel"
              value={phone}
              onChange={(e) => setPhone(e.target.value)}
              disabled={busy || loading}
              placeholder="+91 90000 00000"
              className="surface-card w-full bg-bg-elevated px-3 py-2 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:disabled:opacity-50"
            />
          </div>

          <button
            type="submit"
            disabled={busy || loading}
            className="surface-card inline-flex items-center gap-2 px-4 py-2 bg-action-success hover:bg-action-success disabled:opacity-50 text-white text-sm font-semibold"
          >
            {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <Save className="w-4 h-4" />}
            {busy ? "Saving…" : "Save changes"}
          </button>

          {msg && (
            <div
              className={`rounded-lg border p-3 text-sm flex items-start gap-2 ${
                msg.ok
                  ? "border-emerald-400/30 bg-emerald-400/10 text-action-success"
                  : "border-rose-400/30 bg-rose-400/10 text-action-danger"
              }`}
            >
              <CheckCircle2 className="w-4 h-4 shrink-0 mt-0.5" />
              <span>{msg.text}</span>
            </div>
          )}
        </form>
      </div>

      <RoleProfileSettingsPanel role="guardian" />
      <div className="flex justify-end">
        <RoleLogoutButton />
      </div>
    </div>
  );
}
export default function ContactInfoPage() {
  return (
    <AuthGuard allowedRoles={['guardian', 'parent', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <ContactInfoInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

