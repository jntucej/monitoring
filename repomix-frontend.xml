<file path="src/app/(sysadmin)/sysadmin/access-keys/page.tsx">
"use client";


import { useState, useEffect, useCallback, useRef } from "react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import {
  KeyRound, Search, RefreshCw, Loader2, Clock, Trash2, UserPlus, Check, Copy,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface EnrollmentCodeRow {
  id: string;
  user_id: string;
  user_roll: string | null;
  user_name: string | null;
  purpose: string;
  expires_at: string;
  used_at: string | null;
  created_at: string;
  created_by: string | null;
}

interface GeneratedCode {
  code: string;
  purpose: string;
  expiresAt: string;
  userRoll: string;
  userName: string;
  bootstrapLink?: string;
}

const PURPOSES: { value: string; label: string }[] = [
  { value: "web_bootstrap", label: "Web onboarding (password + PIN)" },
  { value: "mobile", label: "Mobile device pairing (15 min)" },
  { value: "pin_reset", label: "Kiosk PIN reset" },
];

function formatTs(iso?: string | null) {
  if (!iso) return "—";
  try { return new Date(iso).toLocaleString(); } catch { return iso; }
}

export default function SysAdminAccessKeysPage() {
  const { addToast } = useUIStore();
  const [codes, setCodes] = useState<EnrollmentCodeRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [loadError, setLoadError] = useState<string | null>(null);

  const [rollInput, setRollInput] = useState("");
  const [purpose, setPurpose] = useState("web_bootstrap");
  const [generating, setGenerating] = useState(false);
  const [generated, setGenerated] = useState<GeneratedCode | null>(null);
  const [genError, setGenError] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const genTimer = useRef<number | null>(null);

  const loadCodes = useCallback(async () => {
    setLoading(true);
    setLoadError(null);
    try {
      const res = await fetch(`/api/admin/users/enrollment-codes?active=true&t=${Date.now()}`, {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const json = await res.json().catch(() => ({ success: false, error: { message: "Invalid server response." } }));
      if (res.ok && json.success) {
        setCodes(Array.isArray(json.data) ? json.data : []);
      } else {
        setLoadError(json.error?.message || `Failed to load enrollment codes (HTTP ${res.status})`);
      }
    } catch {
      setLoadError("Network error loading enrollment codes");
    } finally {
      setLoading(false);
    }
  }, [addToast]);

  useEffect(() => { loadCodes(); }, [loadCodes]);

  const handleGenerate = async () => {
    setGenError(null);
    const roll = rollInput.trim().toUpperCase();
    if (!roll) {
      setGenError("Enter the student's roll number.");
      return;
    }
    setGenerating(true);
    try {
      // Resolve roll -> user id
      const usersRes = await fetch(`/api/users?q=${encodeURIComponent(roll)}`, {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const usersJson = await usersRes.json().catch(() => ({ success: false, data: [] }));
      let target: { id: string; name?: string; uniqueId?: string; unique_id?: string } | undefined;

      if (usersRes.ok && usersJson.success && Array.isArray(usersJson.data) && usersJson.data.length > 0) {
        const exact = usersJson.data.find(
          (u: any) =>
            String(u.uniqueId ?? u.unique_id ?? u.id ?? "")
              .toUpperCase()
              .replace(/\s/g, "") === roll.replace(/\s/g, "")
        );
        target = exact ?? usersJson.data[0];
      }

      if (!target?.id) {
        setGenError(`No user found for roll number "${roll}". Make sure the student exists in the roster.`);
        setGenerating(false);
        return;
      }

      const res = await fetch(`/api/admin/users/${encodeURIComponent(target.id)}/enrollment-code`, {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ purpose }),
      });
      const json = await res.json().catch(() => ({ success: false }));
      if (res.ok && json.success) {
        setGenerated({
          code: json.data.code,
          purpose: json.data.purpose,
          expiresAt: json.data.expiresAt,
          userRoll: String(target.uniqueId ?? target.unique_id ?? roll),
          userName: target.name ?? "",
        });
        addToast({ variant: "success", title: "Code generated", message: `Enrollment code issued for ${String(target.uniqueId ?? target.unique_id ?? roll)}.` });
        loadCodes();
      } else {
        setGenError(json.error?.message || "Failed to generate enrollment code.");
      }
    } catch {
      setGenError("Network error generating code.");
    } finally {
      setGenerating(false);
    }
  };

  const handleInvalidate = async (id: string) => {
    try {
      const res = await fetch(`/api/admin/users/enrollment-codes/${id}`, {
        method: "DELETE",
        headers: getAuthHeaders(),
      });
      if (res.ok) {
        addToast({ variant: "success", message: "Code invalidated." });
        loadCodes();
      } else {
        const json = await res.json().catch(() => ({}));
        addToast({ variant: "error", title: "Error", message: json.error?.message || "Failed to invalidate code." });
      }
    } catch {
      addToast({ variant: "error", message: "Network error invalidating code." });
    }
  };

  const copyCode = async () => {
    if (!generated) return;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(generated.code);
      }
      setCopied(true);
      if (genTimer.current) window.clearTimeout(genTimer.current);
      genTimer.current = window.setTimeout(() => setCopied(false), 1500);
    } catch { /* ignore */ }
  };

  const activeCount = codes.filter((c) => !c.used_at && new Date(c.expires_at).getTime() > Date.now()).length;

  return (
    <AuthGuard allowedRoles={["sysadmin", "admin"]}>
      <div className="space-y-6">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Enrollment Keys & Tokens"
        purpose="Issue, audit, and revoke single-use enrollment credentials and administrative access tokens for student and staff onboarding."
        statusSummary={`${codes.length} enrollment keys tracked with ${codes.filter((c) => !c.used_at && new Date(c.expires_at) > new Date()).length} currently active and unredeemed.`}
        why="Enrollment keys permit users to claim official identities and link devices; stale or exposed keys must be revoked immediately."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "Access Governance", href: "/sysadmin/access" }}
      />
        <div className="flex items-center gap-3">
          <div className="size-5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center">
            <KeyRound className="w-5 h-5 text-action-success" />
          </div>
          <div>
            <p className="text-xl font-bold text-text-primary">Access Keys</p>
            <p className="text-xs text-text-muted">
              One-time enrollment codes for student bootstrap, mobile pairing and PIN reset. {activeCount} active.
            </p>
          </div>
        </div>

        {/* Generate by roll */}
        <div className="surface-card bg-bg-surface p-4 space-y-3">
          <h2 className="text-sm font-semibold text-text-primary flex items-center gap-2">
            <UserPlus className="w-4 h-4 text-action-success" /> Generate code for a student
          </h2>
          <div className="grid sm:grid-cols-[1fr_auto_auto] gap-3 items-end">
            <div>
              <label className="block text-xs font-semibold text-text-muted mb-1 uppercase tracking-wide">Roll / Employee ID</label>
              <div className="relative">
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" />
                <input
                  type="text"
                  value={rollInput}
                  onChange={(e) => setRollInput(e.target.value.toUpperCase())}
                  placeholder="e.g. 24JJ1A0501"
                  className="surface-card w-full pl-9 pr-3 py-2 bg-bg-base font-mono text-sm text-text-primary placeholder-slate-600 focus:outline-none focus:"
                />
              </div>
            </div>
            <div>
              <label className="block text-xs font-semibold text-text-muted mb-1 uppercase tracking-wide" htmlFor="purpose">Purpose</label>
              <select id="purpose"
                value={purpose}
                onChange={(e) => setPurpose(e.target.value)}
                className="surface-card px-3 py-2 bg-bg-base text-sm text-text-primary focus:outline-none focus:"
              >
                {PURPOSES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}
              </select>
            </div>
            <button
              onClick={handleGenerate}
              disabled={generating}
              className="surface-card inline-flex items-center gap-2 px-4 py-2 bg-action-success hover:bg-action-success text-white text-sm font-semibold disabled:opacity-50 whitespace-nowrap"
            >
              {generating ? <Loader2 className="w-4 h-4 animate-spin" /> : <KeyRound className="w-4 h-4" />}
              {generating ? "Generating…" : "Generate"}
            </button>
          </div>
          {genError && <p className="text-xs text-action-danger">{genError}</p>}
        </div>

        {/* Generated code display */}
        {generated && (
          <div className="surface-card p-4 bg-emerald-500/5 space-y-2">
            <div className="text-xs uppercase font-bold text-text-muted tracking-wider flex items-center justify-between">
              <span>New code for {generated.userName ? `${generated.userName} (` : ""}{generated.userRoll}{generated.userName ? ")" : ""}</span>
              <span className="flex items-center gap-1 text-action-success normal-case font-mono text-xs">
                <Clock className="w-3.5 h-3.5" /> {formatTs(generated.expiresAt)}
              </span>
            </div>
            <div className="flex items-center gap-3">
              <span className="text-3xl font-mono font-black tracking-[0.3em] text-action-success select-all">{generated.code}</span>
              <button onClick={copyCode} className="surface-card inline-flex items-center gap-1.5 text-xs text-action-success hover:text-action-success px-2 py-1">
                {copied ? <Check className="w-3.5 h-3.5" /> : <Copy className="w-3.5 h-3.5" />}
                {copied ? "Copied" : "Copy"}
              </button>
            </div>
            <p className="text-xs text-action-warning">Share at <code className="font-mono">/bootstrap</code> with the student&apos;s roll number and this code.</p>
          </div>
        )}

        {/* Active codes table */}
        <div>
          <div className="flex items-center justify-between mb-2">
            <h2 className="text-xs font-semibold text-text-muted uppercase tracking-wider">Recently issued codes</h2>
            <button onClick={loadCodes} className="inline-flex items-center gap-1.5 text-xs text-text-muted hover:text-text-secondary">
              <RefreshCw className={`w-3.5 h-3.5 ${loading ? "animate-spin" : ""}`} /> Refresh
            </button>
          </div>

          {loadError && (
            <div className="surface-card mb-3 px-4 py-3 bg-rose-500/10 text-action-danger text-sm">
              {loadError}
            </div>
          )}

          <div className="border border-border rounded-xl overflow-hidden">
            <table className="w-full text-sm">
              <thead>
                <tr className="bg-bg-base text-xs uppercase tracking-wider text-text-muted">
                  <th className="px-4 py-2.5 text-left">User</th>
                  <th className="px-4 py-2.5 text-left">Purpose</th>
                  <th className="px-4 py-2.5 text-left">Issued</th>
                  <th className="px-4 py-2.5 text-left">Expires</th>
                  <th className="px-4 py-2.5 text-left">Status</th>
                  <th className="px-4 py-2.5 text-right">Action</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {loading ? (
                  <tr>
                    <td colSpan={6} className="px-4 py-10 text-center text-text-muted">
                      <Loader2 className="w-5 h-5 animate-spin mx-auto mb-2" /> Loading codes…
                    </td>
                  </tr>
                ) : codes.length === 0 ? (
                  <tr>
                    <td colSpan={6} className="px-4 py-10 text-center text-text-muted text-xs">
                      No recently issued codes. Generate one above using a roll number.
                    </td>
                  </tr>
                ) : (
                  codes.map((c) => {
                    const now = Date.now();
                    const expired = new Date(c.expires_at).getTime() <= now;
                    const used = !!c.used_at;
                    const status = used ? "Used" : expired ? "Expired" : "Active";
                    return (
                      <tr key={c.id} className="hover:bg-bg-base/50">
                        <td className="px-4 py-2.5">
                          <div className="font-mono text-xs text-action-success">{c.user_roll || c.user_id?.slice(0, 8)}</div>
                          {c.user_name && <div className="text-xs text-text-muted">{c.user_name}</div>}
                        </td>
                        <td className="px-4 py-2.5 text-xs text-text-secondary">{c.purpose}</td>
                        <td className="px-4 py-2.5 text-xs text-text-muted">{formatTs(c.created_at)}</td>
                        <td className="px-4 py-2.5 text-xs text-text-muted">{formatTs(c.expires_at)}</td>
                        <td className="px-4 py-2.5">
                          <span className={`inline-block px-2 py-0.5 rounded-full text-xs font-bold uppercase ${
                            status === "Active" ? "bg-emerald-500/15 text-action-success"
                            : status === "Used" ? "bg-bg-elevated/15 text-text-muted"
                            : "bg-rose-500/15 text-action-danger"
                          }`}>
                            {status}
                          </span>
                        </td>
                        <td className="px-4 py-2.5 text-right">
                          {!used && !expired && (
                            <button
                              onClick={() => handleInvalidate(c.id)}
                              title="Invalidate this code"
                              className="surface-card inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold text-action-danger hover:bg-rose-500/10"
                            >
                              <Trash2 className="w-3.5 h-3.5" /> Invalidate
                            </button>
                          )}
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(sysadmin)/sysadmin/achievements/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  Trophy, Star,
} from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { EmptyState } from "@/components/admin/shared/EmptyState";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface AchievementDef {
  code: string;
  title: string;
  description: string | null;
  icon: string | null;
  tier: string | null;
  earnedAt?: string;
  earned?: boolean;
}

/**
 * Sysadmin Achievements — achievement definitions + earned counts.
 * Backend: /api/campus/achievements (open GET).
 */
function SysadminAchievementsInner() {
  const [earned, setEarned] = useState<AchievementDef[]>([]);
  const [available, setAvailable] = useState<AchievementDef[]>([]);
  const [loading, setLoading] = useState(true);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const res = await fetch("/api/campus/achievements", { headers: getAuthHeaders() });
      const body = await res.json();
      setEarned((body?.data?.earned ?? []) as AchievementDef[]);
      setAvailable((body?.data?.available ?? []) as AchievementDef[]);
    } catch (e) {
      console.error("achievements", e);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  if (loading) {
    return (
      <div className="space-y-4 p-4 md:p-6">
        <Skeleton className="h-10 w-48" />
        <Skeleton className="h-72 rounded-2xl" />
      </div>
    );
  }

  const unearned = available.filter((a) => !a.earned);

  return (
    <div className="space-y-6 p-4 md:p-6">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Campus Achievement System"
        purpose="Configure gamified campus milestones, monitor student milestone completions, and manage badge tier allocations."
        statusSummary={`${earned.length} unlocked achievements and ${unearned.length} available tier badges configured in the campus engagement registry.`}
        why="Student achievements incentivize campus participation, verified attendance milestones, and positive student community engagement."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "Communities", href: "/sysadmin/communities" }}
      />
      <PageHeader
        title="Achievements"
        subtitle={`${earned.length} earned · ${unearned.length} available`}
        onRefresh={load}
      />

      <WidgetBoundary title="Earned">
        <div className="glass-card">
          {earned.length === 0 ? (
            <EmptyState
              icon={<Trophy className="w-6 h-6" />}
              title="No achievements earned"
              description="Earned achievements appear here once awarded."
            />
          ) : (
            <div className="divide-y divide-border">
              {earned.map((a) => (
                <div key={a.code} className="p-3 flex items-center gap-3">
                  <div className="size-6 rounded-xl bg-amber-500/15 flex items-center justify-center shrink-0">
                    <span className="text-lg">{a.icon || "🏆"}</span>
                  </div>
                  <div className="flex-1">
                    <p className="text-sm font-medium text-text-primary">{a.title}</p>
                    <p className="text-xs text-text-muted">{a.description}</p>
                  </div>
                  {a.earnedAt && (
                    <span className="text-xs text-text-muted shrink-0">
                      {new Date(a.earnedAt).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" })}
                    </span>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      </WidgetBoundary>

      <WidgetBoundary title="Available">
        <div className="glass-card">
          {unearned.length === 0 ? (
            <EmptyState icon={<Star className="w-6 h-6" />} title="All achievements earned" />
          ) : (
            <div className="divide-y divide-border">
              {unearned.map((a) => (
                <div key={a.code} className="p-3 flex items-center gap-3 opacity-70">
                  <div className="size-6 rounded-xl bg-bg-elevated flex items-center justify-center shrink-0">
                    <span className="text-lg">{a.icon || "⭐"}</span>
                  </div>
                  <div className="flex-1">
                    <p className="text-sm font-medium text-text-secondary">{a.title}</p>
                    <p className="text-xs text-text-muted">{a.description}</p>
                  </div>
                  {a.tier && (
                    <span className="surface-card px-2 py-0.5 text-xs bg-bg-elevated text-text-muted shrink-0">{a.tier}</span>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      </WidgetBoundary>
    </div>
  );
}

export default function SysadminAchievementsPage() {
  return (
    <AuthGuard allowedRoles={["admin", "sysadmin"]}>
      <SysadminAchievementsInner />
    </AuthGuard>
  );
}
