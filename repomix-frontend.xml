                          <span className="text-text-muted">—</span>
                        )}
                      </td>

                      <td className="px-6 py-4 text-xs text-text-muted">
                        {st.telegramLastSeenAt ? (
                          <div className="flex items-center gap-1.5">
                            <Clock className="w-3.5 h-3.5 text-text-muted" />
                            {new Date(st.telegramLastSeenAt).toLocaleString()}
                          </div>
                        ) : (
                          <span className="text-text-muted">Never</span>
                        )}
                      </td>

                      <td className="px-6 py-4 text-right">
                        <button
                          onClick={() => handleRequestCode(st.uniqueId)}
                          disabled={verifyingRoll === st.uniqueId}
                          className="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[color:var(--action-primary)]/10 hover:bg-[color:var(--action-primary)]/20 border border-[color:var(--action-primary)]/30 text-[color:var(--action-primary)] text-xs font-medium transition-colors disabled:opacity-50"
                        >
                          <KeyRound className="w-3.5 h-3.5" />
                          {verifyingRoll === st.uniqueId ? "Generating..." : "Verify / Relay Code"}
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

        {/* Verification Modal */}
        {verifyModalRoll && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4">
            <div className="bg-bg-base w-full max-w-md p-6 space-y-5">
              <div className="flex items-center justify-between pb-3 border-b border-border">
                <div className="flex items-center gap-2 text-[color:var(--action-primary)]">
                  <KeyRound className="w-4 h-4" />
                  <h3 className="font-semibold text-white">Verify Telegram Link</h3>
                </div>
                <button
                  onClick={() => {
                    setVerifyModalRoll(null);
                    setGeneratedCodeResult(null);
                    setVerifyInputCode("");
                  }}
                  className="text-text-muted hover:text-white text-sm"
                >
                  ✕
                </button>
              </div>

              <div className="space-y-4">
                <p className="text-xs text-text-secondary">
                  Target Student: <span className="font-mono font-bold text-[color:var(--action-primary)]">{verifyModalRoll}</span>
                </p>

                {generatedCodeResult?.code && (
                  <div className="p-4 bg-[color:var(--action-primary)]/10 space-y-2">
                    <span className="text-xs font-medium text-[color:var(--action-primary)] block">
                      Generated 6-Digit Verification Code:
                    </span>
                    <div className="text-2xl font-mono font-bold text-white tracking-widest bg-bg-base/60 p-2.5 text-center">
                      {generatedCodeResult.code}
                    </div>
                    <p className="text-[11px] text-text-muted">
                      {generatedCodeResult.sentViaTelegram
                        ? "Sent directly to student via Telegram bot."
                        : "Student is not linked to chat yet. Provide this code to the student to send via /verify <code> in Telegram, or submit it here directly."}
                    </p>
                  </div>
                )}

                <div className="space-y-1.5">
                  <label className="text-xs font-medium text-text-secondary">
                    Enter Verification Code
                  </label>
                  <input
                    type="text"
                    value={verifyInputCode}
                    onChange={(e) => setVerifyInputCode(e.target.value)}
                    placeholder="e.g. 123456"
                    maxLength={6}
                    className="w-full bg-bg-surface px-3 py-2 text-sm text-white font-mono placeholder:text-text-muted focus:outline-none focus:border-[color:var(--action-primary)]"
                  />
                </div>
              </div>

              <div className="flex items-center justify-end gap-3 pt-3">
                <button
                  type="button"
                  onClick={() => {
                    setVerifyModalRoll(null);
                    setGeneratedCodeResult(null);
                    setVerifyInputCode("");
                  }}
                  className="px-4 py-2 bg-bg-surface hover:bg-bg-elevated text-text-secondary text-xs font-medium transition-colors"
                >
                  Close
                </button>

                <button
                  type="button"
                  onClick={handleConfirmVerify}
                  disabled={verifyActionLoading || !verifyInputCode.trim()}
                  className="px-4 py-2 bg-[color:var(--action-primary)] hover:bg-[color:var(--action-primary)]/80 text-white text-xs font-bold transition-colors disabled:opacity-50 flex items-center gap-1.5"
                >
                  {verifyActionLoading && <RefreshCw className="w-3.5 h-3.5 animate-spin" />}
                  Confirm Verification
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(sysadmin)/sysadmin/classes/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import {Layers, Plus, Loader2, Search}  from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { usePersistentQuery } from "@/hooks/usePersistentQuery";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface Dept {
  id: string;
  code: string;
  name: string;
}
interface ClassRow {
  id: string;
  departmentId: string;
  year: number;
  section: string;
  name: string | null;
  classTeacherId: string | null;
  roomNumber: string | null;
  capacity: number | null;
  isActive: boolean;
}
interface NewClass {
  departmentId: string;
  year: string;
  section: string;
  name: string;
  roomNumber: string;
  capacity: string;
}

async function fetchClasses(): Promise<ClassRow[]> {
  const res = await fetch("/api/classes", { headers: getAuthHeaders() });
  const body = await res.json();
  return (body?.data ?? body ?? []) as ClassRow[];
}

async function fetchDepartments(): Promise<Dept[]> {
  const res = await fetch("/api/departments", { headers: getAuthHeaders() });
  const body = await res.json();
  return (body?.data ?? body ?? []) as Dept[];
}

/**
 * Admin Classes — manage (department, year, section) teaching groups.
 * Backend: /api/classes (hod|admin|sysadmin scope). No UI existed anywhere.
 */
function AdminClassesInner() {
  const [rows, setRows] = useState<ClassRow[]>([]);
  const [depts, setDepts] = useState<Dept[]>([]);
  const [loading, setLoading] = useState(true);
  const [query, setQuery] = usePersistentQuery("gate-sysadmin-classes-query");
  const [draft, setDraft] = useState<NewClass>({
    departmentId: "", year: "", section: "", name: "", roomNumber: "", capacity: "",
  });
  const [saving, setSaving] = useState(false);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const [c, d] = await Promise.all([fetchClasses(), fetchDepartments()]);
      setRows(c);
      setDepts(d);
    } catch (e) {
      console.error("classes", e);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  const filtered = useMemo(() => {
    if (!query.trim()) return rows;
    const q = query.toLowerCase();
    const deptName = (id: string) => depts.find((d) => d.id === id)?.name ?? id;
    return rows.filter((r) =>
      `${r.departmentId} ${deptName(r.departmentId)} ${r.year} ${r.section} ${r.name ?? ""}`.toLowerCase().includes(q)
    );
  }, [rows, query, depts]);

  const create = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!draft.departmentId || !draft.year || !draft.section) return;
    setSaving(true);
    try {
      const res = await fetch("/api/classes", {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({
          departmentId: draft.departmentId,
          year: Number(draft.year),
          section: draft.section,
          name: draft.name || undefined,
          roomNumber: draft.roomNumber || undefined,
          capacity: draft.capacity ? Number(draft.capacity) : undefined,
        }),
      });
      const json = await res.json();
      if (res.ok && json.success) {
        setDraft({ departmentId: "", year: "", section: "", name: "", roomNumber: "", capacity: "" });
        load();
      }
    } finally {
      setSaving(false);
    }
  };

  const deptName = (id: string) => depts.find((d) => d.id === id)?.name ?? id;

  if (loading) {
    return (
      <div className="space-y-4 p-4 md:p-6">
        <Skeleton className="h-10 w-48" />
        <Skeleton className="h-64 rounded-2xl" />
      </div>
    );
  }

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-4 md:py-6">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Classes & Academic Cohorts"
        purpose="Create teaching sections, manage classroom capacities, and configure academic groups by department, year, and section."
        statusSummary={`${filtered.filter((c: { isActive?: boolean }) => c.isActive).length} active classes configured across ${depts.length} campus departments.`}
        why="Structured class rosters link students to class advisors, department faculty, and timetable-based gate pass permissions."
        primaryAction={{ label: "Faculty Assignments", href: "/sysadmin/faculty-assignments" }}
        secondaryAction={{ label: "Departments", href: "/sysadmin/departments" }}
      />
      <PageHeader title="Classes" subtitle="Teaching groups by department, year, and section" onRefresh={load} />

      <WidgetBoundary title="Create class">
        <form onSubmit={create} className="surface-card p-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 items-end">
          <label className="block sm:col-span-2 md:col-span-1">
            <span className="text-xs font-semibold text-text-secondary block mb-1">Department</span>
            <select
              value={draft.departmentId}
              onChange={(e) => setDraft((d) => ({ ...d, departmentId: e.target.value }))}
              className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm"
              required
            >
              <option value="">Select</option>
              {depts.map((d) => <option key={d.id} value={d.id}>{d.name}</option>)}
            </select>
          </label>
          <label>
            <span className="text-xs font-semibold text-text-secondary block mb-1">Year</span>
            <input type="number" min="1" max="10" value={draft.year} onChange={(e) => setDraft((d) => ({ ...d, year: e.target.value }))}
              placeholder="1" required className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm" />
          </label>
          <label>
            <span className="text-xs font-semibold text-text-secondary block mb-1">Section</span>
            <input value={draft.section} onChange={(e) => setDraft((d) => ({ ...d, section: e.target.value }))}
              placeholder="A" required className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm" />
          </label>
          <label>
            <span className="text-xs font-semibold text-text-secondary block mb-1">Room</span>
            <input value={draft.roomNumber} onChange={(e) => setDraft((d) => ({ ...d, roomNumber: e.target.value }))}
              placeholder="B101" className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm" />
          </label>
          <label>
            <span className="text-xs font-semibold text-text-secondary block mb-1">Capacity</span>
            <input type="number" min="0" value={draft.capacity} onChange={(e) => setDraft((d) => ({ ...d, capacity: e.target.value }))}
              placeholder="60" className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm" />
          </label>
          <button type="submit" disabled={saving}
            className="surface-card inline-flex items-center justify-center gap-1.5 px-3 py-2 min-h-11 bg-action-primary text-white text-xs font-semibold disabled:opacity-50">
            {saving ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Plus className="w-3.5 h-3.5" />} Add
          </button>
        </form>
      </WidgetBoundary>

      <WidgetBoundary title="Class list">
        <div className="glass-card">
          <div className="surface-card p-4 flex flex-wrap items-center gap-2">
            <Layers className="w-4 h-4 text-action-primary" />
            <span className="text-sm font-semibold">{filtered.length} classes</span>
            <div className="ml-auto relative min-w40">
              <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-muted" />
              <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Filter…"
                className="surface-card pl-8 pr-3 py-1.5 min-h-11 bg-bg-elevated text-xs w-full sm:w-40" />
            </div>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-xs text-text-muted border-b border-border">
                  <th className="p-3 text-left">Department</th>
                  <th className="p-3 text-left">Year</th>
                  <th className="p-3 text-left">Section</th>
                  <th className="p-3 text-left">Name</th>
                  <th className="p-3 text-left">Room</th>
                  <th className="p-3 text-left">Capacity</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {filtered.length === 0 && (
                  <tr><td colSpan={6} className="p-6 text-center text-text-muted">No classes yet.</td></tr>
                )}
                {filtered.map((r) => (
                  <tr key={r.id} className="hover:bg-bg-elevated/40">
                    <td className="p-3 text-text-primary">{deptName(r.departmentId)}</td>
                    <td className="p-3 tabular-nums">{r.year}</td>
                    <td className="p-3 font-medium">{r.section}</td>
                    <td className="p-3 text-text-muted">{r.name ?? "—"}</td>
                    <td className="p-3 text-text-muted">{r.roomNumber ?? "—"}</td>
                    <td className="p-3 tabular-nums">{r.capacity ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </WidgetBoundary>
    </div>
  );
}

export default function AdminClassesPage() {
  return (
    <AuthGuard allowedRoles={["admin", "sysadmin"]}>
      <AdminClassesInner />
    </AuthGuard>
  );
}
</file>

