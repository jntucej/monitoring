"use client";

import { Suspense, useCallback, useMemo, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { buildDeputyWardenGateMovementInspection } from "@/lib/role-registers/deputyWardenInspections";
import {
  ShieldCheck,
  Loader2,
  ArrowRight,
  AlertTriangle,
  Inbox
} from "lucide-react";
import { gatePresenceInspection, type GatePresenceRow } from "@/components/approver/wardenConsoleModels";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

/* response shapes */

interface GateInfo {
  id: string;
  name: string;
  code: string;
  audience: string;
  type: string;
}

interface PresenceMatrixResponse {
  success: boolean;
  data: {
    gates: GateInfo[];
    roles: string[];
    matrix: Record<string, Record<string, number>>;
    lastUpdated: string;
  };
}

function DeputyWardenGatemovementInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "deputy_warden") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<PresenceMatrixResponse>("/api/occupancy/presence-matrix", { ttlMs: 30_000 });

  const gates = data?.data?.gates ?? [];
  const matrix = data?.data?.matrix ?? {};
  const onCampusTotal = gates.reduce(
    (sum, g) => sum + Object.values(matrix[g.id] ?? {}).reduce((a, b) => a + b, 0),
    0
  );
  const inspectGate = useCallback(
    (g: GateInfo) => {
      const onCampus = Object.values(matrix[g.id] ?? {}).reduce((a, b) => a + b, 0);
      inspect(gatePresenceInspection({ id: g.id, name: g.name, code: g.code, audience: g.audience, type: g.type, onCampus } satisfies GatePresenceRow));
    },
    [matrix, inspect]
  );

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      {/* Back link */}
      <Link
        href="/deputy-warden/daily-overview"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Daily Overview
      </Link>

      {/* Page toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Deputy Warden"
        purpose="Monitor live campus gate movements, track entry/exit throughput, and identify perimeter anomalies"
        why="Tracking live entry and exit traffic highlights abnormal perimeter behavior and curfew violations in real time."
        contextLabel={`Gate Movement & Presence · ${onCampusTotal} Inside`}
        statusSummary={`${onCampusTotal} person(s) currently on campus across ${gates.length} reporting gate(s).`}
        severity="info"
        primaryAction={{ label: "Curfew Oversight", href: "/deputy-warden/curfew-oversight" }}
        secondaryActions={[
          { label: "Daily Overview", href: "/deputy-warden/daily-overview" },
          { label: "Outpass Queue", href: "/deputy-warden" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">Gate Movement data unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      <WidgetBoundary title="Gate Movement">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <ShieldCheck className="w-4 h-4 text-action-success shrink-0" />
              <span className="text-sm font-semibold text-white truncate">Gate Movement</span>
            </div>
            <span className="text-xs text-text-muted shrink-0">
              {onCampusTotal} person(s) on campus across {gates.length} gate(s)
            </span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" /> Loading Gate Movement…
            </div>
          ) : gates.length === 0 ? (
            <div className="p-6 text-center min-w-0">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No active gates are feeding the presence matrix.</p>
            </div>
          ) : (
            <div className="overflow-x-auto min-w-0">
              <table className="w-full text-sm min-w120">
                <thead>
                  <tr className="border-b border-border text-left text-xs text-text-muted">
                    <th className="py-2 pr-4">Gate</th>
                    <th className="py-2 pr-4">Audience</th>
                    <th className="py-2 pr-4">Type</th>
                    <th className="py-2">On Campus</th>
                  </tr>
                </thead>
                <tbody>
                  {gates.map((g) => {
                    const count = Object.values(matrix[g.id] ?? {}).reduce((a, b) => a + b, 0);
                    const gateRecord = {
                      ...g,
                      onCampusCount: count,
                      roleCounts: matrix[g.id] ?? {},
                    };
                    return (
                      <tr
                        key={g.id}
                        onClick={() => inspect(buildDeputyWardenGateMovementInspection(gateRecord))}
                        onKeyDown={(e) => {
                          if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            inspect(buildDeputyWardenGateMovementInspection(gateRecord));
                          }
                        }}
                        tabIndex={0}
                        role="button"
                        aria-label={`Inspect gate ${g.name || g.code}`}
                        className="border-b border-border/50 last:border-0 hover:bg-bg-elevated/30 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary"
                      >
                        <td className="py-2 pr-4 font-mono text-xs text-text-secondary whitespace-nowrap">{g.name || g.code}</td>
                        <td className="py-2 pr-4 text-text-muted">{g.audience}</td>
                        <td className="py-2 pr-4 text-text-muted">{g.type}</td>
                        <td className="py-2 text-action-success font-semibold">{count}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}
export default function DeputyWardenGatemovementPage() {
  return (
    <AuthGuard allowedRoles={['deputy_warden', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <DeputyWardenGatemovementInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(approver)/deputy-warden/incident-reporting/page.tsx">
"use client";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { buildDeputyWardenIncidentInspection } from "@/lib/role-registers/deputyWardenInspections";
import {
  ShieldCheck,
  Loader2,
  ArrowRight,
  AlertTriangle,
  Inbox
} from "lucide-react";
import { incidentInspection, type IncidentRow } from "@/components/approver/wardenConsoleModels";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

/* response shapes */

interface AlertItem {
  id: string;
  title: string;
  severity: string;
  status: string;
  created_at?: string | null;
}

interface AlertsResponse {
  success: boolean;
  data: AlertItem[];
}

function DeputyWardenIncidentsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "deputy_warden") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();
  const inspectIncident = useCallback(
    (a: AlertItem) => {
      inspect(incidentInspection({
        id: a.id,
        title: a.title,
        severity: a.severity,
        status: a.status,
        created_at: a.created_at ?? null,
      } satisfies IncidentRow));
    },
    [inspect]
  );

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<AlertsResponse>("/api/alerts", { ttlMs: 30_000 });

  const alerts = data?.data ?? [];
  const openCount = alerts.filter((a) => a.status !== "RESOLVED" && a.status !== "DISMISSED").length;

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      {/* Back link */}
      <Link
        href="/deputy-warden/daily-overview"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Daily Overview
      </Link>

      {/* Page toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Deputy Warden"
        purpose="Review and record hostel security incidents, track emergency alerts, and coordinate escalations"
        why="Documenting safety incidents provides crucial audit trails and triggers timely escalation to chief wardens and security."
        contextLabel={`Incident Reporting & Safety Alerts · ${openCount} Open`}
        statusSummary={
          openCount > 0
            ? `${openCount} open security or safety alert${openCount === 1 ? "" : "s"} requiring attention.`
            : "No active incidents or security alerts reported. Campus status is nominal."
        }
        severity={openCount > 0 ? "warn" : "ok"}
        primaryAction={{ label: "Daily Overview", href: "/deputy-warden/daily-overview" }}
        secondaryActions={[
          { label: "Curfew Oversight", href: "/deputy-warden/curfew-oversight" },
          { label: "Shift Handover", href: "/deputy-warden/shift-handover" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">
              {/403|forbidden/i.test(error)
                ? "Campus-wide incident alerts are restricted to supervisors and principals."
                : `Incidents data unavailable: ${error}`}
            </span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      <WidgetBoundary title="Incident Reporting">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <ShieldCheck className="w-4 h-4 text-action-success shrink-0" />
              <span className="text-sm font-semibold text-white truncate">Incident Reporting</span>
            </div>
            <span className="text-xs text-text-muted shrink-0">{openCount} open alert(s)</span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" /> Loading Incidents…
            </div>
          ) : alerts.length === 0 ? (
            <div className="p-6 text-center min-w-0">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No open alerts or incidents are visible to your role. The campus is nominal.</p>
            </div>
          ) : (
            <div className="overflow-x-auto min-w-0">
              <table className="w-full text-sm min-w120">
                <thead>
                  <tr className="border-b border-border text-left text-xs text-text-muted">
                    <th className="py-2 pr-4">Title</th>
                    <th className="py-2 pr-4">Severity</th>
                    <th className="py-2 pr-4">Status</th>
                    <th className="py-2">Created</th>
                  </tr>
                </thead>
                <tbody>
                  {alerts.slice(0, 20).map((a) => (
                    <tr
                      key={a.id}
                      onClick={() => inspect(buildDeputyWardenIncidentInspection(a))}
                      onKeyDown={(e) => {
                        if (e.key === "Enter" || e.key === " ") {
                          e.preventDefault();
                          inspect(buildDeputyWardenIncidentInspection(a));
                        }
                      }}
                      tabIndex={0}
                      role="button"
                      aria-label={`Inspect incident alert: ${a.title}`}
                      className="border-b border-border/50 last:border-0 hover:bg-bg-elevated/30 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary"
                    >
                      <td className="py-2 pr-4 text-text-secondary">{a.title}</td>
