<file path="src/components/operator/VoiceAssistantModal.tsx">
"use client";

import React, { useState, useEffect } from "react";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { parseVoiceCommand, VoiceCommand } from "@/lib/voice";
import { Mic, MicOff, Check, Sparkles } from "lucide-react";

interface VoiceAssistantModalProps {
  onExecuteCommand: (cmd: VoiceCommand) => void;
}

export function VoiceAssistantModal({ onExecuteCommand }: VoiceAssistantModalProps) {
  const [isListening, setIsListening] = useState(false);
  const [transcript, setTranscript] = useState("");
  const [parsedCommand, setParsedCommand] = useState<VoiceCommand | null>(null);
  const [recognition, setRecognition] = useState<any>(null);
  const [manualText, setManualText] = useState("");

  useEffect(() => {
    if (typeof window !== "undefined") {
      const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
      if (SpeechRecognition) {
        const recog = new SpeechRecognition();
        recog.continuous = false;
        recog.interimResults = true;
        recog.lang = "en-US";

        recog.onresult = (event: any) => {
          const current = event.resultIndex;
          const text = event.results[current][0].transcript;
          setTranscript(text);
          const cmd = parseVoiceCommand(text);
          setParsedCommand(cmd);
          if (cmd.confidence > 0.88 && cmd.roll_number) {
            onExecuteCommand(cmd);
          }
        };

        recog.onend = () => {
          setIsListening(false);
        };

        setRecognition(recog);
      }
    }
  }, [onExecuteCommand]);

  const toggleListening = () => {
    if (!recognition) {
      // Demo voice command simulation for non-supporting browsers
      const sample = "entry for 24JJ1A0501";
      setTranscript(sample);
      const cmd = parseVoiceCommand(sample);
      setParsedCommand(cmd);
      return;
    }
    if (isListening) {
      recognition.stop();
      setIsListening(false);
    } else {
      setTranscript("");
      setParsedCommand(null);
      try {
        recognition.start();
        setIsListening(true);
      } catch {
        setIsListening(false);
      }
    }
  };

  const handleManualSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!manualText.trim()) return;
    const cmd = parseVoiceCommand(manualText);
    setTranscript(manualText);
    setParsedCommand(cmd);
    onExecuteCommand(cmd);
    setManualText("");
  };

  const handleConfirm = () => {
    if (parsedCommand) {
      onExecuteCommand(parsedCommand);
      setTranscript("");
      setParsedCommand(null);
    }
  };

  return (
    <div className="surface-card p-3.5 bg-purple-950/10 backdrop-blur-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 animate-in fade-in duration-200">
      <div className="flex flex-wrap items-center gap-3 w-full sm:w-auto">
        <Button
          variant={isListening ? "danger" : "secondary"}
          size="sm"
          onClick={toggleListening}
          className="gap-2 text-xs font-bold"
        >
          {isListening ? <MicOff className="h-4 w-4 animate-pulse text-action-danger" /> : <Mic className="h-4 w-4 text-unit-c" />}
          {isListening ? "Listening..." : "Voice Assistant"}
        </Button>

        <form onSubmit={handleManualSubmit} className="flex items-center gap-1.5 flex-1 sm:flex-initial">
          <input
            type="text"
            value={manualText}
            onChange={(e) => setManualText(e.target.value)}
            placeholder="or type command e.g. 'entry 24JJ1A0501'"
            className="surface-card px-2.5 py-1 text-xs bg-bg-base font-mono text-text-primary outline-none focus:ring-1 focus:ringunit-c"
          />
          <button type="submit" className="surface-card p-1 bg-purple-500/20 text-purple-300 text-xs hover:bg-purple-500/30">
            <Sparkles className="w-3.5 h-3.5" />
          </button>
        </form>

        {transcript && (
          <div className="text-xs space-y-1">
            <span className="font-mono text-purple-300">&ldquo;{transcript}&rdquo;</span>
            {parsedCommand && (
              <Badge variant="success" className="ml-2 text-xs">
                {parsedCommand.action} {parsedCommand.roll_number ? `[${parsedCommand.roll_number}]` : ""}
              </Badge>
            )}
          </div>
        )}
      </div>

      {parsedCommand && parsedCommand.action !== "UNKNOWN" && (
        <div className="flex items-center gap-2">
          <Button variant="primary" size="sm" onClick={handleConfirm} className="gap-1 text-xs">
            <Check className="h-3.5 w-3.5" /> Execute Voice Action
          </Button>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/parent/ChildActivity.tsx">
"use client";
import { useEffect, useState, useCallback } from "react";
import { ArrowRight, ArrowLeft, Loader2, AlertCircle } from "lucide-react";
import type { Scan } from "@/lib/types";
import { useApi } from "@/hooks/useApi";

export function ChildActivity() {
const api = useApi();

  const [activities, setActivities] = useState<Scan[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(false);
  const [childRoll, setChildRoll] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(false);
    try {
      const authRaw = sessionStorage.getItem("gate-monitor-auth");
      const auth = authRaw ? JSON.parse(authRaw) : null;
      const parentId = auth?.state?.user?.id ?? auth?.user?.id;
      if (!parentId) {
        setLoading(false);
        return;
      }
      const res = await fetch(`/api/students?parentId=${parentId}`, { headers: api.getHeaders(), cache: "no-store" });
      if (!res.ok) {
        setError(true);
        setLoading(false);
        return;
      }
      const json = await res.json();
      const kids = Array.isArray(json.data) ? json.data : [];
      // Use the first child for the activity feed (parent page shows top-level summary)
      const first = kids[0];
      if (!first) {
        setLoading(false);
        return;
      }
      setChildRoll(first.roll);
      const r2 = await fetch(`/api/persons/${encodeURIComponent(first.uniqueId || first.roll)}/history?limit=10`, {
        headers: api.getHeaders(),
        cache: "no-store",
      });
      if (!r2.ok) {
        setError(true);
        setLoading(false);
        return;
      }
      const j2 = await r2.json();
      setActivities(Array.isArray(j2?.data?.history) ? j2.data.history : []);
      setLoading(false);
    } catch {
      setError(true);
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  return (
    <div className="surface-card bg-bg-surface p-6">
      <h3 className="font-semibold mb-4">Recent Activity</h3>
      <div className="space-y-4">
        {error ? (
          <div className="surface-card flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 p-3 bg-rose-500/10">
            <div className="flex items-center gap-2 text-sm text-action-danger font-medium">
              <AlertCircle className="w-4 h-4 text-action-danger shrink-0" />
              <span>Could not load activity.</span>
            </div>
            <button
              onClick={load}
              className="surface-card px-3 py-1.5 bg-rose-500/20 text-action-danger text-xs font-bold hover:bg-rose-500/30 transition shrink-0"
            >
              Retry
            </button>
          </div>
        ) : loading ? (
          <div className="flex items-center gap-2 text-sm text-text-muted">
            <Loader2 className="w-4 h-4 animate-spin" /> Loading activity…
          </div>
        ) : !childRoll ? (
          <p className="text-sm text-text-muted">No linked students.</p>
        ) : activities.length === 0 ? (
          <p className="text-sm text-text-muted">No recent activity.</p>
        ) : (
          activities.map((a) => {
            const isIn = a.direction === "IN";
            const t = new Date(a.timestamp).toLocaleString("en-IN", {
              weekday: "short",
              hour: "2-digit",
              minute: "2-digit",
            });
            return (
              <div key={a.id} className="flex items-center justify-between">
                <div className={`flex items-center gap-2 font-medium ${isIn ? "text-action-success" : "text-action-danger"}`}>
                  {isIn ? <ArrowRight className="w-5 h-5" /> : <ArrowLeft className="w-5 h-5" />}
                  <span className="capitalize">{a.direction === "IN" ? "Entry" : "Exit"}</span>
                </div>
                <div className="text-right">
                  <p className="text-sm">{t}</p>
                  <p className="text-xs text-text-muted">{a.gateName}</p>
                </div>
              </div>
            );
          })
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/parent/ChildActivityReviewPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  Clock,
  AlertTriangle,
  FileDown,
  RefreshCw,
  User,
  MapPin,
  ChevronRight,
} from "lucide-react";
import { usePeriod } from "@/hooks/usePeriod";
import { useExport } from "@/hooks/useExport";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { RaiseIssueButton } from "@/components/shared/RaiseIssueButton";
import { ScheduleStrip, type ScheduleItem } from "@/components/shared/ScheduleStrip";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";
import { useAuthStore } from "@/stores/authStore";

// ── Types ─────────────────────────────────────────────────────────────────

interface ChildActivityPayload {
  data: {
    child: { id: string; name: string };
    period: string;
    range: { from: string; to: string };
    activity: Array<{
      date: string;
      direction: string;
      gate: string;
      timeIn: string | null;
      timeOut: string | null;
    }>;
    timeSpent: {
      hours: number;
      lastMonthHours: number;
      delta: number;
    };
    heatmap: {
      grid: number[][]; // [dayOfWeek(0-6)][hour(0-23)]
      max: number;
    };
    upcoming: Array<{
      date: string;
      gate: string;
      timeIn: string | null;
    }>;
  };
}

const DOW_LABELS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

// ── Component ─────────────────────────────────────────────────────────────

export function ChildActivityReviewPanel({ childId }: { childId: string }) {
  const { period, setPeriod } = usePeriod("this-week");
  const { exportCSV } = useExport();
  const authUser = useAuthStore((s) => s.user);
  const parentId = authUser?.id ?? null;

  const [data, setData] = useState<ChildActivityPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [queryOpen, setQueryOpen] = useState(false);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/parent/child-activity?childId=${childId}&period=${period.key === "all-time" ? "this-week" : period.key}`,
        { headers: getAuthHeaders(), cache: "no-store" }
      );
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load");
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [childId, period.key]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      data.activity.map((a) => ({
        date: a.date,
        direction: a.direction,
        gate: a.gate,
        timeIn: a.timeIn ?? "",
        timeOut: a.timeOut ?? "",
      })),
      [
        { key: "date", header: "Date" },
        { key: "direction", header: "Direction" },
        { key: "gate", header: "Gate" },
        { key: "timeIn", header: "Time In" },
        { key: "timeOut", header: "Time Out" },
      ],
      `child_activity_${data.child.name?.replace(/\s/g, "_") ?? "child"}.csv`
    );
  };

  const handleQuerySubmit = async (reason: string, category?: string) => {
    // Route query to warden — uses the complaints API
    await fetch("/api/complaints", {
      method: "POST",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({
        category: "GUARDIAN_QUERY",
        subject: `Query about ${data?.child.name ?? "child"}`,
        description: category ? `${category}: ${reason}` : reason,
        targetType: "STUDENT",
        targetId: childId,
      }),
    });
    setQueryOpen(false);
  };

  const scheduleItems: ScheduleItem[] = (data?.upcoming ?? []).map((u, i) => ({
    id: `${u.date}-${i}`,
    title: `${u.gate} gate`,
    subtitle: u.timeIn ? u.timeIn : undefined,
    start: `${u.date}T${u.timeIn ?? "08:00:00"}`,
    end: `${u.date}T${u.timeIn ?? "08:00:00"}`,
  }));

  const heatGrid = data?.heatmap.grid ?? [];
  const heatMax = data?.heatmap.max ?? 0;

  return (
    <WidgetBoundary name="ChildActivityReviewPanel" resetKey={`${childId}-${period.key}`}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <User className="h-4 w-4 text-action-success shrink-0" />
            <div>
              <h2 className="text-sm font-semibold text-text-primary">
                {data?.child.name ?? "Child Activity"}
              </h2>
              <p className="text-xs text-text-muted">Period review, heatmap & time on campus</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <RaiseIssueButton
              label="Raise query"
              categories={["Late out", "Missing scan", "Wrong gate"]}
              onSubmit={handleQuerySubmit}
              className="text-xs"
            />
            <button
              type="button"
              onClick={handleExport}
              disabled={!data}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        <PeriodPicker value={period} onChange={setPeriod} allowCustom={false} />

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <Skeleton className="h-14 rounded-xl" />
            <Skeleton className="h-24 rounded-xl" />
            <Skeleton className="h-32 rounded-xl" />
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-rose-500/10 p-4 text-sm text-rose-600">
            <AlertTriangle className="h-4 w-4 inline mr-1" /> {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {data && !loading && (
          <>
            {/* Time spent KPI */}
            <div className="flex items-center justify-between rounded-xl border border-border bg-bg-elevated px-5 py-3">
              <div className="flex items-center gap-3">
                <Clock className="h-5 w-5 text-emerald-500" />
                <div>
                  <p className="text-xs text-text-muted">Time on campus</p>
                  <div className="flex items-center gap-2">
                    <span className="text-2xl font-bold text-text-primary tabular-nums">{data.timeSpent.hours}h</span>
                    {data.timeSpent.lastMonthHours > 0 && (
                      <DeltaBadge
                        value={data.timeSpent.hours}
                        reference={data.timeSpent.lastMonthHours}
                        label="vs last month"
                      />
                    )}
                  </div>
                </div>
              </div>
              <span className="text-xs text-text-muted">{data.period}</span>
            </div>

            {/* Heatmap */}
            {heatGrid.length === 7 && heatMax > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">Activity heatmap (day × hour)</p>
                <div className="overflow-x-auto">
                  <div className="grid grid-rows-7 gap-0.5 min-w-[420px]">
                    {heatGrid.map((row, dow) => (
                      <div key={dow} className="flex items-center gap-0.5">
                        <span className="w-8 text-[10px] text-text-muted shrink-0">{DOW_LABELS[dow]}</span>
                        {row.map((count, hr) => (
                          <div
                            key={hr}
                            title={`${DOW_LABELS[dow]} ${hr}:00 — ${count}`}
                            className={cn(
                              "h-3.5 flex-1 rounded-sm",
                              count === 0
                                ? "bg-bg-surface border border-border"
                                : "bg-emerald-500"
                            )}
                            style={
                              count > 0
                                ? { opacity: 0.3 + 0.7 * (count / heatMax) }
                                : undefined
                            }
                          />
                        ))}
                      </div>
                    ))}
                  </div>
                  <div className="flex justify-between text-[10px] text-text-muted mt-1 px-8">
                    <span>12a</span>
                    <span>6a</span>
                    <span>12p</span>
                    <span>6p</span>
                    <span>11p</span>
                  </div>
                </div>
              </div>
            )}

            {/* Upcoming */}
            {scheduleItems.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">Upcoming</p>
                <ScheduleStrip items={scheduleItems} />
              </div>
            )}

            {/* Activity list */}
            {data.activity.length > 0 ? (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">
                  Recent scans ({data.activity.length})
                </p>
                <div className="space-y-1">
                  {data.activity.slice(0, 8).map((a, i) => (
                    <div
                      key={i}
                      className="flex items-center gap-2 rounded-lg bg-bg-elevated px-3 py-2 text-xs"
                    >
                      <MapPin className={cn("h-3.5 w-3.5 shrink-0", a.direction === "IN" ? "text-emerald-500" : "text-rose-500")} />
                      <span className="font-medium text-text-primary">
                        {a.direction === "IN" ? "Entry" : "Exit"}
                      </span>
                      <span className="text-text-muted">{a.gate}</span>
                      <span className="ml-auto text-text-muted tabular-nums">
                        {a.date}
                        {a.timeIn ? ` ${a.timeIn}` : ""}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <EmptyState title="No activity in this period" />
            )}
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default ChildActivityReviewPanel;
