"use client";

/* ── DecisionCard ── */

import { memo } from "react";
import { cn } from "@/lib/utils";
import {
  AlertTriangle,
  Check,
  Clock,
  ExternalLink,
  UserPlus,
  X,
} from "lucide-react";

export const DecisionCard = memo(function DecisionCard({
  ticket, title, subtitle, reason, urgency = "due",
  slaDeadline, onApprove, onReject, onDelegate, onOpen, busy,
}: {
  ticket: string;
  title: string;
  subtitle?: string;
  reason?: string;
  urgency?: "overdue" | "due" | "info";
  slaDeadline?: string | null;
  onApprove?: () => void;
  onReject?: () => void;
  onDelegate?: () => void;
  onOpen?: () => void;
  busy?: boolean;
}) {
  const accent = { overdue: "border-l-rose-500", due: "border-l-amber-500", info: "border-l-slate-300" }[urgency];
  return (
    <div className={cn(
      "group flex items-start gap-4 rounded-xl border border-border border-l-4 bg-bg-surface p-4",
      "transition-shadow hover:shadow-card-hover", accent,
    )}>
      <div className="min-w-0 flex-1">
        <button onClick={onOpen} className="block w-full text-left">
