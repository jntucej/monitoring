<file path="src/app/(admin)/admin/gates/[id]/page.tsx">
"use client";


import { useEffect, useState } from "react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useParams, useRouter } from "next/navigation";
import { motion } from "framer-motion";
import {
  ArrowLeft,
  Activity,
  UserCheck,
  Clock,
  CheckCircle2,
  RefreshCw,
  TrendingUp,
  Lock,
  Power,
  Compass,
} from "lucide-react";
import { StatCard } from "@/components/admin/StatCard";
import { useApi } from "@/hooks/useApi";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageLoading } from "@/components/admin/shared/LoadingStates";
import { ConfirmDialog } from "@/components/admin/shared/ConfirmDialog";
import { CommandPivotDrawer, type CommandPivotTarget } from "@/components/nav/level3/CommandPivotDrawer";
import { useAuthStore } from "@/stores/authStore";
import { resolveGateEventAbility, makeViewer, type RecordEventAbility } from "@/lib/record-abilities";
import { getGateEventRulesForRole } from "@/lib/gate-event-rules";
import { RecordAbilityBanner } from "@/components/shared/RecordAbilityBanner";

interface GateMetrics {
  gateId: string;
  gateCode: string;
  gateName: string;
  location: string;
  type: string;
  status: "ACTIVE" | "INACTIVE" | string;
  activeOperator: { name: string; email: string | null; since: string } | null;
  scansToday: number | null;
  entriesToday: number | null;
  exitsToday: number | null;
  peakHour: string | null;
  recentScans: Array<{
    id: string;
    personName: string;
    personRole: string;
    direction: "IN" | "OUT" | string;
    reason: string | null;
    operator: string | null;
    timestamp: string;
  }>;
}

export default function GateDetailPage() {
  const api = useApi();
  const params = useParams<{ id: string }>();
  const gateId = params?.id || "";
  const router = useRouter();

  const [loading, setLoading] = useState(true);
  const [data, setData] = useState<GateMetrics | null>(null);
  const [operatorNote, setOperatorNote] = useState<string | null>(null);
  const [confirmDeactivate, setConfirmDeactivate] = useState(false);
  const [toggleBusy, setToggleBusy] = useState(false);
  const [pivot, setPivot] = useState<CommandPivotTarget | null>(null);

  const isSentinel = data?.gateCode?.toUpperCase() === "UNKNOWN";

  // Role-ability layer: why THIS viewer manages / operates this gate.
  const viewer = makeViewer(useAuthStore.getState().role, {
    userId: useAuthStore.getState().user?.id ?? "",
    assignedGateId: gateId || null,
  });
  const gateAbility: RecordEventAbility | null = data
    ? resolveGateEventAbility(
        {
          id: gateId,
          gate_code: data.gateCode,
          direction: null,
          status: data.status,
          hostel_scope: null,
        },
        viewer,
      )
    : null;

  const fetchGateDetails = async () => {
    setLoading(true);
    setOperatorNote(null);
    try {
      const headers = api.getHeaders();
      const res = await fetch(`/api/admin/gates/${gateId}/metrics`, { headers, cache: "no-store" });
      const json = await res.json();

      if (json.success && json.data) {
        setData(json.data as GateMetrics);
      } else {
        const msg =
          typeof json.error === "string" ? json.error : json.error?.message || "Failed to load gate metrics";
        setOperatorNote(msg);
      }
    } catch (e) {
      console.error("Failed to load gate detail:", e);
      setOperatorNote("Network or server error loading gate metrics");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (gateId) fetchGateDetails();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [gateId]);

  const toggleActive = async (activate: boolean) => {
    setToggleBusy(true);
    setConfirmDeactivate(false);
    setOperatorNote(null);
    try {
      const headers = api.getHeaders();
      const res = await fetch(`/api/admin/gates/${gateId}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json", ...headers },
        body: JSON.stringify({ isActive: activate }),
      });
      const json = await res.json();
      if (json.success) {
        await fetchGateDetails();
      } else {
        setOperatorNote(typeof json.error === "string" ? json.error : json.error?.message || "Toggle failed");
      }
    } catch {
      setOperatorNote("Network or server error toggling gate status");
    } finally {
      setToggleBusy(false);
    }
  };

  const gateRules = data
    ? getGateEventRulesForRole(
        {
          role: useAuthStore.getState().role ?? "admin",
          userId: useAuthStore.getState().user?.id ?? "",
          assignedGateId: gateId || null,
        },
        {
          id: gateId,
          gateCode: data.gateCode,
          gateName: data.gateName,
          status: data.status,
        },
      )
    : null;

  return (
    
      <motion.div
        initial={{ opacity: 0, y: 8 }}
        animate={{ opacity: 1, y: 0 }}
        data-role-tier={gateRules ? gateRules.tierLabel.split("•")[0].trim().toLowerCase().replace(/\s+/g, "-") : undefined}
        data-event-mode={gateRules?.mode}
        className="space-y-6"
      >
              <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Inspect a single gate's live status, recent scan log, and device health for that entry point."
        contextLabel="Admin Gates"
        why="Use this view to troubleshoot scanner faults or review unusual movement patterns at one gate."
        statusSummary="Review the current state and take action below."
      />
<div className="surface-card flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-bg-surface p-5">
          <div className="flex items-center gap-3">
            <button
              onClick={() => router.back()}
              className="surface-card p-2 bg-bg-elevated hover:bg-bg-base text-text-muted hover:text-text-primary transition-colors"
            >
              <ArrowLeft className="w-5 h-5" />
            </button>
            <div>
              <div className="flex items-center gap-2">
                <p className="text-xl font-bold text-text-primary">
                  {data?.gateName || `Gate ${gateId}`}
                </p>
                {data && (
                  <span
                    className={`px-2.5 py-0.5 rounded-full text-xs font-extrabold border ${
                      data.status === "ACTIVE"
                        ? "bg-emerald-500/10 text-action-success border-emerald-500/20"
                        : "bg-rose-500/10 text-action-danger border-rose-500/20"
                    }`}
                  >
                    {data.status}
                  </span>
                )}
              </div>
              <p className="text-xs text-text-muted mt-0.5">
                {data?.gateCode ? `${data.gateCode} — ` : ""}
                Terminal ID: {gateId} — {data?.location || "Campus Access Point"}
              </p>
            </div>
          </div>

          <div className="flex items-center gap-2 flex-wrap">
            <button
              onClick={fetchGateDetails}
              disabled={loading}
              className="surface-card px-3 py-2 bg-bg-elevated text-xs font-semibold hover:bg-bg-base flex items-center gap-1.5 transition-colors"
            >
              <RefreshCw className={`w-3.5 h-3.5 ${loading ? "animate-spin" : ""}`} />
              Refresh
            </button>
            <button
              onClick={() =>
                setPivot({
                  kind: "gate",
                  id: gateId,
                  title: data?.gateName || `Gate ${gateId}`,
                  subtitle: `${data?.gateCode ? data.gateCode + " · " : ""}${data?.location || "Campus"} · ${data?.status || ""}`,
                  fullRoute: `/admin/gates/${gateId}`,
                  relatedLinks: [
                    { label: "Gate List", href: "/admin/gates" },
                    { label: "Attendance", href: "/admin/attendance" },
                    { label: "Incidents", href: "/admin/alerts" },
                    { label: "Reports", href: "/admin/reports" },
                    { label: "Hostel", href: "/admin/occupancy" },
                    { label: "Gate Schedule", href: "/admin/gates/schedule" },
                  ],
                })
              }
              className="surface-card px-3 py-2 bg-bg-elevated text-xs font-semibold hover:bg-bg-base flex items-center gap-1.5 transition-colors"
            >
              <Compass className="w-3.5 h-3.5" /> Pivot
            </button>
            {data && !isSentinel && (
              data.status === "ACTIVE" ? (
                <button
                  onClick={() => setConfirmDeactivate(true)}
                  disabled={toggleBusy}
                  className="surface-card px-3 py-2 bg-bg-elevated text-action-danger text-xs font-semibold hover:bg-rose-500/10 flex items-center gap-1.5 transition-colors"
                >
                  <Power className="w-3.5 h-3.5" /> Deactivate
                </button>
              ) : (
                <button
                  onClick={() => toggleActive(true)}
                  disabled={toggleBusy}
                  className="surface-card px-3 py-2 bg-action-success hover:bg-action-success text-white text-xs font-bold flex items-center gap-1.5 transition-colors"
                >
                  <Power className="w-3.5 h-3.5" /> Activate
                </button>
              )
            )}
            {isSentinel && (
              <span className="surface-card flex items-center gap-1.5 px-3 py-2 bg-amber-500/10 text-action-warning text-xs font-semibold">
                <Lock className="w-3.5 h-3.5" /> System sentinel gate — read-only
              </span>
            )}
          </div>
        </div>

        {/* Role-ability banner: why this role manages/operates this gate */}
        <RecordAbilityBanner ability={gateAbility} fullRoute={`/admin/gates/${gateId}`} />

        {operatorNote && (
          <div className="surface-card p-4 bg-rose-500/10 text-action-danger text-sm flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 shrink-0" />
            <span>{operatorNote}</span>
          </div>
        )}

        {loading && !data ? (
          <PageLoading />
        ) : (
          <>
            <WidgetBoundary title="Gate Metrics">
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <StatCard
                  label="Scans Today"
                  value={data?.scansToday ?? 0}
                  icon={Activity}
                  color="var(--action-success)"
                  trend="Total throughput"
                  onClick={() => router.push("/admin/reports")}
                />
                <StatCard
                  label="Entries (IN)"
                  value={data?.entriesToday ?? 0}
                  icon={CheckCircle2}
                  color="var(--action-primary)"
                  trend="Checked in campus"
                  onClick={() => router.push("/admin/attendance")}
                />
                <StatCard
                  label="Exits (OUT)"
                  value={data?.exitsToday ?? 0}
                  icon={Clock}
                  color="var(--action-warning)"
                  trend="Checked out campus"
                  onClick={() => router.push("/admin/attendance")}
                />
                <StatCard
                  label="Peak Activity"
                  value={data?.peakHour || "N/A"}
                  icon={TrendingUp}
                  color="var(--unit-c)"
                  trend="Mode entry hour (7 days)"
                  onClick={() => router.push("/admin/analytics/predictive")}
                />
              </div>
            </WidgetBoundary>

            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              <WidgetBoundary title="Scan Stream">
                <div className="surface-card lg:col-span-2 bg-bg-surface p-5 space-y-4">
                  <div className="flex items-center justify-between">
                    <h3 className="font-bold text-sm text-text-primary flex items-center gap-2">
                      <Activity className="w-4 h-4 text-action-success" />
                      Recent Scan Activity (last 20)
                    </h3>
                    <span className="text-xs text-text-muted font-mono">Real-time</span>
                  </div>

                  <div className="overflow-x-auto -mx-4 sm:mx-0">
                    <table className="w-full text-xs text-left border-collapse min-w125">
                      <thead>
                        <tr className="border-b border-border text-text-muted uppercase tracking-wider font-semibold">
                          <th className="pb-2 px-3">Subject Name</th>
                          <th className="pb-2 px-3">Category</th>
                          <th className="pb-2 px-3">Movement</th>
                          <th className="pb-2 px-3">Scan Time</th>
                          <th className="pb-2 px-3 text-right">Operator</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-border">
                        {data?.recentScans && data.recentScans.length > 0 ? (
                          data.recentScans.map((scan) => (
                            <tr key={scan.id} className="hover:bg-bg-elevated/50 transition-colors">
                              <td className="py-3 px-3 font-semibold text-text-primary">{scan.personName}</td>
                              <td className="py-3 px-3 text-text-muted">{scan.personRole}</td>
                              <td className="py-3 px-3">
                                <span
                                  className={`px-2 py-0.5 rounded text-xs font-extrabold ${
                                    scan.direction === "IN"
                                      ? "bg-emerald-500/20 text-action-success border border-emerald-500/30"
                                      : "bg-amber-500/20 text-action-warning border border-amber-500/30"
                                  }`}
                                >
                                  {scan.direction}
                                </span>
                                {scan.reason && (
                                  <span className="ml-1.5 text-xs text-text-muted">({scan.reason})</span>
                                )}
                              </td>
                              <td className="py-3 px-3 font-mono text-text-muted">
                                {new Date(scan.timestamp).toLocaleString()}
                              </td>
                              <td className="py-3 px-3 text-right font-bold text-action-success">
                                {scan.operator || "Auto"}
                              </td>
                            </tr>
                          ))
                        ) : (
                          <tr>
                            <td colSpan={5} className="py-8 text-center text-text-muted">
                              No recent scans recorded for this gate terminal.
                            </td>
                          </tr>
                        )}
                      </tbody>
                    </table>
                  </div>
                </div>
              </WidgetBoundary>

              <WidgetBoundary title="Assigned Operator">
                <div className="space-y-4">
                  <div className="surface-card bg-bg-surface p-5 space-y-4">
                    <h3 className="font-bold text-sm text-text-primary flex items-center gap-2">
                      <UserCheck className="w-4 h-4 text-unit-c" />
                      Active Gate Operator
                    </h3>

                    {data?.activeOperator ? (
                      <div className="surface-card p-3.5 bg-bg-base flex items-center gap-3">
                        <div className="size-5 bg-purple-500/20 text-unit-c font-bold flex items-center justify-center border border-purple-500/30">
                          {data.activeOperator.name.charAt(0)}
                        </div>
                        <div>
                          <p className="text-xs font-bold text-text-primary">{data.activeOperator.name}</p>
                          <p className="text-xs text-text-muted">{data.activeOperator.email ?? "No email"}</p>
                          <span className="surface-card inline-block mt-1 px-2 py-0.5 text-xs font-bold bg-emerald-500/10 text-action-success">
                            Active On Duty
                          </span>
                        </div>
                      </div>
                    ) : (
                      <p className="text-xs text-text-muted italic">No operator currently on duty at this gate.</p>
                    )}

                    {!isSentinel && (
                      <p className="text-xs text-text-muted">
                        Reassigning the operator is managed from the operator desk
                        (<button onClick={() => router.push(`/gate/${gateId}`)} className="underline font-semibold text-action-success">
                          open operator desk
                        </button>)
                        — this page is read-only for operator assignment.
                      </p>
                    )}
                  </div>
                </div>
              </WidgetBoundary>
            </div>
          </>
        )}

        <ConfirmDialog
          open={confirmDeactivate}
          onClose={() => setConfirmDeactivate(false)}
          title="Deactivate gate?"
          body={
            data
              ? `This will mark '${data.gateCode} (${data.gateName})' as inactive. New scans will be flagged but will still be recorded. This action is audited.`
              : "Deactivate this gate?"
          }
          confirmText="Deactivate"
          variant="destructive"
          onConfirm={() => toggleActive(false)}
        />

        <CommandPivotDrawer target={pivot} onClose={() => setPivot(null)} />
      </motion.div>
    
    

  );
}
