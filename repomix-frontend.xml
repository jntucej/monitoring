"use client";

import { useMemo, useState } from "react";
import { usePersistentQuery } from "@/hooks/usePersistentQuery";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";

import { PageLoading } from "@/components/admin/shared/LoadingStates";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import {
  GitBranch,
  FileCheck,
  Clock,
  Search,
  X,
  Lock,
  CheckCircle2,
  XCircle,
} from "lucide-react";
import Link from "next/link";
import { Suspense } from "react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
/* ── response shape (mirrors /api/admin/workflow-configuration) ───────────── */

interface WorkflowStat {
  workflow_type: string;
  current_stage: string;
  open: number;
  pending: number;
  completed: number;
  rejected: number;
  last_active: string | null;
}

interface PassTypeConfig {
  code: string;
  name: string;
  requires_approval: boolean;
  approval_flow: string | null;
  is_active: boolean;
  sla_hours: number;
  volume_total: number;
  volume_pending: number;
  workflow: WorkflowStat | null;
}

interface WorkflowConfigData {
  pass_types: PassTypeConfig[];
  workflow_stats: WorkflowStat[];
  note?: string;
}

function AdminWorkflowConfigurationInner() {
  const [query, setQuery] = usePersistentQuery("gate-admin-workflow-query");

  const res = useApiResource<{ success: boolean; data: WorkflowConfigData }>("/api/admin/workflow-configuration", { ttlMs: 30_000 });

  usePolling(
    () => {
      clearCache("/api/admin/workflow-configuration");
      return res.refresh();
    },
    { intervalMs: 60_000 }
  );

  const passTypes = res.data?.data?.pass_types ?? [];
  const loading = res.loading && !res.data;

  const visible = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return passTypes;
    return passTypes.filter(
      (p) =>
        p.code.toLowerCase().includes(q) ||
        p.name.toLowerCase().includes(q)
    );
  }, [passTypes, query]);

  const totalPending = useMemo(
    () => passTypes.reduce((sum, p) => sum + (p.volume_pending || 0), 0),
    [passTypes]
  );

  return (
    <div className="space-y-4">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Pass types, pending requests, and approval routing"
        why="Workflow changes here affect every pending and new request of that type immediately."
        contextLabel="Pass types, pending requests, and approval routing"
        statusSummary="Review current pass types, pending requests, and approval routing state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
