<file path="src/app/(approver)/vice-principal/department-performance/page.tsx">
"use client";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { Suspense, useMemo } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";
import { useApiResource } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { Loader2, Inbox, Building2, TrendingUp, Users, School } from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";


interface DepartmentRow {
  code: string;
  name: string;
  hod?: string;
  totalStudents?: number;
  facultyCount?: number;
}

interface DepartmentsResponse {
  success: boolean;
  data: DepartmentRow[];
}

interface CampusAnalyticsResponse {
  success: boolean;
  data?: {
    role?: string;
    metrics?: Array<{ key: string; label: string; value: number; unit?: string }>;
    seriesData?: Array<Record<string, string | number>>;
  };
}

function VpDepartmentPerformanceInner() {
  const {
    data: departments,
    loading: deptLoading,
    error: deptError,
    refresh: refreshDepts,
  } = useApiResource<DepartmentsResponse>("/api/departments", { ttlMs: 60_000 });

  const { data: analytics, refresh: refreshAnalytics } =
    useApiResource<CampusAnalyticsResponse>(
      "/api/campus-extra/analytics?role=vice_principal",
      { ttlMs: 30_000 }
    );

  usePolling(refreshDepts, { intervalMs: 60_000, enabled: true });

  const deptList = (departments?.data ?? []) as DepartmentRow[];

  const comparison = useMemo(() => {
    const sorted = [...deptList].sort((a, b) => (b.totalStudents ?? 0) - (a.totalStudents ?? 0));
    const max = Math.max(1, ...sorted.map((d) => d.totalStudents ?? 0));
    return sorted.map((d, i) => ({
      ...d,
      rank: i + 1,
      pct: Math.round(((d.totalStudents ?? 0) / max) * 100),
    }));
  }, [deptList]);

  const totals = useMemo(() => {
    return {
      students: deptList.reduce((sum, d) => sum + (d.totalStudents ?? 0), 0),
      faculty: deptList.reduce((sum, d) => sum + (d.facultyCount ?? 0), 0),
      departments: deptList.length,
    };
  }, [deptList]);

  return (
    <div className="mx-auto max-w-7xl space-y-5 px-4 py-6 md:px-6 min-w-0">
      <ContextSituationBar
        roleLabel="Vice Principal"
        purpose="Cross-departmental academic performance monitoring, attendance rates, and KPI evaluation"
        why="Comparative departmental radar analytics identify underperforming programs and highlight best practices across faculties."
        contextLabel="Department Performance Radar"
        statusSummary="Evaluate academic metrics, department attendance benchmarks, and faculty workload distributions."
        primaryAction={{ label: "Academic Departments", href: "/vice-principal/academics/departments" }}
        secondaryAction={{ label: "Attendance Exceptions", href: "/vice-principal/attendance-exceptions" }}
      />
      <WidgetBoundary title="Department Performance">
        <div className="surface-card bg-bg-base p-4 min-w-0">
          <div className="flex items-center gap-2 text-text-muted mb-3 min-w-0">
            <Building2 className="w-4 h-4 shrink-0" />
            <span className="text-xs font-semibold uppercase tracking-wide">
              Cross-Department Comparison
            </span>
          </div>

          {/* KPI row */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-4 min-w-0">
            <div className="surface-card bg-bg-elevated/40 p-3 min-w-0">
              <div className="flex items-center gap-2 text-text-muted">
                <School className="w-4 h-4" />
                <span className="text-xs uppercase tracking-wide">Departments</span>
              </div>
              <p className="text-xl font-bold text-white">{totals.departments}</p>
            </div>
            <div className="surface-card bg-bg-elevated/40 p-3 min-w-0">
              <div className="flex items-center gap-2 text-text-muted">
                <Users className="w-4 h-4" />
                <span className="text-xs uppercase tracking-wide">Total Students</span>
              </div>
              <p className="text-xl font-bold text-action-info">{totals.students || "—"}</p>
            </div>
            <div className="surface-card bg-bg-elevated/40 p-3 min-w-0">
              <div className="flex items-center gap-2 text-text-muted">
                <TrendingUp className="w-4 h-4" />
                <span className="text-xs uppercase tracking-wide">Faculty</span>
              </div>
              <p className="text-xl font-bold text-action-success">{totals.faculty || "—"}</p>
            </div>
          </div>

          {deptError && (
            <div className="surface-card mb-3 bg-amber-500/10 p-3 text-xs text-action-warning">
              Department data unavailable right now: {deptError}
            </div>
          )}

          {deptLoading && !departments ? (
            <div className="space-y-2 min-w-0">
              {[0, 1, 2].map((i) => (
                <div key={i} className="h-8 rounded-lg bg-bg-elevated/60 animate-pulse" />
              ))}
            </div>
          ) : comparison.length === 0 ? (
            <div className="p-6 text-center">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">
                No department performance data yet.
              </p>
            </div>
          ) : (
            <div className="space-y-3 min-w-0">
              {comparison.map((d) => (
                <div key={d.code} className="min-w-0">
                  <div className="flex items-center justify-between gap-2 text-sm mb-1">
                    <span className="text-text-secondary truncate">
                      <span className="text-text-muted font-mono text-xs mr-2">#{d.rank}</span>
                      {d.name}
                    </span>
                    <span className="text-text-muted text-xs shrink-0">
                      {d.totalStudents ?? 0} students · {d.facultyCount ?? 0} faculty
                    </span>
                  </div>
                  <div className="h-2 rounded-full bg-bg-elevated overflow-hidden" role="presentation">
                    <div
                      className="h-full rounded-pill bg-action-info transition-all motion-reduce:transition-none"
                      style={{ width: `${d.pct}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </WidgetBoundary>

      <WidgetBoundary title="Role Analytics Signal">
        <div className="surface-card bg-bg-base p-4 min-w-0">
          <div className="flex items-center gap-2 text-text-muted mb-3 min-w-0">
            <TrendingUp className="w-4 h-4 shrink-0" />
            <span className="text-xs font-semibold uppercase tracking-wide">
              Institutional Turnaround & Queue Signals
            </span>
          </div>
          {analytics?.data?.metrics && analytics.data.metrics.length > 0 ? (
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 min-w-0">
              {analytics.data.metrics.map((m) => (
                <div key={m.key} className="surface-card bg-bg-elevated/40 p-3 min-w-0">
                  <p className="text-xs text-text-muted truncate">{m.label}</p>
                  <p className="text-lg font-bold text-white">
                    {m.value}
                    {m.unit ? <span className="text-xs text-text-muted ml-1">{m.unit}</span> : null}
                  </p>
                </div>
              ))}
            </div>
          ) : (
            <p className="text-sm text-text-muted">
              No role analytics signals for this period. Full analytics are available to the
              Principal and Administrator desks.
            </p>
          )}
          <button
            type="button"
            onClick={() => {
              void refreshAnalytics();
            }}
            className="surface-card mt-4 inline-flex items-center gap-1.5 bg-bg-elevated px-3 py-1.5 text-xs text-text-secondary hover:bg-bg-elevated transition-colors"
          >
            <Loader2 className={`w-3.5 h-3.5 ${!analytics ? "animate-spin" : "hidden"}`} />
            Refresh signals
          </button>
        </div>
      </WidgetBoundary>
    </div>
  );
}
export default function VpDepartmentPerformancePage() {
  return (
    <AuthGuard allowedRoles={['vice_principal', 'exam_branch', 'oie', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <VpDepartmentPerformanceInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(approver)/vice-principal/escalated-requests/page.tsx">
"use client";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { Suspense, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";
import { RequestTimeline } from "@/components/shared/RequestTimeline";
import { useApiResource } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { Inbox, ChevronDown, ChevronUp } from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { escalationInspection } from "@/components/approver/wardenConsoleModels";


interface PermissionRequestRow {
  id: string;
  ticket_number: string;
  workflow_type: string;
  current_stage: string;
  status: string;
  sla_deadline?: string | null;
  student?: {
    name: string;
    student_details?: { roll?: string } | null;
  } | null;
}

interface PermissionsResponse {
  success: boolean;
  data: PermissionRequestRow[];
  total?: number;
}

function VpEscalatedInner() {
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const inspectRow = (r: PermissionRequestRow) => {
    inspect(
      escalationInspection({
        id: r.id,
        ticket_number: r.ticket_number,
        workflow_type: r.workflow_type,
        current_stage: r.current_stage,
        status: r.status,
        sla_deadline: r.sla_deadline ?? null,
        created_at: null,
        student: r.student
          ? { name: r.student.name, student_details: r.student.student_details ? { roll: r.student.student_details.roll } : null }
          : null,
      }),
    );
  };

  const {
    data: escalated,
    loading: queueLoading,
    error: queueError,
    refresh: refreshQueue,
  } = useApiResource<PermissionsResponse>("/api/permissions?status=ESCALATED", {
    ttlMs: 30_000,
  });

  usePolling(refreshQueue, { intervalMs: 30_000, enabled: true });

  const [openTicket, setOpenTicket] = useState<string | null>(null);
  const rows = (escalated?.data ?? []) as PermissionRequestRow[];

  return (
    <div className="mx-auto max-w-7xl space-y-5 px-4 py-6 md:px-6 min-w-0">
      <ContextSituationBar
        roleLabel="Vice Principal"
        purpose="Review urgent requests escalated beyond normal departmental resolution thresholds"
        why="Executive intervention on escalated requests unblocks students facing urgent extenuating circumstances or timeline constraints."
        contextLabel="Escalated Requests Queue"
        statusSummary={rows.length > 0 ? `${rows.length} urgent escalations requiring executive review.` : "All escalated items resolved."}
        severity={rows.length > 0 ? "warn" : "ok"}
        primaryAction={{ label: "Pending Approvals", href: "/vice-principal/pending-approvals" }}
        secondaryAction={{ label: "Decision History", href: "/vice-principal/decision-history" }}
      />
      <WidgetBoundary title="Escalated Requests">
        <div className="surface-card bg-bg-base p-4 min-w-0">
          <div className="flex items-center gap-2 text-text-muted mb-3 min-w-0">
            <Inbox className="w-4 h-4 shrink-0" />
            <span className="text-xs font-semibold uppercase tracking-wide">
              Requests escalated for senior review
            </span>
          </div>

          {queueError && (
            <div className="surface-card mb-3 bg-amber-500/10 p-3 text-xs text-action-warning">
              Escalated list failed to load: {queueError}
            </div>
          )}

          {queueLoading && !escalated ? (
            <div className="space-y-2 min-w-0">
              {[0, 1].map((i) => (
                <div key={i} className="h-14 rounded-lg bg-bg-elevated/60 animate-pulse" />
              ))}
            </div>
          ) : rows.length === 0 ? (
            <div className="p-6 text-center">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No escalated requests right now.</p>
            </div>
          ) : (
            <ul className="space-y-3 min-w-0">
              {rows.slice(0, 10).map((r) => {
                const open = openTicket === r.ticket_number;
                return (
                  <li
                    key={r.id}
                    className="surface-card bg-bg-surface/40 p-3 min-w-0 cursor-pointer hover:bg-bg-elevated/30 transition-colors"
                    onClick={() => inspectRow(r)}
                  >
                    <div className="flex flex-wrap items-center gap-2" onClick={(e) => e.stopPropagation()}>
                      <span className="font-mono text-xs text-action-warning">{r.ticket_number}</span>
                      <span className="text-sm text-text-secondary truncate min-w-0 flex-1">
                        {r.student?.name || "—"}
                        {r.student?.student_details?.roll
                          ? ` · ${r.student.student_details.roll}`
                          : ""}
                      </span>
                      <span className="text-xs text-text-muted capitalize whitespace-nowrap">
                        {r.workflow_type.replace(/_/g, " ")}
                      </span>
                      <span className="surface-card text-xs font-semibold text-action-warning bg-amber-500/10 px-2 py-0.5">
                        escalated → {r.current_stage}
                      </span>
                      <button
                        type="button"
                        onClick={(e) => { e.stopPropagation(); setOpenTicket(open ? null : r.ticket_number); }}
                        aria-expanded={open}
                        className="surface-card inline-flex items-center gap-1 bg-bg-elevated px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-elevated transition-colors"
                      >
                        {open ? <ChevronUp className="w-3.5 h-3.5" /> : <ChevronDown className="w-3.5 h-3.5" />}
                        {open ? "Hide timeline" : "Timeline"}
                      </button>
                    </div>
                    {open && (
                      <div className="surface-card mt-4 bg-bg-base p-3 min-w-0">
                        <RequestTimeline ticket={r.ticket_number} compact />
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
