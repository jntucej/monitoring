<file path="src/components/sysadmin/SecurityManagement.tsx">
"use client";

import React, { useEffect, useState } from "react";
import { useUIStore } from "@/stores/uiStore";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";

import { ShieldAlert, Lock, Globe, RefreshCw } from "lucide-react";
import { useApi } from "@/hooks/useApi";

interface SecurityStats {
  failedLogins24h: number;
  activeSessions: number;
  ipAllowlistEnabled: boolean;
  allowedIps: string[];
}

export function SecurityManagement() {
const api = useApi();

  const { addToast } = useUIStore();
  const [stats, setStats] = useState<SecurityStats | null>(null);
  const [loading, setLoading] = useState(true);
  const [ipInput, setIpInput] = useState("");

  const fetchStats = async () => {
    setLoading(true);
    try {
      const headers = api.getHeaders();
      const res = await fetch("/api/admin/security/stats", { headers });
      const result = await res.json();
      if (result.success && result.data) {
        setStats(result.data);
        setIpInput((result.data.allowedIps || []).join(", "));
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to load stats" });
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { fetchStats(); }, []);

  const handleSave = async () => {
    try {
      const headers = api.getHeaders();
      const ips = ipInput.split(",").map((s) => s.trim()).filter(Boolean);
      const res = await fetch("/api/admin/security/ip-allowlist", {
        method: "POST",
        headers,
        body: JSON.stringify({ allowedIps: ips }),
      });
      const result = await res.json();
      if (result.success) {
        setStats(result.data);
        addToast({ variant: "success", title: "Saved", message: "Security settings updated" });
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to update security settings" });
    }
  };

  if (loading) return (
    <div className="flex items-center gap-2 p-6 text-sm text-text-secondary">
      <RefreshCw className="w-4 h-4 animate-spin" /> Loading...
    </div>
  );
  if (!stats) return (
    <div className="p-6 text-action-danger text-sm">
      Failed to load. <button onClick={fetchStats} className="underline">Retry</button>
    </div>
  );

  return (
    <div className="space-y-6">
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <Card>
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-xs font-semibold text-text-secondary uppercase">Failed Logins (24h)</CardTitle>
            <ShieldAlert className="h-4 w-4 text-action-warning" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold text-text-primary">{stats?.failedLogins24h || 0}</div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-xs font-semibold text-text-secondary uppercase">Active Sessions</CardTitle>
            <Lock className="h-4 w-4 text-cyan-400" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold text-text-primary">{stats?.activeSessions || 0}</div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-xs font-semibold text-text-secondary uppercase">IP Policy</CardTitle>
            <Globe className="h-4 w-4 text-unit-c" />
          </CardHeader>
          <CardContent>
            <div className="text-lg font-semibold text-text-primary">{stats?.ipAllowlistEnabled ? "Allowlist" : "Open"}</div>
          </CardContent>
        </Card>
      </div>

      <Card>
        <CardHeader>
          <CardTitle>Zero-Trust IP Allowlist & Security Controls</CardTitle>
        </CardHeader>
        <CardContent className="space-y-4">
          <div>
            <label className="block text-xs font-medium text-text-secondary mb-1" htmlFor="allowed-subnets-ips">Allowed Subnets / IPs</label>
            <input id="allowed-subnets-ips"
              type="text"
              value={ipInput}
              onChange={(e) => setIpInput(e.target.value)}
              className="surface-card w-full bg-bg-surface px-3 py-2 text-xs text-text-primary"
            />
          </div>

          <Button variant="primary" size="sm" onClick={handleSave}>Save Security Policies</Button>
        </CardContent>
      </Card>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/Sidebar.tsx">
"use client";

/**
 * Sidebar — the collapsible 11-category manifest-driven shell for the sysadmin
 * Command Center. Replaces the old RoleConsole IconRail.
 *
 * - Drives its tree of categories/pages from the IA manifest
 *   (packages/sysadmin-console-kit/manifest/ia.json).
 * - Collapsible per-category (localStorage-persisted) plus a global
 *   collapsed / expanded mode (icon-only rail).
 * - Renders a live "infographic" mini next to each category header, driven by
 *   the manifest's `infographic` spec + a live overview payload polled at the
 *   layout level.
 * - Auto-expands the category that contains the current route and highlights
 *   the active page row with aria-current + a live count badge.
 */
import { useCallback, useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import {
  LayoutDashboard,
  Users,
  ShieldCheck,
  DoorOpen,
  Activity,
  Bell as BellIcon,
  Clock,
  Database,
  Layers,
  Settings,
  Scale,
  Menu,
  ChevronRight,
  ChevronsDownUp,
  ChevronsUpDown,
  ArrowUpRight,
  type LucideIcon,
} from "lucide-react";
import { cn } from "@/lib/utils";
import { SidebarInfographic } from "./SidebarInfographic";
import { ProfileMenuButton } from "@/components/shared/ProfileMenuButton";
import { RoleLogoutButton } from "@/components/shared/RoleLogoutButton";
import manifest from "../../../packages/sysadmin-console-kit/manifest/ia.json";

// ── Payload shape ─────────────────────────────────────────────────────────
export interface OverviewPayload {
  command?: { health: string[] };
  identity?: { active: number; suspended: number; deprovisioned: number };
  access?: { mfaCoverage: number };
  gates?: { status: string[] };
  monitoring?: { errorRate24h: number[] };
  alerts?: { critical: number; high: number; medium: number; low: number };
  automation?: { runs14d: number[] };
  data?: { backupFreshness: number };
  reference?: { departments: number; courses: number; sections: number };
  platform?: { envDrift: number; schemaDrift: number };
  governance?: { events7d: number[] };
  counts?: Record<string, number>;
}

// ── Manifest shape (subset the Sidebar consumes) ──────────────────────────
interface ManifestPage {
  id: string;
  route: string;
  title: string;
  kind?: string;
  pollMs?: number;
  sse?: string;
  children?: ManifestPage[];
  api?: Record<string, string>;
  drawer?: Record<string, unknown>;
  tabs?: unknown[];
}

interface ManifestCategory {
  id: string;
  label: string;
  icon: string;
  order: number;
  hidden?: boolean;
  infographic?: { kind: string; source: string; color?: string };
  pages: ManifestPage[];
}

interface Manifest {
  version: string;
  categories: ManifestCategory[];
  personal?: ManifestPage[];
}

// Manifest JSON is typed structurally by tsconfig; we rebind it to our
// concrete interface so the rest of the file can use a well-shaped view.
const ia = manifest as unknown as Manifest;

// ── Icon registry (manifest "icon" string → component) ───────────────────
const ICONS: Record<string, LucideIcon> = {
  LayoutDashboard,
  Users,
  ShieldCheck,
  DoorOpen,
  Activity,
  Bell: BellIcon,
  Clock,
  Database,
  Layers,
  Settings,
  Scale,
  Menu,
};

function iconFor(name: string): LucideIcon {
  return ICONS[name] ?? Activity;
}

// ── LocalStorage keys ─────────────────────────────────────────────────────
const OPEN_KEY = "sysadmin:sidebar:open";
const COLLAPSED_KEY = "sysadmin:sidebar:collapsed";

function loadGroupOpen(pageId: string): boolean | null {
  if (typeof window === "undefined") return null;
  try {
    const raw =
      window.localStorage.getItem(`sysadmin:sidebar:page:${pageId}`) ??
      window.localStorage.getItem(pageId);
    if (raw !== null) {
      return raw === "1" || raw === "true" || raw === "open";
    }
  } catch {
    return null;
  }
  return null;
}

function saveGroupOpen(pageId: string, isOpen: boolean) {
  if (typeof window === "undefined") return;
  try {
    window.localStorage.setItem(`sysadmin:sidebar:page:${pageId}`, isOpen ? "1" : "0");
    window.localStorage.setItem(pageId, isOpen ? "1" : "0");
  } catch {
    /* no-op */
  }
}

function loadOpenState(): Record<string, boolean> {
  if (typeof window === "undefined") return {};
  try {
    const raw = window.localStorage.getItem(OPEN_KEY);
    return raw ? (JSON.parse(raw) as Record<string, boolean>) : {};
  } catch {
    return {};
  }
}

function loadCollapsed(): boolean {
  if (typeof window === "undefined") return false;
  try {
    return window.localStorage.getItem(COLLAPSED_KEY) === "1";
  } catch {
    return false;
  }
}

// ── Component ─────────────────────────────────────────────────────────────
export interface SidebarProps {
  overview: OverviewPayload | null;
  /** Force the rail to its expanded (label-visible) width regardless of the
   *  stored collapsed state. Used by the mobile off-canvas drawer, which is
   *  always wide enough to show labels. */
  forceExpanded?: boolean;
  /** Fire after any nav link is activated. The mobile drawer uses this to
   *  close itself on successful navigation. */
  onNavigate?: () => void;
}

export function Sidebar({ overview, forceExpanded, onNavigate }: SidebarProps) {
  const pathname = usePathname();

  const [showAll, setShowAll] = useState(false);
  const categories = useMemo(
    () =>
      [...ia.categories]
        .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
        .filter((c) => showAll || !c.hidden),
    [showAll]
  );

  // Per-category open map. Hydrate from localStorage on mount, default to
  // "all open" so the user sees every category on first visit.
  const [open, setOpen] = useState<Record<string, boolean>>({});
  const [hydratedOpen, setHydratedOpen] = useState(false);
  const [collapsed, setCollapsed] = useState(false);
  const [hydratedCollapsed, setHydratedCollapsed] = useState(false);

  // Effective collapsed state: forceExpanded overrides the stored value.
  const isCollapsed = forceExpanded ? false : collapsed;

  // Hydrate persisted state.
  useEffect(() => {
    setOpen((prev) => {
      const stored = loadOpenState();
      if (Object.keys(stored).length === 0) {
        // Default: all open.
        const all: Record<string, boolean> = {};
        categories.forEach((c) => {
          all[c.id] = true;
        });
        // Merge with any initial state.
        return { ...all, ...prev };
      }
      // Use stored values, filling missing categories with true.
      const merged: Record<string, boolean> = { ...prev };
      categories.forEach((c) => {
        if (!(c.id in stored)) merged[c.id] = true;
        else merged[c.id] = stored[c.id];
      });
      return merged;
    });
    setHydratedOpen(true);
  }, [categories]);

  useEffect(() => {
    setCollapsed(loadCollapsed());
    setHydratedCollapsed(true);
  }, []);

  // Persist when the open map changes after hydration.
  useEffect(() => {
    if (!hydratedOpen) return;
    if (typeof window === "undefined") return;
    try {
      window.localStorage.setItem(OPEN_KEY, JSON.stringify(open));
    } catch {
      /* no-op */
    }
  }, [open, hydratedOpen]);

  // Persist collapsed flag.
  useEffect(() => {
    if (!hydratedCollapsed) return;
    if (typeof window === "undefined") return;
    try {
      window.localStorage.setItem(COLLAPSED_KEY, collapsed ? "1" : "0");
    } catch {
      /* no-op */
    }
  }, [collapsed, hydratedCollapsed]);

  const [groupOpen, setGroupOpen] = useState<Record<string, boolean>>({});

  // Initial group hydration
  useEffect(() => {
    const initial: Record<string, boolean> = {};
    categories.forEach((cat) => {
      cat.pages.forEach((p) => {
        if (p.children && p.children.length > 0) {
          const stored = loadGroupOpen(p.id);
          const pageUrl = p.route ? `/sysadmin/${p.route}` : "/sysadmin";
          const isUnder =
            pathname === pageUrl ||
            pathname.startsWith(pageUrl + "/") ||
            p.children.some((c) => {
              const cUrl = c.route ? `/sysadmin/${c.route}` : "/sysadmin";
              return pathname === cUrl || pathname.startsWith(cUrl + "/");
            });
          if (stored !== null) {
            initial[p.id] = stored || isUnder;
          } else {
            initial[p.id] = isUnder;
          }
        }
      });
    });
    setGroupOpen((prev) => ({ ...initial, ...prev }));
  }, [categories, pathname]);

  // When collapsed, if the current path starts with page.route, auto-expand the group
  useEffect(() => {
    categories.forEach((cat) => {
      cat.pages.forEach((p) => {
        if (p.children && p.children.length > 0) {
          const pageUrl = p.route ? `/sysadmin/${p.route}` : "/sysadmin";
          const matches =
            pathname === pageUrl ||
            pathname.startsWith(pageUrl + "/") ||
            p.children.some((c) => {
              const cUrl = c.route ? `/sysadmin/${c.route}` : "/sysadmin";
              return pathname === cUrl || pathname.startsWith(cUrl + "/");
            });
          if (matches) {
            setGroupOpen((prev) => {
              if (prev[p.id]) return prev;
              saveGroupOpen(p.id, true);
              return { ...prev, [p.id]: true };
            });
          }
        }
      });
    });
  }, [categories, pathname]);

  const toggleGroup = useCallback((pageId: string) => {
    setGroupOpen((prev) => {
      const current = prev[pageId] ?? loadGroupOpen(pageId) ?? false;
      const next = !current;
      saveGroupOpen(pageId, next);
      return { ...prev, [pageId]: next };
    });
  }, []);

  // Auto-expand the category containing the current pathname.
  const containingCatId = useMemo(() => {
    const active = categories.find((c) =>
      c.pages.some((p) => {
        const url = p.route ? `/sysadmin/${p.route}` : "/sysadmin";
        if (pathname === url || pathname.startsWith(url + "/")) return true;
        if (
          p.children?.some((child) => {
            const childUrl = child.route ? `/sysadmin/${child.route}` : "/sysadmin";
            return pathname === childUrl || pathname.startsWith(childUrl + "/");
          })
        ) {
          return true;
        }
        return false;
      })
    );
    return active?.id ?? null;
  }, [categories, pathname]);

  useEffect(() => {
    if (!hydratedOpen || !containingCatId) return;
    setOpen((prev) =>
      prev[containingCatId] ? prev : { ...prev, [containingCatId]: true }
    );
  }, [containingCatId, hydratedOpen]);

  const toggleCat = useCallback((id: string) => {
    setOpen((prev) => ({ ...prev, [id]: !prev[id] }));
  }, []);

  const collapseAll = useCallback(() => {
    setOpen((prev) => {
      const next: Record<string, boolean> = { ...prev };
      categories.forEach((c) => {
        next[c.id] = false;
      });
      return next;
    });
  }, [categories]);

  const expandAll = useCallback(() => {
    setOpen((prev) => {
      const next: Record<string, boolean> = { ...prev };
      categories.forEach((c) => {
        next[c.id] = true;
      });
      return next;
    });
  }, [categories]);

  // Personal footer routes (manifest `personal`).
  const personalRoutes = useMemo(() => ia.personal ?? [], []);

  const widthClass = isCollapsed ? "w-16" : "w-64";

  return (
    <aside
      className={cn(
        "shrink-0 border-r border-border flex flex-col",
        widthClass,
        "transition-[width] duration-200"
      )}
      aria-label="Sysadmin navigation"
    >
      {/* Top bar: brand + collapse toggle + expand/collapse all */}
      <div className="surface-card flex items-center gap-2 px-3 py-3">
        <button
          type="button"
          onClick={() => (forceExpanded ? undefined : setCollapsed((v) => !v))}
          aria-label={isCollapsed ? "Expand sidebar" : "Collapse sidebar"}
          aria-expanded={!isCollapsed}
          className={cn(
            "inline-flex items-center justify-center p-1.5",
            "text-text-muted",
            "focus:outline-none focus-visible:ring-2 focus-visible:ring-action-primary",
            "transition-colors"
          )}
        >
          {isCollapsed ? <Menu className="h-4 w-4" /> : <ChevronsDownUp className="h-4 w-4" />}
        </button>
        {!isCollapsed && (
          <>
            <span className="text-sm font-semibold tracking-tight flex-1 min-w-0 truncate">
              Sysadmin
            </span>
            <button
              type="button"
              onClick={collapseAll}
              title="Collapse all"
              className="surface-card inline-flex items-center justify-center p-1 text-text-muted hover:text-text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-action-primary hover:bg-bg-elevated"
            >
              <ChevronsDownUp className="h-4 w-4" />
            </button>
            <button
              type="button"
              onClick={expandAll}
              title="Expand all"
              className="surface-card inline-flex items-center justify-center p-1 text-text-muted hover:text-text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-action-primary hover:bg-bg-elevated"
            >
              <ChevronsUpDown className="h-4 w-4" />
            </button>
            {!showAll && ia.categories.some((c) => c.hidden) && (
              <button
                type="button"
                onClick={() => setShowAll(true)}
                title="Show all categories"
                className="surface-card px-2 py-1 text-xs text-text-muted hover:text-text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-action-primary hover:bg-bg-elevated"
              >
                Show all
              </button>
            )}
          </>
        )}
      </div>

      <nav className="flex-1 overflow-y-auto py-2 px-2 space-y-1">
        {categories.map((cat) => {
          const Icon = iconFor(cat.icon);
          const isOpen = open[cat.id] ?? false;
          const isCollapsedInner = isCollapsed;

          // Collapsed rail: icon-only, clicking jumps to the category's first
          // page and also expands the sidebar for context.
          if (isCollapsedInner) {
            return (
              <div key={cat.id} className="px-1 py-1">
                <Link
                  href={`/sysadmin${cat.pages[0]?.route ? "/" + cat.pages[0].route : ""}`}
                  aria-label={cat.label}
                  title={cat.label}
                  onClick={() => {
                    if (!forceExpanded) setCollapsed(false);
                    onNavigate?.();
                  }}
                  className="flex items-center justify-center h-9 w-full text-text-muted hover:text-text-primary hover:bg-bg-elevated"
                >
                  <Icon className="h-4 w-4" />
                </Link>
              </div>
            );
          }

          return (
            <div key={cat.id} className="select-none">
              {/* Category header */}
              <div className="flex items-center gap-1 px-2 py-1.5">
                <button
                  type="button"
                  onClick={() => toggleCat(cat.id)}
                  aria-expanded={isOpen}
                  className="surface-card flex items-center gap-1.5 flex-1 min-w-0 py-0.5 hover:text-text-primary text-text-muted focus:outline-none focus-visible:ring-2 focus-visible:ring-action-primary hover:bg-bg-elevated"
                >
                  <Icon className="h-4 w-4 shrink-0" aria-hidden="true" />
                  <span className="text-xs font-medium uppercase tracking-wider truncate flex-1 text-left">
                    {cat.label}
                  </span>
                  <ChevronRight
                    className={cn(
                      "h-3.5 w-3.5 shrink-0 transition-transform",
                      isOpen ? "rotate-90" : "rotate-0"
                    )}
                    aria-hidden="true"
                  />
                </button>
                {/* Live infographic mini next to the header */}
                <div className="shrink-0 w-12 flex items-center justify-end pr-1">
                  <SidebarInfographic
                    spec={cat.infographic}
                    overview={overview}
                  />
                </div>
              </div>

              {/* Pages */}
              {isOpen && (
                <ul className="space-y-0.5 pb-1">
                  {cat.pages.map((page) => {
                    if (page.children && page.children.length > 0) {
                      const isGroupOpen = groupOpen[page.id] ?? false;
                      const groupUrl = page.route
                        ? `/sysadmin/${page.route}`
                        : "/sysadmin";
                      const isGroupActive =
                        pathname === groupUrl ||
                        pathname.startsWith(groupUrl + "/") ||
                        page.children.some((c) => {
                          const cUrl = c.route ? `/sysadmin/${c.route}` : "/sysadmin";
                          return pathname === cUrl || pathname.startsWith(cUrl + "/");
                        });

                      return (
                        <li key={page.id} className="space-y-0.5">
                          <button
                            type="button"
                            onClick={() => toggleGroup(page.id)}
                            aria-expanded={isGroupOpen}
                            className={cn(
                              "flex items-center gap-1.5 w-full px-2.5 py-1.5 text-sm font-medium transition-colors text-left",
                              isGroupActive
                                ? "text-text-primary font-medium"
                                : "text-text-muted"
                            )}
                          >
                            <span className="flex-1 truncate">{page.title}</span>
                            <ChevronRight
                              className={cn(
                                "h-3.5 w-3.5 shrink-0 transition-transform text-text-muted",
                                isGroupOpen ? "rotate-90" : "rotate-0"
                              )}
                              aria-hidden="true"
                            />
                          </button>
                          {isGroupOpen && (
                            <ul className="surface-card pl-2.5 space-y-0.5 ml-3 my-0.5">
                              {page.children.map((child) => {
                                const childHref = child.route
                                  ? `/sysadmin/${child.route}`
                                  : "/sysadmin";
                                const isChildActive =
                                  pathname === childHref || pathname.startsWith(childHref + "/");
                                const liveCount = overview?.counts?.[child.id];
                                const hasLive =
                                  liveCount !== undefined && liveCount !== null;
                                return (
                                  <li key={child.id}>
                                    <Link
                                      href={childHref}
                                      aria-current={isChildActive ? "page" : undefined}
                                      onClick={onNavigate}
                                      className={cn(
                                        "flex items-center gap-1.5 px-2.5 py-1 text-xs transition-colors",
                                        isChildActive
                                          ? "text-text-primary font-medium"
                                          : "text-text-muted"
                                      )}
                                    >
                                      <span className="flex-1 truncate">{child.title}</span>
                                      {hasLive && (
                                        <span
                                          className={cn(
                                            "ml-auto inline-flex items-center justify-center text-xs font-medium min-w4 h4 px-1",
                                            isChildActive
                                              ? "text-text-primary"
                                              : "text-text-muted"
                                          )}
                                          title={`${child.title}: ${liveCount} live`}
                                        >
                                          {liveCount}
                                        </span>
                                      )}
                                    </Link>
                                  </li>
                                );
                              })}
                            </ul>
                          )}
                        </li>
                      );
                    }

                    const href = page.route
                      ? `/sysadmin/${page.route}`
                      : "/sysadmin";
                    const isActive =
                      pathname === href || pathname.startsWith(href + "/");
                    const liveCount = overview?.counts?.[page.id];
                    const hasLive =
                      liveCount !== undefined && liveCount !== null;
                    return (
                      <li key={page.id}>
                        <Link
                          href={href}
                          aria-current={isActive ? "page" : undefined}
                          onClick={onNavigate}
                          className={cn(
                            "flex items-center gap-1.5 px-2.5 py-1.5 text-sm",
                            "transition-colors",
                            isActive
                              ? "text-text-primary font-medium"
                              : "text-text-muted"
                          )}
                        >
                          <span className="flex-1 truncate">{page.title}</span>
                          {hasLive && (
                            <span
                              className={cn(
                                "ml-auto inline-flex items-center justify-center text-xs font-medium min-w-[18px] h-[18px] px-1",
                                isActive
                                  ? "text-text-primary"
                                  : "text-text-muted"
                              )}
                              title={`${page.title}: ${liveCount} live`}
                            >
                              {liveCount}
                            </span>
                          )}
                        </Link>
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          );
        })}

        {/* Personal footer routes (manifest `personal`) */}
        {!collapsed && personalRoutes.length > 0 && (
          <div className="surface-card mt-2 pt-2 px-1">
            {personalRoutes.map((p) => {
              const href = p.route ? `/sysadmin/${p.route}` : "/sysadmin";
              const isActive =
                pathname === href || pathname.startsWith(href + "/");
              return (
                <Link
                  key={p.id}
                  href={href}
                  aria-current={isActive ? "page" : undefined}
                  onClick={onNavigate}
                  className={cn(
                    "flex items-center gap-1.5 px-2.5 py-1.5 text-sm transition-colors",
                    isActive
                      ? "text-text-primary font-medium"
                      : "text-text-muted"
                  )}
                >
                  <span className="flex-1 truncate">{p.title}</span>
                  <ArrowUpRight
                    className="h-3.5 w-3.5 opacity-60"
                    aria-hidden="true"
                  />
                </Link>
              );
            })}
          </div>
        )}
      </nav>

      {/* Account footer: profile button + appearance + sign out */}
      <div className="surface-card shrink-0 p-2 space-y-1.5">
        <ProfileMenuButton consoleRoot="/sysadmin" compact={collapsed} />
        {!collapsed && (
          <RoleLogoutButton variant="compact" className="w-full justify-center" />
        )}
      </div>
    </aside>
  );
}
