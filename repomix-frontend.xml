    ? "bg-action-primary"
    : reason === "Day Out"
    ? "bg-action-warning"
    : reason === "Leave"
    ? "bg-action-info"
    : "bg-action-danger";

  const icon = isEntry ? "⬇" : reason === "Home Out" ? "🏠" : reason === "Day Out" ? "☀️" : reason === "Leave" ? "📝" : "🚶";
