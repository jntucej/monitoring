<file path="src/components/principal/inbox/InboxList.tsx">
"use client";

import { useCallback, useState } from "react";
import { AlertCircle, Inbox, RefreshCw } from "lucide-react";
import { useSearchParams } from "next/navigation";
import { InboxCard } from "./InboxCard";
import { InboxDetailSheet } from "./InboxDetailSheet";
import { InboxBatchBar } from "./InboxBatchBar";
import { useInboxData, useInboxBatch } from "./useInboxData";
import { filtersFromParams } from "./InboxFilters";
import type { InboxFilters } from "./useInboxData";

import { clearCache } from "@/hooks/useApiResource";

export interface InboxListProps {
  title: string;
  description?: string;
  /** Fixed filters applied on top of URL params. */
  fixedFilters?: Partial<InboxFilters>;
}

/**
 * InboxList — the full inbox list: filters + cards + batch bar + detail sheet.
 * Used by inbox/page.tsx, overdue/, delegated/, escalated/, manage-approved/.
 */
export function InboxList({ title, description, fixedFilters }: InboxListProps) {
  const searchParams = useSearchParams();
  const activeFilters: InboxFilters = {
    ...filtersFromParams(searchParams),
    ...fixedFilters,
  };
  const [selected, setSelected] = useState<Set<string>>(new Set());
  const [activeTicket, setActiveTicket] = useState<string | null>(null);

  const { tickets, loading, error, refresh, total } = useInboxData(activeFilters);
  const { run: batchRun, busy, result } = useInboxBatch();

  const handleToggleSelect = useCallback((ticket: string) => {
    setSelected((prev) => {
      const next = new Set(prev);
      if (next.has(ticket)) next.delete(ticket);
      else next.add(ticket);
      return next;
    });
  }, []);

  const handleClear = useCallback(() => setSelected(new Set()), []);

  const handleBatchApprove = useCallback(async () => {
    if (selected.size === 0) return;
    await batchRun(Array.from(selected), "APPROVE");
    handleClear();
    clearCache();
  }, [selected, batchRun, handleClear]);

  const handleBatchReject = useCallback(async () => {
    if (selected.size === 0) return;
    await batchRun(Array.from(selected), "REJECT");
    handleClear();
    clearCache();
  }, [selected, batchRun, handleClear]);

  return (
    <div className="space-y-4 min-w-0 pb-16">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 min-w-0">
        <div className="min-w-0">
          <h1 className="text-lg sm:text-xl font-bold text-text-primary">{title}</h1>
          {description && (
            <p className="text-xs text-text-secondary mt-0.5">{description}</p>
          )}
          {!loading && (
            <p className="text-xs text-text-muted mt-1">{total} items</p>
          )}
        </div>
        <button
          type="button"
          onClick={() => { clearCache(); refresh(); }}
          disabled={loading}
          className="inline-flex items-center gap-1.5 text-xs text-text-muted hover:text-text-primary self-start sm:self-auto"
        >
          <RefreshCw className={`w-3.5 h-3.5 ${loading ? "animate-spin" : ""}`} />
          Refresh
        </button>
      </div>

      {/* Error */}
      {error && (
        <div className="surface-card flex items-center gap-2 p-3 bg-rose-500/10 text-action-danger text-sm">
          <AlertCircle className="w-4 h-4 shrink-0" />
          {error}
        </div>
      )}

      {/* Loading skeleton */}
      {loading && tickets.length === 0 && (
        <div className="space-y-3">
          {[0, 1, 2].map((i) => (
            <div key={i} className="h-20 rounded-xl bg-bg-elevated animate-pulse" />
          ))}
        </div>
      )}

      {/* Empty */}
      {!loading && !error && tickets.length === 0 && (
        <div className="surface-card flex flex-col items-center justify-center p-12 bg-bg-surface space-y-2">
          <Inbox className="size-6 text-text-muted" />
          <p className="text-sm text-text-secondary">No tickets match your filters.</p>
        </div>
      )}

      {/* Card list */}
      {!loading && tickets.length > 0 && (
        <div className="space-y-2.5">
          {tickets.map((ticket) => (
            <InboxCard
              key={ticket.id || ticket.ticket_number}
              ticket={ticket}
              onOpenDetail={setActiveTicket}
              selected={selected.has(ticket.ticket_number)}
              onToggleSelect={handleToggleSelect}
            />
          ))}
        </div>
      )}

      {/* Batch bar */}
      <InboxBatchBar
        selectedCount={selected.size}
        onApprove={handleBatchApprove}
        onReject={handleBatchReject}
        onClear={handleClear}
        isLoading={busy}
        lastResult={result}
      />

      {/* Detail sheet */}
      <InboxDetailSheet
        ticket={activeTicket}
        onClose={() => setActiveTicket(null)}
        onActionComplete={() => {
          clearCache();
          refresh();
        }}
      />
    </div>
  );
}
</file>

<file path="src/components/principal/shared/DecisionWorkspace.tsx">
"use client";

/**
 * DecisionWorkspace — PR-09. The unified decision/execution surface.
 *
 * Consolidates the existing approval detail (PermissionDetailPanel /
 * InboxDetailSheet) into one coherent model:
 *
 *   1. Request summary        (what's being decided)
 *   2. Requester / department (who asked — verified ref, not a guess)
 *   3. Reason + supporting info
 *   4. Current workflow stage
 *   5. Available actions      (only what the SERVER allows — see canAct)
 *   6. Confirmation gate      (consequential, possibly-irreversible actions)
 *   7. Result                 (the authoritative execution outcome — PR-10)
 *
 * Authorization rule (protocol §7.7, §12.2): the client NEVER decides what is
 * allowed. `availableActions` must come from a server check (e.g. the
 * `can-act` endpoint). This component only presents them + routes execution
 * through the PR-10 execution monitor (honest completed/failed/unknown).
 *
 * It reuses, not duplicates: the full approval detail is handed to
 * PermissionDetailPanel by ticket; this workspace adds the decision context
 * + confirmation + execution lifecycle around it.
 */
import { useState } from "react";
import type { PrincipalActionDefinition } from "@/lib/principal/contracts";
import type { ActionResult } from "@/hooks/usePrincipalAction";

export interface DecisionContext {
  /** The record being decided (its real id + a human label). */
  recordId: string;
  title: string;
  /** The requester, when the backend provides it (verified ref). */
  requester?: { label: string; role?: string } | null;
  /** One-line reason / supporting context. */
  reason?: string | null;
  /** Current workflow stage, when known. */
  stage?: string | null;
}

export interface DecisionWorkspaceProps<TInput, TOut> {
  context: DecisionContext;
  /** The actions the SERVER permits (from can-act / a permission check). */
  availableActions: PrincipalActionDefinition[];
  /** Confirmation gate for consequential actions. */
  requireConfirm?: boolean;
  /** The execution monitor (PR-10). One per consequential action. */
  executeAction: (
    action: PrincipalActionDefinition,
    input: TInput,
  ) => Promise<ActionResult<TOut>>;
  /** The last/known outcome to display (so "what happened" is visible). */
  lastOutcome?: ActionResult<TOut> | null;
  /** Optional: open the full approval detail in the shared panel. */
  renderDetail?: () => React.ReactNode;
  className?: string;
}

export function DecisionWorkspace<TInput, TOut>(
  props: DecisionWorkspaceProps<TInput, TOut>,
) {
  const {
    context,
    availableActions,
    requireConfirm = false,
    executeAction,
    lastOutcome,
    renderDetail,
    className,
  } = props;

  // Confirmation + per-action in-flight / outcome state (transient, local).
  const [pending, setPending] = useState<PrincipalActionDefinition | null>(null);
  const [reason, setReason] = useState("");
  const [busy, setBusy] = useState(false);

  const confirmNeeded = (a: PrincipalActionDefinition) =>
    requireConfirm || a.confirmationRequired;

  const runAction = async (a: PrincipalActionDefinition) => {
    setBusy(true);
    // A reason is collected only when the action demands one (honest: don't
    // fabricate a reason field the workflow doesn't record).
    const input = (a.requiresReason ? reason : "") as unknown as TInput;
    const result = await executeAction(a, input);
    setBusy(false);
    setPending(null);
    setReason("");
    // The caller persists `result` into lastOutcome; we clear local state.
    void result;
  };

  const outcome = lastOutcome;
  const showUnknown = outcome?.state === "unknown";

  return (
    <div className={className}>
      {/* 1–4: decision context (verified fields only) */}
      <div className="flex flex-col gap-2">
        <h3 className="text-base font-semibold text-text-primary">{context.title}</h3>
        {context.requester ? (
          <p className="text-xs text-text-muted">
            Requested by {context.requester.label}
            {context.requester.role ? ` · ${context.requester.role}` : ""}
          </p>
        ) : null}
        {context.reason ? (
          <p className="text-sm text-text-secondary">{context.reason}</p>
        ) : null}
        {context.stage ? (
          <p className="text-xs text-text-muted">Stage: {context.stage}</p>
        ) : null}
      </div>

      {/* 5: available actions (server-permitted only). Flat text affordances —
          no per-button card treatment, which avoids nested-card (lasagna)
          inside the workspace's outer card. */}
      {availableActions.length > 0 ? (
        <div className="mt-3 flex flex-wrap gap-x-3 gap-y-1.5">
          {availableActions.map((a) => (
            <button
              key={a.id}
              type="button"
              disabled={busy}
              onClick={() =>
                confirmNeeded(a) ? setPending(a) : void runAction(a)
              }
              className="text-sm font-medium text-action-primary underline-offset-2 hover:underline disabled:opacity-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-action-primary rounded-sm"
            >
              {a.label}
            </button>
          ))}
        </div>
      ) : (
        <p className="mt-3 text-xs text-text-muted">
          No authorized actions are available for this record right now.
        </p>
      )}

      {/* 6: confirmation gate (only for consequential actions). Divider-based
          block, not a nested card — the gate is a state, not a surface. */}
      {pending ? (
        <div
          role="alertdialog"
          aria-label={`Confirm ${pending.label}`}
          className="mt-3 border-t border-border pt-3"
        >
          <p className="text-sm font-medium text-text-primary">
            Confirm “{pending.label}”?
          </p>
          <p className="text-xs text-text-muted">
            This action will be recorded and may be irreversible.
          </p>
          {pending.requiresReason ? (
            <input
              value={reason}
              onChange={(e) => setReason(e.target.value)}
              placeholder="Reason (recorded for audit)"
              className="mt-2 w-full rounded border border-border bg-bg-surface px-2 py-1 text-sm"
            />
          ) : null}
          <div className="mt-2 flex gap-2">
            <button
              type="button"
              onClick={() => void runAction(pending)}
              disabled={busy}
              className="rounded-md bg-action-primary px-3 py-1 text-sm font-medium text-bg-surface disabled:opacity-50"
            >
              {busy ? "Submitting…" : "Confirm"}
            </button>
            <button
              type="button"
              onClick={() => setPending(null)}
              className="rounded-md border border-border px-3 py-1 text-sm text-text-secondary"
            >
              Cancel
            </button>
          </div>
        </div>
      ) : null}

      {/* 7: authoritative result (from the execution monitor). Left-accent
          status line, not a nested card — it's a state, not a surface. */}
      {outcome ? (
        <div
          role="status"
          className={
            "mt-3 border-l-2 pl-3 text-sm " +
            (outcome.state === "completed"
              ? "border-action-success text-text-primary"
              : showUnknown
                ? "border-action-warning text-text-primary"
                : "border-action-danger text-text-primary")
          }
        >
          {outcome.state === "completed" ? (
            <span>Action completed and verified.</span>
          ) : showUnknown ? (
            <span>
              <strong className="text-action-warning">Outcome unconfirmed.</strong>{" "}
              {outcome.error}
            </span>
          ) : (
            <span>
              <strong className="text-action-danger">Action failed.</strong>{" "}
              {outcome.error}
            </span>
          )}
        </div>
      ) : null}

      {/* Full approval detail (shared panel, not a duplicate) */}
      {renderDetail ? <div className="mt-3">{renderDetail()}</div> : null}
    </div>
  );
}

export default DecisionWorkspace;
</file>

<file path="src/components/principal/shared/EntityTimeline.tsx">
"use client";

/**
 * EntityTimeline — shared presentation layer for *recorded* entity history.
 *
 * PR-06 rule (protocol §6): "Do not fabricate a timeline from the current
 * record's state. Do not infer historical events if the backend does not
 * store them." This component renders ONLY events the caller passes in —
 * i.e. real recorded audit/activity data. It has no data source of its own;
 * it is pure presentation over a `PrincipalTimelineEvent[]`.
 *
 * States it owns (honestly):
 *  - loading  → a skeleton, never a fabricated entry
 *  - empty    → "No recorded history" + the reason (e.g. not yet audited)
 *  - error    → the failure, not a silent empty
 *  - long list→ paginate (load more) so histories don't degrade the page
 *
 * It does NOT sort/derive events itself: ordering + dedup are the caller's
 * responsibility (they own the source of truth). We only display.
 */
import { useState } from "react";
import { cn } from "@/lib/utils";
import type { PrincipalTimelineEvent } from "@/lib/principal/contracts";

export interface EntityTimelineProps {
  events: PrincipalTimelineEvent[];
  loading?: boolean;
  /** Terminal load-failure (API unavailable, 403, ...). Shown, not swallowed. */
  error?: string | null;
  /** How many to show before "load more" (default 10). */
  pageSize?: number;
  /**
   * Render each event. Defaults to a label + optional actor + timestamp.
   * Pass a custom renderer for richer domain events. Receives the FULL list
   * (not just the paged slice) only when you need it; by default we page.
   */
  renderEvent?: (event: PrincipalTimelineEvent) => React.ReactNode;
  /** Stable key per event (default: event.id ?? index). */
  eventKey?: (event: PrincipalTimelineEvent, index: number) => string;
  className?: string;
}

const PAGE_DEFAULT = 10;

export function EntityTimeline({
  events,
  loading = false,
  error = null,
  pageSize = PAGE_DEFAULT,
  renderEvent,
  eventKey = (e, i) => e.id ?? String(i),
  className,
}: EntityTimelineProps) {
  const [visible, setVisible] = useState(pageSize);

  // ── Honest terminal states first (never fake an entry) ─────────────────
  if (loading && events.length === 0) {
    return (
      <div className={cn("flex flex-col gap-3", className)} aria-busy="true">
        <div className="h-2 w-full animate-pulse rounded bg-surface-2" />
        <div className="h-2 w-4/5 animate-pulse rounded bg-surface-2" />
        <div className="h-2 w-3/5 animate-pulse rounded bg-surface-2" />
      </div>
    );
  }

  if (error) {
    return (
      <div
        className={cn(
          "flex flex-col gap-1 rounded-md border border-border p-3 text-xs",
          "bg-surface-1 text-text-secondary",
          className,
        )}
        role="alert"
      >
        <span className="font-medium text-action-danger">
          Could not load history
        </span>
        <span>{error}</span>
      </div>
    );
  }

  if (events.length === 0) {
    return (
      <div
        className={cn(
          "flex flex-col gap-1 rounded-md border border-dashed border-border p-4 text-center",
          "text-xs text-text-muted",
          className,
        )}
      >
        <span className="font-medium text-text-secondary">
          No recorded history
        </span>
        <span>
          {events.length === 0
            ? "This record has no stored events yet — history is not fabricated."
            : ""}
        </span>
      </div>
    );
  }

  // ── Recorded events: display only the paged slice; "load more" for the rest ─
  const shown = events.slice(0, visible);
  const defaultRender = (e: PrincipalTimelineEvent) => (
    <div className="flex flex-col gap-0.5">
      <span className="text-sm font-medium text-text-primary">{e.type}</span>
      {e.actor ? (
        <span className="text-xs text-text-muted">
          by {e.actor.label}
          {e.actor.role ? ` · ${e.actor.role}` : ""}
        </span>
      ) : null}
      {e.at ? (
        <span className="text-xs text-text-muted">
          {formatTimestamp(e.at)}
        </span>
      ) : null}
      {e.fromState || e.toState ? (
        <span className="text-xs text-text-muted">
          {e.fromState ?? "—"} → {e.toState ?? "—"}
        </span>
      ) : null}
      {e.reason ? (
        <span className="text-xs text-text-muted">{e.reason}</span>
      ) : null}
      {e.auditRef ? (
        <span className="text-[11px] font-mono text-text-muted">
          ref {e.auditRef}
        </span>
      ) : null}
    </div>
  );
  const renderer = renderEvent ?? defaultRender;

  return (
    <div className={cn("flex flex-col", className)}>
      <ol className="relative flex flex-col gap-4 pl-4 before:absolute before:left-1 before:top-1 before:h-[calc(100%-0.5rem)] before:w-px before:bg-border">
        {shown.map((e, i) => (
          <li key={eventKey(e, i)} className="relative">
            {/* node */}
            <span
              className={cn(
                "absolute -left-[15px] top-1 size-2.5 rounded-full border-2",
                "bg-bg-surface",
                i === 0 ? "border-action-primary" : "border-border",
              )}
              aria-hidden="true"
            />
            {renderer(e)}
          </li>
        ))}
      </ol>
      {events.length > visible ? (
        <button
          type="button"
          onClick={() => setVisible((v) => v + pageSize)}
          className="mt-3 self-start rounded text-xs font-medium text-action-primary underline-offset-2 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-action-primary"
        >
          Load {Math.min(pageSize, events.length - visible)} more
          <span className="text-text-muted">
            {" "}
            ({events.length - visible} remaining)
          </span>
        </button>
      ) : null}
    </div>
  );
}

function formatTimestamp(at: string): string {
  try {
    const d = new Date(at);
    if (Number.isNaN(d.getTime())) return at;
    return d.toLocaleString("en-IN", {
      dateStyle: "medium",
      timeStyle: "short",
    });
  } catch {
    return at;
  }
}

export default EntityTimeline;
</file>

<file path="src/components/principal/shared/ExecutionFeedbackCard.tsx">
"use client";

/**
 * ExecutionFeedbackCard — PR-11. Renders the honest execution feedback from
 * buildExecutionFeedback: the result, the next safe step, and whether an audit
 * record is actually confirmed (never asserted without evidence).
 */
import type { ExecutionFeedback } from "@/lib/principal/executionFeedback";
import { cn } from "@/lib/utils";

export function ExecutionFeedbackCard({
  feedback,
  className,
}: {
  feedback: ExecutionFeedback;
  className?: string;
}) {
  const tone =
    feedback.kind === "audit-verified" || feedback.kind === "completed"
      ? "text-action-success"
      : feedback.kind === "unknown" || feedback.kind === "partial"
        ? "text-action-warning"
        : feedback.kind === "failed"
          ? "text-action-danger"
          : "text-text-muted";

  return (
    <div
      role="status"
      aria-live="polite"
      className={cn(
        "rounded-md border border-border bg-bg-surface p-3",
        className,
      )}
    >
      <p className={cn("text-sm font-medium", tone)}>{feedback.headline}</p>
      {feedback.nextStep ? (
        <p className="mt-1 text-xs text-text-muted">{feedback.nextStep}</p>
      ) : null}
      {feedback.auditConfirmed ? (
        <p className="mt-1 text-[11px] font-mono text-text-muted">
          audit record confirmed
        </p>
      ) : feedback.kind === "completed" ? (
        <p className="mt-1 text-[11px] font-mono text-text-muted">
          audit record not confirmed
        </p>
      ) : null}
    </div>
  );
}

export default ExecutionFeedbackCard;
