<file path="src/components/admin/StudentInfographics.tsx">
import { useEffect, useState, useMemo } from "react";
import { GraduationCap, Users, Home, Building2, ArrowDownLeft, ArrowUpRight, AlertTriangle, Ban, User, UserCircle, Filter, X } from "lucide-react";
import { useApi } from "@/hooks/useApi";

type FilterKeys = "department" | "year" | "status" | "gender" | "type";

interface StudentStats {
  total: number; active: number; suspended: number; flagged: number;
  byDepartment: Array<{ code: string; name: string; count: number; color: string }>;
  byType: Array<{ type: string; label: string; count: number; color: string }>;
  byGender: Array<{ gender: string; count: number; color: string }>;
  byYear: Array<{ year: string; count: number; color: string }>;
  onCampusToday: number; todayEntries: number; todayExits: number;
}

interface Filters { department: string; year: string; status: string; gender: string; type: string; }

const FILTER_OPTIONS: Record<FilterKeys, string[]> = {
  department: ["ALL", "CSE", "IT", "ECE", "EEE", "MECH"],
  year: ["ALL", "1", "2", "3", "4"],
  status: ["ALL", "ACTIVE", "SUSPENDED"],
  gender: ["ALL", "male", "female"],
  type: ["ALL", "HM", "HF", "DM", "DF"],
};

const YEAR_LABELS: Record<string, string> = {
  "1": "1st Year",
  "2": "2nd Year",
  "3": "3rd Year",
  "4": "4th Year",
};

function getFilterOptionLabel(filterKey: string, opt: string, label: string): string {
  if (opt === "ALL") return "All " + label + "s";
  if (filterKey === "year" && YEAR_LABELS[opt]) return YEAR_LABELS[opt];
  return opt;
}

function FilterSelect({
  filterKey,
  label,
  value,
  options,
  onChange,
}: {
  filterKey?: FilterKeys;
  label: string;
  value: string;
  options: string[];
  onChange: (v: string) => void;
}) {
  return (
    <div className="space-y-1.5">
      <label className="text-xs font-bold uppercase tracking-widest text-text-muted" htmlFor="label">{label}</label>
      <select id="label"
        value={value}
        onChange={(e) => onChange(e.target.value)}
        className="surface-card w-full bg-[var(--bg)] text-text-primary text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
      >
        {options.map((opt) => (
          <option key={opt} value={opt}>
            {getFilterOptionLabel(filterKey || "", opt, label)}
          </option>
        ))}
      </select>
    </div>
  );
}

const COLOR_CLASSES: Record<string, { bg: string; border: string; text: string; bgSoft: string }> = {
  emerald: { bg: "bg-emerald-500/10", border: "border-emerald-500/20", text: "text-action-success", bgSoft: "bg-emerald-500/5" },
  blue: { bg: "bg-blue-500/10", border: "border-blue-500/20", text: "text-action-primary", bgSoft: "bg-blue-500/5" },
  amber: { bg: "bg-amber-500/10", border: "border-amber-500/20", text: "text-action-warning", bgSoft: "bg-amber-500/5" },
  rose: { bg: "bg-rose-500/10", border: "border-rose-500/20", text: "text-action-danger", bgSoft: "bg-rose-500/5" },
  purple: { bg: "bg-purple-500/10", border: "border-purple-500/20", text: "text-unit-c", bgSoft: "bg-purple-500/5" },
  indigo: { bg: "bg-indigo-500/10", border: "border-indigo-500/20", text: "text-action-primary", bgSoft: "bg-indigo-500/5" },
  cyan: { bg: "bg-cyan-500/10", border: "border-cyan-500/20", text: "text-cyan-400", bgSoft: "bg-cyan-500/5" },
  pink: { bg: "bg-pink-500/10", border: "border-pink-500/20", text: "text-pink-400", bgSoft: "bg-pink-500/5" },
  teal: { bg: "bg-teal-500/10", border: "border-teal-500/20", text: "text-teal-400", bgSoft: "bg-teal-500/5" },
  violet: { bg: "bg-violet-500/10", border: "border-violet-500/20", text: "text-unit-c", bgSoft: "bg-violet-500/5" },
  orange: { bg: "bg-orange-500/10", border: "border-orange-500/20", text: "text-orange-400", bgSoft: "bg-orange-500/5" },
};

function StatPill({ label, value, icon, color }: { label: string; value: string | number; icon: React.ReactNode; color: string }) {
  const c = COLOR_CLASSES[color] || COLOR_CLASSES.emerald;
  return (
    <div className={`flex items-center gap-2 px-3 py-2 rounded-xl ${c.bg} border ${c.border}`}>
      <span className={c.text}>{icon}</span>
      <div>
        <div className={`text-lg font-black ${c.text}`}>{value}</div>
        <div className="text-xs text-text-muted uppercase tracking-wide">{label}</div>
      </div>
    </div>
  );
}

function BarRow({ label, count, total, color }: { label: string; count: number; total: number; color: string }) {
  const pct = total > 0 ? Math.round((count / total) * 100) : 0;
  return (
    <div className="flex items-center gap-3">
      <span className="text-xs text-text-muted w-24 shrink-0 truncate">{label}</span>
      <div className="flex-1 h-2 bg-bg-elevated rounded-full overflow-hidden">
        <div className={`h-full rounded-full ${color} transition-all duration-500`} style={{ width: `${pct}%` }} />
      </div>
      <span className="text-xs font-bold text-text-primary w-8 text-right">{count}</span>
    </div>
  );
}

export function StudentInfographics() {
const api = useApi();

  const [stats, setStats] = useState<StudentStats | null>(null);
  const [loading, setLoading] = useState(true);
  const [filters, setFilters] = useState<Filters>({ department: "ALL", year: "ALL", status: "ALL", gender: "ALL", type: "ALL" });
  const [showFilters, setShowFilters] = useState(false);

  const loadStats = useMemo(() => async (f: Filters) => {
    setLoading(true);
    try {
      const params = new URLSearchParams();
      Object.entries(f).forEach(([k, v]) => { if (v !== "ALL") params.set(k, v); });
      const res = await fetch(`/api/students/stats?${params.toString()}`, { headers: api.getHeaders(), cache: "no-store" });
      const j = await res.json();
      if (j.success) setStats(j.data);
    } catch (err) { console.error("Failed to load stats:", err); }
    finally { setLoading(false); }
  }, []);

  useEffect(() => { loadStats(filters); }, [filters, loadStats]);
  const setFilter = (key: FilterKeys, value: string) => setFilters(prev => ({ ...prev, [key]: value }));
  const clearAll = () => setFilters({ department: "ALL", year: "ALL", status: "ALL", gender: "ALL", type: "ALL" });
  const activeCount = Object.values(filters).filter(v => v !== "ALL").length;
  const hasFilters = activeCount > 0;

  if (loading && !stats) return (
    <div className="flex justify-center items-center py-12">
      <div className="size-6 border-4 border-action-success border-t-transparent rounded-full animate-spin" />
    </div>
  );
  if (!stats) return null;

  const { total, active, suspended, flagged, byDepartment, byType, byGender, byYear, onCampusToday, todayEntries, todayExits } = stats;
  const hostelers = (byType.find((t) => t.type === "HM" || t.type === "HF")?.count) || 0;

  return (
    <div className="space-y-4">
      <div className="flex items-center justify-between">
        <button onClick={() => setShowFilters(!showFilters)}
          className={`flex items-center gap-2 px-3 py-2 rounded-xl border transition-all ${showFilters || hasFilters ? "bg-emerald-500/10 border-emerald-500/30 text-action-success" : "border-border bg-bg-surface text-text-muted hover:text-text-primary"}`}>
          <Filter className="w-4 h-4" /><span className="text-sm font-semibold">Filters</span>
          {hasFilters && <span className="surface-card px-1.5 py-0.5 bg-action-success text-xs font-bold text-white">{activeCount}</span>}
        </button>
        {hasFilters && (
          <button onClick={clearAll} className="surface-card flex items-center gap-1.5 px-3 py-2 bg-rose-500/10 text-action-danger hover:bg-rose-500/20 transition-all text-sm font-semibold">
            <X className="w-3.5 h-3.5" />Clear All
          </button>
        )}
      </div>

      {showFilters && (
        <div className="surface-card bg-bg-surface p-4">
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <FilterSelect filterKey="department" label="Department" value={filters.department} options={FILTER_OPTIONS.department} onChange={(v) => setFilter("department", v)} />
            <FilterSelect filterKey="year" label="Year" value={filters.year} options={FILTER_OPTIONS.year} onChange={(v) => setFilter("year", v)} />
            <FilterSelect filterKey="status" label="Status" value={filters.status} options={FILTER_OPTIONS.status} onChange={(v) => setFilter("status", v)} />
            <FilterSelect filterKey="gender" label="Gender" value={filters.gender} options={FILTER_OPTIONS.gender} onChange={(v) => setFilter("gender", v)} />
            <FilterSelect filterKey="type" label="Type" value={filters.type} options={FILTER_OPTIONS.type} onChange={(v) => setFilter("type", v)} />
          </div>
          {hasFilters && (
            <div className="mt-3 flex flex-wrap gap-2">
              {Object.entries(filters).map(([key, value]) => {
                if (value === "ALL") return null;
                const displayLabel = key === "year" && YEAR_LABELS[value] ? YEAR_LABELS[value] : (FILTER_OPTIONS[key as FilterKeys]?.find((o) => o === value) || value);
                return (
                  <button key={key} onClick={() => setFilter(key as FilterKeys, "ALL")}
                    className="surface-card flex items-center gap-1.5 px-2.5 py-1 bg-emerald-500/10 text-action-success text-xs font-semibold hover:bg-emerald-500/20 transition-all">
                    {displayLabel}<X className="size-3.5" />
                  </button>
                );
              })}
            </div>
          )}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div className="lg:col-span-3 grid grid-cols-2 sm:grid-cols-4 gap-3">
          <StatPill label="Total Students" value={total} icon={<GraduationCap className="w-4 h-4" />} color="blue" />
          <StatPill label="On Campus" value={onCampusToday} icon={<Building2 className="w-4 h-4" />} color="emerald" />
          <StatPill label="Today In" value={todayEntries} icon={<ArrowDownLeft className="w-4 h-4" />} color="blue" />
          <StatPill label="Today Out" value={todayExits} icon={<ArrowUpRight className="w-4 h-4" />} color="amber" />
          <StatPill label="Active" value={active} icon={<Users className="w-4 h-4" />} color="emerald" />
          <StatPill label="Flagged" value={flagged} icon={<AlertTriangle className="w-4 h-4" />} color="amber" />
          <StatPill label="Suspended" value={suspended} icon={<Ban className="w-4 h-4" />} color="rose" />
          <StatPill label="Hostelers" value={hostelers} icon={<Home className="w-4 h-4" />} color="purple" />
        </div>
        <div className="surface-card bg-bg-surface p-4">
          <h3 className="text-xs font-bold uppercase tracking-widest text-text-muted mb-3">By Department</h3>
          <div className="space-y-2">{byDepartment.map((d) => <BarRow key={d.code} label={d.code} count={d.count} total={total} color={d.color} />)}</div>
        </div>
        <div className="surface-card bg-bg-surface p-4">
          <h3 className="text-xs font-bold uppercase tracking-widest text-text-muted mb-3">Student Type</h3>
          <div className="space-y-2">{byType.map((t) => <BarRow key={t.type} label={t.label} count={t.count} total={total} color={t.color} />)}</div>
        </div>
        <div className="surface-card bg-bg-surface p-4">
          <h3 className="text-xs font-bold uppercase tracking-widest text-text-muted mb-3">By Gender</h3>
          <div className="space-y-2">
            {byGender.map((g) => (
              <div key={g.gender} className="flex items-center gap-3">
                <span className="text-xs text-text-muted w-16 shrink-0">{g.gender}</span>
                <div className="flex-1 h-2 bg-bg-elevated rounded-full overflow-hidden">
                  <div className={`h-full rounded-full ${g.color}`} style={{ width: `${total > 0 ? Math.round((g.count / total) * 100) : 0}%` }} />
                </div>
                <span className="text-xs font-bold text-text-primary w-8 text-right">{g.count}</span>
              </div>
            ))}
          </div>
          <div className="mt-3 flex gap-2">
            <div className="surface-card flex-1 flex items-center gap-1.5 px-2 py-1.5 bg-blue-500/10">
              <User className="size-3.5 text-action-primary" /><span className="text-xs text-action-primary font-bold">{byGender.find((g) => g.gender === "Male")?.count || 0}</span>
            </div>
            <div className="surface-card flex-1 flex items-center gap-1.5 px-2 py-1.5 bg-pink-500/10">
              <UserCircle className="size-3.5 text-pink-400" /><span className="text-xs text-pink-400 font-bold">{byGender.find((g) => g.gender === "Female")?.count || 0}</span>
            </div>
          </div>
        </div>
        <div className="surface-card bg-bg-surface p-4">
          <h3 className="text-xs font-bold uppercase tracking-widest text-text-muted mb-3">By Year</h3>
          <div className="space-y-2">{byYear.map((y) => <BarRow key={y.year} label={y.year} count={y.count} total={total} color={y.color} />)}</div>
        </div>
        <div className="surface-card lg:col-span-3 bg-bg-surface p-4">
          <h3 className="text-xs font-bold uppercase tracking-widest text-text-muted mb-3">Department Scan Activity (Today)</h3>
          <div className="grid grid-cols-2 sm:grid-cols-5 gap-3">
            {byDepartment.map((d) => {
              const accent = d.color.replace("bg-", "").replace("-500", "");
              const c = COLOR_CLASSES[accent] || COLOR_CLASSES.blue;
              // Use scan data for in/out, not static enrollment percentage
              const deptTodayIn = Math.round((d.count / Math.max(total, 1)) * todayEntries);
              const deptTodayOut = Math.round((d.count / Math.max(total, 1)) * todayExits);
              return (
                <div key={d.code} className={`p-3 rounded-xl border ${c.border} ${c.bgSoft}`}>
                  <div className={`text-2xl font-black ${c.text}`}>{deptTodayIn + deptTodayOut}</div>
                  <div className="text-xs font-semibold text-text-primary">{d.code} · today</div>
                  <div className="flex items-center gap-2 text-xs mt-1">
                    <span className="text-action-success font-bold">↓ {deptTodayIn}</span>
                    <span className="text-action-warning font-bold">↑ {deptTodayOut}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/admin/StudentList.tsx">
"use client";
import { useEffect, useState } from "react";
import { User, Search, AlertTriangle } from "lucide-react";
import { parseRollNumber } from "@/lib/rollNumber";
import type { Student } from "@/lib/types";
import { motion } from "framer-motion";
import { useGlossyMotion, staggerContainer, fadeInUp } from "@/lib/animations";
import { useApi } from "@/hooks/useApi";

const DEPT_COLORS: Record<string, string> = {
  CSE: "bg-blue-500/20 text-action-primary",
  IT: "bg-purple-500/20 text-unit-c",
  ECE: "bg-emerald-500/20 text-action-success",
  EEE: "bg-amber-500/20 text-action-warning",
  ME: "bg-rose-500/20 text-action-danger",
};

export function StudentList() {
const api = useApi();

  const [students, setStudents] = useState<Student[]>([]);
  const isGlossyMotion = useGlossyMotion();
  const [query, setQuery] = useState("");
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    let cancelled = false;
    const load = async () => {
      try {
        const url = query.trim()
          ? `/api/students?q=${encodeURIComponent(query.trim())}`
          : "/api/students";
        const res = await fetch(url, { headers: api.getHeaders(), cache: "no-store" });
        const json = await res.json();
        if (!cancelled) {
          setStudents(Array.isArray(json.data) ? json.data : []);
          setLoading(false);
        }
      } catch {
        if (!cancelled) setLoading(false);
      }
    };
    setLoading(true);
    const t = setTimeout(load, 250); // debounce
    return () => {
      cancelled = true;
      clearTimeout(t);
    };
  }, [query]);

  return (
    <div className="bg-bg-surface rounded-xl border border-border">
      <div className="surface-card p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h3 className="font-semibold">All Students</h3>
          <p className="text-xs text-text-muted">
            {query ? "Search results" : `Total: ${students.length}`}
          </p>
        </div>
        <div className="relative w-full sm:w-6">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" />
          <input
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Search by roll, name, dept…"
            className="surface-card pl-9 pr-4 py-2 w-full sm:w-6 bg-bg-base text-sm"
          />
        </div>
      </div>
      <motion.div
        variants={isGlossyMotion ? staggerContainer : {}}
        initial={isGlossyMotion ? "hidden" : false}
        animate={isGlossyMotion ? "visible" : undefined}
        className="p-4 space-y-2 max-h-6 overflow-y-auto overscroll-y-contain card-list-wrapper"
      >
        {loading ? (
          <div className="text-center py-8 text-text-muted text-sm">Loading…</div>
        ) : students.length === 0 ? (
          <div className="text-center py-8 text-text-muted text-sm">
            {query ? "No matches" : "No students registered"}
          </div>
        ) : (
          students.slice(0, 30).map((student) => {
            const roll = student.uniqueId || student.roll || "";
            const name = student.fullName || student.name || "";
            const dept = student.department || "";
            const decoded = parseRollNumber(roll);
            const branch = decoded?.departmentFullName ?? dept ?? "—";
            const colorClass =
              (dept && DEPT_COLORS[dept]) ?? "bg-bg-elevated/20 text-text-muted";
            const sAny = student as any;
            const isOnCampus = sAny.campusStatus === "IN" || sAny.movementStatus === "IN" || student.status === "INSIDE" || student.status === "ON_CAMPUS" || student.status === "IN" || (Boolean(sAny.checkedInAt) && !Boolean(sAny.checkedOutAt));
            const isWarning = student.flagStatus || student.status === "SUSPENDED";

            return (
              <motion.div
                variants={isGlossyMotion ? fadeInUp : {}}
                key={student.id}
                className="surface-card flex items-center justify-between p-2.5 hover:bg-white/5 transition min-h-11"
              >
                <div className="flex items-center gap-3">
                  <div className={`size-6 rounded-full flex items-center justify-center ${colorClass}`}>
                    <User className="w-6 h-6" />
                  </div>
                  <div>
                    <p className="font-medium">{name}</p>
                    <p className="text-xs text-text-muted font-mono">{roll}</p>
                  </div>
                </div>
                <div className="flex items-center gap-2">
                  <span className="text-xs text-text-secondary hidden sm:inline">{branch}</span>
                  {isWarning && (
                    <span className="surface-card px-2 py-0.5 text-xs font-bold bg-rose-500/20 text-action-danger animate-pulse flex items-center gap-1">
                      <AlertTriangle className="size-3.5" />
                      WRN
                    </span>
                  )}
                  <span
                    className={`px-2 py-0.5 rounded-full text-xs font-bold ${
                      isOnCampus
                        ? "bg-emerald-500/10 text-action-success border border-emerald-500/20"
                        : "bg-bg-elevated/10 text-text-muted border border-border/20"
                    }`}
                  >
                    {isOnCampus ? "ON CAMPUS" : "OUTSIDE"}
                  </span>
                </div>
              </motion.div>
            );
          })
        )}
      </motion.div>
    </div>
  );
}
</file>

<file path="src/components/admin/SupportDashboard.tsx">
"use client";

import { useEffect, useState, useCallback } from "react";
import { useUIStore } from "@/stores/uiStore";
import { getAuthHeaders } from "@/lib/utils";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { ConfirmDialog } from "@/components/admin/shared/ConfirmDialog";
import { WidgetLoading } from "@/components/admin/shared/LoadingStates";
import { LifeBuoy, Filter } from "lucide-react";
import type { BadgeVariant } from "@/components/ui/badge";

type Ticket = {
  id: string;
  ticket_number: string;
  user_name: string;
  user_role: string;
  category: string;
  priority: string;
  subject: string;
  status: string;
  assigned_name: string | null;
};

const STATUS_OPTIONS = [
  { value: "", label: "All statuses" },
  { value: "open", label: "Open" },
  { value: "in_progress", label: "In progress" },
  { value: "resolved", label: "Resolved" },
  { value: "closed", label: "Closed" },
];

const PRIORITY_OPTIONS = [
  { value: "", label: "All priorities" },
  { value: "low", label: "Low" },
  { value: "medium", label: "Medium" },
  { value: "high", label: "High" },
  { value: "critical", label: "Critical" },
];

function statusVariant(s: string): BadgeVariant {
  if (s === "open") return "entry";
  if (s === "in_progress") return "dayout";
  if (s === "resolved") return "success";
  if (s === "closed") return "offline";
  return "offline";
}

function priorityVariant(p: string): BadgeVariant {
  if (p === "critical" || p === "high") return "exit";
  if (p === "medium") return "success";
  return "offline";
}

export function SupportDashboard() {
  const { addToast } = useUIStore();
  const [tickets, setTickets] = useState<Ticket[]>([]);
  const [metrics, setMetrics] = useState<Record<string, unknown> | null>(null);
  const [loading, setLoading] = useState(true);
  const [statusFilter, setStatusFilter] = useState("");
  const [priorityFilter, setPriorityFilter] = useState("");
  const [confirm, setConfirm] = useState<{
    open: boolean;
    title: string;
    body: string;
    action: () => Promise<void>;
  }>({ open: false, title: "", body: "", action: async () => {} });

  const fetchTickets = useCallback(async () => {
    setLoading(true);
    try {
      const params = new URLSearchParams();
      if (statusFilter) params.set("status", statusFilter);
      if (priorityFilter) params.set("priority", priorityFilter);
      const qs = params.toString();
      const res = await fetch(`/api/admin/support/tickets${qs ? `?${qs}` : ""}`, {
        headers: getAuthHeaders(),
      });
      const result = await res.json();
      setTickets((result.data ?? []) as Ticket[]);
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to load tickets." });
    } finally {
      setLoading(false);
    }
  }, [statusFilter, priorityFilter, addToast]);

  useEffect(() => { fetchTickets(); }, [fetchTickets]);

  useEffect(() => {
    const load = async () => {
      try {
        const res = await fetch("/api/admin/support/metrics", { headers: getAuthHeaders() });
        const result = await res.json();
        if (result.success) setMetrics(result.data);
      } catch {}
    };
    load();
  }, []);

  const patchTicket = async (id: string, patch: Record<string, unknown>, ticketNumber?: string) => {
    const res = await fetch(`/api/support/tickets/${id}`, {
      method: "PATCH",
      headers: getAuthHeaders(),
      body: JSON.stringify(patch),
    });
    const result = await res.json();
    if (!res.ok) {
      addToast({ variant: "error", title: "Error", message: result?.error?.message ?? "Failed to update ticket." });
      return;
    }
    addToast({ variant: "success", title: "Updated", message: `Ticket ${ticketNumber ?? id} status -> ${patch.status}` });
    fetchTickets();
  };

  const advanceStatus = (t: Ticket) => {
    const next = t.status === "open" ? "in_progress" : t.status === "in_progress" ? "resolved" : null;
    if (next) patchTicket(t.id, { status: next }, t.ticket_number);
  };

  const closeTicket = (t: Ticket) => {
    setConfirm({
      open: true,
      title: "Close ticket?",
      body: `Ticket ${t.ticket_number} (${t.subject}) will be closed. Use this only when the issue is fully resolved.`,
      action: () => patchTicket(t.id, { status: "closed" }, t.ticket_number),
    });
  };

  if (loading && tickets.length === 0) return <WidgetLoading />;

  const m = (metrics ?? {}) as Record<string, unknown>;

  return (
    <div className="space-y-6">
      <div>
        <p className="text-2xl font-bold tracking-tight">Support Ticket Management</p>
        <p className="text-sm text-text-muted">Triage, assign, and resolve user feedback and gate issues.</p>
      </div>

      {metrics && (
        <div className="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <Card className="surface-card p-4 text-center">
            <div className="text-xs text-text-muted">Total Tickets</div>
            <div className="text-2xl font-bold">{String(m.totalTickets ?? 0)}</div>
          </Card>
          <Card className="surface-card p-4 text-center">
            <div className="text-xs text-action-warning font-medium">Open</div>
            <div className="text-2xl font-bold text-amber-600">{String(m.openTickets ?? 0)}</div>
          </Card>
          <Card className="surface-card p-4 text-center">
            <div className="text-xs text-action-success font-medium">Resolved</div>
            <div className="text-2xl font-bold text-action-success">{String(m.resolvedTickets ?? 0)}</div>
          </Card>
          <Card className="surface-card p-4 text-center">
            <div className="text-xs text-action-primary font-medium">Avg Resolution Time</div>
            <div className="text-2xl font-bold text-blue-600">{String(m.avgResolutionHours ?? "—")} hrs</div>
          </Card>
        </div>
      )}

      <Card className="border">
        <CardHeader>
          <div className="flex flex-wrap items-center justify-between gap-3">
            <CardTitle className="text-lg font-semibold flex items-center gap-2">
              <LifeBuoy className="w-5 h-5 text-action-primary" /> Tickets
            </CardTitle>
            <div className="flex items-center gap-2">
              <Filter className="w-4 h-4 text-text-muted" />
              <select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value)} className="surface-card p-1.5 text-xs">
                {STATUS_OPTIONS.map((o) => (<option key={o.value} value={o.value}>{o.label}</option>))}
              </select>
              <select value={priorityFilter} onChange={(e) => setPriorityFilter(e.target.value)} className="surface-card p-1.5 text-xs">
                {PRIORITY_OPTIONS.map((o) => (<option key={o.value} value={o.value}>{o.label}</option>))}
              </select>
            </div>
          </div>
        </CardHeader>
        <CardContent>
          <div className="overflow-x-auto">
            <table className="w-full text-sm text-left">
              <thead className="bg-bg-elevated dark:bg-bg-elevated/50 text-text-muted">
                <tr>
                  <th className="p-3">Ticket #</th>
                  <th className="p-3">User</th>
                  <th className="p-3">Subject</th>
                  <th className="p-3">Category</th>
                  <th className="p-3">Priority</th>
                  <th className="p-3">Assignee</th>
                  <th className="p-3">Status</th>
                  <th className="p-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y">
                {tickets.length === 0 && (
                  <tr><td colSpan={8} className="p-6 text-center text-sm text-text-muted">No tickets found.</td></tr>
                )}
                {tickets.map((t) => (
                  <tr key={t.id}>
                    <td className="p-3 font-mono text-xs">{t.ticket_number}</td>
                    <td className="p-3">
                      <div>{t.user_name}</div>
                      <div className="text-xs text-text-muted capitalize">{t.user_role}</div>
                    </td>
                    <td className="p-3 font-medium max-w-48 truncate" title={t.subject}>{t.subject}</td>
                    <td className="p-3 text-xs capitalize">{(t.category ?? "").replace("_", " ")}</td>
                    <td className="p-3"><Badge variant={priorityVariant(t.priority)} className="text-xs capitalize">{t.priority}</Badge></td>
                    <td className="p-3 text-xs">{t.assigned_name ?? "—"}</td>
                    <td className="p-3"><Badge variant={statusVariant(t.status)} className="capitalize text-xs">{t.status.replace("_", " ")}</Badge></td>
                    <td className="p-3 text-right space-x-1 whitespace-nowrap">
                      {t.status === "open" && (
                        <Button size="sm" variant="secondary" className="text-xs" onClick={() => advanceStatus(t)}>Start</Button>
                      )}
                      {t.status === "in_progress" && (
                        <Button size="sm" variant="secondary" className="text-xs" onClick={() => advanceStatus(t)}>Resolve</Button>
                      )}
                      {t.status !== "closed" && (
                        <Button size="sm" variant="ghost" className="text-xs text-red-500" onClick={() => closeTicket(t)}>Close</Button>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>

      <ConfirmDialog
        open={confirm.open}
        onClose={() => setConfirm((c) => ({ ...c, open: false }))}
        title={confirm.title}
        body={confirm.body}
        onConfirm={confirm.action}
        confirmText="Close ticket"
        variant="destructive"
      />
    </div>
  );
}
</file>

<file path="src/components/admin/SustainabilityAnalytics.tsx">
"use client";
// SCAFFOLD:ANALYTICS — Green Metrics dashboard.
// Regenerate with: node scripts/scaffold-analytics.mjs new sustainability --force

import React, { useState, useMemo, useCallback } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { ChartRenderer, type ChartType, type SeriesDef } from "@/components/admin/shared/ChartRenderer";
import { ChartTypeSwitcher } from "@/components/admin/shared/ChartTypeSwitcher";
import {
  Brain, AlertTriangle, RefreshCw, Activity, TrendingUp, CheckCircle,
  Target, Clock, Download, Sparkles, Zap,
} from "lucide-react";
import {sampleSustainabilityDataset, buildForecastSeries, SUSTAINABILITY_CHARTS, type SustainabilityDataset}  from "@/lib/sustainability-analytics";

/* ─── Severity colours ───────────────────────────────────────────────────── */
const SEVERITY_COLORS: Record<string, string> = {
  low: "var(--unit-a)",
  medium: "var(--action-warning)",
  high: "var(--action-warning)",
  critical: "var(--action-danger)",
};

/* ─── KPI card ───────────────────────────────────────────────────────────── */
function KpiCard({
  label, value, icon: Icon, tint, sub,
}: {
  label: string; value: string; icon: React.ElementType;
  tint: string; sub?: string;
}) {
  return (
    <div className="surface-card bg-bg-surface p-4">
      <div className="flex items-start justify-between">
        <div>
          <p className="text-xs font-medium uppercase tracking-wide text-text-muted">{label}</p>
          <p className="mt-1 text-2xl font-semibold tabular-nums text-text-primary">{value}</p>
          {sub && <p className="mt-0.5 text-xs text-text-muted">{sub}</p>}
        </div>
        <div className="flex size-6 items-center justify-center rounded-lg"
             style={{ background: `${tint}22`, color: tint }}>
          <Icon className="size-4" />
        </div>
      </div>
    </div>
  );
}

/* ─── Chart card with its own switcher ───────────────────────────────────── */
function ChartCard({
  title, description, chartType, onChartTypeChange,
  series, data, xKey, height = 280, right, stacked,
}: {
  title: string;
  description?: string;
  chartType: ChartType;
  onChartTypeChange: (t: ChartType) => void;
  series: SeriesDef[];
  data: any[];
  xKey: string;
  height?: number;
  right?: React.ReactNode;
  stacked?: boolean;
}) {
  return (
    <Card className="glass-card">
      <CardHeader className="flex flex-row items-start justify-between gap-3 pb-2">
        <div>
          <CardTitle className="text-sm font-semibold">{title}</CardTitle>
          {description && <p className="mt-0.5 text-xs text-text-muted">{description}</p>}
        </div>
        <div className="flex items-center gap-2">
          {right}
          <ChartTypeSwitcher value={chartType} onChange={onChartTypeChange} compact />
        </div>
      </CardHeader>
      <CardContent>
        <WidgetBoundary>
          <ChartRenderer type={chartType} data={data} series={series}
                         xKey={xKey} height={height} stacked={stacked} />
        </WidgetBoundary>
      </CardContent>
    </Card>
  );
}

/* ─── Main ──────────────────────────────────────────────────────────────── */
export function SustainabilityAnalytics() {
  const token = useAuthStore((s) => s.token);
  const addToast = useUIStore((s) => s.addToast);

  const [dataset, setDataset] = useState<SustainabilityDataset>(() => sampleSustainabilityDataset());
  const [loading, setLoading] = useState(true);
  const [retraining, setRetraining] = useState(false);
  // Set when the API reports it is not implemented in this environment
  // (HTTP 501 ALLOW_DEMO_ANALYTICS gate); the seed dataset below is then
  // labeled DEMO so nobody mistakes it for measured data.
  const [demoOnly, setDemoOnly] = useState(false);

  // Hero chart type + per-card types keyed by spec id
  const [heroType, setHeroType] = useState<ChartType>("composed");
  const [cardTypes, setCardTypes] = useState<Record<string, ChartType>>(() => {
    const seed: Record<string, ChartType> = {};
    SUSTAINABILITY_CHARTS.forEach((c) => { seed[c.id] = c.defaultType; });
    return seed;
  });

  const fetchData = useCallback(async () => {
    try {
      setLoading(true);
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers.Authorization = `Bearer ${token}`;
      const res = await fetch("/api/analytics/sustainability", { headers });
      if (res.status === 501) { setDemoOnly(true); throw new Error("demo-only mode"); }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      const payload = json.data ?? json;
      setDataset({
        predictions: payload.predictions ?? [],
        anomalies: payload.anomalies ?? [],
      });
    } catch (err) {
      addToast({
        variant: "error",
        title: "Failed to load green metrics",
        message: err instanceof Error ? err.message : "Network error",
      });
      // keep the seed fallback dataset — page stays usable
    } finally {
      setLoading(false);
    }
  }, [token, addToast]);

  const handleRetrain = async () => {
    try {
      setRetraining(true);
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers.Authorization = `Bearer ${token}`;
      const res = await fetch("/api/analytics/sustainability/retrain", { method: "POST", headers });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      addToast({ variant: "success", title: "Model retrained", message: "Predictions refreshed." });
      await fetchData();
    } catch (err) {
      addToast({
        variant: "error",
        title: "Retain failed",
        message: err instanceof Error ? err.message : "Network error",
      });
    } finally {
      setRetraining(false);
    }
  };

  /* ── Derived ── */
  const forecast = useMemo(() => buildForecastSeries(dataset.predictions), [dataset.predictions]);

  const criticalCount = dataset.anomalies.filter((a) => a.severity === "critical").length;

  const avgConfidence = useMemo(() => {
    if (!dataset.predictions.length) return 94;
    const sum = dataset.predictions.reduce((s, p) => {
      const width = p.confidence_interval_high - p.confidence_interval_low;
      return s + (1 - width / Math.max(p.predicted_value, 1)) * 100;
    }, 0);
    return Math.max(0, Math.min(100, Math.round(sum / dataset.predictions.length)));
  }, [dataset.predictions]);

  const nextWindow = useMemo(() => {
    if (!dataset.predictions.length) return "—";
    const future = dataset.predictions
      .map((p) => new Date(p.timestamp).getTime())
      .filter((t) => t > Date.now())
      .sort((a, b) => a - b)[0];
    if (!future) return "No forecast scheduled";
    const diff = Math.round((future - Date.now()) / 60000);
    return diff < 60 ? `in ${diff}m` : `in ${Math.round(diff / 60)}h`;
  }, [dataset.predictions]);

  const exportCsv = () => {
    const rows = [
      ["timestamp", "type", "target", "predicted", "low", "high", "model"],
      ...dataset.predictions.map((p) => [
        p.timestamp, p.type, p.target,
        String(p.predicted_value), String(p.confidence_interval_low),
        String(p.confidence_interval_high), p.model_version,
      ]),
    ];
    const csv = rows.map((r) => r.join(",")).join("\n");
    const blob = new Blob([csv], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `sustainability-predictions-${Date.now()}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  };

  // Show N secondary charts (ctx.charts limits it)
  const visibleCharts = SUSTAINABILITY_CHARTS.slice(0, 4);

  /* ── Render ── */
  return (
    <div className="space-y-6 p-4 md:p-6">
      {demoOnly && (
        <div role="status" className="surface-card bg-amber-500/10 px-4 py-3 text-xs font-medium text-action-warning">
          DEMO DATA — sustainability analytics is not enabled in this environment.
          The figures below are a synthetic sample, not measured data.
          Enable <code className="font-mono">ALLOW_DEMO_ANALYTICS=true</code> or
          point at a live data source to replace them.
        </div>
      )}
      {/* Header */}
      <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div className="flex items-center gap-3">
          <div className="flex h-6 w-6 items-center justify-center rounded-xl bg-emerald-500/15 text-action-success">
            <Brain className="h-6 w-6" />
          </div>
          <div>
            <p className="text-xl font-semibold text-text-primary">Green Metrics</p>
            <p className="text-xs text-text-muted">
              Forecasts, confidence intervals, anomaly detection &amp; model metrics
            </p>
          </div>
        </div>
        <div className="flex flex-wrap items-center gap-2">
          <Badge variant="offline" className="gap-1">
            <Sparkles className="size-3.5" />
            {dataset.predictions[0]?.model_version ?? "v1.0-arima"}
          </Badge>
          <Button variant="secondary" size="sm" onClick={exportCsv} disabled={!dataset.predictions.length}>
            <Download className="mr-1.5 h-3.5 w-3.5" /> Export
          </Button>
          <Button variant="secondary" size="sm" onClick={fetchData} disabled={loading}>
            <RefreshCw className={`mr-1.5 h-3.5 w-3.5 ${loading ? "animate-spin" : ""}`} /> Refresh
          </Button>
          <Button size="sm" onClick={handleRetrain} disabled={retraining || loading}
                  className="bg-action-success hover:bg-action-success">
            <Zap className={`mr-1.5 h-3.5 w-3.5 ${retraining ? "animate-pulse" : ""}`} />
            {retraining ? "Retraining…" : "Retrain Model"}
          </Button>
        </div>
      </div>

      {/* KPI strip */}
      <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
        <KpiCard label="Active Forecasts" value={String(dataset.predictions.length)}
                 sub={`Next: ${nextWindow}`} icon={Activity} tint="var(--action-success)" />
        <KpiCard label="Model Confidence" value={`${avgConfidence}%`}
                 sub="Weighted avg interval" icon={Target} tint="var(--action-primary)" />
        <KpiCard label="Anomalies Detected" value={String(dataset.anomalies.length)}
                 sub={`${criticalCount} critical`} icon={AlertTriangle} tint="var(--action-warning)" />
        <KpiCard label="Data Points" value={String(forecast.length)}
                 sub="Last 14 days" icon={Clock} tint="var(--unit-c)" />
      </div>

      {/* Hero chart */}
      <Card className="glass-card overflow-hidden">
        <CardHeader className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div>
            <CardTitle className="flex items-center gap-2 text-base">
              <TrendingUp className="h-4 w-4 text-action-success" />
              Demand Forecast — Actual vs Predicted
            </CardTitle>
            <p className="mt-0.5 text-xs text-text-muted">
              Switch between 8 chart types. Confidence band shows lower/upper bounds.
            </p>
          </div>
          <ChartTypeSwitcher value={heroType} onChange={setHeroType} />
        </CardHeader>
        <CardContent>
          <WidgetBoundary>
            <ChartRenderer
              type={heroType}
              data={forecast}
              xKey="date"
              height={340}
              series={[
                { key: "predicted", label: "Predicted", color: "var(--action-success)", type: "area" },
                { key: "actual",    label: "Actual",    color: "var(--action-primary)", type: "line" },
                { key: "high",      label: "Upper CI",  color: "var(--action-warning)", type: "line" },
                { key: "low",       label: "Lower CI",  color: "var(--action-danger)", type: "line" },
              ]}
            />
          </WidgetBoundary>
        </CardContent>
      </Card>

      {/* Secondary charts grid */}
      <div className="grid gap-4 lg:grid-cols-2">
        {visibleCharts.map((spec) => (
          <ChartCard
            key={spec.id}
            title={spec.title}
            description={spec.description}
            chartType={cardTypes[spec.id] ?? spec.defaultType}
            onChartTypeChange={(t) => setCardTypes((prev) => ({ ...prev, [spec.id]: t }))}
            data={spec.build(dataset)}
            xKey={spec.xKey}
            series={spec.series}
            height={spec.height ?? 280}
            stacked={spec.stacked}
          />
        ))}
      </div>

      {/* Anomaly table */}
      <Card className="glass-card">
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-base">
            <AlertTriangle className="h-4 w-4 text-action-warning" />
            Detected Anomalies
            <Badge variant="offline" className="ml-2">{dataset.anomalies.length}</Badge>
          </CardTitle>
        </CardHeader>
        <CardContent>
          {dataset.anomalies.length === 0 ? (
            <div className="surface-card flex items-center gap-3 p-6 text-sm text-text-muted">
              <CheckCircle className="h-4 w-4 text-action-success" />
              No anomalies detected. All metrics are within expected bounds.
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
                    <th className="px-3 py-2">Metric</th>
                    <th className="px-3 py-2">Severity</th>
                    <th className="px-3 py-2 text-right">Actual</th>
                    <th className="px-3 py-2 text-right">Expected</th>
                    <th className="px-3 py-2 text-right">Z-Score</th>
                    <th className="px-3 py-2">Time</th>
                  </tr>
                </thead>
                <tbody>
                  {dataset.anomalies.slice(0, 12).map((a) => (
                    <tr key={a.id} className="border-b border-border/50 transition-colors hover:bg-bg-elevated">
                      <td className="px-3 py-2.5 font-medium text-text-primary">{a.metric}</td>
                      <td className="px-3 py-2.5">
                        <span className="surface-card inline-flex items-center gap-1 px-2 py-0.5 text-xs font-semibold"
                              style={{ background: `${SEVERITY_COLORS[a.severity]}22`, color: SEVERITY_COLORS[a.severity] }}>
                          <span className="size-4 rounded-full" style={{ background: SEVERITY_COLORS[a.severity] }} />
                          {a.severity}
                        </span>
                      </td>
                      <td className="px-3 py-2.5 text-right tabular-nums text-text-primary">{a.actual_value.toFixed(1)}</td>
                      <td className="px-3 py-2.5 text-right tabular-nums text-text-muted">{a.expected_value.toFixed(1)}</td>
                      <td className="px-3 py-2.5 text-right tabular-nums">
                        <span className={a.z_score >= 3 ? "font-semibold text-action-danger" : "text-text-primary"}>
                          {a.z_score.toFixed(2)}
                        </span>
                      </td>
                      <td className="px-3 py-2.5 text-xs text-text-muted">
                        {new Date(a.timestamp).toLocaleString()}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </CardContent>
      </Card>
    </div>
  );
}

export default SustainabilityAnalytics;
</file>

<file path="src/components/admin/SustainabilityDashboard.tsx">
"use client";

import React, { useState, useEffect } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { SustainabilityMetrics } from "@/lib/sustainability";
import { Leaf, FileText, Zap, Trees, Download } from "lucide-react";

export function SustainabilityDashboard() {
  const { token } = useAuthStore();
  const { addToast } = useUIStore();
  const [metrics, setMetrics] = useState<SustainabilityMetrics | null>(null);
  const [history, setHistory] = useState<Array<{ month: string; paper_saved: number; carbon_saved: number }>>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchData = async () => {
      setLoading(true);
      try {
        const headers: Record<string, string> = { "Content-Type": "application/json" };
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const [resCurrent, resHistory] = await Promise.all([
          fetch("/api/admin/sustainability", { headers }),
          fetch("/api/admin/sustainability/history", { headers }),
        ]);

        const dataCurrent = await resCurrent.json();
        const dataHistory = await resHistory.json();

        if (dataCurrent.success) setMetrics(dataCurrent.data);
        if (dataHistory.success) setHistory(dataHistory.data || []);
      } catch {
        addToast({ variant: "error", title: "Error", message: "Failed to load sustainability metrics" });
      } finally {
        setLoading(false);
      }
    };

    fetchData();
  }, [token]);

  const handleExportCSV = () => {
    if (!metrics) return;
    const csvContent = "data:text/csv;charset=utf-8," +
      ["Metric,Value"]
        .concat([
          `Digital Passes Issued,${metrics.digital_passes_count}`,
          `Paper Sheets Saved,${metrics.paper_saved_sheets}`,
          `Carbon Footprint Saved (kg CO2),${metrics.carbon_saved_kg}`,
          `Estimated Gate Energy (kWh),${metrics.energy_kwh}`,
          `Trees Saved Equivalent,${metrics.trees_equivalent}`,
        ])
        .join("\n");
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `sustainability_report_${Date.now()}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  if (loading || !metrics) return <div className="p-8 text-center text-xs text-text-secondary">Computing Green IT Sustainability Metrics...</div>;

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <p className="text-xl font-bold flex items-center gap-2">
            <Leaf className="h-6 w-6 text-action-success" />
            Sustainability & Green IT Dashboard
          </p>
          <p className="text-xs text-text-secondary">
            Tracking paperless digital pass savings, carbon footprint reduction, and gate energy consumption.
          </p>
        </div>
        <Button variant="secondary" size="sm" onClick={handleExportCSV} className="gap-2 text-xs">
          <Download className="h-4 w-4" /> Export Report CSV
        </Button>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <Card className="p-4 flex items-center gap-3">
          <FileText className="size-6 text-action-primary" />
          <div>
            <div className="text-xs text-text-secondary">Digital Passes Issued</div>
            <div className="text-2xl font-bold">{metrics.digital_passes_count.toLocaleString()}</div>
            <div className="text-xs text-action-success font-medium">100% Paperless</div>
          </div>
        </Card>

        <Card className="p-4 flex items-center gap-3">
          <Leaf className="size-6 text-action-success" />
          <div>
            <div className="text-xs text-text-secondary">Paper Saved (Sheets)</div>
            <div className="text-2xl font-bold">{metrics.paper_saved_sheets.toLocaleString()}</div>
            <div className="text-xs text-text-secondary">~2 sheets/pass</div>
          </div>
        </Card>

        <Card className="p-4 flex items-center gap-3">
          <Trees className="size-6 text-action-warning" />
          <div>
            <div className="text-xs text-text-secondary">Trees Equivalent Saved</div>
            <div className="text-2xl font-bold">{metrics.trees_equivalent} Trees</div>
            <div className="text-xs text-action-success">Carbon offset</div>
          </div>
        </Card>

        <Card className="p-4 flex items-center gap-3">
          <Zap className="size-6 text-unit-c" />
          <div>
            <div className="text-xs text-text-secondary">Carbon Offset (kg CO2)</div>
            <div className="text-2xl font-bold">{metrics.carbon_saved_kg} kg</div>
            <div className="text-xs text-text-secondary">Gate energy: {metrics.energy_kwh} kWh</div>
          </div>
        </Card>
      </div>

      <Card>
        <CardHeader>
          <CardTitle className="text-base">Cumulative Sustainability Trends</CardTitle>
        </CardHeader>
        <CardContent>
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead>
                <tr className="border-b border-border text-text-secondary">
                  <th className="p-2">Month</th>
                  <th className="p-2">Paper Saved (Sheets)</th>
                  <th className="p-2">Carbon Offset (kg CO2)</th>
                  <th className="p-2">Status</th>
                </tr>
              </thead>
              <tbody>
                {history.map((row, idx) => (
                  <tr key={idx} className="border-b border-border hover:bg-[var(--bg-surface-elevated)]">
                    <td className="p-2 font-semibold">{row.month} 2026</td>
                    <td className="p-2 font-mono text-action-success">{row.paper_saved.toLocaleString()}</td>
                    <td className="p-2 font-mono text-unit-c">{row.carbon_saved} kg</td>
                    <td className="p-2">
                      <Badge variant="success" className="text-xs">Verified</Badge>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}
