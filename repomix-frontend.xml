<file path="src/components/admin/TrafficAnalytics.tsx">
"use client";
// SCAFFOLD:ANALYTICS — Traffic dashboard.
// Regenerate with: node scripts/scaffold-analytics.mjs new traffic --force

import React, { useState, useMemo, useCallback } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { ChartRenderer, type ChartType, type SeriesDef } from "@/components/admin/shared/ChartRenderer";
import { ChartTypeSwitcher } from "@/components/admin/shared/ChartTypeSwitcher";
import {
  Brain, AlertTriangle, RefreshCw, Activity, TrendingUp, CheckCircle,
  Target, Clock, Download, Sparkles, Zap,
} from "lucide-react";
import {sampleTrafficDataset, buildForecastSeries, TRAFFIC_CHARTS, type TrafficDataset}  from "@/lib/traffic-analytics";

/* ─── Severity colours ───────────────────────────────────────────────────── */
const SEVERITY_COLORS: Record<string, string> = {
  low: "var(--unit-a)",
  medium: "var(--action-warning)",
  high: "var(--action-warning)",
  critical: "var(--action-danger)",
};

/* ─── KPI card ───────────────────────────────────────────────────────────── */
function KpiCard({
  label, value, icon: Icon, tint, sub,
}: {
  label: string; value: string; icon: React.ElementType;
  tint: string; sub?: string;
}) {
  return (
    <div className="surface-card bg-bg-surface p-4">
      <div className="flex items-start justify-between">
        <div>
          <p className="text-xs font-medium uppercase tracking-wide text-text-muted">{label}</p>
          <p className="mt-1 text-2xl font-semibold tabular-nums text-text-primary">{value}</p>
          {sub && <p className="mt-0.5 text-xs text-text-muted">{sub}</p>}
        </div>
        <div className="flex size-6 items-center justify-center rounded-lg"
             style={{ background: `${tint}22`, color: tint }}>
          <Icon className="size-4" />
        </div>
      </div>
    </div>
  );
}

/* ─── Chart card with its own switcher ───────────────────────────────────── */
function ChartCard({
  title, description, chartType, onChartTypeChange,
  series, data, xKey, height = 280, right, stacked,
}: {
  title: string;
  description?: string;
  chartType: ChartType;
  onChartTypeChange: (t: ChartType) => void;
  series: SeriesDef[];
  data: any[];
  xKey: string;
  height?: number;
  right?: React.ReactNode;
  stacked?: boolean;
}) {
  return (
    <Card className="glass-card">
      <CardHeader className="flex flex-row items-start justify-between gap-3 pb-2">
        <div>
          <CardTitle className="text-sm font-semibold">{title}</CardTitle>
          {description && <p className="mt-0.5 text-xs text-text-muted">{description}</p>}
        </div>
        <div className="flex items-center gap-2">
          {right}
          <ChartTypeSwitcher value={chartType} onChange={onChartTypeChange} compact />
        </div>
      </CardHeader>
      <CardContent>
        <WidgetBoundary>
          <ChartRenderer type={chartType} data={data} series={series}
                         xKey={xKey} height={height} stacked={stacked} />
        </WidgetBoundary>
      </CardContent>
    </Card>
  );
}

/* ─── Main ──────────────────────────────────────────────────────────────── */
export function TrafficAnalytics() {
  const token = useAuthStore((s) => s.token);
  const addToast = useUIStore((s) => s.addToast);

  const [dataset, setDataset] = useState<TrafficDataset>(() => sampleTrafficDataset());
  const [loading, setLoading] = useState(true);
  const [retraining, setRetraining] = useState(false);
  // Set when the API reports it is not implemented in this environment
  // (HTTP 501 ALLOW_DEMO_ANALYTICS gate). The seed dataset below is then
  // labeled DEMO explicitly so nobody mistakes it for measured traffic.
  const [demoOnly, setDemoOnly] = useState(false);

  // Hero chart type + per-card types keyed by spec id
  const [heroType, setHeroType] = useState<ChartType>("composed");
  const [cardTypes, setCardTypes] = useState<Record<string, ChartType>>(() => {
    const seed: Record<string, ChartType> = {};
    TRAFFIC_CHARTS.forEach((c) => { seed[c.id] = c.defaultType; });
    return seed;
  });

  const fetchData = useCallback(async () => {
    try {
      setLoading(true);
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers.Authorization = `Bearer ${token}`;
      const res = await fetch("/api/analytics/traffic", { headers });
      if (res.status === 501) { setDemoOnly(true); throw new Error("demo-only mode"); }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      const payload = json.data ?? json;
      setDataset({
        predictions: payload.predictions ?? [],
        anomalies: payload.anomalies ?? [],
      });
    } catch (err) {
      addToast({
        variant: "error",
        title: "Failed to load traffic",
        message: err instanceof Error ? err.message : "Network error",
      });
      // keep the seed fallback dataset — page stays usable
    } finally {
      setLoading(false);
    }
  }, [token, addToast]);

  const handleRetrain = async () => {
    try {
      setRetraining(true);
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers.Authorization = `Bearer ${token}`;
      const res = await fetch("/api/analytics/traffic/retrain", { method: "POST", headers });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      addToast({ variant: "success", title: "Model retrained", message: "Predictions refreshed." });
      await fetchData();
    } catch (err) {
      addToast({
        variant: "error",
        title: "Retain failed",
        message: err instanceof Error ? err.message : "Network error",
      });
    } finally {
      setRetraining(false);
    }
  };

  /* ── Derived ── */
  const forecast = useMemo(() => buildForecastSeries(dataset.predictions), [dataset.predictions]);

  const criticalCount = dataset.anomalies.filter((a) => a.severity === "critical").length;

  const avgConfidence = useMemo(() => {
    if (!dataset.predictions.length) return 94;
    const sum = dataset.predictions.reduce((s, p) => {
      const width = p.confidence_interval_high - p.confidence_interval_low;
      return s + (1 - width / Math.max(p.predicted_value, 1)) * 100;
    }, 0);
    return Math.max(0, Math.min(100, Math.round(sum / dataset.predictions.length)));
  }, [dataset.predictions]);

  const nextWindow = useMemo(() => {
    if (!dataset.predictions.length) return "—";
    const future = dataset.predictions
      .map((p) => new Date(p.timestamp).getTime())
      .filter((t) => t > Date.now())
      .sort((a, b) => a - b)[0];
    if (!future) return "No forecast scheduled";
    const diff = Math.round((future - Date.now()) / 60000);
    return diff < 60 ? `in ${diff}m` : `in ${Math.round(diff / 60)}h`;
  }, [dataset.predictions]);

  const exportCsv = () => {
    const rows = [
      ["timestamp", "type", "target", "predicted", "low", "high", "model"],
      ...dataset.predictions.map((p) => [
        p.timestamp, p.type, p.target,
        String(p.predicted_value), String(p.confidence_interval_low),
        String(p.confidence_interval_high), p.model_version,
      ]),
    ];
    const csv = rows.map((r) => r.join(",")).join("\n");
    const blob = new Blob([csv], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `traffic-predictions-${Date.now()}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  };

  // Show N secondary charts (ctx.charts limits it)
  const visibleCharts = TRAFFIC_CHARTS.slice(0, 4);

  /* ── Render ── */
  return (
    <div className="space-y-6 p-4 md:p-6">
      {demoOnly && (
        <div role="status" className="surface-card bg-amber-500/10 px-4 py-3 text-xs font-medium text-action-warning">
          DEMO DATA — traffic analytics is not enabled in this environment.
          The figures below are a synthetic sample, not measured gate traffic.
          Enable <code className="font-mono">ALLOW_DEMO_ANALYTICS=true</code> or
          point at a live data source to replace them.
        </div>
      )}
      {/* Header */}
      <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div className="flex items-center gap-3">
          <div className="flex h-6 w-6 items-center justify-center rounded-xl bg-emerald-500/15 text-action-success">
            <Brain className="h-6 w-6" />
          </div>
          <div>
            <p className="text-xl font-semibold text-text-primary">Traffic</p>
            <p className="text-xs text-text-muted">
              Forecasts, confidence intervals, anomaly detection &amp; model metrics
            </p>
          </div>
        </div>
        <div className="flex flex-wrap items-center gap-2">
          <Badge variant="offline" className="gap-1">
            <Sparkles className="size-3.5" />
            {dataset.predictions[0]?.model_version ?? "v1.0-arima"}
          </Badge>
          <Button variant="secondary" size="sm" onClick={exportCsv} disabled={!dataset.predictions.length}>
            <Download className="mr-1.5 h-3.5 w-3.5" /> Export
          </Button>
          <Button variant="secondary" size="sm" onClick={fetchData} disabled={loading}>
            <RefreshCw className={`mr-1.5 h-3.5 w-3.5 ${loading ? "animate-spin" : ""}`} /> Refresh
          </Button>
          <Button size="sm" onClick={handleRetrain} disabled={retraining || loading}
                  className="bg-action-success hover:bg-action-success">
            <Zap className={`mr-1.5 h-3.5 w-3.5 ${retraining ? "animate-pulse" : ""}`} />
            {retraining ? "Retraining…" : "Retrain Model"}
          </Button>
        </div>
      </div>

      {/* KPI strip */}
      <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
        <KpiCard label="Active Forecasts" value={String(dataset.predictions.length)}
                 sub={`Next: ${nextWindow}`} icon={Activity} tint="var(--action-success)" />
        <KpiCard label="Model Confidence" value={`${avgConfidence}%`}
                 sub="Weighted avg interval" icon={Target} tint="var(--action-primary)" />
        <KpiCard label="Anomalies Detected" value={String(dataset.anomalies.length)}
                 sub={`${criticalCount} critical`} icon={AlertTriangle} tint="var(--action-warning)" />
        <KpiCard label="Data Points" value={String(forecast.length)}
                 sub="Last 14 days" icon={Clock} tint="var(--unit-c)" />
      </div>

      {/* Hero chart */}
      <Card className="glass-card overflow-hidden">
        <CardHeader className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div>
            <CardTitle className="flex items-center gap-2 text-base">
              <TrendingUp className="h-4 w-4 text-action-success" />
              Demand Forecast — Actual vs Predicted
            </CardTitle>
            <p className="mt-0.5 text-xs text-text-muted">
              Switch between 8 chart types. Confidence band shows lower/upper bounds.
            </p>
          </div>
          <ChartTypeSwitcher value={heroType} onChange={setHeroType} />
        </CardHeader>
        <CardContent>
          <WidgetBoundary>
            <ChartRenderer
              type={heroType}
              data={forecast}
              xKey="date"
              height={340}
              series={[
                { key: "predicted", label: "Predicted", color: "var(--action-success)", type: "area" },
                { key: "actual",    label: "Actual",    color: "var(--action-primary)", type: "line" },
                { key: "high",      label: "Upper CI",  color: "var(--action-warning)", type: "line" },
                { key: "low",       label: "Lower CI",  color: "var(--action-danger)", type: "line" },
              ]}
            />
          </WidgetBoundary>
        </CardContent>
      </Card>

      {/* Secondary charts grid */}
      <div className="grid gap-4 lg:grid-cols-2">
        {visibleCharts.map((spec) => (
          <ChartCard
            key={spec.id}
            title={spec.title}
            description={spec.description}
            chartType={cardTypes[spec.id] ?? spec.defaultType}
            onChartTypeChange={(t) => setCardTypes((prev) => ({ ...prev, [spec.id]: t }))}
            data={spec.build(dataset)}
            xKey={spec.xKey}
            series={spec.series}
            height={spec.height ?? 280}
            stacked={spec.stacked}
          />
        ))}
      </div>

      {/* Anomaly table */}
      <Card className="glass-card">
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-base">
            <AlertTriangle className="h-4 w-4 text-action-warning" />
            Detected Anomalies
            <Badge variant="offline" className="ml-2">{dataset.anomalies.length}</Badge>
          </CardTitle>
        </CardHeader>
        <CardContent>
          {dataset.anomalies.length === 0 ? (
            <div className="surface-card flex items-center gap-3 p-6 text-sm text-text-muted">
              <CheckCircle className="h-4 w-4 text-action-success" />
              No anomalies detected. All metrics are within expected bounds.
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
                    <th className="px-3 py-2">Metric</th>
                    <th className="px-3 py-2">Severity</th>
                    <th className="px-3 py-2 text-right">Actual</th>
                    <th className="px-3 py-2 text-right">Expected</th>
                    <th className="px-3 py-2 text-right">Z-Score</th>
                    <th className="px-3 py-2">Time</th>
                  </tr>
                </thead>
                <tbody>
                  {dataset.anomalies.slice(0, 12).map((a) => (
                    <tr key={a.id} className="border-b border-border/50 transition-colors hover:bg-bg-elevated">
                      <td className="px-3 py-2.5 font-medium text-text-primary">{a.metric}</td>
                      <td className="px-3 py-2.5">
                        <span className="surface-card inline-flex items-center gap-1 px-2 py-0.5 text-xs font-semibold"
                              style={{ background: `${SEVERITY_COLORS[a.severity]}22`, color: SEVERITY_COLORS[a.severity] }}>
                          <span className="size-4 rounded-full" style={{ background: SEVERITY_COLORS[a.severity] }} />
                          {a.severity}
                        </span>
                      </td>
                      <td className="px-3 py-2.5 text-right tabular-nums text-text-primary">{a.actual_value.toFixed(1)}</td>
                      <td className="px-3 py-2.5 text-right tabular-nums text-text-muted">{a.expected_value.toFixed(1)}</td>
                      <td className="px-3 py-2.5 text-right tabular-nums">
                        <span className={a.z_score >= 3 ? "font-semibold text-action-danger" : "text-text-primary"}>
                          {a.z_score.toFixed(2)}
                        </span>
                      </td>
                      <td className="px-3 py-2.5 text-xs text-text-muted">
                        {new Date(a.timestamp).toLocaleString()}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </CardContent>
      </Card>
    </div>
  );
}

export default TrafficAnalytics;
</file>

<file path="src/components/admin/UserAnalytics.tsx">
"use client";

import React, { useState, useEffect } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { UserEngagementMetric } from "@/lib/user-analytics";
import { Users, TrendingUp, UserX, Download } from "lucide-react";

export function UserAnalytics() {
  const { token } = useAuthStore();
  const { addToast } = useUIStore();
  const [metrics, setMetrics] = useState<UserEngagementMetric[]>([]);
  const [trends, setTrends] = useState<{ dau: number; mau: number; adoptionByRole: Record<string, number> }>({ dau: 0, mau: 0, adoptionByRole: {} });
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchData = async () => {
      setLoading(true);
      try {
        const headers: Record<string, string> = { "Content-Type": "application/json" };
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const [resMetrics, resTrends] = await Promise.all([
          fetch("/api/admin/analytics/users/engagement", { headers }),
          fetch("/api/admin/analytics/users/trends", { headers }),
        ]);

        const dataMetrics = await resMetrics.json();
        const dataTrends = await resTrends.json();

        if (dataMetrics.success) setMetrics(dataMetrics.data || []);
        if (dataTrends.success) setTrends(dataTrends.data || { dau: 0, mau: 0, adoptionByRole: {} });
      } catch {
        addToast({ variant: "error", title: "Error", message: "Failed to load user analytics" });
      } finally {
        setLoading(false);
      }
    };

    fetchData();
  }, [token]);

  const handleExportCSV = () => {
    const csvContent = "data:text/csv;charset=utf-8," +
      ["Name,Email,Role,Engagement Score,Logins/Wk,Scans/Wk,Last Active"]
        .concat(metrics.map(m => `"${m.name}","${m.email}","${m.role}",${m.engagement_score},${m.login_frequency},${m.scan_frequency},"${m.last_active_at}"`))
        .join("\n");
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `user_analytics_${Date.now()}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  if (loading) return <div className="p-8 text-center text-xs text-text-secondary">Computing Behavioral Engagement Metrics...</div>;

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <p className="text-xl font-bold flex items-center gap-2">
            <Users className="h-6 w-6 text-action-primary" />
            User & Role Behavioral Analytics
          </p>
          <p className="text-xs text-text-secondary">
            Engagement scoring (0-100), adoption trends by role, and active user analytics.
          </p>
        </div>
        <Button variant="secondary" size="sm" onClick={handleExportCSV} className="gap-2 text-xs">
          <Download className="h-4 w-4" /> Export CSV
        </Button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <Card className="p-4 flex items-center gap-3">
          <Users className="size-6 text-action-success" />
          <div>
            <div className="text-xs text-text-secondary">Daily Active Users (DAU)</div>
            <div className="text-2xl font-bold">{trends.dau}</div>
          </div>
        </Card>
        <Card className="p-4 flex items-center gap-3">
          <TrendingUp className="size-6 text-action-primary" />
          <div>
            <div className="text-xs text-text-secondary">Monthly Active Users (MAU)</div>
            <div className="text-2xl font-bold">{trends.mau}</div>
          </div>
        </Card>
        <Card className="p-4 flex items-center gap-3">
          <UserX className="size-6 text-unit-c" />
          <div>
            <div className="text-xs text-text-secondary">DAU / MAU Ratio</div>
            <div className="text-2xl font-bold">
              {trends.mau > 0 ? Math.round((trends.dau / trends.mau) * 100) : 0}%
            </div>
          </div>
        </Card>
      </div>

      <Card>
        <CardHeader>
          <CardTitle className="text-base">User Engagement Scores</CardTitle>
        </CardHeader>
        <CardContent>
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead>
                <tr className="border-b border-border text-text-secondary">
                  <th className="p-2">User / Email</th>
                  <th className="p-2">Role</th>
                  <th className="p-2">Engagement Score</th>
                  <th className="p-2">Weekly Activity</th>
                  <th className="p-2">Last Active</th>
                </tr>
              </thead>
              <tbody>
                {metrics.map((u) => (
                  <tr key={u.id} className="border-b border-border hover:bg-[var(--bg-surface-elevated)]">
                    <td className="p-2">
                      <div className="font-semibold">{u.name}</div>
                      <div className="text-text-secondary text-xs">{u.email}</div>
                    </td>
                    <td className="p-2 font-mono text-text-secondary">{u.role}</td>
                    <td className="p-2">
                      <Badge variant={u.engagement_score >= 70 ? "success" : u.engagement_score >= 40 ? "leave" : "error"} className="text-xs">
                        {u.engagement_score} / 100
                      </Badge>
                    </td>
                    <td className="p-2 text-text-secondary">
                      {u.login_frequency} logins • {u.scan_frequency} scans
                    </td>
                    <td className="p-2 text-text-secondary">{new Date(u.last_active_at).toLocaleDateString()}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}
</file>

<file path="src/components/admin/UserManagementPanel.tsx">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Search,
  Upload,
  KeyRound,
  ShieldOff,
  Shield,
  Hash,
  CheckCircle2,
  AlertTriangle,
  X,
  Loader2,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { ConfirmDialog } from "@/components/admin/shared/ConfirmDialog";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageLoading } from "@/components/admin/shared/LoadingStates";
import type { User, AccountStatus, Role } from "@/lib/types";

export interface UserManagementPanelProps {
  role?: Role | string;
  status?: AccountStatus | string;
  departmentId?: string;
  search?: string;
  page?: number;
  pageSize?: number;
  initialRole?: Role | string;
}

type ModalKind = "password" | null;

interface SuspendTarget {
  user: User;
  suspend: boolean;
}

export function UserManagementPanel(props: UserManagementPanelProps) {
  return (
    <WidgetBoundary title="User Management">
      <UserManagementPanelBody {...props} />
    </WidgetBoundary>
  );
}

function UserManagementPanelBody({
  role,
  status,
  departmentId,
  search,
  page = 1,
  pageSize = 25,
  initialRole,
}: UserManagementPanelProps) {
  const effectiveRole = role ?? initialRole;
  const [users, setUsers] = useState<User[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [flash, setFlash] = useState<{ type: "success" | "error"; msg: string } | null>(null);
  const [query, setQuery] = useState(search ?? "");

  // Row action states
  const [suspendTarget, setSuspendTarget] = useState<SuspendTarget | null>(null);
  const [modal, setModal] = useState<ModalKind>(null);
  const [modalTarget, setModalTarget] = useState<User | null>(null);
  const [secretValue, setSecretValue] = useState("");
  const [secretError, setSecretError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);
  const [busyRow, setBusyRow] = useState<string | null>(null);

  // Bulk import state
  const [bulkOpen, setBulkOpen] = useState(false);
  const [bulkFile, setBulkFile] = useState<File | null>(null);
  const [bulkRows, setBulkRows] = useState<Record<string, unknown>[]>([]);
  const [bulkValid, setBulkValid] = useState<Record<string, unknown>[]>([]);
  const [bulkInvalid, setBulkInvalid] = useState<Array<{ index: number; errors: string[] }>>([]);
  const [bulkSummary, setBulkSummary] = useState<{ total: number; valid: number; invalid: number } | null>(null);
  const [bulkValidating, setBulkValidating] = useState(false);
  const [bulkCommitting, setBulkCommitting] = useState(false);
  const [bulkCommitConfirm, setBulkCommitConfirm] = useState(false);
  const [bulkResult, setBulkResult] = useState<{ imported: number; failed: number } | null>(null);
  const [bulkError, setBulkError] = useState<string | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);

  const loadUsers = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const params = new URLSearchParams();
      if (query.trim()) params.set("q", query.trim());
      if (departmentId) params.set("departmentId", departmentId);
      if (status) params.set("status", status);
      if (effectiveRole) params.set("role", String(effectiveRole));
      const qs = params.toString();
      const url = qs ? `/api/users?${qs}` : "/api/users";
      const res = await fetch(url, { headers: getAuthHeaders(), cache: "no-store" });
      const json = await res.json();
      if (json.success && Array.isArray(json.data)) {
        setUsers(json.data);
      } else {
        const msg = typeof json.error === "string" ? json.error : json.error?.message || "Failed to load users";
        setError(msg);
      }
    } catch (e: unknown) {
      setError((e as Error)?.message || "Network error");
    } finally {
      setLoading(false);
    }
  }, [query, departmentId, status, effectiveRole]);

  useEffect(() => {
    loadUsers();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [departmentId, status, effectiveRole, page, pageSize]);

  const filtered = useMemo(() => {
    let list = users;
    if (effectiveRole) list = list.filter((u) => (u.role || "").toString().toLowerCase() === String(effectiveRole).toLowerCase());
    if (status) list = list.filter((u) => (u.status || "").toString().toUpperCase() === String(status).toUpperCase());
    return list;
  }, [users, effectiveRole, status]);

  const paged = useMemo(() => {
    const start = (page - 1) * pageSize;
    return filtered.slice(start, start + pageSize);
  }, [filtered, page, pageSize]);

  const setStatus = useCallback(async (user: User, next: AccountStatus) => {
    setBusyRow(user.id);
    setFlash(null);
    try {
      const res = await fetch(`/api/admin/users/${user.id}`, {
        method: "PATCH",
        headers: getAuthHeaders(),
        body: JSON.stringify({ status: next }),
      });
      const json = await res.json();
      if (json.success) {
        setUsers((prev) => prev.map((u) => (u.id === user.id ? { ...u, status: next } : u)));
        setFlash({ type: "success", msg: next === "SUSPENDED" ? "User suspended" : "User reactivated" });
        loadUsers();
      } else {
        const msg = typeof json.error === "string" ? json.error : json.error?.message || "Update failed";
        setFlash({ type: "error", msg });
      }
    } catch (e: unknown) {
      setFlash({ type: "error", msg: (e as Error)?.message || "Network error" });
    } finally {
      setBusyRow(null);
    }
  }, [loadUsers]);

  const openSecretModal = useCallback((kind: "password", user: User) => {
    setModal(kind);
    setModalTarget(user);
    setSecretValue("");
    setSecretError(null);
    setBusy(false);
  }, []);

  const closeSecretModal = useCallback(() => {
    setModal(null);
    setModalTarget(null);
    setSecretValue("");
    setSecretError(null);
    setBusy(false);
  }, []);

  const submitSecret = useCallback(async () => {
    if (!modalTarget || busy) return;
    setBusy(true);
    setSecretError(null);
    setFlash(null);
    try {
      if (secretValue.length < 8) {
        setSecretError("Password must be at least 8 characters");
        setBusy(false);
        return;
      }
      const res = await fetch(`/api/admin/users/${modalTarget.id}/reset-password`, {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ password: secretValue }),
      });
      const json = await res.json();
      if (json.success) {
        setFlash({ type: "success", msg: "Password reset" });
        closeSecretModal();
      } else {
        const msg = typeof json.error === "string" ? json.error : json.error?.message || "Reset failed";
        setSecretError(msg);
      }
    } catch (e: unknown) {
      setSecretError((e as Error)?.message || "Network error");
    } finally {
      setBusy(false);
    }
  }, [modal, modalTarget, secretValue, busy, closeSecretModal]);

  // ---- Bulk import ----
  const parseCsv = useCallback((text: string): Record<string, unknown>[] => {
    const lines = text.replace(/\r/g, "").split("\n").map((l) => l.trim()).filter(Boolean);
    if (lines.length === 0) return [];
    const headers = lines[0].split(",").map((h) => h.trim());
    const rows: Record<string, unknown>[] = [];
    for (let i = 1; i < lines.length; i++) {
      const cells = lines[i].split(",");
      const rec: Record<string, unknown> = {};
      headers.forEach((h, idx) => {
        if (h) rec[h] = (cells[idx] ?? "").trim();
      });
      rows.push(rec);
    }
    return rows;
  }, []);

  const onFileSelect = useCallback((file: File) => {
    setBulkFile(file);
    setBulkValid([]);
    setBulkInvalid([]);
    setBulkSummary(null);
    setBulkResult(null);
    setBulkError(null);
    file.text().then((text) => {
      setBulkRows(parseCsv(text));
    }).catch(() => {
      setBulkRows([]);
      setBulkError("Could not read file");
    });
  }, [parseCsv]);

  const validateBulk = useCallback(async () => {
    if (bulkRows.length === 0) {
      setBulkError("No rows to validate. Please select a CSV file.");
      return;
    }
    setBulkValidating(true);
    setBulkError(null);
    setBulkValid([]);
    setBulkInvalid([]);
    setBulkSummary(null);
    setBulkResult(null);
    try {
      const res = await fetch("/api/admin/users/bulk/validate", {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ rows: bulkRows }),
      });
      const json = await res.json();
      if (json.success && json.data) {
        setBulkValid(Array.isArray(json.data.valid) ? json.data.valid : []);
        setBulkInvalid(Array.isArray(json.data.invalid) ? json.data.invalid : []);
        setBulkSummary(json.data.summary ?? { total: bulkRows.length, valid: 0, invalid: 0 });
      } else {
        const msg = typeof json.error === "string" ? json.error : json.error?.message || "Validation failed";
        setBulkError(msg);
      }
    } catch (e: unknown) {
      setBulkError((e as Error)?.message || "Network error");
    } finally {
      setBulkValidating(false);
    }
  }, [bulkRows]);

  const closeBulk = useCallback(() => {
    setBulkOpen(false);
    setBulkFile(null);
    setBulkRows([]);
    setBulkValid([]);
    setBulkInvalid([]);
    setBulkSummary(null);
    setBulkResult(null);
    setBulkError(null);
    setBulkCommitConfirm(false);
    if (fileInputRef.current) fileInputRef.current.value = "";
  }, []);

  const commitBulk = useCallback(async () => {
    if (bulkValid.length === 0) {
      setBulkError("No valid rows to commit.");
      return;
    }
    setBulkCommitting(true);
    setBulkError(null);
    try {
      const res = await fetch("/api/admin/users/bulk/commit", {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ rows: bulkValid, confirm: "BULK_IMPORT" }),
      });
      const json = await res.json();
      if (json.success) {
        const d = json.data ?? {};
        setBulkResult({ imported: d.importedCount ?? 0, failed: d.failedCount ?? 0 });
        setBulkValid([]);
        loadUsers();
      } else {
        const msg = typeof json.error === "string" ? json.error : json.error?.message || "Commit failed";
        setBulkError(msg);
      }
    } catch (e: unknown) {
      setBulkError((e as Error)?.message || "Network error");
    } finally {
      setBulkCommitting(false);
    }
  }, [bulkValid, loadUsers]);

  const statusBadge = (u: User) => {
    const s = (u.status || "ACTIVE").toString().toUpperCase();
    const cls =
      s === "ACTIVE" ? "bg-emerald-500/10 text-action-success" :
      s === "SUSPENDED" ? "bg-rose-500/10 text-action-danger" :
      s === "LOCKED" ? "bg-amber-500/10 text-action-warning" :
      "bg-bg-elevated/10 text-text-muted";
    return (
      <span className={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${cls}`}>
        {s}
      </span>
    );
  };

  const guardianLabel = (u: User) => {
    const gid = u.guardianId || u.parentId;
    if (!gid) return null;
    const guardian = users.find((g) => g.id === gid);
    return guardian ? guardian.name || guardian.email || gid : gid;
  };

  const displayName = (u: User) => u.name || u.email || "—";
  const displayRoll = (u: User) => u.uniqueId || u.employeeId || u.loginIdentifier || "—";

  if (loading && users.length === 0) {
    return <PageLoading />;
  }

  return (
    <div className="space-y-4">
      {/* Toolbar */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div className="flex items-center gap-2">
          <button
            onClick={loadUsers}
            className="surface-card inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-text-primary hover:bg-bg-elevated transition"
          >
            <Search className="w-3.5 h-3.5" />
            Refresh
          </button>
          <button
            onClick={() => { setBulkOpen(true); setBulkResult(null); }}
            className="surface-card inline-flex items-center gap-1.5 px-3 py-2 bg-action-primary text-white text-xs font-semibold hover:brightness-110 transition"
          >
            <Upload className="w-3.5 h-3.5" />
            Bulk Import
          </button>
        </div>
        <div className="relative w-full sm:w-5">
          <Search className="w-4 h-4 text-text-muted absolute left-3 top-1/2 -translate-y-1/2" />
          <input
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Search name, roll, email, or role…"
            className="surface-card w-full bg-bg-surface pl-9 pr-9 py-2 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-purple-500/50"
          />
          {query && (
            <button
              onClick={() => setQuery("")}
              className="absolute right-2.5 top-1/2 -translate-y-1/2 text-text-muted hover:text-text-primary text-xs font-bold"
              title="Clear search"
            >
              ✕
            </button>
          )}
        </div>
      </div>

      {flash && (
        <div className={`flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm ${flash.type === "success" ? "bg-emerald-500/10 text-action-success" : "bg-rose-500/10 text-action-danger"}`}>
          {flash.type === "success" ? <CheckCircle2 className="w-4 h-4 shrink-0" /> : <AlertTriangle className="w-4 h-4 shrink-0" />}
          {flash.msg}
        </div>
      )}

      {error && (
        <div className="surface-card px-4 py-2.5 bg-rose-500/10 text-action-danger text-sm">{error}</div>
      )}

      {/* Table */}
      <div className="bg-bg-surface rounded-xl border border-border overflow-hidden">
        <div className="overflow-x-auto">
          <table className="w-full text-sm min-w200">
            <thead>
              <tr className="border-b border-border text-left text-text-muted bg-white/5">
                <th className="p-4 font-medium">Name</th>
                <th className="p-4 font-medium">Roll / ID</th>
                <th className="p-4 font-medium">Role</th>
                <th className="p-4 font-medium">Status</th>
                <th className="p-4 font-medium">Department</th>
                <th className="p-4 font-medium">Guardian</th>
                <th className="p-4 font-medium text-right">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-border">
              {paged.length === 0 ? (
                <tr>
                  <td colSpan={7} className="p-8 text-center text-text-muted">
                    {loading ? "Loading users…" : "No users found"}
                  </td>
                </tr>
              ) : (
                paged.map((u) => {
                  const isSuspended = (u.status || "").toUpperCase() === "SUSPENDED";
                  const rowBusy = busyRow === u.id;
                  return (
                    <tr key={u.id} className="hover:bg-white/5 transition">
                      <td className="p-4">
                        <div className="font-medium text-text-primary">{displayName(u)}</div>
                        {u.email && u.name && u.email !== u.name && (
                          <div className="text-xs text-text-muted">{u.email}</div>
                        )}
                      </td>
                      <td className="p-4 font-mono text-xs text-text-muted">{displayRoll(u)}</td>
                      <td className="p-4 uppercase text-xs font-semibold text-unit-c">{u.role || "—"}</td>
                      <td className="p-4">{statusBadge(u)}</td>
                      <td className="p-4 text-xs text-text-muted">{u.departmentId || "All Campus"}</td>
                      <td className="p-4 text-xs">
                        {guardianLabel(u) ? (
                          <span className="inline-flex items-center gap-1 text-text-secondary">
                            <Hash className="size-3.5 text-text-muted" />
                            {guardianLabel(u)}
                          </span>
                        ) : (
                          <span className="text-text-muted">—</span>
                        )}
                      </td>
                      <td className="p-4">
                        <div className="flex items-center justify-end gap-1.5">
                          <button
                            onClick={() => (isSuspended ? setStatus(u, "ACTIVE") : setSuspendTarget({ user: u, suspend: true }))}
                            disabled={rowBusy}
                            title={isSuspended ? "Activate" : "Suspend"}
                            className={`inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold transition disabled:opacity-40 ${
                              isSuspended
                                ? "bg-emerald-500/10 text-action-success hover:bg-emerald-500/20"
                                : "bg-rose-500/10 text-action-danger hover:bg-rose-500/20"
                            }`}
                          >
                            {rowBusy ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : isSuspended ? <Shield className="w-3.5 h-3.5" /> : <ShieldOff className="w-3.5 h-3.5" />}
                            {isSuspended ? "Activate" : "Suspend"}
                          </button>
                          <button
                            onClick={() => openSecretModal("password", u)}
                            title="Reset password"
                            className="surface-card inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-text-muted hover:bg-bg-elevated hover:text-text-primary transition"
                          >
                            <KeyRound className="w-3.5 h-3.5" />
                            <span className="hidden sm:inline">Password</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
        {filtered.length > pageSize && (
          <div className="surface-card flex items-center justify-between px-4 py-2.5 text-xs text-text-muted">
            <span>{(page - 1) * pageSize + 1}–{Math.min(page * pageSize, filtered.length)} of {filtered.length}</span>
            <div className="flex items-center gap-2">
              <button
                onClick={() => setQuery(query)}
                disabled={page <= 1}
                className="surface-card px-2.5 py-1 disabled:opacity-40"
              >
                Prev
              </button>
              <button
                onClick={() => setQuery(query)}
                disabled={page * pageSize >= filtered.length}
                className="surface-card px-2.5 py-1 disabled:opacity-40"
              >
                Next
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Suspend confirm */}
      {suspendTarget && (
        <ConfirmDialog
          open
          onClose={() => setSuspendTarget(null)}
          title="Suspend this user?"
          body={`This will suspend ${displayName(suspendTarget.user)} and revoke all active sessions. You can reactivate later.`}
          confirmText="Suspend"
          onConfirm={() => {
            setStatus(suspendTarget.user, "SUSPENDED");
            setSuspendTarget(null);
          }}
        />
      )}

      {/* Password / PIN reset modal */}
      {modal && modalTarget && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
          <div className="surface-card relative w-full max-w-md bg-bg-surface p-6">
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-3">
                <div className="size-5 rounded-xl bg-blue-500/20 text-action-primary flex items-center justify-center">
                  <KeyRound className="w-5 h-5" />
                </div>
                <h3 className="text-lg font-semibold text-text-primary">
                  Reset password
                </h3>
              </div>
              <button onClick={closeSecretModal} className="text-text-muted hover:text-text-primary">
                <X className="w-5 h-5" />
              </button>
            </div>
            <p className="text-sm text-text-muted mb-4">
              Set a new password for{" "}
              <span className="text-text-primary font-medium">{displayName(modalTarget)}</span>.
            </p>
            <input
              type="text"
              value={secretValue}
              onChange={(e) => setSecretValue(e.target.value)}
              autoFocus
              placeholder="New password (min 8 chars)"
              className={`w-full bg-bg-elevated border rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-blue-500/50 ${secretError ? "border-rose-500/50" : "border-border"}`}
            />
            {secretError && <p className="mt-2 text-xs text-action-danger">{secretError}</p>}
            <div className="flex justify-end gap-3 mt-6">
              <button onClick={closeSecretModal} className="surface-card px-4 py-2 text-sm font-medium text-text-primary hover:bg-bg-elevated transition">
                Cancel
              </button>
              <button
                onClick={submitSecret}
                disabled={busy || !secretValue}
                className="surface-card bg-action-primary hover:bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition disabled:opacity-40"
              >
                {busy ? <Loader2 className="w-4 h-4 animate-spin inline" /> : "Confirm"}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Bulk import modal */}
      {bulkOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm overflow-auto">
          <div className="surface-card relative w-full max-w-2xl bg-bg-surface p-6 my-4">
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-3">
                <div className="size-5 rounded-xl bg-blue-500/20 text-action-primary flex items-center justify-center">
                  <Upload className="w-5 h-5" />
                </div>
                <h3 className="text-lg font-semibold text-text-primary">Bulk import users</h3>
              </div>
              <button onClick={closeBulk} className="text-text-muted hover:text-text-primary">
                <X className="w-5 h-5" />
              </button>
            </div>

            <p className="text-sm text-text-muted mb-4">
              Upload a CSV with a header row (e.g. <code className="text-xs">name,email,roll,role,department</code>).
              Validate first, then commit only the valid rows.
            </p>

            <div className="flex items-center gap-3 mb-4">
              <input
                ref={fileInputRef}
                type="file"
                accept=".csv,text/csv"
                onChange={(e) => {
                  const f = e.target.files?.[0];
                  if (f) onFileSelect(f);
                }}
                className="text-sm text-text-muted file:mr-3 file:px-3 file:py-1.5 file:rounded-lg file:border file:border-border file:bg-bg-elevated file:text-xs file:font-medium file:text-text-primary file:hover:bg-white/5"
              />
              {bulkFile && <span className="text-xs text-text-muted truncate">{bulkFile.name} ({bulkRows.length} rows)</span>}
            </div>

            {bulkRows.length > 0 && (
              <button
                onClick={validateBulk}
                disabled={bulkValidating}
                className="surface-card inline-flex items-center gap-1.5 px-3 py-2 bg-action-primary text-white text-xs font-semibold hover:brightness-110 transition disabled:opacity-40 mb-4"
              >
                {bulkValidating ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Search className="w-3.5 h-3.5" />}
                Validate
              </button>
            )}

            {bulkSummary && (
              <div className="grid grid-cols-3 gap-3 mb-4">
                <div className="surface-card bg-bg-elevated p-3 text-center">
                  <div className="text-xl font-bold text-text-primary">{bulkSummary.valid}</div>
                  <div className="text-xs text-text-muted">Valid</div>
                </div>
                <div className="surface-card bg-bg-elevated p-3 text-center">
                  <div className="text-xl font-bold text-action-danger">{bulkSummary.invalid}</div>
                  <div className="text-xs text-text-muted">Invalid</div>
                </div>
                <div className="surface-card bg-bg-elevated p-3 text-center">
                  <div className="text-xl font-bold text-text-primary">{bulkSummary.total}</div>
                  <div className="text-xs text-text-muted">Total</div>
                </div>
              </div>
            )}

            {bulkInvalid.length > 0 && (
              <div className="surface-card max-h-5 overflow-auto bg-rose-500/5 p-3 mb-4 text-xs">
                <div className="font-semibold text-action-danger mb-2">Invalid rows</div>
                {bulkInvalid.map((row, i) => (
                  <div key={i} className="mb-1.5">
                    <span className="text-text-muted">Row {row.index + 1}: </span>
                    <span className="text-action-danger">{row.errors.join("; ")}</span>
                  </div>
                ))}
              </div>
            )}

            {bulkResult && (
              <div className="surface-card flex items-center gap-2 px-4 py-2.5 bg-emerald-500/10 text-action-success text-sm mb-4">
                <CheckCircle2 className="w-4 h-4 shrink-0" />
                Imported {bulkResult.imported}, failed {bulkResult.failed}
              </div>
            )}

            {bulkError && (
              <div className="surface-card px-4 py-2.5 bg-rose-500/10 text-action-danger text-sm mb-4">{bulkError}</div>
            )}

            <div className="flex justify-end gap-3">
              <button onClick={closeBulk} className="surface-card px-4 py-2 text-sm font-medium text-text-primary hover:bg-bg-elevated transition">
                Close
              </button>
              {bulkValid.length > 0 && !bulkResult && (
                <button
                  onClick={() => setBulkCommitConfirm(true)}
                  disabled={bulkCommitting}
                  className="surface-card bg-action-success hover:bg-action-success px-4 py-2 text-sm font-semibold text-white transition disabled:opacity-40"
                >
                  Commit {bulkValid.length}
                </button>
              )}
            </div>
          </div>
        </div>
      )}

      {/* Bulk commit confirm */}
      {bulkCommitConfirm && (
        <ConfirmDialog
          open
          onClose={() => setBulkCommitConfirm(false)}
          title={`Commit ${bulkValid.length} valid rows?`}
          body="Valid rows will be imported permanently. Invalid rows are skipped. This action cannot be undone."
          confirmText="Commit"
          variant="primary"
          onConfirm={async () => {
            setBulkCommitConfirm(false);
            await commitBulk();
          }}
        />
      )}
    </div>
  );
}
</file>

<file path="src/components/admin/WebhooksAnalytics.tsx">
"use client";
// SCAFFOLD:ANALYTICS — Webhooks dashboard.
// Regenerate with: node scripts/scaffold-analytics.mjs new webhooks --force

import React, { useState, useMemo, useCallback } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { ChartRenderer, type ChartType, type SeriesDef } from "@/components/admin/shared/ChartRenderer";
import { ChartTypeSwitcher } from "@/components/admin/shared/ChartTypeSwitcher";
import {
  Brain, AlertTriangle, RefreshCw, Activity, TrendingUp, CheckCircle,
  Target, Clock, Download, Sparkles, Zap,
} from "lucide-react";
import {sampleWebhooksDataset, buildForecastSeries, WEBHOOKS_CHARTS, type WebhooksDataset}  from "@/lib/webhooks-analytics";

/* ─── Severity colours ───────────────────────────────────────────────────── */
const SEVERITY_COLORS: Record<string, string> = {
  low: "var(--unit-a)",
  medium: "var(--action-warning)",
  high: "var(--action-warning)",
  critical: "var(--action-danger)",
};

/* ─── KPI card ───────────────────────────────────────────────────────────── */
function KpiCard({
  label, value, icon: Icon, tint, sub,
}: {
  label: string; value: string; icon: React.ElementType;
  tint: string; sub?: string;
}) {
  return (
    <div className="surface-card bg-bg-surface p-4">
      <div className="flex items-start justify-between">
        <div>
          <p className="text-xs font-medium uppercase tracking-wide text-text-muted">{label}</p>
          <p className="mt-1 text-2xl font-semibold tabular-nums text-text-primary">{value}</p>
          {sub && <p className="mt-0.5 text-xs text-text-muted">{sub}</p>}
        </div>
        <div className="flex size-6 items-center justify-center rounded-lg"
             style={{ background: `${tint}22`, color: tint }}>
          <Icon className="size-4" />
        </div>
      </div>
    </div>
  );
}

/* ─── Chart card with its own switcher ───────────────────────────────────── */
function ChartCard({
  title, description, chartType, onChartTypeChange,
  series, data, xKey, height = 280, right, stacked,
}: {
  title: string;
  description?: string;
  chartType: ChartType;
  onChartTypeChange: (t: ChartType) => void;
  series: SeriesDef[];
  data: any[];
  xKey: string;
  height?: number;
  right?: React.ReactNode;
  stacked?: boolean;
}) {
  return (
    <Card className="glass-card">
      <CardHeader className="flex flex-row items-start justify-between gap-3 pb-2">
        <div>
          <CardTitle className="text-sm font-semibold">{title}</CardTitle>
          {description && <p className="mt-0.5 text-xs text-text-muted">{description}</p>}
        </div>
        <div className="flex items-center gap-2">
          {right}
          <ChartTypeSwitcher value={chartType} onChange={onChartTypeChange} compact />
        </div>
      </CardHeader>
      <CardContent>
        <WidgetBoundary>
          <ChartRenderer type={chartType} data={data} series={series}
                         xKey={xKey} height={height} stacked={stacked} />
        </WidgetBoundary>
      </CardContent>
    </Card>
  );
}

/* ─── Main ──────────────────────────────────────────────────────────────── */
export function WebhooksAnalytics() {
  const token = useAuthStore((s) => s.token);
  const addToast = useUIStore((s) => s.addToast);

  const [dataset, setDataset] = useState<WebhooksDataset>(() => sampleWebhooksDataset());
  const [loading, setLoading] = useState(true);
  const [retraining, setRetraining] = useState(false);
  // Set when the API reports it is not implemented in this environment
  // (HTTP 501 ALLOW_DEMO_ANALYTICS gate); the seed dataset below is then
  // labeled DEMO so nobody mistakes it for measured data.
  const [demoOnly, setDemoOnly] = useState(false);

  // Hero chart type + per-card types keyed by spec id
  const [heroType, setHeroType] = useState<ChartType>("composed");
  const [cardTypes, setCardTypes] = useState<Record<string, ChartType>>(() => {
    const seed: Record<string, ChartType> = {};
    WEBHOOKS_CHARTS.forEach((c) => { seed[c.id] = c.defaultType; });
    return seed;
  });

  const fetchData = useCallback(async () => {
    try {
      setLoading(true);
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers.Authorization = `Bearer ${token}`;
      const res = await fetch("/api/analytics/webhooks", { headers });
      if (res.status === 501) { setDemoOnly(true); throw new Error("demo-only mode"); }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      const payload = json.data ?? json;
      setDataset({
        predictions: payload.predictions ?? [],
        anomalies: payload.anomalies ?? [],
      });
    } catch (err) {
      addToast({
        variant: "error",
        title: "Failed to load webhooks",
        message: err instanceof Error ? err.message : "Network error",
      });
      // keep the seed fallback dataset — page stays usable
    } finally {
      setLoading(false);
    }
  }, [token, addToast]);

  const handleRetrain = async () => {
    try {
      setRetraining(true);
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers.Authorization = `Bearer ${token}`;
      const res = await fetch("/api/analytics/webhooks/retrain", { method: "POST", headers });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      addToast({ variant: "success", title: "Model retrained", message: "Predictions refreshed." });
      await fetchData();
    } catch (err) {
      addToast({
        variant: "error",
        title: "Retain failed",
        message: err instanceof Error ? err.message : "Network error",
      });
    } finally {
      setRetraining(false);
    }
  };

  /* ── Derived ── */
  const forecast = useMemo(() => buildForecastSeries(dataset.predictions), [dataset.predictions]);

  const criticalCount = dataset.anomalies.filter((a) => a.severity === "critical").length;

  const avgConfidence = useMemo(() => {
    if (!dataset.predictions.length) return 94;
    const sum = dataset.predictions.reduce((s, p) => {
      const width = p.confidence_interval_high - p.confidence_interval_low;
      return s + (1 - width / Math.max(p.predicted_value, 1)) * 100;
    }, 0);
    return Math.max(0, Math.min(100, Math.round(sum / dataset.predictions.length)));
  }, [dataset.predictions]);

  const nextWindow = useMemo(() => {
    if (!dataset.predictions.length) return "—";
    const future = dataset.predictions
      .map((p) => new Date(p.timestamp).getTime())
      .filter((t) => t > Date.now())
      .sort((a, b) => a - b)[0];
    if (!future) return "No forecast scheduled";
    const diff = Math.round((future - Date.now()) / 60000);
    return diff < 60 ? `in ${diff}m` : `in ${Math.round(diff / 60)}h`;
  }, [dataset.predictions]);

  const exportCsv = () => {
    const rows = [
      ["timestamp", "type", "target", "predicted", "low", "high", "model"],
      ...dataset.predictions.map((p) => [
        p.timestamp, p.type, p.target,
        String(p.predicted_value), String(p.confidence_interval_low),
        String(p.confidence_interval_high), p.model_version,
      ]),
    ];
    const csv = rows.map((r) => r.join(",")).join("\n");
    const blob = new Blob([csv], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `webhooks-predictions-${Date.now()}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  };

  // Show N secondary charts (ctx.charts limits it)
  const visibleCharts = WEBHOOKS_CHARTS.slice(0, 4);

  /* ── Render ── */
  return (
    <div className="space-y-6 p-4 md:p-6">
      {demoOnly && (
        <div role="status" className="surface-card bg-amber-500/10 px-4 py-3 text-xs font-medium text-action-warning">
          DEMO DATA — webhook-deliveries analytics is not enabled in this environment.
          The figures below are a synthetic sample, not measured data.
          Enable <code className="font-mono">ALLOW_DEMO_ANALYTICS=true</code> or
          point at a live data source to replace them.
        </div>
      )}
      {/* Header */}
      <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div className="flex items-center gap-3">
          <div className="flex h-6 w-6 items-center justify-center rounded-xl bg-emerald-500/15 text-action-success">
            <Brain className="h-6 w-6" />
          </div>
          <div>
            <p className="text-xl font-semibold text-text-primary">Webhooks</p>
            <p className="text-xs text-text-muted">
              Forecasts, confidence intervals, anomaly detection &amp; model metrics
            </p>
          </div>
        </div>
        <div className="flex flex-wrap items-center gap-2">
          <Badge variant="offline" className="gap-1">
            <Sparkles className="size-3.5" />
            {dataset.predictions[0]?.model_version ?? "v1.0-arima"}
          </Badge>
          <Button variant="secondary" size="sm" onClick={exportCsv} disabled={!dataset.predictions.length}>
            <Download className="mr-1.5 h-3.5 w-3.5" /> Export
          </Button>
          <Button variant="secondary" size="sm" onClick={fetchData} disabled={loading}>
            <RefreshCw className={`mr-1.5 h-3.5 w-3.5 ${loading ? "animate-spin" : ""}`} /> Refresh
          </Button>
          <Button size="sm" onClick={handleRetrain} disabled={retraining || loading}
                  className="bg-action-success hover:bg-action-success">
            <Zap className={`mr-1.5 h-3.5 w-3.5 ${retraining ? "animate-pulse" : ""}`} />
            {retraining ? "Retraining…" : "Retrain Model"}
          </Button>
        </div>
      </div>

      {/* KPI strip */}
      <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
        <KpiCard label="Active Forecasts" value={String(dataset.predictions.length)}
                 sub={`Next: ${nextWindow}`} icon={Activity} tint="var(--action-success)" />
        <KpiCard label="Model Confidence" value={`${avgConfidence}%`}
                 sub="Weighted avg interval" icon={Target} tint="var(--action-primary)" />
        <KpiCard label="Anomalies Detected" value={String(dataset.anomalies.length)}
                 sub={`${criticalCount} critical`} icon={AlertTriangle} tint="var(--action-warning)" />
        <KpiCard label="Data Points" value={String(forecast.length)}
                 sub="Last 14 days" icon={Clock} tint="var(--unit-c)" />
      </div>

      {/* Hero chart */}
      <Card className="glass-card overflow-hidden">
        <CardHeader className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div>
            <CardTitle className="flex items-center gap-2 text-base">
              <TrendingUp className="h-4 w-4 text-action-success" />
              Demand Forecast — Actual vs Predicted
            </CardTitle>
            <p className="mt-0.5 text-xs text-text-muted">
              Switch between 8 chart types. Confidence band shows lower/upper bounds.
            </p>
          </div>
          <ChartTypeSwitcher value={heroType} onChange={setHeroType} />
        </CardHeader>
        <CardContent>
          <WidgetBoundary>
            <ChartRenderer
              type={heroType}
              data={forecast}
              xKey="date"
              height={340}
              series={[
                { key: "predicted", label: "Predicted", color: "var(--action-success)", type: "area" },
                { key: "actual",    label: "Actual",    color: "var(--action-primary)", type: "line" },
                { key: "high",      label: "Upper CI",  color: "var(--action-warning)", type: "line" },
                { key: "low",       label: "Lower CI",  color: "var(--action-danger)", type: "line" },
              ]}
            />
          </WidgetBoundary>
        </CardContent>
      </Card>

      {/* Secondary charts grid */}
      <div className="grid gap-4 lg:grid-cols-2">
        {visibleCharts.map((spec) => (
          <ChartCard
            key={spec.id}
            title={spec.title}
            description={spec.description}
            chartType={cardTypes[spec.id] ?? spec.defaultType}
            onChartTypeChange={(t) => setCardTypes((prev) => ({ ...prev, [spec.id]: t }))}
            data={spec.build(dataset)}
            xKey={spec.xKey}
            series={spec.series}
            height={spec.height ?? 280}
            stacked={spec.stacked}
          />
        ))}
      </div>

      {/* Anomaly table */}
      <Card className="glass-card">
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-base">
            <AlertTriangle className="h-4 w-4 text-action-warning" />
            Detected Anomalies
            <Badge variant="offline" className="ml-2">{dataset.anomalies.length}</Badge>
          </CardTitle>
        </CardHeader>
        <CardContent>
          {dataset.anomalies.length === 0 ? (
            <div className="surface-card flex items-center gap-3 p-6 text-sm text-text-muted">
              <CheckCircle className="h-4 w-4 text-action-success" />
              No anomalies detected. All metrics are within expected bounds.
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
                    <th className="px-3 py-2">Metric</th>
                    <th className="px-3 py-2">Severity</th>
                    <th className="px-3 py-2 text-right">Actual</th>
                    <th className="px-3 py-2 text-right">Expected</th>
                    <th className="px-3 py-2 text-right">Z-Score</th>
                    <th className="px-3 py-2">Time</th>
                  </tr>
                </thead>
                <tbody>
                  {dataset.anomalies.slice(0, 12).map((a) => (
                    <tr key={a.id} className="border-b border-border/50 transition-colors hover:bg-bg-elevated">
                      <td className="px-3 py-2.5 font-medium text-text-primary">{a.metric}</td>
                      <td className="px-3 py-2.5">
                        <span className="surface-card inline-flex items-center gap-1 px-2 py-0.5 text-xs font-semibold"
                              style={{ background: `${SEVERITY_COLORS[a.severity]}22`, color: SEVERITY_COLORS[a.severity] }}>
                          <span className="size-4 rounded-full" style={{ background: SEVERITY_COLORS[a.severity] }} />
                          {a.severity}
                        </span>
                      </td>
                      <td className="px-3 py-2.5 text-right tabular-nums text-text-primary">{a.actual_value.toFixed(1)}</td>
                      <td className="px-3 py-2.5 text-right tabular-nums text-text-muted">{a.expected_value.toFixed(1)}</td>
                      <td className="px-3 py-2.5 text-right tabular-nums">
                        <span className={a.z_score >= 3 ? "font-semibold text-action-danger" : "text-text-primary"}>
                          {a.z_score.toFixed(2)}
                        </span>
                      </td>
                      <td className="px-3 py-2.5 text-xs text-text-muted">
                        {new Date(a.timestamp).toLocaleString()}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </CardContent>
      </Card>
    </div>
  );
}

export default WebhooksAnalytics;
</file>

<file path="src/components/admin/WorkerMonthlyReviewPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  HardHat,
  Clock,
  TrendingUp,
  TrendingDown,
  Minus,
  AlertTriangle,
  CheckCircle,
  FileDown,
  Loader2,
} from "lucide-react";
import { usePeriod } from "@/hooks/usePeriod";
import { useExport } from "@/hooks/useExport";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { EditableField } from "@/components/shared/EditableField";
import { DurationBar } from "@/components/shared/DurationBar";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface WorkerRow {
  id: string;
  name: string;
  contractor: string;
  totalHours: number;
  overtimeHours: number;
  lateCount: number;
  shiftCount: number;
}

interface ContractorRow {
  contractor: string;
  workers: number;
  totalHours: number;
  lateCount: number;
}

interface MonthlyPayload {
  data: {
    period: string;
    range: { from: string; to: string };
    summary: {
      totalHours: number;
      lateCount: number;
      workerCount: number;
      lastMonthHours: number;
      hoursDelta: number;
      lateDelta: number;
    };
    contractors: ContractorRow[];
    workers: WorkerRow[];
  };
}

// ── Sub-components ────────────────────────────────────────────────────────

function ContractorCard({ c }: { c: ContractorRow }) {
  return (
    <div className="surface-card p-3">
      <p className="text-sm font-semibold text-text-primary">{c.contractor}</p>
      <div className="mt-2 flex items-center justify-between text-xs">
        <span className="text-text-muted">{c.workers} workers</span>
        <div className="text-right">
          <p className="font-medium tabular-nums text-text-primary">{c.totalHours}h</p>
          {c.lateCount > 0 && <p className="text-rose-500">{c.lateCount} late</p>}
        </div>
      </div>
    </div>
  );
}

function WorkerRowView({
  w,
  onEdit,
  isEditing,
}: {
  w: WorkerRow;
  onEdit: (id: string, field: "totalHours" | "lateCount", val: string, reason: string) => Promise<void>;
  isEditing: boolean;
}) {
  const overtimeTone = w.overtimeHours > 0 ? "text-amber-500" : "text-text-muted";

  return (
    <div className="flex items-center justify-between rounded-xl border border-border bg-bg-elevated px-4 py-3">
      {/* Name + contractor */}
      <div className="flex items-center gap-2">
        <div className="p-2 bg-action-primary/10 text-action-primary">
          <HardHat className="h-4 w-4" />
        </div>
        <div className="min-w-0">
          <p className="text-sm font-medium text-text-primary truncate">{w.name}</p>
          <p className="text-xs text-text-muted">{w.contractor}</p>
        </div>
      </div>

      {/* Stats */}
      <div className="flex items-center gap-4 text-xs shrink-0">
        <div className="text-right">
          <p className="font-semibold text-text-primary tabular-nums">{w.totalHours}h</p>
          <p className={cn("tabular-nums", overtimeTone)}>+{w.overtimeHours}h OT</p>
        </div>
        <div className="text-right w-14">
          <p className={cn("font-semibold tabular-nums", w.lateCount > 0 ? "text-rose-500" : "text-emerald-500")}>
            {w.lateCount}
          </p>
          <p className="text-text-muted">late</p>
        </div>
        <div className="text-right w-12">
          <p className="font-semibold text-text-primary tabular-nums">{w.shiftCount}</p>
          <p className="text-text-muted">shifts</p>
        </div>
        {/* Edit button */}
        <button
          type="button"
          onClick={() => onEdit(w.id, "totalHours", String(w.totalHours), "")}
          className="text-text-muted hover:text-action-primary"
          title="Edit hours (with reason)"
        >
          <Clock className="h-3.5 w-3.5" />
        </button>
      </div>
    </div>
  );
}

// ── Main panel ────────────────────────────────────────────────────────────

export function WorkerMonthlyReviewPanel() {
  const { period, setPeriod } = usePeriod("this-month");
  const { exportCSV } = useExport();
  const [data, setData] = useState<MonthlyPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/admin/worker-shifts/monthly?period=${period.key === "all-time" ? "this-month" : period.key}`,
        { headers: getAuthHeaders(), cache: "no-store" }
      );
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load");
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [period.key]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleEdit = async (id: string, field: string, val: string, reason: string) => {
    await fetch(`/api/admin/worker-shifts/monthly/${id}`, {
      method: "PATCH",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({ field, value: val, reason }),
    });
    void load();
  };

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      data.workers.map((w) => ({
        worker: w.name,
        contractor: w.contractor,
        hours: w.totalHours,
        overtime: w.overtimeHours,
        late: w.lateCount,
        shifts: w.shiftCount,
      })),
      [
        { key: "worker", header: "Worker" },
        { key: "contractor", header: "Contractor" },
        { key: "hours", header: "Hours" },
        { key: "overtime", header: "Overtime" },
        { key: "late", header: "Late" },
        { key: "shifts", header: "Shifts" },
      ],
      `worker_shifts_${data.period.replace(/\s/g, "_")}.csv`
    );
  };

  return (
    <WidgetBoundary name="WorkerMonthlyReviewPanel" resetKey={period.key}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <div className="p-2 rounded-xl bg-amber-500/10 text-amber-500">
              <HardHat className="h-4 w-4" />
            </div>
            <div>
              <h2 className="text-sm font-semibold text-text-primary">Worker Shifts — Monthly</h2>
              <p className="text-xs text-text-muted">Hours, overtime, late arrivals, contractor roll-up</p>
            </div>
          </div>
          <button
            type="button"
            onClick={handleExport}
            disabled={!data}
            className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
          >
            <FileDown className="h-3.5 w-3.5" /> Export
          </button>
        </div>

        <PeriodPicker value={period} onChange={setPeriod} allowCustom={false} />

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <Skeleton className="h-16 rounded-xl" />
            {Array.from({ length: 3 }).map((_, i) => (
              <Skeleton key={i} className="h-12 rounded-xl" />
            ))}
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-rose-500/10 p-4 text-sm text-rose-600">
            <AlertTriangle className="h-4 w-4 inline mr-1" /> {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {data && !loading && (
          <>
            {/* Summary KPI row */}
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div className="surface-card p-3">
                <p className="text-xs text-text-muted">Total hours</p>
                <div className="flex items-center gap-2 mt-1">
                  <span className="text-xl font-bold text-text-primary tabular-nums">{data.summary.totalHours}</span>
                  {data.summary.lastMonthHours > 0 && (
                    <DeltaBadge
                      value={data.summary.totalHours}
                      reference={data.summary.lastMonthHours}
                      label="vs LM"
                    />
                  )}
                </div>
              </div>
              <div className="surface-card p-3">
                <p className="text-xs text-text-muted">Late arrivals</p>
                <div className="flex items-center gap-2 mt-1">
                  <span className={cn("text-xl font-bold tabular-nums", data.summary.lateCount > 0 ? "text-rose-500" : "text-emerald-500")}>
                    {data.summary.lateCount}
                  </span>
                  {data.summary.lastMonthHours > 0 && (
                    <DeltaBadge
                      value={data.summary.lateCount}
                      reference={0}
                      label=""
                      higherIsBetter={false}
                    />
                  )}
                </div>
              </div>
              <div className="surface-card p-3">
                <p className="text-xs text-text-muted">Workers</p>
                <p className="text-xl font-bold text-text-primary tabular-nums mt-1">{data.summary.workerCount}</p>
              </div>
              <div className="surface-card p-3">
                <p className="text-xs text-text-muted">Period</p>
                <p className="text-sm font-semibold text-text-primary mt-1">{data.period}</p>
                <p className="text-xs text-text-muted">{data.range.from} → {data.range.to}</p>
              </div>
            </div>

            {/* Contractor cards */}
            {data.contractors.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">By contractor</p>
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                  {data.contractors.map((c) => (
                    <ContractorCard key={c.contractor} c={c} />
                  ))}
                </div>
              </div>
            )}

            {/* Worker list */}
            <div>
              <p className="text-xs font-medium text-text-muted mb-2">Workers</p>
              {data.workers.length === 0 ? (
                <EmptyState title="No shift records in this period" />
              ) : (
                <div className="space-y-1.5">
                  {data.workers.map((w) => (
                    <WorkerRowView key={w.id} w={w} onEdit={handleEdit} isEditing={false} />
                  ))}
                </div>
              )}
            </div>
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default WorkerMonthlyReviewPanel;
