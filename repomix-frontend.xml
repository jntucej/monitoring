<file path="src/app/(supervisor)/supervisor/_retention/WinFeed.tsx">
"use client";

import { motion, AnimatePresence } from "framer-motion";
import { Check, ArrowUpRight, Sparkles } from "lucide-react";
import { useSupervisorRetention, type SupervisorWin } from "@/stores/supervisorRetentionStore";
import { EmptyState } from "@/components/shared/EmptyState";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { alertInspection, passTicketInspection, useRoleInspectorHost } from "@/components/shared/roleInspectors";

function relativeTime(iso: string): string {
  const ms = Date.now() - new Date(iso).getTime();
  const m = Math.floor(ms / 60_000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.floor(h / 24)}d ago`;
}

function outcomeStyle(kind: SupervisorWin["kind"]): {
  icon: typeof Check;
  color: string;
} {
  switch (kind) {
    case "escalation_cleared":
      return { icon: Check, color: "text-action-primary" };
    case "incident_resolved":
      return { icon: Check, color: "text-action-info" };
    case "exception_reviewed":
      return { icon: ArrowUpRight, color: "text-action-warning" };
    default:
      return { icon: Check, color: "text-action-primary" };
  }
}

export function WinFeed() {
  const sessionWins = useSupervisorRetention((s) => s.sessionWins);
  const shiftWins = useSupervisorRetention((s) => s.shiftWins);
  const { inspection, inspect, closeInspection, role } = useRoleInspectorHost();

  /** A win IS a decided record: opening it shows the quick overview of the
   *  underlying entity (escalation ticket or incident) with a link back to
   *  the response console — no re-acting possible from here. */
  const openWin = (w: SupervisorWin) => {
    if (w.kind === "incident_resolved") {
      inspect(
        alertInspection({
          id: w.ticket,
          severity: "high",
          title: w.subject,
          timestamp: w.at,
          resolved: true,
        }),
      );
    } else {
      inspect(
        passTicketInspection(
          {
            id: w.ticket,
            ticket_number: w.ticket,
            status: "RESOLVED",
            student: undefined,
          },
          { role },
        ),
      );
    }
  };

  // Merge: session wins first, then shift wins (deduped by ticket)
  const seen = new Set<string>();
  const merged: SupervisorWin[] = [];
  for (const w of [...sessionWins].reverse()) {
    if (!seen.has(w.ticket)) {
      seen.add(w.ticket);
      merged.push(w);
    }
  }
  for (const w of [...shiftWins].reverse()) {
    if (!seen.has(w.ticket)) {
      seen.add(w.ticket);
      merged.push(w);
    }
  }

  return (
    <section className="surface-card bg-bg-surface p-4 sm:p-5">
      <header className="mb-3 flex items-center gap-2">
        <Sparkles className="size-4 text-action-warning" />
        <h2 className="text-sm font-semibold text-text-primary">Your wins</h2>
        {merged.length > 0 && (
          <span className="surface-card bg-action-primary/10 px-2 py-0.5 text-xs font-medium text-action-primary">
            {merged.length}
          </span>
        )}
      </header>

      {merged.length === 0 ? (
        <EmptyState
          title="No wins yet this shift"
          description="Clear an escalation or resolve an incident to start your list."
        />
      ) : (
        <ul className="divide-y divide-border">
          <AnimatePresence initial={false}>
            {merged.slice(0, 6).map((w) => {
              const style = outcomeStyle(w.kind);
              const Icon = style.icon;
              return (
                <motion.li
                  key={w.ticket + w.at}
                  initial={{ opacity: 0, x: -10 }}
                  animate={{ opacity: 1, x: 0 }}
                  exit={{ opacity: 0, x: 10 }}
                  className="flex cursor-pointer items-center gap-3 py-2 text-xs hover:bg-bg-elevated transition-colors rounded"
                  onClick={() => openWin(w)}
                >
                  <span
                    className={`flex size-6 shrink-0 items-center justify-center rounded-full bg-bg-elevated ${style.color}`}
                  >
                    <Icon className="size-4" />
                  </span>
                  <div className="min-w-0 flex-1">
                    <p className="truncate font-medium text-text-primary">
                      {w.subject}
                    </p>
                    <p className="text-xs text-text-muted">
                      {w.ticket} · {w.kind.replace("_", " ")} · {relativeTime(w.at)}
                    </p>
                  </div>
                </motion.li>
              );
            })}
          </AnimatePresence>
        </ul>
      )}

      <EntityInspector inspection={inspection} onClose={closeInspection} />
    </section>
  );
}
