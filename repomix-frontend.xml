<file path="src/app/(supervisor)/supervisor/_retention/Scorecard.tsx">
"use client";

import { TrendingUp, TrendingDown, Minus, Award, Zap } from "lucide-react";
import { useSupervisorRetention } from "@/stores/supervisorRetentionStore";

function formatMs(ms: number | null): string {
  if (ms === null) return "—";
  const s = Math.round(ms / 1000);
  if (s < 60) return `${s}s`;
  const m = Math.floor(s / 60);
  if (m < 60) return `${m}m`;
  return `${Math.floor(m / 60)}h ${m % 60}m`;
}

export function Scorecard({
  thisWeek,
  lastWeek,
  avgResponseSec,
}: {
  thisWeek: number;
  lastWeek: number;
  avgResponseSec: number;
}) {
  const bests = useSupervisorRetention((s) => s.bests);
  const sessionDecisions = useSupervisorRetention((s) => s.sessionDecisions);

  const delta = thisWeek - lastWeek;
  const TrendIcon = delta > 0 ? TrendingUp : delta < 0 ? TrendingDown : Minus;
  const trendClass =
    delta > 0
      ? "text-action-primary"
      : delta < 0
      ? "text-action-danger"
      : "text-text-muted";

  return (
    <section className="surface-card bg-bg-surface p-4 sm:p-5">
      <header className="mb-4 flex items-center justify-between">
        <h2 className="text-sm font-semibold text-text-primary">Your scorecard</h2>
        <span className="text-xs uppercase tracking-wider text-text-muted">
          this shift
        </span>
      </header>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <Stat
          icon={TrendIcon}
          iconClass={trendClass}
          label="Decisions"
          value={thisWeek}
          hint={
            delta === 0
              ? "same as last shift"
              : `${delta > 0 ? "+" : ""}${delta} vs last shift`
          }
        />
        <Stat
          icon={Zap}
          iconClass="text-action-warning"
          label="Avg response"
          value={formatMs(avgResponseSec * 1000)}
          hint="this shift"
        />
        <Stat
          icon={Award}
          iconClass="text-action-primary"
          label="Fastest"
          value={formatMs(bests.fastestResponseMs)}
          hint="personal best"
        />
        <Stat
          icon={Award}
          iconClass="text-action-info"
          label="Session"
          value={sessionDecisions}
          hint="decisions this shift"
        />
      </div>
    </section>
  );
}

function Stat({
  icon: Icon,
  iconClass,
  label,
  value,
  hint,
}: {
  icon: typeof TrendingUp;
  iconClass: string;
  label: string;
  value: string | number;
  hint: string;
}) {
  return (
    <div>
      <div className="mb-1 flex items-center gap-1.5">
        <Icon className={`size-3.5 ${iconClass}`} aria-hidden />
        <p className="text-xs uppercase tracking-wider text-text-muted">{label}</p>
      </div>
      <p className="text-xl font-semibold tabular-nums text-text-primary">{value}</p>
      <p className="text-xs text-text-muted">{hint}</p>
    </div>
  );
}
</file>

<file path="src/app/(supervisor)/supervisor/_retention/ShiftBar.tsx">
"use client";

import { Clock, ArrowRight } from "lucide-react";

function fmtDuration(ms: number): string {
  if (ms < 0) return "ended";
  const h = Math.floor(ms / 3600_000);
  const m = Math.floor((ms % 3600_000) / 60_000);
  if (h > 0) return `${h}h ${m}m`;
  return `${m}m`;
}

export function ShiftBar({
  startedAt,
  endsAt,
  escalationsOpen,
  incidentsOpen,
}: {
  startedAt: string | null;
  endsAt: string | null;
  escalationsOpen: number;
  incidentsOpen: number;
}) {
  if (!startedAt) {
    return (
      <section className="surface-card bg-bg-surface p-4 sm:p-5">
        <p className="text-sm font-medium text-text-primary">No active shift</p>
        <p className="mt-1 text-xs text-text-muted">
          Your shift hasn&#39;t started yet.
        </p>
      </section>
    );
  }

  const now = Date.now();
  const startMs = new Date(startedAt).getTime();
  const endMs = endsAt ? new Date(endsAt).getTime() : startMs + 8 * 3600_000;
  const elapsed = now - startMs;
  const remaining = endMs - now;
  const pct = Math.max(0, Math.min(100, (elapsed / (endMs - startMs)) * 100));

  const needsAction = escalationsOpen + incidentsOpen;
  const message =
    needsAction === 0
      ? "All clear — nothing needs you right now."
      : needsAction === 1
      ? "1 item to clear before handover."
      : `${needsAction} items to clear before handover.`;

  return (
    <section className="surface-card bg-bg-surface p-4 sm:p-5">
      <div className="flex flex-wrap items-start justify-between gap-3">
        <div className="flex items-center gap-3">
          <div className="flex size-5 items-center justify-center rounded-full bg-action-primary/10">
            <Clock className="size-5 text-action-primary" aria-hidden />
          </div>
          <div>
            <p className="text-sm font-medium text-text-primary">
              Shift in progress
            </p>
            <p className="text-xs text-text-muted">
              {fmtDuration(elapsed)} in · {fmtDuration(remaining)} to handover
            </p>
          </div>
        </div>
        <span className="text-2xl font-semibold tabular-nums text-action-primary">
          {Math.round(pct)}%
        </span>
      </div>

      <div className="mt-3 h-1.5 overflow-hidden rounded-full bg-bg-elevated">
        <div
          className="h-full rounded-full bg-action-primary transition-[width] duration-500"
          style={{ width: `${pct}%` }}
        />
      </div>

      <div className="mt-3 flex items-center justify-between text-xs">
        <span className="text-text-secondary">{message}</span>
        {needsAction > 0 && (
          <span className="flex items-center gap-1 text-action-warning">
            Clear now <ArrowRight className="size-3" />
          </span>
        )}
      </div>
    </section>
  );
}
</file>

