<file path="src/components/shared/ReasonSelect.tsx">
"use client";

import React, { useEffect, useMemo, useState, useId } from "react";
import { cn } from "@/lib/utils";
import { useApi } from "@/hooks/useApi";
import type { WorkflowType } from "@/lib/types";

export interface ReasonSelectProps {
  workflowType: WorkflowType;
  value?: string; // reason code
  onChange: (code: string, label: string) => void;
  className?: string;
  disabled?: boolean;
  required?: boolean;
  placeholder?: string;
}

interface ReasonOption {
  code: string;
  label: string;
}

export function ReasonSelect({
  workflowType,
  value = "",
  onChange,
  className,
  disabled = false,
  required = false,
  placeholder = "Select a reason...",
}: ReasonSelectProps) {
  const api = useApi();
  const id = useId();
  const [standardReasons, setStandardReasons] = useState<ReasonOption[]>([]);
  const [customReasons, setCustomReasons] = useState<ReasonOption[]>([]);
  const [loading, setLoading] = useState<boolean>(true);

  useEffect(() => {
    let isCancelled = false;

    async function loadReasons() {
      setLoading(true);
      try {
        const headers = api.getHeaders();
        const [exitReasonsRes, customReasonsRes] = await Promise.all([
          fetch("/api/config/exit-reasons", { headers }).catch(() => null),
          fetch(`/api/config/custom-reasons?workflow_type=${encodeURIComponent(workflowType)}`, {
            headers,
          }).catch(() => null),
        ]);

        if (isCancelled) return;

        let stdList: ReasonOption[] = [];
        if (exitReasonsRes && exitReasonsRes.ok) {
          const json = await exitReasonsRes.json();
          if (json.success && Array.isArray(json.data)) {
            stdList = json.data.map((r: { code: string; name?: string; label?: string }) => ({
              code: r.code,
              label: r.name || r.label || r.code,
            }));
          }
        }

        let customList: ReasonOption[] = [];
        if (customReasonsRes && customReasonsRes.ok) {
          const json = await customReasonsRes.json();
          if (json.success && Array.isArray(json.data)) {
            customList = json.data.map((r: { code: string; label?: string; name?: string }) => ({
              code: r.code,
              label: r.label || r.name || r.code,
            }));
          }
        }

        if (!isCancelled) {
          setStandardReasons(stdList);
          setCustomReasons(customList);
        }
      } catch (err) {
        console.error("[ReasonSelect] Error fetching reasons:", err);
      } finally {
        if (!isCancelled) {
          setLoading(false);
        }
      }
    }

    loadReasons();

    return () => {
      isCancelled = true;
    };
  }, [workflowType]);

  // Display-side dedupe: two seed migrations shipped the same labels under
  // different codes (hostel_medical/medical_emergency, hostel_family/family_emergency).
  // The migration 20270101000002 deletes the older rows; this guard is a
  // belt-and-suspenders measure so the dropdown never shows duplicates even
  // if the migration has not yet run.
  const dedupedCustomReasons = useMemo(() => {
    const seen = new Set<string>();
    return customReasons.filter((r) => {
      const key = r.label.trim().toLowerCase();
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  }, [customReasons]);

  const allReasons = [...standardReasons, ...dedupedCustomReasons];

  const handleChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const selectedCode = e.target.value;
    const found = allReasons.find((r) => r.code === selectedCode);
    const selectedLabel = found ? found.label : selectedCode;
    onChange(selectedCode, selectedLabel);
  };

  return (
    <div className="relative w-full">
      <select
        id={id}
        value={value}
        onChange={handleChange}
        disabled={disabled || loading}
        required={required}
        className={cn(
          "w-full h-11 px-3.5 rounded-md bg-bg-surface border border-border text-text-primary text-sm transition-colors focus:outline-none focus:ring-2 focus:ringfocus-ring disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer",
          className
        )}
      >
        <option value="" disabled>
          {loading ? "Loading reasons..." : placeholder}
        </option>

        {standardReasons.length > 0 && (
          <optgroup label="Standard" className="bg-bg-surface text-text-primary font-semibold">
            {standardReasons.map((reason) => (
              <option key={`std_${reason.code}`} value={reason.code} className="font-normal text-text-primary py-1">
                {reason.label}
              </option>
            ))}
          </optgroup>
        )}

        {dedupedCustomReasons.length > 0 && (
          <optgroup label="Custom" className="bg-bg-surface text-text-primary font-semibold">
            {dedupedCustomReasons.map((reason) => (
              <option key={`cust_${reason.code}`} value={reason.code} className="font-normal text-text-primary py-1">
                {reason.label}
              </option>
            ))}
          </optgroup>
        )}
      </select>
    </div>
  );
}

export default ReasonSelect;
</file>

