"use client";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { buildFacultyCorrectionInspection } from "@/lib/role-registers/facultyInspections";
import {
  ShieldCheck,
  Loader2,
  ArrowRight,
  AlertTriangle,
  Inbox
} from "lucide-react";

/* response shapes */

interface PermissionRow {
  id: string;
  ticket_number: string;
  workflow_type: string;
  current_stage: string;
  status: string;
  sla_deadline?: string | null;
  student?: { name: string; unique_id?: string } | null;
  requester?: { id: string; name: string; role: string } | null;
}

interface PermissionsResponse {
  success: boolean;
  data: PermissionRow[];
  total?: number;
}

function FacultyCorrectionRequestsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "faculty") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<PermissionsResponse>("/api/permissions?workflow_type=memo&status=PENDING&stage=faculty", { ttlMs: 30_000 });

  const rows = data?.data ?? [];
  const total = data?.total ?? rows.length;

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      {/* Back link */}
      <Link
        href="/faculty"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Faculty Overview
      </Link>

      {/* Page toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Faculty · Corrections"
        purpose="Inspect student attendance correction memos and forward validated edits."
        why="Reviewing disputed attendance logs prevents incorrect absences from counting against the 75% threshold."
        contextLabel="Correction Queue"
        statusTone={rows.length > 0 ? "warn" : "ok"}
        statusPill={rows.length > 0 ? `${rows.length} pending` : "All clear"}
        statusSummary={
          rows.length > 0
            ? `${rows.length} attendance correction request${rows.length === 1 ? "" : "s"} awaiting faculty verification.`
            : "No pending attendance correction memos in your queue."
        }
        primaryAction={{ label: "Faculty Home", href: "/faculty" }}
        secondaryActions={[
          { label: "Permissions", href: "/faculty/permissions" },
          { label: "Request History", href: "/faculty/request-history" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">
              {/403|forbidden/i.test(error)
                ? "Correction requests are reviewed at the Head of Department (HOD) stage."
                : `Correction Requests data unavailable: ${error}`}
            </span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      <WidgetBoundary title="Correction Requests">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <ShieldCheck className="w-4 h-4 text-action-success shrink-0" />
              <span className="text-sm font-semibold text-white truncate">Correction Requests</span>
            </div>
            <span className="text-xs text-text-muted shrink-0">{total} memo correction(s) pending</span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" /> Loading Correction Requests…
            </div>
          ) : rows.length === 0 ? (
            <div className="p-6 text-center min-w-0">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No attendance correction memos are pending at your stage. Faculty recommend; HOD approves.</p>
            </div>
          ) : (
            <div className="overflow-x-auto min-w-0">
              <table className="w-full text-sm min-w140">
                <thead>
                  <tr className="border-b border-border text-left text-xs text-text-muted">
                    <th className="py-2 pr-4">Ticket</th>
                    <th className="py-2 pr-4">Student</th>
                    <th className="py-2 pr-4">Stage</th>
                    <th className="py-2 pr-4">SLA</th>
                    <th className="py-2">Status</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr
                      key={r.id}
                      onClick={() => inspect(buildFacultyCorrectionInspection(r))}
                      onKeyDown={(e) => {
                        if (e.key === "Enter" || e.key === " ") {
                          e.preventDefault();
                          inspect(buildFacultyCorrectionInspection(r));
                        }
                      }}
                      tabIndex={0}
                      role="button"
                      aria-label={`Inspect correction request ${r.ticket_number}`}
                      className="border-b border-border/50 last:border-0 hover:bg-bg-elevated/30 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary"
                    >
                      <td className="py-2 pr-4 font-mono text-xs text-text-secondary whitespace-nowrap">{r.ticket_number}</td>
                      <td className="py-2 pr-4 text-text-secondary">{r.student?.name ?? "—"}</td>
                      <td className="py-2 pr-4 text-text-muted">{r.current_stage}</td>
                      <td className="py-2 pr-4 text-text-muted">
                        {r.sla_deadline ? new Date(r.sla_deadline).toLocaleDateString("en-IN", { day: "2-digit", month: "short" }) : "—"}
                      </td>
                      <td className="py-2 text-text-muted">{r.status}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}
export default function FacultyCorrectionRequestsPage() {
  return (
    <AuthGuard allowedRoles={['faculty', 'hod', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <FacultyCorrectionRequestsInner />
      </Suspense>
    </AuthGuard>
  );
}
