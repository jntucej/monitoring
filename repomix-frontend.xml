<file path="src/app/exam-branch/page.tsx">
"use client";

import { Suspense, useCallback, useMemo, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import { getAuthHeaders } from "@/lib/utils";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import {
  ShieldCheck,
  AlertTriangle,
  ArrowRight,
  ListChecks,
} from "lucide-react";

/* /api/permissions response shape — filtered to pending exam clearances */
interface PermissionRequest {
  id: string;
  ticket_number: string;
  workflow_type: string;
  student_user_id: string;
  status: string;
  current_stage: string;
  created_at: string;
  updated_at: string;
  sla_deadline?: string;
  hostel_scope?: string | null;
  [key: string]: unknown;
}

interface PermissionsResponse {
  success: boolean;
  data: PermissionRequest[] | null;
  total: number;
}

function isOverdue(sla: string | undefined): boolean {
  return !!sla && new Date(sla).getTime() < Date.now();
}

function ExamBranchPassQueueInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "exam_branch") as Role;
  const tier = getRoleTier(role);
  const [forwarding, setForwarding] = useState<string | null>(null);

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<PermissionsResponse>(
    "/api/permissions?workflow_type=exam&status=PENDING&stage=oie",
    { ttlMs: 30_000 }
  );

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const requests = useMemo<PermissionRequest[]>(
    () => (data?.data as unknown as PermissionRequest[]) ?? [],
    [data]
  );

  const total = data?.total ?? requests.length;
  const pendingCount = requests.filter((r) => r.status === "PENDING").length;
  const overdueCount = requests.filter((r) => isOverdue(r.sla_deadline)).length;

  // 1.14 — "Send to OIE": exam branch prepares, OIE approves. The forward POST
  // moves the ticket's current_stage from exam_branch to oie.
  const sendToOie = useCallback(
    async (ticket: PermissionRequest) => {
      setForwarding(ticket.id);
      try {
        const res = await fetch(
          `/api/permissions/${encodeURIComponent(ticket.ticket_number)}/forward`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json", ...getAuthHeaders() },
            body: JSON.stringify({
              targetRole: "oie",
              comment: "Forwarded to OIE for clearance",
            }),
          },
        );
        const json = await res.json().catch(() => null);
        if (!res.ok) {
          console.error("[exam-branch] forward to OIE failed", res.status, json);
        }
        await refreshAll();
      } finally {
        setForwarding(null);
      }
    },
    [refreshAll],
  );

  return (
    <div className="mx-auto max-w-7xl space-y-6 px-4 py-6 md:px-6 min-w-0">
      <Link
        href="/exam-branch"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Overview
      </Link>

      {/* Toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Exam Branch"
        purpose="Review and process student examination passes and clearance workflows."
        why="Processing student exam pass requests verifies prerequisite compliance and enables hall permit generation."
        contextLabel="Exam Pass Queue"
        statusTone={pendingCount > 0 ? "warn" : "ok"}
        statusPill={pendingCount > 0 ? `${pendingCount} pending` : "Queue clear"}
        statusSummary={
          pendingCount > 0
            ? `${pendingCount} exam pass request${pendingCount === 1 ? "" : "s"} awaiting verification and processing.`
            : "No pending exam pass requests in your queue."
        }
        primaryAction={{ label: "OIE Requests", href: "/exam-branch/oie-approval-requests" }}
        secondaryActions={[
          { label: "Verification", href: "/exam-branch/verification" },
          { label: "Today Overview", href: "/exam-branch/home" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">Pass queue unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      {/* KPI cards */}
      <WidgetBoundary title="Pass Queue Stats">
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 min-w-0">
          <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
            <p className="text-xs text-text-muted uppercase tracking-wide">In Queue</p>
            <p className="mt-1 text-2xl font-bold text-action-warning">{pendingCount}</p>
            <p className="text-xs text-text-muted">Exam passes awaiting OIE clearance</p>
          </div>
          <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
            <p className="text-xs text-text-muted uppercase tracking-wide">Overdue (SLA)</p>
            <p
              className={`mt-1 text-2xl font-bold ${
                overdueCount > 0 ? "text-action-danger" : "text-text-muted"
              }`}
            >
              {overdueCount}
            </p>
            <p className="text-xs text-text-muted">Past SLA deadline — escalate to OIE</p>
          </div>
          <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
            <p className="text-xs text-text-muted uppercase tracking-wide">Total Pending</p>
            <p className="mt-1 text-2xl font-bold text-white">{total}</p>
            <p className="text-xs text-text-muted">All pending exam-stage requests</p>
          </div>
        </div>
      </WidgetBoundary>

      {/* OIE dependency notice */}
      <div
        className="surface-card bg-sky-500/10 p-3 min-w-0"
        role="note"
      >
        <p className="flex items-center gap-2 text-xs text-action-info font-medium">
          <ShieldCheck className="w-4 h-4 shrink-0" />
          Pass clearances require OIE approval. Exam branch cannot self-clear.
        </p>
        <p className="mt-1 text-xs text-sky-600/60">
          Items here are visible for preparation only. Final approval is owned
          by the OIE — see the{" "}
          <Link
            href="/exam-branch/oie-approval-requests"
            className="underline decoration-dotted hover:text-sky-600"
          >
            OIE Approvals
          </Link>{" "}
          tab to track approval status.
        </p>
      </div>

      {/* Queue list */}
      <WidgetBoundary title="Exam Pass Queue">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <ListChecks className="w-4 h-4 text-action-success shrink-0" />
              <span className="text-sm font-semibold text-white truncate">
                Passes Awaiting Clearance
              </span>
            </div>
            <span className="text-xs text-text-muted shrink-0">{requests.length} shown</span>
          </div>

          {busy ? (
            <div className="p-4 space-y-3 min-w-0">
              {Array.from({ length: 3 }).map((_, i) => (
                <div
                  key={i}
                  className="h-14 rounded-lg border border-border bg-bg-surface/40 animate-pulse motion-reduce:animate-none"
                />
              ))}
            </div>
          ) : requests.length === 0 ? (
            <div className="p-6 text-center min-w-0">
              <ListChecks className="size-6 mx-auto text-text-muted mb-2" />
              <p className="text-sm text-text-muted">
                No exam passes in the queue.
              </p>
              <p className="text-xs text-text-muted mt-1">
                Passes appear here when a candidate enters the exam clearance
                workflow.
              </p>
            </div>
          ) : (
            <ul className="divide-y divide-slate-800 min-w-0">
              {requests.map((req) => (
                <li
                  key={req.id}
                  className={`px-4 py-3 flex flex-col gap-1 min-w-0 ${
                    isOverdue(req.sla_deadline) ? "bg-rose-500/5" : ""
                  }`}
                >
                  <div className="flex flex-wrap items-center gap-2 min-w-0">
                    <span className="font-mono text-xs text-text-secondary">
                      {req.ticket_number}
                    </span>
                    <span className="surface-card inline-flex items-center bg-amber-500/15 text-action-warning px-2 py-0.5 text-xs">
                      PENDING
                    </span>
                    {isOverdue(req.sla_deadline) && (
                      <span className="surface-card inline-flex items-center bg-rose-500/15 text-action-danger px-2 py-0.5 text-xs font-semibold">
                        SLA EXCEEDED
                      </span>
                    )}
                    <span className="text-xs text-text-muted">
                      stage: {req.current_stage}
                    </span>
                  </div>
                  <p className="text-xs text-text-muted min-w-0">
                    {new Date(req.created_at).toLocaleString([], {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                      hour: "2-digit",
                      minute: "2-digit",
                    })}
                    {req.sla_deadline
                      ? ` · SLA: ${new Date(req.sla_deadline).toLocaleString([], { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })}`
                      : ""}
                  </p>
                  <button
                    type="button"
                    disabled={forwarding === req.id}
                    onClick={() => void sendToOie(req)}
                    className="surface-card mt-1 self-start px-2 py-1 text-xs text-action-info hover:bg-sky-500/10 disabled:opacity-50"
                  >
                    {forwarding === req.id ? "Forwarding…" : "Send to OIE"}
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>
      </WidgetBoundary>

    </div>
  );
}

export default function ExamBranchPassQueuePage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <ExamBranchPassQueueInner />
    </Suspense>
  );
}
</file>

<file path="src/app/faculty/attendance/page.tsx">
"use client";


import React, { useState, useCallback } from "react";
import { Users, AlertCircle, RotateCw, Inbox } from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";

import { FacultyTracking } from "@/components/admin/FacultyTracking";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useAuthStore } from "@/stores/authStore";
import { useLiveRefresh } from "@/hooks/useLiveRefresh";
import { getAuthHeaders } from "@/lib/utils";
import type { FacultyMemberAttendance, DepartmentAttendanceSummary } from "@/lib/types";

interface FacultyAttendanceResponse {
  success: boolean;
  summary?: {
    totalFaculty: number;
    presentToday: number;
    currentlyInside: number;
    currentlyOutside: number;
    lateArrivals: number;
    absentCount: number;
    overallAttendanceRate: number;
  };
  departmentSummaries?: DepartmentAttendanceSummary[];
  records?: FacultyMemberAttendance[];
  error?: string | { message?: string };
}

const EMPTY_SUMMARY = {
  totalFaculty: 0,
  presentToday: 0,
  currentlyInside: 0,
  currentlyOutside: 0,
  lateArrivals: 0,
  absentCount: 0,
  overallAttendanceRate: 0,
};

function FacultyAttendanceInner() {
  const user = useAuthStore((s) => s.user);
  const [records, setRecords] = useState<FacultyMemberAttendance[]>([]);
  const [summary, setSummary] = useState(EMPTY_SUMMARY);
  const [departmentSummaries, setDepartmentSummaries] = useState<DepartmentAttendanceSummary[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const fetchFacultyAttendance = useCallback(async () => {
    try {
      setLoading(true);
      setError(null);
      const res = await fetch("/api/faculty/attendance", {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const data: FacultyAttendanceResponse = await res.json();
      if (data.success) {
        setRecords(data.records || []);
        if (data.summary) setSummary(data.summary);
        if (data.departmentSummaries) setDepartmentSummaries(data.departmentSummaries);
      } else {
        const msg =
          typeof data.error === "string"
            ? data.error
            : data.error?.message || "Failed to fetch faculty attendance data";
        setError(msg);
      }
    } catch (err) {
      console.error("Error loading faculty attendance:", err);
      setError("Network error fetching faculty attendance");
    } finally {
      setLoading(false);
    }
  }, []);

  // Initial fetch + poll every 30s while the global Live toggle is on.
  useLiveRefresh(fetchFacultyAttendance, { intervalMs: 30_000 });

  const isFaculty = user?.role === "faculty";
  const deptCode = user?.departmentId ? ` · dept ${user.departmentId}` : "";

  return (
    <div className="min-h-dvh bg-bg-elevated p-4 sm:p-6 md:p-4 space-y-4 sm:space-y-6">
      {/* Page Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <p className="text-2xl font-bold text-white flex items-center gap-2">
            <Users className="w-6 h-6 text-action-success" />
            Faculty Attendance Desk
          </p>
          <p className="text-sm text-text-muted mt-1">
            {isFaculty
              ? `Your department${deptCode || " (assigned branch)"} — live entry/exit, punctuality and attendance metrics.`
              : "Real-time entry/exit logs, punctuality tracking, and department-level attendance metrics."}
          </p>
        </div>
        <div className="flex items-center gap-3 text-xs text-text-muted">
          {user?.name && <span className="truncate max-w-55">{user.name}</span>}
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Faculty Attendance Admin"
        purpose="Track faculty arrivals, gate movement logs, and departmental presence compliance"
        why="Auditing faculty attendance records ensures timely lecture delivery and complies with institutional regulatory metrics."
        contextLabel={`Faculty Presence · ${summary.presentToday}/${summary.totalFaculty || records.length} Present`}
        statusTone={summary.overallAttendanceRate > 0 && summary.overallAttendanceRate < 75 ? "warn" : "ok"}
        statusPill={`${summary.presentToday} Present`}
        statusSummary={
          records.length > 0
            ? `${summary.presentToday} faculty present today across departments (${summary.overallAttendanceRate}% overall attendance rate).`
            : "No faculty check-in records logged for today yet."
        }
        primaryAction={{ label: "Faculty Directory", href: "/faculty/student-directory" }}
        secondaryAction={{ label: "My Classes", href: "/faculty/my-classes" }}
      />

      {/* Error banner with retry */}
      {error && (
        <div className="surface-card p-4 bg-rose-500/10 text-action-danger text-sm flex items-center justify-between gap-2">
          <span className="flex items-center gap-2">
            <AlertCircle className="w-5 h-5 shrink-0" />
            <span>Failed to load faculty attendance: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => fetchFacultyAttendance()}
            className="surface-card inline-flex items-center gap-1.5 bg-rose-500/10 px-3 py-1.5 text-xs font-semibold text-action-danger hover:bg-rose-500/20 shrink-0"
          >
            <RotateCw className="w-3.5 h-3.5" />
            Retry
          </button>
        </div>
      )}

      {/* Loading state */}
      {loading && records.length === 0 && !error ? (
        <div className="flex justify-center items-center py-20">
          <div className="size-6 border-4 border-action-success border-t-transparent rounded-full animate-spin" />
        </div>
      ) : !error && records.length === 0 && departmentSummaries.length === 0 ? (
        /* Empty state — no attendance records yet */
        <div className="surface-card flex flex-col items-center justify-center p-12 bg-bg-base text-center space-y-3">
          <Inbox className="size-6 text-text-muted" />
          <div className="space-y-1">
            <h3 className="text-base font-semibold text-text-secondary">No attendance records yet</h3>
            <p className="text-xs text-text-muted max-w-sm">
              Faculty appear here after their first gate check-in today. Metrics refresh
              automatically while Live mode is on.
            </p>
          </div>
        </div>
      ) : (
        <FacultyTracking
          records={records}
          summary={summary}
          departmentSummaries={departmentSummaries}
        />
      )}

    </div>
  );
}

export default function FacultyAttendancePage() {
  return (
    <AuthGuard allowedRoles={["faculty", "hod", "admin", "sysadmin"]}>
      <FacultyAttendanceInner />
    </AuthGuard>
  );
}
