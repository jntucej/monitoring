<file path="src/app/(approver)/oie/examination-reports/page.tsx">
"use client";

import { Suspense, useCallback, useMemo } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

import { PageLoading, TableSkeleton } from "@/components/shared/LoadingStates";
import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import {
  ArrowRight,
  FileBarChart,
  Loader2,
  AlertTriangle,
  Inbox,
  TrendingUp,
  CalendarDays,
} from "lucide-react";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { KVPairs, ActionRow, InspectorButton } from "@/components/shared/EntityInspector";

interface AnalyticsResponse {
  success: boolean;
  data: {
    metrics: Array<{ key: string; label: string; value: number; unit?: string }>;
    seriesData: Array<Record<string, string | number>>;
    role: string;
  };
}

function StatCard({
  icon: Icon,
  label,
  value,
  sub,
  accent = "text-white",
  loading,
}: {
  icon: React.ComponentType<{ className?: string }>;
  label: string;
  value: React.ReactNode;
  sub?: string;
  accent?: string;
  loading?: boolean;
}) {
  return (
    <div className="surface-card bg-bg-base p-4 flex flex-col gap-2 min-w-0">
      <div className="flex items-center gap-2 text-text-muted min-w-0">
        <Icon className="w-4 h-4 shrink-0" />
        <span className="text-xs font-semibold uppercase tracking-wide truncate">{label}</span>
      </div>
      {loading ? (
        <Loader2 className="w-5 h-5 animate-spin text-text-muted" />
      ) : (
        <p className={`text-2xl font-bold ${accent}`}>{value}</p>
      )}
      {sub && <p className="text-xs text-text-muted min-w-0">{sub}</p>}
    </div>
  );
}

function EmptyState({ message }: { message: string }) {
  return (
    <div className="surface-card bg-bg-base p-8 text-center min-w-0">
      <div className="flex flex-col items-center gap-2">
        <Inbox className="w-5 h-5 text-text-muted" />
        <p className="max-w-md text-sm text-text-muted">{message}</p>
      </div>
    </div>
  );
}

function ErrorBanner({ message, onRetry }: { message: string; onRetry: () => void }) {
  return (
    <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
      <span className="flex items-center gap-2 min-w-0">
        <AlertTriangle className="w-4 h-4 shrink-0" />
        <span className="truncate">{message}</span>
      </span>
      <button
        type="button"
        onClick={onRetry}
        className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
      >
        Retry
      </button>
    </div>
  );
}

function ExaminationReportsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "oie") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const inspectReports = () => {
    inspect({
      kind: "academic_record",
      title: "Examination reports (30-day)",
      subtitle: data?.data?.role ?? "oie",
      sections: [
        {
          title: "Overview",
          content: (
            <KVPairs
              items={
                metrics.map((m) => ({
                  label: m.label,
                  value: `${m.value}${m.unit ? ` ${m.unit}` : ""}`,
                }))
              }
            />
          ),
        },
        {
          title: "Actions",
          content: (
            <ActionRow>
              <InspectorButton href="/oie/examination-reports" variant="ghost">
                Back to reports
              </InspectorButton>
            </ActionRow>
          ),
        },
      ],
      detailHref: "/oie/examination-reports",
      detailLabel: "Examination reports",
    });
  };

  const {
    data,
    loading,
    error,
    refresh: refreshAnalytics,
  } = useApiResource<AnalyticsResponse>(
    "/api/campus-extra/analytics?role=oie&date_range=30d",
    { ttlMs: 60_000 }
  );

  const refresh = useCallback(async () => {
    clearCache();
    await refreshAnalytics();
  }, [refreshAnalytics]);

  usePolling(refresh, { intervalMs: 60_000, enabled: !!user });

  const metrics = data?.data?.metrics ?? [];
  const seriesData = data?.data?.seriesData ?? [];

  // Render series chart (simple bar-style)
  const maxSeries =
    seriesData.length === 0
      ? 0
      : Math.max(
          ...seriesData.map((s) => Number(s.resolved ?? s.pending ?? s.scans ?? s.alerts ?? 0))
        );

  const seriesLabels = seriesData.map((s) => {
    const label = String(s.date ?? "").slice(5); // MM-DD
    const value = Number(s.resolved ?? s.pending ?? s.scans ?? s.alerts ?? 0);
    return { label, value };
  });

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      <Link
        href="/oie"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Overview
      </Link>

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Officer In-Charge of Examinations"
        purpose="Generate hall occupancy summaries, clearance statistics, and exam reports."
        why="Comprehensive session reports provide the Academic Council and Principal with reliable exam conduct and turnout metrics."
        contextLabel="Examination Reports"
        statusTone="info"
        statusSummary="Export examination audit statistics, clearance volumes, and hall allocations."
        primaryAction={{ label: "Records", href: "/oie/records" }}
        secondaryActions={[
          { label: "OIE Overview", href: "/oie" },
          { label: "Decision History", href: "/oie/decision-history" },
        ]}
      />

      {error && (
        <ErrorBanner
          message={`Examination reports data failed to load: ${error}`}
          onRetry={() => void refreshAnalytics()}
        />
      )}

      {/* KPI row */}
      <WidgetBoundary title="Examination Reports — 30-Day KPIs">
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 min-w-0">
          {loading && metrics.length === 0 ? (
            <div className="p-4">
              <TableSkeleton rows={2} />
            </div>
          ) : metrics.length > 0 ? (
            metrics.map((m, i) => (
              <div
                key={m.key}
                className="surface-card bg-bg-base p-4 flex flex-col gap-2 min-w-0 cursor-pointer hover:bg-bg-elevated/40 transition-colors"
                onClick={inspectReports}
                role="button"
                tabIndex={0}
                onKeyDown={(e) => {
                  if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    inspectReports();
                  }
                }}
              >
                <div className="flex items-center gap-2 text-text-muted min-w-0">
                  {(i === 0 ? <TrendingUp className="w-4 h-4 shrink-0" /> : i === 1 ? <CalendarDays className="w-4 h-4 shrink-0" /> : i === 2 ? <Inbox className="w-4 h-4 shrink-0" /> : <FileBarChart className="w-4 h-4 shrink-0" />)}
                  <span className="text-xs font-semibold uppercase tracking-wide truncate">{m.label}</span>
                </div>
                <p className={`text-2xl font-bold ${i === 0 ? "text-action-success" : i === 1 ? "text-action-info" : i === 2 ? "text-action-warning" : "text-white"}`}>
                  {m.value}
                  {m.unit ? <span className="text-sm text-text-muted ml-1">{m.unit}</span> : null}
                </p>
                {loading && !data ? (
                  <Loader2 className="w-4 h-4 animate-spin text-text-muted" />
                ) : (
                  <p className="text-xs text-text-muted">{m.key}</p>
                )}
              </div>
            ))
          ) : (
            <EmptyState message="No report data available for the selected period. Exam season metrics will appear once activity is recorded." />
          )}
        </div>
      </WidgetBoundary>

      {/* Series chart */}
      <WidgetBoundary title="Daily Activity Trend">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex items-center gap-2 min-w-0">
            <TrendingUp className="w-4 h-4 text-action-success shrink-0" />
            <span className="text-sm font-semibold text-white truncate">
              30-Day Examination Activity
            </span>
          </div>
          {loading && seriesLabels.length === 0 ? (
            <div className="p-4">
              <TableSkeleton rows={2} />
            </div>
          ) : seriesLabels.length > 0 ? (
            <div className="p-4">
              <div className="flex items-end gap-1 h-32 min-w-0" role="img" aria-label="Daily activity bar chart">
                {seriesLabels.map((s, i) => (
                  <div key={i} className="flex-1 flex flex-col items-center gap-1 min-w-0">
                    <div
                      className="w-full rounded-t bg-emerald-500/60 min-w-1"
                      style={{
                        height: maxSeries > 0
                          ? `${Math.max(4, (s.value / maxSeries) * 100)}px`
                          : "4px",
                      }}
                      title={`${s.label}: ${s.value}`}
                    />
                    <span className="text-xs text-text-muted rotate-0">{s.label}</span>
                  </div>
                ))}
              </div>
              <p className="mt-3 text-xs text-text-muted">
                {seriesLabels.length} days with recorded activity in the last 30 days.
              </p>
            </div>
          ) : (
            <div className="p-8 text-center">
              <p className="text-sm text-text-muted">No daily trend data for this period yet.</p>
            </div>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}
export default function ExaminationReportsPage() {
  return (
    <AuthGuard allowedRoles={['oie', 'exam_branch', 'exam_superintendent', 'vice_principal', 'principal', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <ExaminationReportsInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

