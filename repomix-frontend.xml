                </Link>{" "}
                tab.
              </p>
            </div>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}

export default function MessInventoryStockPage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <MessInventoryStockInner />
    </Suspense>
  );
}
