"use client";
import { errMsg } from "@/lib/err-msg";

import { useEffect, useState, useCallback } from "react";
import { useRouter } from "next/navigation";
import {
  Activity,
  Database,
  Shield,
  Server,
  AlertTriangle,
  CheckCircle2,
  XCircle,
  Clock,
  Users,
  Zap,
} from "lucide-react";
import { SystemHealth } from "@/lib/health";
import { getAuthHeaders } from "@/lib/utils";

export function HealthDashboard() {
  const router = useRouter();
  const [health, setHealth] = useState<SystemHealth | null>(null);
  const [_loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);
  const [lastUpdated, setLastUpdated] = useState<Date | null>(null);

  const fetchHealth = useCallback(async (isManual = false) => {
    if (isManual) setLoading(true);
    setError(null);
    try {
      const res = await fetch("/api/admin/health/full", { headers: getAuthHeaders(), cache: "no-store" });
      if (!res.ok && res.status !== 503) {
        throw new Error(`Failed to fetch health data (status ${res.status})`);
      }
      const data: SystemHealth = await res.json();
      setHealth(data);
      setLastUpdated(new Date());
    } catch (err) {
      setError(errMsg(err) || "Unable to reach health monitoring service");
    } finally {
      setLoading(false);
    }
  }, []);

  // Initial load only. /api/health reflects the live stack and is cheap to
  // call, but the 15s/60s timer was still the source of the request-spike
  // the user was seeing on the sysadmin area. Manual refresh remains
  // available via the Refresh button in the panel header.
  useEffect(() => {
    fetchHealth(true);
  }, [fetchHealth]);

  const getStatusBadge = (status?: "healthy" | "degraded" | "unhealthy") => {
    switch (status) {
      case "healthy":
        return (
          <span className="surface-card inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold bg-emerald-500/10 text-action-success">
            <CheckCircle2 className="w-3.5 h-3.5" /> Healthy
          </span>
        );
      case "degraded":
        return (
          <span className="surface-card inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold bg-amber-500/10 text-action-warning">
            <AlertTriangle className="w-3.5 h-3.5" /> Degraded
          </span>
        );
      case "unhealthy":
        return (
          <span className="surface-card inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold bg-rose-500/10 text-action-danger">
            <XCircle className="w-3.5 h-3.5" /> Unhealthy
          </span>
        );
      default:
        return (
          <span className="surface-card inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold bg-bg-elevated0/10 text-text-muted">
            Unknown
          </span>
        );
    }
  };

  const getSeverityBadge = (severity: "info" | "warning" | "critical") => {
    switch (severity) {
      case "critical":
        return <span className="surface-card px-2 py-0.5 text-xs font-bold bg-rose-500/20 text-action-danger">CRITICAL</span>;
      case "warning":
        return <span className="surface-card px-2 py-0.5 text-xs font-bold bg-amber-500/20 text-action-warning">WARNING</span>;
      default:
        return <span className="surface-card px-2 py-0.5 text-xs font-bold bg-sky-500/20 text-action-info">INFO</span>;
    }
  };

  return (
    <div className="space-y-6">
      {/* Top Banner */}
      <div className="surface-card flex flex-col md:flex-row md:items-center justify-between gap-4 bg-bg-surface p-6">
        <div className="space-y-1">
          <div className="flex items-center gap-3">
            <h2 className="text-xl font-bold text-text-primary flex items-center gap-2">
              <Activity className="w-5 h-5 text-action-info" /> System Health & Telemetry
            </h2>
            {health && getStatusBadge(health.status)}
          </div>
          <p className="text-xs text-text-muted flex items-center gap-2">
            <Clock className="w-3.5 h-3.5 text-text-muted" />
            {lastUpdated ? `Last updated: ${lastUpdated.toLocaleTimeString()}` : "Fetching..."} (refresh on demand)
          </p>
        </div>
      </div>

      {error && (
        <div className="surface-card p-4 bg-rose-500/10 text-action-danger text-xs font-medium flex items-center gap-3">
          <AlertTriangle className="w-5 h-5 text-action-danger shrink-0" />
          <span>{error}</span>
        </div>
      )}
      {/* Metrics Row */}
      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <div className="surface-card bg-bg-surface p-4 space-y-1">
          <div className="text-xs text-text-muted flex items-center justify-between">
            <span>Active Users</span>
            <Users className="w-4 h-4 text-action-info" />
          </div>
          <p className="text-2xl font-black text-text-primary">{health?.metrics?.activeUsers ?? "-"}</p>
          <p className="text-xs text-text-muted">{health?.metrics?.activeSessions ?? 0} active sessions</p>
        </div>

        <div className="surface-card bg-bg-surface p-4 space-y-1">
          <div className="text-xs text-text-muted flex items-center justify-between">
            <span>Requests / Min</span>
            <Zap className="w-4 h-4 text-action-warning" />
          </div>
          <p className="text-2xl font-black text-text-primary">{health?.metrics?.requestsPerMinute ?? "-"}</p>
          <p className="text-xs text-text-muted">Live API throughput</p>
        </div>

        <div className="surface-card bg-bg-surface p-4 space-y-1">
          <div className="text-xs text-text-muted flex items-center justify-between">
            <span>Avg Latency</span>
            <Clock className="w-4 h-4 text-action-success" />
          </div>
          <p className="text-2xl font-black text-text-primary">
            {health?.metrics?.avgResponseTime !== undefined ? `${Math.round(health.metrics.avgResponseTime)} ms` : "—"}
          </p>
          <p className="text-xs text-text-muted">
            {health?.metrics?.avgResponseTime ? (health.metrics.avgResponseTime < 50 ? "Optimal" : health.metrics.avgResponseTime < 200 ? "Acceptable" : "Elevated") : "Capturing data..."}
          </p>
        </div>

        <div className="surface-card bg-bg-surface p-4 space-y-1">
          <div className="text-xs text-text-muted flex items-center justify-between">
            <span>Error Rate</span>
            <AlertTriangle className="w-4 h-4 text-action-danger" />
          </div>
          <p className="text-2xl font-black text-text-primary">
            {health?.metrics?.errorRate !== undefined ? `${(health.metrics.errorRate * 100).toFixed(2)}%` : "0.00%"}
          </p>
          <p className="text-xs text-text-muted">Threshold: &lt; 5.00%</p>
        </div>
      </div>
      {/* Component Cards */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div
          onClick={() => router.push("/sysadmin/audit")}
          className="surface-card bg-bg-surface p-5 space-y-4 cursor-pointer hover:bg-bg-elevated transition-all group"
        >
          <div className="surface-card flex items-center justify-between pb-3">
            <h3 className="font-bold text-sm text-text-primary flex items-center gap-2 group-hover:text-action-info transition-colors">
              <Database className="w-4 h-4 text-action-info" /> Database
            </h3>
            {getStatusBadge(health?.components?.database?.status)}
          </div>
          <div className="space-y-2 text-xs">
            <div className="flex justify-between">
              <span className="text-text-muted">Latency</span>
              <span className="font-mono text-text-primary font-medium">{health?.components?.database?.latency ?? 0} ms</span>
            </div>
            {health?.components?.database?.error && (
              <div className="surface-card p-2.5 bg-rose-500/10 text-action-danger font-mono text-xs">
                {health.components.database.error}
              </div>
            )}
            <p className="text-xs text-text-muted mt-2 flex items-center gap-1">
              Click to view audit telemetry →
            </p>
          </div>
        </div>

        <div
          onClick={() => router.push("/admin/gates")}
          className="surface-card bg-bg-surface p-5 space-y-4 cursor-pointer hover:bg-bg-elevated transition-all group"
        >
          <div className="surface-card flex items-center justify-between pb-3">
            <h3 className="font-bold text-sm text-text-primary flex items-center gap-2 group-hover:text-unit-c transition-colors">
              <Server className="w-4 h-4 text-unit-c" /> Gate Turnstiles
            </h3>
            {getStatusBadge(health?.components?.gateways?.status)}
          </div>
          <div className="space-y-2 text-xs">
            <div className="flex justify-between">
              <span className="text-text-muted">Online</span>
              <span className="font-mono text-action-success font-bold">{health?.components?.gateways?.online ?? 0}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-text-muted">Total Gates</span>
              <span className="font-mono text-text-primary font-bold">{health?.components?.gateways?.total ?? 0}</span>
            </div>
            <p className="text-xs text-text-muted mt-2 flex items-center gap-1">
              Click to manage gate hardware →
            </p>
          </div>
        </div>

        <div
          onClick={() => router.push("/sysadmin/security")}
          className="surface-card bg-bg-surface p-5 space-y-4 cursor-pointer hover:bg-bg-elevated transition-all group"
        >
          <div className="surface-card flex items-center justify-between pb-3">
            <h3 className="font-bold text-sm text-text-primary flex items-center gap-2 group-hover:text-action-success transition-colors">
              <Shield className="w-4 h-4 text-action-success" /> Subsystems
            </h3>
            {getStatusBadge((health?.components?.services?.auth?.status === "degraded" ? "degraded" : health?.components?.services?.status) as any)}
          </div>
          <div className="space-y-2 text-xs">
            <div className="flex justify-between">
              <span className="text-text-muted">Auth & JWT Engine</span>
              <span className="text-action-success font-bold text-xs">
                {health?.components?.services?.auth?.status === "healthy" ? "Operational" : "Degraded"}
              </span>
            </div>
            <div className="flex justify-between">
              <span className="text-text-muted">Background Worker</span>
              <span className="text-action-success font-bold text-xs">Operational</span>
            </div>
            <p className="text-xs text-text-muted mt-2 flex items-center gap-1">
              Click to manage security policies →
            </p>
          </div>
        </div>
      </div>

      {/* Recent Alerts */}
      <div className="surface-card bg-bg-surface p-6 space-y-4">
        <h3 className="font-bold text-sm text-text-primary flex items-center gap-2">
          <AlertTriangle className="w-4 h-4 text-action-warning" /> System Alerts
        </h3>
        {!health?.recentAlerts || health.recentAlerts.length === 0 ? (
          <div className="surface-card py-6 text-center text-xs text-text-muted">
            No active system alerts recorded. All subsystems operating normally.
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs min-w-[650px]">
              <thead>
                <tr className="border-b border-border text-text-muted">
                  <th className="pb-2">Severity</th>
                  <th className="pb-2">Message</th>
                  <th className="pb-2 text-right">Timestamp</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {(health?.recentAlerts || []).map((alert) => (
                  <tr key={alert.id} className="hover:bg-bg-elevated/50 transition-colors">
                    <td className="py-2.5">{getSeverityBadge(alert.severity)}</td>
                    <td className="py-2.5 font-medium text-text-primary">{alert.message}</td>
                    <td className="py-2.5 text-right font-mono text-text-muted text-xs">
                      {new Date(alert.timestamp).toLocaleString()}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/HodIdInput.tsx">
"use client";
import { useEffect, useState } from "react";
import { Search, Loader2, CheckCircle2, XCircle, AlertTriangle } from "lucide-react";

interface LookupResult {
  found: boolean;
  id?: string;
  name?: string;
  uniqueId?: string;
  roll?: string | null;
  employeeId?: string | null;
  role?: string;
  status?: string;
  department?: { code: string; name: string } | null;
  isHodOfDepartment?: string | null;
  eligible?: boolean;
  reason?: string;
  willTransferFrom?: { code: string; name: string } | null;
}

type State =
  | { kind: "idle" }
  | { kind: "checking" }
  | { kind: "ready"; result: LookupResult }
  | { kind: "error"; message: string };

export function HodIdInput({
  value,
  onChange,
  onResolved,
}: {
  value: string;
  onChange: (raw: string) => void;
  onResolved: (userId: string | null) => void;
}) {
  const [state, setState] = useState<State>({ kind: "idle" });

  useEffect(() => {
    if (!value.trim()) {
      setState({ kind: "idle" });
      onResolved(null);
      return;
    }
    let cancelled = false;
    setState({ kind: "checking" });
    const t = setTimeout(async () => {
      try {
        const res = await fetch(
          `/api/users/lookup?id=${encodeURIComponent(value.trim())}`,
          { headers: { "Content-Type": "application/json" } }
        );
        const json: LookupResult = await res.json();
        if (cancelled) return;
        setState({ kind: "ready", result: json });
        onResolved(json.found && json.eligible ? json.id! : null);
      } catch {
        if (!cancelled) {
          setState({ kind: "error", message: "Lookup failed" });
          onResolved(null);
        }
      }
    }, 350);
    return () => {
      cancelled = true;
      clearTimeout(t);
    };
  }, [value, onResolved]);

  return (
    <div className="space-y-2">
      <div className="relative">
        <Search
          className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"
        />
        <input
          type="text"
          value={value}
          onChange={(e) => onChange(e.target.value)}
          placeholder="Enter roll number, employee ID, unique ID, or email"
          className="surface-card w-full bg-background py-2 pl-9 pr-10 text-sm outline-none focus:"
        />
        {state.kind === "checking" && (
          <Loader2
            className="absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 animate-spin text-muted-foreground"
          />
        )}
      </div>

      {state.kind === "ready" && <LookupBanner result={state.result} />}
      {state.kind === "error" && (
        <p className="text-xs text-destructive">{state.message}</p>
      )}
    </div>
  );
}

function LookupBanner({ result }: { result: LookupResult }) {
  if (!result.found) {
    return (
      <div className="surface-card flex items-start gap-2 bg-destructive/5 px-3 py-2 text-sm text-destructive">
        <XCircle className="mt-0.5 h-4 w-4 shrink-0" />
        <div>
          <div className="font-medium">Not found</div>
          <div className="text-xs">{result.reason}</div>
        </div>
      </div>
    );
  }

  if (result.eligible === false) {
    return (
      <div className="surface-card flex items-start gap-2 bg-orange-500/5 px-3 py-2 text-sm text-orange-400">
        <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
        <div>
          <div className="font-medium">
            {result.name} <span className="opacity-70">· {result.role}</span>
          </div>
          <div className="text-xs">{result.reason}</div>
        </div>
      </div>
    );
  }

  if (result.willTransferFrom) {
    return (
      <div className="surface-card flex items-start gap-2 bg-blue-500/5 px-3 py-2 text-sm text-blue-300">
        <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
        <div>
          <div className="font-medium">{result.name}</div>
          <div className="text-xs">
            Currently HOD of{" "}
            <strong>{result.willTransferFrom.name}</strong>. Saving will transfer
            the HOD role to this department.
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="surface-card flex items-start gap-2 bg-emerald-500/5 px-3 py-2 text-sm text-emerald-400">
      <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0" />
      <div>
        <div className="font-medium">
          {result.name}
          <span className="ml-2 text-xs font-normal opacity-70">
            {result.role}
            {result.department ? ` · ${result.department.name}` : ""}
          </span>
        </div>
        <div className="text-xs">
          {result.roll && <>Roll: {result.roll} · </>}
          {result.employeeId && <>Emp ID: {result.employeeId} · </>}
          Unique ID: {result.uniqueId}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/IntegrationsDashboard.tsx">
"use client";

import { useEffect, useState } from "react";
import { useUIStore } from "@/stores/uiStore";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { RefreshCw, CheckCircle2, Zap, Server, Activity, Database } from "lucide-react";
import { useApi } from "@/hooks/useApi";

export function IntegrationsDashboard() {
const api = useApi();

  const { addToast } = useUIStore();

  const [integrations, setIntegrations] = useState<any[]>([]);
  const [logs, setLogs] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [syncingId, setSyncingId] = useState<string | null>(null);
  const [ldapSyncing, setLdapSyncing] = useState(false);

  const handleLdapSync = async () => {
    setLdapSyncing(true);
    try {
      const headers = api.getHeaders();
      const res = await fetch("/api/admin/ldap/sync", { method: "POST", headers });
      const result = await res.json();
      if (result.success) {
        addToast({
          variant: "success",
          title: "LDAP Sync Complete",
          message: `Processed: ${result.data?.usersProcessed || 0}, Created: ${result.data?.usersCreated || 0}, Updated: ${result.data?.usersUpdated || 0}`,
        });
        fetchIntegrations();
      } else {
        addToast({ variant: "error", title: "LDAP Sync Failed", message: result.error?.message || "Error syncing Active Directory" });
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "LDAP sync request failed" });
    } finally {
      setLdapSyncing(false);
    }
  };

  const fetchIntegrations = async () => {
    setLoading(true);
    try {
      const headers = api.getHeaders();
      const [resConfig, resLogs] = await Promise.all([
        fetch("/api/integrations", { headers }),
        fetch("/api/integrations/logs", { headers }),
      ]);
      const dataConfig = await resConfig.json();
      const dataLogs = await resLogs.json();

      if (dataConfig.success) setIntegrations(dataConfig.data || []);
      if (dataLogs.success) setLogs(dataLogs.data || []);
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to load integrations" });
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { fetchIntegrations(); }, []);

  const handleSyncNow = async (id: string) => {
    setSyncingId(id);
    try {
      const headers = api.getHeaders();
      const res = await fetch(`/api/integrations/${id}/sync`, { method: "POST", headers });
      const result = await res.json();
      if (result.success) {
        addToast({ variant: "success", title: "Sync Completed", message: result.data.message });
        fetchIntegrations();
      }
    } finally {
      setSyncingId(null);
    }
  };

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center">
        <div>
          <p className="text-2xl font-bold tracking-tight">Integration Hub</p>
          <p className="text-sm text-text-muted">Manage HR, SIS, Email/SMS, and Biometric connections.</p>
        </div>
        <Button onClick={fetchIntegrations} variant="secondary" size="sm" className="gap-2">
          <RefreshCw className={`w-4 h-4 ${loading ? "animate-spin" : ""}`} /> Refresh
        </Button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card className="border shadow-sm border-blue-500/30">
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <div className="flex items-center gap-3">
              <div className="surface-card p-2 bg-action-primary/10 dark:bg-blue-950/40">
                <Server className="w-5 h-5 text-action-primary" />
              </div>
              <div>
                <CardTitle className="text-base">Active Directory / LDAP</CardTitle>
                <CardDescription className="text-xs">User Directory & IAM Sync</CardDescription>
              </div>
            </div>
            <Badge variant="success">Active</Badge>
          </CardHeader>
          <CardContent className="space-y-4 pt-2">
            <div className="text-xs text-text-muted flex justify-between">
              <span>Status:</span>
              <span className="font-medium text-action-success flex items-center gap-1"><CheckCircle2 className="size-3.5" /> Connected</span>
            </div>
            <Button onClick={handleLdapSync} disabled={ldapSyncing} size="sm" className="w-full gap-1 text-xs variant-primary">
              <Zap className={`w-3.5 h-3.5 ${ldapSyncing ? "animate-spin" : ""}`} /> Sync LDAP Now
            </Button>
          </CardContent>
        </Card>

        {integrations.map((item) => (
          <Card key={item.id} className="border shadow-sm">
            <CardHeader className="flex flex-row items-center justify-between pb-2">
              <div className="flex items-center gap-3">
                <div className="surface-card p-2 bg-bg-elevated dark:bg-bg-elevated">
                  {item.type === "hr_sync" ? <Database className="w-5 h-5 text-action-primary" /> : <Server className="w-5 h-5 text-unit-c" />}
                </div>
                <div>
                  <CardTitle className="text-base">{item.name}</CardTitle>
                  <CardDescription className="text-xs capitalize">{item.type.replace("_", " ")}</CardDescription>
                </div>
              </div>
              <Badge variant={item.enabled ? "success" : "offline"}>{item.enabled ? "Active" : "Disabled"}</Badge>
            </CardHeader>
            <CardContent className="space-y-4 pt-2">
              <div className="text-xs text-text-muted flex justify-between">
                <span>Status:</span>
                <span className="font-medium text-action-success flex items-center gap-1"><CheckCircle2 className="size-3.5" /> Connected</span>
              </div>
              <Button onClick={() => handleSyncNow(item.id)} disabled={syncingId === item.id || !item.enabled} size="sm" className="w-full gap-1 text-xs">
                <Zap className={`w-3.5 h-3.5 ${syncingId === item.id ? "animate-spin" : ""}`} /> Sync Now
              </Button>
            </CardContent>
          </Card>
        ))}
      </div>

      <Card className="border">
        <CardHeader>
          <CardTitle className="text-lg font-semibold flex items-center gap-2"><Activity className="w-5 h-5 text-action-primary" /> Sync Logs</CardTitle>
        </CardHeader>
        <CardContent>
          <div className="overflow-x-auto">
            <table className="w-full text-sm text-left">
              <thead className="bg-bg-elevated dark:bg-bg-elevated/50 text-text-muted">
                <tr><th className="p-3">Integration</th><th className="p-3">Status</th><th className="p-3">Records</th><th className="p-3">Timestamp</th></tr>
              </thead>
              <tbody className="divide-y">
                {logs.map((log) => (
                  <tr key={log.id}>
                    <td className="p-3 font-medium capitalize">{log.type.replace("_", " ")}</td>
                    <td className="p-3"><Badge variant={log.status === "success" ? "success" : "error"}>{log.status}</Badge></td>
                    <td className="p-3 font-mono">{log.records_synced}</td>
                    <td className="p-3 text-xs text-text-muted">{new Date(log.timestamp).toLocaleString()}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/LMSIntegration.tsx">
"use client";

import React, { useState, useEffect } from "react";
import { Card, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { useUIStore } from "@/stores/uiStore";
import { BookOpen, RefreshCw } from "lucide-react";
import { useApi } from "@/hooks/useApi";

export function LMSIntegration() {
const api = useApi();

  const { addToast } = useUIStore();
  const [config, setConfig] = useState({
    platform: "moodle",
    api_url: "https://moodle.campus.edu/webservice/rest/server.php",
    sync_schedule: "daily_02:00",
    auto_push_attendance: true,
    status: "connected",
    last_synced_at: new Date().toISOString(),
  });
  const [loading, setLoading] = useState(true);
  const [syncing, setSyncing] = useState(false);


  const fetchStatus = async () => {
    setLoading(true);
    try {
      const headers = api.getHeaders();
      const res = await fetch("/api/integrations/lms/status", { headers });
      const result = await res.json();
      if (result.success && result.data) {
        setConfig((prev) => ({ ...prev, ...result.data }));
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to fetch LMS status" });
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchStatus();
  }, []);

  const handleSyncNow = async () => {
    setSyncing(true);
    try {
      const headers = api.getHeaders();
      const res = await fetch("/api/integrations/lms/sync", { method: "POST", headers });
      const result = await res.json();
      if (result.success) {
        addToast({ variant: "success", title: "Sync Complete", message: result.message });
        fetchStatus();
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "LMS sync failed" });
    } finally {
      setSyncing(false);
    }
  };

  if (loading) return <div className="p-4 text-xs text-text-secondary">Loading LMS Integration...</div>;

  return (
    <Card className="p-4 space-y-4">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <div className="flex items-center gap-3">
          <BookOpen className="h-6 w-6 text-action-primary" />
          <div>
            <CardTitle className="text-base">LMS Integration (Moodle / Canvas)</CardTitle>
            <p className="text-xs text-text-secondary">
              Automated roster synchronization & real-time gate scan attendance push.
            </p>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <Badge variant={config.status === "connected" ? "success" : "error"} className="text-xs">
            {config.status.toUpperCase()}
          </Badge>
          <Button variant="secondary" size="sm" onClick={handleSyncNow} disabled={syncing} className="gap-1 text-xs">
            <RefreshCw className={`h-3.5 w-3.5 ${syncing ? "animate-spin" : ""}`} />
            {syncing ? "Syncing..." : "Sync Roster Now"}
          </Button>
        </div>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <div className="surface-card p-2.5 bg-[var(--bg-surface-elevated)]">
          <span className="text-text-secondary">Platform Target</span>
          <div className="font-bold text-sm uppercase">{config.platform}</div>
        </div>
        <div className="surface-card p-2.5 bg-[var(--bg-surface-elevated)]">
          <span className="text-text-secondary">Sync Schedule</span>
          <div className="font-bold text-sm">{config.sync_schedule}</div>
        </div>
        <div className="surface-card p-2.5 bg-[var(--bg-surface-elevated)]">
          <span className="text-text-secondary">Last Synced</span>
          <div className="font-bold text-sm">{new Date(config.last_synced_at).toLocaleTimeString()}</div>
        </div>
      </div>
    </Card>
  );
}
