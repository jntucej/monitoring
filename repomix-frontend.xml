                >
                  {r.ticket_number}
                </a>
              </td>
              <td className="px-4 py-3 text-text-secondary min-w-0">
                {r.student?.name || "—"}
                {r.student?.student_details?.roll ? (
                  <span className="ml-2 text-xs text-text-muted">{r.student.student_details.roll}</span>
                ) : null}
