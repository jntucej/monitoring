<file path="src/app/(approver)/vice-principal/decision-history/page.tsx">
"use client";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { Suspense, useCallback, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { History, ScrollText } from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { decisionRecordInspection } from "@/components/approver/wardenConsoleModels";


interface DecisionRow {
  id: string;
  ticket_number: string;
  workflow_type: string;
  current_stage: string;
  status: string;
  updated_at?: string | null;
  student?: {
    name: string;
    student_details?: { roll?: string } | null;
  } | null;
}

interface PermissionsResponse {
  success: boolean;
  data: DecisionRow[];
  total?: number;
}

type StatusFilter = "ALL" | "APPROVED" | "REJECTED";

function VpDecisionHistoryInner() {
  const [filter, setFilter] = useState<StatusFilter>("ALL");
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const inspectRow = (r: DecisionRow) => {
    inspect(
      decisionRecordInspection({
        id: r.id,
        ticket_number: r.ticket_number,
        workflow_type: r.workflow_type,
        current_stage: r.current_stage,
        status: r.status,
        updated_at: r.updated_at ?? null,
        created_at: null,
        student: r.student
          ? { name: r.student.name, student_details: r.student.student_details ? { roll: r.student.student_details.roll } : null }
          : null,
      }),
    );
  };

  const {
    data: approved,
    loading: approvedLoading,
    error: approvedError,
    refresh: refreshApproved,
  } = useApiResource<PermissionsResponse>("/api/permissions?status=APPROVED", {
    ttlMs: 60_000,
  });

  const {
    data: rejected,
    loading: rejectedLoading,
    error: rejectedError,
    refresh: refreshRejected,
  } = useApiResource<PermissionsResponse>("/api/permissions?status=REJECTED", {
    ttlMs: 60_000,
  });

  const refreshAll = useCallback(async () => {
    clearCache();
    await Promise.all([refreshApproved(), refreshRejected()]);
  }, [refreshApproved, refreshRejected]);

  usePolling(refreshAll, { intervalMs: 60_000, enabled: true });

  const approvedRows: DecisionRow[] = (approved?.data ?? []) as DecisionRow[];
  const rejectedRows: DecisionRow[] = (rejected?.data ?? []) as DecisionRow[];

  const merged =
    filter === "APPROVED"
      ? approvedRows.map((r) => ({ ...r, status: "APPROVED" as const }))
      : filter === "REJECTED"
        ? rejectedRows.map((r) => ({ ...r, status: "REJECTED" as const }))
        : [
            ...approvedRows.map((r) => ({ ...r, status: "APPROVED" as const })),
            ...rejectedRows.map((r) => ({ ...r, status: "REJECTED" as const })),
          ].sort((a, b) => {
            const ta = a.updated_at ? new Date(a.updated_at).getTime() : 0;
            const tb = b.updated_at ? new Date(b.updated_at).getTime() : 0;
            return tb - ta;
          });

  const loading =
    (approvedLoading && !approved) ||
    (filter !== "APPROVED" && rejectedLoading && !rejected);
  const error = approvedError || (filter !== "APPROVED" ? rejectedError : null);

  return (
    <div className="mx-auto max-w-7xl space-y-5 px-4 py-6 md:px-6 min-w-0">
      <ContextSituationBar
        roleLabel="Vice Principal"
        purpose="Searchable audit trail of past determinations, sign-offs, and rejected requests"
        why="Auditing past approvals and rejections maintains accountability and provides a consistent reference for future determinations."
        contextLabel="Executive Decision Ledger"
        statusSummary="Audit approved, rejected, and delegated decisions with full provenance and timestamps."
        primaryAction={{ label: "Pending Approvals", href: "/vice-principal/pending-approvals" }}
        secondaryAction={{ label: "30-Day History", href: "/vice-principal/history/30-days" }}
      />
      <WidgetBoundary title="Decision History">
        <div className="surface-card bg-bg-base p-4 min-w-0">
          <div className="flex flex-wrap items-center gap-2 text-text-muted mb-3 min-w-0">
            <History className="w-4 h-4 shrink-0" />
            <span className="text-xs font-semibold uppercase tracking-wide">
              Past Decisions — VP Scope
            </span>
          </div>

          {/* status filter */}
          <div className="flex items-center gap-2 overflow-x-auto mb-3 min-w-0">
            {(["ALL", "APPROVED", "REJECTED"] as const).map((f) => (
              <button
                key={f}
                type="button"
                onClick={() => setFilter(f)}
                className={`px-3 py-1.5 rounded-lg text-xs font-semibold border shrink-0 transition-colors ${
                  filter === f
                    ? "bg-sky-500/15 text-action-info border-sky-500/30"
                    : "bg-bg-elevated text-text-muted border-border hover:text-text-secondary"
                }`}
              >
                {f === "ALL" ? "All" : f.charAt(0) + f.slice(1).toLowerCase()}
              </button>
            ))}
            <span className="ml-auto text-xs text-text-muted shrink-0">
              {approved?.total ?? 0} approved · {rejected?.total ?? 0} rejected
            </span>
          </div>

          {error && (
            <div className="surface-card mb-3 bg-amber-500/10 p-3 text-xs text-action-warning">
              History unavailable: {error}
            </div>
          )}

          {loading ? (
            <div className="space-y-2 min-w-0">
              {[0, 1, 2].map((i) => (
                <div key={i} className="h-12 rounded-lg bg-bg-elevated/60 animate-pulse" />
              ))}
            </div>
          ) : merged.length === 0 ? (
            <div className="p-6 text-center">
              <ScrollText className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No past decisions recorded in this scope.</p>
            </div>
          ) : (
            <ul className="space-y-2 min-w-0">
              {merged.slice(0, 20).map((r) => (
                <li
                  key={`${r.status}-${r.id}`}
                  className="surface-card bg-bg-surface/40 px-3 py-2 min-w-0 flex flex-wrap items-center gap-2 cursor-pointer hover:bg-bg-elevated/30 transition-colors"
                  onClick={() => inspectRow(r)}
                >
                  <span
                    className={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold shrink-0 ${
                      r.status === "APPROVED"
                        ? "bg-emerald-500/15 text-action-success border border-emerald-500/30"
                        : "bg-rose-500/15 text-action-danger border border-rose-500/30"
                    }`}
                  >
                    {r.status}
                  </span>
                  <span className="font-mono text-xs text-action-info shrink-0">{r.ticket_number}</span>
                  <span className="text-sm text-text-secondary truncate min-w-0 flex-1">
                    {r.student?.name || "—"}
                    {r.student?.student_details?.roll ? ` · ${r.student.student_details.roll}` : ""}
                  </span>
                  <span className="text-xs text-text-muted capitalize shrink-0">
                    {r.workflow_type.replace(/_/g, " ")}
                  </span>
                  <span className="text-xs text-text-muted shrink-0 ml-auto">
                    {r.updated_at
                      ? new Date(r.updated_at).toLocaleDateString(undefined, {
                          month: "short",
                          day: "numeric",
                          year: "numeric",
                        })
                      : "—"}
                  </span>
                </li>
              ))}
              {merged.length > 20 && (
                <li className="text-xs text-text-muted">
                  Showing 20 of {merged.length} decisions.
                </li>
              )}
            </ul>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}
export default function VpDecisionHistoryPage() {
  return (
    <AuthGuard allowedRoles={['vice_principal', 'exam_branch', 'oie', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <VpDecisionHistoryInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

