"use client";

import { useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { useApiResource } from "@/hooks/useApiResource";
import { useRoleContext } from "@/hooks/useRoleContext";
import { PrincipalEmptyState as EmptyState } from "@/components/principal/shared/PrincipalEmptyState";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { buildDelegationInspection } from "@/lib/principal/registerInspections";
import {
  buildDelegationInspection as buildMainDelegationInspection,
  type DelegationRecord,
  type RoleGate,
} from "./entityInspectionModels";
import { DataTable } from "@/components/ui/DataTable";
import { KpiCard } from "./KpiCard";
import { ListSkeleton } from "./ListSkeleton";
import { WeekBar } from "./WeekBar";
import { PrincipalEmptyReconciler } from "@/components/nav/level3/PrincipalRecordHub";
import { SmartTextRef } from "@/components/nav/SmartTextRef";

interface Delegation {
  id: string;
  delegate_role?: string;
  scope?: string;
  starts_at?: string;
  expires_at?: string | null;
  status?: string;
  note?: string | null;
}

interface DelegationsResponse {
  success?: boolean;
  data: {
    delegations: Delegation[];
    auditTrail?: unknown[];
  };
}

export function DelegationsView() {
  const { data, loading } = useApiResource<DelegationsResponse>("/api/principal/delegations", {
    ttlMs: 30_000,
  });

  const role = useRoleContext();
  const gate: RoleGate = {
    isPrincipal: role.isPrincipal,
    isFaculty: role.isFaculty,
    role: role.role ?? null,
  };
  const router = useRouter();
  const [filter, setFilter] = useState<"all" | "active" | "inactive">("all");
  const [mainInspection, setMainInspection] = useState<
    ReturnType<typeof buildMainDelegationInspection> | null
  >(null);
  const inspectMain = (d: Delegation) =>
    setMainInspection(buildMainDelegationInspection(d as DelegationRecord, gate));

  const delegations = data?.data?.delegations ?? [];
  const isActive = (d: Delegation) => (d.status ?? "ACTIVE").toUpperCase() === "ACTIVE";
  const activeCount = delegations.filter(isActive).length;
  const inactiveCount = delegations.length - activeCount;
  const visibleDelegations = delegations.filter((d) => {
    if (filter === "active") return isActive(d);
    if (filter === "inactive") return !isActive(d);
    return true;
  });
  const {
    inspection: ourInspection,
    closeInspection,
  } = useEntityInspector();
  const openInspector = (d: Delegation) => inspectMain(d);

  return (
    <div className="space-y-4">
      <WeekBar />
      <header className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 className="text-lg font-semibold text-text-primary">Delegations Manager</h1>
          <p className="text-xs text-text-muted">
            Delegated authority rules and institutional scope · click any rule to inspect or revoke
          </p>
        </div>
        <div className="flex flex-wrap items-center gap-2">
          <nav className="flex flex-wrap items-center gap-1.5" aria-label="Delegation filters">
            {[
              { key: "all" as const, label: "All", count: delegations.length },
              { key: "active" as const, label: "Active", count: activeCount },
              { key: "inactive" as const, label: "Inactive", count: inactiveCount },
            ].map((tab) => (
              <button
                key={tab.key}
                type="button"
                onClick={() => setFilter(tab.key)}
                className={`inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1 text-xs font-medium transition-colors ${
                  filter === tab.key
                    ? "border-action-primary bg-action-primary/10 text-action-primary"
                    : "border-border bg-bg-surface text-text-secondary hover:bg-bg-elevated"
                }`}
              >
                <span>{tab.label}</span>
                <span className="font-mono text-[11px] opacity-80">{tab.count}</span>
              </button>
            ))}
          </nav>
          <Link
            href="/principal/approvals/delegated"
            className="rounded-lg border border-border bg-bg-surface px-2.5 py-1 text-xs font-medium text-action-primary hover:bg-bg-elevated"
          >
            Delegated Queue &rarr;
          </Link>
        </div>
      </header>

      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <KpiCard label="Total Delegations" value={delegations.length} onClick={() => setFilter("all")} />
        <KpiCard label="Active Rules" value={activeCount} tone="ok" onClick={() => setFilter("active")} />
        <KpiCard
          label="Coverage"
          value={activeCount > 0 ? "Protected" : "Direct"}
          tone={activeCount > 0 ? "ok" : "warn"}
          onClick={() => router.push("/principal/approvals/delegated")}
        />
      </div>

      {loading && delegations.length === 0 ? (
        <ListSkeleton rows={5} />
      ) : visibleDelegations.length === 0 ? (
        <PrincipalEmptyReconciler
          title="No matching delegations"
          breakdown={[
            { label: "Delegated Approvals", count: 0, href: "/principal/approvals/delegated" },
            { label: "Pending Queue", count: 0, href: "/principal/approvals/pending" },
          ]}
        />
      ) : (
        <>
          <ul className="space-y-2 md:hidden">
            {visibleDelegations.map((d) => (
              <li key={d.id}>
                <button
                  type="button"
                  onClick={() => openInspector(d)}
                  onKeyDown={(e) => {
                    if (e.key === "Enter" || e.key === " ") openInspector(d);
                  }}
                  aria-label={`Inspect delegation: ${d.delegate_role ?? "delegation"}`}
                  className="surface-card block w-full bg-bg-surface p-3 text-left cursor-pointer hover:bg-bg-surface/60 transition-colors"
                >
                  <div className="flex items-center justify-between">
                    <p className="text-sm font-medium">{d.delegate_role?.replace(/_/g, " ")}</p>
                    <span className="surface-card bg-action-primary/10 px-2 py-0.5 text-xs text-action-primary">
                      {d.status ?? "ACTIVE"}
                    </span>
                  </div>
                  <p className="mt-1 text-xs text-text-secondary">
                    Scope: <SmartTextRef text={d.scope ?? "Full"} currentPath="/principal/governance/delegations" />
                  </p>
                </button>
              </li>
            ))}
          </ul>

          <div className="hidden md:block">
            <DataTable<Delegation>
              onRowClick={openInspector}
              columns={[
                {
                  header: "Delegate Role",
                  accessor: (r) => r.delegate_role?.replace(/_/g, " ") ?? "—",
                },
                {
                  header: "Scope",
                  accessor: (r) => r.scope ?? "All Workflows",
                },
                {
                  header: "Starts",
                  accessor: (r) => (r.starts_at ? new Date(r.starts_at).toLocaleDateString() : "—"),
                },
                {
                  header: "Status",
                  accessor: (r) => (
                    <span className="surface-card bg-action-primary/10 px-2 py-0.5 text-xs text-action-primary">
                      {r.status ?? "ACTIVE"}
                    </span>
                  ),
                },
                {
                  header: "Overview",
                  accessor: (r) => (
                    <button
                      type="button"
                      onClick={(e) => {
                        e.stopPropagation();
                        openInspector(r);
                      }}
                      className="text-xs font-semibold text-action-primary hover:underline"
                    >
                      Open &rarr;
                    </button>
                  ),
                },
              ]}
              data={visibleDelegations}
              keyExtractor={(r) => r.id}
            />
          </div>
        </>
      )}

      <EntityInspectorPanel inspection={ourInspection} onClose={closeInspection} />
      <EntityInspector inspection={mainInspection} onClose={() => setMainInspection(null)} />
    </div>
  );
}
</file>

<file path="src/app/(approver)/principal/_shared/DepartmentsView.tsx">
"use client";

import { useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { useApiResource } from "@/hooks/useApiResource";
import { PrincipalEmptyState as EmptyState } from "@/components/principal/shared/PrincipalEmptyState";
import { DataTable } from "@/components/ui/DataTable";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { buildDepartmentInspection } from "@/lib/principal/registerInspections";
import {
  buildDepartmentInspection as buildMainDepartmentInspection,
  type RoleGate,
} from "./entityInspectionModels";
import { useRoleContext } from "@/hooks/useRoleContext";
import { KpiCard } from "./KpiCard";
import { ListSkeleton } from "./ListSkeleton";
import { WeekBar } from "./WeekBar";

interface DepartmentItem {
  code: string;
  name: string;
  hodName: string | null;
  faculty: number;
  students: number;
  ratio: number;
  attendancePct: number;
}

interface AcademicsResponse {
  success?: boolean;
  data: {
    departments: DepartmentItem[];
    summary: {
      totalDepts: number;
      totalStudents: number;
      totalFaculty: number;
      avgAttendance: number;
    };
  };
}

export function DepartmentsView() {
  const { data, loading } = useApiResource<AcademicsResponse>("/api/vp/academics", {
    ttlMs: 60_000,
  });
  const {
    inspection: ourInspection,
    inspect: ourInspect,
    closeInspection,
  } = useEntityInspector();

  const role = useRoleContext();
  const gate: RoleGate = {
    isPrincipal: role.isPrincipal,
    isFaculty: role.isFaculty,
    role: role.role ?? null,
  };
  const [mainInspection, setMainInspection] = useState<
    ReturnType<typeof buildMainDepartmentInspection> | null
  >(null);
  const inspectMain = (dept: DepartmentItem) =>
    setMainInspection(buildMainDepartmentInspection(dept, gate));

  const router = useRouter();
  const d = data?.data;
  const openInspector = (dept: DepartmentItem) => {
    const model = buildDepartmentInspection(dept);
    ourInspect({
      ...model,
      detailHref: `/principal/people/departments/${encodeURIComponent(dept.code)}`,
      detailLabel: "Open department page",
    });
  };

  return (
    <div className="space-y-4">
      <WeekBar />
      <header>
        <h1 className="text-lg font-semibold text-text-primary">Departments</h1>
        <p className="text-xs text-text-muted">
          Headcount and attendance per department
        </p>
      </header>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <KpiCard
          label="Departments"
          value={d?.summary?.totalDepts}
          onClick={
            d && d.departments.length > 0 ? () => openInspector(d.departments[0]) : undefined
          }
        />
        <KpiCard
          label="Students"
          value={d?.summary?.totalStudents}
          onClick={() => router.push("/principal/people")}
        />
        <KpiCard
          label="Faculty"
          value={d?.summary?.totalFaculty}
          onClick={() => router.push("/principal/people")}
        />
        <KpiCard
          label="Avg attendance"
          value={d?.summary?.avgAttendance !== undefined ? `${d.summary.avgAttendance}%` : "—"}
          tone="ok"
          onClick={() => router.push("/principal/people/attendance")}
        />
      </div>

      {loading && !d ? (
        <ListSkeleton rows={5} />
      ) : !d || (d.departments ?? []).length === 0 ? (
        <EmptyState title="No departments found" description="Department details are currently unavailable." />
      ) : (
        <>
          <ul className="space-y-2 md:hidden">
            {(d?.departments ?? []).map((dept) => (
              <li key={dept.code}>
                <button
                  type="button"
                  onClick={() => openInspector(dept)}
                  onKeyDown={(e) => {
                    if (e.key === "Enter" || e.key === " ") openInspector(dept);
                  }}
                  aria-label={`Inspect department: ${dept.name}`}
                  className="surface-card block w-full bg-bg-surface p-3 text-left cursor-pointer hover:bg-bg-surface/60 transition-colors"
                >
                  <div className="flex items-start justify-between">
                    <div>
                      <p className="text-sm font-medium">{dept.name}</p>
                      <p className="text-xs text-text-muted">HOD: {dept.hodName ?? "—"}</p>
                    </div>
                    <span className="surface-card bg-action-primary/10 px-2 py-0.5 text-xs font-semibold text-action-primary">
                      {dept.attendancePct}%
                    </span>
                  </div>
                  <div className="mt-2 flex items-center justify-between gap-3 text-xs text-text-secondary">
                    <div className="flex gap-3">
                      <span>{dept.students} students</span>
                      <span>{dept.faculty} faculty</span>
                      <span>1:{dept.ratio}</span>
                    </div>
                    <Link
                      href={`/principal/people/departments/${encodeURIComponent(dept.code)}`}
                      onClick={(e) => e.stopPropagation()}
                      className="font-semibold text-action-primary hover:underline"
                    >
                      Open &rarr;
                    </Link>
                  </div>
                </button>
              </li>
            ))}
          </ul>

          <div className="hidden md:block">
            <DataTable<DepartmentItem>
              onRowClick={openInspector}
              columns={[
                { header: "Department", accessor: (r) => r.name },
                { header: "HOD", accessor: (r) => r.hodName ?? "—" },
                { header: "Students", accessor: (r) => r.students },
                { header: "Faculty", accessor: (r) => r.faculty },
                { header: "Ratio", accessor: (r) => `1:${r.ratio}` },
                {
                  header: "Attendance",
                  accessor: (r) => `${r.attendancePct}%`,
                },
                {
                  header: "Page",
                  accessor: (r) => (
                    <Link
                      href={`/principal/people/departments/${encodeURIComponent(r.code)}`}
                      onClick={(e) => e.stopPropagation()}
                      className="text-xs font-semibold text-action-primary hover:underline"
                    >
                      Open &rarr;
                    </Link>
                  ),
                },
              ]}
              data={d?.departments ?? []}
              keyExtractor={(r) => r.code}
              mobileLayout="cards"
            />
          </div>
        </>
      )}

      <EntityInspectorPanel inspection={ourInspection} onClose={closeInspection} />
      <EntityInspector inspection={mainInspection} onClose={() => setMainInspection(null)} />
    </div>
  );
}
</file>

