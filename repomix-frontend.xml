"use client";

import { Suspense, useState } from "react";
import { useSearchParams } from "next/navigation";
import { PageLoading } from "@/components/shared/LoadingStates";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { EmptyState } from "@/components/shared/EmptyState";
import { KanbanBoard } from "@/components/shared/KanbanBoard";
import type { BoardRow } from "@/components/shared/Board";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { scanInspection } from "@/components/shared/inspectionModels";
import { useApiResource } from "@/hooks/useApiResource";
import type { MyClass } from "@/contracts/classes";
import { Loader2, BookOpen, PencilLine } from "lucide-react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageHeader } from "@/components/shared/PageHeader";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { LivePulseStrip } from "@/components/shared/LivePulseStrip";
import { QuickActions } from "@/components/shared/QuickActions";
import { NotificationCenter } from "@/components/shared/NotificationCenter";

import { TaskContinuity } from "@/components/retention/TaskContinuity";
import { UnifiedCampusCalendar } from "@/components/retention/UnifiedCampusCalendar";
import { RoleAnalytics } from "@/components/retention/RoleAnalytics";

/* my-classes response shape */
interface MyClassesResponse {
  success: boolean;
  data: MyClass[];
}

/**
 * Faculty console root (class-teacher scope).
 *
 * Resolves the caller's class scope from GET /api/faculty/my-classes?role=class_teacher:
 *   - 0 rows → EmptyState "Not assigned as class teacher"
 *   - 1 row  → no picker, hardcode that class as the scope
 *   - >1 rows → scope picker (year × section chips) persisted in ?class_id=
 *
 * When a class is resolved, the main column shows the KanbanBoard of the
 * HOD-stage permission queue for that class. All KPI cards / charts /
 * section quick-links are removed to keep the console lean.
 */
function FacultyInner() {
  const searchParams = useSearchParams();
  const selectedClassId = searchParams.get("class_id");

  const {
    data: myClasses,
    loading,
    error,
  } = useApiResource<MyClassesResponse>("/api/faculty/my-classes?role=class_teacher", {
    ttlMs: 30_000,
  });

  const classes = myClasses?.data ?? [];
  const [active, setActive] = useState<BoardRow | null>(null);

  if (error) {
    return (
      <div className="p-6 text-sm text-action-danger">
        Failed to load class scope: {error}
      </div>
    );
  }

  if (loading && classes.length === 0) {
    return (
      <div className="flex items-center gap-2 p-6 text-sm text-text-muted">
        <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none" />
        Resolving your class&hellip;
      </div>
    );
  }

  if (classes.length === 0) {
    return (
      <div className="p-4 sm:p-6 space-y-4 max-w-3xl mx-auto">
        <ContextSituationBar
          roleLabel="Faculty · Class Teacher"
          purpose="Monitor assigned class permissions, attendance status, and student academic routing."
          why="Assigning a class section enables you to review student leaves and monitor daily cohort attendance."
          contextLabel="Faculty Workspace"
          statusTone="warn"
          statusPill="Unassigned"
          statusSummary="You are not assigned as a class teacher yet. Ask your Head of Department (HOD) to assign a class, or open your permissions and subject teaching views."
          primaryAction={{ label: "View Permissions", href: "/faculty/permissions" }}
          secondaryActions={[
            { label: "Subject Teaching", href: "/faculty/subject" },
            { label: "Directory", href: "/faculty/student-directory" },
          ]}
        />
      <LivePulseStrip items={[{ id: "classes", label: "My Classes", valueLabel: "Live", tone: "ok", benchmark: "Manage class attendance & messages" }, { id: "requests", label: "Student Passes", valueLabel: "Active", tone: "info", benchmark: "Review mentor/class-level requests" }]} />
        <EmptyState
          title="Not assigned as class teacher"
          description="You have no class assigned. Ask your Head of Department (HOD) to assign you to a class."
        />
      </div>
    );
  }

  // Resolve the active class: explicit ?class_id= wins, else the single class.
  const activeClass =
    classes.find((c) => c.id === selectedClassId) ??
    (classes.length === 1 ? classes[0] : null);

  // Kanban board of the HOD-stage permission queue scoped to this class.
  const boardSource = activeClass
    ? `/api/permissions?status=PENDING&stage=hod&class_id=${activeClass.id}`
    : "/api/permissions?status=PENDING&stage=hod";

  return (
    <div className="space-y-4 p-2 min-w-0">
      <PageHeader title="Faculty" subtitle="Class scope & HOD-stage queue" />
      <ContextSituationBar
        roleLabel="Faculty · Class Teacher"
        purpose="Monitor assigned class permissions, attendance status, and student academic routing."
        why="Class teacher approval is the primary filter for student gate leaves, event passes, and attendance tracking."
        contextLabel={activeClass ? `Year ${activeClass.year} · ${activeClass.section}` : "All Assigned Classes"}
        statusTone="info"
        statusSummary={
          activeClass
            ? `Viewing active class queue for Year ${activeClass.year} ${activeClass.section}. Review pending items or switch view.`
            : "Select a class to filter your student permissions and class queue."
        }
        primaryAction={{ label: "View Permissions", href: "/faculty/permissions" }}
        secondaryActions={[
          { label: "My Classes", href: "/faculty/my-classes" },
          { label: "Attendance", href: activeClass ? `/faculty/attendance/${activeClass.id}` : "/faculty/my-classes" },
        ]}
      />
      {classes.length > 1 ? (
        /* Scope picker: year × section chips, persisted in URL */
        <div className="surface-card bg-bg-surface p-3 min-w-0">
          <p className="text-xs font-bold uppercase tracking-wider text-text-muted mb-2 flex items-center gap-1.5">
            <PencilLine className="w-3.5 h-3.5" /> Your classes
          </p>
          <div className="flex flex-wrap gap-1.5 min-w-0">
            {classes.map((c) => {
              const isActive = activeClass?.id === c.id;
return (
                <a
                  key={c.id}
                  href={`/faculty?class_id=${c.id}`}
                  className={`px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors ${
                    isActive
                      ? "bg-action-primary/15 text-action-primary border border-action-primary/30"
                      : "bg-bg-elevated text-text-secondary hover:bg-bg-base"
                  }`}
                >
                  Year {c.year} &middot; {c.section}
                  {c.name ? ` · ${c.name}` : ""}
                </a>
              );
            })}
          </div>
        </div>
      ) : activeClass ? (
        /* Single resolved class banner */
        <div className="surface-card bg-bg-surface p-3 min-w-0">
          <p className="text-xs font-bold uppercase tracking-wider text-text-muted flex items-center gap-1.5">
            <BookOpen className="w-3.5 h-3.5" /> Your class
          </p>
          <p className="text-sm font-semibold text-text-primary mt-1">
            Year {activeClass.year} &middot; {activeClass.section}
            {activeClass.name ? ` · ${activeClass.name}` : ""}
          </p>
        </div>
      ) : null}

      {/* Kanban board of the HOD-stage permission queue for the resolved class */}
      <KanbanBoard
        source={boardSource}
        itemKey="permission"
        columns={["PENDING", "APPROVED", "REJECTED"]}
        onSelect={(row) => setActive(row)}
      />
          <EntityInspector
            inspection={active ? scanInspection(active) : null}
            onClose={() => setActive(null)}
          />
      <WidgetBoundary name="TaskContinuity" title="Task Continuity">
        <TaskContinuity />
      </WidgetBoundary>
      <WidgetBoundary name="UnifiedCampusCalendar" title="Unified Campus Calendar">
        <UnifiedCampusCalendar />
      </WidgetBoundary>
      <WidgetBoundary name="RoleAnalytics" title="Role Analytics">
        <RoleAnalytics />
      </WidgetBoundary>
      <WidgetBoundary name="QuickActions" title="Quick Actions">
        <QuickActions />
      </WidgetBoundary>
      <WidgetBoundary name="NotificationCenter" title="Notification Center">
        <NotificationCenter />
      </WidgetBoundary>

    </div>
  );
}

export default function FacultyPage() {
  return (
    <AuthGuard allowedRoles={["faculty", "hod", "admin", "sysadmin"]}>
      <Suspense fallback={<PageLoading />}>
        <FacultyInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

