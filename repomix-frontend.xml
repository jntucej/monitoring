<file path="src/components/bot/BotMessages.tsx">
"use client";
import { memo, useEffect, useRef, useState } from "react";
import { Sparkles, ArrowDown } from "lucide-react";
import { useBotStore, type BotMsg } from "./store";
import { BotBubble } from "./BotBubble";
import { BotWelcome } from "./BotWelcome";
import { roleWelcome } from "./role-welcome";
import type { Role } from "@/lib/types";
import type { BotStrings } from "@/lib/i18n/bot-strings";

interface Props {
  t: BotStrings;
  onFeedback: (id: string, f: -1 | 1) => void;
  onRetry: (text: string) => void;
  onChip: (prompt: string) => void;
  interim: string;
  listening: boolean;
  /** The authenticated user's role — drives the role-specific welcome
      subtitle + suggestion chips (see role-welcome.ts). */
  role?: Role | null;
  /** Called when the user scrolls to the top and older pages exist. */
  onScrollToTop?: () => void;
  /** While a "load older" request is in flight — shows a spinner at the top. */
  loadingOlder?: boolean;
}

function useStickToBottom(deps: unknown[], ref: React.RefObject<HTMLDivElement | null>) {
  const [pinned, setPinned] = useState(true);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const onScroll = () => {
      const dist = el.scrollHeight - el.scrollTop - el.clientHeight;
      setPinned(dist < 60);
    };
    el.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    return () => el.removeEventListener("scroll", onScroll);
  }, [ref]);

  useEffect(() => {
    const el = ref.current;
    if (!el || !pinned) return;
    el.scrollTo({ top: el.scrollHeight, behavior: "smooth" });
  }, [deps, pinned, ref]);

  const scrollToBottom = () => {
    const el = ref.current;
    if (!el) return;
    el.scrollTo({ top: el.scrollHeight, behavior: "smooth" });
  };

  return { ref, pinned, scrollToBottom };
}

export const BotMessages = memo(function BotMessages({
  t, onFeedback, onRetry, onChip, interim, listening, role, onScrollToTop, loadingOlder,
}: Props) {
  const messages = useBotStore((s) => s.messages);
  const streaming = useBotStore((s) => s.streaming);
  const lastLen = messages.length;
  const lastContent = messages[messages.length - 1]?.content ?? "";
  const scrollRef = useRef<HTMLDivElement>(null);
  const { pinned, scrollToBottom } = useStickToBottom([lastLen, lastContent, interim], scrollRef);

  const prevUserQuestion = (idx: number): string => {
    for (let i = idx - 1; i >= 0; i--) {
      if (messages[i].role === "user") return messages[i].content;
    }
    return "";
  };

  // Prepend-older-pages: when the user reaches the top and older history
  // still exists, fetch the previous page and re-anchor scroll so the view
  // doesn't jump to the bottom.
  const anchorEl = useRef<HTMLElement | null>(null);
  const handleScroll = (e: React.UIEvent<HTMLDivElement>) => {
    const el = e.currentTarget;
    if (el.scrollTop < 40 && onScrollToTop && !loadingOlder) {
      // Capture the current first visible message so we can restore
      // relative position after the older page is prepended.
      const first = el.querySelector("[data-msg-id]") as HTMLElement | null;
      anchorEl.current = first;
      onScrollToTop();
    }
  };
  // After a prepend completes, the store's messages array grows — restore
  // scroll position anchored to the previously-first message.
  const [prevLen, setPrevLen] = useState(lastLen);
  useEffect(() => {
    if (lastLen > prevLen && anchorEl.current) {
      const el = scrollRef.current;
      if (!el) return;
      const id = anchorEl.current.getAttribute("data-msg-id");
      const prevEl = id ? document.getElementById(id) : null;
      const prevTop = prevEl ? prevEl.offsetTop : 0;
      requestAnimationFrame(() => {
        el.scrollTop = prevTop - 10;
      });
      anchorEl.current = null;
    }
    setPrevLen(lastLen);
  }, [lastLen, prevLen]);

  return (
    <div className="relative flex-1 min-h-0">
      <div
        ref={scrollRef}
        onScroll={handleScroll}
        role="log"
        aria-live="polite"
        aria-relevant="additions"
        className="h-full overflow-y-auto overscroll-contain px-3 py-3 space-y-3
                   [scrollbar-width:thin] custom-scrollbar"
      >
        {loadingOlder && (
          <div className="flex justify-center py-1" role="status" aria-live="polite">
            <span className="h-3.5 w-3.5 rounded-full border-2 bordertext-muted border-t-transparent animate-spin" />
          </div>
        )}
        {messages.length === 0 && (
          <BotWelcome t={t} onChip={onChip} disabled={streaming} welcome={roleWelcome(role ?? null)} />
        )}

        {messages.map((m, i) => {
          const withRetry: BotMsg = m.status === "error"
            ? { ...m, __retryOf: prevUserQuestion(i) } as BotMsg
            : m;
          return (
            <BotBubble
              key={m.id}
              m={withRetry}
              onFeedback={onFeedback}
              onRetry={onRetry}
              thanksLabel={t.feedbackThanks}
              retryLabel={t.retry}
            />
          );
        })}

        {listening && (
          <div className="flex justify-end">
            <div className="surface-card max-w-[88%] px-3.5 py-2.5 text-sm bg-emerald-500/15 text-text-primary italic">
              {interim || t.listening}
              <span className="ml-1 animate-pulse">▍</span>
            </div>
          </div>
        )}

        {streaming && messages[messages.length - 1]?.content === "" && (
          <div className="flex items-center gap-1.5 text-xs text-text-muted px-1">
            <Sparkles className="size-3.5 animate-pulse" /> {t.thinking}
          </div>
        )}
      </div>

      {!pinned && messages.length > 0 && (
        <button
          onClick={scrollToBottom}
          aria-label="Scroll to latest"
          className="absolute bottom-3 right-3 size-6 rounded-full
                     bg-bg-elevated border border-border
                     flex items-center justify-center shadow-lg active:scale-95 transition"
        >
          <ArrowDown className="h-4 w-4 text-text-secondary" />
        </button>
      )}
    </div>
  );
});
</file>

<file path="src/components/bot/BotPanel.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { motion } from "framer-motion";
import { useBotStore } from "./store";
import { useBotChat } from "./useBotChat";
import { subscribeBot } from "./crossTab";
import { useSpeechRecognition } from "@/hooks/useSpeechRecognition";
import { useSpeechSynthesis } from "@/hooks/useSpeechSynthesis";
import { useIsMobile } from "@/hooks/useMediaQuery";
import { useVisualViewport } from "@/hooks/useVisualViewport";
import { BOT_STRINGS } from "@/lib/i18n/bot-strings";
import { playAudioFeedback } from "@/lib/sound";
import { useApi } from "@/hooks/useApi";
import { useAuthStore } from "@/stores/authStore";
import { BotHeader } from "./BotHeader";
import { BotMessages } from "./BotMessages";
import { BotComposer } from "./BotComposer";

import dynamic from "next/dynamic";

// The listening-visualisation canvas bundles three + @react-three/fiber
// (heavy WebGL). It must not block the initial render of every page, so
// load it only when the user actually opens the bot panel.
const ListeningParticles = dynamic(() => import("./ListeningParticles").then((m) => m.ListeningParticles), {
  ssr: false,
});

export function BotPanel() {
  const api = useApi();
  const isMobile = useIsMobile();
  const vv = useVisualViewport();
  const inputRef = useRef<HTMLTextAreaElement>(null);
  const lastSpokenRef = useRef<string | null>(null);
  const lastUserQuestionRef = useRef("");


  const open = useBotStore((s) => s.open);
  const setOpen = useBotStore((s) => s.setOpen);
  const lang = useBotStore((s) => s.lang);
  const setLang = useBotStore((s) => s.setLang);
  const voiceReplies = useBotStore((s) => s.voiceReplies);
  const setVoiceReplies = useBotStore((s) => s.setVoiceReplies);
  const voiceMode = useBotStore((s) => s.voiceMode);
  const clearVoiceMode = useBotStore((s) => s.clearVoiceMode);
  const voicePrompt = useBotStore((s) => s.voicePrompt);
  const setVoicePrompt = useBotStore((s) => s.setVoicePrompt);
  const voiceModeConfirmed = useBotStore((s) => s.voiceModeConfirmed);
  const setVoiceModeConfirmed = useBotStore((s) => s.setVoiceModeConfirmed);
  const langPromptPending = useBotStore((s) => s.langPromptPending);
  const setLangPromptPending = useBotStore((s) => s.setLangPromptPending);
  const userRole = useAuthStore((s) => s.role);
  const requestVoiceMode = useBotStore((s) => s.requestVoiceMode);
  const messages = useBotStore((s) => s.messages);
  const streaming = useBotStore((s) => s.streaming);
  const error = useBotStore((s) => s.error);

  const t = BOT_STRINGS[lang];
  const { send, cancel, setFeedback, resetChat } = useBotChat();
  const tts = useSpeechSynthesis(lang);
  const [input, setInput] = useState("");

  // Cross-tab sync: mirror state mutations from other tabs so two open
  // panels on the same origin stay consistent (send / done / feedback / reset).
  useEffect(() => {
    return subscribeBot((evt) => {
      const s = useBotStore.getState();
      switch (evt.type) {
        case "reset":
          s.reset();
          break;
        case "send":
          s.appendUser(evt.content);
          break;
        case "done":
          if (evt.content !== undefined) {
            // Late-opening tab: it never saw the token stream, so insert
            // the complete assistant message directly (not just the status
            // flip, which would be a no-op against an unknown draft id).
            s.upsertAssistantMessage(evt.messageId, evt.content, evt.citations ?? []);
          } else {
            s.setDraftStatus(evt.messageId, "done");
          }
          break;
        case "feedback":
          s.setFeedback(evt.messageId, evt.v);
          break;
      }
    });
  }, []);

  const stt = useSpeechRecognition({
    lang,
    onPartial: () => {},
    onFinal: (text) => {
      const trimmed = text.trim();
      if (!trimmed) return;
      playAudioFeedback("success");
      lastUserQuestionRef.current = trimmed;
      void send(trimmed, "auto", (full) => {
        if (voiceReplies) tts.speak(full);
      });
      clearVoiceMode();
    },
  });

  // Auto-start listening when long-press voice mode fires
  useEffect(() => {
    if (voiceMode && open && !stt.listening && stt.supported) {
      stt.start();
      playAudioFeedback("warning");
    }
  }, [voiceMode, open, stt.listening, stt.supported, stt.start]);

  // Auto-speak assistant responses when voiceReplies is on
  const lastAssistant = [...messages].reverse().find(
    (m) => m.role === "assistant" && m.status === "done"
  );
  useEffect(() => {
    if (!voiceReplies || !lastAssistant || tts.speaking) return;
    if (lastSpokenRef.current === lastAssistant.id) return;
    lastSpokenRef.current = lastAssistant.id;
    if (lastAssistant.content.trim()) {
      tts.speak(lastAssistant.content);
    }
  }, [voiceReplies, lastAssistant, tts.speaking, tts.speak]);

  // Stop TTS if user speaks
  useEffect(() => {
    if (stt.listening && tts.speaking) tts.stop();
  }, [stt.listening, tts]);

  // Auto-focus the composer on open (desktop); on close, return focus to
  // the launcher button so keyboard/screen-reader users are never stranded
  // in the detached panel.
  useEffect(() => {
    if (open && !isMobile && !voiceMode) {
      const t = setTimeout(() => inputRef.current?.focus(), 220);
      return () => clearTimeout(t);
    }
    if (!open) {
      // Give the exit animation a beat before stealing focus back.
      const t = setTimeout(() => {
        document.getElementById("bot-launcher-btn")?.focus();
      }, 260);
      return () => clearTimeout(t);
    }
  }, [open, isMobile, voiceMode]);

  // Cmd/Ctrl+J opens the panel (design doc: J, not K — K is the command
  // palette). Esc already closes (effect above).
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "j") {
        e.preventDefault();
        useBotStore.getState().toggleOpen();
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, []);

  // Escape key closes and clears speech
  useEffect(() => {
    if (!open) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        e.stopPropagation();
        if (stt.listening) stt.stop();
        clearVoiceMode();
        setOpen(false);
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open, stt.listening, stt.stop, clearVoiceMode, setOpen]);

  // Persist language and voice settings
  useEffect(() => {
    const user = useAuthStore.getState().user;
    if (!user) return;
    fetch("/api/profile", {
      method: "PATCH",
      headers: { "content-type": "application/json", ...api.getHeaders() },
      body: JSON.stringify({ bot_lang: lang, bot_voice_replies: voiceReplies }),
    }).catch(() => {});
  }, [lang, voiceReplies, api]);

  const handleSend = () => {
    if (voiceMode) clearVoiceMode();
    const text = input.trim();
    if (!text) return;
    playAudioFeedback("success");
    lastUserQuestionRef.current = text;
    void send(text, "auto", (full) => { if (voiceReplies) tts.speak(full); });
    setInput("");
  };

  // Quick-chip / suggestion behavior: SEND IMMEDIATELY (single-tap), not
  // prefill. The prompt is submitted straight to send() — the user's
  // question appears in the thread and the answer streams in, so a tap is
  // one round-trip, not two. Documenting this so it's a conscious choice
  // (prefill + edit would feel faster for power users, but the welcome
  // screen's job is "one tap to an answer," which is the right default for
  // a first-open assistant surface).
  const handleChip = (prompt: string) => {
    if (voiceMode) clearVoiceMode();
    playAudioFeedback("success");
    lastUserQuestionRef.current = prompt;
    void send(prompt, "auto", (full) => { if (voiceReplies) tts.speak(full); });
  };

  const handleRetry = (text: string) => {
    if (voiceMode) clearVoiceMode();
    const q = text || lastUserQuestionRef.current;
    if (!q) return;
    void send(q, "auto", (full) => { if (voiceReplies) tts.speak(full); });
  };

  const handleToggleMic = () => {
    if (stt.listening) {
      stt.stop();
      clearVoiceMode();
    } else {
      if (!stt.supported) return;
      playAudioFeedback("warning");
      tts.stop();
      stt.start();
    }
  };

  const handleToggleVoiceReplies = () => {
    if (!tts.supported) return;
    const next = !voiceReplies;
    setVoiceReplies(next);
    if (!next) tts.stop();
  };

  // Reconcile server-side state on every open:
  //  1. hydrate lang / voiceReplies from the caller's profile (the store's
  //     localStorage cache is only the fast-path render; the server is the
  //     source of truth, so a shared browser / fresh tab still gets the
  //     user's saved settings).
  //  2. load the current conversation so a hard refresh does not wipe the
  //     chat history — the bot "remembers" across refreshes and tabs.
  //  3. if a stream was still in flight when the panel last closed, mark
  //     the draft errored and clear the stuck streaming flag.
  const hydratedRef = useRef(false);
  useEffect(() => {
    if (!open || hydratedRef.current) return;
    hydratedRef.current = true;
    let cancelled = false;
    const user = useAuthStore.getState().user;
    const token = useAuthStore.getState().token;
    const headers: Record<string, string> = { "content-type": "application/json" };
    if (token) headers.Authorization = `Bearer ${token}`;
    if (user) {
      fetch("/api/profile", { headers, cache: "no-store" })
        .then((r) => r.ok ? r.json() : null)
        .then((j) => {
          if (cancelled || !j?.success) return;
          const s = useBotStore.getState();
          if (j.data?.botLang === "en" || j.data?.botLang === "te") s.setLang(j.data.botLang);
          if (typeof j.data?.botVoiceReplies === "boolean") s.setVoiceReplies(j.data.botVoiceReplies);
          // First-open language prompt: only shown once, per user (the
          // server column bot_lang_prompted_at is the source of truth).
          s.setLangPromptPending(!j.data?.botLangPromptedAt);
        })
        .catch(() => {});
    }
    fetch("/api/bot/session/current", { headers, cache: "no-store" })
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => {
        if (cancelled || !j?.success || !Array.isArray(j.data?.messages)) return;
        const s = useBotStore.getState();
        s.setMessages(j.data.messages);
        s.setConversationId(j.data.conversationId ?? null);
        // Remember the pagination cursor so "load older" (scroll-up) can
        // fetch the next page of history on demand.
        oldestIdRef.current = j.data.oldestId ?? null;
        hasMoreRef.current = !!j.data.hasMore;
      })
      .catch(() => {});
    const st = useBotStore.getState();
    if (st.streaming) {
      st.messages
        .filter((m) => m.status === "streaming")
        .forEach((m) => st.setDraftStatus(m.id, "error"));
      st.setStreaming(false);
    }
    return () => { cancelled = true; };
  }, [open]);

  // "Load older" — the panel opens with the newest 50 messages (the server
  // default); scrolling to the top fetches the previous page (newest-first
  // `before` cursor) and prepends it. Capped at 3 pages to keep the panel
  // light; older history is still reachable via the API if needed.
  const oldestIdRef = useRef<string | null>(null);
  const hasMoreRef = useRef(false);
  const loadingOlderRef = useRef(false);
  const [loadingOlder, setLoadingOlder] = useState(false);
  const loadOlder = useCallback(async () => {
    if (loadingOlderRef.current || !hasMoreRef.current || !oldestIdRef.current) return;
    loadingOlderRef.current = true;
    setLoadingOlder(true);
    try {
      const token = useAuthStore.getState().token;
      const headers: Record<string, string> = { "content-type": "application/json" };
      if (token) headers.Authorization = `Bearer ${token}`;
      const res = await fetch(
        `/api/bot/session/current?limit=50&before=${encodeURIComponent(oldestIdRef.current)}`,
        { headers, cache: "no-store" },
      );
      const j = res.ok ? await res.json() : null;
      if (!j?.success || !Array.isArray(j.data?.messages) || j.data.messages.length === 0) return;
      const s = useBotStore.getState();
      // Prepend: older page (newest-first from the API, reversed by the
      // server to oldest-first) goes in front of the current messages.
      const existing = new Set(s.messages.map((m: { id: string }) => m.id));
      const fresh = j.data.messages.filter((m: { id: string }) => !existing.has(m.id));
      if (fresh.length) s.setMessages([...fresh, ...s.messages].slice(-400));
      oldestIdRef.current = j.data.oldestId ?? null;
      hasMoreRef.current = !!j.data.hasMore;
    } catch {
      /* network failure — silently retry on the next scroll-up */
    } finally {
      loadingOlderRef.current = false;
      setLoadingOlder(false);
    }
  }, []);

  // Persist a one-time language choice (from the first-open prompt) to the
  // server; the profile PUT stamps bot_lang_prompted_at, so the prompt
  // never reappears for this user.
  const persistLangChoice = useCallback(async (l: "en" | "te") => {
    const token = useAuthStore.getState().token;
    const headers: Record<string, string> = { "content-type": "application/json" };
    if (token) headers.Authorization = `Bearer ${token}`;
    await fetch("/api/profile", {
      method: "PUT",
      headers,
      body: JSON.stringify({ bot_lang: l }),
    }).catch(() => {});
  }, []);

  const [confirmPending, setConfirmPending] = useState(false);
  const handleClose = () => {
    if (stt.listening) stt.stop();
    tts.stop();
    clearVoiceMode();
    // Blur the composer first so the iOS keyboard dismisses before the exit
    // animation starts — otherwise the panel jump causes a visible layout
    // shift on mobile.
    inputRef.current?.blur();
    setOpen(false);
  };

  const phase = stt.listening ? "listening"
              : tts.speaking   ? "speaking"
              : streaming      ? "thinking"
              : "idle";

  const keyboardOffset = isMobile ? vv.keyboardOffset : 0;

  const desktopVariants = {
    closed: { opacity: 0, y: 20, scale: 0.96, transition: { duration: 0.18 } },
    open:   { opacity: 1, y: 0,  scale: 1,    transition: { type: "spring" as const, stiffness: 320, damping: 30 } },
  };
  const mobileVariants = {
    closed: { opacity: 0, y: "100%", transition: { duration: 0.22 } },
    open:   { opacity: 1, y: 0,      transition: { type: "spring" as const, stiffness: 300, damping: 34 } },
  };

  const panelStyle: React.CSSProperties = isMobile
    ? {
        height: `calc(100dvh - ${keyboardOffset}px)`,
        bottom: keyboardOffset,
        paddingTop: "env(safe-area-inset-top, 0px)",
        paddingBottom: "env(safe-area-inset-bottom, 0px)",
      }
    : {};

  const variants = isMobile ? mobileVariants : desktopVariants;

  return (
    <motion.div
      key={isMobile ? "mobile" : "desktop"}
      initial="closed"
      animate={open ? "open" : "closed"}
      variants={variants}
      style={panelStyle}
      className={[
        "fixed z-[100] flex flex-col overflow-hidden",
        "bg-bg-elevated/98 backdrop-blur-2xl border border-border shadow-[0_24px_64px_rgba(0,0,0,0.5)]",
        "mb-[env(safe-area-inset-bottom)]",
        isMobile
          ? "inset-x-0 bottom-0 rounded-t-2xl"
          : "right-4 bottom-4 w95 max-w-[calc(100vw-2rem)] h-[min(640px,80vh)] rounded-2xl",
        open ? "" : "pointer-events-none",
      ].join(" ")}
      role="dialog"
      aria-modal="false"
      aria-label={t.title}
      aria-hidden={!open}
    >
      <ListeningParticles active={stt.listening} />

      {isMobile && (
        <div className="pt-2 pb-1 flex justify-center relative z-10" aria-hidden>
          <div className="size-20 rounded-full bgborder" />
        </div>
      )}

      <BotHeader
        t={t}
        lang={lang}
        onLangChange={(l) => { setLang(l); tts.stop(); }}
        phase={phase}
        listening={stt.listening}
        speaking={tts.speaking}
        streaming={streaming}
        hasMessages={messages.length > 0}
        voiceReplies={voiceReplies}
        ttsSupported={tts.supported}
        onToggleVoiceReplies={handleToggleVoiceReplies}
        onNewChat={() => {
          // Two-tap destructive action: first tap surfaces a visible
          // confirm row, second tap (within 4s) actually clears.
          const st = useBotStore.getState();
          if (st.messages.length === 0) return;
          if (!confirmPending) {
            setConfirmPending(true);
            window.setTimeout(() => setConfirmPending(false), 4000);
            return;
          }
          setConfirmPending(false);
          resetChat();
          tts.stop();
        }}
        onClose={handleClose}
      />

      {(error || stt.error === "permission") && (
        <div className="surface-card relative z-10 px-3 py-2 text-xs bg-rose-500/10 text-action-danger">
          {stt.error === "permission"
            ? "Microphone permission denied. Enable it in your browser settings to use voice."
            : error?.startsWith("HTTP 401")
              ? "Session expired. Please sign in again."
              : /RAG_UNAVAILABLE/.test(error ?? "")
                ? t.errorRagUnavailable
                : /RATE_LIMITED|HTTP 429/.test(error ?? "")
                  ? t.errorRateLimit
                  : error?.startsWith("HTTP")
                    ? t.errorNetwork
                    : t.errorGeneric}
        </div>
      )}

      {!stt.supported && isMobile && (
        <div className="surface-card relative z-10 px-3 py-1.5 text-xs text-text-muted bg-bg-elevated">
          {t.micUnsupported}
        </div>
      )}

      {voicePrompt && !voiceModeConfirmed && (
        <div
          role="status"
          aria-live="polite"
          className="surface-card relative z-10 mx-3 mb-1 bg-bg-elevated px-3 py-2 text-xs text-text-secondary"
        >
          <div className="flex items-center justify-between gap-2">
            <span>Voice mode uses your microphone. Enable it?</span>
            <div className="flex items-center gap-2">
              <button
                onClick={() => {
                  requestVoiceMode();
                  setVoiceModeConfirmed(true);
                  setVoicePrompt(false);
                }}
                className="text-action-success hover:underline underline-offset-2"
              >
                Enable
              </button>
              <button
                onClick={() => {
                  setVoiceModeConfirmed(true); // remember: don't ask again
                  setVoicePrompt(false);
                }}
                className="text-text-muted hover:text-text-primary"
                aria-label="Not now"
              >
                Not now
              </button>
            </div>
          </div>
        </div>
      )}

      {langPromptPending && messages.length === 0 && (
        <div
          role="group"
          aria-label="Choose your language"
          className="surface-card relative z-10 mx-3 my-2 bg-bg-elevated p-3"
        >
          <p className="text-xs font-medium text-text-primary mb-2">
            Choose your language
          </p>
          <div className="grid grid-cols-2 gap-2">
            <button
              onClick={() => {
                setLang("en");
                setLangPromptPending(false);
                // Persist the choice (and mark the prompt as shown) via the
                // profile PUT — one call covers both.
                void persistLangChoice("en");
              }}
              className="surface-card px-3 py-2 text-xs hover:bg-bg-base transition active:scale-[0.98]"
            >
              English
            </button>
            <button
              onClick={() => {
                setLang("te");
                setLangPromptPending(false);
                void persistLangChoice("te");
              }}
              className="surface-card px-3 py-2 text-xs hover:bg-bg-base transition active:scale-[0.98]"
            >
              తెలుగు
            </button>
          </div>
          <p className="text-xs text-text-muted mt-2">
            You can change this anytime from the language icon above.
          </p>
        </div>
      )}

      {confirmPending && (
        <div
          role="alert"
          aria-live="assertive"
          className="surface-card relative z-10 mx-3 my-1.5 flex items-center justify-between gap-2 bg-amber-500/10 px-3 py-2 text-xs text-action-warning"
        >
          <span>Start a new chat? Your current history will be cleared.</span>
          <div className="flex items-center gap-2 shrink-0">
            <button
              onClick={() => {
                setConfirmPending(false);
                resetChat();
                tts.stop();
              }}
              className="text-action-warning hover:underline underline-offset-2"
            >
              Clear
            </button>
            <button
              onClick={() => setConfirmPending(false)}
              className="text-text-muted hover:text-text-primary"
            >
              Cancel
            </button>
          </div>
        </div>
      )}

      <BotMessages
        t={t}
        onFeedback={setFeedback}
        onRetry={handleRetry}
        onChip={handleChip}
        interim={stt.interim}
        listening={stt.listening}
        role={userRole}
        onScrollToTop={loadOlder}
        loadingOlder={loadingOlder}
      />

      <BotComposer
        ref={inputRef}
        t={t}
        value={input}
        onChange={setInput}
        onSend={handleSend}
        onStop={cancel}
        listening={stt.listening}
        streaming={streaming}
        micSupported={stt.supported}
        onToggleMic={handleToggleMic}
        micRemainingSeconds={stt.remainingSeconds}
      />
    </motion.div>
  );
}
</file>

<file path="src/components/bot/BotWelcome.tsx">
"use client";
import { memo } from "react";
import { motion } from "framer-motion";
import { BotBoat } from "./BotBoat";
import type { BotStrings } from "@/lib/i18n/bot-strings";
import type { RoleWelcome } from "./role-welcome";

export const BotWelcome = memo(function BotWelcome({
  t, onChip, disabled, welcome,
}: {
  t: BotStrings;
  onChip: (prompt: string) => void;
  disabled?: boolean;
  /** Role-specific subtitle + examples (see role-welcome.ts). Falls back
      to the generic strings when omitted. */
  welcome?: RoleWelcome;
}) {
  const chips = welcome?.chips ?? [];
  const questions = welcome?.questions ?? t.suggestions;

  return (
    <motion.div
      initial={{ opacity: 0, y: 8 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.25 }}
      className="pt-1"
    >
      {/* Welcome card: boat silhouette + institutional title. No emoji,
          no slogan — the "quiet library desk attendant" tone. */}
      <div className="flex flex-col items-center gap-1.5 mb-4">
        <div className="h-11 w-11 rounded-xl bg-bg-elevated border border-border
                        flex items-center justify-center">
          <BotBoat size={24} />
        </div>
        <p className="text-sm font-semibold text-text-primary">{t.title}</p>
        {welcome && (
          <p className="text-xs text-text-muted">{welcome.subtitle}</p>
        )}
      </div>

      <p className="text-xs text-text-muted mb-2 text-center">{t.tryAsking}</p>

      {chips.length > 0 && (
        <div className="flex flex-wrap gap-1.5 justify-center mb-3">
          {chips.map((label, i) => (
            <motion.button
              key={label}
              initial={{ opacity: 0, y: 4 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: i * 0.04 }}
              disabled={disabled}
              onClick={() => onChip(label)}
              className="surface-card text-xs px-2.5 py-1 hover:bg-bg-elevated active:scale-95 transition disabled:opacity-50 text-text-secondary"
            >
              {label}
            </motion.button>
          ))}
        </div>
      )}

      <div className="grid gap-2">
        {questions.map((s, i) => (
          <motion.button
            key={s}
            initial={{ opacity: 0, y: 4 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.1 + i * 0.04 }}
            disabled={disabled}
            onClick={() => onChip(s)}
            className="surface-card text-left text-xs px-3 py-2 hover:bg-bg-elevated active:scale-[0.99] transition disabled:opacity-50 text-text-secondary"
          >
            {s}
          </motion.button>
        ))}
      </div>
    </motion.div>
  );
});
</file>

<file path="src/components/bot/CitationChip.tsx">
// src/components/bot/CitationChip.tsx
//
// A single source chip rendered under an assistant message. Tapping the
// chip opens a small popover with the source document's title/source
// label and the actual passage it was quoted from (the `excerpt` the
// retriever carries). Max 3 chips shown; a "+N more" toggle reveals
// the rest.
//
// Why a chip, not plain text: a citation you can open and read the
// source behind it is what makes a RAG answer *trustable* — the user
// can verify "yes, that's what §4.2 actually says" instead of taking
// the LLM's paraphrase on faith.

import { memo, useState } from "react";
import { AnimatePresence, motion } from "framer-motion";
import { FileText, X } from "lucide-react";
import type { Citation } from "./store";

export const CitationChip = memo(function CitationChip({
  cites,
}: {
  cites: Citation[];
}) {
  const [openId, setOpenId] = useState<string | null>(null);
  const [showAll, setShowAll] = useState(false);

  const visible = showAll ? cites : cites.slice(0, 3);
  const hidden = cites.length - visible.length;
  const open = openId ? cites.find((c) => c.id === openId) : null;

  if (!cites.length) return null;

  return (
    <div className="mt-2 flex flex-wrap gap-1.5" role="group" aria-label="Sources">
      {visible.map((c) => (
        <button
          key={c.id}
          onClick={() => setOpenId(openId === c.id ? null : c.id)}
          aria-expanded={openId === c.id}
          aria-label={`Source: ${c.title}${c.source ? `, ${c.source}` : ""}`}
          className="surface-card inline-flex items-center gap-1 bg-bg-base px-2.5 py-1 text-xs font-medium text-text-secondary hover:text-action-success hover: transition active:scale-[0.98]"
        >
          <FileText className="size-3.5 text-action-success" aria-hidden />
          <span className="font-mono text-xs text-action-success">[{c.n}]</span>
          <span className="max-w-40 truncate">{c.title}</span>
        </button>
      ))}
      {hidden > 0 && (
        <button
          onClick={() => setShowAll(true)}
          className="surface-card inline-flex items-center px-2.5 py-1 text-xs text-text-muted hover:text-text-primary transition"
        >
          +{hidden} more
        </button>
      )}

      <AnimatePresence>
        {open && (
          <motion.div
            initial={{ opacity: 0, y: 4 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: 4 }}
            transition={{ duration: 0.15 }}
            role="dialog"
            aria-label={`Source: ${open.title}`}
            className="surface-card relative w-full max-w-md bg-bg-elevated p-3 text-left"
          >
            <div className="flex items-start justify-between gap-2 mb-1.5">
              <div className="min-w-0">
                <p className="text-xs font-semibold text-text-primary">
                  <span className="font-mono text-action-success">[{open.n}]</span> {open.title}
                </p>
                {open.source && (
                  <p className="text-xs text-text-muted mt-0.5">{open.source}</p>
                )}
              </div>
              <button
                onClick={() => setOpenId(null)}
                aria-label="Close source"
                className="surface-card shrink-0 p-0.5 text-text-muted hover:text-text-primary transition"
              >
                <X className="h-3.5 w-3.5" />
              </button>
            </div>
            {open.excerpt && (
              <blockquote className="surface-card text-xs leading-relaxed text-text-secondary pl-2 italic">
                {open.excerpt}
              </blockquote>
            )}
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
});
</file>

<file path="src/components/bot/FloatingBot.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { AnimatePresence } from "framer-motion";
import { usePathname } from "next/navigation";
import dynamic from "next/dynamic";
import { useBotStore } from "./store";
import { BotBoat } from "./BotBoat";
import { useAuthStore } from "@/stores/authStore";
import { playAudioFeedback } from "@/lib/sound";
import { isDashboardRoot } from "./dashboard-root";

const LONG_PRESS_MS = 420;

// The chat panel is the trigger UI's heavy dependency. It transitively pulls in
// the 3D particles (three + @react-three/fiber), speech hooks, and other
// large modules, so it must NOT be part of the first-load bundle. The
// floating button (~2 KB) stays static so it appears immediately; the panel
// + its 3D/speech code download only when the user actually opens it.
const BotPanel = dynamic(() => import("./BotPanel").then((m) => m.BotPanel), {
  ssr: false,
  loading: () => (
    <div className="fixed bottom-24 right-6 h130 w95 rounded-2xl bg-bg-surface/70 animate-pulse" />
  ),
});

export function FloatingBot() {
  const { open, toggleOpen, requestVoiceMode } = useBotStore();
  const hydrated = useAuthStore((s) => s._hasHydrated);
  const authed = useAuthStore((s) => s.authenticated);
  const [pos, setPos] = useState({ x: -1, y: -1 });
  const [holdProgress, setHoldProgress] = useState(0);
  const dragRef = useRef<{ startX: number; startY: number; originX: number; originY: number; moved: boolean } | null>(null);
  const pressTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
  const rafRef = useRef<number | null>(null);
  const didLongPress = useRef(false);
  const pressStart = useRef(0);

  const clearPress = useCallback(() => {
    if (pressTimer.current) { clearTimeout(pressTimer.current); pressTimer.current = null; }
    if (rafRef.current) { cancelAnimationFrame(rafRef.current); rafRef.current = null; }
    setHoldProgress(0);
  }, []);

  const onPointerDown = (e: React.PointerEvent) => {
    if (open) return;
    (e.target as HTMLElement).setPointerCapture(e.pointerId);
    dragRef.current = {
      startX: e.clientX, startY: e.clientY,
      originX: pos.x >= 0 ? pos.x : window.innerWidth - 96,
      originY: pos.y >= 0 ? pos.y : window.innerHeight - 96,
      moved: false,
    };
    didLongPress.current = false;
    pressStart.current = performance.now();
    // animate hold progress
    const tick = () => {
      const elapsed = performance.now() - pressStart.current;
      setHoldProgress(Math.min(1, elapsed / LONG_PRESS_MS));
      if (elapsed < LONG_PRESS_MS) rafRef.current = requestAnimationFrame(tick);
    };
    rafRef.current = requestAnimationFrame(tick);
    pressTimer.current = setTimeout(() => {
      didLongPress.current = true;
      playAudioFeedback("success");
      // First time: open the panel normally and let it surface a one-time
      // "Voice mode — enable microphone?" confirmation before touching the
      // mic. After that (voiceModeConfirmed), go straight into voice mode.
      const st = useBotStore.getState();
      if (st.voiceModeConfirmed) {
        requestVoiceMode();
      } else {
        st.setOpen(true);
        st.setVoicePrompt(true);
      }
      clearPress();
      dragRef.current = null;
    }, LONG_PRESS_MS);
  };

  const onPointerMove = (e: React.PointerEvent) => {
    const d = dragRef.current;
    if (!d) return;
    const dx = e.clientX - d.startX;
    const dy = e.clientY - d.startY;
    if (Math.hypot(dx, dy) > 8) d.moved = true;
    const nx = Math.max(8, Math.min(window.innerWidth - 80, d.originX + dx));
    const ny = Math.max(8, Math.min(window.innerHeight - 80, d.originY + dy));
    setPos({ x: nx, y: ny });
    if (d.moved) clearPress();      // drag cancels hold
  };

  const onPointerUp = (_e: React.PointerEvent) => {
    const d = dragRef.current;
    dragRef.current = null;
    clearPress();
    if (!d) return;
    if (!didLongPress.current && !d.moved) {
      // short tap -> plain open
      toggleOpen();
    }
  };

  const onPointerCancel = () => { dragRef.current = null; clearPress(); };

  useEffect(() => () => clearPress(), [clearPress]);

  // The bot lives on dashboard pages. If the user navigates off a dashboard
  // root while the panel is open, close it — otherwise returning later makes
  // it pop open unexpectedly (the `open` flag persists across navigation).
  const pathname = usePathname();
  useEffect(() => {
    if (pathname && !isDashboardRoot(pathname) && useBotStore.getState().open) {
      useBotStore.getState().setOpen(false);
    }
  }, [pathname]);

  if (!hydrated || !authed) return null;

  const style = pos.x < 0
    ? { right: 24, bottom: 24 }
    : { left: pos.x, top: pos.y, right: "auto", bottom: "auto" };

  return (
    <>
      {/* Hold-to-speak hint (only when closed and idle) */}
      {!open && (
        <div
          className="fixed z-[79] text-xs uppercase tracking-wider text-text-muted pointer-events-none select-none"
          style={
            pos.x < 0
              ? { right: 30, bottom: 104 }
              : { left: pos.x + 6, top: pos.y - 18 }
          }
        >
          Hold to speak
        </div>
      )}
      <div
        id="bot-launcher"
        className="fixed z-[80] floating-bot-root touch-none"
        style={style}
        onPointerDown={onPointerDown}
        onPointerMove={onPointerMove}
        onPointerUp={onPointerUp}
        onPointerCancel={onPointerCancel}
      >
        <button
          type="button"
          id="bot-launcher-btn"
          aria-label="Hold to speak, tap to open assistant"
          className="relative size-6 rounded-full bg-bg-surface border border-border shadow-[0_8px_24px_rgba(0,0,0,0.35)] flex items-center justify-center active:scale-95 transition-transform"
        >
          {/* Hold-progress ring */}
          <svg
            className="absolute inset-0 -rotate-90 pointer-events-none"
            viewBox="0 0 64 64"
          >
            <circle cx="32" cy="32" r="30" fill="none" stroke="rgba(139,92,246,0.15)" strokeWidth="2" />
            <circle
              cx="32" cy="32" r="30"
              fill="none"
              stroke="rgba(139,92,246,0.95)"
              strokeWidth="2"
              strokeLinecap="round"
              strokeDasharray={2 * Math.PI * 30}
              strokeDashoffset={2 * Math.PI * 30 * (1 - holdProgress)}
              style={{ transition: holdProgress === 0 ? "stroke-dashoffset 180ms ease" : "none" }}
            />
          </svg>
          <BotBoat phase="idle" />
        </button>
      </div>
      <AnimatePresence>{open && <BotPanel />}</AnimatePresence>
    </>
  );
}
</file>

