<file path="src/components/mess/MessMonthlyReviewPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  UtensilsCrossed,
  TrendingUp,
  TrendingDown,
  Minus,
  RefreshCw,
  Star,
  AlertTriangle,
} from "lucide-react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { EmptyState } from "@/components/shared/EmptyState";
import { Skeleton } from "@/components/ui/skeleton";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { usePeriod } from "@/hooks/usePeriod";
import { useExport } from "@/hooks/useExport";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface PerMeal {
  meal: string;
  avg: number;
  count: number;
  complaints: number;
  lastMonthAvg: number | null;
  delta: number | null;
}

interface AggregatePayload {
  data: {
    period: string;
    range: { from: string; to: string };
    perMeal: PerMeal[];
    overall: { avg: number; total: number };
  };
}

const MEAL_LABEL: Record<string, string> = {
  BREAKFAST: "Breakfast",
  LUNCH: "Lunch",
  DINNER: "Dinner",
};

function StarScale({ avg, className }: { avg: number; className?: string }) {
  const rounded = Math.round(avg);
  return (
    <div className={cn("inline-flex gap-0.5", className)}>
      {[1, 2, 3, 4, 5].map((i) => (
        <Star
          key={i}
          className={cn(
            "h-4 w-4",
            i <= rounded ? "fill-action-warning text-action-warning" : "text-text-muted/20"
          )}
        />
      ))}
    </div>
  );
}

function MealRow({ meal }: { meal: PerMeal }) {
  const trendIcon =
    meal.delta == null ? <Minus className="h-3.5 w-3.5 text-text-muted" />
    : meal.delta > 0 ? <TrendingUp className="h-3.5 w-3.5 text-action-success" />
    : meal.delta < 0 ? <TrendingDown className="h-3.5 w-3.5 text-action-danger" />
    : <Minus className="h-3.5 w-3.5 text-text-muted" />;

  return (
    <div className="flex items-center justify-between rounded-xl border border-border bg-bg-elevated px-4 py-3">
      {/* Left: meal name + stars */}
      <div className="flex items-center gap-3 min-w-0">
        <span className="text-sm font-medium text-text-primary w-20 shrink-0">
          {MEAL_LABEL[meal.meal] ?? meal.meal}
        </span>
        <StarScale avg={meal.avg} />
        <span className="text-lg font-bold text-text-primary tabular-nums">
          {meal.avg.toFixed(1)}
        </span>
      </div>

      {/* Right: count, complaints, delta */}
      <div className="flex items-center gap-4 text-xs shrink-0">
        <div className="text-right">
          <p className="text-text-muted">{meal.count} reviews</p>
          {meal.complaints > 0 && (
            <p className="text-action-danger">{meal.complaints} complaints</p>
          )}
        </div>
        <div
          className={cn(
            "flex items-center gap-1 rounded-lg px-2 py-1 font-medium tabular-nums",
            meal.delta == null
              ? "text-text-muted bg-bg-surface"
              : meal.delta > 0
                ? "text-action-success bg-action-success/10"
                : meal.delta < 0
                  ? "text-action-danger bg-action-danger/10"
                  : "text-text-muted bg-bg-surface"
          )}
        >
          {trendIcon}
          {meal.delta == null ? "—" : `${meal.delta > 0 ? "+" : ""}${meal.delta.toFixed(1)}`}
          <span className="text-text-muted font-normal">vs LM</span>
        </div>
      </div>
    </div>
  );
}

// ── Main panel ────────────────────────────────────────────────────────────

export function MessMonthlyReviewPanel() {
  const { period, setPeriod } = usePeriod("this-month");
  const { exportCSV } = useExport();
  const [data, setData] = useState<AggregatePayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/mess/reviews/aggregate?period=${period.key === "all-time" ? "all-time" : period.key}`,
        { headers: getAuthHeaders(), cache: "no-store" }
      );
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) {
        throw new Error(body?.message ?? "Failed to load");
      }
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [period.key]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      data.perMeal.map((m) => ({
        meal: m.meal,
        avg: m.avg,
        reviews: m.count,
        complaints: m.complaints,
        lastMonth: m.lastMonthAvg ?? "n/a",
        delta: m.delta ?? "n/a",
      })),
      [
        { key: "meal", header: "Meal" },
        { key: "avg", header: "Avg Rating" },
        { key: "reviews", header: "Reviews" },
        { key: "complaints", header: "Complaints" },
        { key: "lastMonth", header: "Last Month Avg" },
        { key: "delta", header: "Delta" },
      ],
      `mess_review_${data.period}.csv`
    );
  };

  return (
    <WidgetBoundary name="MessMonthlyReviewPanel" resetKey={period.key}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <div className="p-2 rounded-xl bg-action-warning/10 text-action-warning">
              <UtensilsCrossed className="h-4 w-4" />
            </div>
            <div>
              <h2 className="text-sm font-semibold text-text-primary">Meal Reviews</h2>
              <p className="text-xs text-text-muted">Monthly aggregate & last-month compare</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              disabled={!data}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              Export
            </button>
            <button
              type="button"
              onClick={() => void load()}
              className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-surface"
            >
              <RefreshCw className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        {/* Period picker */}
        <PeriodPicker value={period} onChange={setPeriod} allowCustom={false} />

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <Skeleton className="h-10 rounded-xl" />
            {Array.from({ length: 3 }).map((_, i) => (
              <Skeleton key={i} className="h-14 rounded-xl" />
            ))}
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-action-danger/10 p-4 text-sm text-action-danger">
            <AlertTriangle className="h-4 w-4 inline mr-1" />
            {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">
              Retry
            </button>
          </div>
        )}

        {/* Data */}
        {data && !loading && (
          <>
            {/* Overall scorecard */}
            <div className="flex items-center justify-between rounded-xl border border-border bg-bg-elevated px-5 py-4">
              <div>
                <p className="text-xs font-medium text-text-muted">Overall rating (all time)</p>
                <div className="flex items-center gap-2 mt-1">
                  <span className="text-3xl font-bold text-text-primary tabular-nums">
                    {data.overall.avg.toFixed(1)}
                  </span>
                  <StarScale avg={data.overall.avg} />
                </div>
                <p className="text-xs text-text-muted mt-1">{data.overall.total} total reviews</p>
              </div>
              <div className="text-right">
                <p className="text-xs font-medium text-text-muted">Period</p>
                <p className="text-lg font-semibold text-text-primary">{data.period}</p>
                <p className="text-xs text-text-muted">{data.range.from} → {data.range.to}</p>
              </div>
            </div>

            {/* Per-meal rows */}
            <div className="space-y-2">
              {data.perMeal.map((m) => (
                <MealRow key={m.meal} meal={m} />
              ))}
            </div>

            {/* No data */}
            {data.perMeal.every((m) => m.count === 0) && (
              <EmptyState
                title="No reviews in this period"
                description="Reviews will appear once students submit ratings for meals."
              />
            )}
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default MessMonthlyReviewPanel;
</file>

<file path="src/components/mess/MessOperations.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import {Plus, Pencil, Trash2, Save, X, Loader2, RefreshCw, Ban, Check, AlertTriangle, Leaf, Beef, Lock, Users, Ticket}  from "lucide-react";

import { ConfirmDialog } from "@/components/admin/shared/ConfirmDialog";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import type {
  MessAnalytics,
  MessDay,
  MessMenuItem,
} from "@/lib/types";

/* ── shared helpers + types ── */

export const DAY_TYPES = ["LUNCH", "DINNER", "BREAKFAST", "SPECIAL"] as const;

export interface MenuItemDraft {
  id?: string;
  code: string;
  label: string;
  isPrimary: boolean;
  sortOrder: number;
}

export interface MealDayDraft {
  mealDate: string;
  dayType: string;
  windowOpens: string;
  windowCloses: string;
  items: string[];
}

export function timeToIso(dateIso: string, timeStr: string): string {
  if (!dateIso) return "";
  try {
    const d = new Date(`${dateIso}T${timeStr || "00:00"}`);
    return d.toISOString();
  } catch {
    return "";
  }
}

export function isoToTime(iso?: string | null): string {
  if (!iso) return "";
  try {
    return new Date(iso).toTimeString().slice(0, 5);
  } catch {
    return "";
  }
}

/* ── shared card ── */

export function SectionCard({
  title,
  subtitle,
  action,
  children,
}: {
  title: string;
  subtitle?: string;
  action?: React.ReactNode;
  children: React.ReactNode;
}) {
  return (
    <div className="surface-card bg-bg-elevated p-4 sm:p-5 space-y-3">
      <div className="flex items-center justify-between gap-3">
        <div>
          <h2 className="text-xs font-bold uppercase tracking-wider text-white">{title}</h2>
          {subtitle && <p className="text-xs text-text-muted mt-0.5">{subtitle}</p>}
        </div>
        {action}
      </div>
      {children}
    </div>
  );
}

/* ── Menu Items tab ── */

export function MenuItemsTab() {
  const { addToast } = useUIStore();
  const itemsRes = useApiResource<MessMenuItem[] | { items: MessMenuItem[] }>("/api/mess/menu-items");

  const items: MessMenuItem[] = (() => {
    if (!itemsRes.data) return [];
    const d = itemsRes.data as unknown;
    if (Array.isArray(d)) return d as MessMenuItem[];
    return (d as { items?: MessMenuItem[] }).items ?? [];
  })();

  const [editing, setEditing] = useState<MenuItemDraft | null>(null);
  const [saving, setSaving] = useState(false);
  const [deleteId, setDeleteId] = useState<string | null>(null);

  const startNew = () =>
    setEditing({
      code: "",
      label: "",
      isPrimary: false,
      sortOrder: items.length + 1,
    });

  const startEdit = (it: MessMenuItem) =>
    setEditing({ ...it });

  const saveItem = async () => {
    if (!editing) return;
    if (!editing.code.trim() || !editing.label.trim()) {
      addToast({
        variant: "warning",
        title: "Missing fields",
        message: "Code and label are required.",
      });
      return;
    }
    setSaving(true);
    try {
      const headers = getAuthHeaders();
      let res: Response;
      if (editing.id) {
        res = await fetch(`/api/mess/menu-items/${encodeURIComponent(editing.id)}`, {
          method: "PATCH",
          headers,
          body: JSON.stringify({
            code: editing.code.trim(),
            label: editing.label.trim(),
            isPrimary: editing.isPrimary,
            sortOrder: editing.sortOrder,
          }),
        });
      } else {
        res = await fetch("/api/mess/menu-items", {
          method: "POST",
          headers,
          body: JSON.stringify({
            code: editing.code.trim(),
            label: editing.label.trim(),
            isPrimary: editing.isPrimary,
            sortOrder: editing.sortOrder,
          }),
        });
      }
      const json = await res.json().catch(() => null);
      if (!res.ok || json?.success === false) {
        throw new Error(
          typeof json?.error === "string" ? json.error : json?.error?.message ?? `HTTP ${res.status}`
        );
      }
      addToast({ variant: "success", title: editing.id ? "Item updated" : "Item added", message: editing.label });
      clearCache("/api/mess/menu-items");
      await itemsRes.refresh();
      setEditing(null);
    } catch (err) {
      addToast({
        variant: "error",
        title: "Save failed",
        message: err instanceof Error ? err.message : "Could not save item",
      });
    } finally {
      setSaving(false);
    }
  };

  const deleteItem = async () => {
    if (!deleteId) return;
    try {
      const res = await fetch(`/api/mess/menu-items/${encodeURIComponent(deleteId)}`, {
        method: "DELETE",
        headers: getAuthHeaders(),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      addToast({ variant: "success", title: "Item deleted", message: "Menu item removed." });
      clearCache("/api/mess/menu-items");
      await itemsRes.refresh();
    } catch (err) {
      addToast({
        variant: "error",
        title: "Delete failed",
        message: err instanceof Error ? err.message : "Could not delete item",
      });
    } finally {
      setDeleteId(null);
    }
  };

  const sorted = useMemo(
    () => [...items].sort((a, b) => a.sortOrder - b.sortOrder),
    [items]
  );

  return (
    <div className="space-y-4">
      {itemsRes.error && (
        <div className="surface-card flex items-center gap-2 p-3 bg-rose-500/10 text-action-danger text-xs">
          <AlertTriangle className="w-4 h-4 shrink-0" />
          <span className="flex-1">{itemsRes.error}</span>
          <button
          type="button"
            onClick={() => void itemsRes.refresh()}
            className="surface-card inline-flex items-center gap-1 px-2 py-1 bg-rose-500/20 hover:bg-rose-500/30"
          >
            <RefreshCw className="size-3.5" /> Retry
          </button>
        </div>
      )}

      <SectionCard
        title="Menu Item Catalog"
        subtitle="Items students can select as their primary or sub-item"
        action={
          <button
          type="button"
            onClick={startNew}
            className="surface-card inline-flex items-center gap-1.5 px-3 py-2 bg-action-success hover:bg-action-success text-white text-xs font-bold transition"
          >
            <Plus className="w-3.5 h-3.5" /> Add item
          </button>
        }
      >
        {itemsRes.loading && items.length === 0 ? (
          <div className="py-8 flex items-center justify-center">
            <Loader2 className="w-6 h-6 text-action-success animate-spin" />
          </div>
        ) : sorted.length === 0 ? (
          <p className="py-6 text-center text-xs text-text-muted">No menu items yet. Add the first one.</p>
        ) : (
          <div className="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
            <table className="w-full text-sm min-w120">
              <thead>
                <tr className="text-left border-b border-border text-xs font-bold uppercase tracking-wider text-text-muted">
                  <th className="py-2.5 pr-2">#</th>
                  <th className="py-2.5 px-2">Code</th>
                  <th className="py-2.5 px-2">Label</th>
                  <th className="py-2.5 px-2">Primary</th>
                  <th className="py-2.5 pl-2 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800/70">
                {sorted.map((it) => (
                  <tr key={it.id} className="hover:bg-bg-elevated/30 transition">
                    <td className="py-2.5 pr-2 text-text-muted tabular-nums">{it.sortOrder}</td>
                    <td className="py-2.5 px-2">
                      <span className="surface-card font-mono text-xs text-text-secondary bg-bg-elevated/60 px-1.5 py-0.5">
                        {it.code}
                      </span>
                    </td>
                    <td className="py-2.5 px-2 font-semibold text-white">{it.label}</td>
                    <td className="py-2.5 px-2">
                      {it.isPrimary ? (
                        <span className="surface-card inline-flex items-center gap-1 px-2 py-0.5 bg-emerald-500/10 text-action-success text-xs font-bold">
                          <Check className="size-3.5" /> Primary
                        </span>
                      ) : (
                        <span className="text-xs text-text-muted">Sub-item</span>
                      )}
                    </td>
                    <td className="py-2.5 pl-2">
                      <div className="flex items-center justify-end gap-1.5">
                        <button
                        type="button"
                          onClick={() => startEdit(it)}
                          className="size-6 bg-bg-elevated hover:bg-bg-elevated border border-border text-text-muted hover:text-white flex items-center justify-center transition"
                          aria-label={`Edit ${it.label}`}
                        >
                          <Pencil className="size-3.5" />
                        </button>
                        <button
                        type="button"
                          onClick={() => setDeleteId(it.id)}
                          className="size-6 bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-action-danger flex items-center justify-center transition"
                          aria-label={`Delete ${it.label}`}
                        >
                          <Trash2 className="size-3.5" />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </SectionCard>

      {/* Editor */}
      {editing && (
        <SectionCard
          title={editing.id ? `Edit: ${editing.label}` : "New menu item"}
          action={
            <button type="button" onClick={() => setEditing(null)} className="text-text-muted hover:text-white">
              <X className="w-4 h-4" />
            </button>
          }
        >
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label className="block">
              <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Code</span>
              <input
                value={editing.code}
                onChange={(e) => setEditing({ ...editing, code: e.target.value.toUpperCase() })}
                placeholder="RICE"
                className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm font-mono text-white placeholder-slate-600 focus:outline-none focus:"
              />
            </label>
            <label className="block">
              <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Label</span>
              <input
                value={editing.label}
                onChange={(e) => setEditing({ ...editing, label: e.target.value })}
                placeholder="Rice"
                className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white placeholder-slate-600 focus:outline-none focus:"
              />
            </label>
            <label className="block">
              <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Sort order</span>
              <input
                type="number"
                value={editing.sortOrder}
                onChange={(e) => setEditing({ ...editing, sortOrder: Number(e.target.value) || 0 })}
                className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
              />
            </label>
            <div>
              <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Type</span>
              <div className="mt-1 flex gap-2">
                <button
                type="button"
                  onClick={() => setEditing({ ...editing, isPrimary: true })}
                  className={` flex-1 px-3 py-2 rounded-xl text-xs font-bold transition "text-action-success" "text-text-muted "text-action-success" "text-text-muted" `}
                >
                  Primary
                </button>
                <button
                type="button"
                  onClick={() => setEditing({ ...editing, isPrimary: false })}
                  className={` flex-1 px-3 py-2 rounded-xl text-xs font-bold transition "text-text-secondary" "text-text-muted "text-text-secondary" "text-text-muted" `}
                >
                  Sub-item
                </button>
              </div>
            </div>
          </div>
          <button
          type="button"
            onClick={() => void saveItem()}
            disabled={saving}
            className="surface-card inline-flex items-center gap-1.5 px-4 py-2 bg-action-success hover:bg-action-success disabled:opacity-40 text-white text-xs font-bold transition"
          >
            {saving ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Save className="w-3.5 h-3.5" />}
            {editing.id ? "Update item" : "Add item"}
          </button>
        </SectionCard>
      )}

      <ConfirmDialog
        open={Boolean(deleteId)}
        onClose={() => setDeleteId(null)}
        title="Delete menu item?"
        body="This item will no longer be available for new meal days. Existing days are not affected."
        onConfirm={deleteItem}
        confirmText="Delete"
      />
    </div>
  );
}

/* ── Meal Days tab ── */

export function MealDaysTab() {
  const { addToast } = useUIStore();
  const daysRes = useApiResource<MessDay[] | { days: MessDay[] }>("/api/mess/days");
  const itemsRes = useApiResource<MessMenuItem[] | { items: MessMenuItem[] }>("/api/mess/menu-items");

  const days: MessDay[] = (() => {
    if (!daysRes.data) return [];
    const d = daysRes.data as unknown;
    if (Array.isArray(d)) return d as MessDay[];
    return (d as { days?: MessDay[] }).days ?? [];
  })();

  const items: MessMenuItem[] = (() => {
    if (!itemsRes.data) return [];
    const d = itemsRes.data as unknown;
    if (Array.isArray(d)) return d as MessMenuItem[];
    return (d as { items?: MessMenuItem[] }).items ?? [];
  })();

  const itemById = useMemo(() => new Map(items.map((i) => [i.id, i])), [items]);

  const [draft, setDraft] = useState<MealDayDraft>(() => ({
    mealDate: new Date().toISOString().slice(0, 10),
    dayType: "LUNCH",
    windowOpens: "12:30",
    windowCloses: "14:00",
    items: [],
  }));
  const [creating, setCreating] = useState(false);
  const [editingDay, setEditingDay] = useState<MessDay | null>(null);
  const [editingDraft, setEditingDraft] = useState<MealDayDraft | null>(null);
  const [cancelDayId, setCancelDayId] = useState<string | null>(null);

  const toggleItem = (id: string) =>
    setDraft((d) => ({
      ...d,
      items: d.items.includes(id) ? d.items.filter((x) => x !== id) : [...d.items, id],
    }));

  const createDay = async () => {
    if (!draft.mealDate) {
      addToast({ variant: "warning", title: "Date required", message: "Pick a meal date first." });
      return;
    }
    setCreating(true);
    try {
      const res = await fetch("/api/mess/days", {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({
          mealDate: draft.mealDate,
          dayType: draft.dayType,
          windowOpens: timeToIso(draft.mealDate, draft.windowOpens),
          windowCloses: timeToIso(draft.mealDate, draft.windowCloses),
          items: draft.items,
        }),
      });
      const json = await res.json().catch(() => null);
      if (!res.ok || json?.success === false) {
        throw new Error(
          typeof json?.error === "string" ? json.error : json?.error?.message ?? `HTTP ${res.status}`
        );
      }
      addToast({ variant: "success", title: "Meal day created", message: draft.mealDate });
      clearCache("/api/mess/days");
      await daysRes.refresh();
    } catch (err) {
      addToast({
        variant: "error",
        title: "Create failed",
        message: err instanceof Error ? err.message : "Could not create meal day",
      });
    } finally {
      setCreating(false);
    }
  };

  const startEditDay = (day: MessDay) => {
    setEditingDay(day);
    setEditingDraft({
      mealDate: day.mealDate,
      dayType: day.dayType ?? "LUNCH",
      windowOpens: isoToTime(day.windowOpens),
      windowCloses: isoToTime(day.windowCloses),
      items: day.itemIds ?? [],
    });
  };

  const saveEditDay = async () => {
    if (!editingDay || !editingDraft) return;
    setCreating(true);
    try {
      const res = await fetch(`/api/mess/days/${encodeURIComponent(editingDay.id)}`, {
        method: "PATCH",
        headers: getAuthHeaders(),
        body: JSON.stringify({
          mealDate: editingDraft.mealDate,
          dayType: editingDraft.dayType,
          windowOpens: timeToIso(editingDraft.mealDate, editingDraft.windowOpens),
          windowCloses: timeToIso(editingDraft.mealDate, editingDraft.windowCloses),
          items: editingDraft.items,
        }),
      });
      const json = await res.json().catch(() => null);
      if (!res.ok || json?.success === false) {
        throw new Error(
          typeof json?.error === "string" ? json.error : json?.error?.message ?? `HTTP ${res.status}`
        );
      }
      addToast({ variant: "success", title: "Meal day updated", message: editingDraft.mealDate });
      clearCache("/api/mess/days");
      await daysRes.refresh();
      setEditingDay(null);
      setEditingDraft(null);
    } catch (err) {
      addToast({
        variant: "error",
        title: "Update failed",
        message: err instanceof Error ? err.message : "Could not update meal day",
      });
    } finally {
      setCreating(false);
    }
  };

  const cancelDay = async () => {
    if (!cancelDayId) return;
    try {
      const res = await fetch(`/api/mess/days/${encodeURIComponent(cancelDayId)}`, {
        method: "DELETE",
        headers: getAuthHeaders(),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      addToast({ variant: "success", title: "Meal day cancelled", message: "The meal day has been cancelled." });
      clearCache("/api/mess/days");
      await daysRes.refresh();
    } catch (err) {
      addToast({
        variant: "error",
        title: "Cancel failed",
        message: err instanceof Error ? err.message : "Could not cancel meal day",
      });
    } finally {
      setCancelDayId(null);
    }
  };

  const fmtDate = (d: string) => {
    try {
      return new Date(`${d}T00:00:00`).toLocaleDateString("en-IN", {
        weekday: "short",
        day: "numeric",
        month: "short",
      });
    } catch {
      return d;
    }
  };

  const sortedDays = useMemo(
    () => [...days].sort((a, b) => a.mealDate.localeCompare(b.mealDate)),
    [days]
  );

  const toggleEditItem = (id: string) =>
    setEditingDraft((d) =>
      d
        ? {
            ...d,
            items: d.items.includes(id) ? d.items.filter((x) => x !== id) : [...d.items, id],
          }
        : d
    );

  return (
    <div className="space-y-4">
      {daysRes.error && (
        <div className="surface-card flex items-center gap-2 p-3 bg-rose-500/10 text-action-danger text-xs">
          <AlertTriangle className="w-4 h-4 shrink-0" />
          <span className="flex-1">{daysRes.error}</span>
          <button
          type="button"
            onClick={() => void daysRes.refresh()}
            className="surface-card inline-flex items-center gap-1 px-2 py-1 bg-rose-500/20 hover:bg-rose-500/30"
          >
            <RefreshCw className="size-3.5" /> Retry
          </button>
        </div>
      )}

      <SectionCard
        title="Create Meal Day"
        subtitle="Set the date, type, serving window and which menu items are on"
      >
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <label className="block">
            <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Meal date</span>
            <input
              type="date"
              value={draft.mealDate}
              onChange={(e) => setDraft({ ...draft, mealDate: e.target.value })}
              className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
            />
          </label>
          <label className="block">
            <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Day type</span>
            <select
              value={draft.dayType}
              onChange={(e) => setDraft({ ...draft, dayType: e.target.value })}
              className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
            >
              {DAY_TYPES.map((t) => (
                <option key={t} value={t}>
                  {t.charAt(0) + t.slice(1).toLowerCase()}
                </option>
              ))}
            </select>
          </label>
          <label className="block">
            <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Window opens</span>
            <input
              type="time"
              value={draft.windowOpens}
              onChange={(e) => setDraft({ ...draft, windowOpens: e.target.value })}
              className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
            />
          </label>
          <label className="block">
            <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Window closes</span>
            <input
              type="time"
              value={draft.windowCloses}
              onChange={(e) => setDraft({ ...draft, windowCloses: e.target.value })}
              className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
            />
          </label>
        </div>

        {/* Items multi-select */}
        <div>
          <span className="text-xs font-bold uppercase tracking-wider text-text-muted">
            Items on this day
          </span>
          {items.length === 0 ? (
            <p className="text-xs text-text-muted mt-1">No menu items available yet.</p>
          ) : (
            <div className="mt-1.5 flex flex-wrap gap-1.5">
              {items.map((it) => {
                const on = draft.items.includes(it.id);
                return (
                  <button
                    type="button"
                    key={it.id}
                    onClick={() => toggleItem(it.id)}
                    className={` inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold transition "text-action-success" "text-text-muted "text-action-success" "text-text-muted" `}
                  >
                    {on && <Check className="size-3.5" />}
                    {it.isPrimary ? (
                      it.label === "Veg" || it.label.toLowerCase() === "veg" ? (
                        <Leaf className="size-3.5" />
                      ) : (
                        <Beef className="size-3.5" />
                      )
                    ) : null}
                    {it.label}
                  </button>
                );
              })}
            </div>
          )}
        </div>

        <button
        type="button"
          onClick={() => void createDay()}
          disabled={creating}
          className="surface-card inline-flex items-center gap-1.5 px-4 py-2 bg-action-success hover:bg-action-success disabled:opacity-40 text-white text-xs font-bold transition"
        >
          {creating ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Plus className="w-3.5 h-3.5" />}
          Create meal day
        </button>
      </SectionCard>

      {/* Days list */}
      <SectionCard
        title="Scheduled Meal Days"
        subtitle={String(sortedDays.length)}
        action={
          <button
          type="button"
            onClick={() => void daysRes.refresh()}
            className="text-text-muted hover:text-white"
            aria-label="Refresh"
          >
            <RefreshCw className="w-4 h-4" />
          </button>
        }
      >
        {sortedDays.length === 0 ? (
          <p className="py-6 text-center text-xs text-text-muted">No meal days scheduled.</p>
        ) : (
          <div className="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
            <table className="w-full text-sm min-w140">
              <thead>
                <tr className="text-left border-b border-border text-xs font-bold uppercase tracking-wider text-text-muted">
                  <th className="py-2.5 pr-2">Date</th>
                  <th className="py-2.5 px-2">Type</th>
                  <th className="py-2.5 px-2">Window</th>
                  <th className="py-2.5 px-2">Items</th>
                  <th className="py-2.5 pl-2 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800/70">
                {sortedDays.map((d) => (
                  <tr key={d.id} className="hover:bg-bg-elevated/30 transition">
                    <td className="py-2.5 pr-2 font-semibold text-white">{fmtDate(d.mealDate)}</td>
                    <td className="py-2.5 px-2 text-xs text-text-muted">
                      {(d.dayType ?? "").replace(/_/g, " ") || "—"}
                    </td>
                    <td className="py-2.5 px-2 text-xs text-text-muted tabular-nums">
                      {isoToTime(d.windowOpens) || "—"} – {isoToTime(d.windowCloses) || "—"}
                    </td>
                    <td className="py-2.5 px-2">
                      <div className="flex flex-wrap gap-1">
                        {(d.itemIds ?? []).map((iid) => {
                          const it = itemById.get(iid);
                          return (
                            <span
                              key={iid}
                              className="surface-card px-1.5 py-0.5 bg-bg-elevated/60 text-xs text-text-secondary"
                            >
                              {it?.label ?? iid.slice(0, 6)}
                            </span>
                          );
                        })}
                        {(d.itemIds ?? []).length === 0 && <span className="text-xs text-text-muted">—</span>}
                      </div>
                    </td>
                    <td className="py-2.5 pl-2">
                      <div className="flex items-center justify-end gap-1.5">
                        <button
                        type="button"
                          onClick={() => startEditDay(d)}
                          className="size-6 bg-bg-elevated hover:bg-bg-elevated border border-border text-text-muted hover:text-white flex items-center justify-center transition"
                          aria-label="Edit"
                        >
                          <Pencil className="size-3.5" />
                        </button>
                        <button
                        type="button"
                          onClick={() => setCancelDayId(d.id)}
                          className="size-6 bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-action-danger flex items-center justify-center transition"
                          aria-label="Cancel day"
                        >
                          <Ban className="size-3.5" />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </SectionCard>

      {/* Edit day */}
      {editingDay && editingDraft && (
        <SectionCard
          title={`Edit meal day — ${fmtDate(editingDraft.mealDate)}`}
          action={
            <button type="button" onClick={() => { setEditingDay(null); setEditingDraft(null); }} className="text-text-muted hover:text-white">
              <X className="w-4 h-4" />
            </button>
          }
        >
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label className="block">
              <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Meal date</span>
              <input
                type="date"
                value={editingDraft.mealDate}
                onChange={(e) => setEditingDraft({ ...editingDraft, mealDate: e.target.value })}
                className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
              />
            </label>
            <label className="block">
              <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Day type</span>
              <select
                value={editingDraft.dayType}
                onChange={(e) => setEditingDraft({ ...editingDraft, dayType: e.target.value })}
                className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
              >
                {DAY_TYPES.map((t) => (
                  <option key={t} value={t}>
                    {t.charAt(0) + t.slice(1).toLowerCase()}
                  </option>
                ))}
              </select>
            </label>
            <label className="block">
              <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Window opens</span>
              <input
                type="time"
                value={editingDraft.windowOpens}
                onChange={(e) => setEditingDraft({ ...editingDraft, windowOpens: e.target.value })}
                className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
              />
            </label>
            <label className="block">
              <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Window closes</span>
              <input
                type="time"
                value={editingDraft.windowCloses}
                onChange={(e) => setEditingDraft({ ...editingDraft, windowCloses: e.target.value })}
                className="surface-card mt-1 w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
              />
            </label>
          </div>
          <div>
            <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Items</span>
            {items.length === 0 ? (
              <p className="text-xs text-text-muted mt-1">No menu items.</p>
            ) : (
              <div className="mt-1.5 flex flex-wrap gap-1.5">
                {items.map((it) => {
                  const on = editingDraft.items.includes(it.id);
                  return (
                    <button
                        key={it.id}
                        type="button"
                        onClick={() => toggleEditItem(it.id)}
                      className={` inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold transition "text-action-success" "text-text-muted "text-action-success" "text-text-muted" `}
                    >
                      {on && <Check className="size-3.5" />}
                      {it.label}
                    </button>
                  );
                })}
              </div>
            )}
          </div>
          <button
          type="button"
            onClick={() => void saveEditDay()}
            disabled={creating}
            className="surface-card inline-flex items-center gap-1.5 px-4 py-2 bg-action-success hover:bg-action-success disabled:opacity-40 text-white text-xs font-bold transition"
          >
            {creating ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Save className="w-3.5 h-3.5" />}
            Save changes
          </button>
        </SectionCard>
      )}

      <ConfirmDialog
        open={Boolean(cancelDayId)}
        onClose={() => setCancelDayId(null)}
        title="Cancel this meal day?"
        body="Cancelling will stop the preference window for this day and revoke pending tokens. Students will no longer be able to select for this meal."
        onConfirm={cancelDay}
        confirmText="Cancel day"
        variant="destructive"
      />
    </div>
  );
}

/* ── Analytics tab ── */

/* ── Today tab ── */

export interface MenuTodayItem {
  id: string;
  code: string;
  label: string;
  isAvailable: boolean;
}

export interface TodayMenuData {
  mealDate: string | null;
  messDayId: string | null;
  items: MenuTodayItem[];
}

export interface CountsTimelineRow {
  messDayId: string;
  mealDate: string;
  servedTotal: number;
}

export function TodayTab() {
  const { addToast } = useUIStore();
  const menuRes = useApiResource<TodayMenuData | null>("/api/mess/menu");
  const mealCountsRes = useApiResource<Record<string, unknown> | null>("/api/mess/meal-counts");
  const consumptionRes = useApiResource<{ days: number; trend: CountsTimelineRow[]; totals: Record<string, number> } | null>(
    "/api/mess/consumption?days=14"
  );

  const menu: MenuTodayItem[] = (menuRes.data as TodayMenuData | null)?.items ?? [];
  const counts = mealCountsRes.data as Record<string, unknown> | null;
  const trend: CountsTimelineRow[] = (consumptionRes.data as { trend?: CountsTimelineRow[] } | null)?.trend ?? [];
  const total = counts ? Number(counts.total ?? 0) : 0;
  const confirmed = counts ? Number(counts.confirmed ?? 0) : 0;
  const noShows = counts ? Number(counts.noShows ?? 0) : 0;

  const issued = confirmed + noShows;
  const remaining = Math.max(0, total - issued);

  const [headcount, setHeadcount] = useState<string>("");
  const [finalizing, setFinalizing] = useState(false);
  const [confirmFinalize, setConfirmFinalize] = useState(false);
  const [confirmRevoke, setConfirmRevoke] = useState(false);
  const [revoking, setRevoking] = useState(false);

  const messDayId = (menuRes.data as TodayMenuData | null)?.messDayId ?? null;

  const finalizeDay = async () => {
    if (!messDayId) return;
    setFinalizing(true);
    try {
      const res = await fetch("/api/admin/mess-finalize", {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({
          messDayId,
          finalHeadcount: headcount.trim() !== "" ? Number(headcount) : confirmed,
          confirmedBy: "MANUAL_FINALIZE",
        }),
      });
      const json = await res.json().catch(() => null);
      if (!res.ok || json?.success === false) {
        throw new Error(
          typeof json?.error === "string" ? json.error : json?.error?.message ?? `HTTP ${res.status}`
        );
      }
      addToast({ variant: "success", title: "Day finalized", message: `Headcount ${json?.data?.finalHeadcount} locked.` });
      clearCache("/api/mess/menu");
      clearCache("/api/mess/meal-counts");
      await menuRes.refresh();
    } catch (err) {
      addToast({ variant: "error", title: "Finalize failed", message: err instanceof Error ? err.message : "Could not finalize day" });
    } finally {
      setFinalizing(false);
    }
  };

  const revokeAllTokens = async () => {
    if (!messDayId) return;
    setRevoking(true);
    try {
      const res = await fetch("/api/mess/revoke", {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ dayId: messDayId }),
      });
      const json = await res.json().catch(() => null);
      if (!res.ok || json?.success === false) {
        throw new Error(
          typeof json?.error === "string" ? json.error : json?.error?.message ?? `HTTP ${res.status}`
        );
      }
      addToast({
        variant: "success",
        title: "Tokens revoked",
        message: `${json?.data?.revokedCount ?? 0} token(s) revoked for ${menuRes.data?.mealDate ?? "this day"}.`,
      });
      clearCache("/api/mess/menu");
      clearCache("/api/mess/meal-counts");
      await menuRes.refresh();
    } catch (err) {
      addToast({ variant: "error", title: "Revoke failed", message: err instanceof Error ? err.message : "Could not revoke tokens" });
    } finally {
      setRevoking(false);
    }
  };

  const maxServed = trend.reduce((m, r) => Math.max(m, r.servedTotal), 1);

  return (
    <div className="space-y-4">
      {(menuRes.error || mealCountsRes.error || consumptionRes.error) && (
        <div className="surface-card flex items-center gap-2 p-3 bg-rose-500/10 text-action-danger text-xs">
          <AlertTriangle className="w-4 h-4 shrink-0" />
          <span className="flex-1">{[menuRes.error, mealCountsRes.error, consumptionRes.error].filter(Boolean).join(" · ")}</span>
          <button
            type="button"
            onClick={() => { void menuRes.refresh(); void mealCountsRes.refresh(); void consumptionRes.refresh(); }}
            className="surface-card inline-flex items-center gap-1 px-2 py-1 bg-rose-500/20 hover:bg-rose-500/30"
          >
            <RefreshCw className="size-3.5" /> Retry
          </button>
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <SectionCard title="Today's Menu" subtitle={(menuRes.data as TodayMenuData | null)?.mealDate ?? "No active meal day"}>
          {menuRes.loading && menu.length === 0 ? (
            <div className="py-8 flex items-center justify-center"><Loader2 className="w-6 h-6 text-action-success animate-spin" /></div>
          ) : menu.length === 0 ? (
            <p className="py-4 text-center text-xs text-text-muted">No menu items scheduled for the active meal day.</p>
          ) : (
            <ul className="space-y-1.5">
              {menu.map((it) => (
                <li key={it.id} className="surface-card flex items-center justify-between px-3 py-2 bg-bg-surface/60">
                  <div className="flex items-center gap-2 min-w-0">
                    {it.code === "VEG" ? <Leaf className="w-3.5 h-3.5 text-action-success shrink-0" /> : <Beef className="w-3.5 h-3.5 text-action-danger shrink-0" />}
                    <span className="font-semibold text-white text-xs truncate">{it.label}</span>
                    <span className="surface-card font-mono text-xs text-text-muted bg-bg-elevated/60 px-1.5 py-0.5">{it.code}</span>
                  </div>
                  <span className={`text-xs font-bold uppercase ${it.isAvailable ? "text-action-success" : "text-text-muted line-through"}`}>
                    {it.isAvailable ? "Available" : "Unavailable"}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </SectionCard>

        <SectionCard title="Token Status" subtitle="Issued · verified · remaining">
          <div className="space-y-3">
            <div className="grid grid-cols-3 gap-2">
              <div className="surface-card bg-bg-surface/60 p-3 text-center">
                <Users className="w-4 h-4 text-action-info mx-auto mb-1" />
                <p className="text-lg font-black text-white tabular-nums">{issued}</p>
                <p className="text-xs font-bold uppercase tracking-wider text-text-muted">Issued</p>
              </div>
              <div className="surface-card bg-bg-surface/60 p-3 text-center">
                <Check className="w-4 h-4 text-action-success mx-auto mb-1" />
                <p className="text-lg font-black text-white tabular-nums">{confirmed}</p>
                <p className="text-xs font-bold uppercase tracking-wider text-text-muted">Verified</p>
              </div>
              <div className="surface-card bg-bg-surface/60 p-3 text-center">
                <Ticket className="w-4 h-4 text-action-warning mx-auto mb-1" />
                <p className="text-lg font-black text-white tabular-nums">{remaining}</p>
                <p className="text-xs font-bold uppercase tracking-wider text-text-muted">Remaining</p>
              </div>
            </div>
            <div>
              <label className="block">
                <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Final headcount</span>
                <div className="mt-1 flex gap-2">
                  <input type="number" min={0} value={headcount} onChange={(e) => setHeadcount(e.target.value)} placeholder={String(confirmed)}
                    className="surface-card flex-1 px-3 py-2 bg-bg-surface text-sm text-white placeholder-slate-600 focus:outline-none focus:" />
                  <button type="button" onClick={() => setConfirmFinalize(true)} disabled={!messDayId || finalizing}
                    className="surface-card inline-flex items-center gap-1.5 px-4 py-2 bg-action-success hover:bg-action-success disabled:opacity-40 text-white text-xs font-bold transition">
                    {finalizing ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Lock className="w-3.5 h-3.5" />} Finalize Day
                  </button>
                </div>
              </label>
            </div>
            <div>
              <button type="button" onClick={() => setConfirmRevoke(true)} disabled={!messDayId || revoking}
                className="surface-card inline-flex items-center gap-1.5 px-4 py-2 bg-rose-600/80 hover:bg-action-danger disabled:opacity-40 text-white text-xs font-bold transition w-full">
                {revoking ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Ban className="w-3.5 h-3.5" />} Revoke All Tokens
              </button>
            </div>
          </div>
        </SectionCard>
      </div>

      <SectionCard title="Counts Timeline" subtitle="Per-day served headcount, last 14 days">
        {trend.length === 0 ? (
          <p className="py-4 text-center text-xs text-text-muted">No serving data yet.</p>
        ) : (
          <div className="space-y-2">
            {trend.map((r) => (
              <div key={r.messDayId} className="flex items-center gap-2">
                <span className="text-xs text-text-muted w-24 shrink-0 tabular-nums">{r.mealDate.slice(5)}</span>
                <div className="flex-1 h-2.5 rounded-full bg-bg-elevated overflow-hidden">
                  <div className="h-full bg-emerald-500/80 rounded-full transition-all" style={{ width: `${Math.round((r.servedTotal / maxServed) * 100)}%` }} />
                </div>
                <span className="text-xs text-white font-bold tabular-nums w-10 text-right">{r.servedTotal}</span>
              </div>
            ))}
          </div>
        )}
      </SectionCard>

      <ConfirmDialog open={confirmFinalize} onClose={() => setConfirmFinalize(false)} title="Finalize this mess day?"
        body={`The headcount (${headcount.trim() !== "" ? headcount : confirmed}) will be locked and the selection window closed for this day. This cannot be undone.`}
        onConfirm={finalizeDay} confirmText="Finalize" variant="destructive" />
      <ConfirmDialog open={confirmRevoke} onClose={() => setConfirmRevoke(false)} title="Revoke all tokens for this day?"
        body="All unused, unrevoked tokens for the active meal day will be revoked immediately. Students will not be able to redeem them."
        onConfirm={revokeAllTokens} confirmText="Revoke tokens" variant="destructive" />
    </div>
  );
}

/* ── Analytics tab ── */

interface DayAnalyticsRow {
  dayId: string;
  mealDate: string;
  analytics: MessAnalytics | null;
  error?: string;
}

export function AnalyticsTab() {
  const daysRes = useApiResource<MessDay[] | { days: MessDay[] }>("/api/mess/days");

  const days: MessDay[] = (() => {
    if (!daysRes.data) return [];
    const d = daysRes.data as unknown;
    if (Array.isArray(d)) return d as MessDay[];
    return (d as { days?: MessDay[] }).days ?? [];
  })();

  const [rows, setRows] = useState<DayAnalyticsRow[]>([]);
  const [loading, setLoading] = useState(false);

  const loadAnalytics = useCallback(async () => {
    if (days.length === 0) return;
    setLoading(true);
    try {
      const results = await Promise.all(
        days.map(async (day) => {
          try {
            const res = await fetch(`/api/mess/analytics?dayId=${encodeURIComponent(day.id)}`, {
              headers: getAuthHeaders(),
              cache: "no-store",
            });
            const json = await res.json().catch(() => null);
            if (!res.ok) {
              return {
                dayId: day.id,
                mealDate: day.mealDate,
                analytics: null,
                error: `HTTP ${res.status}`,
              } satisfies DayAnalyticsRow;
            }
            const data: MessAnalytics = (json.data ?? json) as MessAnalytics;
            return {
              dayId: day.id,
              mealDate: day.mealDate,
              analytics: data,
            } satisfies DayAnalyticsRow;
          } catch (err) {
            return {
              dayId: day.id,
              mealDate: day.mealDate,
              analytics: null,
              error: err instanceof Error ? err.message : "fetch failed",
            } satisfies DayAnalyticsRow;
          }
        })
      );
      setRows(
        [...results]
          .sort((a, b) => b.mealDate.localeCompare(a.mealDate))
          .slice(0, 30)
      );
    } finally {
      setLoading(false);
    }
  }, [days]);

  useEffect(() => {
    if (days.length > 0) void loadAnalytics();
  }, [days.length, loadAnalytics]);

  const fmtDate = (d: string) => {
    try {
      return new Date(`${d}T00:00:00`).toLocaleDateString("en-IN", {
        weekday: "short",
        day: "numeric",
        month: "short",
      });
    } catch {
      return d;
    }
  };

  return (
    <div className="space-y-4">
      {daysRes.error && (
        <div className="surface-card flex items-center gap-2 p-3 bg-rose-500/10 text-action-danger text-xs">
          <AlertTriangle className="w-4 h-4 shrink-0" />
          <span className="flex-1">Could not load meal days: {daysRes.error}</span>
        </div>
      )}

      <SectionCard
        title="Historical Meal-Day Counts"
        subtitle="Last 30 meal days — declared vs confirmed vs no-show"
        action={
          <button
          type="button"
            onClick={() => void loadAnalytics()}
            disabled={loading}
            className="surface-card inline-flex items-center gap-1.5 px-3 py-2 bg-bg-elevated hover:bg-bg-elevated text-text-secondary text-xs font-bold transition disabled:opacity-50"
          >
            {loading ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <RefreshCw className="w-3.5 h-3.5" />}
            Reload
          </button>
        }
      >
        {loading && rows.length === 0 ? (
          <div className="py-10 flex items-center justify-center">
            <Loader2 className="w-6 h-6 text-action-success animate-spin" />
          </div>
        ) : rows.length === 0 ? (
          <p className="py-8 text-center text-xs text-text-muted">
            No historical data yet. Schedule meal days to start collecting counts.
          </p>
        ) : (
          <div className="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
            <table className="w-full text-sm min-w155">
              <thead>
                <tr className="text-left border-b border-border text-xs font-bold uppercase tracking-wider text-text-muted">
                  <th className="py-2.5 pr-2">Date</th>
                  <th className="py-2.5 px-2">Total</th>
                  <th className="py-2.5 px-2">Declared</th>
                  <th className="py-2.5 px-2">Confirmed</th>
                  <th className="py-2.5 px-2">Not selected</th>
                  <th className="py-2.5 px-2">Veg / Non</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800/70">
                {rows.map((r) => {
                  const a = r.analytics;
                  const veg = a?.byPrimary?.veg ?? 0;
                  const non = a?.byPrimary?.nonVeg ?? 0;
                  return (
                    <tr key={r.dayId} className="hover:bg-bg-elevated/30 transition">
                      <td className="py-2.5 pr-2 font-semibold text-white">{fmtDate(r.mealDate)}</td>
                      <td className="py-2.5 px-2 text-text-secondary tabular-nums">{a?.totalHostellers ?? "—"}</td>
                      <td className="py-2.5 px-2 text-action-success tabular-nums">{a?.declaredPresent ?? "—"}</td>
                      <td className="py-2.5 px-2 text-action-success tabular-nums">{a?.confirmedPresent ?? "—"}</td>
                      <td className="py-2.5 px-2 text-action-warning tabular-nums">{a?.notSelected ?? "—"}</td>
                      <td className="py-2.5 px-2">
                        {a ? (
                          <div className="flex items-center gap-2">
                            <div className="w-16 h-1.5 rounded-full bg-bg-elevated overflow-hidden flex">
                              <div
                                className="h-full bg-action-success"
                                style={{
                                  width: veg + non
                                    ? `${Math.round((veg / (veg + non)) * 100)}%`
                                    : "0%",
                                }}
                              />
                              <div className="h-full bg-action-danger flex-1" />
                            </div>
                            <span className="text-xs text-text-muted tabular-nums">
                              {veg}/{non}
                            </span>
                          </div>
                        ) : (
                          <span className="text-xs text-text-muted">{r.error ?? "—"}</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </SectionCard>
    </div>
  );
}
