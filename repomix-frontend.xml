<file path="src/components/nav/LifefulCalendarAgenda.tsx">
"use client";

import React, { useMemo } from "react";
import Link from "next/link";
import { usePathname, useRouter } from "next/navigation";
import {
  Clock,
  MapPin,
  Sparkles,
  ArrowUpRight,
  CalendarCheck,
} from "lucide-react";
import { SmartTextRef } from "@/components/nav/SmartTextRef";
import { useIsSakuga } from "@/components/student/useIsSakuga";

export interface LifefulCalendarItem {
  id: string;
  title: string;
  category?: string;
  timeRange?: string | null;
  location?: string | null;
  status?: string | null;
  note?: string | null;
  actionLabel?: string;
  actionHref?: string;
}

export function LifefulCalendarAgenda({
  selectedDateLabel,
  isToday = false,
  items = [],
  onJumpToday,
  emptyMessage = "No scheduled events or entries on this date.",
  quickLinks = [],
}: {
  selectedDateLabel: string;
  isToday?: boolean;
  items: LifefulCalendarItem[];
  onJumpToday?: () => void;
  emptyMessage?: string;
  quickLinks?: Array<{ label: string; href: string }>;
}) {
  const pathname = usePathname();
  const router = useRouter();
  const isSakuga = useIsSakuga();

  const countsByCategory = useMemo(() => {
    const map: Record<string, number> = {};
    for (const item of items) {
      const key = (item.category ?? "general").toLowerCase();
      map[key] = (map[key] ?? 0) + 1;
    }
    return Object.entries(map);
  }, [items]);

  return (
    <div
      data-testid="lifeful-calendar-agenda"
      className="surface-card bg-bg-surface p-4 space-y-3.5"
    >
      <div className="flex flex-wrap items-center justify-between gap-2 border-b border-border pb-3">
        <div className="flex flex-wrap items-center gap-2">
          <CalendarCheck className="h-4 w-4 text-action-primary shrink-0" />
          <h3 className="text-sm font-semibold text-text-primary">
            {selectedDateLabel}
          </h3>
          {isToday && (
            <span className="inline-flex items-center gap-1 rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-[11px] font-semibold text-action-success">
              <Sparkles className="h-3 w-3" />
              Live Today
            </span>
          )}
          <span className="border border-border bg-bg-elevated px-2.5 py-0.5 font-mono text-[11px] text-text-muted">
            {items.length} {items.length === 1 ? "item" : "items"}
          </span>
        </div>

        <div className="flex items-center gap-2">
          {!isToday && onJumpToday && (
            isSakuga ? (
              <sakuga-button variant="secondary" onClick={onJumpToday}>
                <span className="text-xs">Jump to Today</span>
              </sakuga-button>
            ) : (
              <button
                type="button"
                onClick={onJumpToday}
                className="surface-card bg-bg-elevated px-2.5 py-1 text-xs font-medium text-action-primary hover:bg-bg-surface transition-colors"
              >
                Jump to Today
              </button>
            )
          )}
        </div>
      </div>

      {countsByCategory.length > 0 && (
        <div className="flex flex-wrap gap-1.5">
          {countsByCategory.map(([cat, count]) => (
            <span
              key={cat}
              className="border border-border bg-bg-elevated/60 px-2.5 py-0.5 text-[11px] font-medium capitalize text-text-muted"
            >
              {cat.replace(/[_-]+/g, " ")}:{" "}
              <strong className="text-text-primary">{count}</strong>
            </span>
          ))}
        </div>
      )}

      {items.length === 0 ? (
        <div className="surface-card border-dashed bg-bg-elevated/30 p-4 text-xs text-text-muted">
          {emptyMessage}
        </div>
      ) : (
        <div className="space-y-2.5">
          {items.map((item) => (
            <div
              key={item.id}
              className="surface-card bg-bg-elevated/40 p-3 space-y-2 transition-colors hover:border-action-primary/40"
            >
              <div className="flex flex-wrap items-start justify-between gap-2">
                <div className="space-y-0.5 min-w-0">
                  <div className="flex flex-wrap items-center gap-2 text-xs text-text-muted">
                    {item.timeRange && (
                      <span className="inline-flex items-center gap-1 font-mono font-medium text-text-primary">
                        <Clock className="h-3 w-3 text-action-primary" />
                        {item.timeRange}
                      </span>
                    )}
                    {item.location && (
                      <span className="inline-flex items-center gap-1">
                        <MapPin className="h-3 w-3" />
                        {item.location}
                      </span>
                    )}
                    {item.category && (
                      <span className="rounded bg-bg-surface px-1.5 py-0.5 text-[10px] font-semibold uppercase text-text-muted">
                        {item.category}
                      </span>
                    )}
                  </div>
                  <p className="text-sm font-semibold break-words text-text-primary">
                    {item.title}
                  </p>
                </div>

                {item.status && (
                  <span className="border border-border bg-bg-surface px-2.5 py-0.5 text-[11px] font-medium capitalize text-text-primary">
                    {item.status.replace(/[_-]+/g, " ")}
                  </span>
                )}
              </div>

              {item.note && (
                <p className="text-xs text-text-muted leading-relaxed">
                  <SmartTextRef text={item.note} currentPath={pathname} />
                </p>
              )}

              {item.actionHref && item.actionLabel && (
                <div className="pt-1">
                  {isSakuga ? (
                    <sakuga-button
                      variant="secondary"
                      onClick={() => router.push(item.actionHref!)}
                    >
                      <span className="inline-flex items-center gap-1 text-xs">
                        <span>{item.actionLabel}</span>
                        <ArrowUpRight className="h-3.5 w-3.5" />
                      </span>
                    </sakuga-button>
                  ) : (
                    <Link
                      href={item.actionHref}
                      className="inline-flex items-center gap-1 text-xs font-semibold text-action-primary hover:underline"
                    >
                      <span>{item.actionLabel}</span>
                      <ArrowUpRight className="h-3.5 w-3.5" />
                    </Link>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {quickLinks.length > 0 && (
        <div className="flex flex-wrap items-center gap-2 pt-2 border-t border-border">
          {quickLinks.map((ql) =>
            isSakuga ? (
              <sakuga-button
                key={ql.href + ql.label}
                variant="secondary"
                onClick={() => router.push(ql.href)}
              >
                <span className="inline-flex items-center gap-1 text-xs">
                  <span>{ql.label}</span>
                  <ArrowUpRight className="h-3 w-3" />
                </span>
              </sakuga-button>
            ) : (
              <Link
                key={ql.href + ql.label}
                href={ql.href}
                className="inline-flex items-center gap-1 surface-card bg-bg-elevated/60 px-2.5 py-1 text-xs font-medium text-text-primary hover:bg-bg-elevated transition-colors"
              >
                <span>{ql.label}</span>
                <ArrowUpRight className="h-3 w-3" />
              </Link>
            ),
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/nav/PassTicketTierView.tsx">
"use client";

/**
 * PassTicketTierView — role-adapted UI for a pass/permission ticket.
 *
 * Shows:
 *   1. A "why I'm here" banner (role + tier label + mode).
 *   2. Any reason/note text rendered through SmartTextRef for live links.
 *   3. Tier-filtered content sections (pass-qr, chain, student-context, etc.).
 *   4. A decision note input when rejecting/escalating.
 *   5. An action bar scoped to the role's abilities.
 *
 * This is the rendering layer for the pure `getPassTicketRulesForRole()` resolver
 * in `src/lib/pass-ticket-rules.ts`.
 */

import React, { useState } from "react";
import Link from "next/link";
import { ShieldCheck, ArrowUpRight, AlertTriangle } from "lucide-react";
import {
  getPassTicketRulesForRole,
  type PassTicketSnapshot,
  type PassActionSpec,
  type PassTicketRuleSet,
} from "@/lib/pass-ticket-rules";
import { SmartTextRef } from "./SmartTextRef";
import { cn } from "@/lib/utils";

interface PassTicketTierViewProps {
  role: string | undefined;
  ticket: PassTicketSnapshot;
  /** Optional free-text field (reason, notes) that gets smart-linked. */
  reasonText?: string | null;
  /** Current URL path used to resolve ?inspect= links (default: ""). */
  currentPath?: string;
  /** Called when an API-bound action is triggered. Return a promise if async. */
  onExecuteAction?: (action: PassActionSpec, note?: string) => Promise<void> | void;
  /**
   * Custom section renderer. When provided, called for each visibleSection.
   * When absent, renders placeholder blocks.
   */
  renderSection?: (section: NonNullable<PassTicketRuleSet["visibleSections"]>[number]) => React.ReactNode;
}

type RuleSet = ReturnType<typeof getPassTicketRulesForRole>;

// Color map for mode badges
const MODE_CLS: Record<string, string> = {
  "requester-loop": "border-action-info/30 bg-action-info/10 text-action-info",
  "gate-verify": "border-action-success/30 bg-action-success/10 text-action-success",
  "stage-act": "border-action-warning/30 bg-action-warning/10 text-action-warning",
  "stage-wait": "border-border/30 bg-bg-elevated text-text-secondary",
  "exec-intervene": "border-action-danger/30 bg-action-danger/10 text-action-danger",
  "sys-trace": "border-unit-b/30 bg-unit-b/10 text-unit-b",
};

export function PassTicketTierView({
  role,
  ticket,
  reasonText,
  currentPath = "",
  onExecuteAction,
  renderSection,
}: PassTicketTierViewProps) {
  const rules = getPassTicketRulesForRole(
    { role: role ?? "", userId: "" },
    ticket,
  );
  const [note, setNote] = useState("");
  const [pendingId, setPendingId] = useState<string | null>(null);

  // True if any action spec requires a note before submit
  const needsNote = rules.actions.some((a) => a.requiresNote);

  const runAction = async (act: PassActionSpec) => {
    if (!onExecuteAction || !act.apiAction) return;
    setPendingId(act.id);
    try {
      await onExecuteAction(act, note.trim() || undefined);
      if (act.requiresNote) setNote("");
    } finally {
      setPendingId(null);
    }
  };

  return (
    <div
      data-role-tier={rules.tierLabel.split("•")[0].trim().toLowerCase()}
      data-event-mode={rules.mode}
      data-testid="pass-ticket-tier-view"
      className="space-y-4"
    >
      {/* ── Role capability header ─────────────────────────────── */}
      <div
        className={cn(
          "surface-card px-3 py-2.5 space-y-1",
          MODE_CLS[rules.mode],
        )}
      >
        <div className="flex items-center justify-between gap-2 flex-wrap">
          <span className="inline-flex items-center gap-1.5 text-xs font-semibold">
            <ShieldCheck className="h-3.5 w-3.5 shrink-0" />
            {rules.tierLabel}
          </span>
          <span className="bg-surface px-2 py-0.5 font-mono text-[11px] tabular-nums text-text-secondary border-b">
            {ticket.ticketNumber} &middot; {ticket.currentStage} &middot; {ticket.status}
          </span>
        </div>
        <p className="text-xs text-text-primary leading-relaxed">{rules.whyRoleIsHere}</p>
      </div>

      {/* ── Reason / notes with smart references ───────────────── */}
      {reasonText && (
        <div className="border-y p-3 text-xs leading-relaxed bg-surface">
          <span className="font-semibold text-text-secondary mr-1.5 shrink-0">Reason / Ref:</span>
          <SmartTextRef text={reasonText} currentPath={currentPath} />
        </div>
      )}

      {/* ── Tier-filtered content sections ─────────────────────── */}
      <div className="space-y-2">
        {rules.visibleSections.map((sec) =>
          renderSection ? (
            <React.Fragment key={sec}>{renderSection(sec)}</React.Fragment>
          ) : (
            <div
              key={sec}
              className="p-2.5 text-xs text-text-secondary border-b"
            >
              Section:{" "}
              <span className="font-mono font-medium text-text-primary capitalize">
                {sec.replace("-", " ")}
              </span>
            </div>
          ),
        )}
      </div>

      {/* ── Decision / escalation note (when required) ─────────── */}
      {needsNote && onExecuteAction && (
        <div className="space-y-1.5">
          <label className="text-xs font-medium text-text-secondary flex items-center gap-1.5">
            <AlertTriangle className="h-3.5 w-3.5 shrink-0 text-action-warning" />
            Decision Note (required for this action)
          </label>
          <input
            type="text"
            value={note}
            onChange={(e) => setNote(e.target.value)}
            placeholder="Enter reason or remarks..."
            className="w-full rounded-lg border bg-surface px-3 py-2 text-xs placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-action-primary/30"
          />
        </div>
      )}

      {/* ── Action bar (pinned bottom thumb-bar on <md) ────────── */}
      <div
        data-testid="action-bar"
        className="sticky bottom-0 z-10 flex flex-wrap items-center gap-2 border-t border-border bg-bg-surface/95 backdrop-blur-sm py-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] md:static md:border-t-0 md:bg-transparent md:py-0 md:pt-1"
      >
        {rules.actions.map((act) => {
          // External link button
          if (act.tone === "link" && act.href) {
            return (
              <Link
                key={act.id}
                data-testid={`action-${act.id}`}
                href={act.href}
                scroll={false}
                className={cn(
                  "inline-flex items-center gap-1.5 px-3 py-1.5",
                  "text-xs font-medium text-action-primary hover:underline transition-colors",
                )}
              >
                <span>{act.label}</span>
                <ArrowUpRight className="h-3 w-3 text-text-muted" />
              </Link>
            );
          }

          // API-bound button
          const toneClass =
            act.tone === "primary"
              ? "bg-action-primary text-white hover:opacity-90"
              : act.tone === "danger"
              ? "bg-action-danger text-white hover:opacity-90"
              : "border bg-bg-elevated text-text-primary hover:bg-surface";

          return (
            <button
              key={act.id}
              data-testid={`action-${act.id}`}
              type="button"
              disabled={pendingId !== null}
              onClick={() => runAction(act)}
              className={cn(
                "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium",
                "transition-opacity disabled:opacity-50",
                toneClass,
              )}
            >
              <span>{pendingId === act.id ? "Working..." : act.label}</span>
            </button>
          );
        })}
      </div>
    </div>
  );
}
</file>

