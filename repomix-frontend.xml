"use client";

/**
 * WorkerStatusBar — bottom status strip for the Worker console.
 *
 * Renders the compact worker summary:
 *   ● Worker: N tasks · M active · K work-orders · last update HH:MM
 *
 * Counts are passed in from RoleConsole, which derives them from the
 * /api/workers/my-work digest (tasks + active + work-order counts + the
 * last-update proxy). A read-only surface: no KPI cards, no charts.
 */

import { Clock, Loader2, Wrench } from "lucide-react";

export interface WorkerCounts {
  /** Total open work items / tasks from /api/workers/my-work. */
  tasks: number;
  /** Tasks currently in an active stage (non-PENDING open items). */
  active: number;
  /** Open work orders (maintenance tickets) for the caller. */
  workOrders: number;
}

export interface WorkerStatusBarProps {
  counts: WorkerCounts | null;
  /** Timestamp of the last data refresh (ISO). */
  lastScan?: string | null;
  /** Whether a refresh is in progress. */
  refreshing?: boolean;
}

export function WorkerStatusBar({ counts, lastScan, refreshing = false }: WorkerStatusBarProps) {
  const fmt = (iso: string | null | undefined) => {
    if (!iso) return "—";
    try {
      return new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    } catch {
      return "—";
    }
  };

  return (
    <footer
      className="surface-card flex items-center justify-between gap-4 px-4 py-2 bg-bg-surface/95 backdrop-blur-md text-xs text-text-secondary select-none"
      aria-label="Worker status bar"
    >
      {/* Left: task / active / work-order counts */}
      <div className="flex items-center gap-4 min-w-0">
        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span className="size-2 rounded-full bg-action-primary shrink-0" />
          <span className="text-text-muted">Worker</span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span className="text-text-muted">{counts?.tasks ?? 0} tasks</span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span className="text-text-muted">{counts?.active ?? 0} active</span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0">
          <Wrench className="w-3.5 h-3.5 text-text-muted" />
          <span className="text-text-muted">{counts?.workOrders ?? 0} work-orders</span>
        </span>
      </div>

      {/* Right: last updated + refresh indicator */}
      <div className="flex items-center gap-3 shrink-0">
        {refreshing ? (
          <Loader2 className="w-3.5 h-3.5 animate-spin text-text-muted" />
        ) : null}
        {lastScan ? (
          <span className="inline-flex items-center gap-1.5">
            <Clock className="w-3.5 h-3.5 text-text-muted" />
            <span className="text-text-muted">last update</span>
            <span className="font-mono tabular-nums text-text-secondary">
              {fmt(lastScan)}
            </span>
          </span>
        ) : null}
      </div>
    </footer>
  );
}

export default WorkerStatusBar;
</file>

<file path="src/components/bot/BotBoat.tsx">
"use client";
import { memo } from "react";
import { motion } from "framer-motion";

export type Phase = "idle" | "listening" | "thinking" | "speaking";

export const BotBoat = memo(function BotBoat({
  phase = "idle", size = 34,
}: { phase?: Phase; size?: number }) {
  const animate = (() => {
    switch (phase) {
      case "listening": return { y: [0, -2, 0], rotate: [-2, 2, -2] };
      case "thinking":  return { y: [0, -3, 0, -2, 0], rotate: [-5, 5, -5] };
      case "speaking":  return { y: [0, -4, 0, -3, 0], rotate: [-6, 6, -6] };
      default:          return { y: [0, -2.5, 0], rotate: [-3, 3, -3] };
    }
  })();
  const duration = phase === "thinking" ? 1.4 : phase === "speaking" ? 1.0 : 3.4;

  // Theme-aware ink: the boat was hardcoded white (stroke="white" /
  // fill="white"), which disappears on the light / light-blue themes where
  // the button surface is light. --text-primary flips with the theme
  // (near-white on dark themes, near-black on light themes), so the boat
  // is always legible against its own bg-surface circle.
  const ink = "var(--text-primary)";
  const inkDim = "color-mix(in srgb, var(--text-primary) 60%, transparent)";

  return (
    <motion.svg
      width={size} height={size} viewBox="0 0 40 40" fill="none"
      animate={animate}
      transition={{ duration, repeat: Infinity, ease: "easeInOut" }}
      aria-hidden
    >
      <path d="M20 4 L20 24" stroke={ink} strokeWidth="1.8" strokeLinecap="round" />
      <path d="M20 6 L32 21 L20 21 Z" fill={ink} fillOpacity="0.95" />
      <path d="M19 10 L10 21 L19 21 Z" fill={inkDim} />
      <path d="M6 25 H34 L30 33 H10 Z" fill={ink} fillOpacity="0.98" />
      {(phase === "speaking" || phase === "thinking") && (
        <>
          <motion.path
            d="M4 35 Q10 37 16 35 T28 35 T38 34"
            stroke={ink} strokeWidth="1.4" strokeLinecap="round" fill="none" strokeOpacity="0.85"
            animate={{ x: [0, 3, 0], opacity: [0.4, 1, 0.4] }}
            transition={{ duration: 0.9, repeat: Infinity }}
          />
          <motion.path
            d="M2 38 Q9 40 15 38 T27 38 T36 37"
            stroke={ink} strokeWidth="1.2" strokeLinecap="round" fill="none" strokeOpacity="0.55"
            animate={{ x: [0, -3, 0], opacity: [0.3, 0.9, 0.3] }}
            transition={{ duration: 1.2, repeat: Infinity }}
          />
        </>
      )}
    </motion.svg>
  );
});
