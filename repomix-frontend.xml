<file path="src/components/shared/pass/QuotaCard.tsx">
/**
 * shared/pass/QuotaCard — per-quotaKey progress bars.
 * Shows remaining quota for a student (hosteller outpass, etc.).
 *
 * Reads quota usage from /api/student/quota (or falls back to 0 used).
 * Driven by PassTypeConfig.quotaKey / quotaLimit / quotaWindow.
 */

"use client";

import { useEffect, useState } from "react";
import { Gauge, AlertTriangle } from "lucide-react";
import { getAuthHeaders, cn } from "@/lib/utils";
import type { PassTypeConfig } from "@/lib/pass-types";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

export interface QuotaCardProps {
  /** The pass type config to show quota for (must have a quotaKey). */
  config: PassTypeConfig;
  /** Used count for this quota window. If null, component fetches it. */
  used?: number;
  className?: string;
}

export function QuotaCard({ config, used: usedProp, className }: QuotaCardProps) {
  const [used, setUsed] = useState<number | null>(usedProp ?? null);

  useEffect(() => {
    if (usedProp != null) {
      setUsed(usedProp);
      return;
    }
    if (!config.quotaKey) return;
    // Best-effort fetch; degrade to 0 if endpoint absent.
    fetch("/api/student/quota", { headers: getAuthHeaders(), cache: "no-store" })
      .then((r) => (r.ok ? r.json() : null))
      .then((b) => {
        const row = (b?.data ?? []).find(
          (x: { key: string }) => x.key === config.quotaKey
        );
        if (row?.used != null) setUsed(Number(row.used));
      })
      .catch(() => {});
  }, [config.quotaKey, usedProp]);

  if (!config.quotaKey || config.quotaLimit == null) return null;

  const usedNum = used ?? 0;
  const remaining = Math.max(0, config.quotaLimit - usedNum);
  const pct = config.quotaLimit > 0 ? Math.min(100, Math.round((usedNum / config.quotaLimit) * 100)) : 0;
  const nearlyExhausted = remaining === 1;
  const exhausted = remaining === 0;

  const barColor = exhausted
    ? "bg-rose-500"
    : nearlyExhausted
      ? "bg-amber-500"
      : "bg-action-primary";

  return (
    <WidgetBoundary name={`quota-${config.quotaKey}`}>
      <div
        className={cn(
          "rounded-xl border border-border bg-bg-elevated p-4",
          exhausted && "border-rose-500/30",
          className
        )}
      >
        <div className="flex items-center justify-between mb-2">
          <p className="text-xs font-medium text-text-muted flex items-center gap-1.5">
            <Gauge className="h-3.5 w-3.5" />
            {config.quotaKey} quota
          </p>
          <span className="text-[10px] text-text-muted uppercase">{config.quotaWindow}</span>
        </div>

        <div className="flex items-baseline gap-2">
          <span
            className={cn(
              "text-2xl font-bold tabular-nums",
              exhausted ? "text-rose-500" : nearlyExhausted ? "text-amber-500" : "text-text-primary"
            )}
          >
            {remaining}
          </span>
          <span className="text-xs text-text-muted">remaining of {config.quotaLimit}</span>
        </div>

        {/* Progress bar */}
        <div className="mt-2.5 h-1.5 rounded-full bg-bg-surface overflow-hidden">
          <div className={cn("h-full rounded-full transition-all", barColor)} style={{ width: `${pct}%` }} />
        </div>
        <div className="flex justify-between text-[10px] text-text-muted mt-1">
          <span>{usedNum} used</span>
          <span>{pct}%</span>
        </div>

        {exhausted && (
          <p className="mt-2 text-[10px] text-rose-500 flex items-center gap-1">
            <AlertTriangle className="h-3 w-3" /> Quota exhausted — warden can override
          </p>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default QuotaCard;
</file>

<file path="src/components/shared/profile/MyDisputesPanel.tsx">
/**
 * shared/profile/MyDisputesPanel.tsx — every open dispute across all
 * features (attendance, event, meal, pass, document, complaint). This is
 * the ESCALATE step of the Profile Records loop: "my disputes" in one
 * place. Reuses useDisputes.
 */

"use client";

import { ShieldAlert, CheckCircle2, Clock, Loader2, ArrowUpRight } from "lucide-react";
import { cn } from "@/lib/utils";
import { useDisputes, type Dispute } from "@/hooks/useDisputes";

export interface MyDisputesPanelProps {
  /** Only show open disputes (default true). */
  openOnly?: boolean;
  /** Max rows (default 10). */
  limit?: number;
  className?: string;
}

/** Map an entity_type to its owner deep-link. */
const ENTITY_LINK: Record<string, { label: string; href: string }> = {
  attendance: { label: "Attendance", href: "/student/attendance" },
  event: { label: "Event", href: "/student/my-events" },
  meal: { label: "Meal", href: "/student/mess" },
  pass: { label: "Pass", href: "/student/passes" },
  document: { label: "Document", href: "/student/passes" },
  complaint: { label: "Complaint", href: "/student/complaints" },
};

function statusMeta(s: Dispute["status"]) {
  switch (s) {
    case "open":
      return { label: "Open", accent: "text-amber-400", Icon: Clock };
    case "reviewed":
      return { label: "In review", accent: "text-blue-400", Icon: Clock };
    case "resolved":
      return { label: "Resolved", accent: "text-green-400", Icon: CheckCircle2 };
    case "rejected":
      return { label: "Rejected", accent: "text-red-400", Icon: CheckCircle2 };
    default:
      return { label: s, accent: "text-text-muted", Icon: Clock };
  }
}

export function MyDisputesPanel({ openOnly = true, limit = 10, className }: MyDisputesPanelProps) {
  const { disputes, loading } = useDisputes(openOnly ? "open" : undefined);
  const rows = disputes.slice(0, limit);

  if (loading) {
    return (
      <div className={cn("flex items-center gap-2 py-3 text-xs text-text-muted", className)}>
        <Loader2 className="h-4 w-4 animate-spin" />
        Loading disputes…
      </div>
    );
  }

  return (
    <div className={cn("space-y-2", className)}>
      <div className="flex items-center gap-2">
        <ShieldAlert className="h-4 w-4 text-action-primary" />
        <h3 className="text-xs font-semibold text-text-muted uppercase tracking-wider">
          My disputes {openOnly && `(${rows.length} open)`}
        </h3>
      </div>

      {rows.length === 0 && (
        <p className="text-xs text-text-muted">No open disputes. If something was marked wrong, raise one from the feature page.</p>
      )}

      {rows.map((d) => {
        const link = ENTITY_LINK[d.entity_type] ?? { label: d.entity_type, href: "/student" };
        const meta = statusMeta(d.status);
        const Icon = meta.Icon;
        return (
          <div key={d.id} className="surface-card p-3 space-y-1.5">
            <div className="flex items-center justify-between gap-2">
              <div className="flex items-center gap-2 min-w-0">
                <Icon className={cn("h-3.5 w-3.5 shrink-0", meta.accent)} />
                <span className="text-xs font-medium text-text capitalize">{d.entity_type}</span>
                <span className={cn("text-[11px]", meta.accent)}>{meta.label}</span>
              </div>
              <a
                href={link.href}
                className="flex items-center gap-0.5 text-[11px] text-action-primary/80 hover:text-action-primary shrink-0"
              >
                {link.label}
                <ArrowUpRight className="h-3 w-3" />
              </a>
            </div>
            {d.reason && <p className="text-[11px] text-text-muted">{d.reason}</p>}
            <p className="text-[10px] text-text-muted/70">
              {new Date(d.created_at).toLocaleDateString("en-IN", { day: "2-digit", month: "short" })}
              {d.escalated_to ? ` · escalated to ${d.escalated_to}` : ""}
            </p>
          </div>
        );
      })}
    </div>
  );
}

export default MyDisputesPanel;
</file>

<file path="src/components/shared/profile/ProfileShell.tsx">
/**
 * shared/profile/ProfileShell — persona-scoped profile layout.
 *
 * Left: tab rail (persona modules + shared sections).
 * Right: active section content.
 *
 * Replaces the single generic UserProfileTab for students: branches by
 * persona (Commute / Residence / Guardian / Outpass Defaults) plus shared
 * sections that every persona gets.
 */

"use client";

import { useState } from "react";
import { User, FileText, LogOut, Car, Building, Shield, Ticket, Lock, BarChart3 } from "lucide-react";
import { cn } from "@/lib/utils";
import { usePersona } from "@/hooks/usePersona";
import { PersonaBadge } from "@/components/shared/PersonaBadge";
import type { Persona } from "@/lib/pass-types";

export type ProfileTabKey =
  | "overview"
  | "commute"
  | "residence"
  | "guardian"
  | "outpass"
  | "documents"
  | "records"
  | "privacy"
  | "security";

export interface ProfileShellProps {
  /** Which tabs to render. Persona modules are auto-filtered by the active persona. */
  tabs?: ProfileTabKey[];
  activeTab?: ProfileTabKey;
  onTabChange?: (tab: ProfileTabKey) => void;
  /** Render a tab's content. Receives the tab key. */
  renderTab: (tab: ProfileTabKey) => React.ReactNode;
  /** Custom header (defaults to persona badge + overview). */
  header?: React.ReactNode;
  className?: string;
}

const TAB_META: Record<ProfileTabKey, { label: string; icon: React.ElementType; personas?: Persona[] }> = {
  overview: { label: "Overview", icon: User },
  commute: { label: "Commute", icon: Car, personas: ["day_scholar"] },
  residence: { label: "Residence", icon: Building, personas: ["hosteller"] },
  guardian: { label: "Guardian", icon: Shield },
  outpass: { label: "Outpass Defaults", icon: Ticket, personas: ["hosteller"] },
  documents: { label: "Documents", icon: FileText },
  records: { label: "My Records", icon: BarChart3 },
  privacy: { label: "Privacy & Access", icon: Shield },
  security: { label: "Security", icon: Lock },
};

export function ProfileShell({
  tabs,
  activeTab,
  onTabChange,
  renderTab,
  header,
  className,
}: ProfileShellProps) {
  const persona = usePersona();
  const [internalTab, setInternalTab] = useState<ProfileTabKey>("overview");

  // Persona-filter the tabs: only show persona modules this persona owns.
  const visibleTabs: ProfileTabKey[] = (tabs ?? (Object.keys(TAB_META) as ProfileTabKey[]))
    .filter((t) => {
      const meta = TAB_META[t];
      if (!meta.personas) return true; // shared — everyone
      return meta.personas.includes(persona);
    });

  const active = activeTab ?? internalTab;
  const activeKey: ProfileTabKey = visibleTabs.includes(active) ? active : visibleTabs[0] ?? "overview";

  const handleTab = (t: ProfileTabKey) => {
    setInternalTab(t);
    onTabChange?.(t);
  };

  return (
    <div className={cn("grid grid-cols-1 md:grid-cols-[160px_1fr] gap-4", className)}>
      {/* Left rail */}
      <aside className="md:sticky md:top-24 self-start space-y-1">
        <nav className="space-y-0.5">
          {visibleTabs.map((t) => {
            const meta = TAB_META[t];
            const Icon = meta.icon;
            return (
              <button
                key={t}
                type="button"
                onClick={() => handleTab(t)}
                className={cn(
                  "w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium transition",
                  activeKey === t
                    ? "bg-action-primary/10 text-action-primary"
                    : "text-text-secondary hover:bg-bg-elevated"
                )}
              >
                <Icon className="h-4 w-4 shrink-0" />
                {meta.label}
              </button>
            );
          })}
        </nav>
      </aside>

      {/* Right content */}
      <div className="space-y-4 min-w-0">
        {header ?? (
          <div className="flex items-center gap-3">
            <PersonaBadge persona={persona} />
            <div>
              <h2 className="text-base font-bold text-text-primary capitalize">{TAB_META[activeKey].label}</h2>
              <p className="text-xs text-text-muted">persona: {persona}</p>
            </div>
          </div>
        )}
        {renderTab(activeKey)}
      </div>
    </div>
  );
}

export default ProfileShell;
</file>

<file path="src/components/shared/profile/RecordsSection.tsx">
/**
 * shared/profile/RecordsSection.tsx — the "My Records" aggregate view.
 * Ties every feature together into one profile tab: attendance %,
 * passes used, meals attended + avg rating, events, achievements,
 * complaints, documents. With PDF export + share-with-parent.
 *
 * This is the aggregation step: the cross-links from Part 5 resolve
 * here, not in each silo.
 */

"use client";

import { useEffect, useState } from "react";
import { Download, Share2, Loader2 } from "lucide-react";
import { cn } from "@/lib/utils";
import { getAuthHeaders } from "@/lib/utils";
import { MyDisputesPanel } from "@/components/shared/profile/MyDisputesPanel";

interface Records {
  attendance?: { pct: number; period: string };
  passes?: { used: number; total: number; avgApprovalHours: number };
  meals?: { attended: number; total: number; avgRating: number };
  events?: { attended: number; upcoming: number };
  achievements?: { unlocked: number; inProgress: number };
  complaints?: { open: number; resolved: number; avgRating: number };
  documents?: { verified: number; pending: number };
}

export interface RecordsSectionProps {
  /** The records to display. When omitted, the section fetches them. */
  records?: Records;
  /** Period label (default "this month"). */
  periodLabel?: string;
  className?: string;
}

export function RecordsSection({ records: recordsProp, periodLabel = "this month", className }: RecordsSectionProps) {
  const [records, setRecords] = useState<Records>(recordsProp ?? {});
  const [loading, setLoading] = useState(!recordsProp);

  useEffect(() => {
    if (recordsProp) {
      setRecords(recordsProp);
      return;
    }
    let cancelled = false;
    (async () => {
      try {
        const res = await fetch("/api/records/me", { headers: getAuthHeaders() });
        if (!res.ok) return;
        const data = await res.json();
        if (!cancelled && data?.records) setRecords(data.records);
      } catch {
        // graceful degradation
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();
    return () => {
      cancelled = true;
    };
  }, [recordsProp]);

  const exportPdf = async () => {
    const res = await fetch("/api/records/me/export", {
      headers: getAuthHeaders(),
      method: "POST",
      body: JSON.stringify({ format: "pdf" }),
    });
    if (res.ok) {
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "my-records.pdf";
      a.click();
      URL.revokeObjectURL(url);
    }
  };

  if (loading) {
    return (
      <div className={cn("flex items-center gap-2 p-4 text-xs text-text-muted", className)}>
        <Loader2 className="h-4 w-4 animate-spin" />
        Loading your records…
      </div>
    );
  }

  const cards: { label: string; value: string; detail?: string }[] = [];
  if (records.attendance) cards.push({ label: "Attendance", value: `${records.attendance.pct}%`, detail: periodLabel });
  if (records.passes) cards.push({ label: "Passes", value: `${records.passes.used}/${records.passes.total}`, detail: `avg ${records.passes.avgApprovalHours}h approval` });
  if (records.meals) cards.push({ label: "Meals", value: `${records.meals.attended}/${records.meals.total}`, detail: `avg rating ${records.meals.avgRating}` });
  if (records.events) cards.push({ label: "Events", value: String(records.events.attended), detail: `${records.events.upcoming} upcoming` });
  if (records.achievements) cards.push({ label: "Achievements", value: String(records.achievements.unlocked), detail: `${records.achievements.inProgress} in progress` });
  if (records.complaints) cards.push({ label: "Complaints", value: String(records.complaints.open), detail: `${records.complaints.resolved} resolved` });
  if (records.documents) cards.push({ label: "Documents", value: String(records.documents.verified), detail: `${records.documents.pending} pending` });

  return (
    <div className={cn("space-y-3", className)}>
      <div className="flex items-center justify-between">
        <h3 className="text-sm font-semibold text-text">My Records</h3>
        <div className="flex gap-1.5">
          <button
            type="button"
            onClick={exportPdf}
            className="flex items-center gap-1 rounded-lg border border-border px-2.5 py-1 text-[11px] text-text-secondary hover:bg-bg-elevated"
          >
            <Download className="h-3 w-3" />
            PDF
          </button>
          <button
            type="button"
            className="flex items-center gap-1 rounded-lg border border-border px-2.5 py-1 text-[11px] text-text-secondary hover:bg-bg-elevated"
          >
            <Share2 className="h-3 w-3" />
            Share
          </button>
        </div>
      </div>

      {cards.length === 0 ? (
        <p className="text-xs text-text-muted">No records yet for {periodLabel}.</p>
      ) : (
        <div className="grid grid-cols-2 gap-2 sm:grid-cols-3">
          {cards.map((c) => (
