<file path="src/app/(sysadmin)/sysadmin/reports/page.tsx">
"use client";
import { useEffect, useState } from "react";
import { FileText, Download, BarChart3, ClipboardList, Clock } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import type { DashboardData } from "@/lib/types";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface GeneratedReport {
  id: string;
  title: string;
  range: string;
  type: "Daily" | "Weekly" | "Monthly";
  generatedAt: string;
  source: "auto" | "manual";
}

const TYPES: GeneratedReport["type"][] = ["Daily", "Weekly", "Monthly"];




function rangeFor(type: GeneratedReport["type"]): string {
  const t = new Date();
  if (type === "Daily") return t.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
  if (type === "Weekly") {
    const start = new Date(t);
    start.setDate(t.getDate() - 6);
    return `${start.toLocaleDateString("en-IN", { day: "2-digit", month: "short" })} – ${t.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" })}`;
  }
  return t.toLocaleDateString("en-IN", { month: "long", year: "numeric" });
}

function downloadReportCSV(report: GeneratedReport, data: DashboardData | null) {
  if (!data) return;
  const rows: string[] = [
    ["Date", report.range].join(","),
    ["Type", report.type].join(","),
    ["Generated", report.generatedAt].join(","),
  ];
  const dump = () => {
    const blob = new Blob([rows.join("\n")], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = `report-${report.id}.csv`; a.click();
    URL.revokeObjectURL(url);
  };
  dump();
}

/**
 * SysAdmin Reports — ported from the admin console so the root operator can
 * generate and download Daily/Weekly/Monthly campus reports.
 */
export default function SysAdminReportsPage() {
  const [data, setData] = useState<DashboardData | null>(null);
  const [reports, setReports] = useState<GeneratedReport[]>([]);

  useEffect(() => {
    fetch("/api/admin/dashboard", { headers: getAuthHeaders() })
      .then((r) => r.ok ? r.json() : null)
      .then((j) => {
        if (!j) return;
        setData((j.data ?? j) as DashboardData);
      })
      .catch(() => {});
  }, []);

  const generate = (type: GeneratedReport["type"]) => {
    const r: GeneratedReport = {
      id: `${type.toLowerCase()}-${Date.now()}`,
      title: `${type} Campus Report`,
      range: rangeFor(type),
      type,
      generatedAt: new Date().toISOString(),
      source: "manual",
    };
    setReports((prev) => [r, ...prev].slice(0, 20));
    downloadReportCSV(r, data);
  };

  return (
    <AuthGuard allowedRoles={["admin", "sysadmin"]}>
      <div className="space-y-6 p-4 md:p-6">
      <ContextSituationBar
        roleLabel="System Admin"
        purpose="Generate and download campus reports"
        why="Reports generated here reflect the live database state at generation time, not a snapshot."
        contextLabel="Generate and download campus reports"
        statusSummary="Review current generate and download campus reports state and take action below."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "System Health", href: "/sysadmin/health" }}
      />
        <PageHeader title="Reports" subtitle="Generate and download campus reports" />

        <div className="surface-card p-5 space-y-4">
          <div className="flex items-center gap-2">
            <FileText className="w-5 h-5 text-action-primary" />
            <h2 className="text-base font-semibold text-text-primary">Generate report</h2>
          </div>
          <div className="flex flex-wrap gap-2">
            {TYPES.map((t) => (
              <button
                key={t}
                onClick={() => generate(t)}
                className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 text-sm hover:bg-bg-surface/60"
              >
                <BarChart3 className="w-3.5 h-3.5" /> {t}
              </button>
            ))}
          </div>
        </div>

        <div className="surface-card p-5 space-y-3">
          <div className="flex items-center gap-2">
            <ClipboardList className="w-5 h-5 text-action-info" />
            <h2 className="text-base font-semibold text-text-primary">Recent reports</h2>
          </div>
          {reports.length === 0 ? (
            <p className="text-sm text-text-muted">No reports generated this session.</p>
          ) : (
            <ul className="divide-y divide-border">
              {reports.map((r) => (
                <li key={r.id} className="flex items-center justify-between py-2.5 gap-3">
                  <div className="min-w-0">
                    <p className="text-sm font-medium text-text-primary truncate">{r.title}</p>
                    <p className="text-xs text-text-muted flex items-center gap-1.5">
                      <Clock className="size-3.5" /> {r.range} · {new Date(r.generatedAt).toLocaleString("en-IN")}
                    </p>
                  </div>
                  <button
                    onClick={() => downloadReportCSV(r, data)}
                    className="surface-card inline-flex items-center gap-1 text-xs px-2.5 py-1 hover:bg-bg-surface/60"
                  >
                    <Download className="size-3.5" /> CSV
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(sysadmin)/sysadmin/retention-policies/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import { FileText, Clock } from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { SectionCard } from "@/components/admin/shared/SectionCard";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface PolicyRow {
  id: string;
  name: string;
  ttl_days: number | null;
  applies_to: string | null;
  is_active: boolean;
  last_run_at: string | null;
  last_runs?: Array<{ status: string; run_at: string; items_deleted: number }>;
}

/**
 * Sysadmin Retention Policies — data-retention policy list (read-only view).
 * Backend: /api/admin/retention-policies (sysadmin scope; GET-only from UI).
 */
function SysadminRetentionInner() {
  const [rows, setRows] = useState<PolicyRow[]>([]);
  const [loading, setLoading] = useState(true);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const res = await fetch("/api/admin/retention-policies", { headers: getAuthHeaders() });
      const body = await res.json();
      setRows((body?.data ?? []) as PolicyRow[]);
    } catch (e) {
      console.error("retention-policies", e);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  if (loading) {
    return (
      <div className="space-y-4 p-4 md:p-6">
      <ContextSituationBar
        roleLabel="System Admin"
        purpose="Data-retention and de-provisioning policy definitions"
        why="Policies applied here govern when historical records are archived or permanently deleted."
        contextLabel="Data-retention and de-provisioning policy definitions"
        statusSummary="Review current data-retention and de-provisioning policy definitions state and take action below."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "System Health", href: "/sysadmin/health" }}
      />
        <Skeleton className="h-10 w-48" />
        <Skeleton className="h-72 rounded-2xl" />
      </div>
    );
  }

  return (
    <div className="space-y-6 p-4 md:p-6">
      <PageHeader
        title="Retention Policies"
        subtitle="Data-retention and de-provisioning policy definitions"
        onRefresh={load}
      />

      <WidgetBoundary title="Policies">
        <div className="glass-card">
          {rows.length === 0 ? (
            <div className="p-8 text-center">
              <p className="text-sm text-text-muted">No retention policies configured.</p>
            </div>
          ) : (
            <div className="divide-y divide-border">
              {rows.map((r) => (
                <div key={r.id} className="p-4 flex items-start gap-3">
                  <div className="size-6 rounded-xl bg-bg-elevated flex items-center justify-center text-text-secondary shrink-0">
                    <Clock className="w-4 h-4" />
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 flex-wrap">
                      <p className="text-sm font-semibold text-text-primary">{r.name}</p>
                      <span className={`px-2 py-0.5 rounded-full text-xs ${r.is_active ? "bg-emerald-500/15 text-action-success" : "bg-bg-elevated text-text-muted"}`}>
                        {r.is_active ? "Active" : "Inactive"}
                      </span>
                    </div>
                    <p className="text-xs text-text-muted mt-0.5">
                      {r.ttl_days ? `TTL: ${r.ttl_days} days` : "No TTL"}
                      {r.applies_to ? ` · applies to ${r.applies_to}` : ""}
                    </p>
                    {r.last_run_at && (
                      <p className="text-xs text-text-muted mt-1">
                        Last run: {new Date(r.last_run_at).toLocaleString("en-IN", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" })}
                      </p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </WidgetBoundary>

      <WidgetBoundary title="Retention run log">
        <SectionCard
          title="Retention runs"
          description="Recent retention policy execution results"
          icon={FileText}
          iconTone="default"
        >
          <p className="text-sm text-text-secondary">
            Retention runs are executed on the schedule defined in the policy. Each run
            de-provisions or deletes records past their TTL. Run history is recorded in the
            audit log.
          </p>
        </SectionCard>
      </WidgetBoundary>
    </div>
  );
}

export default function SysadminRetentionPoliciesPage() {
  return (
    <AuthGuard allowedRoles={["admin", "sysadmin"]}>
      <SysadminRetentionInner />
    </AuthGuard>
  );
}
