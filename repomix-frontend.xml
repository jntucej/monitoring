<file path="src/components/remotion/GlossyMotionPlayer.tsx">
"use client";

import { useState, useEffect } from "react";
import { Player } from "@remotion/player";
import { useGlass } from "@/context/GlassContext";
import { GlossyGateScanComposition } from "./GlossyGateScanComposition";
import { GlossyHeroComposition } from "./GlossyHeroComposition";

export interface GlossyMotionPlayerProps {
  type?: "scan" | "hero";
  status?: "entry" | "exit" | "idle" | "warning";
  className?: string;
}

export function GlossyMotionPlayer({
  type = "scan",
  status = "entry",
  className = "",
}: GlossyMotionPlayerProps) {
  const { prefersReducedMotion, performanceTier, isTouchDevice, displayMode } = useGlass();
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    setMounted(true);
  }, []);

  const isMobileOrLowFps =
    isTouchDevice ||
    performanceTier === "legacy" ||
    performanceTier === "emergency" ||
    performanceTier === "low" ||
    displayMode === "outdoor" ||
    prefersReducedMotion;

  // Static Lightweight SVG / CSS Fallback for Mobile / Non-Glossy / Low-FPS
  if (!mounted || isMobileOrLowFps) {
    const statusColor =
      status === "entry"
        ? "text-action-success bg-emerald-500/10 border-emerald-500/30"
        : status === "exit"
        ? "text-action-danger bg-rose-500/10 border-rose-500/30"
        : "text-action-warning bg-amber-500/10 border-amber-500/30";

    return (
      <div
        className={`relative w-full h-full min-h35 rounded-2xl border bg-bg-surface/60 p-4 flex flex-col items-center justify-center text-center ${statusColor} ${className}`}
      >
        <div className="size-6 rounded-full border border-current flex items-center justify-center animate-pulse mb-2">
          <div className="size-3.5 rounded-full bg-current" />
        </div>
        <span className="text-xs font-mono font-bold uppercase tracking-wider">
          {type === "scan" ? "Gate Scanner Active" : "Campus Gate System"}
        </span>
      </div>
    );
  }

  const componentToRender =
    type === "scan" ? GlossyGateScanComposition : GlossyHeroComposition;

  return (
    <div className={`relative w-full overflow-hidden rounded-2xl ${className}`}>
      <Player
        component={componentToRender as any}
        inputProps={{ status }}
        durationInFrames={180}
        compositionWidth={400}
        compositionHeight={180}
        fps={30}
        style={{
          width: "100%",
          height: "100%",
        }}
        controls={false}
        autoPlay
        loop
      />
    </div>
  );
}

export default GlossyMotionPlayer;
</file>

<file path="src/components/retention/CampusFeedbackDesk.tsx">
"use client";

import React, { useState, useEffect, useCallback } from "react";
import {
  MessageSquare,
  Clock,
  User,
  CheckCircle,
  AlertTriangle,
  Send,
  Loader2,
} from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import {
  getFeedbackReports,
  submitFeedbackReport,
  type FeedbackReport,
} from "@/lib/retention";

/* ------------------------------------------------------------------ */
/* Lifecycle steps                                                     */
/* ------------------------------------------------------------------ */

const STATUS_STEPS: Array<{ key: FeedbackReport["status"]; label: string }> = [
  { key: "submitted", label: "Submitted" },
  { key: "acknowledged", label: "Acknowledged" },
  { key: "assigned", label: "Assigned" },
  { key: "in_progress", label: "In Progress" },
  { key: "resolved", label: "Resolved" },
  { key: "feedback", label: "Feedback" },
];

const STATUS_ICONS: Record<string, React.ReactNode> = {
  submitted: <Clock className="h-3.5 w-3.5" />,
  acknowledged: <CheckCircle className="h-3.5 w-3.5" />,
  assigned: <User className="h-3.5 w-3.5" />,
  in_progress: <Loader2 className="h-3.5 w-3.5 animate-spin" />,
  resolved: <CheckCircle className="h-3.5 w-3.5" />,
  feedback: <MessageSquare className="h-3.5 w-3.5" />,
};

const STATUS_COLORS: Record<string, string> = {
  submitted: "text-action-warning",
  acknowledged: "text-action-primary",
  assigned: "text-unit-c",
  in_progress: "text-cyan-600",
  resolved: "text-action-success",
  feedback: "text-action-primary",
};

const FEEDBACK_CATEGORIES = [
  "facility_fault",
  "rfid_reader",
  "account_access",
  "hostel_maintenance",
  "admin_request",
  "suggestion",
  "general",
];

function getStepIndex(status: FeedbackReport["status"]): number {
  return STATUS_STEPS.findIndex((s) => s.key === status);
}

/* ------------------------------------------------------------------ */
/* Component                                                           */
/* ------------------------------------------------------------------ */

export function CampusFeedbackDesk() {
  const { user } = useAuthStore();
  const [reports, setReports] = useState<FeedbackReport[]>([]);
  const [loading, setLoading] = useState(true);
  const [showForm, setShowForm] = useState(false);

  // Form state
  const [formCategory, setFormCategory] = useState("general");
  const [formSubject, setFormSubject] = useState("");
  const [formDescription, setFormDescription] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [submitSuccess, setSubmitSuccess] = useState(false);

  const load = useCallback(async () => {
    if (!user) return;
    setLoading(true);
    try {
      const result = await getFeedbackReports();
      if (result.success) {
        setReports(result.data.reports);
      }
    } catch {
      // Silently fail
    } finally {
      setLoading(false);
    }
  }, [user]);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  const handleSubmit = useCallback(async () => {
    if (!user || !formSubject.trim()) return;
    setSubmitting(true);
    try {
      const result = await submitFeedbackReport({
        category: formCategory,
        subject: formSubject.trim(),
        description: formDescription.trim(),
      });
      if (result.success) {
        setFormSubject("");
        setFormDescription("");
        setFormCategory("general");
        setShowForm(false);
        setSubmitSuccess(true);
        setTimeout(() => setSubmitSuccess(false), 3000);
        load();
      }
    } catch {
      // Silently ignore
    } finally {
      setSubmitting(false);
    }
  }, [user, formCategory, formSubject, formDescription, load]);

  return (
    <WidgetBoundary title="Campus Feedback Desk">
      <div className="surface-card bg-bg-elevated/40 p-4 sm:p-5">
        {/* Header */}
        <div className="flex items-center justify-between mb-4 flex-wrap gap-2">
          <div className="flex items-center gap-2">
            <MessageSquare className="h-6 w-6 text-cyan-600" />
            <h3 className="text-sm font-medium text-text-primary">Feedback & Issues</h3>
            <span className="text-xs text-text-muted">
              {reports.length} report(s)
            </span>
          </div>
          <button
            type="button"
            onClick={() => setShowForm(!showForm)}
            className="surface-card flex items-center gap-1.5 bg-cyan-500/10 px-3 py-1.5 text-xs text-cyan-700 hover:bg-cyan-500/20 transition-colors motion-reduce:transition-none"
          >
            <Send className="h-3.5 w-3.5" />
            {showForm ? "Cancel" : "New Report"}
          </button>
        </div>

        {submitSuccess && (
          <div className="surface-card mb-3 bg-emerald-500/10 p-2.5 text-xs text-action-success">
            Report submitted. You&#39;ll see status updates here.
          </div>
        )}

        {/* New Report Form */}
        {showForm && (
          <div className="surface-card mb-4 space-y-3 bg-bg-surface/40 p-4">
            <div>
              <label className="block text-xs text-text-muted mb-1.5" htmlFor="category">Category</label>
              <select id="category"
                value={formCategory}
                onChange={(e) => setFormCategory(e.target.value)}
                className="surface-card w-full bg-bg-elevated/50 px-3 py-2 text-xs text-text-secondary focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
              >
                {FEEDBACK_CATEGORIES.map((c) => (
                  <option key={c} value={c}>
                    {c.replace(/_/g, " ").toUpperCase()}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label className="block text-xs text-text-muted mb-1.5">
                Subject <span className="text-action-danger">*</span>
              </label>
              <input
                type="text"
                value={formSubject}
                onChange={(e) => setFormSubject(e.target.value)}
                placeholder="Brief description of the issue"
                className="surface-card w-full bg-bg-elevated/50 px-3 py-2 text-xs text-text-secondary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
              />
            </div>
            <div>
              <label className="block text-xs text-text-muted mb-1.5" htmlFor="details">Details</label>
              <textarea id="details"
                value={formDescription}
                onChange={(e) => setFormDescription(e.target.value)}
                rows={3}
                placeholder="Additional context (optional)"
                className="surface-card w-full bg-bg-elevated/50 px-3 py-2 text-xs text-text-secondary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-cyan-500/50 resize-none"
              />
            </div>
            <button
              type="button"
              onClick={handleSubmit}
              disabled={!formSubject.trim() || submitting}
              className="surface-card flex items-center gap-1.5 bg-cyan-500/80 px-4 py-2 text-xs font-medium text-white hover:bg-cyan-500 disabled:opacity-40 transition-colors motion-reduce:transition-none"
            >
              {submitting ? (
                <Loader2 className="h-3.5 w-3.5 animate-spin" />
              ) : (
                <Send className="h-3.5 w-3.5" />
              )}
              Submit Report
            </button>
          </div>
        )}

        {/* Reports List */}
        {loading ? (
          <div className="h-6 animate-pulse rounded bg-bg-elevated/20" />
        ) : reports.length === 0 ? (
          <p className="text-xs text-text-muted py-6 text-center">
            No reports yet. Be the first to flag an issue.
          </p>
        ) : (
          <div className="space-y-3 max-h-6 overflow-y-auto">
            {reports.map((report) => {
              const stepIdx = getStepIndex(report.status);
              return (
                <div
                  key={report.id}
                  className="surface-card bg-bg-elevated/30 p-3"
                >
                  {/* Subject + Status Badge */}
                  <div className="flex items-start gap-2">
                    <div
                      className={`mt-0.5 flex h-6 w-6 items-center justify-center rounded-full ${STATUS_COLORS[report.status] ?? ""} bg-bg-elevated/50 shrink-0`}
                    >
                      {STATUS_ICONS[report.status] ?? <AlertTriangle className="h-3.5 w-3.5" />}
                    </div>
                    <div className="flex-1 min-w-2">
                      <p className="text-xs font-medium text-text-secondary truncate">
                        {report.subject}
                      </p>
                      <p className="text-xs text-text-muted capitalize">
                        {report.category.replace(/_/g, " ")}
                      </p>
                    </div>
                    <span
                      className={`shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ${STATUS_COLORS[report.status] ?? "text-text-muted"}`}
                    >
                      {report.status.replace(/_/g, " ").toUpperCase()}
                    </span>
                  </div>

                  {/* Lifecycle Track */}
                  <div className="mt-3 flex items-center gap-0">
                    {STATUS_STEPS.map((step, i) => {
                      const done = i <= stepIdx;
                      const isCurrent = i === stepIdx;
                      return (
                        <React.Fragment key={step.key}>
                          <div className="flex flex-col items-center">
                            <div
                              className={`h-2 w-2 rounded-full ${
                                done
                                  ? "bg-cyan-400"
                                  : "bg-bg-elevated"
                              } ${isCurrent ? "ring-2 ring-cyan-400/40" : ""}`}
                            />
                            <span
                              className={`mt-1 text-xs ${
                                done ? "text-cyan-700" : "text-text-muted"
                              }`}
                            >
                              {step.label}
                            </span>
                          </div>
                          {i < STATUS_STEPS.length - 1 && (
                            <div
                              className={`h-px flex-1 ${
                                i < stepIdx ? "bg-cyan-400/50" : "bg-bg-elevated"
                              }`}
                            />
                          )}
                        </React.Fragment>
                      );
                    })}
                  </div>

                  {/* Follow-through details */}
                  <div className="mt-3 space-y-1.5">
                    {report.assignedTo && (
                      <p className="text-xs text-text-muted flex items-center gap-1">
                        <User className="size-3.5" />
                        Assigned to: <span className="text-text-secondary">{report.assignedTo}</span>
                      </p>
                    )}
                    {report.reviewerNote && (
                      <p className="text-xs text-text-muted flex items-center gap-1">
                        <MessageSquare className="size-3.5" />
                        <span className="line-clamp-2">{report.reviewerNote}</span>
                      </p>
                    )}
                    {report.notes && report.status === "in_progress" && (
                      <p className="text-xs text-text-muted flex items-center gap-1">
                        <Clock className="size-3.5" />
                        <span className="line-clamp-2">{report.notes}</span>
                      </p>
                    )}
                    <p className="text-xs text-text-muted">
                      {new Date(report.createdAt).toLocaleDateString()}
                      {report.resolvedAt
                        ? ` · Resolved ${new Date(report.resolvedAt).toLocaleDateString()}`
                        : ""}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default CampusFeedbackDesk;
</file>

<file path="src/components/retention/CampusKnowledgeCentre.tsx">
"use client";

import React, { useState, useEffect, useCallback, useRef } from "react";
import {
  Search,
  BookOpen,
  AlertTriangle,
  User,
  Clock,
  ChevronDown,
} from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { getAuthHeaders } from "@/lib/utils";
import { getKnowledgeCentre, type KnowledgeDoc } from "@/lib/retention";
import { useIsSakuga } from "@/components/student/useIsSakuga";

/* ------------------------------------------------------------------ */
/* Component                                                           */
/* ------------------------------------------------------------------ */

export function CampusKnowledgeCentre() {
  const isSakuga = useIsSakuga();
  const { user, role } = useAuthStore();
  const [docs, setDocs] = useState<KnowledgeDoc[]>([]);
  const [categories, setCategories] = useState<string[]>([]);
  const [activeCategory, setActiveCategory] = useState<string>("all");
  const [search, setSearch] = useState("");
  const [selectedDoc, setSelectedDoc] = useState<KnowledgeDoc | null>(null);
  const [loading, setLoading] = useState(false);
  const [activeIndex, setActiveIndex] = useState(-1);
  const listRef = useRef<HTMLDivElement>(null);

  const CAN_REPORT = ["admin", "sysadmin", "supervisor", "hostel_manager", "hod", "principal", "vice_principal"].includes(
    role ?? ""
  );

  const load = useCallback(
    async (cat?: string, searchStr?: string) => {
      if (!user) return;
      setLoading(true);
      try {
        const result = await getKnowledgeCentre(cat, searchStr);
        if (result.success) {
          setDocs(result.data.docs);
          setCategories(result.data.categories);
        }
      } catch {
        // Silently fail
      } finally {
        setLoading(false);
      }
    },
    [user]
  );

  useEffect(() => {
    load(activeCategory, search);
  }, [activeCategory, load]); // eslint-disable-line react-hooks/exhaustive-deps

  useEffect(() => {
    const t = setTimeout(() => load(activeCategory, search), 300);
    return () => clearTimeout(t);
  }, [search, activeCategory, load]);  

  const reportOutdated = useCallback(
    async (docId: string) => {
      if (!user || !CAN_REPORT) return;
      try {
        const headers = getAuthHeaders();
        await fetch(
          `/api/campus-extra/knowledge?doc_id=${encodeURIComponent(
            docId
          )}&reason=Reported as outdated`,
          { method: "POST", headers }
        );
        // Refresh
        load(activeCategory);
      } catch {
        // Silently ignore
      }
    },
    [user, CAN_REPORT, activeCategory, load]
  );

  const handleKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActiveIndex((i) => Math.min(i + 1, docs.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActiveIndex((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter" && activeIndex >= 0) {
        e.preventDefault();
        setSelectedDoc(docs[activeIndex]);
      }
    },
    [docs, activeIndex]
  );

  return (
    <WidgetBoundary title="Campus Knowledge Centre">
      <div className="surface-card bg-bg-elevated/40 p-4 sm:p-5">
        {/* Header */}
        <div className="flex items-center gap-2 mb-4">
          <BookOpen className="h-4 w-4 text-action-warning" />
          <h3 className="text-sm font-medium text-text-primary">Knowledge Centre</h3>
          <span className="text-xs text-text-muted ml-auto">
            {docs.length} document(s)
          </span>
        </div>

        {/* Search + Category Filter */}
        <div className="flex flex-col sm:flex-row gap-2 mb-4">
          <div className="flex-1">
            {isSakuga ? (
              <div className="relative">
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-text-muted z-10" />
                <sakuga-input
                  value={search}
                  onValueChange={((v: unknown) => setSearch(String(v ?? ""))) as any}
                  placeholder="Search documents…"
                  label="search"
                  className="w-full pl-9"
                />
              </div>
            ) : (
            <div className="relative">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-text-muted" />
              <input
                type="search"
                placeholder="Search documents…"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                className="surface-card w-full bg-bg-surface/50 py-2 pl-9 pr-3 text-xs text-text-secondary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-indigo-500/50"
                aria-label="Search knowledge documents"
              />
            </div>
            )}
          </div>
          {isSakuga ? (
            <div className="flex gap-1 flex-wrap">
              <button
                type="button"
                onClick={() => setActiveCategory("all")}
                className={`px-2.5 py-1.5 rounded-full text-xs font-medium transition ${activeCategory === "all" ? "bg-action-primary text-white" : "bg-bg-elevated text-text-muted hover:text-text-primary"}`}
              >
                All
              </button>
              {categories.map((c) => (
                <button
                  key={c}
                  type="button"
                  onClick={() => setActiveCategory(c)}
                  className={`px-2.5 py-1.5 rounded-full text-xs font-medium transition ${activeCategory === c ? "bg-action-primary text-white" : "bg-bg-elevated text-text-muted hover:text-text-primary"}`}
                >
                  {c.charAt(0).toUpperCase() + c.slice(1)}
                </button>
              ))}
            </div>
          ) : (
          <select
            value={activeCategory}
            onChange={(e) => setActiveCategory(e.target.value)}
            className="surface-card bg-bg-surface/50 px-3 py-2 text-xs text-text-secondary focus:outline-none focus:ring-1 focus:ring-indigo-500/50"
            aria-label="Filter by category"
          >
            <option value="all">All Categories</option>
            {categories.map((c) => (
              <option key={c} value={c}>
                {c.charAt(0).toUpperCase() + c.slice(1)}
              </option>
            ))}
          </select>
          )}
        </div>

        {/* Document List */}
        {loading ? (
          <div className="h-32 animate-pulse rounded bg-bg-elevated/20" />
        ) : docs.length === 0 ? (
          <p className="text-xs text-text-muted py-8 text-center">
            No documents found. Documents are published by campus administrators.
          </p>
        ) : (
          <div
            ref={listRef}
            onKeyDown={handleKeyDown}
            tabIndex={0}
            className="space-y-2 max-h-80 overflow-y-auto outline-none focus-visible:ring-1 focus-visible:ring-indigo-500/40 rounded"
            role="listbox"
            aria-label="Knowledge documents"
          >
            {docs.map((doc, i) => (
              <button
                key={doc.id}
                type="button"
                role="option"
                aria-selected={i === activeIndex}
                onClick={() => {
                  setActiveIndex(i);
                  setSelectedDoc(doc);
                }}
                className={`w-full text-left rounded-lg border p-3 transition-colors motion-reduce:transition-none ${
                  selectedDoc?.id === doc.id
                    ? "border-indigo-500/50 bg-indigo-500/10"
                    : i === activeIndex
                    ? "border-border/50 bg-bg-elevated/30"
                    : "border-border/40 bg-bg-elevated/30 hover:bg-bg-elevated/20"
                }`}
              >
                <div className="flex items-start gap-2">
                  <div className="flex-1 min-w-0">
                    <p className="text-xs font-medium text-text-secondary truncate">
                      {doc.title}
                    </p>
                    <div className="mt-1 flex flex-wrap items-center gap-2 text-xs text-text-muted">
                      <span className="surface-card bg-bg-elevated/50 px-1.5 py-0.5 capitalize">
                        {doc.category}
                      </span>
                      <span className="flex items-center gap-1">
                        <User className="size-3.5" />
                        {doc.ownerRole}
                      </span>
                      <span className="flex items-center gap-1">
                        <Clock className="size-3.5" />
                        {new Date(doc.updatedAt).toLocaleDateString()}
                      </span>
                      <span>v{doc.version}</span>
                    </div>
                  </div>
                  <ChevronDown className="h-4 w-4 text-text-muted shrink-0 mt-0.5" />
                </div>

                {selectedDoc?.id === doc.id && (
                  <div className="mt-2 text-xs text-text-muted whitespace-pre-line line-clamp-4">
                    {doc.body}
                  </div>
                )}

                {selectedDoc?.id === doc.id && CAN_REPORT && (
                  <div className="mt-2">
                    <button
                      type="button"
                      onClick={(e) => {
                        e.stopPropagation();
                        reportOutdated(doc.id);
                      }}
                      className="surface-card flex items-center gap-1.5 bg-rose-500/10 px-2 py-1 text-xs text-action-danger hover:bg-rose-500/20 transition-colors motion-reduce:transition-none"
                    >
                      <AlertTriangle className="size-3.5" />
                      Report as outdated
                    </button>
                  </div>
                )}
              </button>
            ))}
          </div>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default CampusKnowledgeCentre;
</file>

