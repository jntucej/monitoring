<file path="src/components/shared/PasswordRules.tsx">
"use client";
// M3 — Live password rule checklist. Pass the target user's role and the
// in-progress password; renders which role-specific rules pass or fail.
import { policyFor } from "@/lib/password-policy";

export function PasswordRules({
  role,
  password,
  context,
}: {
  role: string;
  password: string;
  context?: { email?: string; name?: string };
}) {
  const p = policyFor(role);

  const rules: { label: string; ok: boolean }[] = [
    { label: `At least ${p.minLength} characters`, ok: password.length >= p.minLength },
    { label: "An uppercase letter", ok: !p.requireUpper || /[A-Z]/.test(password) },
    { label: "A lowercase letter", ok: !p.requireLower || /[a-z]/.test(password) },
    { label: "A digit", ok: !p.requireDigit || /[0-9]/.test(password) },
    { label: "A symbol", ok: !p.requireSpecial || /[^A-Za-z0-9]/.test(password) },
  ];

  // Blocklist / PII checks (mirrors server-side validatePassword).
  if (password) {
    const lower = password.toLowerCase();
    if (context?.email) {
      const local = context.email.split("@")[0].toLowerCase();
      if (local.length >= 4 && lower.includes(local)) {
        rules.push({ label: "Must not contain your email", ok: false });
      }
    }
    if (context?.name) {
      for (const token of context.name.toLowerCase().split(/\s+/)) {
        if (token.length >= 4 && lower.includes(token)) {
          rules.push({ label: "Must not contain your name", ok: false });
          break;
        }
      }
    }
  }

  return (
    <ul className="mt-2 space-y-1 text-xs">
      {rules.map((r) => (
        <li
          key={r.label}
          className={
            "flex items-center gap-1 " +
            (r.ok ? "text-emerald-400" : "text-rose-400")
          }
        >
          <span aria-hidden>{r.ok ? "✓" : "✗"}</span>
          {r.label}
        </li>
      ))}
    </ul>
  );
}
</file>

<file path="src/components/shared/PeriodPicker.tsx">
/**
 * PeriodPicker — segmented control + optional custom date-range input.
 * Controlled component; lift state to the parent via `usePeriod`.
 */
"use client";

import React, { useCallback, useState } from "react";
import { Calendar, ChevronDown } from "lucide-react";
import { cn } from "@/lib/utils";
import { PERIOD_OPTIONS, getPeriod, type Period, type PeriodKey } from "@/lib/period";

export interface PeriodPickerProps {
  value: Period;
  onChange: (period: Period) => void;
  className?: string;
  /** Show custom date inputs when key === "custom". Default true. */
  allowCustom?: boolean;
}

export function PeriodPicker({ value, onChange, className, allowCustom = true }: PeriodPickerProps) {
  const [open, setOpen] = useState(false);

  const select = useCallback(
    (key: PeriodKey) => {
      if (key === "custom") {
        onChange({ key, from: value.from, to: value.to, label: "Custom" });
        setOpen(false);
        return;
      }
      onChange(getPeriod(key));
      setOpen(false);
    },
    [onChange, value]
  );

  const customFrom = value.key === "custom" ? value.from.slice(0, 10) : "";
  const customTo = value.key === "custom" ? value.to.slice(0, 10) : "";

  const handleCustomFrom = (v: string) => {
    if (!v) return;
    onChange({ key: "custom", from: new Date(v + "T00:00:00").toISOString(), to: value.to, label: "Custom" });
  };
  const handleCustomTo = (v: string) => {
    if (!v) return;
    onChange({ key: "custom", from: value.from, to: new Date(v + "T23:59:59.999Z").toISOString(), label: "Custom" });
  };

  return (
    <div className={cn("inline-flex items-center gap-1", className)}>
      {/* Segmented buttons for common periods */}
      <div className="surface-card inline-flex rounded-lg p-0.5 gap-0.5">
        {PERIOD_OPTIONS.map(({ key, label }) => (
          <button
            key={key}
            type="button"
            onClick={() => select(key)}
            className={cn(
              "rounded-md px-2.5 py-1 text-xs font-medium transition-colors",
              value.key === key
                ? "bg-action-primary text-white"
                : "text-text-secondary hover:bg-bg-elevated"
            )}
          >
            {label}
          </button>
        ))}
      </div>

      {/* Custom date inputs */}
      {allowCustom && value.key === "custom" && (
        <div className="inline-flex items-center gap-1.5">
          <input
            type="date"
            value={customFrom}
            onChange={(e) => handleCustomFrom(e.target.value)}
            className="surface-card rounded-md px-2 py-1 text-xs bg-bg-elevated w-[8.5rem]"
            aria-label="From date"
          />
          <span className="text-xs text-text-muted">–</span>
          <input
            type="date"
            value={customTo}
            onChange={(e) => handleCustomTo(e.target.value)}
            className="surface-card rounded-md px-2 py-1 text-xs bg-bg-elevated w-[8.5rem]"
            aria-label="To date"
          />
        </div>
      )}
    </div>
  );
}

export default PeriodPicker;
</file>

