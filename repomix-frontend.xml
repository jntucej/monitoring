"use client";

/**
 * EventCard — a single campus event with a Register button.
 * Registration calls POST /api/campus/events/[id]/register (idempotent,
 * authenticated-only) and reflects the resulting state locally.
 */
import { useState } from "react";
import {
  CalendarDays,
  MapPin,
  Users,
  CheckCircle2,
  Loader2,
  ArrowRight,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import type { CampusEvent } from "@/lib/engagement";

type RegistrationState = "idle" | "pending" | "registered" | "error";

function formatEventWhen(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleString(undefined, {
    weekday: "short",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

export function EventCard({
  event,
  onChanged,
}: {
  event: CampusEvent;
  onChanged?: () => void;
}) {
  const [state, setState] = useState<RegistrationState>(
    event.isRegistered ? "registered" : "idle"
  );
  const [message, setMessage] = useState<string | null>(null);

  const isFull =
    event.capacity !== null &&
    event.capacity >= 0 &&
    event.registrations >= event.capacity;

  async function handleRegister() {
    if (state === "pending" || state === "registered") return;
    setState("pending");
    setMessage(null);
    try {
      const res = await fetch(
        `/api/campus/events/${encodeURIComponent(event.id)}/register`,
        {
          method: "POST",
          headers: getAuthHeaders(),
          cache: "no-store",
        }
      );
      const json = await res.json().catch(() => null);
      if (!res.ok || !json?.success) {
        throw new Error(
          (json?.error as { code?: string; message?: string } | undefined)
            ?.message ?? `Registration failed (${res.status})`
        );
      }
      setState("registered");
      setMessage(
        json.data.status === "already_registered"
          ? "You were already registered for this event."
          : "You're registered — see you there!"
      );
      onChanged?.();
    } catch (e) {
      setState("error");
      setMessage(e instanceof Error ? e.message : "Registration failed");
    }
  }

  const button = (() => {
    switch (state) {
      case "registered":
        return (
          <button
            type="button"
            disabled
            className="surface-card inline-flex w-full items-center justify-center gap-1.5 bg-emerald-500/15 px-3 py-2 text-xs font-semibold text-action-success motion-safe:transition-colors motion-reduce:transition-none disabled:cursor-default"
          >
            <CheckCircle2 className="h-3.5 w-3.5" aria-hidden />
            Registered
          </button>
        );
      case "pending":
        return (
          <button
            type="button"
            disabled
            className="surface-card inline-flex w-full items-center justify-center gap-1.5 bg-[var(--bg-raised)] px-3 py-2 text-xs font-semibold text-text-muted motion-reduce:transition-none"
          >
            <Loader2 className="h-3.5 w-3.5 animate-spin motion-reduce:animate-none" aria-hidden />
            Registering…
          </button>
        );
      case "error":
        return (
          <button
            type="button"
            onClick={() => void handleRegister()}
            className="surface-card inline-flex w-full items-center justify-center gap-1.5 bg-rose-500/10 px-3 py-2 text-xs font-semibold text-action-danger motion-safe:transition-colors motion-reduce:transition-none"
          >
            <ArrowRight className="h-3.5 w-3.5" aria-hidden />
            Retry registration
          </button>
        );
      default:
        return (
          <button
            type="button"
            disabled={isFull}
            onClick={() => void handleRegister()}
            className={`inline-flex w-full items-center justify-center gap-1.5 rounded-lg px-3 py-2 text-xs font-semibold motion-safe:transition-colors motion-reduce:transition-none ${
              isFull
                ? "cursor-not-allowed border border-border bg-[var(--bg-raised)] text-text-muted opacity-60"
                : "border border-indigo-500/40 bg-indigo-500/20 text-indigo-300 hover:bg-indigo-500/30"
            }`}
          >
            {isFull ? "Event full" : "Register"}
            {!isFull && <ArrowRight className="h-3.5 w-3.5" aria-hidden />}
          </button>
        );
    }
  })();

  return (
    <article
      aria-label={`Campus event: ${event.title}`}
      className="surface-card flex flex-col bg-bg-surface p-4 min-w-0"
    >
      <div className="flex items-start justify-between gap-2">
        <div className="flex min-w-0 items-center gap-2">
          <div className="flex size-6 shrink-0 items-center justify-center rounded-lg bg-sky-500/15 text-action-info">
            <CalendarDays className="h-4 w-4" aria-hidden />
          </div>
          <div className="min-w-0">
            <h3 className="truncate text-sm font-bold text-text-primary">
              {event.title}
            </h3>
            <p className="text-xs uppercase tracking-wide text-text-muted">
              {event.category}
            </p>
          </div>
        </div>
        {event.registrationStatus === "attended" && (
          <span className="surface-card bg-emerald-500/15 px-2 py-0.5 text-xs font-medium text-action-success">
            Attended
          </span>
        )}
      </div>

      {event.description && (
        <p className="mt-2 line-clamp-2 text-xs text-text-muted">
          {event.description}
        </p>
      )}

      <div className="mt-3 space-y-1.5 text-xs text-text-muted">
        <p className="flex items-center gap-1.5">
          <CalendarDays className="h-3.5 w-3.5 shrink-0" aria-hidden />
          {formatEventWhen(event.startsAt)}
        </p>
        {event.location && (
          <p className="flex items-center gap-1.5">
            <MapPin className="h-3.5 w-3.5 shrink-0" aria-hidden />
            {event.location}
          </p>
        )}
        <p className="flex items-center gap-1.5">
          <Users className="h-3.5 w-3.5 shrink-0" aria-hidden />
          {event.registrations} registered
          {event.capacity !== null && event.capacity >= 0
            ? ` of ${event.capacity}`
            : ""}
        </p>
      </div>

      <div className="mt-4 pt-1">
        {button}
        {message && (
          <p
            className={`mt-2 text-center text-xs ${
              state === "error" ? "text-action-danger" : "text-text-muted"
            }`}
            role={state === "error" ? "alert" : "status"}
          >
            {message}
          </p>
        )}
      </div>
    </article>
  );
}
</file>

<file path="src/components/engagement/EventsPanel.tsx">
"use client";

/**
 * Events & Registration panel — grid of upcoming campus events.
 * Data comes from /api/campus/events (real rows); each card is an
 * EventCard with a working, idempotent Register button.
 */
import { useCallback, useEffect, useState } from "react";
import { CalendarDays, Loader2, Inbox } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { EventCard } from "./EventCard";
import type { CampusEvent } from "@/lib/engagement";

export function EventsPanel({ limit = 12 }: { limit?: number }) {
  const [events, setEvents] = useState<CampusEvent[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    try {
      setLoading(true);
      const res = await fetch("/api/campus/events", {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const json = await res.json().catch(() => null);
      if (!res.ok || !json?.success) {
        throw new Error(json?.error?.message ?? "Failed to load events");
      }
      setEvents(json.data.events ?? []);
      setError(null);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load events");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void load();
  }, [load]);

  const shown = events.slice(0, limit);

  return (
    <WidgetBoundary title="Campus Events">
      <section aria-label="Campus events" className="surface-card bg-bg-surface p-5 min-w-0">
        <div className="flex items-center justify-between gap-3">
          <h2 className="flex items-center gap-2 text-sm font-bold text-text-primary">
            <CalendarDays className="h-4 w-4 text-action-info" aria-hidden />
            Campus Events
          </h2>
          <button
            type="button"
            onClick={() => void load()}
            className="surface-card px-2 py-1 text-xs font-medium text-text-muted hover:text-text-primary motion-safe:transition-colors motion-reduce:transition-none"
            aria-label="Refresh events"
          >
            Refresh
          </button>
        </div>

        {loading && events.length === 0 ? (
          <div className="mt-8 flex items-center justify-center gap-2 py-8 text-sm text-text-muted" role="status">
            <Loader2 className="h-4 w-4 animate-spin motion-reduce:animate-none" aria-hidden />
            Loading events…
          </div>
        ) : error && events.length === 0 ? (
          <div className="surface-card mt-6 bg-rose-500/10 p-3 text-sm text-rose-600">
            {error}
          </div>
        ) : shown.length === 0 ? (
          <div className="mt-6 flex flex-col items-center gap-2 py-8 text-center text-text-muted">
            <Inbox className="h-6 w-6 opacity-50" aria-hidden />
            <p className="text-sm">No upcoming campus events.</p>
          </div>
        ) : (
          <div className="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {shown.map((event) => (
              <EventCard
                key={event.id}
                event={event}
                onChanged={() => {
                  // Optimistic count bump so sibling cards stay honest
                  // without a full refetch.
                  setEvents((prev) =>
                    prev.map((e) =>
                      e.id === event.id
                        ? {
                            ...e,
                            isRegistered: true,
                            registrationStatus: "registered",
                            registrations: Math.min(
                              e.capacity ?? Number.MAX_SAFE_INTEGER,
                              e.registrations + 1
                            ),
                          }
                        : e
                    )
                  );
                }}
              />
            ))}
          </div>
        )}
        {events.length > limit ? (
          <p className="mt-3 text-center text-xs text-text-muted">
            Showing {shown.length} of {events.length} events
          </p>
        ) : null}
      </section>
    </WidgetBoundary>
  );
}
