<file path="src/components/sysadmin/kit/viz/CalendarHeatmap.tsx">
"use client";
import { useMemo } from "react";
import { cn } from "@/lib/utils";
import type { CalendarDay, CalendarHeatmapProps } from "./types";
import { heatColor, clamp01, VIZ_THEME } from "./theme";

const CELL = 12;
const GAP = 3;
const DAY_LABELS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

function parseDate(s: string): Date {
  // Parse as local date (avoid TZ shift from Date.UTC).
  const [y, m, d] = s.split("-").map(Number);
  return new Date(y, m - 1, d);
}

function isoWeekday(d: Date): number {
  // Sunday = 0 … Saturday = 6 (matches getDay()).
  return d.getDay();
}

/** GitHub-style contribution calendar. Days are laid out on a Sunday-aligned
 *  week grid; each cell's fill = heatColor(value/max), zero = faint gray. */
export function CalendarHeatmap({ days, weeks, label, onDayClick, className }: CalendarHeatmapProps) {
  const max = useMemo(
    () => days.reduce((m, d) => Math.max(m, d.value), 0),
    [days],
  );

  // Build the Sunday-aligned grid. The first week starts on the Sunday on or
  // before the earliest day; columns advance weekly.
  const grid = useMemo(() => {
    const byDate = new Map<string, CalendarDay>();
    days.forEach((d) => byDate.set(d.date, d));

    const start = parseDate(days[0].date);
    if (days.length > 0) {
      const wd = isoWeekday(start);
      start.setDate(start.getDate() - wd); // back to Sunday
    }
    const weekCount = weeks ?? Math.max(1, Math.ceil(days.length / 7));
    const weeksArr: { week: number; cells: { key: string; day?: CalendarDay }[] }[] = [];
    for (let w = 0; w < weekCount; w++) {
      const cells: { key: string; day?: CalendarDay }[] = [];
      for (let dow = 0; dow < 7; dow++) {
        const cur = new Date(start);
        cur.setDate(start.getDate() + w * 7 + dow);
        const key = `${cur.getFullYear()}-${String(cur.getMonth() + 1).padStart(2, "0")}-${String(cur.getDate()).padStart(2, "0")}`;
        cells.push({ key, day: byDate.get(key) });
      }
      weeksArr.push({ week: w, cells });
    }
    return weeksArr;
  }, [days, weeks]);

  const svgH = (7 * (CELL + GAP) + GAP).toFixed(0);
  const widthLabelX = 26;
  const gridW = grid.length * (CELL + GAP) + GAP;
  const svgW = widthLabelX + gridW + 6;

  return (
    <div className={cn("w-full", className)}>
      <div className="mb-2 text-xs font-medium" style={{ color: VIZ_THEME.muted }}>
        {label}
      </div>
      <svg
        role="img"
        aria-label={`${label}: ${days.length} days of activity`}
        viewBox={`0 0 ${svgW} ${svgH}`}
        width="100%"
        height={Number(svgH)}
        preserveAspectRatio="xMinYMid meet"
        className="overflow-visible"
      >
        {/* day-of-week labels */}
        {DAY_LABELS.map((lbl, i) =>
          i % 2 === 0 ? (
            <text
              key={lbl}
              x={0}
              y={i * (CELL + GAP) + 8}
              fontSize={9}
              fill={VIZ_THEME.muted}
            >
              {lbl}
            </text>
          ) : null,
        )}
        {grid.map(({ week, cells }) =>
          cells.map(({ key, day }) => {
            const value = day?.value;
            const x = widthLabelX + week * (CELL + GAP);
            const y = isoWeekday(parseDate(key)) * (CELL + GAP);
            const fill =
              value == null
                ? "transparent"
                : value === 0
                  ? "var(--text-muted)"
                  : heatColor(max > 0 ? clamp01(value / max) : 0);
            const fillOpacity = value === 0 ? 0.25 : 1;
            const interactive = day != null && !!onDayClick;
            return (
              <g
                key={key}
                onClick={() => day && onDayClick?.(day.date, day.value)}
                style={{ cursor: interactive ? "pointer" : "default" }}
                role={interactive ? "button" : "img"}
                aria-label={day ? `${day.date}: ${day.value}` : `${key}: no data`}
                tabIndex={interactive ? 0 : -1}
                onKeyDown={(ev) => ev.key === "Enter" && day && onDayClick?.(day.date, day.value)}
              >
                <rect
                  x={x}
                  y={y}
                  width={CELL}
                  height={CELL}
                  rx={2.5}
                  fill={fill}
                  fillOpacity={fillOpacity}
                  stroke="var(--border)"
                  strokeWidth={0.5}
                >
                  <title>{day ? `${day.date} · ${day.value}` : key}</title>
                </rect>
              </g>
            );
          }),
        )}
      </svg>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/kit/viz/ChainDots.tsx">
"use client";
import { useMemo } from "react";
import { cn } from "@/lib/utils";
import type { ChainDotsProps } from "./types";
import { statusColor, VIZ_THEME } from "./theme";

const DOT_R = 8;
const CONNECTOR_W = 2;

/** Horizontal stepper: ●─●─●. Each stage is a colored dot with label/meta.
 *  done → action-primary, active → action-warning (with a subtle glow),
 *  pending → border. Connector lines join consecutive dots. */
export function ChainDots({ stages, label, onStageClick, className }: ChainDotsProps) {
  const W = 640;
  const H = 64;

  // Distribute dots evenly across the width.
  const n = stages.length;
  const dotXs = useMemo(() => {
    if (n === 0) return [] as number[];
    if (n === 1) return [W / 2];
    const pad = DOT_R * 2 + 20;
    const step = (W - pad * 2) / (n - 1);
    return stages.map((_, i) => pad + i * step);
  }, [n]);

  const dotColor = (s: (typeof stages)[number]) => {
    switch (s.status) {
      case "done":
        return statusColor("ok");
      case "active":
        return statusColor("warn");
      case "pending":
        return VIZ_THEME.border;
      default:
        return VIZ_THEME.neutral;
    }
  };

  return (
    <div className={cn("w-full", className)}>
      <div className="mb-2 text-xs font-medium" style={{ color: VIZ_THEME.muted }}>
        {label}
      </div>
      <svg
        role="img"
        aria-label={`${label}: ${stages
          .map((s) => s.label)
          .join(" → ")}`}
        viewBox={`0 0 ${W} ${H}`}
        width="100%"
        height={H}
        className="overflow-visible"
      >
        {/* connector lines between consecutive dots */}
        {stages.slice(0, -1).map((s, i) => {
          const x1 = dotXs[i];
          const x2 = dotXs[i + 1];
          const y = H / 2 - 8; // center dots vertically a bit higher
          // A connector is "filled" when the preceding stage is done.
          const filled = s.status === "done";
          return (
            <line
              key={`conn-${i}`}
              x1={x1 + DOT_R + 4}
              y1={y}
              x2={x2 - DOT_R - 4}
              y2={y}
              stroke={filled ? statusColor("ok") : VIZ_THEME.border}
              strokeOpacity={filled ? 0.7 : 0.4}
              strokeWidth={CONNECTOR_W}
            />
          );
        })}

        {/* dots */}
        {stages.map((s, i) => {
          const cx = dotXs[i];
          const cy = H / 2 - 8;
          const c = dotColor(s);
          const glow = s.status === "active";
          const interactive = !!onStageClick;
          return (
            <g
              key={s.id}
              transform={`translate(${cx} ${cy})`}
              onClick={() => onStageClick?.(s.id)}
              style={{ cursor: interactive ? "pointer" : "default" }}
              role={interactive ? "button" : "img"}
              aria-label={`${s.label} — ${s.status}${s.meta ? `, ${s.meta}` : ""}`}
              tabIndex={interactive ? 0 : -1}
              onKeyDown={(ev) => ev.key === "Enter" && onStageClick?.(s.id)}
            >
              {glow && <circle r={DOT_R + 6} fill={c} fillOpacity={0.18} />}
              <circle
                r={DOT_R}
                fill={s.status === "pending" ? VIZ_THEME.surface : c}
                stroke={c}
                strokeWidth={2}
              />
              {s.status === "done" && (
                <path
                  d="M -3.5 0.5 L -1 3 L 4 -3"
                  fill="none"
                  stroke="var(--bg-surface)"
                  strokeWidth={2}
                  strokeLinecap="round"
                  strokeLinejoin="round"
                />
              )}
              <text y={DOT_R + 12} textAnchor="middle" fontSize={11} fill={VIZ_THEME.text}>
                {s.label}
              </text>
              {s.meta && (
                <text y={DOT_R + 24} textAnchor="middle" fontSize={9} fill={VIZ_THEME.muted}>
                  {s.meta}
                </text>
              )}
            </g>
          );
        })}
      </svg>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/kit/viz/FlowMap.tsx">
"use client";
import { useMemo } from "react";
import { cn } from "@/lib/utils";
import type { FlowMapProps, FlowNode } from "./types";
import { statusColor, VIZ_THEME } from "./theme";

const DEFAULT_W = 640;
const NODE_R = 16;

export function FlowMap({ nodes, edges, height = 220, onNodeClick, className }: FlowMapProps) {
  const W = DEFAULT_W;
  const H = height;
  // Auto-layout: nodes without explicit x/y are placed left→right in input order.
  const positions = useMemo(() => {
    const map: Record<string, { x: number; y: number }> = {};
    const num = (v: unknown): number | null =>
      typeof v === "number" && Number.isFinite(v) ? v : null;
    const auto = nodes.filter((n) => num(n.x) == null || num(n.y) == null);
    const explicit = nodes.filter((n) => num(n.x) != null && num(n.y) != null);
    explicit.forEach((n) => (map[n.id] = { x: num(n.x)! * W, y: num(n.y)! * H }));
    const pad = 60;
    auto.forEach((n, i) => {
      void n;
      const step = auto.length > 1 ? (W - pad * 2) / (auto.length - 1) : 0;
      map[auto[i].id] = { x: pad + i * step, y: H / 2 };
    });
    return map;
  }, [nodes, W, H]);

  const nodeById = useMemo(() => {
    const m: Record<string, FlowNode> = {};
    nodes.forEach((n) => (m[n.id] = n));
    return m;
  }, [nodes]);
  void nodeById;

  return (
    <svg
      role="img"
      aria-label={`Service topology, ${nodes.length} services, ${edges.length} connections`}
      viewBox={`0 0 ${W} ${H}`}
      width="100%"
      height={H}
      className={cn("overflow-visible", className)}
    >
      <defs>
        <marker id="flow-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill={VIZ_THEME.border} />
        </marker>
      </defs>
      {/* edges */}
      {edges.map((e, i) => {
        const a = positions[e.from];
        const b = positions[e.to];
        if (!a || !b) return null;
        const stroke = statusColor(e.status ?? "neutral");
        const traffic = e.traffic ?? 0.5;
        const dur = `${Math.max(0.8, 2.2 - traffic * 1.5)}s`;
        const d = Number.isFinite(a.x) && Number.isFinite(b.x) 
          ? `M ${a.x + NODE_R} ${a.y} C ${a.x + (b.x - a.x) / 2} ${a.y}, ${b.x - (b.x - a.x) / 2} ${b.y}, ${b.x - NODE_R} ${b.y}`
          : "M 0 0 L 0 0";
        return (
          <g key={`${e.from}-${e.to}-${i}`}>
            <path d={d} fill="none" stroke={stroke} strokeOpacity={0.25} strokeWidth={2} />
            <path
              d={d}
              fill="none"
              stroke={stroke}
              strokeWidth={2}
              strokeDasharray="4 8"
              markerEnd="url(#flow-arrow)"
            >
              <animate attributeName="stroke-dashoffset" from="0" to="-24" dur={dur} repeatCount="indefinite" />
            </path>
            {e.latencyMs != null && (
              <text x={(a.x + b.x) / 2} y={(a.y + b.y) / 2 - 6} textAnchor="middle" fontSize={10} fill={VIZ_THEME.muted}>
                {e.latencyMs}ms
              </text>
            )}
          </g>
        );
      })}
      {/* nodes */}
      {nodes.map((n) => {
        const p = positions[n.id];
        if (!p) return null;
        const c = statusColor(n.status);
        return (
          <g
            key={n.id}
            transform={`translate(${p.x} ${p.y})`}
            onClick={() => onNodeClick?.(n.id)}
            style={{ cursor: onNodeClick ? "pointer" : "default" }}
            role={onNodeClick ? "button" : "img"}
            aria-label={`${n.label} — ${n.status}`}
            tabIndex={onNodeClick ? 0 : -1}
            onKeyDown={(ev) => ev.key === "Enter" && onNodeClick?.(n.id)}
          >
            <circle r={NODE_R + 6} fill={c} fillOpacity={0.15} />
            <circle r={NODE_R} fill={VIZ_THEME.surface} stroke={c} strokeWidth={2} />
            <circle r={4} fill={c} />
            <text y={NODE_R + 18} textAnchor="middle" fontSize={11} fill={VIZ_THEME.text}>
              {n.label}
            </text>
            {n.meta && (
              <text y={NODE_R + 32} textAnchor="middle" fontSize={9} fill={VIZ_THEME.muted}>
                {n.meta}
              </text>
            )}
          </g>
        );
      })}
    </svg>
  );
}
</file>

<file path="src/components/sysadmin/kit/viz/GeoMap.tsx">
"use client";
import { useMemo } from "react";
import { cn } from "@/lib/utils";
import type { GeoGate, GeoMapProps } from "./types";
import { statusColor, VIZ_THEME } from "./theme";

const DEFAULT_W = 640;

// Earth radius in meters → approx px scale for radiusMeters.
// 1 degree of latitude ≈ 111,000 m (111000 m/deg).
const M_PER_DEG = 111_000;

/** SVG "campus map": a subtle lat/lng grid with each gate drawn as an outer
 *  radius circle (radiusMeters → px via 111000 m/deg) around a center dot and
 *  label. Status drives the color. */
export function GeoMap({ gates, bounds, height = 360, onGateClick, className }: GeoMapProps) {
  const W = DEFAULT_W;
  const H = height;

  const computedBounds = useMemo(() => {
    if (bounds) return bounds;
    if (gates.length === 0) return { minLat: -1, maxLat: 1, minLng: -1, maxLng: 1 };
    let minLat = Infinity,
      maxLat = -Infinity,
      minLng = Infinity,
      maxLng = -Infinity;
    gates.forEach((g) => {
      minLat = Math.min(minLat, g.lat);
      maxLat = Math.max(maxLat, g.lat);
      minLng = Math.min(minLng, g.lng);
      maxLng = Math.max(maxLng, g.lng);
    });
    // pad by ~15% so radius circles near the edge don't clip
    const latPad = (maxLat - minLat || 0.001) * 0.2;
    const lngPad = (maxLng - minLng || 0.001) * 0.2;
    return {
      minLat: minLat - latPad,
      maxLat: maxLat + latPad,
      minLng: minLng - lngPad,
      maxLng: maxLng + lngPad,
    };
  }, [bounds, gates]);

  const latSpan = computedBounds.maxLat - computedBounds.minLat;
  const lngSpan = computedBounds.maxLng - computedBounds.minLng;

  // px-per-meter at this latitude (deg → px, meters per degree is M_PER_DEG)
  const pxPerMeter = W / (lngSpan * M_PER_DEG);

  const toX = (lng: number) => ((lng - computedBounds.minLng) / lngSpan) * W;
  const toY = (lat: number) => H - ((lat - computedBounds.minLat) / latSpan) * H;

  // Subtle grid: one vertical line every ~1/8 of the width, one horizontal
  // every ~1/8 of the height.
  const gridLines = useMemo(() => {
    const v: { x: number }[] = [];
    const h: { y: number }[] = [];
    for (let i = 0; i <= 8; i++) {
      v.push({ x: (i / 8) * W });
      h.push({ y: (i / 8) * H });
    }
    return { v, h };
  }, [W, H]);

  return (
    <div className={cn("w-full", className)}>
      <div className="mb-2 text-xs font-medium" style={{ color: VIZ_THEME.muted }}>
        Campus map · {gates.length} gate{gates.length === 1 ? "" : "s"}
      </div>
      <svg
        role="img"
        aria-label={`Campus map, ${gates.length} gates`}
        viewBox={`0 0 ${W} ${H}`}
        width="100%"
        height={H}
        className="overflow-visible"
      >
        {/* subtle grid */}
        {gridLines.v.map((l, i) => (
          <line key={`v-${i}`} x1={l.x} y1={0} x2={l.x} y2={H} stroke="var(--border)" strokeOpacity={0.25} strokeWidth={0.5} />
        ))}
        {gridLines.h.map((l, i) => (
          <line key={`h-${i}`} x1={0} y1={l.y} x2={W} y2={l.y} stroke="var(--border)" strokeOpacity={0.25} strokeWidth={0.5} />
        ))}

        {/* gates */}
        {gates.map((g) => {
          const x = toX(g.lng);
          const y = toY(g.lat);
          const rPx = g.radiusMeters != null ? Math.max(4, g.radiusMeters * pxPerMeter) : 14;
          const c = statusColor(g.status);
          return (
            <Gate key={g.id} g={g} x={x} y={y} rPx={rPx} color={c} onGateClick={onGateClick} />
          );
        })}
      </svg>
    </div>
  );
}

function Gate({
  g,
  x,
  y,
  rPx,
  color,
  onGateClick,
}: {
  g: GeoGate;
  x: number;
  y: number;
  rPx: number;
  color: string;
  onGateClick?: (id: string) => void;
}) {
  const interactive = !!onGateClick;
  return (
    <g
      transform={`translate(${x} ${y})`}
      onClick={() => onGateClick?.(g.id)}
      style={{ cursor: interactive ? "pointer" : "default" }}
      role={interactive ? "button" : "img"}
      aria-label={`${g.name} — ${g.status}, lat ${g.lat}, lng ${g.lng}`}
      tabIndex={interactive ? 0 : -1}
      onKeyDown={(ev) => ev.key === "Enter" && onGateClick?.(g.id)}
    >
      {/* outer radius ring */}
      <circle r={rPx} fill={color} fillOpacity={0.12} stroke={color} strokeOpacity={0.5} strokeWidth={1} />
      {/* center dot */}
      <circle r={4} fill={color} />
      {/* label with paint-order text-stroke so it stays legible over the grid */}
      <text
        y={rPx + 14}
        textAnchor="middle"
        fontSize={11}
        fill={VIZ_THEME.text}
        style={{
          paintOrder: "stroke",
          stroke: "var(--bg-surface)",
          strokeWidth: 3,
          strokeLinejoin: "round",
        }}
      >
        {g.name}
      </text>
    </g>
  );
}
