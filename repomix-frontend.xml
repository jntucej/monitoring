<file path="src/hooks/useDashboardData.ts">
/**
 * useDashboardData — a composite for dashboard reads.
 *
 * Wraps useApiResource (cached, deduped) and usePolling (visibility-aware) so
 * every dashboard gets the same correct behaviour with one call.
 *
 * - Cache key is url + userId — never shared across users.
 * - Polling is disabled while the tab is hidden.
 * - refreshKey increments on every successful refresh so WidgetBoundary can reset.
 */
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useApiResource } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { useAuthStore } from "@/stores/authStore";

/**
 * useDashboardData — a composite for dashboard reads.
 *
 * Wraps useApiResource (cached, deduped) and usePolling (visibility-aware) so
 * every dashboard gets the same correct behaviour with one call.
 *
 * - Cache key is url + userId — never shared across users.
 * - Polling is disabled while the tab is hidden.
 * - refreshKey increments on every successful refresh so WidgetBoundary can reset.
 *
 * The hook unwraps the standard ok() envelope ({ success, data: T }) internally,
 * so callers type T as the *inner* payload shape (e.g. `AlertsData`) and read
 * `data` directly as `T | null` — no `.data` access on the result.
 *
 * @deprecated `DashboardData<T>` and the `Envelope` alias types
 * (AlertsEnvelope, PeopleEnvelope, etc.) are retained for backward
 * compatibility but no longer needed: callers should pass the inner data
 * type directly to `useDashboardData<T>` and use `data` without unwrapping.
 */
export interface DashboardData<T> {
  data: T | null;
  loading: boolean;
  error: string | null;
  refresh: () => Promise<void>;
  refreshKey: number;
}

export function useDashboardData<T>(
  url: string | null,
  options: { ttlMs?: number; pollMs?: number; enabled?: boolean; poll?: boolean } = {}
): DashboardData<T> {
  // `poll` defaults to false: dashboards load once on mount and only
  // refresh when the user clicks the page's Refresh button. Passing
  // `pollMs` alone no longer enables auto-polling — pages that genuinely
  // need a live feed (e.g. the operator desk) must opt in with poll: true.
  const { ttlMs = 15000, pollMs = 30000, enabled = true, poll = false } = options;
  const userId = useAuthStore((s) => s.user?.id ?? "");
  // The cache is scoped per-user internally (see useApiResource below); the
  // URL no longer carries a `?_u=<uuid>` cache-buster — that was leaking the
  // caller's account UUID into every dashboard request (visible in devtools +
  // server logs) for no benefit now that polling is opt-in.
  const scopedUrl = url;

  // The ok() helper returns { success: true, data: T, ... } — we type the
  // fetch as the envelope and unwrap `.data` below so callers get T | null.
  const res = useApiResource<{ data: T } | null>(scopedUrl, {
    ttlMs,
    enabled: enabled && !!scopedUrl && userId !== "",
    deps: [userId],
  });
  const [refreshKey, setRefreshKey] = useState(0);

  // Stable access to the current refresh: useApiResource returns a fresh
  // result object on every render (its inner refresh is a useCallback, but
  // the *object* carrying it is not). Depending on the whole object made
  // `refresh` re-identify on every render, which drove usePolling's effect
  // (fn dep) into an immediate-tick burst loop. The ref below keeps
  // refresh stable while still calling the current underlying refresh.
  const refreshLiveRef = useRef(res.refresh);
  useEffect(() => {
    refreshLiveRef.current = res.refresh;
  }, [res.refresh]);

  const refresh = useCallback(async () => {
    await refreshLiveRef.current();
    setRefreshKey((k) => k + 1);
  }, []); // stable — the polling timer must never see it churn

  usePolling(
    async () => {
      await refresh();
    },
    { intervalMs: pollMs, enabled: enabled && !!scopedUrl && poll },
  );

  // Track loading for the very first paint only.
  const [firstLoad, setFirstLoad] = useState(true);
  useEffect(() => { if (!res.loading && firstLoad) setFirstLoad(false); }, [res.loading, firstLoad]);

  // Unwrap the { data: T } envelope so callers get T | null directly.
  const unwrapped: T | null = res.data?.data ?? null;

  return {
    data: unwrapped,
    loading: res.loading || firstLoad,
    error: res.error,
    refresh,
    refreshKey,
  };
}
</file>

<file path="src/hooks/useDeviceSettings.ts">
"use client";

import { useCallback, useEffect, useState } from "react";
import { useApi } from "@/hooks/useApi";
import { useAuthStore } from "@/stores/authStore";

export type DeviceType = "thumb" | "face" | "barcode" | "qr";

export interface DeviceSetting {
  id: string;
  deviceType: DeviceType;
  enabled: boolean;
  scope: "global" | "gate" | "hostel";
  scopeId?: string;
}

interface DeviceSettingRow {
  id: string;
  device_type: DeviceType;
  enabled: boolean;
  scope: "global" | "gate" | "hostel";
  scope_id?: string | null;
}

/** Module-level cache with a 60s TTL so every mount doesn't re-hit the API. */
const CACHE_TTL_MS = 60_000;
let cache: { at: number; settings: DeviceSetting[] } | null = null;

function mapRow(row: DeviceSettingRow): DeviceSetting {
  return {
    id: row.id,
    deviceType: row.device_type,
    enabled: Boolean(row.enabled),
    scope: row.scope,
    scopeId: row.scope_id ?? undefined,
  };
}

/**
 * useDeviceSettings — fetches device verification settings from
 * `/api/admin/device-settings` (Step 5) once per TTL window and returns a lookup
 * map. `isEnabled(type)` is `true` only when an enabled setting of that type
 * exists.
 *
 * The endpoint is restricted to sysadmin/admin roles. For callers without
 * access (401/403) we fail open — `isEnabled` returns `true` — so approvers and
 * operators are never blocked by a permission they legitimately can't read; the
 * server-side route remains the authoritative enforcement point.
 */
export function useDeviceSettings(): {
  settings: DeviceSetting[];
  isEnabled: (deviceType: DeviceType) => boolean;
  loading: boolean;
  refresh: () => void;
} {
  const api = useApi();
  const token = useAuthStore((s) => s.token);
  const [settings, setSettings] = useState<DeviceSetting[]>(
    () => cache?.settings ?? []
  );
  const [loading, setLoading] = useState<boolean>(!cache);
  const [nonce, setNonce] = useState(0);

  const refresh = useCallback(() => {
    cache = null;
    setNonce((n) => n + 1);
  }, []);

  useEffect(() => {
    if (cache && Date.now() - cache.at < CACHE_TTL_MS) {
      setSettings(cache.settings);
      setLoading(false);
      return;
    }

    let ignore = false;
    setLoading(true);

    fetch("/api/admin/device-settings", { headers: api.getHeaders() })
      .then((res) => res.json())
      .then((json) => {
        if (ignore) return;
        const rows = Array.isArray(json?.data) ? (json.data as DeviceSettingRow[]) : [];
        const mapped = rows.map(mapRow);
        cache = { at: Date.now(), settings: mapped };
        setSettings(mapped);
      })
      .catch(() => {
        if (ignore) return;
        // Fail open: treat all device types as enabled when we can't read settings.
        const fallback: DeviceSetting[] = (["thumb", "face", "barcode", "qr"] as DeviceType[]).map((t) => ({
          id: t,
          deviceType: t,
          enabled: true,
          scope: "global",
        }));
        setSettings(fallback);
      })
      .finally(() => {
        if (!ignore) setLoading(false);
      });

    return () => {
      ignore = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [token, nonce]);

  const isEnabled = useCallback(
    (deviceType: DeviceType): boolean =>
      settings.some((s) => s.deviceType === deviceType && s.enabled),
    [settings]
  );

  return { settings, isEnabled, loading, refresh };
}

export default useDeviceSettings;
</file>

<file path="src/hooks/useDispute.ts">
/**
 * useDispute — client-side dispute/issue tracking.
 * No server call; wire `onSubmit` to your API endpoint.
 */
"use client";

import { useCallback, useState } from "react";

export interface DisputeEntry {
  id: string;
  reason: string;
  category?: string;
  status: "open" | "in-review" | "resolved";
  createdAt: string;
  resolvedAt?: string;
}

export interface UseDisputeOptions {
  /** Persist a new dispute. Called on submit. */
  onSubmit: (d: Omit<DisputeEntry, "id" | "status" | "createdAt"> & { id?: string }) => Promise<void> | void;
  initial?: DisputeEntry[];
}

export interface UseDisputeResult {
  disputes: DisputeEntry[];
  openDisputes: DisputeEntry[];
  submitDispute: (reason: string, category?: string) => Promise<void>;
  isBusy: boolean;
}

let _id = 0;
function nextId() {
  _id += 1;
  return `dsp-${Date.now()}-${_id}`;
}

export function useDispute({ onSubmit, initial = [] }: UseDisputeOptions): UseDisputeResult {
  const [disputes, setDisputes] = useState<DisputeEntry[]>(initial);
  const [isBusy, setIsBusy] = useState(false);

  const submitDispute = useCallback(
    async (reason: string, category?: string) => {
      const entry: DisputeEntry = {
        id: nextId(),
        reason,
        category,
        status: "open",
        createdAt: new Date().toISOString(),
      };
      setIsBusy(true);
      try {
        await onSubmit(entry);
        setDisputes((prev) => [entry, ...prev]);
      } finally {
        setIsBusy(false);
      }
    },
    [onSubmit]
  );

  const openDisputes = disputes.filter((d) => d.status !== "resolved");

  return { disputes, openDisputes, submitDispute, isBusy };
}

export default useDispute;
</file>

<file path="src/hooks/useDisputes.ts">
/**
 * hooks/useDisputes.ts — the universal dispute hook. Every feature gets
 * "request if wrong" for free: call useDisputes() and you get the user's
 * open disputes + a create() function that posts to /api/disputes.
 *
 * Tier 1 (hooks) — never forks.
 */

"use client";

import { useCallback, useEffect, useState } from "react";
import { getAuthHeaders } from "@/lib/utils";

export interface Dispute {
  id: string;
  entity_type: string;
  entity_id: string;
  reason: string;
  status: "open" | "reviewed" | "resolved" | "rejected";
  resolution_note?: string;
  escalated_to?: string;
  created_at: string;
  resolved_at?: string;
}

export interface UseDisputesResult {
  /** The user's disputes (most recent first). */
  disputes: Dispute[];
  /** True while the first fetch is in flight. */
  loading: boolean;
  /** Create a new dispute. Returns the created dispute or null on failure. */
  create: (input: {
    entity_type: string;
    entity_id: string;
    reason: string;
    evidence?: Record<string, unknown>;
  }) => Promise<Dispute | null>;
  /** Refetch. */
  refresh: () => void;
}

export function useDisputes(status?: "open"): UseDisputesResult {
  const [disputes, setDisputes] = useState<Dispute[]>([]);
  const [loading, setLoading] = useState(true);

  const fetchDisputes = useCallback(async () => {
    try {
      const qs = status ? `?status=${status}` : "";
      const res = await fetch(`/api/disputes${qs}`, { headers: getAuthHeaders() });
      if (!res.ok) return;
      const data = await res.json();
      setDisputes(data.disputes ?? []);
    } catch {
      // graceful degradation: disputes stay empty
    } finally {
      setLoading(false);
    }
  }, [status]);

  useEffect(() => {
    fetchDisputes();
  }, [fetchDisputes]);

  const create = useCallback(
    async (input: {
      entity_type: string;
      entity_id: string;
      reason: string;
      evidence?: Record<string, unknown>;
    }) => {
      try {
        const res = await fetch("/api/disputes", {
          method: "POST",
          headers: getAuthHeaders(),
          body: JSON.stringify(input),
        });
        if (!res.ok) return null;
        const data = await res.json();
        if (data.dispute) {
          setDisputes((prev) => [data.dispute, ...prev]);
          return data.dispute as Dispute;
        }
        return null;
      } catch {
        return null;
      }
    },
    [],
  );

  return { disputes, loading, create, refresh: fetchDisputes };
}

export default useDisputes;
</file>

<file path="src/hooks/useEditable.ts">
/**
 * useEditable — inline edit-with-reason hook for single fields.
 * Toggling `editing` shows the input; saving requires a reason (audit trail).
 * Wire `onSave` to your PATCH endpoint.
 */
"use client";

import { useCallback, useState } from "react";

export interface UseEditableOptions<T extends string | number> {
  /** Initial value */
  initial: T;
  /** Persist the change. `reason` is required (audit). */
  onSave: (value: T, reason: string) => Promise<void> | void;
  /** Show cancel button. Default true. */
  canCancel?: boolean;
}

export interface UseEditableResult<T extends string | number> {
  value: T;
  editing: boolean;
  startEdit: () => void;
  cancelEdit: () => void;
  /** Call with the new value and a reason. Triggers onSave. */
  saveEdit: (newValue: T, reason: string) => Promise<void>;
  isBusy: boolean;
  hasChanged: boolean;
  lastEditReason?: string;
  draft: T;
  setDraft: (v: T) => void;
}

export function useEditable<T extends string | number>({
  initial,
  onSave,
  canCancel = true,
}: UseEditableOptions<T>): UseEditableResult<T> {
  const [value, setValue] = useState<T>(initial);
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState<T>(initial);
  const [isBusy, setIsBusy] = useState(false);
  const [lastEditReason, setLastEditReason] = useState<string>();

  const startEdit = useCallback(() => {
    setDraft(value);
    setEditing(true);
  }, [value]);

  const cancelEdit = useCallback(() => {
    setEditing(false);
  }, []);

  const saveEdit = useCallback(
    async (newValue: T, reason: string) => {
      if (!reason.trim()) throw new Error("Reason required");
      setIsBusy(true);
      try {
        await onSave(newValue, reason);
        setValue(newValue);
        setEditing(false);
        setLastEditReason(reason);
      } finally {
        setIsBusy(false);
      }
    },
    [onSave]
  );

  const hasChanged = JSON.stringify(value) !== JSON.stringify(initial);

  return { value, editing, startEdit, cancelEdit, saveEdit, isBusy, hasChanged, lastEditReason, draft, setDraft };
}

export default useEditable;
</file>

<file path="src/hooks/useEffectivePref.ts">
/**
 * hooks/useEffectivePref.ts — read any preference through the 4-layer cascade.
 *
 *   policy > user > persona > role > system
 *
 * The hook owns the cascade: it reads the user's stored prefs (from the
 * auth store + a lazy fetch of /api/preferences), the current persona
 * (usePersona), and the role (auth store), then calls resolvePref().
 *
 * Shells call `const { value, locked } = useEffectivePref("appearance.density")`
 * instead of hardcoding a default. `locked` is true when a "required"-rank
 * key is in effect — the UI shows 🔒 "Set by institute".
 *
 * Tier 1 (hooks) — never forks.
 */

"use client";

import { useMemo } from "react";
import { useAuthStore } from "@/stores/authStore";
import { usePersona } from "@/hooks/usePersona";
import { useActiveTraits } from "@/hooks/useActiveTraits";
import {
  resolvePref,
  PERSONA_DEFAULTS,
  ROLE_DEFAULTS,
  POLICY_DEFAULTS,
  type CascadeContext,
} from "@/lib/preferences/resolve";
import { getPrefDef, type Persona as PersonaKey } from "@/lib/preferences/registry";

export interface EffectivePrefResult<T> {
  /** The effective value after the cascade. */
  value: T;
  /** Which layer won. */
  source: "policy" | "user" | "trait" | "persona" | "role" | "system";
  /** The trait id when the trait layer won. */
  traitId?: string;
  /** The key's rank. */
  rank: "required" | "recommended" | "cosmetic";
  /** True when a "required"-rank policy value is in effect (show the lock). */
  locked: boolean;
  /** The user's stored value, even when policy overrode it. */
  userValue: unknown;
}

/**
 * Read one preference key through the 5-layer cascade:
 *   policy > user > trait > persona > role > system
 *
 * The hook owns the cascade: it reads the user's stored prefs, the current
 * persona (usePersona), the active traits (useActiveTraits), and the role
 * (auth store), then calls resolvePref().
 *
 * Shells call `const { value, locked, source } = useEffectivePref("appearance.density")`
 * instead of hardcoding a default. `locked` is true when a "required"-rank
 * key is in effect — the UI shows 🔒 "Set by institute". `source` is the
 * layer that won (used by the PreviewAs tool + the lock indicator).
 *
 * Tier 1 (hooks) — never forks.
 */
export function useEffectivePref<T>(
  key: string,
  userPrefs?: Record<string, unknown>,
): EffectivePrefResult<T> {
  const user = useAuthStore((s) => s.user);
  const role = useAuthStore((s) => s.role);
  const personaKey = usePersona();
  const traits = useActiveTraits().traits;

  return useMemo(() => {
    // The user layer: explicit arg, else the auth store's stored prefs.
    const userLayer: Record<string, unknown> =
      userPrefs ?? (user as unknown as { preferences?: Record<string, unknown> })?.preferences ?? {};

    // Build the cascade context.
    const persona = (PERSONA_DEFAULTS[personaKey] ?? PERSONA_DEFAULTS.both) as Record<string, unknown>;
    const roleLayer = (ROLE_DEFAULTS[role ?? "student"] ?? ROLE_DEFAULTS.student) as Record<string, unknown>;
    const ctx: CascadeContext = {
      user: userLayer,
      traits,
      persona,
      role: roleLayer,
      policy: POLICY_DEFAULTS,
    };

    const resolved = resolvePref<T>(key, ctx);

    return {
      value: resolved.value,
      source: resolved.source,
      traitId: resolved.traitId,
      rank: resolved.rank,
      locked: resolved.rank === "required" && resolved.source === "policy",
      userValue: resolved.userValue,
    };
  }, [key, userPrefs, user, role, personaKey, traits]);
}

export default useEffectivePref;
</file>

<file path="src/hooks/useExport.ts">
/**
 * useExport — client-side CSV export trigger.
 * Call `exportCSV(rows, columns, filename)` to download a file in the browser.
 * No server round-trip; suitable for period-filtered views.
 */
"use client";

import { useCallback } from "react";
import { csvEscape } from "@/lib/csv";

export interface CsvColumn<T> {
  key: keyof T | string;
  header: string;
  /** Transform row value to display string. Default String(). */
  format?: (row: T) => string;
}

/**
 * Build a CSV string from rows + columns. Uses csvEscape for injection safety.
 */
export function buildCSV<T>(rows: T[], columns: CsvColumn<T>[]): string {
  const headers = columns.map((c) => c.header).join(",");
  const lines = rows.map((row) =>
    columns
      .map((col) => {
        const raw = col.format
          ? col.format(row)
          : String((row as Record<string, unknown>)[String(col.key)] ?? "");
        return csvEscape(raw);
      })
      .join(",")
  );
  return [headers, ...lines].join("\n");
}

/**
 * Download a CSV file in the browser.
 */
export function downloadCSV(csvText: string, filename: string): void {
  const blob = new Blob([csvText], { type: "text/csv;charset=utf-8" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

export interface UseExportResult {
  exportCSV: <T>(rows: T[], columns: CsvColumn<T>[], filename?: string) => void;
  buildCSV: typeof buildCSV;
}

export function useExport() {
  const exportCSV = useCallback(
    <T,>(rows: T[], columns: CsvColumn<T>[], filename = "export.csv") => {
      downloadCSV(buildCSV(rows, columns), filename);
    },
    []
  );

  return { exportCSV, buildCSV };
}

export default useExport;
</file>

<file path="src/hooks/useHasCapability.ts">
// src/hooks/useHasCapability.ts
//
// P1 / §1 Touch 4: the client-side capability hook for buttons + widgets.
//
// The client is a PROJECTION of the server resolver (guardrail #1). This
// hook calls the SAME `hasCapability()` the API route uses, so client and
// server agree on the decision. Use it to disable a button:
//
//   const canApply = useHasCapability("hostel.leave.apply", ctx);
//   <Button disabled={!canApply}>Apply</Button>
//
// If the API returns 403 on a click, that's a drift bug — the
// `capability.api_forbidden` metric (§3 observability) catches it.

"use client";

import { useMemo } from "react";
import { hasCapability } from "@/config/roles";
import type { WorkspaceContext } from "@/config/roles/types";
import { useAuthStore } from "@/stores/authStore";
import type { Role } from "@/lib/types";

export function useHasCapability(
  capId: string,
  context: WorkspaceContext,
): boolean {
  const role = useAuthStore((s) => s.role) as Role | undefined;
  return useMemo(
    () => (role ? hasCapability(role, context, capId) : false),
    [role, context, capId],
  );
}
