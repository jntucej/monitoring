<file path="src/components/shared/GridBoard.tsx">
"use client";

/**
 * GridBoard — a multi-column grid board for a role console.
 *
 * Fetches a summary endpoint (e.g. /api/caretaker/summary) via
 * useApiResource, groups the returned ticket rows into columns by their
 * normalized status, and renders each card with the ticket number,
 * student/facility name, workflow type, an SLA badge, and the status.
 *
 * Desktop shows three columns side by side; mobile stacks columns
 * vertically. No horizontal scroll. No KPI cards or charts.
 */

import { useMemo } from "react";
import { Loader2 } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { type BoardRow } from "@/components/shared/Board";
import { SlaBadge } from "@/components/approver/SlaBadge";

/** The shape a grid-board source endpoint must return. */
interface GridBoardResponse {
  success?: boolean;
  data: {
    [key: string]: unknown;
    pendingTickets?: GridTicket[];
  };
}

/** A single ticket row as returned by a grid-board source. */
export interface GridTicket {
  ticket_number: string;
  workflow_type: string;
  status: string;
  sla_deadline: string | null;
  student_name: string | null;
}

/**
 * Normalize a raw ticket status into one of the three grid columns.
 * PENDING / ESCALATED → "Open"; IN_PROGRESS → "In Progress";
 * APPROVED / RESOLVED / REJECTED → "Resolved"; anything else → "Open".
 */
export function normalizeGridColumn(status: string | null | undefined): string {
  switch ((status ?? "").toUpperCase()) {
    case "IN_PROGRESS":
      return "In Progress";
    case "APPROVED":
    case "RESOLVED":
    case "REJECTED":
      return "Resolved";
    case "PENDING":
    case "ESCALATED":
    default:
      return "Open";
  }
}

/** Convert a GridTicket into a BoardRow-compatible shape for selection. */
export function ticketToBoardRow(ticket: GridTicket): BoardRow {
  return {
    id: ticket.ticket_number,
    roll: null,
    name: ticket.student_name,
    person_type: null,
    direction: ticket.status,
    reason: null,
    gate_id: null,
    gate_name: null,
    timestamp: ticket.sla_deadline ?? "",
    scan_type: ticket.workflow_type,
    is_correction: null,
    created_at: null,
  };
}

const COLUMN_TITLES = ["Open", "In Progress", "Resolved"];

interface GridBoardProps {
  /** The summary API path, e.g. "/api/caretaker/summary". */
  source: string;
  /** Field to group rows by; the caretaker summary groups by "status". */
  groupBy: string;
  /** Explicit column titles; falls back to the three status columns. */
  columns: string[];
  /** Called when a card is selected. */
  onSelect?: (row: BoardRow) => void;
}

export function GridBoard({ source, groupBy, columns, onSelect }: GridBoardProps) {
  const { data, loading, error } = useApiResource<GridBoardResponse>(source, { ttlMs: 15_000 });

  // The caretaker summary returns tickets under data.pendingTickets.
  // Fall back to the dynamic groupBy field, then to an empty array.
  const tickets = useMemo<GridTicket[]>(() => {
    if (!data) return [];
    const raw = data.data;
    if (Array.isArray(raw.pendingTickets)) return raw.pendingTickets;
    const dyn = raw[groupBy];
    if (Array.isArray(dyn)) return dyn as GridTicket[];
    return [];
  }, [data, groupBy]);

  const byColumn = useMemo(() => {
    const map: Record<string, GridTicket[]> = {};
    for (const col of columns) map[col] = [];
    for (const t of tickets) {
      const col = normalizeGridColumn(t.status);
      if (map[col]) map[col].push(t);
    }
    return map;
  }, [tickets, columns]);

  const empty = tickets.length === 0;

  return (
    <WidgetBoundary title="Tickets by status">
      {loading && empty ? (
        <div className="flex items-center justify-center gap-2 py-8 text-sm text-text-muted">
          <Loader2 className="w-4 h-4 animate-spin" /> Loading tickets&hellip;
        </div>
      ) : error ? (
        <div className="surface-card py-6 text-xs text-action-warning bg-amber-400/10 p-3">
          {error}
        </div>
      ) : empty ? (
        <EmptyState
          title="No pending tickets"
          description="Tickets at the caretaker stage will appear here grouped by status."
        />
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          {columns.map((col) => {
            const colTickets = byColumn[col] ?? [];
            return (
              <section
                key={col}
                className="surface-card bg-bg-elevated p-3 min-w-0"
                aria-label={`${col} tickets`}
              >
                <header className="flex items-center justify-between px-1 pb-2">
                  <h3 className="text-xs font-semibold uppercase tracking-wide text-text-muted">
                    {col}
                  </h3>
                  <span className="text-xs font-mono tabular-nums text-text-muted">
                    {colTickets.length}
                  </span>
                </header>
                <ul className="space-y-2">
                  {colTickets.length === 0 ? (
                    <li className="px-1 py-3 text-xs text-text-muted">
                      No tickets
                    </li>
                  ) : (
                    colTickets.map((t) => (
                      <li key={t.ticket_number}>
                        <button
                          type="button"
                          onClick={() => onSelect?.(ticketToBoardRow(t))}
                          className="surface-card w-full text-left bg-bg-base p-3 min-w-0 hover: transition-colors"
                        >
                          <div className="flex items-center justify-between gap-2 min-w-0">
                            <span className="text-xs font-mono font-semibold text-text-primary truncate">
                              {t.ticket_number}
                            </span>
                            <span className="text-xs font-mono text-text-muted shrink-0">
                              {t.status}
                            </span>
                          </div>
                          <p className="text-xs font-semibold text-text-primary truncate mt-1">
                            {t.student_name || "—"}
                          </p>
                          <p className="text-xs text-text-muted truncate">
                            {t.workflow_type}
                          </p>
                          <div className="mt-2">
                            <SlaBadge slaDeadline={t.sla_deadline} status={t.status} />
                          </div>
                        </button>
                      </li>
                    ))
                  )}
                </ul>
              </section>
            );
          })}
        </div>
      )}
      {/* Unused COLUMN_TITLES is referenced only as a default in the page;
          keep the export for consumers that want the canonical titles. */}
    </WidgetBoundary>
  );
}

export { COLUMN_TITLES };
export default GridBoard;
</file>

<file path="src/components/shared/GuardedPage.tsx">
"use client";
import { useEffect, useRef, useMemo } from "react";
import { getRoleTier } from "@/lib/alert-hierarchy";
import { useAuthStore } from "@/stores/authStore";
import type { Role } from "@/lib/types";
import { useRouter } from "next/navigation";
import { getDefaultRouteForRole } from "@/lib/route-helpers";
import { AppLoadingScreen } from "@/components/shared/AppLoadingScreen";
import { AuthGuard } from "./AuthGuard";
import { hasCapability } from "@/config/roles";
import type { WorkspaceContext } from "@/config/roles/types";

export interface GuardedPageProps {
  allowedRoles?: Role[];
  minTier?: number;
  /**
   * P1: gate on a capability id instead of a role list. When present, the
   * page renders only if `hasCapability(role, ctx, capability)` passes.
   * `allowedRoles`/`minTier` remain as an alias for one release cycle;
   * after that, capability is the path and role is removed.
   */
  capability?: string;
  /** The workspace context to evaluate the capability against. */
  context?: WorkspaceContext;
  children: React.ReactNode;
}

export function GuardedPage({ allowedRoles, minTier = 0, capability, context, children }: GuardedPageProps) {
  const user = useAuthStore((s) => s.user);
  const hasHydrated = useAuthStore((s) => s._hasHydrated);
  const role = (user?.role ?? "student") as Role;
  const tier = getRoleTier(role);
  const router = useRouter();

  const roleOk = allowedRoles ? allowedRoles.includes(role) : true;
  // Tier gate only applies when an allowedRoles list was NOT provided
  // (a role list already encodes the intended audience).
  const tierOk = allowedRoles ? true : tier >= minTier;

  // P1: capability gate. If a capability id is present, the page renders
  // only when the resolver grants it. This is the same call site the API
  // route uses (server-consistent), so client and server agree.
  const capOk = capability && context
    ? hasCapability(role, context, capability)
    : true; // no capability → fall back to role/tier only

  // Guard against double-mount in React strict mode — single render pass
  const redirectedRef = useRef(false);

  useEffect(() => {
    if (redirectedRef.current) return;
    redirectedRef.current = true;

    if ((!roleOk || !tierOk) || !capOk) {
      const defaultRoute = getDefaultRouteForRole(role);
      router.replace(defaultRoute);
    }
  }, [roleOk, tierOk, capOk, role, router]);

  // Fix 6: if auth status === 'loading' → render <AppLoadingScreen/> and NOTHING else
  if (!hasHydrated || !user) {
    return <AppLoadingScreen />;
  }

  if ((!roleOk || !tierOk) || !capOk) {
    return <AppLoadingScreen />;
  }

  return <AuthGuard allowedRoles={allowedRoles}>{children}</AuthGuard>;
}
</file>

<file path="src/components/shared/HoverPreview.tsx">
"use client";

import { useState, type ReactNode } from "react";
import { cn } from "@/lib/utils";

/**
 * HoverPreview — the "hover → tooltip/preview" layer of the inspection
 * hierarchy. Wraps any element and, on hover (or focus, for keyboard),
 * shows a compact preview card without leaving the page.
 *
 * Usage:
 *
 *   <HoverPreview preview={<StudentQuickCard row={r} />}>
 *     <button>…row content…</button>
 *   </HoverPreview>
 *
 * The preview is intentionally compact (a few key facts + state) — the
 * full context/history/actions live in `EntityInspector` (click → panel).
 */

export interface HoverPreviewProps {
  /** The compact preview shown on hover. */
  preview: ReactNode;
  /** The element to wrap. */
  children: ReactNode;
  /** Position of the preview relative to the trigger. Default "top". */
  position?: "top" | "bottom" | "left" | "right";
  /** Extra ms before the preview shows (debounce so it doesn't flicker). */
  delayMs?: number;
  /** Render the trigger inline (no extra wrapper). Default true. */
  inline?: boolean;
  /** Class for the preview card. */
  previewClassName?: string;
}

const POSITIONS: Record<
  NonNullable<HoverPreviewProps["position"]>,
  { trigger: string; card: string }
> = {
  top: {
    trigger: "relative group",
    card: "bottom-full left-1/2 -translate-x-1/2 mb-2",
  },
  bottom: {
    trigger: "relative group",
    card: "top-full left-1/2 -translate-x-1/2 mt-2",
  },
  left: {
    trigger: "relative group",
    card: "top-1/2 right-full -translate-y-1/2 mr-2",
  },
  right: {
    trigger: "relative group",
    card: "top-1/2 left-full -translate-y-1/2 ml-2",
  },
};

export function HoverPreview({
  preview,
  children,
  position = "top",
  delayMs = 150,
  inline = true,
  previewClassName,
}: HoverPreviewProps) {
  const [open, setOpen] = useState(false);
  const [timer, setTimer] = useState<ReturnType<typeof setTimeout> | null>(null);

  const openSoon = () => {
    if (timer) clearTimeout(timer);
    setTimer(setTimeout(() => setOpen(true), delayMs));
  };
  const closeSoon = () => {
    if (timer) clearTimeout(timer);
    setTimer(null);
    setOpen(false);
  };

  const pos = POSITIONS[position];

  const wrapper = (
    <span
      className={cn(pos.trigger, "inline-flex max-w-full", !inline && "block w-full")}
      onMouseEnter={openSoon}
      onMouseLeave={closeSoon}
      onFocus={openSoon}
      onBlur={closeSoon}
      tabIndex={-1}
    >
      {children}
      {open && (
        <span
          role="tooltip"
          className={cn(
            "absolute z-[70] surface-card bg-bg-surface p-3 text-xs text-text-primary shadow-lg border border-border max-w-64 w-max",
            pos.card,
            previewClassName,
          )}
        >
          {preview}
        </span>
      )}
    </span>
  );

  return wrapper;
}

/**
 * A ready-made compact preview for a "current status" style metric.
 *
 *   <HoverPreview preview={<MetricPreview label="On campus" value={n} hint="checked-in and not yet checked-out" />}>
 */
export function MetricPreview({
  label,
  value,
  hint,
}: {
  label: string;
  value: ReactNode;
  hint?: string;
}) {
  return (
    <span className="block space-y-0.5">
      <span className="font-semibold text-text-muted uppercase tracking-wide text-[10px]">{label}</span>
      <span className="text-sm font-bold text-text-primary tabular-nums">{value}</span>
      {hint ? <span className="block text-text-muted text-[11px]">{hint}</span> : null}
    </span>
  );
}
</file>

<file path="src/components/shared/IconRail.tsx">
"use client";

/**
 * IconRail — slim left icon rail for the role console.
 *
 * Renders the operator's <=5 nav items as icons with hover labels (a tooltip
 * implemented locally so we don't drag in the tooltip component's deps).
 * The Dashboard item links to the role root (the board); sub-items link to
 * their sub-routes. Active state is driven by usePathname().
 *
 * Icons are resolved from a fixed, typed map (LucideIcon) rather than the
 * Sidebar's `import * as Icons` pattern, to keep strict TS clean.
 */

import { usePathname } from "next/navigation";
import { useState } from "react";
import {
  LayoutDashboard,
  QrCode,
  Clock,
  CheckSquare,
  ShieldAlert,
  User,
  HelpCircle,
  MoreHorizontal,
  CalendarDays,
  ScanLine,
  UtensilsCrossed,
  type LucideIcon,
} from "lucide-react";
import { useNavigation } from "@/hooks/useNavigation";
import type { NavItem } from "@/hooks/useNavigation";
import { getConsoleConfig } from "@/config/consoles";

export interface IconRailChild {
  label: string;
  href: string;
}

export interface IconRailGroup {
  id: string;
  label: string;
  icon: LucideIcon;
  children: IconRailChild[];
}

const ICON_MAP: Record<string, LucideIcon> = {
  LayoutDashboard,
  QrCode,
  Clock,
  CheckSquare,
  ShieldAlert,
  User,
  HelpCircle,
  MoreHorizontal,
  GraduationCap: QrCode,
  FileSpreadsheet: QrCode,
  Sparkles: Clock,
  CalendarDays,
  ScanLine,
  UtensilsCrossed,
};

function LocalTooltip({ label, children }: { label: string; children: React.ReactNode }) {
  return (
    <span className="relative group flex items-center justify-center">
      {children}
      <span
        role="tooltip"
        className="surface-card absolute left-full ml-3 px-2.5 py-1 bg-bg-elevated text-xs font-medium opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-50 text-text-primary"
      >
        {label}
      </span>
    </span>
  );
}

export interface IconRailProps {
  /** The role being rendered. */
  role: string;
  /** The role root path (e.g. "/operator") for the dashboard item. */
  roleRoot: string;
  /**
   * An explicit set of rail items. When omitted the rail falls back to the
   * first <=5 items from the role's nav groups (excluding the Account group),
   * plus a dashboard item pointing at roleRoot.
   */
  items?: { href: string; label: string; icon: LucideIcon }[];
  /**
   * Optional collapsible groups. Each group renders as a single icon in the
   * rail; hovering (desktop) opens a flyout panel of child links, and the
   * group icon stays highlighted whenever the current path matches any child.
   * When provided, groups replace the flat `items` list.
   */
  groups?: IconRailGroup[];
}

export function IconRail({ role, roleRoot, items, groups }: IconRailProps) {
  const pathname = usePathname();
  const { navigation } = useNavigation(role);
  const [openGroupId, setOpenGroupId] = useState<string | null>(null);

  // Build the rail item set: a dashboard item plus the role's top items.
  const railItems = useMemoRailItems({ navigation, role, roleRoot, items, pathname });

  const isGroupActive = (group: IconRailGroup) =>
    group.children.some(
      (c) => pathname === c.href || (c.href.length > 2 && pathname!.startsWith(c.href))
    );

  return (
    <nav
      aria-label="Primary navigation"
      className="surface-card relative hidden md:flex flex-col items-center gap-1 py-3 px-1.5 w-14 shrink-0 bg-bg-surface/95 backdrop-blur-md"
    >
      {/* Dashboard (board) */}
      <LocalTooltip label="Dashboard">
        <a
          href={roleRoot}
          aria-label="Dashboard"
          aria-current={pathname === roleRoot ? "page" : undefined}
          className={`size-6 rounded-xl flex items-center justify-center transition-colors ${
            pathname === roleRoot
              ? "bg-action-primary/15 text-action-primary"
              : "text-text-secondary hover:bg-bg-elevated hover:text-text-primary"
          }`}
        >
          <LayoutDashboard className="w-4 h-4" />
        </a>
      </LocalTooltip>

      <div className="h-px w-6 bgborder my-1" />

      {groups && groups.length > 0 ? (
        groups.map((group) => {
          const GroupIcon = group.icon;
          const active = isGroupActive(group);
          const open = openGroupId === group.id;
          return (
            <div
              key={group.id}
              className="relative"
              onMouseEnter={() => setOpenGroupId(group.id)}
              onMouseLeave={() => setOpenGroupId(null)}
            >
              <button
                type="button"
                aria-label={group.label}
                aria-expanded={open}
                onClick={() => setOpenGroupId(open ? null : group.id)}
                className={`size-6 rounded-xl flex items-center justify-center transition-colors ${
                  active
                    ? "bg-action-primary/15 text-action-primary"
                    : "text-text-secondary hover:bg-bg-elevated hover:text-text-primary"
                }`}
              >
                <GroupIcon className="w-4 h-4" />
              </button>
              {active && (
                <span className="absolute -right-0.5 top-1/2 -translate-y-1/2 h-4 w-0.5 rounded-full bg-action-primary" />
              )}
              {/* Desktop flyout */}
              <div
                className={`absolute left-full top-0 z-50 ml-2 w-56 rounded-xl border bg-bg-elevated shadow-xl overflow-hidden transition-opacity ${
                  open ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none"
                }`}
                style={{ borderColor: "var(--border)" }}
                role="menu"
                aria-label={group.label}
              >
                <p
                  className="px-3 pt-2 pb-1 text-xs uppercase tracking-wide font-semibold"
                  style={{ color: "var(--text-muted)" }}
                >
                  {group.label}
                </p>
                {group.children.map((child) => {
                  const childActive =
                    pathname === child.href ||
                    (child.href.length > 2 && pathname!.startsWith(child.href));
                  return (
                    <a
                      key={child.href}
                      href={child.href}
                      role="menuitem"
                      onClick={() => setOpenGroupId(null)}
                      className={`flex items-center gap-2 px-3 py-2 text-xs transition-colors ${
                        childActive
                          ? "text-action-primary font-semibold bg-action-primary/10"
                          : "text-text-secondary hover:bg-bg-surface hover:text-text-primary"
                      }`}
                    >
                      <span className="truncate">{child.label}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          );
        })
      ) : (
        railItems.map((item) => {
          const Icon = item.icon;
          const isActive = pathname === item.href || (item.href.length > 2 && pathname.startsWith(item.href));
          return (
            <LocalTooltip key={item.href} label={item.label}>
              <a
                href={item.href}
                aria-label={item.label}
                aria-current={isActive ? "page" : undefined}
                className={`size-6 rounded-xl flex items-center justify-center transition-colors ${
                  isActive
                    ? "bg-action-primary/15 text-action-primary"
                    : "text-text-secondary hover:bg-bg-elevated hover:text-text-primary"
                }`}
              >
                <Icon className="w-4 h-4" />
              </a>
            </LocalTooltip>
          );
        })
      )}
    </nav>
  );
}

/** Flatten the role's nav groups into <=4 rail items (excluding the Account group). */
function useMemoRailItems({
  navigation,
  role,
  roleRoot,
  items,
  pathname,
}: {
  navigation: { groupLabel: string; items: NavItem[] }[];
  role: string;
  roleRoot: string;
  items?: { href: string; label: string; icon: LucideIcon }[];
  pathname: string | null;
}) {
  if (items && items.length > 0) return items;

  // If a console config exists, mirror its command set so the rail stays in
  // sync with the command palette.
  const config = getConsoleConfig(role);

  const flat = navigation
    .filter((g) => g.groupLabel !== "Account")
    .flatMap((g) => g.items)
    // De-duplicate by href (hrefs can repeat across groups)
    .filter((item, idx, arr) => arr.findIndex((x) => x.href === item.href) === idx);

  const resolved = flat.slice(0, 4).map((item) => ({
    href: item.href,
    label: item.label,
    icon: ICON_MAP[item.icon || ""] || QrCode,
  }));

  // If a console config is present, keep only the items that correspond to
  // the configured commands (scan / manual-entry / pass-verify / lookup)
  // and cap at 4. The config presence just signals the console layout is
  // active; the rail items are still derived from the role's nav so the
  // hrefs stay authoritative.
  if (config) {
    void config;
  }

  void roleRoot;
  void pathname;
  return resolved;
}
