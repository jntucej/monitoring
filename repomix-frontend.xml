<file path="src/components/sysadmin/kit/sidebar/MiniGauge.tsx">
"use client";

import { cn } from "@/lib/utils";
import type { MiniProps } from "./types";

export interface MiniGaugeProps extends MiniProps {
  value: number; // 0..1
  color?: string;
  size?: number;
}

export function MiniGauge({ value, label, color, size = 18, onClick, className }: MiniGaugeProps) {
  const clamped = Math.max(0, Math.min(1, value));
  const r = (size - 4) / 2;
  const c = 2 * Math.PI * r;
  const offset = c * (1 - clamped);
  const ringColor = color ?? "var(--action-primary)";

  return (
    <button
      type="button"
      onClick={onClick}
      disabled={!onClick}
      aria-label={label}
      className={cn("flex items-center h-5 min-w-0", className)}
    >
      <svg width={size} height={size} className="shrink-0" style={{ transform: "rotate(-90deg)" }}>
        <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke="var(--border)" strokeWidth={3} />
        <circle
          cx={size / 2}
          cy={size / 2}
          r={r}
          fill="none"
          stroke={ringColor}
          strokeWidth={3}
          strokeLinecap="round"
          strokeDasharray={c}
          strokeDashoffset={offset}
        />
      </svg>
    </button>
  );
}
