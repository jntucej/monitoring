<file path="src/components/shell/RoleSidebar.tsx">
"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { useEffect, useState, useCallback } from "react";
import { ChevronDown, ChevronRight } from "lucide-react";
import { cn } from "@/lib/utils";
import type { NavGroup, NavLink, NavEntry, NavContext, NavChild, RoleManifest } from "./types";

function isActive(pathname: string | null, href: string, rootHref: string) {
  if (!pathname) return false;
  if (href === rootHref) return pathname === rootHref;
  return pathname === href || pathname.startsWith(href + "/");
}

function groupActive(pathname: string | null, group: NavGroup, rootHref: string) {
  return group.children.some((c) => isActive(pathname, c.href, rootHref));
}

/** P1: filter a nav entry by its `when(ctx)` predicate. Omit → always keep. */
function entryVisible(entry: NavEntry, ctx?: NavContext): boolean {
  if (!entry.when || !ctx) return true;
  try {
    return entry.when(ctx);
  } catch {
    return true; // fail-open for nav (cosmetic)
  }
}

/** P1: filter a group child by its `when(ctx)` predicate. Omit → always keep. */
function childVisible(child: NavChild, ctx?: NavContext): boolean {
  if (!child.when || !ctx) return true;
  try {
    return child.when(ctx);
  } catch {
    return true; // fail-open for nav (cosmetic)
  }
}

export function RoleSidebar({
  manifest,
  onNavigate,
}: {
  manifest: RoleManifest;
  onNavigate?: () => void;
}) {
  const pathname = usePathname();
  const [expanded, setExpanded] = useState<Record<string, boolean>>({});
  // P1: the live context the `when(ctx)` predicates evaluate against.
  const navCtx = manifest.navContext;

  useEffect(() => {
    try {
      const raw = localStorage.getItem(manifest.storageKey);
      if (raw) setExpanded(JSON.parse(raw));
    } catch {
      /* storage blocked — start collapsed */
    }
  }, [manifest.storageKey]);

  useEffect(() => {
    const active = manifest.nav.find(
      (e): e is NavGroup =>
        e.kind === "group" && groupActive(pathname, e, manifest.rootHref)
    );
    if (!active) return;
    setExpanded((prev) => {
      if (prev[active.id]) return prev;
      const next = { ...prev, [active.id]: true };
      try {
        localStorage.setItem(manifest.storageKey, JSON.stringify(next));
      } catch {
        /* ignore */
      }
      return next;
    });
  }, [pathname, manifest]);

  const toggle = useCallback(
    (id: string) => {
      setExpanded((prev) => {
        const next = { ...prev, [id]: !prev[id] };
        try {
          localStorage.setItem(manifest.storageKey, JSON.stringify(next));
        } catch {
          /* ignore */
        }
        return next;
      });
    },
    [manifest.storageKey]
  );

  const close = useCallback(() => onNavigate?.(), [onNavigate]);
  const Footer = manifest.footer;

  return (
    <div className="flex h-full w-full flex-col bg-bg-surface">
      <header className="surface-card shrink-0 px-4 py-3">
        <p className="text-xs font-medium uppercase tracking-wider text-text-muted">
          {manifest.brand.short}
        </p>
        <p className="text-sm font-semibold text-text-primary">
          {manifest.brand.long}
        </p>
      </header>

      <nav
        className="flex-1 overflow-y-auto p-2"
        aria-label={`${manifest.role} navigation`}
      >
        {manifest.nav
          .filter((entry) => entryVisible(entry, navCtx))
          .map((entry) =>
            entry.kind === "link" ? (
              <LinkRow
                key={entry.href}
                entry={entry}
                active={isActive(pathname, entry.href, manifest.rootHref)}
                onNavigate={close}
              />
            ) : (
              <GroupRow
                key={entry.id}
                group={entry}
                ctx={navCtx}
                expanded={!!expanded[entry.id]}
                active={groupActive(pathname, entry, manifest.rootHref)}
                pathname={pathname}
                rootHref={manifest.rootHref}
                onToggle={() => toggle(entry.id)}
                onNavigate={close}
              />
            )
          )}
      </nav>

      <footer className="surface-card shrink-0 p-2 space-y-1">
        {Footer && <Footer />}
        {manifest.hasProfile !== false && (
          <Link
            href={`${manifest.rootHref}/profile`}
            onClick={close}
            className="surface-card flex items-center gap-2 px-3 py-1.5 text-xs text-text-muted hover:bg-bg-elevated"
          >
            Account settings
          </Link>
        )}
      </footer>
    </div>
  );
}

function LinkRow({
  entry,
  active,
  onNavigate,
}: {
  entry: NavLink;
  active: boolean;
  onNavigate?: () => void;
}) {
  const Icon = entry.icon;
  return (
    <Link
      href={entry.href}
      onClick={onNavigate}
      aria-current={active ? "page" : undefined}
      className={cn(
        "mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition",
        active
          ? "bg-action-primary/10 font-medium text-action-primary"
          : "text-text-secondary hover:bg-bg-elevated"
      )}
    >
      <Icon className="size-4 shrink-0" aria-hidden />
      <span className="flex-1">{entry.label}</span>
    </Link>
  );
}

function GroupRow({
  group,
  ctx,
  expanded,
  active,
  pathname,
  rootHref,
  onToggle,
  onNavigate,
}: {
  group: NavGroup;
  ctx?: NavContext;
  expanded: boolean;
  active: boolean;
  pathname: string | null;
  rootHref: string;
  onToggle: () => void;
  onNavigate?: () => void;
}) {
  const Icon = group.icon;
  const Chevron = expanded ? ChevronDown : ChevronRight;
  // P1: filter children by their `when(ctx)` predicate.
  const visibleChildren = (ctx ? group.children.filter((c) => childVisible(c, ctx)) : group.children);

  return (
    <div className="mb-0.5">
      <button
        type="button"
        onClick={onToggle}
        aria-expanded={expanded}
        className={cn(
          "flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm transition",
          active
            ? "text-action-primary"
            : "text-text-secondary hover:bg-bg-elevated"
        )}
      >
        <Icon className="size-4 shrink-0" aria-hidden />
        <span className="flex-1 text-left">{group.label}</span>
        <Chevron className="size-3.5 shrink-0 text-text-muted" />
      </button>

      {expanded && (
        <ul className="mt-0.5 space-y-0.5 pl-7">
          {visibleChildren.map((child) => {
            const childActive = isActive(pathname, child.href, rootHref);
            return (
              <li key={child.href}>
                <Link
                  href={child.href}
                  onClick={onNavigate}
                  aria-current={childActive ? "page" : undefined}
                  className={cn(
                    "block rounded-md px-3 py-1.5 text-xs transition",
                    childActive
                      ? "bg-action-primary/10 font-medium text-action-primary"
                      : "text-text-muted hover:bg-bg-elevated hover:text-text-secondary"
                  )}
                >
                  {child.label}
                </Link>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  );
}
</file>

<file path="src/components/student/home/ActionItemsStrip.tsx">
// src/components/student/home/ActionItemsStrip.tsx
// One strip on the student home: "what needs me today". Pulls pending items
// from existing endpoints in parallel. If zero items, the strip is hidden.
// Max 5 pills. No dashboard, no "0 items" noise.

"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { useIsSakuga } from "@/components/student/useIsSakuga";

interface ActionItem {
  label: string;
  href: string;
  tone: "info" | "warning" | "danger" | "success";
}

export function ActionItemsStrip() {
  const router = useRouter();
  const isSakuga = useIsSakuga();
  const [items, setItems] = useState<ActionItem[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    (async () => {
      const out: ActionItem[] = [];

      // 1. Pending assignments due today (from D.3 assignments endpoint)
      try {
        const res = await fetch("/api/student/assignments?mine=pending", { credentials: "include" });
        const json = await res.json();
        const pending = json.data?.pending ?? json.pending ?? 0;
        if (typeof pending === "number" && pending > 0) {
          out.push({ label: `${pending} assignment${pending > 1 ? "s" : ""} due`, href: "/student/assignments", tone: "warning" });
        } else if (Array.isArray(json.data?.items)) {
          const due = json.data.items.filter((i: any) => i.dueDate && new Date(i.dueDate) <= new Date()).length;
          if (due > 0) out.push({ label: `${due} assignment${due > 1 ? "s" : ""} due today`, href: "/student/assignments", tone: "warning" });
        }
      } catch {}

      // 2. Approval waiting (permissions)
      try {
        const res = await fetch("/api/permissions/my-counts", { credentials: "include" });
        const json = await res.json();
        const n = json.data?.pending ?? json.pending ?? 0;
        if (typeof n === "number" && n > 0) {
          out.push({ label: `${n} approval${n > 1 ? "s" : ""} waiting`, href: "/student/permissions", tone: "info" });
        }
      } catch {}

      // 3. Mess token available for today (hostellers)
      try {
        const res = await fetch("/api/mess/my-token", { credentials: "include" });
        const json = await res.json();
        if (json.data?.token && !json.data.eligibility) {
          out.push({ label: "Lunch token ready", href: "/student/mess/token", tone: "success" });
        }
      } catch {}

      // 4. Support ticket open
      try {
        const res = await fetch("/api/support/tickets?mine=open", { credentials: "include" });
        const json = await res.json();
        const n = json.data?.total ?? json.total ?? 0;
        if (typeof n === "number" && n > 0) {
          out.push({ label: `${n} ticket update`, href: "/student/coordinator", tone: "info" });
        }
      } catch {}

      // 5. Next exam coming soon (within 3 days)
      try {
        const res = await fetch("/api/student/next-exam", { credentials: "include" });
        const json = await res.json();
        const next = json.data;
        if (next?.date && new Date(next.date).getTime() - Date.now() < 3 * 86400_000) {
          out.push({ label: `Next exam: ${next.subject ?? next.label}`, href: "/student/exams", tone: "danger" });
        }
      } catch {}

      setItems(out.slice(0, 5));
      setLoading(false);
    })();
  }, []);

  if (loading || items.length === 0) return null;

  return (
    <div className="surface-card bg-bg-base p-3 min-w-0">
      <p className="text-[10px] font-semibold uppercase tracking-wide text-text-muted mb-2">
        Needs your attention
      </p>
      <div className="flex flex-wrap gap-1.5">
        {items.map((it, i) =>
          isSakuga ? (
            <sakuga-button
              key={i}
              variant={it.tone === "danger" || it.tone === "warning" ? "primary" : "secondary"}
              onClick={() => router.push(it.href)}
            >
              <span className="text-xs">{it.label}</span>
            </sakuga-button>
          ) : (
            <a
              key={i}
              href={it.href}
              className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium border transition-colors ${
                it.tone === "danger"
                  ? "bg-rose-500/10 border-rose-500/30 text-action-danger hover:bg-rose-500/20"
                  : it.tone === "warning"
                    ? "bg-amber-500/10 border-amber-500/30 text-action-warning hover:bg-amber-500/20"
                    : it.tone === "success"
                      ? "bg-emerald-500/10 border-emerald-500/30 text-action-success hover:bg-emerald-500/20"
                      : "bg-bg-elevated/50 border-border text-text-secondary hover:bg-bg-elevated"
              }`}
            >
              {it.label}
            </a>
          ),
        )}
      </div>
