"use client";

export interface InlineDiffBadgeProps {
  label: string;
  before: string;
  after: string;
  tone?: "ok" | "warn" | "danger" | "info";
}

const TONE_CLS: Record<NonNullable<InlineDiffBadgeProps["tone"]>, string> = {
  ok: "bg-action-success/15 text-action-success",
