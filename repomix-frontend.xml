<file path="src/app/(admin)/admin/workers/page.tsx">
"use client";
import { POLL_INTERVALS } from "@/config/app-constants";


import React, { useState, lazy, Suspense } from "react";
import { AlertCircle } from "lucide-react";
import { WorkerShiftTracker, WorkerShift } from "@/components/admin/WorkerShiftTracker";
import { useApi } from "@/hooks/useApi";
import { useLiveRefresh } from "@/hooks/useLiveRefresh"
import { CampusStatusBar } from "@/components/admin/CampusStatusBar";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { WorkerTypeAndBlockPanel } from "@/components/admin/WorkerTypeAndBlockPanel";

const WorkerMonthlyReviewPanel = lazy(
  () => import("@/components/admin/WorkerMonthlyReviewPanel")
);
export default function AdminWorkersPage() {
const api = useApi();

  const [shifts, setShifts] = useState<WorkerShift[]>([]);
  const [summary, setSummary] = useState({
    totalActive: 0,
    onShift: 0,
    lateArrivals: 0,
    offShift: 0,
    shiftAdherenceRate: 100,
  });
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);

  const fetchShifts = async () => {
    try {
      setLoading(true);
      setError(null);
      const res = await fetch("/api/workers/shifts", {
        headers: api.getHeaders(),
        cache: "no-store",
      });
      const json = await res.json();
      if (json?.success) {
        const payload = json.data ?? json;
        setShifts(payload.shifts || []);
        if (payload.summary) setSummary(payload.summary);
      } else {
        const msg = typeof json.error === "string" ? json.error : json.error?.message || "Failed to load worker shifts";
        setError(msg);
      }
    } catch (err) {
      console.error("Error fetching worker shifts:", err);
      setError("Network error loading worker shifts");
    } finally {
      setLoading(false);
    }
  };

  // Live toggle drives refetch; polls every 30s while Live.
  useLiveRefresh(fetchShifts, { intervalMs: POLL_INTERVALS.normal });

  return (
    
      <div className="min-h-dvh bg-[var(--bg)]">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Manage and monitor workers for campus operations."
        why="Changing a worker's PIN here takes effect on their kiosk device within seconds."
        contextLabel="Workers"
        statusSummary="Review current workers state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <CampusStatusBar />
      <div className="p-4 sm:p-6 space-y-4 sm:space-y-6">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <p className="text-sm text-muted">
            Track daily worker shifts, contractor compliance, late check-ins, and duty progress.
          </p>
        </div>
      </div>

      {error && (
        <div className="surface-card p-4 bg-rose-500/10 text-rose-400 text-sm flex items-center gap-2">
          <AlertCircle className="w-5 h-5 shrink-0" />
          <span>{error}</span>
        </div>
      )}

      {loading && shifts.length === 0 ? (
        <div className="flex justify-center items-center py-20">
          <div className="size-6 border-4 border-amber-500 border-t-transparent rounded-full animate-spin" />
        </div>
      ) : (
        <>
          <WorkerShiftTracker shifts={shifts} summary={summary} />
          <Suspense fallback={null}>
            <WorkerMonthlyReviewPanel />
          </Suspense>
          <WorkerTypeAndBlockPanel />
        </>
      )}
    </div>
      </div>
    
    

  );
}
</file>

<file path="src/app/(approver)/deputy-warden/daily-overview/page.tsx">
"use client";

import { Suspense, useCallback, useMemo } from "react";
import Link from "next/link";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import {
  Loader2,
  AlertTriangle,
  UserCheck,
  Inbox,
  DoorOpen,
  Gavel,
} from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

/* response shapes (mirror shared endpoints) */

interface PresenceMatrixData {
  gates: Array<{ id: string; name: string; code: string; audience: string; type: string }>;
  matrix: Record<string, Record<string, number>>;
  lastUpdated: string;
}

interface PresenceMatrixResponse {
  success: boolean;
  data: PresenceMatrixData;
}

interface PermissionRequestRow {
  id: string;
  ticket_number: string;
  workflow_type: string;
  current_stage: string;
  status: string;
  sla_deadline?: string | null;
}

interface PermissionsResponse {
  success: boolean;
  data: PermissionRequestRow[];
  total?: number;
}

/* building blocks */

function StatCard({
  icon: Icon,
  label,
  value,
  sub,
  accent = "text-white",
  loading,
}: {
  icon: React.ComponentType<{ className?: string }>;
  label: string;
  value: React.ReactNode;
  sub?: string;
  accent?: string;
  loading?: boolean;
}) {
  return (
    <div className="surface-card bg-bg-base p-4 flex flex-col gap-2 min-w-0">
      <div className="flex items-center gap-2 text-text-muted min-w-0">
        <Icon className="w-4 h-4 shrink-0" />
        <span className="text-xs font-semibold uppercase tracking-wide truncate">{label}</span>
      </div>
      {loading ? (
        <Loader2 className="w-5 h-5 animate-spin motion-reduce:animate-none text-text-muted" />
      ) : (
        <p className={`text-2xl font-bold ${accent}`}>{value}</p>
      )}
      {sub && <p className="text-xs text-text-muted min-w-0">{sub}</p>}
    </div>
  );
}

function SectionLink({
  href,
  title,
  sub,
}: {
  href: string;
  title: string;
  sub: string;
}) {
  return (
    <Link
      href={href}
      className="surface-card bg-bg-base p-4 min-w-0 hover:bg-bg-elevated/50 transition-colors"
    >
      <p className="text-sm font-semibold text-white">{title}</p>
      <p className="text-xs text-text-muted mt-1">{sub}</p>
    </Link>
  );
}

/* main content */

function DeputyWardenDailyOverviewInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "deputy_warden") as Role;
  const tier = getRoleTier(role);

  const {
    data: presence,
    loading: presenceLoading,
    error: presenceError,
    refresh: refreshPresence,
  } = useApiResource<PresenceMatrixResponse>("/api/occupancy/presence-matrix", { ttlMs: 30_000 });
  const {
    data: outpassQueue,
    loading: outpassLoading,
    error: outpassError,
    refresh: refreshOutpass,
  } = useApiResource<PermissionsResponse>(
    "/api/permissions?workflow_type=hostel&status=PENDING&stage=deputy_warden",
    { ttlMs: 30_000 }
  );

  const refreshAll = useCallback(async () => {
    clearCache();
    await Promise.all([refreshPresence(), refreshOutpass()]);
  }, [refreshPresence, refreshOutpass]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });


  const matrix = presence?.data?.matrix ?? {};
  const gates = presence?.data?.gates ?? [];
  const onCampusTotal = useMemo(
    () =>
      gates.reduce(
        (sum, g) => sum + Object.values(matrix[g.id] ?? {}).reduce((a, b) => a + b, 0),
        0
      ),
    [gates, matrix]
  );

  const pendingRows = outpassQueue?.data ?? [];
  const pendingTotal = outpassQueue?.total ?? pendingRows.length;
  const slaBreached = pendingRows.filter((r) => {
    if (!r.sla_deadline) return false;
    const ts = new Date(r.sla_deadline).getTime();
    return !Number.isNaN(ts) && ts < Date.now();
  }).length;

  const SECTIONS = [
    { href: "/deputy-warden", title: "Outpass Queue", sub: "Outpass and hostel pass requests at warden stage" },
    { href: "/deputy-warden/leave-requests", title: "Leave Requests", sub: "Staff-leave requests awaiting review" },
    { href: "/deputy-warden/gate-movement", title: "Gate Movement", sub: "Live gate presence and movement" },
    { href: "/deputy-warden/incident-reporting", title: "Incident Reporting", sub: "Incident recording and escalation" },
    { href: "/deputy-warden/shift-handover", title: "Shift Handover", sub: "Shift handover notes" },
    { href: "/deputy-warden/delegated-approvals", title: "Delegated Approvals", sub: "Delegation-scoped approval queue" },
    { href: "/deputy-warden/decision-history", title: "Decision History", sub: "Past gate activity and approval decisions" },
  ] as const;

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      {/* Page toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Deputy Warden"
        purpose="Monitor daily campus hostel operations, verify gate movement metrics, and maintain shift readiness"
        why="High-level visibility over in-campus headcounts and pending requests keeps daily warden operations synchronized."
        contextLabel={`Daily Operations Overview · ${onCampusTotal} On Campus`}
        statusSummary={
          pendingTotal > 0
            ? `${pendingTotal} request${pendingTotal === 1 ? "" : "s"} pending review at warden stage.${slaBreached > 0 ? ` ${slaBreached} past SLA deadline.` : ""}`
            : "Campus gates nominal. No pending requests awaiting warden review."
        }
        severity={slaBreached > 0 ? "warn" : pendingTotal > 0 ? "info" : "ok"}
        primaryAction={{ label: "Outpass Queue", href: "/deputy-warden" }}
        secondaryActions={[
          { label: "Gate Movement", href: "/deputy-warden/gate-movement" },
          { label: "Curfew Oversight", href: "/deputy-warden/curfew-oversight" },
          { label: "Shift Handover", href: "/deputy-warden/shift-handover" },
        ]}
      />

      {(presenceError || outpassError) && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">
              Some overview data unavailable: {presenceError || outpassError}
            </span>
          </span>
          <button
            type="button"
            onClick={() => void refreshAll()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      {/* KPI row */}
      <WidgetBoundary title="Daily Overview">
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 min-w-0">
          <Link href="/deputy-warden/gate-movement" className="block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary">
            <StatCard
              icon={UserCheck}
              label="On Campus"
              value={onCampusTotal}
              sub="People inside all active gates (live presence matrix)"
              accent="text-action-success"
              loading={presenceLoading && !presence}
            />
          </Link>
          <Link href="/deputy-warden/leave-requests" className="block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary">
            <StatCard
              icon={Inbox}
              label="Pending at Warden Stage"
              value={pendingTotal}
              sub="Hostel / outpass requests awaiting principal review"
              accent="text-action-warning"
              loading={outpassLoading && !outpassQueue}
            />
          </Link>
          <Link href="/deputy-warden/delegated-approvals" className="block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary">
            <StatCard
              icon={AlertTriangle}
              label="SLA Breached"
              value={slaBreached}
              sub="Warden-stage requests past their 48h deadline"
              accent="text-action-danger"
              loading={outpassLoading && !outpassQueue}
            />
          </Link>
          <Link href="/deputy-warden/gate-movement" className="block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary">
            <StatCard
              icon={DoorOpen}
              label="Reporting Gates"
              value={gates.length}
              sub="Gates currently feeding the presence matrix"
              accent="text-white"
              loading={presenceLoading && !presence}
            />
          </Link>
        </div>
      </WidgetBoundary>

      {/* Authority note */}
      <WidgetBoundary title="Authority Scope">
        <div className="surface-card bg-bg-base p-4 min-w-0">
          <div className="flex flex-col sm:flex-row sm:items-center gap-3 min-w-0">
            <Gavel className="w-5 h-5 text-action-info shrink-0" />
            <p className="text-sm text-text-secondary min-w-0">
              Deputy-warden approvals are effective only <span className="font-semibold text-action-info">within an explicit delegation or standing policy scope</span> issued by the
              principal/warden. Without recorded delegation data, review actions surface as
              read-only here and are escalated to the warden stage.
            </p>
          </div>
        </div>
      </WidgetBoundary>

      {/* Section quick-links */}
      <WidgetBoundary title="Sections">
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 min-w-0">
          {SECTIONS.map((s) => (
            <SectionLink key={s.href} href={s.href} title={s.title} sub={s.sub} />
          ))}
        </div>
      </WidgetBoundary>

