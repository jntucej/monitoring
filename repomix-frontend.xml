"use client";

import { useEffect, useState, useCallback } from "react";
import { Activity } from "lucide-react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { WidgetLoading } from "@/components/admin/shared/LoadingStates";
import { HealthDashboard } from "@/components/admin/HealthDashboard";
import { getAuthHeaders } from "@/lib/utils";
import { usePolling } from "@/hooks/usePolling";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

type ComponentStatus = "healthy" | "degraded" | "unhealthy" | "unknown";

interface HealthSnapshot {
  status: ComponentStatus;
  components: {
    database: { status: ComponentStatus; latency?: number };
    redis?: { status: ComponentStatus; latency?: number };
    gateways: { status: ComponentStatus; online?: number; offline?: number; total?: number };
  };
}

const DOT: Record<ComponentStatus, string> = {
  healthy: "bg-action-success",
  degraded: "bg-action-warning",
  unhealthy: "bg-action-danger",
  unknown: "bg-bg-elevated",
};

function StatusDot({ status, label, detail }: { status: ComponentStatus; label: string; detail?: string }) {
  return (
    <div className="surface-card flex items-center gap-2 bg-bg-surface px-3 py-2">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Manage and monitor health for campus operations."
        why="Use this page first when any other admin surface starts returning errors or slow responses."
        contextLabel="Health"
        statusSummary="Review current health state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <span className={`size-2 rounded-full ${DOT[status]} ${status === "healthy" ? "animate-pulse" : ""}`} />
      <div>
        <p className="text-xs font-medium text-text-primary">{label}</p>
        {detail && <p className="text-xs text-text-muted">{detail}</p>}
      </div>
    </div>
  );
}

function HealthSnapshotBar() {
  const [snap, setSnap] = useState<HealthSnapshot | null>(null);
  const [loading, setLoading] = useState(true);

  const loadSnapshot = useCallback(async (isInitial: boolean) => {
    if (isInitial) setLoading(true);
    try {
      const res = await fetch("/api/admin/health/full", {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      if (!res.ok && res.status !== 503) throw new Error("health unavailable");
      setSnap(await res.json());
    } catch {
      // keep last snapshot on transient error
    } finally {
      if (isInitial) setLoading(false);
    }
  }, []);

  useEffect(() => { void loadSnapshot(true); }, [loadSnapshot]);
  // 30s is enough for a health page; usePolling is visibility-aware.
  usePolling(() => loadSnapshot(false), {
    intervalMs: 30_000,
    enabled: !loading,
  });

  if (loading || !snap) {
    return (
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <WidgetLoading />
        <WidgetLoading />
        <WidgetLoading />
      </div>
    );
  }

  const gateways = snap.components?.gateways;
  return (
    <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <StatusDot
        status={snap.status}
        label="Overall"
        detail={snap.status === "healthy" ? "All systems nominal" : `Status: ${snap.status}`}
      />
      <StatusDot
        status={snap.components?.database?.status ?? "unknown"}
        label="Database"
        detail={typeof snap.components?.database?.latency === "number" ? `${snap.components.database.latency}ms` : undefined}
      />
      <StatusDot
        status={gateways?.status ?? "unknown"}
        label="Gateways"
        detail={typeof gateways?.online === "number" ? `${gateways.online} online / ${gateways?.offline ?? 0} offline` : undefined}
      />
    </div>
  );
}

export default function SystemHealthPage() {
  return (
    <div className="max-w-6xl mx-auto space-y-6">
      <div className="flex items-center gap-3">
        <div className="surface-card p-2 bg-emerald-500/10">
          <Activity className="w-5 h-5 text-action-success" />
        </div>
        <div>
          <h1 className="text-lg font-semibold text-text-primary">System Health</h1>
          <p className="text-xs text-text-muted">
            Live infrastructure status — database, redis, gateways and services.
          </p>
        </div>
      </div>

      <WidgetBoundary title="Health Snapshot">
        <HealthSnapshotBar />
      </WidgetBoundary>

      <WidgetBoundary title="Health Dashboard">
        <HealthDashboard />
      </WidgetBoundary>
    </div>
  );
}
</file>

