<file path="src/app/(admin)/admin/parents/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {Search, Users, RefreshCw, ChevronRight}  from "lucide-react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { EmptyState } from "@/components/admin/shared/EmptyState";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { EntityInspector, KVPairs, InspectorButton, Timeline } from "@/components/shared/EntityInspector";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface ParentRow {
  id: string;
  name: string;
  email: string;
  phone: string | null;
  uniqueId: string | null;
  status: string;
  children: Array<{ id: string; roll: string; name: string; status: string }>;
}

/**
 * Admin Parents — guardian/parent roster with linked children.
 * Backend: /api/parents (admin|sysadmin scope).
 */
function AdminParentsInner() {
  const [rows, setRows] = useState<ParentRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [q, setQ] = useState("");
  const [active, setActive] = useState<ParentRow | null>(null);

  /** Standardized inspection model for a guardian row. */
  const parentInspection = active
    ? {
        kind: "parent",
        title: active.name,
        subtitle: active.uniqueId ?? active.id,
        status: (
          <span className="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-bg-elevated text-text-muted">
            {active.status}
          </span>
        ),
        sections: [
          {
            title: "Overview",
            content: (
              <KVPairs
                items={[
                  { label: "Email", value: active.email },
                  ...(active.phone ? [{ label: "Phone", value: active.phone }] : []),
                  { label: "Linked children", value: String(active.children.length) },
                ]}
              />
            ),
          },
          {
            title: "Linked children",
            content:
              active.children.length === 0 ? (
                <p className="text-xs text-text-muted">No children linked to this guardian.</p>
              ) : (
                <Timeline
                  items={active.children.map((c) => ({
                    label: c.name,
                    detail: c.roll ? `Roll ${c.roll}` : undefined,
                    tone: "neutral" as const,
                  }))}
                />
              ),
          },
          {
            title: "Actions",
            content: (
              <div className="flex flex-wrap gap-2">
                <InspectorButton href="/admin/parents" variant="primary">
                  <ChevronRight className="size-3.5" /> All guardians
                </InspectorButton>
              </div>
            ),
          },
        ],
      }
    : null;


  const load = useCallback(async () => {
    setLoading(true);
    try {
      const res = await fetch(`/api/parents?q=${encodeURIComponent(q)}`, { headers: getAuthHeaders() });
      const body = await res.json();
      setRows((body?.data ?? []) as ParentRow[]);
    } catch (e) {
      console.error("parents", e);
    } finally {
      setLoading(false);
    }
  }, [q]);

  useEffect(() => {
    const t = setTimeout(load, q ? 250 : 0);
    return () => clearTimeout(t);
  }, [load, q]);

  if (loading) {
    return (
      <div className="space-y-4 p-4 md:p-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Manage and monitor parents & guardians for campus operations."
        why="Unlinking a parent here immediately removes their live movement visibility for that student."
        contextLabel="Parents & Guardians"
        statusSummary="Review current parents & guardians state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
        <Skeleton className="h-10 w-48" />
        <Skeleton className="h-72 rounded-2xl" />
      </div>
    );
  }

  return (
    <div className="space-y-6 p-4 md:p-6">
      <PageHeader
        title="Parents & Guardians"
        subtitle={`${rows.length} guardian records with linked children`}
        onRefresh={load}
      />

      <WidgetBoundary title="Guardians">
        <div className="glass-card">
          <div className="surface-card p-4 flex items-center gap-3">
            <div className="relative flex-1">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" />
              <input
                value={q}
                onChange={(e) => setQ(e.target.value)}
                placeholder="Search guardians by name / email / phone…"
                className="surface-card w-full pl-9 pr-3 py-2.5 bg-bg-elevated text-sm text-text-primary focus:outline-none focus:"
              />
            </div>
            <button onClick={load} className="text-text-muted hover:text-text-primary"><RefreshCw className="w-4 h-4" /></button>
          </div>

          {rows.length === 0 ? (
            <EmptyState
              icon={<Users className="w-6 h-6" />}
              title="No guardians found"
              description="Guardians are linked to student records via their ID."
            />
          ) : (
            <div className="divide-y divide-border">
              {rows.map((r) => (
                <div
                  key={r.id}
                  onClick={() => setActive(r)}
                  className="p-4 flex items-start gap-3 cursor-pointer hover:bg-bg-elevated/30 transition"
                >
                  <div className="size-6 rounded-xl bg-bg-elevated flex items-center justify-center text-text-secondary shrink-0">
                    <Users className="w-4 h-4" />
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 flex-wrap">
                      <p className="text-sm font-semibold text-text-primary">{r.name}</p>
                      <span className="surface-card px-2 py-0.5 text-xs bg-bg-elevated text-text-muted uppercase tracking-wide">{r.status}</span>
                      {r.uniqueId && <span className="surface-card px-2 py-0.5 text-xs bg-bg-elevated text-text-muted font-mono">{r.uniqueId}</span>}
                    </div>
                    <p className="text-xs text-text-muted font-mono mt-0.5">{r.email}{r.phone ? ` · ${r.phone}` : ""}</p>
                    <div className="mt-2 flex flex-wrap gap-1.5">
                      {r.children.length === 0 && (
                        <span className="text-xs text-text-muted">No linked children</span>
                      )}
                      {r.children.map((c) => (
                        <span key={c.id} className="surface-card px-2 py-0.5 bg-action-primary/10 text-xs text-action-primary">
                          {c.name} {c.roll ? `· ${c.roll}` : ""}
                        </span>
                      ))}
                    </div>
                  </div>
                  <ChevronRight className="w-4 h-4 text-text-muted shrink-0" />
                </div>
              ))}
            </div>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspector inspection={parentInspection} onClose={() => setActive(null)} />
    </div>
  );
}

export default function AdminParentsPage() {
  return (
    
      <AdminParentsInner />
    
    

  );
}
</file>

<file path="src/app/(admin)/admin/permission-policies/page.tsx">
"use client";

import { useMemo, useState, Suspense, useEffect } from "react";
import { usePersistentQuery } from "@/hooks/usePersistentQuery";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";

import { PageLoading } from "@/components/admin/shared/LoadingStates";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { ShieldCheck, GitBranch, FileCheck, Clock, Users, Search, X, Lock } from "lucide-react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
/* ── response shape (mirrors /api/admin/permission-policies) ─────────────── */

interface PolicyWorkflow {
  workflow_type: string;
  current_stage: string;
  document_required: boolean;
  open_count: number;
  pending_count: number;
  last_seen: string | null;
  first_seen: string | null;
  stages: { stage: string; open: number }[];
  sla_hours: number;
  approver_roles: string[];
}

interface PolicyRole {
  code: string;
  permissions: unknown;
}

interface PermissionPoliciesData {
  workflows: PolicyWorkflow[];
  roles: PolicyRole[];
  note?: string;
}

function SkeletonCard() {
  return (
    <div className="surface-card bg-bg-elevated p-4 space-y-2 animate-pulse">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Workflow stage definitions, SLAs, and open approval requests"
        why="Policy changes here propagate to all sessions and can lock out misconfigured roles — test with a test account first."
        contextLabel="Workflow stage definitions, SLAs, and open approval requests"
        statusSummary="Review current workflow stage definitions, slas, and open approval requests state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <div className="h-3 w-24 rounded bg-bg-elevated" />
      <div className="h-5 w-32 rounded bg-bg-elevated" />
      <div className="h-3 w-40 rounded bg-bg-elevated" />
    </div>
  );
}

function AdminPermissionPoliciesInner() {
  const [query, setQuery] = usePersistentQuery("gate-permission-policies-query");

  const res = useApiResource<{ success: boolean; data: PermissionPoliciesData }>("/api/admin/permission-policies", {
    ttlMs: 30_000,
  });

  usePolling(
    () => {
      clearCache("/api/admin/permission-policies");
      return res.refresh();
    },
    { intervalMs: 60_000 }
  );

  const workflows = res.data?.data?.workflows ?? [];

  const visibleWorkflows = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return workflows;
    return workflows.filter(
      (w) =>
        w.workflow_type.toLowerCase().includes(q) ||
        w.current_stage.toLowerCase().includes(q)
    );
  }, [workflows, query]);

  const loading = res.loading && !res.data;

  return (
    <div className="space-y-4">
      <PageHeader
        title="Permission Policies"
        subtitle="Workflow stage definitions, SLAs, and open approval requests"
      />
      {/* KPI row */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <WidgetBoundary title="Workflow Types">
          <div className="surface-card bg-bg-elevated p-4">
            <div className="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-text-muted">
              <GitBranch className="w-3.5 h-3.5 text-action-success" /> Workflow Types
            </div>
            <div className="mt-1.5 text-xl font-black text-white tabular-nums">
              {loading ? <span className="inline-block w-10 h-5 rounded bg-bg-elevated animate-pulse" /> : workflows.length}
            </div>
            <p className="mt-0.5 text-xs text-text-muted">Defined pass types in circulation</p>
          </div>
        </WidgetBoundary>

        <WidgetBoundary title="Open Requests">
          <div className="surface-card bg-bg-elevated p-4">
            <div className="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-text-muted">
              <FileCheck className="w-3.5 h-3.5 text-action-warning" /> Open Requests
            </div>
            <div className="mt-1.5 text-xl font-black text-white tabular-nums">
              {loading
                ? <span className="inline-block w-10 h-5 rounded bg-bg-elevated animate-pulse" />
                : workflows.reduce((sum, w) => sum + (w.open_count || 0), 0)}
            </div>
            <p className="mt-0.5 text-xs text-text-muted">Across all workflow types</p>
          </div>
        </WidgetBoundary>

        <WidgetBoundary title="Standard SLA">
          <div className="surface-card bg-bg-elevated p-4">
            <div className="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-text-muted">
              <Clock className="w-3.5 h-3.5 text-action-primary" /> Standard SLA
            </div>
            <div className="mt-1.5 text-xl font-black text-white tabular-nums">
              {loading ? <span className="inline-block w-10 h-5 rounded bg-bg-elevated animate-pulse" /> : "48 hrs"}
            </div>
            <p className="mt-0.5 text-xs text-text-muted">Approval turnaround target</p>
          </div>
        </WidgetBoundary>
      </div>

      {/* Workflow table */}
      <WidgetBoundary title="Permission Workflow Policies">
        <div className="rounded-2xl border border-border bg-bg-elevated overflow-hidden">
          <div className="surface-card flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4">
            <div className="flex items-center gap-2 text-sm font-semibold text-white">
              <ShieldCheck className="w-4 h-4 text-action-success" />
              Workflow stage definitions
            </div>
            <div className="relative w-full sm:w-64">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-muted" />
              <input
                type="search"
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="Filter workflows…"
                className="surface-card w-full bg-bg-surface pl-8 pr-8 py-1.5 text-xs text-white placeholder:text-text-muted focus:outline-none focus:"
              />
              {query && (
                <button
                  type="button"
                  onClick={() => setQuery("")}
                  className="absolute right-2 top-1/2 -translate-y-1/2 text-text-muted hover:text-white"
                  aria-label="Clear filter"
                >
                  <X className="w-3.5 h-3.5" />
                </button>
              )}
            </div>
          </div>

          {res.error ? (
            <div className="p-6 text-sm text-action-danger">{res.error}</div>
          ) : loading ? (
            <div className="p-4 space-y-2">
              <SkeletonCard />
              <SkeletonCard />
              <SkeletonCard />
            </div>
          ) : visibleWorkflows.length === 0 ? (
            <div className="p-8 text-center text-sm text-text-muted">
              <p>No workflow definitions match the current filter.</p>
              <button
                type="button"
                onClick={() => setQuery("")}
                className="mt-3 text-xs font-semibold text-action-success hover:text-action-success"
              >
                Clear filter
              </button>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full text-left text-sm min-w175">
                <thead className="bg-bg-surface/60 text-xs uppercase tracking-wide text-text-muted border-b border-border">
                  <tr>
                    <th className="py-2.5 px-4">Workflow</th>
                    <th className="py-2.5 px-4">Current Stage</th>
                    <th className="py-2.5 px-4">Document</th>
                    <th className="py-2.5 px-4">Open / Pending</th>
                    <th className="py-2.5 px-4">SLA</th>
                    <th className="py-2.5 px-4">Approvers</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800/70">
                  {visibleWorkflows.map((w) => (
                    <tr key={w.workflow_type} className="hover:bg-bg-surface/40">
                      <td className="py-3 px-4 font-semibold text-white">{w.workflow_type}</td>
                      <td className="py-3 px-4 text-text-secondary">
                        {w.stages.length > 0 ? (
                          <div className="flex flex-wrap gap-1">
                            {w.stages.map((s) => (
                              <span
                                key={s.stage}
                                className="surface-card inline-flex items-center gap-1 bg-bg-elevated px-2 py-0.5 text-xs text-text-secondary"
                              >
                                {s.stage}
                                {s.open > 0 && <span className="text-action-success tabular-nums">{s.open}</span>}
                              </span>
                            ))}
                          </div>
                        ) : (
                          <span className="text-text-muted">—</span>
                        )}
                      </td>
                      <td className="py-3 px-4 text-text-secondary">{w.document_required ? "Required" : "Optional"}</td>
                      <td className="py-3 px-4 tabular-nums text-text-secondary">
                        {w.open_count} / {w.pending_count}
                      </td>
                      <td className="py-3 px-4 tabular-nums text-text-secondary">{w.sla_hours} hrs</td>
                      <td className="py-3 px-4">
                        <div className="flex flex-wrap gap-1">
                          {w.approver_roles.map((r) => (
                            <span key={r} className="surface-card bg-blue-500/10 px-2 py-0.5 text-xs text-blue-300">
                              {r}
                            </span>
                          ))}
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {/* Role policy (read-only) */}
          <div className="surface-card p-4">
            <div className="flex items-center gap-2 text-xs text-text-muted">
              <Users className="w-3.5 h-3.5 text-action-success" />
              {loading
                ? "Loading role policy…"
                : `${workflows.length > 0 ? workflows.map((w) => w.workflow_type).join(", ") : "N/A"} — role policy entries are managed under Roles.`}
            </div>
          </div>
        </div>
      </WidgetBoundary>

      {/* Read-only notice */}
      <WidgetBoundary title="Editing note">
        <div className="surface-card bg-amber-500/[0.06] p-4 flex items-start gap-3">
          <Lock className="w-4 h-4 text-action-warning shrink-0 mt-0.5" />
          <div>
            <p className="text-sm font-semibold text-action-warning">Read-only view</p>
            <p className="mt-1 text-xs text-text-muted">
              Permission workflow definitions, stage SLAs and role policy are locked for admins — editing
              requires sysadmin access. If a stage, SLA or approver chain is out of date, raise a role
              change request or contact the platform team.
            </p>
          </div>
        </div>
      </WidgetBoundary>

    </div>
  );
}

