<file path="src/app/(supervisor)/supervisor/_retention/CelebrateOverlay.tsx">
"use client";

import { useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { useSupervisorRetention } from "@/stores/supervisorRetentionStore";

/**
 * Fires a small celebration when the queue hits zero AFTER at least one
 * decision this session. Not on the initial empty state — only after a
 * transition from >0 to 0.
 */
export function CelebrateOverlay({ queueEmpty }: { queueEmpty: boolean }) {
  const celebrating = useSupervisorRetention((s) => s.celebrating);
  const sessionDecisions = useSupervisorRetention((s) => s.sessionDecisions);
  const markCelebrated = useSupervisorRetention((s) => s.markCelebrated);

  useEffect(() => {
    if (queueEmpty && sessionDecisions > 0) {
      useSupervisorRetention.setState({ celebrating: true });
      const t = setTimeout(markCelebrated, 1800);
      return () => clearTimeout(t);
    }
  }, [queueEmpty, sessionDecisions, markCelebrated]);

  return (
    <AnimatePresence>
      {celebrating && (
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          className="pointer-events-none fixed inset-0 z-40 flex items-center justify-center"
        >
          <motion.div
            initial={{ scale: 0.5, opacity: 0 }}
            animate={{ scale: 1, opacity: 1 }}
            exit={{ scale: 0.9, opacity: 0 }}
            transition={{ type: "spring", stiffness: 260, damping: 20 }}
            className="surface-card bg-bg-surface px-8 py-6 text-center"
          >
            <p className="text-2xl font-bold text-action-primary">Queue cleared</p>
            <p className="mt-1 text-sm text-text-muted border-0">
              {sessionDecisions} item{sessionDecisions === 1 ? "" : "s"} resolved this shift
            </p>
          </motion.div>

          {/* Confetti dots */}
          {Array.from({ length: 20 }).map((_, i) => (
            <motion.span
              key={i}
              initial={{
                x: 0,
                y: 0,
                opacity: 1,
                scale: 1,
              }}
              animate={{
                x: (Math.random() - 0.5) * 400,
                y: (Math.random() - 0.5) * 300,
                opacity: 0,
                scale: 0.3,
              }}
              transition={{ duration: 1.4, delay: i * 0.02 }}
              className="absolute size-2 rounded-full"
              style={{
                backgroundColor:
                  i % 3 === 0
                    ? "var(--action-primary)"
                    : i % 3 === 1
                    ? "var(--action-warning)"
                    : "var(--action-info)",
              }}
            />
          ))}
        </motion.div>
      )}
    </AnimatePresence>
  );
}
</file>

<file path="src/app/(supervisor)/supervisor/_retention/FocusMode.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { Check, ArrowUpRight, Keyboard, Loader2 } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { useSupervisorRetention } from "@/stores/supervisorRetentionStore";
import { SlaBadge } from "@/components/approver/SlaBadge";
import { useUIStore } from "@/stores/uiStore";

interface PriorityItem {
  id: string;
  kind: "escalation" | "incident";
  ticket: string;
  subject: string;
  slaDeadline: string | null;
  age: string;
  href: string;
}

interface DashboardResponse {
  data: {
    priorityItems: PriorityItem[];
  };
}

export function FocusMode({
  open,
  onClose,
}: {
  open: boolean;
  onClose: () => void;
}) {
  const { data, loading, refresh } = useApiResource<DashboardResponse>(
    open ? "/api/supervisor/dashboard" : null,
    { ttlMs: 5_000 }
  );
  const addToast = useUIStore((s) => s.success);
  const errorToast = useUIStore((s) => s.error);
  const recordWin = useSupervisorRetention((s) => s.recordWin);

  const [index, setIndex] = useState(0);
  const [busy, setBusy] = useState(false);
  const [localItems, setLocalItems] = useState<PriorityItem[] | null>(null);
  const prevItemsRef = useRef<PriorityItem[] | null>(null);

  const items = data?.data?.priorityItems ?? [];
  const effectiveItems: PriorityItem[] = localItems ?? items;
  const current = effectiveItems[index] ?? null;
  const total = effectiveItems.length;
  const remaining = Math.max(0, total - index);

  useEffect(() => {
    if (index >= total && total > 0) setIndex(total - 1);
    if (total === 0) setIndex(0);
  }, [total, index]);

  useEffect(() => {
    if (open) setIndex(0);
  }, [open]);

  const act = useCallback(
    async (action: "escalate" | "resolve") => {
      if (!current || busy) return;
      setBusy(true);
      prevItemsRef.current = effectiveItems;
      const currentId = current.id;
      setLocalItems(effectiveItems.filter((i) => i.id !== currentId));

      const t0 = Date.now();
      try {
        let endpoint = "";
        let body: Record<string, unknown> = {};

        if (current.kind === "escalation") {
          endpoint = `/api/permissions/${current.id}/stepup`;
          body = { action: action === "resolve" ? "APPROVE" : "ESCALATE" };
        } else {
          endpoint = `/api/alerts/${current.id}/resolve`;
          body = { notes: "Resolved in focus mode" };
        }

        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });

        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          setLocalItems(prevItemsRef.current);
          throw new Error(j?.error?.message ?? `HTTP ${res.status}`);
        }

        recordWin({
          ticket: current.ticket,
          kind: current.kind === "incident" ? "incident_resolved" : "escalation_cleared",
          subject: current.subject,
          at: new Date().toISOString(),
          responseMs: Math.max(1000, Date.now() - t0),
        });

        addToast(
          action === "resolve"
            ? `Resolved ${current.ticket}`
            : `Escalated ${current.ticket}`
        );

        setLocalItems(null);
        await refresh();
      } catch (err: unknown) {
        setLocalItems(prevItemsRef.current);
        errorToast(err instanceof Error ? err.message : "Action failed");
      } finally {
        setBusy(false);
      }
    },
    [current, busy, effectiveItems, recordWin, addToast, errorToast, refresh]
  );

  useEffect(() => {
    if (!open) return;
    const onKey = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement | null;
      if (
        target &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          target.isContentEditable)
      ) {
        return;
      }

      if (e.key === "Escape") {
        e.preventDefault();
        onClose();
      } else if (e.key === "a" || e.key === "A") {
        e.preventDefault();
        act("resolve");
      } else if (e.key === "e" || e.key === "E") {
        e.preventDefault();
        act("escalate");
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open, onClose, act]);

  if (!open) return null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4"
      role="dialog"
      aria-modal="true"
    >
      <div className="surface-card relative w-full max-w-2xl bg-bg-surface p-6 sm:p-8">
        <header className="surface-card mb-6 flex items-center justify-between pb-4">
          <div className="flex items-center gap-2">
            <span className="size-4 rounded-full bg-action-primary animate-pulse" />
            <h2 className="text-sm font-semibold uppercase tracking-wider text-text-primary">
              Supervisor Focus Mode
            </h2>
          </div>
          <div className="flex items-center gap-3">
            <span className="text-xs text-text-muted">
              {remaining} remaining
            </span>
            <button
              onClick={onClose}
              aria-label="Close"
              className="flex size-4 min-h-11 min-w-11 items-center justify-center rounded-lg text-text-muted hover:bg-bg-elevated"
            >
              ✕
            </button>
          </div>
        </header>

        {loading ? (
          <div className="flex h-64 items-center justify-center">
            <Loader2 className="size-4 animate-spin text-action-primary" />
          </div>
        ) : !current ? (
          <div className="flex h-64 flex-col items-center justify-center text-center">
            <p className="text-lg font-semibold text-text-primary">
              Queue is completely clear
            </p>
            <p className="mt-1 text-xs text-text-muted">
              No open escalations or urgent alerts left.
            </p>
            <button
              onClick={onClose}
              className="surface-card mt-6 min-h-11 bg-action-primary px-5 py-2 text-sm font-medium text-white"
            >
              Exit Focus Mode
            </button>
          </div>
        ) : (
          <AnimatePresence mode="wait">
            <motion.div
              key={current.id}
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -10 }}
              className="space-y-6"
            >
              <div className="flex items-center justify-between">
                <span className="surface-card bg-bg-elevated px-2.5 py-1 text-xs font-semibold uppercase text-text-muted">
                  {current.kind} · {current.ticket}
                </span>
                {current.slaDeadline && (
                  <SlaBadge slaDeadline={current.slaDeadline} status="PENDING" />
                )}
              </div>

              <div>
                <p className="text-xl font-bold leading-snug text-text-primary">
                  {current.subject}
                </p>
                <p className="mt-1 text-xs text-text-muted">
                  Reported {current.age}
                </p>
              </div>

              <div className="surface-card flex gap-3 pt-4">
                <button
                  disabled={busy}
                  onClick={() => act("resolve")}
                  className="surface-card flex min-h-11 flex-1 items-center justify-center gap-2 bg-action-primary py-3 text-sm font-medium text-white transition hover:bg-action-primary/90 disabled:opacity-50"
                >
                  <Check className="size-4" />
                  Resolve / Clear (A)
                </button>
                <button
                  disabled={busy}
                  onClick={() => act("escalate")}
                  className="surface-card flex min-h-11 flex-1 items-center justify-center gap-2 bg-bg-base py-3 text-sm font-medium text-text-primary transition hover:bg-bg-elevated disabled:opacity-50"
                >
                  <ArrowUpRight className="size-4" />
                  Escalate higher (E)
                </button>
              </div>

              <footer className="flex items-center justify-center gap-4 text-xs text-text-muted">
                <span className="flex items-center gap-1">
                  <Keyboard className="size-4" /> Shortcuts: <kbd className="surface-card px-1">A</kbd> resolve, <kbd className="surface-card px-1">E</kbd> escalate, <kbd className="surface-card px-1">Esc</kbd> exit
                </span>
              </footer>
            </motion.div>
          </AnimatePresence>
        )}
      </div>
    </div>
  );
}
</file>

