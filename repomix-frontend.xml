"use client";

import { useCallback, useEffect, useState } from "react";
import {
  History,
  CheckCircle,
  XCircle,
  ArrowUpRight,
  Clock,
  FileDown,
  RefreshCw,
  AlertTriangle,
} from "lucide-react";
import { usePeriod } from "@/hooks/usePeriod";
import { useExport } from "@/hooks/useExport";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface DecisionHistoryPayload {
  data: {
    period: string;
    limit: number;
    count: number;
    decisions: Array<{
      ticket: string;
      type: string;
      status: string;
      action: string;
      comment: string | null;
      decidedAt: string;
    }>;
    totals: { approved: number; rejected: number; escalated: number };
  };
}

const STATUS_ICON: Record<string, { Icon: typeof CheckCircle; cls: string }> = {
  APPROVED: { Icon: CheckCircle, cls: "text-emerald-500" },
  REJECTED: { Icon: XCircle, cls: "text-rose-500" },
  ESCALATED: { Icon: ArrowUpRight, cls: "text-amber-500" },
  COMPLETED: { Icon: CheckCircle, cls: "text-emerald-500" },
};

// ── Component ─────────────────────────────────────────────────────────────

export function DecisionHistoryPanel() {
  const { period, setPeriod } = usePeriod("this-month");
  const { exportCSV } = useExport();
  const [data, setData] = useState<DecisionHistoryPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/approver/decision-history?period=${period.key === "all-time" ? "all" : period.key}`,
        { headers: getAuthHeaders(), cache: "no-store" }
      );
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load");
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [period.key]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      data.decisions.map((d) => ({
        ticket: d.ticket,
        type: d.type,
        status: d.status,
        comment: d.comment ?? "",
        decidedAt: d.decidedAt,
      })),
      [
        { key: "ticket", header: "Ticket" },
        { key: "type", header: "Type" },
        { key: "status", header: "Decision" },
        { key: "comment", header: "Comment" },
        { key: "decidedAt", header: "Decided At" },
      ],
      `decisions_${data.period.replace(/\s/g, "_")}.csv`
    );
  };

  const t = data?.totals;

  return (
    <WidgetBoundary name="DecisionHistoryPanel" resetKey={period.key}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <History className="h-4 w-4 text-action-primary shrink-0" />
            <div>
              <h2 className="text-sm font-semibold text-text-primary">Decision History</h2>
              <p className="text-xs text-text-muted">Your recent decisions & monthly aggregate</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              disabled={!data}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
            <button
              type="button"
              onClick={() => void load()}
              className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-surface"
            >
              <RefreshCw className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        <PeriodPicker value={period} onChange={setPeriod} allowCustom={false} />

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <div className="grid grid-cols-3 gap-3">
              {Array.from({ length: 3 }).map((_, i) => (
                <Skeleton key={i} className="h-14 rounded-xl" />
              ))}
            </div>
            <Skeleton className="h-40 rounded-xl" />
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-rose-500/10 p-4 text-sm text-rose-600">
            <AlertTriangle className="h-4 w-4 inline mr-1" /> {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {t && !loading && (
          <>
            {/* Monthly aggregate */}
            <div className="grid grid-cols-3 gap-3">
              <div className="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-3">
                <p className="text-xs text-text-muted">Approved</p>
                <p className="text-2xl font-bold text-emerald-500 tabular-nums">{t.approved}</p>
              </div>
              <div className="rounded-xl border border-rose-500/20 bg-rose-500/5 p-3">
                <p className="text-xs text-text-muted">Rejected</p>
                <p className="text-2xl font-bold text-rose-500 tabular-nums">{t.rejected}</p>
              </div>
              <div className="rounded-xl border border-amber-500/20 bg-amber-500/5 p-3">
                <p className="text-xs text-text-muted">Escalated</p>
                <p className="text-2xl font-bold text-amber-500 tabular-nums">{t.escalated}</p>
              </div>
            </div>

            {/* Decision list */}
            {data && data.decisions.length > 0 ? (
              <div className="space-y-1.5">
                {data.decisions.map((d, i) => {
                  const meta = STATUS_ICON[d.status] ?? STATUS_ICON.COMPLETED;
                  const { Icon, cls } = meta;
                  return (
                    <div
                      key={`${d.ticket}-${i}`}
                      className="flex items-center gap-3 rounded-lg border border-border bg-bg-elevated px-3 py-2.5"
                    >
                      <Icon className={cn("h-4 w-4 shrink-0", cls)} />
                      <div className="min-w-0 flex-1">
                        <p className="text-sm font-medium text-text-primary truncate">{d.type}</p>
                        {d.comment && (
                          <p className="text-xs text-text-muted truncate">{d.comment}</p>
                        )}
                      </div>
                      <div className="text-right shrink-0">
                        <p className={cn("text-xs font-semibold uppercase", cls)}>{d.status}</p>
                        <p className="text-[10px] text-text-muted tabular-nums">{d.decidedAt}</p>
                      </div>
                    </div>
                  );
                })}
              </div>
            ) : (
              <EmptyState title="No decisions in this period" description="Your recent decisions will appear here." />
            )}
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default DecisionHistoryPanel;
</file>

<file path="src/components/approver/DeputyWardenCommandBar.tsx">
"use client";

/**
 * DeputyWardenCommandBar — Cmd/Ctrl+K command palette for the Deputy Warden
 * console.
 *
 * Extends the PermissionCommandBar parser with two deputy-warden-specific
 * commands:
 *   forward <ticket> to <role>   POST /api/permissions/<ticket>/forward
 *                                { targetRole, comment: "to <role>" }
 *   delegate <role> till <date>  GET /api/deputy-warden/delegation (read-only
 *                                state; no POST ledger exists yet) + toast
 *
 * All other commands (approve / reject / escalate) behave exactly like the
 * base PermissionCommandBar: PATCH /api/permissions/<ticket>.
 *
 * Keyboard: up/down to navigate, Enter to execute, Escape to close.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  CheckCircle,
  XCircle,
  AlertTriangle,
  ArrowRight,
  KeyRound,
  Search,
  ChevronRight,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { getConsoleConfig } from "@/config/consoles";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
}

/** All available deputy-warden command definitions. */
const COMMAND_DEFS: CommandDef[] = [
  {
    id: "approve",
    label: "Approve a permission",
    hint: "approve <ticket> — Approve a pending permission",
    icon: CheckCircle,
  },
  {
    id: "reject",
    label: "Reject a permission",
    hint: "reject <ticket> [reason] — Reject with optional reason",
    icon: XCircle,
  },
  {
    id: "escalate",
    label: "Escalate to next stage",
    hint: "escalate <ticket> — Escalate to the next stage",
    icon: AlertTriangle,
  },
  {
    id: "forward",
    label: "Forward a ticket to a higher role",
    hint: "forward <ticket> to <role> — Forward to a strictly-higher role",
    icon: ArrowRight,
  },
  {
    id: "delegate",
    label: "Check delegation state",
    hint: "delegate <role> till <date> — Read active delegation scopes",
    icon: KeyRound,
  },
];

type Action =
  | "APPROVE"
  | "REJECT"
  | "ESCALATE"
  | "FORWARD"
  | "DELEGATE"
  | "UNKNOWN";

interface ParsedCommand {
  action: Action;
  ticket: string;
  reason: string;
  /** Forward target role (from "to <role>"). */
  targetRole: string;
  /** Delegation target role (from "delegate <role> ..."). */
  delegateRole: string;
  /** Delegation expiry date (from "till <date>"). */
  validUntil: string;
}

/**
 * Parse a deputy-warden free-text command.
 *
 *   approve <ticket>
 *   reject <ticket> [reason...]
 *   escalate <ticket>
 *   forward <ticket> to <role>
 *   delegate <role> till <date>
 */
function parseCommand(input: string): ParsedCommand {
  const tokens = input.trim().split(/\s+/);
  const first = (tokens[0] || "").toLowerCase();
  const empty: ParsedCommand = {
    action: "UNKNOWN",
    ticket: "",
    reason: "",
    targetRole: "",
    delegateRole: "",
    validUntil: "",
  };

  if (first === "approve") {
    return { ...empty, action: "APPROVE", ticket: tokens[1] ?? "" };
  }
  if (first === "reject") {
    const rest = tokens.slice(2).join(" ");
    return { ...empty, action: "REJECT", ticket: tokens[1] ?? "", reason: rest };
  }
  if (first === "escalate") {
    return { ...empty, action: "ESCALATE", ticket: tokens[1] ?? "" };
  }
  if (first === "forward") {
    // forward <ticket> to <role>
    const ticket = tokens[1] ?? "";
    const toIdx = tokens.findIndex((t) => t.toLowerCase() === "to");
    const targetRole = toIdx > 0 ? tokens[toIdx + 1] ?? "" : "";
    return { ...empty, action: "FORWARD", ticket, targetRole };
  }
  if (first === "delegate") {
    // delegate <role> till <date>
    const delegateRole = tokens[1] ?? "";
    const tillIdx = tokens.findIndex((t) => t.toLowerCase() === "till");
    const validUntil = tillIdx > 0 ? tokens[tillIdx + 1] ?? "" : "";
    return { ...empty, action: "DELEGATE", delegateRole, validUntil };
  }
  return { ...empty, action: "UNKNOWN" };
}

export interface DeputyWardenCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function DeputyWardenCommandBar({ role, open, onClose }: DeputyWardenCommandBarProps) {
  const addToast = useUIStore((s) => s.addToast);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const [busy, setBusy] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id));
  }, [role]);

  const filtered = useMemo(() => {
    if (!query.trim()) return available;
    const q = query.toLowerCase();
    return available.filter(
      (c) => c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q),
    );
  }, [query, available]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  const executeCommand = useCallback(
    async (parsed: ParsedCommand) => {
      // ── delegate: read-only delegation state (no POST ledger yet) ──
      if (parsed.action === "DELEGATE") {
        if (!parsed.delegateRole) {
          addToast({ variant: "error", message: "Usage: delegate <role> till <date>" });
          return;
        }
        setBusy(true);
        try {
          const res = await fetch("/api/deputy-warden/delegation", {
            method: "GET",
            headers: getAuthHeaders(),
          });
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            const data = json.data as {
              active: boolean;
              scopes: string[];
              note: string;
            };
            addToast({
              variant: data.active ? "success" : "info",
              message: data.active
                ? `Delegation active for ${parsed.delegateRole} (till ${parsed.validUntil || "no recorded expiry"}). Scopes: ${data.scopes.join(", ")}`
                : `${parsed.delegateRole}: ${data.note}`,
            });
            onClose();
          } else {
            addToast({
              variant: "error",
              message: json?.error?.message || "Failed to read delegation state",
            });
          }
        } catch {
          addToast({ variant: "error", message: "Network error while reading delegation state" });
        } finally {
          setBusy(false);
        }
        return;
      }

      if (parsed.action === "UNKNOWN") {
        addToast({ variant: "error", message: "Unknown command. Type a command from the list below." });
        return;
      }

      // ── forward: POST /api/permissions/<ticket>/forward ──
      if (parsed.action === "FORWARD") {
        if (!parsed.ticket || !parsed.targetRole) {
          addToast({ variant: "error", message: "Usage: forward <ticket> to <role>" });
          return;
        }
        setBusy(true);
        try {
          const res = await fetch(
            `/api/permissions/${encodeURIComponent(parsed.ticket)}/forward`,
            {
              method: "POST",
              headers: getAuthHeaders(),
              body: JSON.stringify({
                targetRole: parsed.targetRole,
                comment: `to ${parsed.targetRole}`,
              }),
            }
          );
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            addToast({
              variant: "success",
              message: `Forwarded ${parsed.ticket} to ${parsed.targetRole}`,
            });
            onClose();
          } else {
            addToast({
              variant: "error",
              message:
                json?.error?.message ||
                `Failed to forward ${parsed.ticket} to ${parsed.targetRole}`,
            });
          }
        } catch {
          addToast({ variant: "error", message: "Network error while forwarding ticket" });
        } finally {
          setBusy(false);
        }
        return;
      }

      // ── approve / reject / escalate: PATCH /api/permissions/<ticket> ──
      if (!parsed.ticket) {
        addToast({ variant: "error", message: "Usage: <action> <ticket>" });
        return;
      }

      const body: Record<string, string> = { action: parsed.action };
      if (parsed.reason) body.comment = parsed.reason;

      setBusy(true);
      try {
        const res = await fetch(
          `/api/permissions/${encodeURIComponent(parsed.ticket)}`,
          {
            method: "PATCH",
            headers: getAuthHeaders(),
            body: JSON.stringify(body),
          }
        );
        const json = await res.json().catch(() => null);
        if (res.ok && json?.success) {
          addToast({
            variant: parsed.action === "REJECT" ? "info" : "success",
            message: `${parsed.action} processed for ${parsed.ticket}`,
          });
          onClose();
        } else {
          addToast({
            variant: "error",
            message:
              json?.error?.message || `Failed to ${parsed.action} ${parsed.ticket}`,
          });
        }
      } catch {
        addToast({ variant: "error", message: "Network error while processing command" });
      } finally {
        setBusy(false);
      }
    },
    [addToast, onClose],
  );

  const handleSelect = useCallback(
    (cmd: CommandDef) => {
      // Selecting a command from the list fills the input so the user can
      // type the ticket / role / date inline.
      setQuery(cmd.id === "delegate" ? "delegate " : `${cmd.id} `);
      inputRef.current?.focus();
    },
    [],
  );

  const handleEnter = useCallback(() => {
    const parsed = parseCommand(query);
    const first = query.trim().toLowerCase();
    // Bare keywords: keep focus so the user can type the remaining tokens.
    if (["approve", "reject", "escalate", "forward", "delegate"].includes(first)) {
      // "forward" and "delegate" need more than a bare keyword — keep focus.
      // For approve/reject/escalate, only keep focus when no ticket is yet.
      if (first === "forward" || first === "delegate" || parsed.action === "UNKNOWN" || !parsed.ticket && parsed.action !== "DELEGATE") {
        inputRef.current?.focus();
        return;
      }
    }
    executeCommand(parsed);
  }, [executeCommand, query]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!query.trim()) {
          if (filtered[active]) handleSelect(filtered[active]);
        } else {
          handleEnter();
        }
      }
    },
    [filtered, active, handleSelect, handleEnter, query],
  );

  if (!open) return null;

  const parsedPreview = query.trim() ? parseCommand(query) : null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="Deputy Warden command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={`Deputy Warden command (role: ${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="Deputy Warden command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Parsed-command preview */}
        {parsedPreview && parsedPreview.action !== "UNKNOWN" ? (
          <div className="surface-card px-4 py-2 bg-bg-elevated text-xs text-text-secondary">
            <span className="font-mono font-bold text-action-primary">
              {parsedPreview.action}
            </span>
            {parsedPreview.action === "FORWARD" ? (
              <>
                {parsedPreview.ticket ? (
                  <span className="ml-1.5 font-mono">{parsedPreview.ticket}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[ticket required]</span>
                )}
                {parsedPreview.targetRole ? (
                  <span className="ml-1.5 text-text-muted italic">to {parsedPreview.targetRole}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[role required]</span>
                )}
              </>
            ) : parsedPreview.action === "DELEGATE" ? (
              <>
                {parsedPreview.delegateRole ? (
                  <span className="ml-1.5 font-mono">{parsedPreview.delegateRole}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[role required]</span>
                )}
                {parsedPreview.validUntil ? (
                  <span className="ml-1.5 text-text-muted italic">till {parsedPreview.validUntil}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[date required]</span>
                )}
              </>
            ) : (
              <>
                {parsedPreview.ticket ? (
                  <span className="ml-1.5 font-mono">{parsedPreview.ticket}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[ticket required]</span>
                )}
                {parsedPreview.reason ? (
                  <span className="ml-1.5 text-text-muted italic">reason: {parsedPreview.reason}</span>
                ) : null}
              </>
            )}
            {busy ? <span className="ml-2 text-text-muted">processing…</span> : null}
          </div>
        ) : null}

        {/* Command list */}
        <ul role="listbox" aria-label="Deputy Warden commands" className="max-h-56 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors disabled:opacity-50 ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>
      </div>
    </div>
  );
}
</file>

<file path="src/components/approver/DigitalSignPanel.tsx">
"use client";

import React, { useState } from "react";
import { PenTool, Download, Eye, AlertCircle, CheckCircle2, Hash } from "lucide-react";
import { Button } from "@/components/ui/button";
import { useUIStore } from "@/stores/uiStore";
import { useApi } from "@/hooks/useApi";
import type { PermissionStatus } from "@/lib/types";

export interface DigitalSignPanelProps {
  ticketNumber: string;
  workflowType: "exam" | "memo";
  currentStage: string;
  status: PermissionStatus;
  documentUrl?: string | null;
  digitalSignature?: string | null;
  onSigned?: () => void;
}

const MAX_NOTE = 200;

/**
 * DigitalSignPanel — Principal-facing panel to digitally sign an exam/memo
 * request once the student's PDF has uploaded and the ticket sits at the
 * `principal` stage. On success the ticket flips to COMPLETED; a completed card
 * then shows the truncated signature hash and a signed-PDF download.
 */
export function DigitalSignPanel({
  ticketNumber,
  workflowType,
  currentStage,
  status,
  documentUrl,
  digitalSignature,
  onSigned,
}: DigitalSignPanelProps) {
  const api = useApi();
  const addToast = useUIStore((s) => s.addToast);
  const [note, setNote] = useState("");
  const [signing, setSigning] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const isExamMemo = workflowType === "exam" || workflowType === "memo";
  const docHref = `/api/permissions/${encodeURIComponent(ticketNumber)}/document`;

  const isCompleted = status === "COMPLETED" && Boolean(digitalSignature);
  const canSign =
    isExamMemo && status === "PENDING" && currentStage === "principal" && Boolean(documentUrl);
  const awaitingDoc =
    isExamMemo && status === "PENDING" && currentStage === "principal" && !documentUrl;

  if (!isExamMemo) return null;
  if (!isCompleted && !canSign && !awaitingDoc) return null;

  const handleSign = async () => {
    if (signing) return;
    setSigning(true);
    setError(null);
    try {
      const res = await fetch(`/api/permissions/${encodeURIComponent(ticketNumber)}/sign`, {
        method: "POST",
        headers: api.getHeaders(),
        body: JSON.stringify({ signatureNote: note.trim() || undefined }),
      });
      const json = await res.json().catch(() => null);
      if (json?.success) {
        addToast({ message: "Document signed successfully.", variant: "success", title: "Signed" });
        setNote("");
        onSigned?.();
      } else {
        setError(json?.error?.message || "Signing failed. Please try again.");
      }
    } catch {
      setError("Network error while signing.");
    } finally {
      setSigning(false);
    }
  };

  // Completed: show signature hash + signed download.
  if (isCompleted) {
    return (
      <div className="surface-card p-3 bg-emerald-500/10 space-y-2">
        <div className="flex items-center gap-2">
          <CheckCircle2 className="w-4 h-4 text-action-success" />
          <span className="text-xs font-bold text-action-success uppercase tracking-wider">
            Digitally Signed
          </span>
        </div>
        <div className="flex items-center gap-1.5 text-xs text-text-secondary">
          <Hash className="w-3.5 h-3.5 text-text-muted" />
          <span className="font-mono">{String(digitalSignature).slice(0, 12)}…</span>
        </div>
        <a
          href={docHref}
          target="_blank"
          rel="noopener noreferrer"
          className="inline-flex items-center gap-1.5 text-xs font-semibold text-action-primary hover:underline"
        >
          <Download className="w-3.5 h-3.5" />
          Download Signed PDF
        </a>
      </div>
    );
  }

  // Awaiting the student's upload.
  if (awaitingDoc) {
    return (
      <p className="text-xs text-text-muted italic">
        Waiting for student to upload document.
      </p>
    );
  }

  // Ready to sign.
  return (
    <div className="space-y-3">
      <a
        href={docHref}
        target="_blank"
        rel="noopener noreferrer"
        className="inline-flex items-center gap-1.5 text-xs font-semibold text-action-primary hover:underline"
      >
        <Eye className="w-3.5 h-3.5" />
        Preview PDF
      </a>

      <div className="space-y-1">
        <label htmlFor="sign-note" className="text-xs text-text-muted font-medium">
          Signature note (optional)
        </label>
        <input
          id="sign-note"
          type="text"
          maxLength={MAX_NOTE}
          value={note}
          onChange={(e) => setNote(e.target.value)}
          disabled={signing}
          placeholder="Optional note (max 200 characters)"
          className="surface-card w-full p-2.5 bg-bg-base text-xs font-semibold text-text-primary focus:outline-none focus:ring-2 focus:ringfocus-ring disabled:opacity-50"
        />
      </div>

      {error && (
        <div className="surface-card flex items-start gap-2 p-2.5 bg-rose-500/10">
          <AlertCircle className="w-4 h-4 text-action-danger shrink-0 mt-0.5" />
          <p className="text-xs text-action-danger font-medium">{error}</p>
        </div>
      )}

      <Button size="sm" onClick={handleSign} disabled={signing} loading={signing}>
        {!signing && <PenTool className="w-3.5 h-3.5 mr-1" />}
        {signing ? "Signing..." : "Sign Digitally"}
      </Button>
    </div>
  );

}
export default DigitalSignPanel;
</file>

<file path="src/components/approver/DirectGenerateModal.tsx">
"use client";

import React, { useMemo, useState } from "react";
import { Lock, Zap } from "lucide-react";
import { Modal } from "@/components/ui/modal";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Select, type SelectOption } from "@/components/ui/select";
import { useApi } from "@/hooks/useApi";
import { useUIStore } from "@/stores/uiStore";
import { requiresStepup } from "@/lib/permission-workflow-pure";
import { PASS_TYPE_SEED, type PassTypeConfig } from "@/lib/pass-types";

// The old DirectGenReason union is replaced by a config-driven list.
// Only configs marked `isDirectGen` appear in the direct-generate modal.
const DIRECT_GEN_CODES: string[] = PASS_TYPE_SEED
  .filter((c: PassTypeConfig) => c.code !== "outpass_home" || c.persona === "hosteller")
  .map((c: PassTypeConfig) => c.code);

// Back-compat: map legacy reason codes to their config equivalent
const LEGACY_CODE_MAP: Record<string, string> = {
  home_out: "outpass_home",
  day_pass: "day_out",
  emergency: "emergency_leave",
  special_leave: "medical_leave",
};

// Resolve a legacy code to a config (or fall back to the first config).
function getConfig(code: string): PassTypeConfig {
  return PASS_TYPE_SEED.find((c) => c.code === code) ?? PASS_TYPE_SEED[0];
}

export interface DirectGenerateModalProps {
  isOpen: boolean;
  onClose: () => void;
  /** The actor's current role (from the auth store). */
  actorRole: string;
  /** Fired after a pass is generated so the caller can refresh. */
  onGenerated?: () => void;
  /** Pre-fill the student user id (from the open ticket). */
  defaultStudentUserId?: string;
  /** Pre-fill the student display name (from the open ticket). */
  defaultStudentName?: string;
  /** Pre-fill the student's live entry type (day_scholar home_out gate). */
  defaultStudentEntryType?: "hosteller" | "day_scholar" | null;
  /** Ticket number to surface in the success toast. */
  ticketNumber?: string;
}

/**
 * Modal that generates a hostel pass directly, bypassing the staged chain.
 * L2+ approvers only (the button that opens this modal is already gated on
 * the caller's role; the server re-checks the same DIRECT_GENERATE_ROLES
 * list). Student lookup is by roll number or user id; reason and window are
 * validated server-side (duration limits, home_out being unlimited).
 */
export function DirectGenerateModal({
  isOpen,
  onClose,
  actorRole,
  onGenerated,
  defaultStudentUserId,
  defaultStudentName,
  defaultStudentEntryType,
  ticketNumber,
}: DirectGenerateModalProps) {
  const api = useApi();
  const addToast = useUIStore((s) => s.addToast);

  const [studentQuery, setStudentQuery] = useState("");
  const [studentUserId, setStudentUserId] = useState(defaultStudentUserId ?? "");
  const [studentName, setStudentName] = useState(defaultStudentName ?? "");
  /** Live entry type of the looked-up student (drives the room-field gate). */
  const [studentEntryType, setStudentEntryType] = useState<"hosteller" | "day_scholar" | null>(
    defaultStudentEntryType ?? null,
  );
  const [reason, setReason] = useState<string>("outpass_home");
  const [from, setFrom] = useState("");
  const [to, setTo] = useState("");
  const [note, setNote] = useState("");
  const [stepupPassword, setStepupPassword] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [submitting, setSubmitting] = useState(false);
  const [looking, setLooking] = useState(false);
  // Room-assignment fields (day_scholar home_out flow).
  const [pendingHostelBlock, setPendingHostelBlock] = useState("");
  const [pendingRoomNumber, setPendingRoomNumber] = useState("");
  const [pendingWardenId, setPendingWardenId] = useState("");

  // Config-driven: only show codes whose config allows direct generation.
  const reasonOptions: SelectOption[] = DIRECT_GEN_CODES.map((code) => ({
    value: code,
    label: getConfig(code).label,
  }));

  const activeConfig = getConfig(reason);
  const toRequired = activeConfig.code !== "outpass_home";
  const roomFieldsRequired = activeConfig.code === "outpass_home" && studentEntryType === "day_scholar";

  const stepupRequired = useMemo(
    () => requiresStepup({ actorRole, action: "direct_generate", reason }),
    [actorRole, reason],
  );

  const lookupStudent = async () => {
    const q = studentQuery.trim();
    if (!q) {
      setError("Enter a roll number or user id to look up the student");
      return;
    }
    setLooking(true);
    setError(null);
    try {
      const res = await fetch(`/api/students?q=${encodeURIComponent(q)}`, {
        headers: api.getHeaders(),
        cache: "no-store",
      });
      const json = await res.json();
      if (res.status === 403) {
        addToast({
          message: json.error?.message || "Your role may not list students; enter the user id directly.",
          variant: "error",
        });
        setLooking(false);
        return;
      }
      const rows: Array<{
        id?: string;
        uniqueId?: string;
        roll?: string;
        name?: string;
        student_details?: { roll?: string; current_entry_type?: "hosteller" | "day_scholar" | null } | null;
        studentDetails?: { roll?: string; currentEntryType?: "hosteller" | "day_scholar" | null } | null;
      }> | undefined = json.data;
      if (json.success && Array.isArray(rows) && rows.length > 0) {
        // Prefer a match whose roll or id equals the query.
        const norm = q.toUpperCase();
        const match =
          rows.find((r) => r.id === q || r.uniqueId === q) ??
          rows.find((r) => r.student_details?.roll?.toUpperCase() === norm) ??
          rows.find((r) => r.roll?.toUpperCase() === norm) ??
          rows[0];
        setStudentUserId(match.id || match.uniqueId || "");
        setStudentName(
          match.name || match.student_details?.roll || match.roll || q,
        );
        // Capture the live entry type so the room-field gate can apply. The
        // mPerson mapping exposes it camelCased on studentDetails.
        const entryType =
          match.studentDetails?.currentEntryType ??
          match.student_details?.current_entry_type ??
          null;
        setStudentEntryType(entryType);
        setPendingHostelBlock("");
        setPendingRoomNumber("");
        setPendingWardenId("");
      } else if (json.success && Array.isArray(rows) && rows.length === 0) {
        setError(`No student found for ${q}`);
      } else {
        setError(json.error?.message || "Student lookup failed");
      }
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : "Network error");
    } finally {
      setLooking(false);
    }
  };

  const submit = async () => {
    if (!studentUserId) {
      setError("Look up the student first (roll number or user id)");
      return;
    }
    if (!from) {
      setError("From timestamp is required");
      return;
    }
    if (toRequired && !to) {
      setError("To timestamp is required for this reason");
      return;
    }
    if (roomFieldsRequired && (!pendingHostelBlock.trim() || !pendingRoomNumber.trim() || !pendingWardenId.trim())) {
      setError("All three room fields are required for day scholar home-out approval");
      return;
    }
    setSubmitting(true);
    setError(null);
    try {
      const res = await fetch("/api/permissions/direct-generate", {
        method: "POST",
        headers: api.getHeaders(),
        body: JSON.stringify({
          studentUserId,
          reason,
          from,
          to: toRequired ? to : null,
          ...(note.trim() ? { note: note.trim() } : {}),
          ...(stepupRequired ? { stepupPassword } : {}),
          ...(roomFieldsRequired
            ? {
                pendingHostelBlock: pendingHostelBlock.trim(),
                pendingRoomNumber: pendingRoomNumber.trim(),
                pendingWardenId: pendingWardenId.trim(),
              }
            : {}),
        }),
      });
      const json = await res.json();
      if (res.status === 403) {
        addToast({
          message: json.error?.message || "Step-up verification failed or you are locked out.",
          variant: "error",
        });
        setSubmitting(false);
        return;
      }
      if (json.success) {
        addToast({
          message: `Direct ${getConfig(reason).label} pass generated for ${studentName || studentUserId}${ticketNumber ? ` (${ticketNumber})` : ""}`,
          variant: "success",
        });
        onClose();
        if (onGenerated) onGenerated();
      } else {
        setError(json.error?.message || "Direct-generate was not accepted");
      }
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : "Network error");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <Modal isOpen={isOpen} onClose={onClose} title="Generate Pass (direct)" size="md">
      <div className="space-y-4">
        <p className="text-xs text-text-secondary">
          Generate an approved pass directly, bypassing the staged chain.
        </p>

        <div className="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div className="sm:col-span-2">
            <label className="block text-xs font-medium text-text-muted mb-1 uppercase">
              Student (roll or user id)
            </label>
            <Input
              value={studentQuery}
              onChange={(e) => setStudentQuery(e.target.value)}
              placeholder="Enter roll number or user id"
            />
          </div>
          <div className="flex items-end">
            <Button size="sm" variant="secondary" onClick={lookupStudent} loading={looking} className="w-full">
              Look up
            </Button>
          </div>
        </div>

        {studentUserId && (
          <div className="flex items-center gap-1.5 text-xs text-text-secondary">
            <span className="font-semibold text-text-primary">{studentName || "Student"}</span>
            <span className="text-text-muted font-mono">({studentUserId})</span>
            {studentEntryType === "day_scholar" && (
              <span className="surface-card px-1.5 py-0.5 text-xs font-semibold bg-amber-500/10 text-action-warning">
                Day Scholar
              </span>
            )}
          </div>
        )}

        {roomFieldsRequired && (
          <div className="surface-card p-3 bg-bg-surface space-y-2">
            <p className="text-xs font-semibold text-text-secondary uppercase tracking-wide">
              Hostel Room Assignment (required for day scholar home out)
            </p>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <div>
                <label className="block text-xs font-medium text-text-muted mb-1">
                  Hostel Block
                </label>
                <Input
                  value={pendingHostelBlock}
                  onChange={(e) => setPendingHostelBlock(e.target.value)}
                  placeholder="e.g. A"
                />
              </div>
              <div>
                <label className="block text-xs font-medium text-text-muted mb-1">
                  Room Number
                </label>
                <Input
                  value={pendingRoomNumber}
                  onChange={(e) => setPendingRoomNumber(e.target.value)}
                  placeholder="e.g. 12"
                />
              </div>
              <div>
                <label className="block text-xs font-medium text-text-muted mb-1">
                  Warden ID
                </label>
                <Input
                  value={pendingWardenId}
                  onChange={(e) => setPendingWardenId(e.target.value)}
                  placeholder="Warden user id"
                />
              </div>
            </div>
          </div>
        )}

        <div className="grid grid-cols-2 gap-3">
          <div>
            <label className="block text-xs font-medium text-text-muted mb-1 uppercase">
              Reason
            </label>
            <Select
              options={reasonOptions}
              value={reason}
              onChange={(v) => setReason(v)}
            />
          </div>
          <div>
            <label className="block text-xs font-medium text-text-muted mb-1 uppercase">
              Note
            </label>
            <Input
              value={note}
              onChange={(e) => setNote(e.target.value)}
              placeholder="Optional"
            />
          </div>
        </div>

        <div className="grid grid-cols-2 gap-3">
          <div>
            <label className="block text-xs font-medium text-text-muted mb-1 uppercase">
              From
            </label>
            <Input
              type="datetime-local"
              value={from}
              onChange={(e) => setFrom(e.target.value)}
            />
          </div>
          <div>
            <label className="block text-xs font-medium text-text-muted mb-1 uppercase">
              To {toRequired ? "" : "(optional for home out)"}
            </label>
            <Input
              type="datetime-local"
              value={to}
              onChange={(e) => setTo(e.target.value)}
              disabled={!toRequired}
            />
          </div>
        </div>

        {stepupRequired && (
          <div className="surface-card p-3 bg-amber-500/10 space-y-2">
            <div className="flex items-center gap-1.5 text-action-warning text-xs font-semibold">
              <Lock className="w-3.5 h-3.5" />
              Step-up password required
            </div>
            <Input
              type="password"
              value={stepupPassword}
              onChange={(e) => setStepupPassword(e.target.value)}
              placeholder="Enter your approval password"
            />
          </div>
        )}

        {error && (
          <div className="surface-card p-3 bg-rose-500/10 text-action-danger text-xs">
            {error}
          </div>
        )}

        <div className="flex items-center justify-end gap-2 pt-2">
          <Button size="sm" variant="secondary" onClick={onClose} disabled={submitting}>
            Cancel
          </Button>
          <Button size="sm" variant="primary" onClick={submit} loading={submitting} disabled={submitting}>
            <Zap className="w-3.5 h-3.5 mr-1" />
            Generate Pass
          </Button>
        </div>
      </div>
    </Modal>
  );
}

export default DirectGenerateModal;
</file>

<file path="src/components/approver/EscalationPanel.tsx">
"use client";

/**
 * EscalationPanel — per-row escalation board for the supervisor console.
 *
 * Desktop: right-side panel (rendered by RoleConsole alongside the board).
 * Mobile: full-width section below the board. No horizontal scroll.
 *
 * Reads GET /api/supervisor/escalations and renders a filterable list of
 * open items (escalated permissions + active alerts) with per-row
 * Assign / Resolve / Escalate actions.
 *
 * Filter tabs: All | Alerts | Escalated | Overdue (client-side filter).
 * Red banner at top when critical alert count > 0.
 */

import { useMemo, useCallback, useState } from "react";
import {
  Radio,
  Clock,
  ShieldAlert,
  Loader2,
  CheckCircle,
  XCircle,
  AlertTriangle,
  UserPlus,
  ChevronDown,
} from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { useAuthStore } from "@/stores/authStore";
import { LADDER, nextActor, isValidForward } from "@/lib/escalation-ladder";
import type { Domain } from "@/lib/permission-model";

/* ── response shapes (mirror the API route) ───────────────────────── */

interface EscalatedPermissionRow {
  ticket_number: string;
  workflow_type: string;
  status: string;
  current_stage: string;
  sla_deadline: string | null;
  student_name: string | null;
  created_at: string;
}

interface ActiveAlertRow {
  id: string;
  severity: string;
  title: string;
  message: string;
  gate_id: string | null;
  gate_name: string | null;
  timestamp: string;
}

interface DecisionRow {
  action: string;
  user_name: string | null;
  user_role: string | null;
  details: string;
  timestamp: string;
}

interface EscalationsResponse {
  success?: boolean;
  data: {
    escalatedPermissions: EscalatedPermissionRow[];
    activeAlerts: ActiveAlertRow[];
    recentDecisions: DecisionRow[];
    counts: { escalated: number; alerts: number; decisions: number };
  };
}

interface AssigneeRow {
  id: string;
  name: string;
  role: string;
}

interface AssigneesResponse {
  success?: boolean;
  data: AssigneeRow[];
}

/* ── merged row type ──────────────────────────────────────────────── */

type FilterCategory = "all" | "alerts" | "escalated" | "overdue";

interface MergedRow {
  key: string;
  type: "alert" | "escalation";
  severity: string;
  title: string;
  gate: string;
  assignedTo: string | null;
  age: string;
  slaBadge: string | null;
  alertId: string | null;
  ticketNumber: string | null;
  isOverdue: boolean;
  /** The ticket's domain (for escalation ladder routing). */
  domain?: Domain;
}

const FILTER_CATEGORIES: Array<{ id: FilterCategory; label: string }> = [
  { id: "all", label: "All" },
  { id: "alerts", label: "Alerts" },
  { id: "escalated", label: "Escalated" },
  { id: "overdue", label: "Overdue" },
];

/** Compute a human-readable age string from an ISO timestamp. */
function fmtAge(iso: string | null | undefined): string {
  if (!iso) return "—";
  try {
    const diff = Date.now() - new Date(iso).getTime();
    const mins = Math.floor(diff / 60_000);
    if (mins < 1) return "now";
    if (mins < 60) return `${mins}m`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs}h ${mins % 60}m`;
    const days = Math.floor(hrs / 24);
    return `${days}d ${hrs % 24}h`;
  } catch {
    return "—";
  }
}

export interface EscalationPanelProps {
  /** Optional refresh callback; called when a row action completes. */
  onRefresh?: () => void;
}

export function EscalationPanel({ onRefresh }: EscalationPanelProps) {
  const currentUserRole = useAuthStore((s) => s.role) ?? "";
  const currentUserId = useAuthStore((s) => s.user?.id) ?? "";
  const addToast = useUIStore((s) => s.addToast);

  const { data: escData, loading: escLoading, refresh: refreshEsc } =
    useApiResource<EscalationsResponse>("/api/supervisor/escalations", {
      ttlMs: 15_000,
    });

  const { data: assigneeData, loading: assigneeLoading, refresh: refreshAssignees } =
    useApiResource<AssigneesResponse>("/api/supervisor/assignees", {
      ttlMs: 60_000,
    });

  const [filter, setFilter] = useState<FilterCategory>("all");
  const [assigningRow, setAssigningRow] = useState<string | null>(null);
  const [busyKey, setBusyKey] = useState<string | null>(null);

  const escalated = escData?.data.escalatedPermissions ?? [];
  const alerts = escData?.data.activeAlerts ?? [];
  const assignees = assigneeData?.data ?? [];

  /* ── merge rows ─────────────────────────────────────────────────── */

  const rows = useMemo<MergedRow[]>(() => {
    const out: MergedRow[] = [];

    for (const a of alerts) {
      const overdue =
        a.severity === "critical" || a.severity === "high";
      out.push({
        key: `alert-${a.id}`,
        type: "alert",
        severity: a.severity.toUpperCase(),
        title: a.title,
        gate: a.gate_name ?? "Gate",
        assignedTo: null, // no assigned_to column in schema yet
        age: fmtAge(a.timestamp),
        slaBadge: a.severity === "critical" ? "SLA 30m" : a.severity === "high" ? "SLA 1h" : null,
        alertId: a.id,
        ticketNumber: null,
        isOverdue: overdue,
      });
    }

    for (const p of escalated) {
      const overdue =
        p.sla_deadline !== null &&
        new Date(p.sla_deadline).getTime() < Date.now();
      out.push({
        key: `esc-${p.ticket_number}`,
        type: "escalation",
        severity: "ESCALATED",
        title: `Ticket ${p.ticket_number}`,
        gate: p.current_stage,
        assignedTo: p.student_name ?? null,
        age: fmtAge(p.created_at),
        slaBadge: p.sla_deadline
          ? overdue
            ? "SLA breached"
            : "SLA active"
          : null,
        alertId: null,
        ticketNumber: p.ticket_number,
        isOverdue: overdue,
      });
    }

    // Sort: overdue first, then critical, then by age desc.
    out.sort((a, b) => {
      if (a.isOverdue && !b.isOverdue) return -1;
      if (!a.isOverdue && b.isOverdue) return 1;
      if (a.severity === "CRITICAL" && b.severity !== "CRITICAL") return -1;
      if (b.severity === "CRITICAL" && a.severity !== "CRITICAL") return 1;
      const tA = a.alertId ? alerts.find((x) => x.id === a.alertId)?.timestamp ?? "" : "";
      const tB = b.ticketNumber ? escalated.find((x) => x.ticket_number === b.ticketNumber)?.created_at ?? "" : "";
      return new Date(tB).getTime() - new Date(tA).getTime();
    });

    return out;
  }, [alerts, escalated]);

  /* ── client-side filter ─────────────────────────────────────────── */

  const filtered = useMemo(() => {
    switch (filter) {
      case "alerts":
        return rows.filter((r) => r.type === "alert");
      case "escalated":
        return rows.filter((r) => r.type === "escalation");
      case "overdue":
        return rows.filter((r) => r.isOverdue);
      default:
        return rows;
    }
  }, [rows, filter]);

  /* ── critical banner ───────────────────────────────────────────── */

  const criticalCount = useMemo(
    () => rows.filter((r) => r.severity === "CRITICAL").length,
    [rows]
  );

  /* ── row actions ───────────────────────────────────────────────── */

  const handleAssign = useCallback(
    async (row: MergedRow, assigneeId: string) => {
      if (!row.alertId) return;
      const assignee = assignees.find((a) => a.id === assigneeId);
      setBusyKey(row.key);
      try {
        const res = await fetch("/api/alerts/assign", {
          method: "POST",
          headers: getAuthHeaders(),
          body: JSON.stringify({
            alert_id: row.alertId,
            assignee_user_id: assigneeId,
            assignee_role: assignee?.role ?? "operator",
            note: `Assigned by supervisor panel`,
          }),
        });
        const json = await res.json().catch(() => null);
        if (res.ok && json?.success) {
          addToast({
            variant: "success",
            message: `Alert assigned to ${assignee?.name ?? assigneeId}`,
          });
          setAssigningRow(null);
          void refreshEsc();
          onRefresh?.();
        } else {
          addToast({
            variant: "error",
            message: json?.error?.message || "Failed to assign alert",
          });
        }
      } catch {
        addToast({ variant: "error", message: "Network error during assignment" });
      } finally {
        setBusyKey(null);
      }
    },
    [addToast, assignees, refreshEsc, onRefresh]
  );

  const handleResolve = useCallback(
    async (row: MergedRow) => {
      if (!row.alertId) return;
      setBusyKey(row.key);
      try {
        const res = await fetch(
          `/api/alerts/${encodeURIComponent(row.alertId)}`,
          {
            method: "PATCH",
            headers: getAuthHeaders(),
            // No JSON body: resolveAlert only needs the alert id + user id
            // from the auth headers (x-user-id).
          }
        );
        const json = await res.json().catch(() => null);
        if (res.ok && json?.success) {
          addToast({
            variant: "success",
            message: `Alert ${row.title} resolved`,
          });
          void refreshEsc();
          onRefresh?.();
        } else {
          addToast({
            variant: "error",
            message: json?.error?.message || "Failed to resolve alert",
          });
        }
      } catch {
        addToast({ variant: "error", message: "Network error during resolve" });
      } finally {
        setBusyKey(null);
      }
    },
    [addToast, refreshEsc, onRefresh]
  );

  const handleEscalate = useCallback(
    async (row: MergedRow) => {
      if (!row.ticketNumber) return;
      setBusyKey(row.key);
      try {
        // Determine the ticket's domain from the workflow_type.
        const workflowType = escalated.find((x) => x.ticket_number === row.ticketNumber)?.workflow_type;
        const workflowToDomain: Record<string, Domain> = {
          hostel: "hostel",
          exam: "exam",
          memo: "academics",
          staff_leave: "governance",
          lab_access: "infrastructure",
        };
        const domain: Domain = workflowToDomain[workflowType ?? ""] ?? "hostel";

        // Use the escalation ladder to find the next role.
        const blocked = {
          allowed: false as const,
          reason: "tier_too_low" as const,
          message: "Manual escalation from EscalationPanel",
        };
        const escalation = nextActor(currentUserRole || "staff", domain, blocked);
        const targetRole = escalation?.targetRole;

        const body: Record<string, unknown> = { action: "ESCALATE" };
        if (targetRole) {
          body.targetRole = targetRole;
          body.reason = "tier_too_low";
          body.escalationExplanation = escalation.explanation;
        }

        const res = await fetch(
          `/api/permissions/${encodeURIComponent(row.ticketNumber)}`,
          {
            method: "PATCH",
            headers: getAuthHeaders(),
            body: JSON.stringify(body),
          }
        );
        const json = await res.json().catch(() => null);
        if (res.ok && json?.success) {
          addToast({
            variant: "success",
            message: targetRole
              ? `Ticket ${row.ticketNumber} escalated to ${targetRole}`
              : `Ticket ${row.ticketNumber} escalated`,
          });
          void refreshEsc();
          onRefresh?.();
        } else {
          addToast({
            variant: "error",
            message: json?.error?.message || "Failed to escalate ticket",
          });
        }
      } catch {
        addToast({ variant: "error", message: "Network error during escalation" });
      } finally {
        setBusyKey(null);
      }
    },
    [addToast, refreshEsc, onRefresh, currentUserRole]
  );

  const handleRefresh = useCallback(() => {
    void refreshEsc();
    void refreshAssignees();
  }, [refreshEsc, refreshAssignees]);

  /* ── severity icon ─────────────────────────────────────────────── */

  function severityIcon(sev: string) {
    if (sev === "CRITICAL") return <ShieldAlert className="w-3.5 h-3.5 text-action-danger shrink-0" />;
    if (sev === "HIGH") return <AlertTriangle className="w-3.5 h-3.5 text-action-warning shrink-0" />;
    if (sev === "ESCALATED") return <ShieldAlert className="w-3.5 h-3.5 text-action-danger shrink-0" />;
    return <Radio className="w-3.5 h-3.5 text-text-muted shrink-0" />;
  }

  /* ── render ────────────────────────────────────────────────────── */

  return (
    <section
      className="surface-card bg-bg-surface/60 p-4 min-w-0"
      aria-label="Escalation panel"
    >
      {/* Critical banner */}
      {criticalCount > 0 ? (
        <div className="surface-card flex items-center gap-2 bg-rose-400/10 px-3 py-2 mb-3">
          <ShieldAlert className="w-4 h-4 text-action-danger shrink-0" />
          <span className="text-xs font-bold text-action-danger">
            {criticalCount} critical {criticalCount === 1 ? "item" : "items"} require immediate attention
          </span>
        </div>
      ) : null}

      {/* Header */}
      <div className="flex items-center justify-between gap-2 mb-3">
        <div className="flex items-center gap-2 min-w-0">
          <Radio className="w-4 h-4 text-action-primary shrink-0" />
          <span className="text-sm font-bold text-text-primary truncate">
            Escalations
          </span>
          <span className="text-xs font-mono text-text-muted">
            {rows.length} items
          </span>
        </div>
        <button
          type="button"
          onClick={handleRefresh}
          disabled={escLoading}
          className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-semibold text-text-secondary hover:text-text-primary hover:bg-bg-elevated disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          aria-label="Refresh escalation panel"
        >
          {escLoading ? (
            <Loader2 className="size-3.5 animate-spin" />
          ) : (
            <Radio className="size-3.5" />
          )}
          <span>Refresh</span>
        </button>
      </div>

      {/* Filter categories */}
      <div className="flex flex-wrap gap-1 mb-3" role="tablist" aria-label="Filter escalations">
        {FILTER_CATEGORIES.map((tab) => (
          <button
            key={tab.id}
            type="button"
            role="tab"
            aria-selected={filter === tab.id}
            onClick={() => setFilter(tab.id)}
            className={`inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-semibold border transition-colors ${
              filter === tab.id
                ? "border-action-primary/40 bg-action-primary/10 text-action-primary"
                : "border-border bg-bg-elevated text-text-muted hover:text-text-secondary"
            }`}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {/* Loading / empty state */}
      {escLoading && rows.length === 0 ? (
        <div className="flex items-center gap-2 text-xs text-text-muted py-4 justify-center">
          <Loader2 className="w-4 h-4 animate-spin" />
          <span>Loading escalations…</span>
        </div>
      ) : filtered.length === 0 ? (
        <div className="surface-card bg-bg-base/50 px-3 py-4">
          <div className="flex items-start gap-2">
            <XCircle className="w-4 h-4 text-text-muted shrink-0 mt-0.5" />
            <p className="text-xs text-text-muted">
              {filter === "all"
                ? "No open escalations or alerts. The desk is clear."
                : `No ${filter} items match the current filter.`}
            </p>
          </div>
        </div>
      ) : (
        <ul className="space-y-2 max-h100 overflow-y-auto custom-scrollbar pr-1">
          {filtered.map((row) => {
            const isActive = assigningRow === row.key;
            const isBusy = busyKey === row.key;
            return (
              <li
                key={row.key}
                className="surface-card bg-bg-elevated px-3 py-2 min-w-0"
              >
                {/* Row header: severity icon + title + age + SLA badge */}
                <div className="flex items-center gap-2 min-w-0">
                  {severityIcon(row.severity)}
                  <span className="text-xs font-semibold text-text-primary truncate flex-1 min-w-0">
                    {row.title}
                  </span>
                  {row.slaBadge ? (
                    <span
                      className={`inline-flex items-center rounded-full px-1.5 py-0.5 text-xs font-mono font-bold border shrink-0 ${
                        row.slaBadge === "SLA breached"
                          ? "text-action-danger bg-rose-400/10 border-rose-400/20"
                          : "text-action-warning bg-amber-400/10 border-amber-400/20"
                      }`}
                    >
                      {row.slaBadge}
                    </span>
                  ) : null}
                  <span className="inline-flex items-center gap-1 shrink-0 text-xs font-mono text-text-muted">
                    <Clock className="size-3.5" />
                    {row.age}
                  </span>
                </div>

                {/* Sub-row: gate + assigned_to */}
                <div className="mt-1 flex items-center gap-2 text-xs font-mono text-text-muted">
                  <span className="truncate">
                    gate: {row.gate}
                  </span>
                  {row.assignedTo ? (
                    <span className="inline-flex items-center gap-0.5 truncate">
                      <UserPlus className="size-3.5 shrink-0" />
                      {row.assignedTo}
                    </span>
                  ) : null}
                  {row.ticketNumber ? (
                    <span className="text-text-muted/60">
                      ticket: {row.ticketNumber}
                    </span>
                  ) : null}
                </div>

                {/* Per-row actions */}
                <div className="mt-2 flex flex-wrap items-center gap-1.5">
                  {/* Assign button (alerts only) */}
                  {row.alertId ? (
                    <button
                      type="button"
                      onClick={() => setAssigningRow(isActive ? null : row.key)}
                      disabled={isBusy}
                      className={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-semibold border transition-colors disabled:opacity-40 ${
                        isActive
                          ? "border-action-primary/40 bg-action-primary/10 text-action-primary"
                          : "border-border bg-bg-base text-text-secondary hover:border-action-primary/40"
                      }`}
                    >
                      <UserPlus className="size-3.5" />
                      Assign
                      {isActive ? (
                        <ChevronDown className="size-3.5" />
                      ) : null}
                    </button>
                  ) : null}

                  {/* Resolve button (alerts only) */}
                  {row.alertId ? (
                    <button
                      type="button"
                      onClick={() => handleResolve(row)}
                      disabled={isBusy}
                      className="surface-card inline-flex items-center gap-1 px-2 py-0.5 text-xs font-semibold bg-emerald-400/10 text-action-success hover:bg-emerald-400/20 transition-colors disabled:opacity-40"
                    >
                      <CheckCircle className="size-3.5" />
                      Resolve
                    </button>
                  ) : null}

                  {/* Escalate button (escalated permissions only) */}
                  {row.ticketNumber ? (
                    <button
                      type="button"
                      onClick={() => handleEscalate(row)}
                      disabled={isBusy}
                      className="surface-card inline-flex items-center gap-1 px-2 py-0.5 text-xs font-semibold bg-rose-400/10 text-action-danger hover:bg-rose-400/20 transition-colors disabled:opacity-40"
                    >
                      <AlertTriangle className="size-3.5" />
                      Escalate
                    </button>
                  ) : null}

                  {/* Busy indicator */}
                  {isBusy ? (
                    <Loader2 className="size-3.5 animate-spin text-text-muted" />
                  ) : null}
                </div>

                {/* Assignee dropdown (shown when Assign is toggled) */}
                {isActive && row.alertId && !isBusy ? (
                  <div className="surface-card mt-2 bg-bg-base/50 p-2">
                    <label className="text-xs font-semibold text-text-muted mb-1 block">
                      Assign to
                    </label>
                    {assigneeLoading ? (
                      <div className="flex items-center gap-1.5 text-xs text-text-muted">
                        <Loader2 className="size-3.5 animate-spin" />
                        <span>Loading assignees…</span>
                      </div>
                    ) : assignees.length === 0 ? (
                      <p className="text-xs text-text-muted">
                        No assignees available.
                      </p>
                    ) : (
                      <div className="flex flex-wrap gap-1">
                        {assignees.map((a) => (
                          <button
                            key={a.id}
                            type="button"
                            onClick={() => handleAssign(row, a.id)}
                            className="surface-card inline-flex items-center gap-1 px-2 py-0.5 text-xs font-mono bg-bg-elevated text-text-secondary hover:text-text-primary transition-colors"
                          >
                            {a.name}
                            <span className="text-text-muted/60">
                              ({a.role})
                            </span>
                          </button>
                        ))}
                      </div>
                    )}
                  </div>
                ) : null}
              </li>
            );
          })}
        </ul>
      )}

      {/* Footer hint */}
      <p className="mt-3 text-xs text-text-muted">
        Data refreshed every 15s. Supervised-gates scope applied server-side
        via <code className="font-mono">users.supervised_gates</code>.
      </p>
    </section>
  );
}

export default EscalationPanel;
</file>

<file path="src/components/approver/ExamBranchCommandBar.tsx">
"use client";

/**
 * ExamBranchCommandBar — Cmd/Ctrl+K command palette for the exam-branch
 * console.
 *
 * Mirrors the DeputyWardenCommandBar / OieCommandBar free-text parser
 * pattern with 5 commands:
 *   verify <ticket>       PATCH /api/permissions/<ticket> { action: "verify" }
 *   forward <ticket> to oie
 *                         POST /api/permissions/<ticket>/forward { targetRole: "oie" }
 *   oie-handoff           navigate to /exam-branch/oie-handoff
 *   records               navigate to /exam-branch/records
 *   discrepancies         navigate to /exam-branch/discrepancies
 *
 * The three navigation commands are bare keywords (no arguments). verify and
 * forward are ticket-scoped.
 *
 * Keyboard: up/down to navigate, Enter to execute, Escape to close.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  CheckCircle,
  ArrowRight,
  ArrowLeftRight,
  FileSpreadsheet,
  ShieldAlert,
  Search,
  ChevronRight,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { getConsoleConfig } from "@/config/consoles";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
}

const COMMAND_DEFS: CommandDef[] = [
  {
    id: "verify",
    label: "Verify an exam ticket",
    hint: "verify <ticket> — Verify a pending exam ticket",
    icon: CheckCircle,
  },
  {
    id: "forward",
    label: "Forward a ticket to OIE",
    hint: "forward <ticket> to oie — Forward to the OIE role",
    icon: ArrowRight,
  },
  {
    id: "oie-handoff",
    label: "Open OIE Handoff",
    hint: "oie-handoff — Go to the OIE handoff list",
    icon: ArrowLeftRight,
  },
  {
    id: "records",
    label: "Open exam records",
    hint: "records — Go to the exam records list",
    icon: FileSpreadsheet,
  },
  {
    id: "discrepancies",
    label: "Open discrepancies",
    hint: "discrepancies — Go to the discrepancies list",
    icon: ShieldAlert,
  },
];

type Action =
  | "VERIFY"
  | "FORWARD"
  | "OIE_HANDOFF"
  | "RECORDS"
  | "DISCREPANCIES"
  | "UNKNOWN";

interface ParsedCommand {
  action: Action;
  ticket: string;
  targetRole: string;
}

/**
 * Parse an exam-branch free-text command.
 *
 *   verify <ticket>
 *   forward <ticket> to oie
 *   oie-handoff
 *   records
 *   discrepancies
 */
function parseCommand(input: string): ParsedCommand {
  const tokens = input.trim().split(/\s+/);
  const first = (tokens[0] || "").toLowerCase();
  const empty: ParsedCommand = {
    action: "UNKNOWN",
    ticket: "",
    targetRole: "",
  };

  if (first === "verify") {
    return { ...empty, action: "VERIFY", ticket: tokens[1] ?? "" };
  }
  if (first === "forward") {
    // forward <ticket> to oie
    const ticket = tokens[1] ?? "";
    const toIdx = tokens.findIndex((t) => t.toLowerCase() === "to");
    const targetRole = toIdx > 0 ? tokens[toIdx + 1] ?? "" : "oie";
    return { ...empty, action: "FORWARD", ticket, targetRole };
  }
  if (first === "oie-handoff") {
    return { ...empty, action: "OIE_HANDOFF" };
  }
  if (first === "records") {
    return { ...empty, action: "RECORDS" };
  }
  if (first === "discrepancies") {
    return { ...empty, action: "DISCREPANCIES" };
  }
  return { ...empty, action: "UNKNOWN" };
}

export interface ExamBranchCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function ExamBranchCommandBar({ role, open, onClose }: ExamBranchCommandBarProps) {
  const addToast = useUIStore((s) => s.addToast);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const [busy, setBusy] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id));
  }, [role]);

  const filtered = useMemo(() => {
    if (!query.trim()) return available;
    const q = query.toLowerCase();
    return available.filter(
      (c) => c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q),
    );
  }, [query, available]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  const navigate = useCallback(
    (href: string) => {
      window.location.href = href;
      onClose();
    },
    [onClose],
  );

  const executeCommand = useCallback(
    async (parsed: ParsedCommand) => {
      // ── navigation commands: bare keywords ──
      if (parsed.action === "OIE_HANDOFF") {
        navigate("/exam-branch/oie-handoff");
        return;
      }
      if (parsed.action === "RECORDS") {
        navigate("/exam-branch/records");
        return;
      }
      if (parsed.action === "DISCREPANCIES") {
        navigate("/exam-branch/discrepancies");
        return;
      }

      if (parsed.action === "UNKNOWN") {
        addToast({ variant: "error", message: "Unknown command. Type a command from the list below." });
        return;
      }

      // ── verify: PATCH /api/permissions/<ticket> { action: "verify" } ──
      if (parsed.action === "VERIFY") {
        if (!parsed.ticket) {
          addToast({ variant: "error", message: "Usage: verify <ticket>" });
          return;
        }
        setBusy(true);
        try {
          const res = await fetch(
            `/api/permissions/${encodeURIComponent(parsed.ticket)}`,
            {
              method: "PATCH",
              headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
              body: JSON.stringify({ action: "verify" }),
            },
          );
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            addToast({
              variant: "success",
              message: `Verified ${parsed.ticket}`,
            });
            onClose();
          } else {
            addToast({
              variant: "error",
              message:
                json?.error?.message || `Failed to verify ${parsed.ticket}`,
            });
          }
        } catch {
          addToast({ variant: "error", message: "Network error while verifying ticket" });
        } finally {
          setBusy(false);
        }
        return;
      }

      // ── forward: POST /api/permissions/<ticket>/forward { targetRole: "oie" } ──
      if (!parsed.ticket) {
        addToast({ variant: "error", message: "Usage: forward <ticket> to oie" });
        return;
      }
      const targetRole = parsed.targetRole || "oie";
      setBusy(true);
      try {
        const res = await fetch(
          `/api/permissions/${encodeURIComponent(parsed.ticket)}/forward`,
          {
            method: "POST",
            headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
            body: JSON.stringify({
              targetRole,
              comment: "forwarded from exam branch to OIE",
            }),
          },
        );
        const json = await res.json().catch(() => null);
        if (res.ok && json?.success) {
          addToast({
            variant: "success",
            message: `Forwarded ${parsed.ticket} to ${targetRole}`,
          });
          onClose();
        } else {
          addToast({
            variant: "error",
            message:
              json?.error?.message ||
              `Failed to forward ${parsed.ticket} to ${targetRole}`,
          });
        }
      } catch {
        addToast({ variant: "error", message: "Network error while forwarding ticket" });
      } finally {
        setBusy(false);
      }
    },
    [addToast, onClose, navigate],
  );

  const handleSelect = useCallback(
    (cmd: CommandDef) => {
      // Bare navigation keywords: fill the whole keyword so Enter executes.
      // verify / forward: prefix the keyword so the user can type the ticket.
      const prefix =
        cmd.id === "oie-handoff" || cmd.id === "records" || cmd.id === "discrepancies"
          ? cmd.id
          : `${cmd.id} `;
      setQuery(prefix);
      inputRef.current?.focus();
    },
    [],
  );

  const handleEnter = useCallback(() => {
    const parsed = parseCommand(query);
    const first = query.trim().toLowerCase();
    // verify / forward need a ticket; the nav keywords are complete on their own.
    if (
      (first === "verify" && parsed.action !== "VERIFY") ||
      (first === "forward" && parsed.action !== "FORWARD") ||
      (parsed.action === "VERIFY" && !parsed.ticket) ||
      (parsed.action === "FORWARD" && !parsed.ticket)
    ) {
      inputRef.current?.focus();
      return;
    }
    if (parsed.action === "UNKNOWN") {
      inputRef.current?.focus();
      return;
    }
    executeCommand(parsed);
  }, [executeCommand, query]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!query.trim()) {
          if (filtered[active]) handleSelect(filtered[active]);
        } else {
          handleEnter();
        }
      }
    },
    [filtered, active, handleSelect, handleEnter, query],
  );

  if (!open) return null;

  const parsedPreview = query.trim() ? parseCommand(query) : null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="Exam Branch command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={`Exam Branch command (role: ${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="Exam Branch command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Parsed-command preview */}
        {parsedPreview && parsedPreview.action !== "UNKNOWN" ? (
          <div className="surface-card px-4 py-2 bg-bg-elevated text-xs text-text-secondary">
            <span className="font-mono font-bold text-action-primary">
              {parsedPreview.action}
            </span>
            {parsedPreview.action === "VERIFY" || parsedPreview.action === "FORWARD" ? (
              <>
                {parsedPreview.ticket ? (
                  <span className="ml-1.5 font-mono">{parsedPreview.ticket}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[ticket required]</span>
                )}
                {parsedPreview.action === "FORWARD" ? (
                  <span className="ml-1.5 text-text-muted italic">
                    to {parsedPreview.targetRole || "oie"}
                  </span>
                ) : null}
              </>
            ) : null}
            {busy ? <span className="ml-2 text-text-muted">processing…</span> : null}
          </div>
        ) : null}

        {/* Command list */}
        <ul role="listbox" aria-label="Exam Branch commands" className="max-h-64 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors disabled:opacity-50 ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>
      </div>
    </div>
  );
}

export default ExamBranchCommandBar;
