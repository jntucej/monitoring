/* response shapes */

interface AnnouncementItem {
  id: string;
  title: string;
  body?: string;
  audience?: string;
  created_at?: string;
}

interface AnnouncementsResponse {
  success: boolean;
  data: AnnouncementItem[];
}

function FacultyNotificationsInner() {
