"use client";

import { useEffect, useState } from "react";
import { useParams } from "next/navigation";
import Link from "next/link";
import {
  ArrowLeft, User, Mail, Phone, Building2, Clock, Briefcase,
} from "lucide-react";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { EmptyState } from "@/components/admin/shared/EmptyState";
import { SectionCard } from "@/components/admin/shared/SectionCard";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface StaffHistoryItem {
  direction?: string;
  gate?: string;
  timestamp?: string;
}

/**
 * /admin/staff/[id] — full staff drill-down: duty roster, leave history,
 * contact info. Pulls /api/persons/[uniqueId] + /api/persons/[uniqueId]/history.
 */
export default function AdminStaffDetailPage() {
  return (
    
      <AdminStaffDetail />
    
    

  );
}

function AdminStaffDetail() {
  const { id } = useParams<{ id: string }>();
  const [record, setRecord] = useState<any | null>(null);
  const [history, setHistory] = useState<StaffHistoryItem[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    if (!id) return;
    let alive = true;
    const headers = getAuthHeaders();
    setLoading(true);
    Promise.all([
      fetch(`/api/persons/${encodeURIComponent(id)}`, { headers, cache: "no-store" })
        .then((r) => (r.ok ? r.json() : null)).catch(() => null),
      fetch(`/api/persons/${encodeURIComponent(id)}/history?limit=20`, { headers, cache: "no-store" })
        .then((r) => (r.ok ? r.json() : null)).catch(() => null),
    ]).then(([rec, hist]) => {
      if (!alive) return;
      setRecord(rec?.data ?? rec);
      setHistory(hist?.data?.history ?? hist?.data ?? []);
      setLoading(false);
    });
    return () => { alive = false; };
  }, [id]);

  const person: any = record?.person ?? record;

  return (
    <div className="space-y-6 p-4 md:p-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Duty roster, leave history, and contact info"
        why="Edit this record to correct department, role, or contact fields; changes sync to their dashboard."
        contextLabel="Duty roster, leave history, and contact info"
        statusSummary="Review current duty roster, leave history, and contact info state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <PageHeader
        title="Staff Profile"
        subtitle="Duty roster, leave history, and contact info"
        breadcrumb={[
          { label: "Staff", href: "/admin/staff" },
          { label: person?.fullName ?? id ?? "Detail", href: "/admin/staff" },
        ]}
      />

      {!loading && !person ? (
        <WidgetBoundary title="Not found">
          <EmptyState
            title="Record not found"
            description={`No staff member matched the id "${id}".`}
          />
        </WidgetBoundary>
      ) : (
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div className="lg:col-span-1">
            <SectionCard title="Identity" showHeader={false}>
              <div className="text-center space-y-3">
                <div className="w-24 h-24 mx-auto rounded-full bg-action-primary/10 flex items-center justify-center text-3xl font-black text-action-primary ring-2 ring-action-primary/25">
                  {(person?.fullName ?? person?.name ?? "S")
                    .split(/\s+/).slice(0, 2).map((w: string) => w[0]?.toUpperCase()).join("")}
                </div>
                <div>
                  <p className="text-lg font-bold text-text-primary">
                    {person?.fullName ?? person?.name ?? "Staff"}
                  </p>
                  <p className="font-mono text-xs text-text-muted">{id}</p>
                </div>
                <span className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold bg-emerald-500/10 text-action-success">
                  <User className="w-3.5 h-3.5" /> {person?.role ?? "STAFF"}
                </span>
              </div>
            </SectionCard>
          </div>

          <div className="lg:col-span-2 space-y-4">
            <SectionCard title="Contact & assignment">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <Fact label="Designation" value={person?.employeeDetails?.designation} icon={Briefcase} />
                <Fact label="Employee ID" value={person?.employeeDetails?.employee_id ?? person?.uniqueId} icon={User} />
                <Fact label="Department" value={person?.employeeDetails?.department_id} icon={Building2} />
                <Fact label="Phone" value={person?.phone} icon={Phone} />
                <Fact label="Email" value={person?.email} icon={Mail} />
                <Fact label="Status" value={person?.status} icon={Clock} />
              </div>
            </SectionCard>

            <SectionCard title="Movement history" description="Recent in/out scans">
              {history.length === 0 ? (
                <EmptyState title="No recent movement" description="No in/out scans recorded yet." />
              ) : (
                <ul className="divide-y divide-border">
                  {history.map((h, i) => (
                    <li key={i} className="flex items-center gap-3 py-2.5 text-sm">
                      <span className={`w-2 h-2 rounded-full shrink-0 ${h.direction === "IN" ? "bg-action-success" : "bg-action-danger"}`} />
                      <span className="font-mono text-text-primary">{h.direction}</span>
                      <span className="text-text-muted">{h.gate ?? "—"}</span>
                      <span className="ml-auto text-xs text-text-muted flex items-center gap-1.5">
                        <Clock className="size-3.5" />
                        {h.timestamp ? new Date(h.timestamp).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" }) : "—"}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </SectionCard>

            <div className="flex">
              <Link
                href="/admin/staff"
                className="surface-card inline-flex items-center gap-2 text-xs font-semibold text-text-secondary hover:text-text-primary px-3 py-2">
                <ArrowLeft className="w-3.5 h-3.5" /> Back to staff directory
              </Link>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function Fact({ label, value, icon: Icon }: { label: string; value?: string | null; icon: typeof User }) {
  return (
    <div>
      <p className="text-xs font-semibold text-text-secondary flex items-center gap-1.5">
        <Icon className="w-3.5 h-3.5" /> {label}
      </p>
      <p className="text-sm text-text-primary mt-0.5">{value || "—"}</p>
    </div>
  );
}
</file>

<file path="src/app/(admin)/admin/staff/page.tsx">
"use client";
import { useCallback, useEffect, useMemo, useState, lazy, Suspense } from "react";
import {Search, X, Briefcase, Mail, ChevronRight, GraduationCap, Wrench}  from "lucide-react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { EntityInspector, KVPairs, InspectorButton } from "@/components/shared/EntityInspector";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { Skeleton } from "@/components/ui/skeleton";
import {
  MiniSparkline, MiniStackedBar,
} from "@/components/admin/kit";
import { getAuthHeaders } from "@/lib/utils";
import { usePolling } from "@/hooks/usePolling";
import { usePersistentQuery } from "@/hooks/usePersistentQuery";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

const StaffMonthlyReviewPanel = lazy(
  () => import("@/components/admin/StaffMonthlyReviewPanel")
);


/**
 * Admin Staff & Faculty — merged roster view.
 *
 * One page covering the staff / faculty / worker roles. KPI + role facets
 * come from the live `/api/staff/stats` (which reports byGroup/byDepartment
 * for the staff-scoped roles). The table rows come from `/api/staff/my-day`
 * (the staff tracking feed) when present, with a graceful fallback.
 */

type StaffRole = "staff" | "faculty" | "worker";

interface StaffRow {
  id: string;
  name: string;
  email: string | null;
  phone: string | null;
  role: StaffRole;
  department: string | null;
  designation: string | null;
  status: string;
}

interface StaffStats {
  total: number;
  active: number;
  suspended: number;
  byGroup: Array<{
    group: string;
    count: number;
    color: string;
    roles: Array<{ role: string; count: number }>;
  }>;
  byDepartment: Array<{ code: string; name: string; count: number }>;
}

const ROLE_COLOR: Record<StaffRole, string> = {
  faculty: "var(--action-success)",
  staff: "var(--action-success)",
  worker: "var(--text-muted)",
};

const ROLE_ICON: Record<StaffRole, typeof Briefcase> = {
  faculty: GraduationCap,
  staff: Briefcase,
  worker: Wrench,
};

function normalizeRole(role: string | undefined | null): StaffRole | null {
  const r = (role ?? "").toLowerCase();
  if (r === "faculty" || r === "hod" || r === "principal" || r === "vice_principal")
    return "faculty";
  if (r === "staff" || r === "operator" || r === "caretaker" || r === "supervisor" || r === "worker")
    return r === "worker" ? "worker" : "staff";
  if (r === "worker") return "worker";
  return null;
}

async function fetchStats(): Promise<StaffStats | null> {
  const res = await fetch("/api/staff/stats", { headers: getAuthHeaders() });
  if (!res.ok) return null;
  const body = await res.json();
  return (body?.data ?? body) as StaffStats | null;
}

async function fetchRows(): Promise<StaffRow[]> {
  // Staff attendance feed provides the richest per-person records.
  try {
    const res = await fetch("/api/staff/my-day", { headers: getAuthHeaders() });
    if (res.ok) {
      const body = await res.json();
      const records = (body?.records ?? body?.data ?? []) as Array<Record<string, unknown>>;
      const rows: StaffRow[] = records
        .map((r) => {
          const role = normalizeRole(String(r.role ?? ""));
          if (!role) return null;
          return {
            id: String(r.id ?? r.user_id ?? ""),
            name: String(r.name ?? r.fullName ?? ""),
            email: (r.email as string) ?? null,
            phone: (r.phone as string) ?? null,
            role,
            department: (r.department as string) ?? (r.departmentId as string) ?? null,
            designation:
              (r.designation as string) ??
              ((r.employeeDetails as Record<string, unknown>)?.designation as string) ??
              null,
            status: String(r.status ?? "ACTIVE"),
          } as StaffRow;
        })
        .filter((r): r is StaffRow => r !== null && r.id.length > 0);
      if (rows.length) return rows;
    }
  } catch {
    /* fall through to the users endpoint */
  }

  // Fallback: the users roster filtered to staff-scoped roles.
  try {
    const res = await fetch("/api/users", { headers: getAuthHeaders() });
    if (!res.ok) return [];
    const body = await res.json();
    const arr = (body?.data ?? body ?? []) as Array<Record<string, unknown>>;
    return arr
      .map((r) => {
        const role = normalizeRole(String(r.role ?? ""));
        if (!role) return null;
        return {
          id: String(r.id ?? ""),
          name: String(r.name ?? r.fullName ?? ""),
          email: (r.email as string) ?? null,
          phone: (r.phone as string) ?? null,
          role,
          department: (r.department as string) ?? (r.departmentId as string) ?? null,
          designation: (r.designation as string) ?? null,
          status: String(r.status ?? "ACTIVE"),
        } as StaffRow;
      })
      .filter((r): r is StaffRow => r !== null);
  } catch {
    return [];
  }
}

function initials(name: string) {
  return name
    .split(/\s+/)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? "")
    .join("");
}

function AdminStaffInner() {
  const [stats, setStats] = useState<StaffStats | null>(null);
  const [rows, setRows] = useState<StaffRow[]>([]);
  const [error, setError] = useState<string | null>(null);
  const [query, setQuery] = usePersistentQuery("gate-admin-staff-query");
  const [roleFilter, setRoleFilter] = useState<StaffRole[]>([]);
  const [active, setActive] = useState<StaffRow | null>(null);

  const load = useCallback(async () => {
    try {
      const [s, r] = await Promise.all([
        fetchStats().catch(() => null),
        fetchRows(),
      ]);
      setStats(s);
      setRows(r);
      setError(null);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load staff");
    }
  }, []);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);
  usePolling(load, { intervalMs: 60_000 });

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    return rows.filter((r) => {
      if (roleFilter.length && !roleFilter.includes(r.role)) return false;
      if (
        q &&
        !`${r.name} ${r.email ?? ""} ${r.department ?? ""} ${r.designation ?? ""}`
          .toLowerCase()
          .includes(q)
      )
        return false;
      return true;
    });
  }, [rows, roleFilter, query]);

  const roleCounts = useMemo(() => {
    const c: Record<StaffRole, number> = { staff: 0, faculty: 0, worker: 0 };
    for (const r of rows) c[r.role] += 1;
    return c;
  }, [rows]);

  const toggleIn = (arr: StaffRole[], v: StaffRole, set: (n: StaffRole[]) => void) => {
    set(arr.includes(v) ? arr.filter((x) => x !== v) : [...arr, v]);
  };

  if (!stats && !rows.length && !error) {
    return (
      <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-4 py-4 md:py-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Teaching, support, and worker roster with department breakdown"
        why="Edit this record to correct department, role, or contact fields; changes sync to their dashboard."
        contextLabel="Teaching, support, and worker roster with department breakdown"
        statusSummary="Review current teaching, support, and worker roster with department breakdown state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
        <Skeleton className="h-6 w-6" />
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {Array.from({ length: 4 }).map((_, i) => (
            <Skeleton key={i} className="h-6 rounded-2xl" />
          ))}
        </div>
        <Skeleton className="h-6 rounded-2xl" />
      </div>
    );
  }

  const roleSegments = (Object.keys(roleCounts) as StaffRole[]).map((r) => ({
    value: roleCounts[r],
    color: ROLE_COLOR[r],
  }));

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-4 md:py-6">
      <PageHeader
        title="Staff & Faculty"
        subtitle="Teaching, support, and worker roster with department breakdown"
        onRefresh={load}
      />

      {error && (
        <div className="surface-card p-3 text-sm text-action-danger">
          {error}
        </div>
      )}

      {/* KPI row */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div className="surface-card p-4">
          <p className="text-xs text-text-muted">Total staff</p>
          <p className="text-2xl font-bold text-text-primary tabular-nums">
            {stats?.total ?? rows.length}
          </p>
          <MiniSparkline
            label=""
            values={[
              (stats?.active ?? 0) * 0.8,
              (stats?.active ?? 0) * 0.85,
              (stats?.active ?? 0) * 0.9,
              stats?.active ?? 0,
            ]}
            width={140}
            height={24}
          />
        </div>
        <div className="surface-card p-4">
          <p className="text-xs text-text-muted">Faculty</p>
          <p className="text-2xl font-bold text-action-success tabular-nums">
            {roleCounts.faculty}
          </p>
        </div>
        <div className="surface-card p-4">
          <p className="text-xs text-text-muted">Staff</p>
          <p className="text-2xl font-bold text-teal-400 tabular-nums">
            {roleCounts.staff}
          </p>
        </div>
        <div className="surface-card p-4">
          <p className="text-xs text-text-muted">Workers</p>
          <p className="text-2xl font-bold text-text-secondary tabular-nums">
            {roleCounts.worker}
          </p>
          <MiniStackedBar label="by role" segments={roleSegments} />
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-4 gap-4 section-offscreen">
        {/* Facet rail */}
        <WidgetBoundary title="Filters">
          <aside className="surface-card p-4 space-y-4 lg:sticky lg:top-4 self-start">
            <div>
              <h3 className="text-xs font-semibold uppercase tracking-wide text-text-muted mb-2">
                Role
              </h3>
              <div className="flex flex-wrap gap-1.5">
                {(Object.keys(roleCounts) as StaffRole[]).map((r) => {
                  const Icon = ROLE_ICON[r];
                  return (
                    <button
                      key={r}
                      onClick={() => toggleIn(roleFilter, r, setRoleFilter)}
                      className={`flex items-center gap-1 text-xs px-2 py-1 rounded-full border transition ${
                        roleFilter.includes(r)
                          ? "border-transparent text-white"
                          : "border-border text-text-primary"
                      }`}
                      style={roleFilter.includes(r) ? { background: ROLE_COLOR[r] } : undefined}
                    >
                      <Icon className="size-3.5" /> {r}{" "}
                      <span className="opacity-70">{roleCounts[r]}</span>
                    </button>
                  );
                })}
              </div>
            </div>

            {(stats?.byDepartment?.length ?? 0) > 0 && (
              <div>
                <h3 className="text-xs font-semibold uppercase tracking-wide text-text-muted mb-2">
                  By department
                </h3>
                <ul className="space-y-1 text-xs">
                  {stats?.byDepartment
                    .slice(0, 8)
                    .map((d) => (
                      <li key={d.code} className="flex items-center justify-between">
                        <span className="text-text-primary">{d.code}</span>
                        <span className="tabular-nums text-text-muted">{d.count}</span>
                      </li>
                    ))}
                </ul>
              </div>
            )}

            {(roleFilter.length || query) && (
              <button
                onClick={() => {
                  setRoleFilter([]);
                  setQuery("");
                }}
                className="text-xs text-action-primary hover:underline flex items-center gap-1"
              >
                <X className="size-3.5" /> Clear filters
              </button>
            )}
          </aside>
        </WidgetBoundary>

        {/* Table */}
        <div className="lg:col-span-3 space-y-3">
          <div className="relative">
            <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" />
            <input
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search by name, email, or department…"
              className="surface-card w-full min-h-11 pl-9 pr-3 py-2 bg-bg-surface/40 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-action-primary/40"
            />
          </div>

          <div className="glass-card overflow-hidden">
            <div className="overflow-x-auto">
              <table className="w-full text-sm min-w160">
                <thead className="bg-bg-surface/60 text-text-muted text-xs uppercase tracking-wide">
                  <tr>
                    <th className="text-left px-4 py-2.5 font-medium">Name</th>
                    <th className="text-left px-4 py-2.5 font-medium">Role</th>
                    <th className="text-left px-4 py-2.5 font-medium">Department</th>
                    <th className="text-left px-4 py-2.5 font-medium">Designation</th>
                    <th className="text-left px-4 py-2.5 font-medium">Status</th>
                    <th />
                  </tr>
                </thead>
                <tbody>
                  {filtered.length === 0 && (
                    <tr>
                      <td colSpan={6} className="px-4 py-10 text-center text-text-muted">
                        No staff match this view
                      </td>
                    </tr>
                  )}
                  {filtered.map((r) => (
                    <tr
                      key={r.id}
                      onClick={() => setActive(r)}
                      className="border-t border-border hover:bg-bg-surface/40 cursor-pointer"
                    >
                      <td className="px-4 py-2.5">
                        <div className="flex items-center gap-2.5">
                          <div
                            className="size-6 rounded-full flex items-center justify-center text-xs font-semibold text-white shrink-0"
                            style={{ background: ROLE_COLOR[r.role] }}
                          >
                            {initials(r.name)}
                          </div>
                          <div className="min-w-4">
                            <p className="text-text-primary font-medium truncate">
                              {r.name}
                            </p>
                            <p className="text-xs text-text-muted truncate flex items-center gap-1">
                              <Mail className="size-3.5" /> {r.email ?? "—"}
                            </p>
                          </div>
                        </div>
                      </td>
                      <td className="px-4 py-2.5">
                        <span
                          className="surface-card text-xs uppercase tracking-wide px-2 py-0.5 font-medium"
                          style={{
                            background: `${ROLE_COLOR[r.role]}22`,
                            color: ROLE_COLOR[r.role],
                          }}
                        >
                          {r.role}
                        </span>
                      </td>
                      <td className="px-4 py-2.5 text-xs">{r.department ?? "—"}</td>
                      <td className="px-4 py-2.5 text-xs text-text-muted">
                        {r.designation ?? "—"}
                      </td>
                      <td className="px-4 py-2.5 text-xs">
                        <span
                          className={
                            r.status === "ACTIVE"
                              ? "text-action-primary"
                              : "text-action-warning"
                          }
                        >
                          {r.status}
                        </span>
                      </td>
                      <td className="px-4 py-2.5">
                        <ChevronRight className="w-4 h-4 text-text-muted" />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      {/* Drawer - standardized inspection model */}
      {(() => {
        const staffInspection = active
          ? {
              kind: "staff_member",
              title: active.name,
              subtitle: active.email,
              status: (
                <span
                  className={`text-[10px] font-bold uppercase px-1.5 py-0.5 rounded ${
                    active.status === "ACTIVE"
                      ? "bg-emerald-500/15 text-action-success"
                      : "bg-rose-500/15 text-action-danger"
                  }`}
                >
                  {active.status}
                </span>
              ),
              sections: [
                {
                  title: "Overview",
                  content: (
                    <KVPairs
                      items={[
                        { label: "Role", value: active.role },
                        { label: "Department", value: active.department ?? "—" },
                        { label: "Designation", value: active.designation ?? "—" },
                        ...(active.phone ? [{ label: "Phone", value: active.phone }] : []),
                      ]}
                    />
                  ),
                },
                {
                  title: "Actions",
                  content: (
                    <div className="flex flex-wrap gap-2">
                      <InspectorButton
                        href={`/admin/staff/${active.id}`}
                        variant="primary"
                      >
                        <ChevronRight className="size-3.5" /> Full record
                      </InspectorButton>
                    </div>
                  ),
                },
              ],
              detailHref: `/admin/staff/${active.id}`,
              detailLabel: "Full record",
            }
          : null;
        return (
          <EntityInspector inspection={staffInspection} onClose={() => setActive(null)} />
        );
      })()}

      {/* Monthly review panel */}
      <Suspense fallback={null}>
        <StaffMonthlyReviewPanel />
      </Suspense>
    </div>
  );
}

export default function AdminStaffPage() {
  return (
    
      <AdminStaffInner />
    
    

  );
}
</file>

<file path="src/app/(admin)/admin/student-representatives/page.tsx">
"use client";
// src/app/(admin)/admin/student-representatives/page.tsx
"use client";

import { useCallback, useEffect, useState } from "react";
import Link from "next/link";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { ConfirmDialog } from "@/components/admin/shared/ConfirmDialog";
import { getActionsForRole } from "@/lib/role-action-engine";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

export default function RepsPage() {
  const [rows, setRows] = useState<any[]>([]);
  const addToast = useUIStore((s) => s.addToast);
  const [revokeId, setRevokeId] = useState<string | null>(null);
  const [form, setForm] = useState({
    studentId: "",
    scopeType: "class",
    scopeId: "",
    validFrom: new Date().toISOString().slice(0, 10),
    validTo: new Date(Date.now() + 180 * 86_400_000).toISOString().slice(0, 10),
  });

  const load = useCallback(async () => {
    const r = await fetch("/api/admin/student-representatives", { headers: getAuthHeaders() });
    const j = await r.json();
    setRows(j.data?.representatives ?? []);
  }, []);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  const create = async (e: React.FormEvent) => {
    e.preventDefault();
    const r = await fetch("/api/admin/student-representatives", {
      method: "POST",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify(form),
    });
    const j = await r.json();
    if (j.success) {
      setForm({ ...form, studentId: "", scopeId: "" });
      await load();
      addToast({ variant: "success", message: "Representative appointed successfully" });
    } else {
      addToast({ variant: "error", message: j.error?.message ?? "Failed" });
    }
  };

  const revoke = async (id: string) => {
    setRevokeId(null);
    await fetch(`/api/admin/student-representatives/${id}`, {
      method: "DELETE",
      headers: getAuthHeaders(),
    });
    await load();
    addToast({ variant: "success", message: "Representative revoked" });
  };

  const crActions = getActionsForRole("cr", { kind: "assignment", recordId: "cr-scope" });

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Manage and monitor student representatives for campus operations."
        why="Only representatives registered here can use the escalation channel on complaint tickets."
        contextLabel="Student Representatives"
        statusSummary="Review current student representatives state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 className="text-2xl font-semibold">Student representatives</h1>
          <p className="text-xs text-text-muted">
            CR capabilities enabled: {crActions.map((a) => a.label).join(" · ")}
          </p>
        </div>
        <div className="flex flex-wrap items-center gap-2">
          <Link
            href="/admin/classes"
            className="rounded-lg border border-border bg-bg-surface px-3 py-1.5 text-xs font-medium hover:bg-bg-elevated"
          >
            Classes &rarr;
          </Link>
          <Link
            href="/admin/faculty-assignments"
            className="rounded-lg border border-border bg-bg-surface px-3 py-1.5 text-xs font-medium hover:bg-bg-elevated"
          >
            Faculty Assignments &rarr;
          </Link>
        </div>
      </div>

      <form onSubmit={create} className="surface-card grid grid-cols-1 sm:grid-cols-2 gap-3 p-4 bg-white">
        <input
          required
          placeholder="Student UUID"
          value={form.studentId}
          onChange={(e) => setForm({ ...form, studentId: e.target.value })}
          className="surface-card p-2 text-sm min-h-11"
        />
        <select
          value={form.scopeType}
          onChange={(e) => setForm({ ...form, scopeType: e.target.value })}
          className="surface-card p-2 text-sm min-h-11"
        >
          <option value="class">Class</option>
          <option value="department">Department</option>
          <option value="block">Block</option>
          <option value="hostel">Hostel</option>
          <option value="mess">Mess</option>
          <option value="girls">Girls</option>
        </select>
        <input
          required
          placeholder="Scope ID (e.g. CSE-3-A, BlockA)"
          value={form.scopeId}
          onChange={(e) => setForm({ ...form, scopeId: e.target.value })}
          className="surface-card p-2 text-sm min-h-11"
        />
        <div className="flex flex-col sm:flex-row gap-2">
          <input
            type="date"
            value={form.validFrom}
            onChange={(e) => setForm({ ...form, validFrom: e.target.value })}
            className="surface-card p-2 text-sm flex-1 min-h-11"
          />
          <input
            type="date"
            required
            value={form.validTo}
            onChange={(e) => setForm({ ...form, validTo: e.target.value })}
            className="surface-card p-2 text-sm flex-1 min-h-11"
          />
        </div>
        <button type="submit" className="surface-card px-4 py-2 bg-bg-surface text-white text-sm col-span-1 sm:col-span-2 font-medium min-h-11">
          Appoint representative
        </button>
      </form>

      <div className="border rounded bg-white overflow-x-auto">
        <table className="w-full text-sm">
          <thead className="text-left border-b bg-bg-elevated">
            <tr>
              <th className="p-3">Name</th>
              <th className="p-3">Roll</th>
              <th className="p-3">Scope</th>
              <th className="p-3">Until</th>
              <th className="p-3">Status</th>
              <th className="p-3"></th>
            </tr>
          </thead>
          <tbody className="divide-y">
            {rows.map((r) => (
              <tr key={r.id} className="hover:bg-bg-elevated">
                <td className="p-3 font-medium">{r.studentName}</td>
                <td className="p-3 font-mono">{r.studentRoll}</td>
                <td className="p-3">{r.scopeType}:{r.scopeId}</td>
                <td className="p-3">{r.validTo}</td>
                <td className="p-3 uppercase text-xs font-mono">{r.status}</td>
                <td className="p-3 text-right">
                  <button
                    type="button"
                    onClick={() => setRevokeId(r.id)}
                    className="text-xs text-action-danger hover:underline font-medium"
                  >
                    Revoke
                  </button>
                </td>
              </tr>
            ))}
            {rows.length === 0 && (
              <tr>
                <td colSpan={6} className="p-6 text-center text-text-muted">No student representatives appointed.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <ConfirmDialog
        open={revokeId !== null}
        onClose={() => setRevokeId(null)}
        title="Revoke representative?"
        body="This representative will immediately lose their scope authority. This action is audited."
        confirmText="Revoke"
        variant="destructive"
        onConfirm={() => { void revoke(revokeId ?? ""); }}
      />
    </div>
  );
}
