<file path="src/components/principal/shared/inspectorSections.tsx">
"use client";

/**
 * PR-04 — composable inspector section builders.
 *
 * Shared, composable section builders for the unified Entity Inspector.
 * Domain inspectors (student, gate, incident, permission, …) compose these
 * instead of hand-building their own panels — shared STRUCTURE, not identical
 * CONTENT. Each builder returns an `InspectionSection` to feed the existing
 * `EntityInspector`, in the canonical order
 * overview → status → relationships → timeline → actions.
 *
 * Reuses existing presentation components (KVPairs, StatusBadge) and the
 * host's own render helpers. Unknown / missing data renders an honest empty
 * state — never invented relationships, events, or audit refs.
 */

import type { ReactNode } from "react";
import { KVPairs } from "@/components/shared/EntityInspector";
import type { InspectionSection } from "@/components/shared/EntityInspector";
import { EntityTimeline } from "@/components/principal/shared/EntityTimeline";
import type {
  PrincipalRelationship,
  PrincipalTimelineEvent,
  PrincipalActionDefinition,
} from "@/lib/principal/contracts";

/* Canonical section titles — one source of truth for inspection order. */
export const INSPECTOR_SECTION_TITLES = {
  overview: "Overview",
  status: "Current status",
  relationships: "Connected records",
  timeline: "Timeline",
  actions: "Actions",
} as const;

/* Honest empty state — no data, no fabricated content. */
function Empty({ text }: { text: string }) {
  return <p className="text-sm text-text-muted">{text}</p>;
}

export interface InspectorSections {
  /** Overview — key/value summary (first, always-shown section). */
  overview: (pairs: Array<{ label: string; value: ReactNode }>) => InspectionSection;
  /** Status / current state (free content from the domain). */
  status: (content: ReactNode) => InspectionSection;
  /**
   * Relationships from verified data. `renderTarget` is the host's link/inspect
   * helper. Missing or inaccessible records (available=false) are shown
   * honestly, never omitted into a fabricated graph.
   */
  relationships: (
    rels: PrincipalRelationship[],
    renderTarget: (r: PrincipalRelationship) => ReactNode,
  ) => InspectionSection;
  /**
   * Timeline (entity-activity or institutional stream — host distinguishes via
   * event.scope). Collapsible by default (may be long). Empty = "no recorded
   * history", never an inferred timeline.
   */
  timeline: (
    events: PrincipalTimelineEvent[],
    renderEvent: (e: PrincipalTimelineEvent) => ReactNode,
    opts?: { collapsible?: boolean },
  ) => InspectionSection;
  /** Actions (presentation only; the SERVER is the authority for each). */
  actions: (
    actions: PrincipalActionDefinition[],
    renderAction: (a: PrincipalActionDefinition) => ReactNode,
  ) => InspectionSection;
  /**
   * PR-06: a timeline section rendered by the shared EntityTimeline — carries
   * honest loading / empty / error states + pagination for long histories.
   * Use this (not the custom `timeline` renderer) when the events are real
   * recorded data (e.g. audit logs) and you want the standard presentation.
   */
  timelineSection: (
    events: PrincipalTimelineEvent[],
    opts?: { loading?: boolean; error?: string | null; pageSize?: number },
  ) => InspectionSection;
}

export function createInspectorSections(): InspectorSections {
  return {
    overview: (pairs) => ({
      title: INSPECTOR_SECTION_TITLES.overview,
      content: pairs.length ? <KVPairs items={pairs} /> : <Empty text="No overview data" />,
    }),
    status: (content) => ({
      title: INSPECTOR_SECTION_TITLES.status,
      content,
    }),
    relationships: (rels, renderTarget) => ({
      title: INSPECTOR_SECTION_TITLES.relationships,
      content:
        rels.length === 0 ? (
          <Empty text="No connected records" />
        ) : (
          <ul className="flex flex-col gap-1.5">
            {rels.map((r) => (
              <li key={r.target.id + r.relation} className="text-sm">
                {r.available === false ? (
                  <span className="text-text-muted">
                    {r.relation}: {r.unavailableReason ?? "unavailable"}
                  </span>
                ) : (
                  renderTarget(r)
                )}
              </li>
            ))}
          </ul>
        ),
    }),
    timeline: (events, renderEvent, opts = {}) => ({
      title: INSPECTOR_SECTION_TITLES.timeline,
      collapsible: opts.collapsible ?? true,
      content:
        events.length === 0 ? (
          <Empty text="No recorded history" />
        ) : (
          <div className="flex flex-col gap-2">{events.map(renderEvent)}</div>
        ),
    }),
    actions: (actions, renderAction) => ({
      title: INSPECTOR_SECTION_TITLES.actions,
      content:
        actions.length === 0 ? (
          <Empty text="No available actions" />
        ) : (
          <div className="flex flex-col gap-2">{actions.map(renderAction)}</div>
        ),
    }),
    timelineSection: (events, opts = {}) => ({
      title: INSPECTOR_SECTION_TITLES.timeline,
      collapsible: true,
      content: (
        <EntityTimeline
          events={events}
          loading={opts.loading}
          error={opts.error}
          pageSize={opts.pageSize}
        />
      ),
    }),
  };
}
</file>

<file path="src/components/principal/shared/InvestigationWorkspace.tsx">
"use client";

/**
 * InvestigationWorkspace — PR-08. Assembles an entity's real data into the
 * unified inspector's `EntityInspection` so it can be opened with progressive
 * disclosure WITHOUT the caller re-inventing the inspector.
 *
 * This is a *composer*, not a new inspector: it delegates presentation to the
 * verified building blocks —
 *   - createInspectorSections() (PR-04) for overview/status/relationships/actions
 *   - EntityTimeline (PR-06) for recorded history
 *   - relationshipResolver (PR-07) for verified related records
 * and hands the result to the existing EntityInspector drawer.
 *
 * Data-integrity rule (protocol §12.3): it renders only what the caller passes
 * (real fetched data). An empty/failed source shows the honest empty/error
 * state, never fabricated content.
 */
import type {
  PrincipalEntityRef,
  PrincipalRelationship,
  PrincipalTimelineEvent,
  PrincipalActionDefinition,
} from "@/lib/principal/contracts";
import type { EntityInspection } from "@/components/shared/EntityInspector";
import { createInspectorSections } from "@/components/principal/shared/inspectorSections";

export interface InvestigationWorkspaceInput {
  /** The entity being investigated (real record). */
  entity: PrincipalEntityRef;
  /** One-line state descriptor ("OPEN", "ESCALATED", "RESOLVED", ...). */
  status?: string | null;
  /** Overview key/value pairs (real fields only). */
  overview?: Array<{ label: string; value: React.ReactNode }>;
  /** Verified relationships (from relationshipResolver or a real API). */
  relationships?: PrincipalRelationship[];
  /** Recorded history (from the audit timeline mapper; empty = none stored). */
  timeline?: PrincipalTimelineEvent[];
  timelineLoading?: boolean;
  timelineError?: string | null;
  /** Available actions (presentation only — the server is the authority). */
  actions?: PrincipalActionDefinition[];
  /** How to open a related entity (inspect-without-losing-origin). */
  onInspectRelated?: (ref: PrincipalEntityRef, relation: string) => void;
  /** How to run an action (must route through the authorized workflow). */
  onAction?: (action: PrincipalActionDefinition) => void;
}

/**
 * Build an EntityInspection for the given entity. Progressive disclosure is
 * preserved by the inspector: overview (0) → relationships (1) → timeline
 * (2, collapsible) → actions (3). Empty sections still render an honest
 * "no …" state so the user knows a source is empty vs. failed.
 */
export function buildInvestigationWorkspace(
  input: InvestigationWorkspaceInput,
): EntityInspection {
  const s = createInspectorSections();
  const {
    entity,
    status,
    overview = [],
    relationships = [],
    timeline = [],
    timelineLoading = false,
    timelineError = null,
    actions = [],
    onInspectRelated,
    onAction,
  } = input;

  // Relationship target: open through the unified inspector (no lost origin),
  // or render a plain label when no inspect callback is wired (honest fallback).
  const renderRelated = (r: PrincipalRelationship) =>
    onInspectRelated ? (
      <button
        type="button"
        onClick={() => onInspectRelated(r.target, r.relation)}
        disabled={r.available === false}
        className="text-action-primary underline-offset-2 hover:underline disabled:no-underline disabled:text-text-muted"
      >
        {r.relation}: {r.target.label}
      </button>
    ) : (
      <span>{r.relation}: {r.target.label}</span>
    );

  const renderAction = (a: PrincipalActionDefinition) =>
    onAction ? (
      <button
        type="button"
        onClick={() => onAction(a)}
        className="text-sm font-medium text-action-primary underline-offset-2 hover:underline"
      >
        {a.label}
        {a.confirmationRequired ? " (requires confirmation)" : ""}
      </button>
    ) : (
      <span className="text-sm text-text-muted">{a.label}</span>
    );

  return {
    kind: entity.type,
    title: entity.label,
    subtitle: entity.id,
    status: status ?? null,
    sections: [
      s.overview(overview),
      s.relationships(relationships, renderRelated),
      s.timelineSection(timeline, {
        loading: timelineLoading,
        error: timelineError,
      }),
      s.actions(actions, renderAction),
    ],
  };
}

/**
 * Convenience hook-like helper: fetches nothing itself (the caller owns data
 * fetch + RBAC via useApiResource). Given already-fetched slices, returns the
 * inspection. Kept a function (not a hook) so it's trivially unit-testable.
 */
export function investigationWorkspaceFor(
  input: InvestigationWorkspaceInput,
): EntityInspection {
  return buildInvestigationWorkspace(input);
}
</file>

