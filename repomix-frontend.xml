} from "@/components/shared/EntityInspector";
import { KVPairs, Timeline, ActionRow, InspectorButton } from "@/components/shared/EntityInspector";

export interface PermissionDetailPanelProps {
  ticket: string | null;
  onClose: () => void;
  onActionComplete?: () => void;
  isStandalonePage?: boolean;
}

/**
 * A pure function that converts a `PermissionItem` (the shape the
 * `/api/permissions/:ticket` route returns) into an `EntityInspection`
 * model. This is the consolidation seam: the local `DetailSheet` and
 * the shared `EntityInspector` both consume the same model, so they
 * always show the same data.
 *
 * The model's `detailHref` points to the page's approvals view — the
 * local sheet is the "deepest layer" (per the design doc's hierarchy:
 * ELEMENT → drawer → full detail page). The sheet itself is the
 * deepest layer; `detailHref` is the footer CTA that links out.
 */
export function permissionToInspection(
  item: PermissionItem,
  opts?: { detailHref?: string; detailLabel?: string },
): EntityInspection {
  const statusTone: "ok" | "warn" | "danger" | "neutral" =
    item.status === "APPROVED" ? "ok"
    : item.status === "REJECTED" ? "danger"
    : item.status === "PENDING" ? "warn"
    : "neutral";

  const historyItems = (item.stage_history ?? []).map((h) => ({
    label: `${h.actorName} ${h.action.toLowerCase()}`,
    time: h.timestamp ? formatDateTime(h.timestamp) : undefined,
    detail: h.comment ?? undefined,
    tone: h.action === "FORWARDED" ? ("warn" as const) : ("neutral" as const),
  }));

  const sections: InspectionSection[] = [
    {
      title: "Overview",
      content: (
        <KVPairs
          items={[
            { label: "Workflow", value: item.workflow_type },
            { label: "Current Stage", value: STAGE_LABELS[item.current_stage] || item.current_stage },
            { label: "Student", value: item.student?.name ?? "—" },
            { label: "Roll", value: item.student?.student_details?.roll ? <SmartTextRef text={item.student.student_details.roll} currentPath="/permissions" /> : "—" },
            { label: "Reason", value: item.reason ? <SmartTextRef text={item.reason} currentPath="/permissions" /> : "—" },
            { label: "Created", value: formatDateTime(item.created_at) },
          ]}
        />
      ),
    },
  ];

  if (historyItems.length > 0) {
    sections.push({
      title: "Timeline",
      collapsible: true,
      content: <Timeline items={historyItems} />,
    });
  }

  // The sheet IS the deepest layer — the actions live here, not in a
  // separate detail page. So the model exposes an Actions section.
  sections.push({
    title: "Actions",
    content: (
      <ActionRow>
        <InspectorButton variant="primary">Approve</InspectorButton>
        <InspectorButton variant="danger">Reject</InspectorButton>
      </ActionRow>
    ),
  });

  return {
    kind: "permission",
    title: item.ticket_number,
    subtitle: `${item.workflow_type} · stage ${STAGE_LABELS[item.current_stage] || item.current_stage}`,
    status: (
      <span
        className={`px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase ${
          statusTone === "ok" ? "bg-emerald-500/10 text-action-success border border-emerald-500/20"
          : statusTone === "danger" ? "bg-rose-500/10 text-action-danger border border-rose-500/20"
          : statusTone === "warn" ? "bg-amber-500/10 text-action-warning border border-amber-500/20"
          : "bg-bg-elevated text-text-muted border border-border"
        }`}
      >
        {item.status}
      </span>
    ),
    sections,
    detailHref: opts?.detailHref ?? "/principal",
    detailLabel: opts?.detailLabel ?? "Approvals view",
  };
}

export interface PermissionDetailPanelResult {
  /** The panel's render tree (the local "deepest layer"). */
  element: React.ReactNode;
  /**
   * The `EntityInspection` model derived from the ticket data.
   * Non-null when data has loaded.
   * Pass this to `useEntityInspector().inspect()` to show the
   * same data in the shared inspector.
   */
  inspection: EntityInspection | null;
}

const STAGE_LABELS: Record<string, string> = {
  caretaker: "Caretaker",
  deputy_warden: "Deputy Warden",
  hostel_manager: "Hostel Manager",
  warden_or_principal: "Warden / Principal",
  lab_incharge: "Lab In-charge",
  hod: "HOD",
  oie: "Officer in Exam (OIE)",
  vice_principal: "Vice Principal",
  principal: "Principal",
};

export function PermissionDetailPanel({
  ticket,
  onClose,
  onActionComplete,
  isStandalonePage = false,
}: PermissionDetailPanelProps) {
  const api = useApi();

  const [data, setData] = useState<PermissionItem | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [activeAction, setActiveAction] = useState<
    "APPROVE" | "REJECT" | "FORWARD" | "ESCALATE" | null
  >(null);
  const [comment, setComment] = useState("");
  const [actionLoading, setActionLoading] = useState(false);
  const addToast = useUIStore((s) => s.addToast);
  const currentUser = useAuthStore((s) => s.user);
  const currentRole = currentUser?.role;

  const [forwardOpen, setForwardOpen] = useState(false);
  const [directGenOpen, setDirectGenOpen] = useState(false);
  const [qrOpen, setQrOpen] = useState(false);
  const [quotaOverrideOpen, setQuotaOverrideOpen] = useState(false);
  const [coSignOpen, setCoSignOpen] = useState(false);

  // Config lookup for the current pass type (data-driven, not a union)
  const passTypeConfig = PASS_TYPE_SEED.find((c) => c.code === data?.reason);

  // Co-sign required when the subject is on probation and the CoC policy
  // mandates dual approval. Fetch co-signers when the ticket loads.
  const subjectFlag = (data?.student as unknown as { conductFlag?: FlagLevel })?.conductFlag;
  const coSignRequired = subjectFlag === "probation";
  const [coSigners, setCoSigners] = useState<Array<{ userId: string; name: string; role: string }>>([]);

  useEffect(() => {
    if (!coSignRequired || !ticket) return;
    fetch("/api/permissions/co-signers", {
      headers: getAuthHeaders(),
      cache: "no-store",
    })
      .then((r) => (r.ok ? r.json() : null))
      .then((b) => setCoSigners((b?.data ?? []) as Array<{ userId: string; name: string; role: string }>))
      .catch(() => {});
  }, [coSignRequired, ticket]);

  // Room-assignment fields for the day_scholar home_out approval flow.
  const [pendingHostelBlock, setPendingHostelBlock] = useState("");
  const [pendingRoomNumber, setPendingRoomNumber] = useState("");
  const [pendingWardenId, setPendingWardenId] = useState("");
  const [roomFieldError, setRoomFieldError] = useState<string | null>(null);

  // The student is a day_scholar when their live entry type says so. A
  // student who already has an assigned hostel_block/room_number is a
  // hosteller (not a day scholar), so the room-field gate does not apply.
  const studentEntryType =
    data?.student?.student_details?.current_entry_type ??
    data?.student?.student_details?.currentEntryType ??
    null;
  const studentIsDayScholar =
    studentEntryType === "day_scholar" &&
    !data?.student?.student_details?.hostel_block &&
    !data?.student?.student_details?.room_number;
  // A day_scholar home_out ticket (the room fields are required to approve it).
  const isDayScholarHomeOut =
    data?.workflow_type === "hostel" &&
    data?.reason === "home_out" &&
    studentIsDayScholar;

  // L1..L3 approvers can forward; principal/L4 and anyone above the chain top
  // cannot (levelsAbove is empty for L4). The Forward button is shown only
  // when the caller is in that band AND there is a strictly-higher level.
  const canForward =
    !!currentRole &&
    [L1_ROLE, L2_ROLE, L3_ROLE].includes(currentRole) &&
    levelsAbove(currentRole).length > 0;

  // G26: L4 (principal) cannot escalate — there is no level above them.
  // Hide the button so the operator is not confused by a 400 on click.
  const canEscalate = !!currentRole && levelsAbove(currentRole).length > 0;

  // L2+ (deputy_warden, hostel_manager, principal) plus sysadmin/admin may
  // direct-generate. The server re-checks the same DIRECT_GENERATE_ROLES list.
  const canDirectGenerate =
    !!currentRole &&
    [L2_ROLE, L3_ROLE, L4_ROLE, "sysadmin", "admin"].includes(currentRole);

  // Exam/memo requests carry an uploaded document + digital signature (Step 7).
  const isExamMemo = data?.workflow_type === "exam" || data?.workflow_type === "memo";

  // Role-ability layer: why THIS viewer is on this ticket. Computed from the
  // live record + the viewer's role/scope. The real buttons below are still
  // gated by canForward/canEscalate/canDirectGenerate + the server; this is
  // the "your role here" banner.
  const ability =
    data && currentRole
      ? resolvePermissionAbility(
          {
            id: data.id ?? ticket ?? "",
            ticket_number: data.ticket_number,
            workflow_type: data.workflow_type,
            current_stage: data.current_stage,
            status: data.status,
            student_user_id: data.student_user_id,
            hostel_scope: (data as unknown as { hostel_scope?: string | null }).hostel_scope,
          },
          makeViewer(currentRole, {
            userId: currentUser?.id ?? "",
            departmentId: currentUser?.departmentId ?? null,
            hostelScope:
              currentUser?.studentDetails?.hostelBlock ??
              null,
            assignedGateId: currentUser?.gateId ?? null,
          }),
        )
      : null;

  const fetchDetail = useCallback(async () => {
    if (!ticket) return;
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(`/api/permissions/${encodeURIComponent(ticket)}`, {
        headers: api.getHeaders(),
        cache: "no-store",
      });
      const json = await res.json();
      if (json.success && json.data) {
        setData(json.data);
      } else {
        setError(json.error?.message || "Failed to load permission details");
      }
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : "Network error");
    } finally {
      setLoading(false);
    }
  }, [ticket]);

  useEffect(() => {
    if (!ticket) return;
    let ignore = false;

    fetch(`/api/permissions/${encodeURIComponent(ticket)}`, {
      headers: api.getHeaders(),
      cache: "no-store",
    })
      .then((res) => res.json())
      .then((json) => {
        if (!ignore) {
          if (json.success && json.data) {
            setData(json.data);
          } else {
            setError(json.error?.message || "Failed to load permission details");
          }
        }
      })
      .catch((err: unknown) => {
        if (!ignore) {
          setError(err instanceof Error ? err.message : "Network error");
        }
      });

    return () => {
      ignore = true;
    };
  }, [ticket]);

  const handleAction = async (action: "APPROVE" | "REJECT" | "FORWARD" | "ESCALATE") => {
    if (!ticket) return;

    // Day-scholar home_out approval requires all three room-assignment fields.
    if (action === "APPROVE" && isDayScholarHomeOut) {
      if (!pendingHostelBlock.trim() || !pendingRoomNumber.trim() || !pendingWardenId.trim()) {
        setRoomFieldError("All three room fields are required for day scholar home-out approval");
        return;
      }
      setRoomFieldError(null);
    }

    setActionLoading(true);
    setRoomFieldError(null);
    try {
      const body: Record<string, unknown> = {
        action,
        comment: comment.trim() || undefined,
      };
      if (action === "APPROVE" && isDayScholarHomeOut) {
        body.pendingHostelBlock = pendingHostelBlock.trim();
        body.pendingRoomNumber = pendingRoomNumber.trim();
        body.pendingWardenId = pendingWardenId.trim();
      }
      const res = await fetch(`/api/permissions/${encodeURIComponent(ticket)}`, {
        method: "PATCH",
        headers: api.getHeaders(),
        body: JSON.stringify(body),
      });
      const json = await res.json();
      if (json.success) {
        addToast({
          message: `Action ${action} processed successfully`,
          variant: action === "REJECT" ? "info" : "success",
        });
        setActiveAction(null);
        setComment("");
        setPendingHostelBlock("");
        setPendingRoomNumber("");
        setPendingWardenId("");
        await fetchDetail();
        if (onActionComplete) onActionComplete();
      } else {
        // Surface the room-field requirement inline when the server rejects
        // a missing room assignment (HOSTEL_ROOM_REQUIRED).
        if (json.error?.code === "HOSTEL_ROOM_REQUIRED") {
          setRoomFieldError("All three room fields are required for day scholar home-out approval");
        }
        addToast({
          message: json.error?.message || `Failed to process ${action}`,
          variant: "error",
        });
      }
    } catch (err: unknown) {
      addToast({
        message: err instanceof Error ? err.message : "Action failed",
        variant: "error",
      });
    } finally {
      setActionLoading(false);
    }
  };

  if (!ticket) return null;

  const content = (
    <div className="space-y-6">
      <div className="surface-card flex items-center justify-between pb-4">
        <div className="flex items-center gap-3">
          {isStandalonePage && (
            <button
              type="button"
              onClick={onClose}
              className="surface-card p-1.5 hover:bg-bg-elevated text-text-secondary"
            >
              <ArrowLeft className="w-4 h-4" />
            </button>
          )}
          <div>
            <div className="flex items-center gap-2">
              <span className="font-mono text-base font-bold text-action-primary">
                {ticket}
              </span>
              {data && (
                <span
                  className={`px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wider ${
                    data.status === "PENDING"
                      ? "bg-amber-500/10 text-action-warning border border-amber-500/20"
                      : data.status === "APPROVED"
                      ? "bg-emerald-500/10 text-action-success border border-emerald-500/20"
                      : data.status === "REJECTED"
                      ? "bg-rose-500/10 text-action-danger border border-rose-500/20"
                      : "bg-blue-500/10 text-action-primary border border-blue-500/20"
                  }`}
                >
                  {data.status}
                </span>
              )}
            </div>
            <p className="text-xs text-text-secondary mt-0.5">
              Workflow: <span className="font-semibold">{data?.workflow_type || "—"}</span>
            </p>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <Button
            size="sm"
            variant="secondary"
            onClick={fetchDetail}
            loading={loading}
            disabled={loading}
          >
            <RefreshCw className={`w-3.5 h-3.5 mr-1 ${loading ? "animate-spin" : ""}`} />
            Refresh
          </Button>
          {!isStandalonePage && (
            <button
              type="button"
              onClick={onClose}
              className="surface-card p-1.5 hover:bg-bg-elevated text-text-muted hover:text-text-primary"
            >
              <X className="w-5 h-5" />
            </button>
          )}
        </div>
      </div>

      {loading && !data && (
        <div className="flex items-center justify-center p-12 text-sm text-text-muted">
          <RefreshCw className="w-5 h-5 animate-spin mr-2" />
          Loading request details...
        </div>
      )}

      {error && (
        <div className="surface-card p-4 bg-rose-500/10 text-action-danger text-sm flex items-center gap-2">
          <AlertTriangle className="w-4 h-4 shrink-0" />
          <span>{error}</span>
        </div>
      )}

      {data && (
        <div className="space-y-6">
          {data.status === "APPROVED" && (
            <div className="surface-card bg-emerald-500/10 p-4 flex items-center justify-between gap-3">
              <div className="flex items-center gap-2 text-action-success">
                <QrCode className="w-5 h-5 shrink-0" />
                <div>
                  <p className="text-xs font-bold text-action-success">Approved Pass Credential Ready</p>
                  <p className="text-xs text-emerald-400/80">Scan this pass credential at campus gates.</p>
                </div>
              </div>
              <Button
                size="sm"
                onClick={() => setQrOpen(true)}
                className="bg-action-success hover:bg-action-success text-white font-bold text-xs shrink-0"
              >
                <QrCode className="w-3.5 h-3.5 mr-1.5" />
                Show Pass QR
              </Button>
            </div>
          )}
          {passTypeConfig && passTypeConfig.requiresParentConsent && data.status === "PENDING" && (
            <ParentConsentStage request={data} />
          )}

          {/* Conduct flag banner — shows when the student has an active flag */}
          {(data.student as unknown as { conductFlag?: FlagLevel })?.conductFlag &&
            (data.student as unknown as { conductFlag: FlagLevel }).conductFlag !== "clear" && (
            <div className="rounded-xl border border-amber-500/30 bg-amber-500/5 p-3 flex items-center gap-3">
              <AlertTriangle className="h-4 w-4 text-amber-500 shrink-0" />
              <div className="flex-1 min-w-0">
                <p className="text-xs font-semibold text-amber-600">
                  Subject is on {(data.student as unknown as { conductFlag: FlagLevel }).conductFlag}
                </p>
                <p className="text-[10px] text-text-muted">
                  {(data.student as unknown as { conductFlagReason?: string }).conductFlagReason ??
                    "Review the conduct ledger before approving."}
                </p>
              </div>
              <FlagBadge
                flag={(data.student as unknown as { conductFlag: FlagLevel }).conductFlag}
              />
            </div>
          )}

          {passTypeConfig && (passTypeConfig.quotaKey ?? null) && data.status === "PENDING" && (
            <div className="flex items-center justify-between rounded-xl border border-amber-500/30 bg-amber-500/5 p-3">
              <div className="text-xs">
                <p className="font-semibold text-amber-600">Quota check</p>
                <p className="text-text-muted">
                  {passTypeConfig.quotaKey} · limit {passTypeConfig.quotaLimit}/{passTypeConfig.quotaWindow}
                  {" — "}
                  warden may override with a documented reason.
                </p>
              </div>
              <button
                type="button"
                onClick={() => setQuotaOverrideOpen(true)}
                className="rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-white hover:opacity-90 shrink-0"
              >
                Override
              </button>
            </div>
          )}

          {data && (
            <LateReturnFlag request={data} />
          )}

          <div className="surface-card bg-bg-elevated p-4 space-y-3">
            <div className="flex items-center justify-between">
              <h3 className="text-xs font-bold text-text-muted uppercase tracking-wider flex items-center gap-1.5">
                <User className="w-3.5 h-3.5" />
                Student Profile
              </h3>
              {studentEntryType && (
                <PersonaBadge
                  persona={studentEntryType === "hosteller" ? "hosteller" : "day_scholar"}
                />
              )}
            </div>
            <div className="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
              <div>
                <span className="text-text-muted block">Name</span>
                <span className="font-medium text-text-primary">
                  {data.student?.name || "—"}
                </span>
              </div>
              <div>
                <span className="text-text-muted block">Roll Number</span>
                <span className="font-mono font-medium text-text-primary">
                  {data.student?.student_details?.roll || "—"}
                </span>
              </div>
              <div>
                <span className="text-text-muted block">Year & Section</span>
                <span className="font-medium text-text-primary">
                  {data.student?.student_details?.year
                    ? `Year ${data.student.student_details.year} (${data.student.student_details.section || "—"})`
                    : "—"}
                </span>
              </div>
              <div>
                <span className="text-text-muted block">Hostel Block / Room</span>
                <span className="font-medium text-text-primary">
                  {data.student?.student_details?.hostel_block
                    ? `${data.student.student_details.hostel_block} - Room ${data.student.student_details.room_number || "—"}`
                    : "—"}
                </span>
              </div>
              <div>
                <span className="text-text-muted block">Contact Email</span>
                <span className="font-mono text-text-primary truncate block">
                  {data.student?.email || "—"}
                </span>
              </div>
              <div>
                <span className="text-text-muted block">Current Stage</span>
                <span className="font-medium text-action-primary">
                  {STAGE_LABELS[data.current_stage] || data.current_stage}
                </span>
              </div>
            </div>
          </div>

          <div className="surface-card bg-bg-elevated p-4 space-y-3">
            <h3 className="text-xs font-bold text-text-muted uppercase tracking-wider flex items-center gap-1.5">
              <Shield className="w-3.5 h-3.5" />
              Verification Status
            </h3>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div className="surface-card flex items-center gap-2 p-2.5 bg-bg-surface">
                <Fingerprint className="w-4 h-4 text-action-primary" />
                <div>
                  <span className="text-text-muted block text-xs">
                    Hostel Biometric Check
                  </span>
                  <span className="font-medium text-text-primary">
                    {data.biometric_hostel_at
                      ? formatDateTime(data.biometric_hostel_at)
                      : "Pending scan"}
                  </span>
                </div>
              </div>

              <div className="surface-card flex items-center gap-2 p-2.5 bg-bg-surface">
                <Fingerprint className="w-4 h-4 text-action-primary" />
                <div>
                  <span className="text-text-muted block text-xs">
                    Main Gate Biometric Check
                  </span>
                  <span className="font-medium text-text-primary">
                    {data.biometric_gate_at
                      ? formatDateTime(data.biometric_gate_at)
                      : "Pending scan"}
                  </span>
                </div>
              </div>

              {data.document_required && (
                <div className="surface-card col-span-full p-2.5 bg-bg-surface flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <PenTool className="w-4 h-4 text-action-warning" />
                    <div>
                      <span className="text-text-muted block text-xs">
                        Attached Document / Proof
                      </span>
                      <span className="font-medium text-text-primary">
                        {data.document_url ? "Document provided" : "Missing document"}
                      </span>
                    </div>
                  </div>
                  {data.document_url && (
                    <a
                      href={data.document_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="inline-flex items-center gap-1 text-xs text-action-primary hover:underline font-medium"
                    >
                      View Document
                      <ExternalLink className="size-3.5" />
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>

          {data.status === "PENDING" && (
            <div className="surface-card bg-bg-elevated p-4 space-y-4">
              {/* Role-ability banner: why THIS viewer is here + their turn */}
              {ability && (
                <div className="flex items-start gap-2 rounded-lg border border-action-primary/20 bg-bg-surface p-3">
                  <Shield className="h-4 w-4 text-action-primary shrink-0 mt-0.5" aria-hidden />
                  <div className="min-w-0">
                    <p className="text-[11px] font-semibold uppercase tracking-wide text-text-muted">
                      Your role here · {ability.mode}
                    </p>
                    <p className="mt-0.5 text-xs text-text-secondary">{ability.roleReason}</p>
                  </div>
                </div>
              )}
              <h3 className="text-xs font-bold text-text-muted uppercase tracking-wider">
                Workflow Decisions
              </h3>

              {activeAction ? (
                <div className="surface-card space-y-3 p-3 bg-bg-surface">
                  <div className="flex items-center justify-between">
                    <span className="text-xs font-bold uppercase text-text-primary">
                      Execute {activeAction}
                    </span>
                    <button
                      type="button"
                      onClick={() => setActiveAction(null)}
                      className="text-xs text-text-muted hover:text-text-primary"
                    >
                      Cancel
                    </button>
                  </div>

                  <textarea
                    value={comment}
                    onChange={(e) => setComment(e.target.value)}
                    placeholder="Enter remarks/reason for this decision..."
                    rows={2}
                    className="surface-card w-full text-xs p-2 bg-bg-elevated text-text-primary focus:outline-none focus:ring-1 focus:ring-action-primary"
                  />

                  {/* Room-assignment fields: required to approve a day_scholar home_out ticket */}
                  {activeAction === "APPROVE" && isDayScholarHomeOut && (
                    <div className="surface-card space-y-2 p-2.5 bg-bg-elevated">
                      <p className="text-xs font-semibold text-text-secondary uppercase tracking-wide">
                        Hostel Room Assignment
                        <span className="ml-1 text-action-danger">* required</span>
                      </p>
                      <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <div>
                          <label className="block text-xs font-medium text-text-muted mb-1">
                            Hostel Block
                          </label>
                          <Input
                            value={pendingHostelBlock}
                            onChange={(e) => setPendingHostelBlock(e.target.value)}
                            placeholder="e.g. A"
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-medium text-text-muted mb-1">
                            Room Number
                          </label>
                          <Input
                            value={pendingRoomNumber}
                            onChange={(e) => setPendingRoomNumber(e.target.value)}
                            placeholder="e.g. 12"
                          />
                        </div>
                        <div>
                          <label className="block text-xs font-medium text-text-muted mb-1">
                            Warden ID
                          </label>
                          <Input
                            value={pendingWardenId}
                            onChange={(e) => setPendingWardenId(e.target.value)}
                            placeholder="Warden user id"
                          />
                        </div>
                      </div>
                      {roomFieldError && (
                        <p className="text-xs text-action-danger">{roomFieldError}</p>
                      )}
                    </div>
                  )}

                  <div className="flex items-center justify-end gap-2">
                    <Button
                      size="sm"
                      variant="secondary"
                      onClick={() => setActiveAction(null)}
                      disabled={actionLoading}
                    >
                      Back
                    </Button>
                    <Button
                      size="sm"
                      variant={activeAction === "REJECT" ? "danger" : "primary"}
                      onClick={() => handleAction(activeAction)}
                      loading={actionLoading}
                      disabled={actionLoading}
                    >
                      Confirm {activeAction}
                    </Button>
                  </div>
                </div>
              ) : (
                <div className="flex flex-wrap items-center gap-2">
                  <Button
                    size="sm"
                    variant="primary"
                    onClick={() => {
                      if (coSignRequired && coSigners.length > 0) {
                        setCoSignOpen(true);
                      } else {
                        setActiveAction("APPROVE");
                      }
                    }}
                    className="bg-action-success hover:bg-emerald-700 text-white"
                  >
                    <CheckCircle className="w-3.5 h-3.5 mr-1" />
                    {coSignRequired ? "Approve (co-sign)" : "Approve"}
                  </Button>

                  {coSignRequired && coSigners.length === 0 && (
                    <span className="text-[10px] text-amber-500 flex items-center gap-1">
                      <Shield className="h-4 w-4" /> Co-sign required — no co-signers available
                    </span>
                  )}

                  <Button
                    size="sm"
                    variant="danger"
                    onClick={() => setActiveAction("REJECT")}
                  >
                    <XCircle className="w-3.5 h-3.5 mr-1" />
                    Reject
                  </Button>

                  <Button
                    size="sm"
                    variant="secondary"
                    onClick={() => setActiveAction("FORWARD")}
                  >
                    <Forward className="w-3.5 h-3.5 mr-1" />
                    Forward Stage
                  </Button>

                  <Button
                    size="sm"
                    variant="secondary"
                    onClick={() => setActiveAction("ESCALATE")}
                    disabled={!canEscalate}
                  >
                    <AlertTriangle className="w-3.5 h-3.5 mr-1" />
                    Escalate
                  </Button>

                  {canForward && (
                    <Button
                      size="sm"
                      variant="secondary"
                      onClick={() => setForwardOpen(true)}
                    >
                      <CornerUpRight className="w-3.5 h-3.5 mr-1" />
                      Forward
                    </Button>
                  )}

                  {canDirectGenerate && (
                    <Button
                      size="sm"
                      variant="secondary"
                      onClick={() => setDirectGenOpen(true)}
                    >
                      <Zap className="w-3.5 h-3.5 mr-1" />
                      Generate Pass
                    </Button>
                  )}
                </div>
              )}
            </div>
          )}

          {isExamMemo && (
            <div className="surface-card bg-bg-surface p-4 space-y-2">
              <h3 className="text-xs font-bold text-text-muted uppercase tracking-wider flex items-center gap-1.5">
                <FileText className="w-3.5 h-3.5" />
                Document
              </h3>
              <DocumentUploadPanel
                ticketNumber={data.ticket_number}
                workflowType={data.workflow_type === "memo" ? "memo" : "exam"}
                currentStage={data.current_stage}
                status={data.status}
                documentUrl={data.document_url}
                onUploaded={fetchDetail}
              />
            </div>
          )}

          {isExamMemo && (
            <div className="surface-card bg-bg-surface p-4 space-y-2">
              <h3 className="text-xs font-bold text-text-muted uppercase tracking-wider flex items-center gap-1.5">
                <PenTool className="w-3.5 h-3.5" />
                Digital Signature
              </h3>
              <DigitalSignPanel
                ticketNumber={data.ticket_number}
                workflowType={data.workflow_type === "memo" ? "memo" : "exam"}
                currentStage={data.current_stage}
                status={data.status}
                documentUrl={data.document_url}
                digitalSignature={data.digital_signature}
                onSigned={fetchDetail}
              />
            </div>
          )}

          <div className="space-y-3">
            <h3 className="text-xs font-bold text-text-muted uppercase tracking-wider flex items-center gap-1.5">
              <Clock className="w-3.5 h-3.5" />
              Stage History & Audit Log
            </h3>

            {(!data.stage_history || data.stage_history.length === 0) ? (
              <p className="text-xs text-text-muted italic">No stage history recorded.</p>
            ) : (
              <div className="surface-card space-y-2 ml-2 pl-4">
                {data.stage_history.map((log, index) => (
                  <div key={index} className="space-y-1 relative group">
                    <div className="absolute -left-[21px] top-1 size-4 rounded-full bg-action-primary ring-4 ringbg-surface" />
                    <div className="flex items-center gap-2">
                      <span className="font-semibold text-xs text-text-primary">
                        {log.actorName || "System Actor"}
                      </span>
                      <span className="text-xs text-text-muted font-mono">
                        ({log.actorRole || "System"})
                      </span>
                      {log.action === "FORWARDED" && (
                        <CornerUpRight className="w-3.5 h-3.5 text-action-warning" aria-label="Forwarded" />
                      )}
                      <span
                        className={`text-xs px-1.5 py-0.5 rounded font-semibold uppercase ${
                          log.action === "FORWARDED"
                            ? "bg-amber-500/10 text-action-warning border border-amber-500/20"
                            : "bg-bg-elevated border border-border text-action-primary"
                        }`}
                      >
                        {log.action}
                      </span>
                    </div>
                    {log.comment && (
                      <p className="text-xs text-text-secondary italic">
                        &ldquo;{log.comment}&rdquo;
                      </p>
                    )}
                    <span className="text-xs text-text-muted block">
                      {formatDateTime(log.timestamp)}
                    </span>
                  </div>
                ))}
              </div>
            )}
          </div>

          {forwardOpen && ticket && (
            <HostelForwardModal
              isOpen={forwardOpen}
              onClose={() => setForwardOpen(false)}
              ticket={ticket}
              actorRole={currentRole || ""}
              onForwarded={fetchDetail}
            />
          )}

          {directGenOpen && (
            <DirectGenerateModal
              isOpen={directGenOpen}
              onClose={() => setDirectGenOpen(false)}
              actorRole={currentRole || ""}
              onGenerated={onActionComplete}
              defaultStudentUserId={data?.student_user_id}
              defaultStudentName={data?.student?.name}
              defaultStudentEntryType={studentEntryType}
              ticketNumber={ticket}
            />
          )}

          {qrOpen && ticket && (
            <PassQrModal
              isOpen={qrOpen}
              ticketNumber={ticket}
              passTitle={`${data.workflow_type || "Gate"} Pass`}
              fromDate={data.from_date ?? data.fromDate ?? undefined}
              toDate={data.to_date ?? data.toDate ?? undefined}
              onClose={() => setQrOpen(false)}
            />
          )}

          {quotaOverrideOpen && data && passTypeConfig && (
            <QuotaOverrideModal
              isOpen={quotaOverrideOpen}
              onClose={() => setQuotaOverrideOpen(false)}
              request={data}
              config={passTypeConfig}
              onApproved={() => { void fetchDetail(); }}
            />
          )}

          {coSignOpen && data && coSignRequired && (
            <CoSignModal
              isOpen={coSignOpen}
              onClose={() => setCoSignOpen(false)}
              request={data}
              policy={{
                id: "dual-probation",
                domain: "hostel",
                rule: "Probation-flagged requests need co-sign from tier+1",
                appliesTo: ["probation"],
                action: "require_dual",
              }}
              coSigners={coSigners}
              onCoSigned={() => { void fetchDetail(); }}
            />
          )}
        </div>
      )}
    </div>
  );

  if (isStandalonePage) {
    return content;
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4 overflow-y-auto">
      <div className="surface-card bg-bg-surface max-w-2xl w-full p-6 my-8 max-h-[90vh] overflow-y-auto">
        {content}
      </div>
    </div>
  );
}
</file>

<file path="src/components/approver/PermissionList.tsx">
"use client";

import React, { useState, useMemo, useEffect, useCallback } from "react";
import { Search, Filter, RefreshCw, AlertCircle } from "lucide-react";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { PermissionRow, type PermissionItem } from "./PermissionRow";
import { BulkActionsBar } from "./BulkActionsBar";
import { PermissionDetailPanel } from "./PermissionDetailPanel";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { richTicketInspection } from "@/components/shared/inspectionModels";
import { useUIStore } from "@/stores/uiStore";
import { useAuthStore } from "@/stores/authStore";
import { getAuthHeaders } from "@/lib/utils";
import {
  LevelBadge,
  ForwardedFromChip,
  DirectBadge,
  sortHostelTickets,
  type HostelTicketRow,
} from "./HostelTicketBadges";

export interface PermissionListProps {
  title: string;
  description?: string;
  subtitle?: string;
  workflowType?: string;
  stageFilter?: string;
  currentStage?: string;
  hostelScope?: "boys" | "girls";
  initialPermissions?: PermissionItem[];
  fetchUrl?: string;
  allowForward?: boolean;
}

export function PermissionList({
  title,
  description,
  subtitle,
  workflowType,
  stageFilter,
  currentStage,
  hostelScope,
  initialPermissions = [],
  fetchUrl,
  allowForward = false,
}: PermissionListProps) {
  const [permissions, setPermissions] = useState<PermissionItem[]>(initialPermissions);
  const [loading, setLoading] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState<string>("ALL");
  const [selectedTickets, setSelectedTickets] = useState<Set<string>>(new Set());
  const [activeDetailTicket, setActiveDetailTicket] = useState<string | null>(null);
  const [activeInspectTicket, setActiveInspectTicket] = useState<string | null>(null);
  const [actionLoading, setActionLoading] = useState(false);
  const addToast = useUIStore((s) => s.addToast);
  const viewerRole = useAuthStore((s) => s.role);

  const effectiveDescription = description || subtitle || "";
  const effectiveStage = stageFilter || currentStage;

  const getEffectiveUrl = useCallback(() => {
    if (fetchUrl) return fetchUrl;
    const params = new URLSearchParams();
    if (workflowType) params.set("workflowType", workflowType);
    if (effectiveStage) params.set("stage", effectiveStage);
    if (hostelScope) params.set("hostelScope", hostelScope);
    const qs = params.toString();
    return `/api/permissions${qs ? `?${qs}` : ""}`;
  }, [fetchUrl, workflowType, effectiveStage, hostelScope]);

  const fetchPermissions = useCallback(async () => {
    setLoading(true);
    try {
      const url = getEffectiveUrl();
      const res = await fetch(url, {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const json = await res.json();
      if (json.success && Array.isArray(json.data)) {
        setPermissions(json.data);
      } else {
        addToast({
          message: json.error?.message || "Failed to load permissions",
          variant: "error",
        });
      }
    } catch (err: unknown) {
      addToast({
        message: err instanceof Error ? err.message : "Network error",
        variant: "error",
      });
    } finally {
      setLoading(false);
    }
  }, [getEffectiveUrl, addToast]);

  useEffect(() => {
    // Render from the provided initialPermissions without re-fetching when
    // the parent already loaded the queue (prevents the double-fetch storm
    // on exam/permissions where useApiResource already owns the data).
    if (initialPermissions && initialPermissions.length > 0) return;
    let ignore = false;
    const url = getEffectiveUrl();
    fetch(url, {
      headers: getAuthHeaders(),
      cache: "no-store",
    })
      .then((res) => res.json())
      .then((json) => {
        if (!ignore && json.success && Array.isArray(json.data)) {
          setPermissions(json.data);
        }
      })
      .catch(() => {});

    return () => {
      ignore = true;
    };
  }, [getEffectiveUrl, initialPermissions]);

  const filteredPermissions = useMemo(() => {
    const filtered = permissions.filter((p) => {
      if (statusFilter !== "ALL" && p.status !== statusFilter) {
        return false;
      }
      if (!searchQuery) return true;
      const q = searchQuery.toLowerCase();
      const studentName = p.student?.name?.toLowerCase() || "";
      const roll = p.student?.student_details?.roll?.toLowerCase() || "";
      const ticket = p.ticket_number?.toLowerCase() || "";
      return studentName.includes(q) || roll.includes(q) || ticket.includes(q);
    });
    // Pinned (forwarded to me) -> SLA-overdue -> rest.
    return sortHostelTickets(filtered, viewerRole);
  }, [permissions, searchQuery, statusFilter, viewerRole]);

  const handleToggleSelect = (ticket: string) => {
    setSelectedTickets((prev) => {
      const next = new Set(prev);
      if (next.has(ticket)) {
        next.delete(ticket);
      } else {
        next.add(ticket);
      }
      return next;
    });
  };

  const handleSelectAllFiltered = () => {
    if (selectedTickets.size === filteredPermissions.length && filteredPermissions.length > 0) {
      setSelectedTickets(new Set());
    } else {
      setSelectedTickets(new Set(filteredPermissions.map((p) => p.ticket_number)));
    }
  };

  const handleSingleAction = async (
    ticket: string,
    action: "APPROVE" | "REJECT" | "FORWARD" | "ESCALATE",
    comment?: string
  ) => {
    setActionLoading(true);
    try {
      const res = await fetch(`/api/permissions/${encodeURIComponent(ticket)}`, {
        method: "PATCH",
        headers: getAuthHeaders(),
        body: JSON.stringify({ action, comment }),
      });
      const json = await res.json();
      if (json.success) {
        addToast({
          message: `Ticket ${ticket} ${action.toLowerCase()}d successfully`,
          variant: action === "REJECT" ? "info" : "success",
        });
        await fetchPermissions();
      } else {
        addToast({
          message: json.error?.message || `Failed to ${action.toLowerCase()} ticket`,
          variant: "error",
        });
      }
    } catch (err: unknown) {
      addToast({
        message: err instanceof Error ? err.message : "Action failed",
        variant: "error",
      });
    } finally {
      setActionLoading(false);
    }
  };

  const handleBulkAction = async (
    action: "APPROVE" | "REJECT" | "FORWARD",
    comment?: string
  ) => {
    if (selectedTickets.size === 0) return;
    setActionLoading(true);
    let successCount = 0;
    let failCount = 0;

    for (const ticket of Array.from(selectedTickets)) {
      try {
        const res = await fetch(`/api/permissions/${encodeURIComponent(ticket)}`, {
          method: "PATCH",
          headers: getAuthHeaders(),
          body: JSON.stringify({ action, comment }),
        });
        const json = await res.json();
        if (json.success) {
          successCount++;
        } else {
          failCount++;
        }
      } catch {
        failCount++;
      }
    }

    addToast({
      message: `Bulk ${action.toLowerCase()}: ${successCount} succeeded, ${failCount} failed`,
      variant: failCount > 0 ? "warning" : "success",
    });

    setSelectedTickets(new Set());
    await fetchPermissions();
    setActionLoading(false);
  };

  return (
    <div className="space-y-6 min-w-0">
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 min-w-0">
        <div className="min-w-0">
          <p className="text-xl sm:text-2xl font-bold text-text-primary min-w-0 truncate">{title}</p>
          {effectiveDescription && (
            <p className="text-sm text-text-secondary mt-1 min-w-0">{effectiveDescription}</p>
          )}
        </div>
        <div className="flex items-center gap-2 shrink-0">
          <Button
            size="sm"
            variant="secondary"
            onClick={fetchPermissions}
            loading={loading}
            disabled={loading}
          >
            <RefreshCw className={`w-4 h-4 mr-1.5 ${loading ? "animate-spin" : ""}`} />
            Refresh
          </Button>
        </div>
      </div>

      <div className="surface-card flex flex-col md:flex-row md:items-center md:justify-between gap-3 bg-bg-surface p-3 min-w-0">
        <div className="relative w-full md:w-80">
          <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" />
          <Input
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Search by name, roll, or ticket..."
            className="pl-9 text-sm"
          />
        </div>

        <div className="flex items-center gap-2 w-full md:w-auto justify-between md:justify-end min-w-0">
          <div className="flex items-center gap-1.5 text-xs text-text-muted mr-2 shrink-0">
            <Filter className="w-3.5 h-3.5" />
            <span>Status:</span>
          </div>
          <div className="flex items-center gap-1 overflow-x-auto min-w-0">
            {["ALL", "PENDING", "APPROVED", "REJECTED"].map((status) => (
              <button
                key={status}
                type="button"
                onClick={() => setStatusFilter(status)}
                className={`px-3 py-1 rounded-lg text-xs font-semibold transition-colors whitespace-nowrap ${
                  statusFilter === status
                    ? "bg-action-primary text-white"
                    : "bg-bg-elevated text-text-secondary hover:bg-bg-surface"
                }`}
              >
                {status}
              </button>
            ))}
          </div>
        </div>
      </div>

      {filteredPermissions.length > 0 && (
        <div className="flex items-center justify-between px-1 text-xs text-text-muted min-w-0">
          <button
            type="button"
            onClick={handleSelectAllFiltered}
            className="hover:text-text-primary font-medium min-w-0"
          >
            {selectedTickets.size === filteredPermissions.length
              ? "Deselect all visible"
              : `Select all visible (${filteredPermissions.length})`}
          </button>
          <span className="shrink-0">Showing {filteredPermissions.length} requests</span>
        </div>
      )}

      {filteredPermissions.length === 0 ? (
        <div className="surface-card flex flex-col items-center justify-center p-12 bg-bg-surface text-center space-y-3 min-w-0">
          <AlertCircle className="size-6 text-text-muted" />
          <div className="space-y-1 max-w-md">
            <h3 className="text-base font-semibold text-text-primary">
              No permission requests found
            </h3>
            <p className="text-xs text-text-muted">
              {searchQuery || statusFilter !== "ALL"
                ? "No items match your active search or filter criteria."
                : "There are currently no permission requests assigned to this queue."}
            </p>
          </div>
        </div>
      ) : (
        <div className="space-y-3 min-w-0">
          {filteredPermissions.map((req) => {
            const hostelRow = req as HostelTicketRow;
            const showBadges =
              hostelRow.routed_to_role ||
              hostelRow.forwarded_from_role ||
              hostelRow.direct_generated;
            return (
              <div key={req.id || req.ticket_number} className="space-y-1.5 min-w-0">
                {showBadges && (
                  <div className="flex flex-wrap items-center gap-1.5 px-1">
                    <LevelBadge row={hostelRow} fallbackStage={req.current_stage} />
                    <ForwardedFromChip row={hostelRow} />
                    <DirectBadge row={hostelRow} />
                  </div>
                )}
                <PermissionRow
                  request={req}
                  isSelected={selectedTickets.has(req.ticket_number)}
                  onToggleSelect={handleToggleSelect}
                  onViewDetails={(ticket) => setActiveInspectTicket(ticket)}
                  onQuickApprove={(ticket) => handleSingleAction(ticket, "APPROVE")}
                  onQuickReject={(ticket) => handleSingleAction(ticket, "REJECT")}
                  loadingAction={actionLoading}
                />
              </div>
            );
          })}
        </div>
      )}

      <BulkActionsBar
        selectedCount={selectedTickets.size}
        onApprove={() => handleBulkAction("APPROVE")}
        onReject={(comment) => handleBulkAction("REJECT", comment)}
        onForward={allowForward ? (comment) => handleBulkAction("FORWARD", comment) : undefined}
        onClear={() => setSelectedTickets(new Set())}
        isLoading={actionLoading}
      />

      {activeInspectTicket && (
        (() => {
          const item = permissions.find((p) => p.ticket_number === activeInspectTicket) ?? null;
          const inspection = item
            ? richTicketInspection(
                {
                  ticket_number: item.ticket_number,
                  workflow_type: item.workflow_type,
                  status: item.status,
                  current_stage: item.current_stage,
                  reason: item.reason ?? null,
                  from_date: item.from_date ?? item.fromDate ?? null,
                  to_date: item.to_date ?? item.toDate ?? null,
                  student: item.student ?? null,
                  sla_deadline: item.sla_deadline ?? null,
                },
                () => {
                  setActiveInspectTicket(null);
                  setActiveDetailTicket(item.ticket_number);
                },
                item.stage_history.map((h) => ({
                  actorName: h.actorName,
                  action: h.action,
                  toStage: h.toStage,
                  timestamp: h.timestamp,
                })),
              )
            : null;
          return (
            <EntityInspector
              inspection={inspection}
              onClose={() => setActiveInspectTicket(null)}
            />
          );
        })()
      )}

      {activeDetailTicket && (
        <PermissionDetailPanel
          ticket={activeDetailTicket}
          onClose={() => setActiveDetailTicket(null)}
          onActionComplete={() => {
            fetchPermissions();
          }}
        />
      )}
    </div>
  );
}

export default PermissionList;
</file>

<file path="src/components/approver/PermissionRow.tsx">
"use client";

import React from "react";
import { Check, Eye, Clock, Shield, User, Building, FileText } from "lucide-react";
import { formatDateTime } from "@/lib/utils";
import { SlaBadge } from "./SlaBadge";
import { FlagBadge } from "@/components/shared/FlagBadge";
import type { PermissionStatus, WorkflowType } from "@/lib/types";
import type { FlagLevel } from "@/lib/permission-model";

export interface PermissionItem {
  id: string;
  ticket_number: string;
  workflow_type: WorkflowType;
  student_user_id: string;
  hostel_scope?: "boys" | "girls" | null;
  current_stage: string;
  status: PermissionStatus;
  /** Request reason (e.g. home_out, day_pass, daily_outing, day_scholar_out). */
  reason?: string | null;
  /** True when the pass was generated directly, bypassing the staged chain. */
  direct_generated?: boolean | null;
  /** Pending hostel room-assignment fields (day_scholar home_out flow). */
  pending_hostel_block?: string | null;
  pending_room_number?: string | null;
  pending_warden_id?: string | null;
  /** Current hostel level the ticket is routed to (forward target / stage). */
  routed_to_role?: string | null;
  /** Set when this ticket was forwarded from a lower level. */
  forwarded_from_role?: string | null;
  /** Forwarder's comment explaining the handoff. */
  forward_comment?: string | null;
  stage_history: Array<{
    actorId: string;
    actorName: string;
    actorRole: string;
    action: string;
    fromStage?: string;
    toStage?: string;
    comment?: string | null;
    timestamp: string;
  }>;
  document_required: boolean;
  document_url?: string | null;
  biometric_hostel_at?: string | null;
  biometric_gate_at?: string | null;
  digital_signature?: string | null;
  created_at: string;
  updated_at: string;
  sla_deadline?: string | null;
  from_date?: string | null;
  to_date?: string | null;
  fromDate?: string | null;
  toDate?: string | null;
  student?: {
    id: string;
    name: string;
    email: string;
    phone?: string;
    role: string;
    student_details?: {
      roll?: string;
      year?: number;
      section?: string;
      hostel_block?: string;
      room_number?: string;
      gender?: string;
      /** Live entry-type selection (student_details.current_entry_type). */
      current_entry_type?: "hosteller" | "day_scholar" | null;
      currentEntryType?: "hosteller" | "day_scholar" | null;
    };
  } | null;
  document_signatures?: Array<{
    id: string;
    signed_by: string;
    signed_at: string;
    signature_hash?: string;
  }>;
}

interface PermissionRowProps {
  request: PermissionItem;
  isSelected: boolean;
  onToggleSelect: (ticket: string) => void;
  onViewDetails: (ticket: string) => void;
  onQuickApprove?: (ticket: string) => void;
  onQuickReject?: (ticket: string) => void;
  loadingAction?: boolean;
}

const STAGE_LABELS: Record<string, string> = {
  caretaker: "Caretaker",
  deputy_warden: "Deputy Warden",
  hostel_manager: "Hostel Manager",
  warden_or_principal: "Warden / Principal",
  lab_incharge: "Lab In-charge",
  hod: "HOD",
  oie: "Officer in Exam (OIE)",
  vice_principal: "Vice Principal",
  principal: "Principal",
};

export function PermissionRow({
  request,
  isSelected,
  onToggleSelect,
  onViewDetails,
  onQuickApprove,
  onQuickReject,
  loadingAction = false,
}: PermissionRowProps) {
  const student = request.student;
  const details = student?.student_details;
  const isPending = request.status === "PENDING";

  return (
    <div
      className={`group relative flex flex-col md:flex-row items-start md:items-center justify-between gap-4 p-4 rounded-xl border transition-all duration-150 ${
        isSelected
          ? "bg-action-primary/5 border-action-primary shadow-sm"
          : "bg-bg-surface border-border hover:bordertext-muted hover:shadow-sm"
      }`}
    >
      <div className="flex items-start md:items-center gap-3 w-full md:w-auto">
        <button
          type="button"
          onClick={() => onToggleSelect(request.ticket_number)}
          className={`w-5 h-5 rounded-md border flex items-center justify-center transition-colors shrink-0 mt-0.5 md:mt-0 ${
            isSelected
              ? "bg-action-primary border-action-primary text-white"
              : "border-border bg-bg-elevated hover:bordertext-muted"
          }`}
          aria-label={`Select ${request.ticket_number}`}
        >
          {isSelected && <Check className="w-3.5 h-3.5 stroke-[3]" />}
        </button>

        <div className="space-y-1 flex-1">
          <div className="flex flex-wrap items-center gap-2">
            <span className="surface-card font-mono text-xs font-bold px-2 py-0.5 bg-bg-elevated text-action-primary">
              {request.ticket_number}
            </span>
            <span className="font-semibold text-sm text-text-primary">
              {student?.name || "Unknown Student"}
            </span>
            {details?.roll && (
              <span className="text-xs text-text-muted font-mono">
                ({details.roll})
              </span>
            )}
            {/* Conduct flag indicator */}
            {(student as unknown as { conductFlag?: FlagLevel })?.conductFlag && (
              <FlagBadge
                flag={(student as unknown as { conductFlag: FlagLevel }).conductFlag!}
              />
            )}
            <span
              className={`px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wider ${
                request.status === "PENDING"
                  ? "bg-amber-500/10 text-action-warning border border-amber-500/20"
                  : request.status === "APPROVED"
                  ? "bg-emerald-500/10 text-action-success border border-emerald-500/20"
                  : request.status === "REJECTED"
                  ? "bg-rose-500/10 text-action-danger border border-rose-500/20"
                  : "bg-blue-500/10 text-action-primary border border-blue-500/20"
              }`}
            >
              {request.status}
            </span>
          </div>

          <div className="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-text-secondary">
            {details?.year && details?.section && (
              <span className="flex items-center gap-1">
                <User className="size-3.5 text-text-muted" />
                Year {details.year} - Sec {details.section}
              </span>
            )}
            {details?.hostel_block && (
              <span className="flex items-center gap-1">
                <Building className="size-3.5 text-text-muted" />
                Block {details.hostel_block} ({details.room_number || "—"})
              </span>
            )}
            <span className="flex items-center gap-1">
              <Shield className="size-3.5 text-text-muted" />
              Stage: {STAGE_LABELS[request.current_stage] || request.current_stage}
            </span>
            {request.document_required && (
              <span className="flex items-center gap-1 text-action-warning font-medium">
                <FileText className="size-3.5" />
                Doc Req
              </span>
            )}
            <span className="flex items-center gap-1 text-text-muted">
              <Clock className="size-3.5" />
              {formatDateTime(request.created_at)}
            </span>
            <SlaBadge slaDeadline={request.sla_deadline} status={request.status} />
          </div>
        </div>
      </div>

      <div className="flex items-center gap-2 self-end md:self-center shrink-0">
        {isPending && onQuickApprove && (
          <button
            type="button"
            onClick={() => onQuickApprove(request.ticket_number)}
            disabled={loadingAction}
            className="surface-card px-3 py-1.5 text-xs font-semibold bg-action-success hover:bg-emerald-700 text-white transition-colors disabled:opacity-50"
          >
            Approve
          </button>
        )}
        {isPending && onQuickReject && (
          <button
            type="button"
            onClick={() => onQuickReject(request.ticket_number)}
            disabled={loadingAction}
            className="surface-card px-3 py-1.5 text-xs font-semibold bg-action-danger hover:bg-rose-700 text-white transition-colors disabled:opacity-50"
          >
            Reject
          </button>
        )}
        <button
          type="button"
          onClick={() => onViewDetails(request.ticket_number)}
          className="surface-card p-1.5 bg-bg-elevated hover:bg-bg-surface text-text-secondary hover:text-text-primary transition-colors"
          title="View full details"
          aria-label="View full details"
        >
          <Eye className="w-4 h-4" />
        </button>
      </div>
    </div>
  );
}
