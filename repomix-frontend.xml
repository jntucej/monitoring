  total?: number;
}

function slaBreached(row: PermissionRequestRow): boolean {
  if (!row.sla_deadline) return false;
  const ts = new Date(row.sla_deadline).getTime();
  return !Number.isNaN(ts) && ts < Date.now();
}

function VpPendingApprovalsInner() {
  const user = useAuthStore((s) => s.user);
  const { inspection, inspect, closeInspection } = useEntityInspector();
  const [pivot, setPivot] = useState<CommandPivotTarget | null>(null);

  const inspectRow = (r: PermissionRequestRow) => {
    inspect(
      escalationInspection({
        id: r.id,
        ticket_number: r.ticket_number,
        workflow_type: r.workflow_type,
        current_stage: r.current_stage,
        status: r.status,
        sla_deadline: r.sla_deadline ?? null,
        created_at: null,
        student: r.student
          ? { name: r.student.name, student_details: r.student.student_details ? { roll: r.student.student_details.roll } : null }
          : null,
      }),
    );
    setPivot({
      kind: "ticket",
      id: r.ticket_number,
      title: r.student?.name || r.ticket_number,
      subtitle: `${r.workflow_type.replace(/_/g, " ")} · ${r.current_stage} · ${r.status}${slaBreached(r) ? " · SLA BREACHED" : ""}`,
      fullRoute: `/permissions/${encodeURIComponent(r.ticket_number)}`,
      relatedLinks: [
        { label: "VP Approvals", href: "/vice-principal/pending-approvals" },
        { label: "Escalated", href: "/vice-principal/approvals/escalated" },
        { label: "Decision History", href: "/vice-principal/decision-history" },
        { label: "Academics", href: "/vice-principal/academics" },
        { label: "Hostel Security", href: "/vice-principal/hostel-security-summaries" },
        { label: "Delegated", href: "/vice-principal/delegated-responsibilities" },
      ],
    });
  };


  const {
    data: vpQueue,
    loading: queueLoading,
    error: queueError,
    refresh: refreshQueue,
  } = useApiResource<PermissionsResponse>(
    "/api/permissions?status=PENDING&stage=vice_principal",
    { ttlMs: 30_000 }
  );

  const [actingTicket, setActingTicket] = useState<string | null>(null);
  const [actionError, setActionError] = useState<string | null>(null);
  const [actionOk, setActionOk] = useState<string | null>(null);

  const rows = vpQueue?.data ?? [];
  const delegated = rows.filter((r) =>
    ["exam", "memo", "staff_leave", "attendance"].includes(r.workflow_type)
  );

  const actOnTicket = useCallback(
    async (row: PermissionRequestRow, action: "APPROVE" | "REJECT" | "ESCALATE") => {
      setActionOk(null);
      setActionError(null);
      setActingTicket(row.ticket_number);
      try {
        const res = await fetch(
          `/api/permissions/${encodeURIComponent(row.ticket_number)}`,
          {
            method: "PATCH",
            headers: { "Content-Type": "application/json", ...getAuthHeaders() },
            body: JSON.stringify({
              action,
              comment:
                action === "ESCALATE"
                  ? "Escalated by Vice Principal for principal review."
                  : action === "APPROVE"
                    ? "Approved at Vice Principal stage."
                    : "Rejected at Vice Principal stage.",
            }),
          }
        );
        const body = await res.json().catch(() => null);
        if (!res.ok) {
          const msg =
            (body as { error?: { message?: string } } | null)?.error?.message ||
            `Request failed (${res.status})`;
          throw new Error(msg);
        }
        clearCache();
        await refreshQueue();
        setActionOk(`${row.ticket_number} ${action.toLowerCase()}d.`);
      } catch (e) {
        const msg = e instanceof Error ? e.message : "Action failed";
        // 403 means this item is outside the VP's delegated action scope — view-only.
        setActionError(
          msg.includes("403") || msg.toLowerCase().includes("not authorized")
            ? `${row.ticket_number}: outside delegated scope — view-only.`
            : `${row.ticket_number}: ${msg}`
        );
      } finally {
        setActingTicket(null);
      }
    },
    [refreshQueue]
  );

  const refreshAll = useCallback(async () => {
    clearCache();
    await refreshQueue();
  }, [refreshQueue]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const grouped = useMemo(() => {
    return [...rows].sort((a, b) => Number(slaBreached(b)) - Number(slaBreached(a)));
  }, [rows]);

  return (
    <div className="mx-auto max-w-7xl space-y-5 px-4 py-6 md:px-6 min-w-0">
      <ContextSituationBar
        roleLabel="Vice Principal"
        purpose="Review and process pending institutional approval requests and gate leave workflows"
        why="Processing pending requests in order of SLA urgency prevents student leave delays and ensures prompt campus gate clearance."
        contextLabel="Pending Approvals Roster"
        statusSummary={rows.length > 0 ? `${rows.length} requests awaiting your review, including ${rows.filter(slaBreached).length} approaching SLA deadlines.` : "No pending approvals currently awaiting your review."}
        severity={rows.some(slaBreached) ? "warn" : "ok"}
        primaryAction={{ label: "Escalated Requests", href: "/vice-principal/escalated-requests" }}
        secondaryAction={{ label: "Decision History", href: "/vice-principal/decision-history" }}
      />
      <ApproverDecisionQueue
        roleLabel="Vice Principal"
        forwardLabel="Forward to Principal"
        relatedHref="/vice-principal/escalated-requests"
        relatedLabel="Escalated Requests"
      />
      <WidgetBoundary title="Pending Approvals">
        <div className="surface-card bg-bg-base p-4 min-w-0">
          <div className="flex flex-wrap items-center gap-2 text-text-muted mb-3 min-w-0">
            <Inbox className="w-4 h-4 shrink-0" />
            <span className="text-xs font-semibold uppercase tracking-wide">
              VP-Stage Queue · {rows.length} pending
            </span>
          </div>

          {actionOk && (
            <div className="surface-card mb-3 flex items-center gap-2 bg-emerald-500/10 p-3 text-xs text-emerald-700">
              <CheckCircle2 className="w-4 h-4 shrink-0" /> {actionOk}
            </div>
          )}
          {actionError && (
            <div className="surface-card mb-3 bg-amber-500/10 p-3 text-xs text-action-warning">
              {actionError}
            </div>
          )}
          {queueError && (
            <div className="surface-card mb-3 bg-amber-500/10 p-3 text-xs text-action-warning">
              Queue load failed: {queueError}
            </div>
          )}

          {queueLoading && !vpQueue ? (
            <div className="space-y-2 min-w-0">
              {[0, 1, 2].map((i) => (
                <div key={i} className="h-14 rounded-lg bg-bg-elevated/60 animate-pulse" />
              ))}
            </div>
          ) : grouped.length === 0 ? (
            <div className="p-6 text-center">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No pending items at the Vice Principal stage.</p>
              <p className="mt-2 text-xs text-text-muted">
                <ShieldCheck className="inline w-3.5 h-3.5 mr-1" />
                When a request lands at the VP stage, approve, reject, or escalate it here.
              </p>
            </div>
          ) : (
            <ul className="space-y-3 min-w-0">
              {grouped.slice(0, 12).map((r) => {
                const inScope = delegated.some((d) => d.id === r.id);
                const busy = actingTicket === r.ticket_number;
                return (
                  <li
                    key={r.id}
                    className="surface-card bg-bg-surface/40 p-3 min-w-0 cursor-pointer hover:bg-bg-elevated/30 transition-colors"
                    onClick={() => inspectRow(r)}
                  >
                    <div className="flex flex-wrap items-center gap-2" onClick={(e) => e.stopPropagation()}>
                      <span className="font-mono text-xs text-action-info">{r.ticket_number}</span>
                      <span className="text-sm text-text-secondary truncate min-w-0 flex-1">
                        {r.student?.name || "—"}
                        {r.student?.student_details?.roll
                          ? ` · ${r.student.student_details.roll}`
                          : ""}
                      </span>
                      <span className="text-xs text-text-muted capitalize whitespace-nowrap">
                        {r.workflow_type.replace(/_/g, " ")}
                      </span>
                      {slaBreached(r) && (
                        <span className="surface-card text-xs font-semibold text-action-danger bg-rose-500/10 px-2 py-0.5 whitespace-nowrap">
                          SLA breached
                        </span>
                      )}
                    </div>
                    <div className="mt-3 flex flex-wrap items-center gap-2">
                      <button
                        type="button"
                        onClick={(e) => { e.stopPropagation(); void actOnTicket(r, "APPROVE"); }}
                        disabled={busy || !inScope}
                        title={inScope ? "Approve" : "View-only: outside delegated scope"}
                        className="surface-card inline-flex items-center gap-1.5 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold text-action-success hover:bg-emerald-500/20 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
                      >
                        <CheckCircle2 className="w-3.5 h-3.5" /> Approve
                      </button>
                      <button
                        type="button"
                        onClick={(e) => { e.stopPropagation(); void actOnTicket(r, "REJECT"); }}
                        disabled={busy || !inScope}
                        title={inScope ? "Reject" : "View-only: outside delegated scope"}
                        className="surface-card inline-flex items-center gap-1.5 bg-rose-500/10 px-3 py-1.5 text-xs font-semibold text-action-danger hover:bg-rose-500/20 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
                      >
                        <XCircle className="w-3.5 h-3.5" /> Reject
                      </button>
                      <button
                        type="button"
                        onClick={(e) => { e.stopPropagation(); void actOnTicket(r, "ESCALATE"); }}
                        disabled={busy}
                        title="Escalate to the next stage (principal)"
                        className="surface-card inline-flex items-center gap-1.5 bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-action-warning hover:bg-amber-500/20 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
                      >
                        <ArrowUpRight className="w-3.5 h-3.5" /> Escalate
                      </button>
                      {!inScope && (
                        <span className="text-xs text-text-muted">
                          view-only · outside delegated scope
                        </span>
                      )}
                    </div>
                  </li>
                );
              })}
              {rows.length > 12 && (
                <li className="text-xs text-text-muted">
                  Showing 12 of {rows.length} items.
                </li>
              )}
            </ul>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={() => { closeInspection(); setPivot(null); }} />
      <CommandPivotDrawer target={pivot} onClose={() => setPivot(null)} />
    </div>
  );
}
export default function VpPendingApprovalsPage() {
  return (
    <AuthGuard allowedRoles={['vice_principal', 'exam_branch', 'oie', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <VpPendingApprovalsInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

