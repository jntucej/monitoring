  const isUser = m.role === "user";
  const cites = m.citations ?? [];
  const [thanked, setThanked] = useState(false);
  const isError = m.status === "error";
  const isStreaming = m.status === "streaming";
  // Feedback is only valid once the message has been persisted server-side
  // (dbId present) and is no longer streaming — clicking earlier would 404
  // on a dbId that doesn't exist yet.
  const canGiveFeedback = !isStreaming && !isError && !!m.dbId;

  const give = (f: -1 | 1) => {
    if (!canGiveFeedback || thanked) return;
    onFeedback(m.id, f);
    setThanked(true);
    playAudioFeedback(f === 1 ? "success" : "warning");
  };

  const retryThis = () => {
    onRetry(m.__retryOf ?? "");
  };

  return (
    <motion.div
      layout="position"
      data-msg-id={m.id}
      initial={{ opacity: 0, y: 6, scale: 0.98 }}
      animate={{ opacity: 1, y: 0, scale: 1 }}
      transition={{ type: "spring", stiffness: 380, damping: 30 }}
      className={isUser ? "flex justify-end" : "flex justify-start"}
    >
      <div className={`max-w-[88%] sm:max-w-[80%] rounded-2xl px-3.5 py-2.5 text-sm leading-relaxed
        ${isUser
          ? "bg-action-success text-white rounded-br-md"
          : isError
            ? "bg-rose-500/10 border border-rose-500/30 text-text-primary rounded-bl-md"
            : "bg-bg-elevated text-text-primary rounded-bl-md"}`}
      >
        {isError && (
          <div className="flex items-center gap-1.5 mb-1.5 text-action-danger text-xs font-medium">
            <AlertCircle className="h-3.5 w-3.5" />
            <span>Error</span>
          </div>
        )}

        <div className="break-words">
          {m.content ? (
            isUser ? (
              <div className="whitespace-pre-wrap">{m.content}</div>
            ) : (
              <MarkdownLite content={m.content} />
            )
          ) : isStreaming ? (
            <span className="inline-flex items-center gap-1 py-0.5">
              <span className="size-2 rounded-full bg-current animate-bounce" style={{ animationDelay: "0ms" }} />
              <span className="size-2 rounded-full bg-current animate-bounce" style={{ animationDelay: "150ms" }} />
              <span className="size-2 rounded-full bg-current animate-bounce" style={{ animationDelay: "300ms" }} />
            </span>
          ) : null}
        </div>

        {!isUser && cites.length > 0 && !isStreaming && (
          <div className="surface-card mt-2 pt-2">
            <CitationChip cites={cites} />
          </div>
        )}

        {!isUser && !isStreaming && m.content && (
          <div className="mt-2 flex items-center gap-2">
            {isError ? (
              <button
                onClick={retryThis}
                className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-success transition"
              >
                <RotateCcw className="size-3.5" /> {retryLabel}
              </button>
            ) : (
              <>
                {/* Regenerate — same question, new answer (not a new user
                    message). Distinct from retry, which re-sends the
                    question after an error. */}
                <button
                  onClick={() => onRetry(m.__retryOf ?? "")}
                  aria-label="Regenerate response"
                  title="Regenerate"
                  className="text-text-muted hover:text-action-success transition active:scale-95"
                >
                  <RefreshCw className="h-3.5 w-3.5" />
                </button>
                {/* Copy — the most-requested assistant feature: quoting an
                    answer into a ticket or email. */}
                <button
                  onClick={() => void navigator.clipboard.writeText(m.content)}
                  aria-label="Copy response"
                  title="Copy"
                  className="text-text-muted hover:text-action-success transition active:scale-95"
                >
                  <Copy className="h-3.5 w-3.5" />
                </button>
                {canGiveFeedback && (
                <>
                <button
                    aria-label="Good response"
                    aria-pressed={m.feedback === 1}
                    onClick={() => give(1)}
                    className="text-text-muted hover:text-action-success transition active:scale-95"
                  >
                    <ThumbsUp aria-hidden="true" className="h-3.5 w-3.5" />
                  </button>
                  <button
                    aria-label="Poor response"
                    aria-pressed={m.feedback === -1}
                    onClick={() => give(-1)}
                    className="text-text-muted hover:text-action-danger transition active:scale-95"
                  >
                    <ThumbsDown aria-hidden="true" className="h-3.5 w-3.5" />
                  </button>
                </>
                )}
                {thanked && (
                  <motion.span
                    initial={{ opacity: 0, y: 4 }}
                    animate={{ opacity: 1, y: 0 }}
                    className="text-xs text-text-muted"
                  >
                    {thanksLabel}
                  </motion.span>
                )}
              </>
            )}
            {!thanked && !isError && !canGiveFeedback && (
              <span className="text-xs text-text-muted opacity-60">Offline</span>
            )}
          </div>
        )}
      </div>
    </motion.div>
  );
});
</file>

<file path="src/components/bot/BotComposer.tsx">
"use client";
import { forwardRef, memo, useEffect, useRef, useState } from "react";
import { motion } from "framer-motion";
import { Send, Mic, MicOff, Square, Loader2 } from "lucide-react";
import type { BotStrings } from "@/lib/i18n/bot-strings";

interface Props {
  t: BotStrings;
  value: string;
  onChange: (v: string) => void;
  onSend: () => void;
  onStop: () => void;
  listening: boolean;
  streaming: boolean;
  micSupported: boolean;
  onToggleMic: () => void;
  /** Seconds remaining before the mic hard-caps its recording (null = no countdown showing). */
  micRemainingSeconds?: number | null;
}

export const BotComposer = memo(forwardRef<HTMLTextAreaElement, Props>(function BotComposer(
  { t, value, onChange, onSend, onStop, listening, streaming, micSupported, onToggleMic, micRemainingSeconds },
  ref,
) {
  const localRef = useRef<HTMLTextAreaElement>(null);
  // Elapsed-seconds counter for the "Generating…" indicator — so the
  // user knows the stream is still alive when the LLM is slow, and
  // can hit Stop (kept right beside the timer) without guessing.
  const [streamingSeconds, setStreamingSeconds] = useState(0);
  useEffect(() => {
    if (!streaming) { setStreamingSeconds(0); return; }
    const t0 = Date.now();
    const iv = setInterval(() => setStreamingSeconds(Math.floor((Date.now() - t0) / 1000)), 1000);
    return () => clearInterval(iv);
  }, [streaming]);
  useEffect(() => {
    const el = (ref as any)?.current ?? localRef.current;
    if (!el) return;
    el.style.height = "0px";
    el.style.height = Math.min(el.scrollHeight, 128) + "px";
  }, [value, ref]);

  const submit = (e: React.FormEvent) => {
    e.preventDefault();
    if (streaming) return;
    onSend();
  };

  const onKeyDown = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {
    if (e.key === "Enter" && !e.shiftKey && !(e.nativeEvent as any).isComposing) {
      e.preventDefault();
      submit(e as unknown as React.FormEvent);
    }
  };

  return (
    <form
      onSubmit={submit}
      className="surface-card p-2.5 flex items-end gap-1.5 bg-bg-surface/80 backdrop-blur-md"
      style={{ paddingBottom: "calc(0.625rem + env(safe-area-inset-bottom, 0px))" }}
    >
      <button
        type="button"
        onClick={onToggleMic}
        disabled={!micSupported || streaming}
        title={micSupported ? t.listening : t.micUnsupported}
        aria-label={listening ? "Stop listening" : "Start voice input"}
        aria-pressed={listening}
        className={`relative size-5 shrink-0 rounded-full flex items-center justify-center transition
          disabled:opacity-40 disabled:cursor-not-allowed active:scale-95
          ${listening
            ? "bg-action-danger text-white shadow-lg"
            : "bg-bg-elevated text-text-secondary hover:text-text-primary"}`}
      >
        {listening ? <MicOff className="h-5 w-5" /> : <Mic className="h-5 w-5" />}
        {listening && (
          <motion.span
            className="absolute inset-0 rounded-full border-2 border-action-danger"
            animate={{ scale: [1, 1.4], opacity: [0.7, 0] }}
            transition={{ duration: 1.1, repeat: Infinity }}
          />
        )}
        {listening && micRemainingSeconds != null && (
          <span
            className="surface-card absolute -top-1 -right-1 h-4 min-w-4 px-0.5 bg-action-danger text-white text-xs font-semibold flex items-center justify-center leading-none"
            aria-label={`${micRemainingSeconds} seconds remaining`}
          >
            {micRemainingSeconds}
          </span>
        )}
      </button>

      <textarea
        ref={(el) => {
          localRef.current = el;
          if (typeof ref === "function") ref(el);
          else if (ref) (ref as any).current = el;
        }}
        value={value}
        onChange={(e) => onChange(e.target.value)}
        onKeyDown={onKeyDown}
        rows={1}
        placeholder={t.placeholder}
        aria-label={t.placeholder}
        enterKeyHint="send"
        className="flex-1 resize-none bg-transparent outline-none text-sm px-2 py-2.5
                   max-h-5 text-text-primary placeholder:text-text-muted
                   [scrollbar-width:thin]"
      />

      {streaming ? (
        <div className="flex items-center gap-2 shrink-0">
          <div className="flex items-center gap-1.5 text-xs text-text-muted" role="status" aria-live="polite">
            <Loader2 className="size-3.5 animate-spin" aria-hidden />
            <span className="whitespace-nowrap">Generating… {streamingSeconds}s</span>
          </div>
          <button
            type="button"
            onClick={onStop}
            aria-label={t.stop}
            className="surface-card h-5 px-2.5 bg-bg-elevated text-xs text-text-secondary active:scale-95 transition inline-flex items-center gap-1"
          >
            <Square className="size-3.5 fill-current" /> {t.stop}
          </button>
        </div>
      ) : (
        <button
          type="submit"
          disabled={!value.trim()}
          aria-label={t.send}
          className="size-5 shrink-0 rounded-lg bg-action-success hover:bg-action-success
                     disabled:opacity-40 disabled:cursor-not-allowed
                     flex items-center justify-center transition active:scale-95"
        >
          <Send className="h-4 w-4 text-white" />
        </button>
      )}
    </form>
  );
}));
</file>

