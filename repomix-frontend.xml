<file path="src/components/shared/LiveActivityFeed.tsx">
"use client";

import { useEffect, useRef, useState } from "react";
import {
  Activity,
  WifiOff,
  Wifi,
  DoorOpen,
  Bell,
  ShieldAlert,
} from "lucide-react";
import { useGlass } from "@/context/GlassContext";
import { useAuthStore, useHasHydrated } from "@/stores/authStore";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import type { AlertPayload } from "@/lib/mockData";
import { formatTime } from "@/lib/utils";

/**
 * LiveActivityFeed — a compact "Live" feed of relevant events sourced from
 * the GateMonitorWS live channel (via useGlass). Renders gate status
 * changes and alerts filtered to the user's scope (the operator's own gate
 * when they have one, otherwise campus-wide). Falls back to a static
 * empty list when the socket is disconnected.
 */

interface FeedEvent {
  id: string;
  kind: "gate" | "alert";
  title: string;
  detail?: string;
  severity?: AlertPayload["severity"];
  timestamp: number;
}

const MAX_FEED = 12;

const SEVERITY_CLASS: Record<string, string> = {
  info: "bg-action-info/10 text-action-info",
  warning: "bg-action-warning/10 text-action-warning",
  critical: "bg-action-danger/10 text-action-danger",
};

export interface LiveActivityFeedProps {
  /** Optional embedded view (no wrapper card). Default: wrapped in a card. */
  compact?: boolean;
  /** Max events to keep in the feed. Default 12. */
  limit?: number;
}

export function LiveActivityFeed({ compact = false, limit = MAX_FEED }: LiveActivityFeedProps) {
  const hasHydrated = useHasHydrated();
  const user = useAuthStore((s) => s.user);
  const {
    wsConnected,
    wsReconnecting,
    wsTransportExhausted,
    cards,
    activeAlerts,
  } = useGlass();

  const [events, setEvents] = useState<FeedEvent[]>([]);
  const prevCardsRef = useRef<Map<string, string>>(new Map());

  // Ingest gate status changes into the feed (scoped to the user's gate).
  useEffect(() => {
    if (!hasHydrated) return;
    const prev = prevCardsRef.current;
    const additions: FeedEvent[] = [];
    for (const card of cards) {
      const prevStatus = prev.get(card.gateId);
      const isInScope =
        !user?.gateId || card.gateId === user.gateId;
      if (isInScope) {
        if (prevStatus && prevStatus !== card.status && card.status !== "idle") {
          additions.push({
            id: `gate-${card.gateId}-${card.lastUpdate}`,
            kind: "gate",
            title: `${card.name}`,
            detail: `Status: ${card.status.toUpperCase()}`,
            timestamp: card.lastUpdate,
          });
        }
      }
      prev.set(card.gateId, card.status);
    }
    if (additions.length > 0) {
      setEvents((old) => [...additions, ...old].slice(0, limit));
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [cards, hasHydrated, limit]);

  // Ingest live alerts into the feed.
  useEffect(() => {
    if (!hasHydrated) return;
    const additions = activeAlerts.map((a: AlertPayload) => ({
      id: `alert-${a.timestamp}-${a.gateId}`,
      kind: "alert" as const,
      title: a.message,
      detail: `${a.gateId} · ${a.severity}`,
      severity: a.severity,
      timestamp: a.timestamp,
    }));
    if (additions.length > 0) {
      setEvents((old) => {
        const seen = new Set(old.map((e) => e.id));
        const fresh = additions.filter((e) => !seen.has(e.id));
        return [...fresh, ...old].slice(0, limit);
      });
    }
     
  }, [activeAlerts, hasHydrated, limit]);

  const offline = !wsConnected && (wsTransportExhausted || !wsReconnecting);

  const feed = (
    <div className="min-w-0">
      {/* Status header */}
      <div className="flex items-center justify-between gap-2 mb-3">
        <div className="flex items-center gap-2 min-w-0">
          <Activity className="h-4 w-4 text-action-primary shrink-0" />
          <h3 className="text-sm font-semibold text-text-primary truncate">
            Live Activity
          </h3>
        </div>
        <span
          className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium shrink-0 ${
            offline
              ? "bg-action-danger/10 text-action-danger"
              : "bg-action-primary/10 text-action-primary"
          }`}
        >
          {offline ? (
            <WifiOff className="size-3.5" />
          ) : (
            <Wifi className="size-3.5" />
          )}
          {offline ? "Offline" : wsReconnecting ? "Reconnecting…" : "Live"}
        </span>
      </div>

      {offline ? (
        /* Static empty list when the socket is disconnected */
        <div className="surface-card bg-bg-elevated p-6 text-center">
          <DoorOpen className="mx-auto size-6 text-text-muted" />
          <p className="mt-2 text-xs text-text-muted">
            Live feed disconnected — showing last known events.
          </p>
        </div>
      ) : events.length === 0 ? (
        <div className="surface-card bg-bg-elevated p-6 text-center">
          <Bell className="mx-auto size-6 text-text-muted" />
          <p className="mt-2 text-xs text-text-muted">
            No live events yet. Gate status changes and alerts will appear here.
          </p>
        </div>
      ) : (
        <ul className="space-y-2 max-h-96 overflow-y-auto pr-1">
          {events.map((e) => (
            <li
              key={e.id}
              className={`flex items-start gap-3 rounded-lg border p-3 ${
                e.kind === "alert" && e.severity === "critical"
                  ? "border-action-danger/30 bg-action-danger/5"
                  : "border-border bg-bg-surface"
              }`}
            >
              <span
                className={`mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md ${
                  e.kind === "gate"
                    ? "bg-action-info/10 text-action-info"
                    : e.severity
                    ? SEVERITY_CLASS[e.severity] ?? SEVERITY_CLASS.info
                    : "bg-action-warning/10 text-action-warning"
                }`}
              >
                {e.kind === "gate" ? (
                  <DoorOpen className="h-3.5 w-3.5" />
                ) : e.severity === "critical" ? (
                  <ShieldAlert className="h-3.5 w-3.5" />
                ) : (
                  <Bell className="h-3.5 w-3.5" />
                )}
              </span>
              <div className="min-w-0 flex-1">
                <p className="text-xs font-medium text-text-primary truncate">
                  {e.title}
                </p>
                {e.detail ? (
                  <p className="text-xs text-text-muted truncate">{e.detail}</p>
                ) : null}
              </div>
              <span className="shrink-0 text-xs text-text-muted">
                {formatTime(new Date(e.timestamp).toISOString())}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
  );

  if (compact) {
    return <WidgetBoundary title="Live Activity">{feed}</WidgetBoundary>;
  }

  return (
    <WidgetBoundary title="Live Activity">
      <div className="surface-card bg-bg-surface/40 p-4 sm:p-5">
        {feed}
      </div>
    </WidgetBoundary>
  );
}

export default LiveActivityFeed;
</file>

<file path="src/components/shared/LiveClassCard.tsx">
// src/components/shared/LiveClassCard.tsx
// A compact "live classes right now" widget for the role dashboards.
// Polls /api/class-sessions/live (server clamps the scope to the caller's role)
// and shows the live/upcoming/missed counts + a short list of the in-progress
// sessions. No per-student data — sessions + faculty names only.

"use client";

import { useEffect, useMemo, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { usePolling } from "@/hooks/usePolling";
import { Loader2 } from "lucide-react";

interface LiveSession {
  sessionId: string;
  className: string;
  subjectCode: string | null;
  periodNo: number;
  facultyName: string | null;
  startAt: string;
  endAt: string;
  state: "LIVE" | "UPCOMING" | "MISSED" | "SUBSTITUTED" | "ENDED";
  confirmation: string | null;
}

interface LiveResponse {
  success: boolean;
  data?: {
    now: string;
    counts: { total: number; live: number; upcoming: number; missed: number; substituted: number };
    sessions: LiveSession[];
  };
  error?: { message?: string };
}

function fmt(t: string): string {
  return t?.slice(0, 5) ?? "—";
}

export function LiveClassCard({
  title,
  scope,
  intervalMs = 30_000,
}: {
  title?: string;
  scope?: "self" | "department" | "academic" | "campus";
  intervalMs?: number;
}) {
  const [data, setData] = useState<LiveResponse["data"] | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);

  const load = async () => {
    try {
      const url = `/api/class-sessions/live${scope ? `?scope=${scope}` : ""}`;
      const res = await fetch(url, { credentials: "include" });
      const json = (await res.json()) as LiveResponse;
      if (json.success && json.data) {
        setData(json.data);
        setError(null);
      } else {
        setError(json.error?.message ?? "Failed to load live classes");
      }
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load live classes");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    load();
  }, [scope]);
  usePolling(load, { intervalMs, enabled: true });

  const inProgress = useMemo(
    () =>
      (data?.sessions ?? [])
        .filter((s) => s.state === "LIVE" || s.state === "SUBSTITUTED")
        .slice(0, 6),
    [data]
  );

  return (
    <WidgetBoundary name="LiveClassCard" title={title ?? "Classes right now"}>
      <div className="space-y-3">
        <div className="grid grid-cols-3 gap-2 text-center">
          <div>
            <p className="text-2xl font-bold text-action-success tabular-nums">
              {data ? data.counts.live : <Loader2 className="w-5 h-5 animate-spin inline" />}
            </p>
            <p className="text-xs uppercase tracking-wide text-text-muted">Live</p>
          </div>
          <div>
            <p className="text-2xl font-bold text-action-info tabular-nums">
              {data ? data.counts.upcoming : "…"}
            </p>
            <p className="text-xs uppercase tracking-wide text-text-muted">Upcoming</p>
          </div>
          <div>
            <p className="text-2xl font-bold text-action-danger tabular-nums">
              {data ? data.counts.missed : "…"}
            </p>
            <p className="text-xs uppercase tracking-wide text-text-muted">Missed</p>
          </div>
        </div>

        {error && <p className="text-xs text-action-danger">{error}</p>}

        {inProgress.length > 0 ? (
          <ul className="space-y-1">
            {inProgress.map((s) => (
              <li key={s.sessionId} className="text-sm text-text-secondary flex justify-between gap-2">
                <span className="truncate">
                  {s.className} · {s.periodNo}
                  {s.subjectCode ? ` · ${s.subjectCode}` : ""}
                  {s.state === "SUBSTITUTED" ? " (sub)" : ""}
                </span>
                <span className="text-xs text-text-muted shrink-0">
                  {fmt(s.startAt)}–{fmt(s.endAt)}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          !error &&
          <p className="text-xs text-text-muted">No classes in progress right now.</p>
        )}
      </div>
    </WidgetBoundary>
  );
}
</file>

<file path="src/components/shared/LiveEventsPanel.tsx">
// src/components/shared/LiveEventsPanel.tsx
// ─────────────────────────────────────────────────────────────────────────────
// LiveEventsPanel — the "overview of each element" widget. Reads the shared
// useLiveEventStore (fed by LiveEventToaster) and renders the last N live
// campus events as a compact, status-coded list:
//
//   • a severity icon + color per row
//   • a "NEW" chip on events still inside the fresh TTL window
//   • a live counter ("N events since you opened this view")
//   • an empty state that names what the panel is waiting for
//
// Deliberately a *separate* element from the toaster: the toaster is the
// ambient "just happened" cue (transient, top of screen); the panel is the
// scannable history ("what has happened this session"). Together they are
// the "new notification which updates those things" the audit asked for —
// one for the instant, one for the roll-up.
// ─────────────────────────────────────────────────────────────────────────────
"use client";

import { motion } from "framer-motion";
import { Radio, AlertCircle, AlertTriangle, Info, Gauge } from "lucide-react";
import { useLiveEventStore, type LiveEvent } from "@/stores/liveEventStore";
import { useAuthStore } from "@/stores/authStore";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { cn } from "@/lib/utils";

const SEV_META: Record<
  NonNullable<LiveEvent["severity"]>,
  { icon: typeof Info; color: string; label: string }
> = {
  critical: { icon: AlertCircle, color: "text-action-danger", label: "critical" },
  high: { icon: AlertTriangle, color: "text-orange-400", label: "high" },
  medium: { icon: Info, color: "text-action-warning", label: "medium" },
  low: { icon: Info, color: "text-action-info", label: "low" },
  info: { icon: Info, color: "text-text-muted", label: "info" },
};

function timeAgo(iso: string): string {
  const s = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
  if (s < 5) return "just now";
  if (s < 60) return `${s}s ago`;
  const m = Math.floor(s / 60);
  if (m < 60) return `${m}m ago`;
  return `${Math.floor(m / 60)}h ago`;
}

export function LiveEventsPanel() {
  const { events, totalSeen, lastEventAt } = useLiveEventStore();
  const role = useAuthStore((s) => s.user?.role ?? null);

  return (
    <WidgetBoundary title="Live Events">
      <div className="surface-card bg-bg-surface/40 p-4 sm:p-5 min-w-0">
        {/* Header: live indicator + session counter */}
        <div className="flex items-center justify-between mb-4 gap-3">
          <div className="flex items-center gap-2 min-w-0">
            <span className="relative flex h-2 w-2 shrink-0">
              <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-action-success opacity-60" />
              <span className="relative inline-flex rounded-full h-2 w-2 bg-action-success" />
            </span>
            <h3 className="text-sm font-semibold text-text-primary truncate">
              Live Events
            </h3>
            <span className="text-xs font-mono uppercase tracking-wider text-text-muted shrink-0">
              live
            </span>
          </div>
          <span
            className={cn(
              "text-xs font-mono px-2 py-0.5 rounded-full border shrink-0",
              totalSeen > 0
                ? "border-emerald-500/30 bg-emerald-500/10 text-action-success"
                : "border-border bg-bg-base text-text-muted"
            )}
          >
            {totalSeen} this session
          </span>
        </div>

        {/* Event list */}
        {events.length === 0 ? (
          <div className="p-6 text-center text-xs text-text-muted flex flex-col items-center gap-2">
            <Radio className="w-6 h-6 opacity-30" />
            <p>No live events yet for your role.</p>
            <p className="text-xs">
              {role && ACTIVE_ROLE_HINT[role]
                ? ACTIVE_ROLE_HINT[role]
                : "New alerts and gate events will appear here the moment they fire."}
            </p>
          </div>
        ) : (
          <div className="space-y-1">
            {events.slice(0, 8).map((e) => {
              const meta = SEV_META[e.severity ?? "info"] ?? SEV_META.info;
              const Icon = meta.icon;
              return (
                <motion.div
                  key={e.id}
                  initial={e.fresh ? { opacity: 0, y: -4 } : false}
                  animate={{ opacity: 1, y: 0 }}
                  className={cn(
                    "flex items-start gap-2.5 p-2.5 rounded-xl border transition-colors",
                    e.fresh
                      ? "border-emerald-500/30 bg-emerald-500/5"
                      : "border-transparent hover:bg-[var(--bg-card)]/50"
                  )}
                >
                  <span
                    className={cn(
                      "p-1.5 rounded-lg bg-bg-base border border-border shrink-0",
                      meta.color
                    )}
                  >
                    <Icon className="w-3.5 h-3.5" />
                  </span>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center justify-between gap-2">
                      <p className="text-xs font-medium text-text-primary truncate">
                        {e.title}
                      </p>
                      {e.fresh && (
                        <span className="surface-card text-xs font-mono uppercase tracking-wider px-1.5 py-0.5 bg-emerald-500/15 text-action-success shrink-0">
                          new
                        </span>
                      )}
                    </div>
                    {e.detail && (
                      <p className="text-xs text-text-muted mt-0.5 line-clamp-2">
                        {e.detail}
                      </p>
                    )}
                    <div className="flex items-center gap-2 mt-1 text-xs font-mono text-text-muted">
                      <span className={meta.color}>{meta.label}</span>
                      <span>·</span>
                      <span>{timeAgo(e.at)}</span>
                    </div>
                  </div>
                </motion.div>
              );
            })}
            {events.length > 8 && (
              <p className="text-xs text-text-muted text-center pt-1">
                +{events.length - 8} older events this session
              </p>
            )}
          </div>
        )}

        {/* Footer: last-event heartbeat */}
        {lastEventAt && (
          <p className="surface-card text-xs font-mono text-text-muted mt-3 pt-3 flex items-center gap-1.5">
            <Gauge className="size-3.5" />
            last event {timeAgo(lastEventAt)}
          </p>
        )}
      </div>
    </WidgetBoundary>
  );
}

const ACTIVE_ROLE_HINT: Record<string, string> = {
  admin: "Gate alerts, escalations, and system incidents stream here in real time.",
  sysadmin: "System-health and gateway alerts will appear here the moment they fire.",
  operator: "Scan, gate-offline, and visitor events for your gate will stream here.",
  supervisor: "Escalation and critical-alert events will stream here in real time.",
  vice_principal: "Campus-wide critical alerts will stream here in real time.",
  principal: "Campus-wide critical alerts will stream here in real time.",
};

export default LiveEventsPanel;
