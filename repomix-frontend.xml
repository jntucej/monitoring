"use client";

import Link from "next/link";
import { ArrowRight } from "lucide-react";

export type ContextTone = "info" | "ok" | "warn" | "critical";

export interface ContextAction {
  label: string;
  href?: string;
  onClick?: () => void;
  loading?: boolean;
  disabled?: boolean;
  disabledReason?: string;
  badgeCount?: number;
  tone?: "primary" | "secondary" | "danger";
}

export type PageActionItem = ContextAction;

export interface ContextSituationBarProps {
  /** Who is viewing this page, e.g. "Deputy Warden · Hostel L2" */
  roleLabel?: string;
  /** Why this page exists for this role */
  purpose?: string;
  /** Short live context tag, e.g. "Day Scholar · CSE" or "Lunch Window · 12:30–14:00" */
  contextLabel: string;
  /** Plain-language summary of what is happening right now and what to do next */
  summary?: string;
  /** Alias for summary */
  statusSummary?: string;
  /** Optional secondary explanation ("Why am I seeing this?") */
  why?: string;
  /** Optional live status pill, e.g. "2 pending", "Closes in 25m" */
  statusPill?: string;
  /** Semantic tone variant */
  statusTone?: ContextTone;
  /** Alias for statusTone */
  severity?: ContextTone;
  /** Backwards-compatible alias for statusTone */
  tone?: "neutral" | "ok" | "warn" | "danger";
  /** Primary contextual action right on this screen */
  primaryAction?: ContextAction;
  /** Optional secondary contextual link/action */
  secondaryAction?: ContextAction;
  /** Optional list of secondary contextual actions */
  secondaryActions?: ContextAction[];
}

export type ContextSituationProps = ContextSituationBarProps;

const TONE_STYLES: Record<
  ContextTone,
  { label: string; pill: string }
> = {
  info: {
    label: "text-action-primary",
    pill: "bg-action-primary/10 text-action-primary",
  },
  ok: {
    label: "text-action-success",
    pill: "bg-action-success/10 text-action-success",
  },
  warn: {
    label: "text-action-warning",
    pill: "bg-action-warning/10 text-action-warning",
  },
  critical: {
    label: "text-action-danger",
    pill: "bg-action-danger/10 text-action-danger",
  },
};

function resolveTone(
  severity?: ContextTone,
  statusTone?: ContextTone,
  tone?: ContextSituationBarProps["tone"],
): ContextTone {
  if (severity) return severity;
  if (statusTone) return statusTone;
  if (tone === "ok") return "ok";
  if (tone === "warn") return "warn";
  if (tone === "danger") return "critical";
  return "info";
}

function ActionControl({
  action,
  variant,
}: {
  action: ContextAction;
  variant: "primary" | "secondary";
}) {
  const effectiveTone = action.tone ?? variant;
  const cls =
    effectiveTone === "primary"
      ? "inline-flex items-center gap-1.5 rounded-lg bg-action-primary px-3.5 py-2 text-xs font-semibold text-white hover:opacity-90 transition-opacity shrink-0"
      : effectiveTone === "danger"
        ? "inline-flex items-center gap-1.5 rounded-lg bg-action-danger px-3.5 py-2 text-xs font-semibold text-white hover:opacity-90 transition-opacity shrink-0"
        : "inline-flex items-center gap-1.5 rounded-lg bg-bg-elevated px-3 py-2 text-xs font-medium text-text-secondary hover:text-text-primary transition-colors shrink-0";

  const badge =
    typeof action.badgeCount === "number" && action.badgeCount > 0 ? (
      <span className="px-1.5 py-0.5 text-[10px] font-bold bg-black/20 rounded-full tabular-nums">
        {action.badgeCount}
      </span>
    ) : null;

  if (action.href && !action.disabled) {
    return (
      <Link href={action.href} className={cls}>
        <span>{action.label}</span>
        {badge}
        <ArrowRight className="h-3.5 w-3.5" aria-hidden />
      </Link>
    );
  }

  return (
    <button
      type="button"
      onClick={action.onClick}
      disabled={action.disabled || action.loading}
      title={action.disabled ? action.disabledReason : undefined}
      className={`${cls} disabled:opacity-50 disabled:cursor-not-allowed`}
    >
      <span>{action.loading ? "Working…" : action.label}</span>
      {badge}
      <ArrowRight className="h-3.5 w-3.5" aria-hidden />
    </button>
  );
}

/**
 * ContextSituationBar — Role + Purpose + Context + Action contract:
 * 1. Who is this for & why is it here? (roleLabel + purpose)
 * 2. What is happening right now? (contextLabel + statusPill + summary/statusSummary)
 * 3. What can I do right here? (primaryAction / secondaryAction / secondaryActions)
 */
export function ContextSituationBar({
  roleLabel,
  purpose,
  contextLabel,
  summary,
  statusSummary,
  why,
  statusPill,
  statusTone,
  severity,
  tone,
  primaryAction,
  secondaryAction,
  secondaryActions,
}: ContextSituationBarProps) {
  const resolved = resolveTone(severity, statusTone, tone);
  const styles = TONE_STYLES[resolved];
  const mainSummary = statusSummary ?? summary ?? "";
  const allSecondary = [
    ...(secondaryAction ? [secondaryAction] : []),
    ...(secondaryActions ?? []),
  ];

  return (
    <section
      aria-label="Current context"
      className="surface-card bg-bg-surface p-4 flex flex-wrap items-center justify-between gap-3"
    >
      <div className="space-y-1 min-w-0 flex-1">
        <div className="flex flex-wrap items-center gap-2">
          {roleLabel && (
            <span className="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-bg-elevated text-text-secondary">
              {roleLabel}
            </span>
          )}
          <p className={`text-[11px] font-semibold uppercase tracking-wider ${styles.label}`}>
            {contextLabel}
          </p>
          {statusPill && (
            <span className={`px-2 py-0.5 rounded-full text-[10px] font-semibold ${styles.pill}`}>
              {statusPill}
            </span>
          )}
        </div>
        {purpose && <p className="text-xs text-text-secondary">{purpose}</p>}
        {mainSummary && <p className="text-sm font-medium text-text-primary">{mainSummary}</p>}
        {why && <p className="text-xs text-text-muted">{why}</p>}
      </div>
      {(primaryAction || allSecondary.length > 0) && (
        <div className="flex flex-wrap items-center gap-2 shrink-0">
          {allSecondary.map((act, idx) => (
            <ActionControl key={`${act.label}-${idx}`} action={act} variant="secondary" />
          ))}
          {primaryAction && <ActionControl action={primaryAction} variant="primary" />}
        </div>
      )}
    </section>
  );
}

export default ContextSituationBar;
</file>

<file path="src/components/shared/ContextualActionRow.tsx">
"use client";

import { useState, type ReactNode } from "react";
import { WorkflowChainTracker } from "@/components/shared/WorkflowChainTracker";
import { ActorTimelineFeed } from "@/components/shared/ActorTimelineFeed";
import { ActionConsequencePreview } from "@/components/shared/ActionConsequencePreview";
import { PermissionScopeHint } from "@/components/shared/PermissionScopeHint";

export interface ActorEventContext {
  actorName: string;
  actorRole: string;
  actionTaken: string;
  reason?: string | null;
  atLabel: string;
}

export interface RowActionSpec<TAction extends string> {
  action: TAction;
  label: string;
  tone?: "primary" | "secondary" | "danger";
  consequence: string;
  requiresReason?: boolean;
  disabledReason?: string;
}

export interface ContextualRowData<TAction extends string> {
  id: string;
  primaryTitle: string;
  secondaryMeta: string;
  liveStateBadge: ReactNode;
  situationSummary: string;
  latestActorEvent?: ActorEventContext;
  historyCount?: number;
  workflowStage?: string | null;
  workflowStatus?: string | null;
  workflowEvents?: Array<{
    actorName?: string | null;
    actorRole?: string | null;
    actionTaken?: string | null;
    reason?: string | null;
    atLabel?: string | null;
  }>;
  actions: RowActionSpec<TAction>[];
}

export interface ContextualActionRowProps<TAction extends string> {
  row: ContextualRowData<TAction>;
  busyAction: TAction | null;
  onAction: (action: TAction, reason?: string) => Promise<void> | void;
}

const TONE_CLS: Record<NonNullable<RowActionSpec<string>["tone"]>, string> = {
  primary: "bg-action-primary text-white hover:opacity-90",
  secondary: "bg-bg-elevated text-text-secondary hover:text-text-primary",
  danger: "bg-action-danger text-white hover:opacity-90",
};

/**
 * ContextualActionRow — high-context, action-transparent row/card exposing:
 * 1. Entity & live state
 * 2. Situation summary (why it needs attention)
 * 3. Latest actor rationale (who acted last and why)
 * 4. Reason-gated actions with consequence preview
 */
export function ContextualActionRow<TAction extends string>({
  row,
  busyAction,
  onAction,
}: ContextualActionRowProps<TAction>) {
  const [pendingSpec, setPendingSpec] = useState<RowActionSpec<TAction> | null>(null);
  const [reasonText, setReasonText] = useState("");

  const handleClick = (spec: RowActionSpec<TAction>) => {
    if (spec.disabledReason) return;
    if (spec.requiresReason) {
      setPendingSpec(spec);
      setReasonText("");
      return;
    }
    void onAction(spec.action);
  };

  const submitReason = () => {
    if (!pendingSpec || !reasonText.trim()) return;
    const act = pendingSpec.action;
    const txt = reasonText.trim();
    setPendingSpec(null);
    setReasonText("");
    void onAction(act, txt);
  };

  return (
    <article className="surface-card bg-bg-surface p-4 flex flex-col gap-3">
      {/* Top strip: identity + live state/SLA pill */}
      <div className="flex flex-wrap items-start justify-between gap-2">
        <div className="min-w-0">
          <h3 className="text-sm font-semibold text-text-primary truncate">
            {row.primaryTitle}
          </h3>
          <p className="text-xs text-text-muted truncate">{row.secondaryMeta}</p>
        </div>
        <div className="shrink-0">
          {typeof row.liveStateBadge === "string" ? (
            <span className="px-2.5 py-0.5 rounded-full bg-bg-elevated text-xs font-medium text-text-secondary">
              {row.liveStateBadge}
            </span>
          ) : (
            row.liveStateBadge
          )}
        </div>
      </div>

      {/* Situation line */}
      <p className="text-xs leading-relaxed text-text-secondary">
        {row.situationSummary}
      </p>

      {/* Compact workflow stage pipeline */}
      {(row.workflowStage || row.workflowStatus) && (
        <WorkflowChainTracker
          currentStage={row.workflowStage}
          ticketStatus={row.workflowStatus}
          events={row.workflowEvents}
          compact
        />
      )}

      {/* Actor rationale block + expandable full timeline */}
      {row.latestActorEvent && (
        <div className="bg-bg-elevated px-3 py-2 text-xs space-y-1.5">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <span className="font-semibold text-text-primary">
              {row.latestActorEvent.actorName} ({row.latestActorEvent.actorRole}) ·{" "}
              {row.latestActorEvent.actionTaken}
            </span>
            <span className="text-[11px] text-text-muted">
              {row.latestActorEvent.atLabel}
              {row.historyCount && row.historyCount > 1
                ? ` · ${row.historyCount} events`
                : ""}
            </span>
          </div>
          {row.latestActorEvent.reason && (
            <p className="text-text-secondary">
              &ldquo;{row.latestActorEvent.reason}&rdquo;
            </p>
          )}
          {row.workflowEvents && row.workflowEvents.length > 1 && (
            <details className="pt-1">
              <summary className="cursor-pointer text-[11px] font-medium text-action-primary">
                View full actor trail ({row.workflowEvents.length})
              </summary>
              <div className="mt-2">
                <ActorTimelineFeed events={row.workflowEvents} />
              </div>
            </details>
          )}
        </div>
      )}

      {/* Action bar with consequence preview or inline reason prompt */}
      {pendingSpec ? (
        <div className="space-y-2 pt-1">
          <ActionConsequencePreview
            nextState={pendingSpec.consequence}
            sideEffects={["Notifies student & guardian", "Writes audit log entry"]}
            requiresReason={pendingSpec.requiresReason}
            tone={pendingSpec.tone}
          />
          <input
            type="text"
            value={reasonText}
            onChange={(e) => setReasonText(e.target.value)}
            placeholder={`Reason for ${pendingSpec.label.toLowerCase()} (required)…`}
            aria-label={`Reason for ${pendingSpec.label}`}
            className="w-full min-h-11 bg-bg-elevated px-3 py-2 text-xs text-text-primary focus:outline-none"
          />
          <div className="flex items-center gap-2">
            <button
              type="button"
              disabled={!reasonText.trim() || Boolean(busyAction)}
              onClick={submitReason}
              className="min-h-11 bg-action-primary px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50"
            >
              Confirm {pendingSpec.label}
            </button>
            <button
              type="button"
              onClick={() => {
                setPendingSpec(null);
                setReasonText("");
              }}
              className="min-h-11 bg-bg-elevated px-3 py-1.5 text-xs font-medium text-text-secondary"
            >
              Cancel
            </button>
          </div>
        </div>
      ) : (
        <div className="space-y-1.5 pt-1">
          <div className="flex flex-wrap items-center gap-2">
            {row.actions.map((spec) => {
              const isBusy = busyAction === spec.action;
              const toneCls = TONE_CLS[spec.tone ?? "secondary"];
              return (
                <button
                  key={spec.action}
                  type="button"
                  title={spec.disabledReason ?? spec.consequence}
                  disabled={Boolean(busyAction) || Boolean(spec.disabledReason)}
                  onClick={() => handleClick(spec)}
                  className={`min-h-11 px-3 py-1.5 text-xs font-medium transition-opacity disabled:opacity-50 ${toneCls}`}
                >
                  {isBusy ? "Applying…" : spec.label}
                </button>
              );
            })}
          </div>
          {row.actions.some((a) => a.disabledReason) && (
            <PermissionScopeHint
              rule={row.actions.find((a) => a.disabledReason)?.disabledReason ?? ""}
              tone="locked"
            />
          )}
          {row.actions[0]?.consequence && (
            <ActionConsequencePreview
              nextState={row.actions.map((a) => `${a.label} → ${a.consequence}`).join(" · ")}
              sideEffects={["Updates workflow stage", "Writes audit entry"]}
              requiresReason={row.actions.some((a) => a.requiresReason)}
            />
          )}
        </div>
      )}
    </article>
  );
}

export default ContextualActionRow;
</file>

<file path="src/components/shared/CountUp.tsx">
"use client";

import { useEffect, useState, useRef } from "react";
import { motion, useSpring, useTransform } from "framer-motion";
import { useGlass } from "@/context/GlassContext";

export interface CountUpProps {
  value: number;
  duration?: number;
  delay?: number;
  className?: string;
  prefix?: string;
  suffix?: string;
  decimals?: number;
  startValue?: number;
  isLoading?: boolean;
}

export function SineWaveLoader({ className = "" }: { className?: string }) {
  const { prefersReducedMotion } = useGlass();

  return (
    <motion.span
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      exit={{ opacity: 0, scale: 0.95 }}
      transition={{ duration: 0.3 }}
      className={`inline-flex items-center gap-2.5 px-3 py-1 rounded-xl bg-bg-surface/90 border border-cyan-500/40 text-cyan-700 font-mono text-xs shadow-[0_0_18px_rgba(6,182,212,0.3)] backdrop-blur-md select-none ${className}`}
    >
      {/* Dynamic Animated Sine Wave SVG */}
      <svg className="w-10 h-3.5 shrink-0 overflow-visible" viewBox="0 0 100 24" fill="none">
        <defs>
          <linearGradient id="sine-wave-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stopColor="var(--action-info)" stopOpacity="0.3" />
            <stop offset="50%" stopColor="var(--action-success)" stopOpacity="1" />
            <stop offset="100%" stopColor="var(--alert-critical)" stopOpacity="0.8" />
          </linearGradient>
        </defs>
        <path
          d="M 0 12 Q 12.5 2, 25 12 T 50 12 T 75 12 T 100 12"
          stroke="url(#sine-wave-grad)"
          strokeWidth="3"
          strokeLinecap="round"
          fill="none"
        >
          {!prefersReducedMotion && (
            <animate
              attributeName="d"
              dur="1.2s"
              repeatCount="indefinite"
              values="M 0 12 Q 12.5 2, 25 12 T 50 12 T 75 12 T 100 12; M 0 12 Q 12.5 22, 25 12 T 50 12 T 75 12 T 100 12; M 0 12 Q 12.5 2, 25 12 T 50 12 T 75 12 T 100 12"
            />
          )}
        </path>
      </svg>

      {/* Noticeable Oscillating Sine Text */}
      <motion.span
        animate={
          prefersReducedMotion
            ? { opacity: 0.8 }
            : {
                opacity: [0.7, 1, 0.7],
                y: [0, -2, 0, 2, 0],
              }
        }
        transition={{
          duration: 1.8,
          repeat: Infinity,
          ease: "easeInOut",
        }}
        className="font-black text-xs uppercase tracking-widest text-cyan-700 drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]"
      >
        FETCHING LIVE TELEMETRY…
      </motion.span>
    </motion.span>
  );
}

export function CountUp({
  value,
  duration: _duration = 0.8,
  delay = 0,
  className = "",
  prefix = "",
  suffix = "",
  decimals = 0,
  startValue = 0,
  isLoading: propIsLoading,
}: CountUpProps) {
  const { prefersReducedMotion, performanceTier, isTouchDevice, isLiveLoading } = useGlass();
  const [mounted, setMounted] = useState(false);

  const isLoading = propIsLoading !== undefined ? propIsLoading : isLiveLoading;

  const isMobileOrLowFps =
    isTouchDevice ||
    performanceTier === "legacy" ||
    performanceTier === "emergency" ||
    performanceTier === "low" ||
    prefersReducedMotion;

  // Cinematic spring tuning for Glossy theme numerical rollout
  const spring = useSpring(startValue, {
    damping: isMobileOrLowFps ? 30 : 22,
    stiffness: isMobileOrLowFps ? 150 : 85,
  });

  useEffect(() => {
    setMounted(true);

    if (!isLoading && typeof value === "number") {
      const timer = setTimeout(() => {
        spring.set(value);
      }, delay * 1000);
      return () => clearTimeout(timer);
    }
  }, [value, delay, spring, isLoading]);

  const display = useTransform(spring, (v) => {
    const formatted = decimals > 0 ? v.toFixed(decimals) : Math.round(v).toLocaleString();
    return `${prefix}${formatted}${suffix}`;
  });

  // Noticeable Sine Wave Telemetry Loading State
  if (isLoading) {
    return <SineWaveLoader className={className} />;
  }

  if (!mounted || isMobileOrLowFps) {
    // Fast static fallback render for SSR and low-end mobile devices
    const formattedFallback = decimals > 0 ? value.toFixed(decimals) : value.toLocaleString();
    return (
      <span className={className}>
        {prefix}
        {formattedFallback}
        {suffix}
      </span>
    );
  }

  return <motion.span className={className}>{display}</motion.span>;
}

export default CountUp;
</file>

<file path="src/components/shared/DataFreshness.tsx">
"use client";

import { useEffect, useState } from "react";

/**
 * DataFreshness — a small dot + "Updated Xs ago" indicator that signals
 * how fresh a data panel is. Used inside KpiCard footers and any panel
 * that tracks when its data was last fetched.
 *
 * The useFreshness hook below returns a derived status (live/stale/offline)
 * and a ready-to-render display string, so callers can just pass
 * `fetchTime` and use the result without re-deriving thresholds.
 */

export type FreshnessStatus = "live" | "stale" | "offline";

export interface DataFreshnessProps {
  /** When the data was last fetched. Accepts either a Date or an epoch-ms number. */
  timestamp: Date | number;
  /** Explicit status override. When omitted, derived from how old the timestamp is. */
  status?: FreshnessStatus;
  /** Start a 10-second interval to refresh the "Xs ago" display. */
  autoRefresh?: boolean;
  className?: string;
}

// Freshness thresholds (seconds since fetch).
const STALE_AFTER_SEC = 30;

export interface UseFreshnessResult {
  status: FreshnessStatus;
  /** A human-readable display string, e.g. "Updated 12s ago" or "Showing cached data". */
  display: string;
}

/**
 * Derives a freshness status + display string from a fetch-timestamp (ms since
 * epoch). Use inside a client component; the caller should pair this with a
 * ticking state (or the `autoRefresh` option on the <DataFreshness/> component)
 * to keep the "Xs ago" text current.
 */
export function useFreshness(fetchTime: number, offline?: boolean): UseFreshnessResult {
  const [now, setNow] = useState<number>(() => (typeof window !== "undefined" ? Date.now() : 0));

  // Ticker — keeps the "ago" text fresh without a forced interval at the call-site.
  useEffect(() => {
    const id = window.setInterval(() => setNow(Date.now()), 10_000);
    return () => window.clearInterval(id);
  }, []);

  const status: FreshnessStatus = offline
    ? "offline"
    : now - fetchTime <= STALE_AFTER_SEC * 1000
      ? "live"
      : "stale";

  const display =
    status === "offline"
      ? "Showing cached data"
      : `Updated ${Math.max(0, Math.floor((now - fetchTime) / 1000))}s ago`;

  return { status, display };
}

const dotColor: Record<FreshnessStatus, string> = {
  live: "bg-emerald-500",
  stale: "bg-amber-500",
  offline: "bg-rose-500",
};

export function DataFreshness({
  timestamp,
  status: statusProp,
  autoRefresh,
  className,
}: DataFreshnessProps) {
  const fetchTime = typeof timestamp === "number" ? timestamp : timestamp.getTime();

  const [now, setNow] = useState<number>(() => Date.now());

  useEffect(() => {
    if (!autoRefresh) return;
    const id = window.setInterval(() => setNow(Date.now()), 10_000);
    return () => window.clearInterval(id);
  }, [autoRefresh]);

  const derived: FreshnessStatus =
    statusProp ?? (now - fetchTime <= STALE_AFTER_SEC * 1000 ? "live" : "stale");

  const display =
    derived === "offline"
      ? "Showing cached data"
      : `Updated ${Math.max(0, Math.floor((now - fetchTime) / 1000))}s ago`;

  return (
    <span
      className={`inline-flex items-center gap-1.5 text-[11px] text-text-muted ${className ?? ""}`}
      role="status"
      aria-live={autoRefresh ? "polite" : undefined}
    >
      <span
        className={`inline-block size-1.5 rounded-full shrink-0 ${dotColor[derived]}`}
        aria-hidden="true"
      />
      <span>{display}</span>
    </span>
  );
}

export default DataFreshness;
</file>

<file path="src/components/shared/DecisionItemCard.tsx">
"use client";

import { useState } from "react";

export interface DecisionOption<TAction extends string> {
  action: TAction;
  label: string;
  tone?: "primary" | "secondary" | "danger";
  requiresReason?: boolean;
}

export interface DecisionItemCardProps<TAction extends string> {
  title: string;
  subtitle: string;
  contextBadge: string;
  whyItNeedsAction: string;
  decisions: DecisionOption<TAction>[];
  busyAction: TAction | null;
  onDecide: (action: TAction, reason?: string) => Promise<void> | void;
}

const TONE_CLS: Record<NonNullable<DecisionOption<string>["tone"]>, string> = {
  primary: "bg-action-primary text-white hover:opacity-90",
  secondary: "bg-bg-elevated text-text-secondary hover:text-text-primary",
  danger: "bg-action-danger text-white hover:opacity-90",
};

/**
 * DecisionItemCard — inline decision-making card for approvers, operators,
 * and admins. Supports optional inline reason input (no browser prompt())
 * and immediate busy/disabled feedback.
 */
export function DecisionItemCard<TAction extends string>({
  title,
  subtitle,
  contextBadge,
  whyItNeedsAction,
  decisions,
  busyAction,
  onDecide,
}: DecisionItemCardProps<TAction>) {
  const [pendingReasonAction, setPendingReasonAction] = useState<TAction | null>(null);
  const [reasonText, setReasonText] = useState("");

  const handleOptionClick = (opt: DecisionOption<TAction>) => {
    if (opt.requiresReason) {
      setPendingReasonAction(opt.action);
      setReasonText("");
      return;
    }
    void onDecide(opt.action);
  };

  const submitReason = () => {
    if (!pendingReasonAction || !reasonText.trim()) return;
    const act = pendingReasonAction;
    const txt = reasonText.trim();
    setPendingReasonAction(null);
    setReasonText("");
    void onDecide(act, txt);
  };

  return (
    <article className="surface-card bg-bg-surface p-4 flex flex-col gap-3">
      <div className="flex flex-wrap items-start justify-between gap-2">
        <div className="min-w-0">
          <h3 className="text-sm font-semibold text-text-primary truncate">{title}</h3>
          <p className="text-xs text-text-muted truncate">{subtitle}</p>
        </div>
        <span className="px-2.5 py-0.5 rounded-full bg-bg-elevated text-xs font-medium text-text-secondary shrink-0">
          {contextBadge}
        </span>
      </div>

      <p className="text-xs leading-relaxed text-text-secondary">{whyItNeedsAction}</p>

      {pendingReasonAction ? (
        <div className="space-y-2 pt-1">
          <input
            type="text"
            value={reasonText}
            onChange={(e) => setReasonText(e.target.value)}
            placeholder="Enter reason (required)…"
            aria-label={`Reason for ${pendingReasonAction}`}
            className="w-full rounded-lg bg-bg-elevated px-3 py-2 text-xs text-text-primary focus:outline-none"
          />
          <div className="flex items-center gap-2">
            <button
              type="button"
              disabled={!reasonText.trim() || Boolean(busyAction)}
              onClick={submitReason}
              className="rounded-lg bg-action-primary px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50"
            >
              Confirm
            </button>
            <button
              type="button"
              onClick={() => {
                setPendingReasonAction(null);
                setReasonText("");
              }}
              className="rounded-lg bg-bg-elevated px-3 py-1.5 text-xs font-medium text-text-secondary"
            >
              Cancel
            </button>
          </div>
        </div>
      ) : (
        <div className="flex flex-wrap items-center gap-2 pt-1">
          {decisions.map((opt) => {
            const isBusy = busyAction === opt.action;
            const toneCls = TONE_CLS[opt.tone ?? "secondary"];
            return (
              <button
                key={opt.action}
                type="button"
                disabled={Boolean(busyAction)}
                onClick={() => handleOptionClick(opt)}
                className={`rounded-lg px-3 py-1.5 text-xs font-medium transition-opacity disabled:opacity-50 ${toneCls}`}
              >
                {isBusy ? "Applying…" : opt.label}
              </button>
            );
          })}
        </div>
      )}
    </article>
  );
}

export default DecisionItemCard;
</file>

<file path="src/components/shared/DeltaBadge.tsx">
/**
 * DeltaBadge — shows change vs a reference period ("vs last month +12%").
 * `value` is the current metric, `reference` is the comparable previous period.
 * Renders nothing when reference is 0 or missing (avoids division-by-zero / "∞%").
 */
import React from "react";
import { TrendingUp, TrendingDown, Minus } from "lucide-react";
import { cn } from "@/lib/utils";

export interface DeltaBadgeProps {
  /** Current value */
  value: number;
  /** Previous-period value to compare against */
  reference: number | null | undefined;
  /** Human label for the reference period, e.g. "vs last month" */
  label?: string;
  /** Higher is better (default true). Set false for metrics like complaints where lower = better. */
  higherIsBetter?: boolean;
  className?: string;
}

export function DeltaBadge({
  value,
  reference,
  label = "vs last period",
  higherIsBetter = true,
  className,
}: DeltaBadgeProps) {
  if (reference == null || reference === 0) return null;

  const delta = value - reference;
  const pct = reference !== 0 ? ((value - reference) / Math.abs(reference)) * 100 : 0;
  const isFlat = Math.abs(delta) < 0.001;
  const isUp = delta > 0;
  const isGood = isFlat ? true : higherIsBetter ? isUp : !isUp;

  const Icon = isFlat ? Minus : isUp ? TrendingUp : TrendingDown;
  const cls = isFlat
    ? "text-text-muted"
    : isGood
      ? "text-emerald-500"
      : "text-rose-500";

  return (
    <span
      className={cn("inline-flex items-center gap-1 text-xs font-medium", cls, className)}
      title={label}
    >
      <Icon className="h-3 w-3" />
      {isFlat ? "0" : `${isUp ? "+" : ""}${Math.round(pct)}%`}
      <span className="text-text-muted font-normal">{label}</span>
    </span>
  );
}

export default DeltaBadge;
</file>

<file path="src/components/shared/DigestBoard.tsx">
"use client";

/**
 * DigestBoard — renders a digest-shaped endpoint as a compact card.
 *
 * The `kind: "digest"` board source points at endpoints whose `data` is a
 * named-key object (e.g. /api/principal/dashboard → { pendingApprovals,
 * recentAlerts, campusOccupancy }), not a flat array. The feed <Board>
 * renderer would show an empty list for those, so this component renders
 * each top-level key as a small stat tile instead.
 *
 * Rendering rules:
 *   - top-level key is a number  → stat tile showing the number
 *   - top-level key is an array  → "N items" stat tile
 *   - top-level key is an object → nested tiles / collapsed preview
 *   - top-level key is a string  → labeled value tile
 *   - empty / null data          → EmptyState
 *
 * Mobile: full-width, no horizontal scroll. Desktop: card grid.
 */

import { useMemo } from "react";
import { LayoutGrid, Loader2 } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

interface DigestResponse {
  success?: boolean;
  data: Record<string, unknown> | null;
}

export interface DigestBoardProps {
  source: string;
}

function TileValue({ value }: { value: unknown }) {
  if (Array.isArray(value)) {
    return <span className="text-lg font-bold">{value.length} items</span>;
  }
  if (typeof value === "number") {
    return <span className="text-lg font-bold tabular-nums">{value}</span>;
  }
  if (typeof value === "object" && value !== null) {
    // Nested object: show key count as a compact preview
    const keys = Object.keys(value);
    return (
      <span className="text-xs text-text-secondary">
        {keys.length} fields
      </span>
    );
  }
  if (typeof value === "string") {
    return <span className="text-sm font-semibold">{value}</span>;
  }
  return <span className="text-sm text-text-muted">—</span>;
}

export function DigestBoard({ source }: DigestBoardProps) {
  const { data, loading, error } = useApiResource<DigestResponse>(source, {
    ttlMs: 15_000,
  });

  const tiles = useMemo(() => {
    if (!data?.data) return [];
    const payload = data.data as Record<string, unknown>;
    // Bo1: some endpoints nest the digest one level under a wrapper key
    // (e.g. { data: { dashboard: { pendingApprovals, ... } } }). Unwrap a
    // single-object wrapper so the tiles show the real fields, not one
    // "N fields" tile.
    const entries = Object.entries(payload);
    if (entries.length === 1 && typeof entries[0][1] === "object" && entries[0][1] !== null && !Array.isArray(entries[0][1])) {
      return Object.entries(entries[0][1] as Record<string, unknown>).map(([key, value]) => ({ key, value }));
    }
    return entries.map(([key, value]) => ({ key, value }));
  }, [data]);

  return (
    <WidgetBoundary title="Digest">
      {loading && tiles.length === 0 ? (
        <div className="flex items-center justify-center gap-2 py-8 text-sm text-text-muted">
          <Loader2 className="w-4 h-4 animate-spin" />
          <span>Loading…</span>
        </div>
      ) : error ? (
        <div className="surface-card py-6 text-xs text-action-warning bg-amber-400/10 p-3">
          {error}
        </div>
      ) : tiles.length === 0 ? (
        <EmptyState
          title="No data"
          description="Nothing to show yet."
          icon={<LayoutGrid className="w-6 h-6" />}
        />
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 p-1">
          {tiles.map(({ key, value }) => (
            <div
              key={key}
              className="surface-card bg-bg-elevated px-3 py-2 min-w-0"
            >
              <p className="text-xs font-mono uppercase tracking-wide text-text-muted truncate">
                {key}
              </p>
              <div className="mt-1">
                <TileValue value={value} />
              </div>
            </div>
          ))}
        </div>
      )}
    </WidgetBoundary>
  );
}
</file>

<file path="src/components/shared/DurationBar.tsx">
/**
 * DurationBar — compact horizontal bar showing elapsed time vs total.
 * `elapsedMs` / `totalMs` are in milliseconds.
 */
import React from "react";
import { cn } from "@/lib/utils";

export interface DurationBarProps {
  elapsedMs: number;
  totalMs: number;
  /** Show time labels. Default true. */
  showLabel?: boolean;
  /** Color tone. Default "info". */
  tone?: "ok" | "warn" | "danger" | "info";
  className?: string;
}

export function formatDuration(ms: number): string {
  const totalSec = Math.max(0, Math.round(ms / 1000));
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;
  if (h > 0) return `${h}h ${m}m`;
  if (m > 0) return `${m}m ${s}s`;
  return `${s}s`;
}

export function DurationBar({
  elapsedMs,
  totalMs,
  showLabel = true,
  tone = "info",
  className,
}: DurationBarProps) {
  const pct = totalMs > 0 ? Math.min(100, Math.max(0, (elapsedMs / totalMs) * 100)) : 0;
  const barCls: Record<string, string> = {
    ok: "bg-emerald-500",
    warn: "bg-amber-500",
    danger: "bg-rose-500",
    info: "bg-action-primary",
  };

  return (
    <div className={cn("flex items-center gap-2", className)}>
      <div
        className="h-1.5 flex-1 overflow-hidden rounded-full bg-bg-elevated"
        role="progressbar"
        aria-valuenow={Math.round(pct)}
        aria-valuemin={0}
        aria-valuemax={100}
      >
        <div
          className={cn("h-full rounded-full transition-all", barCls[tone])}
          style={{ width: `${pct}%` }}
        />
      </div>
      {showLabel && (
        <span className="shrink-0 text-xs tabular-nums text-text-muted">
          {formatDuration(elapsedMs)} / {formatDuration(totalMs)}
        </span>
      )}
    </div>
  );
}

export default DurationBar;
</file>

