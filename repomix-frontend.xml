<file path="src/app/(approver)/guardian/pass-leave-submission/page.tsx">
"use client";

import { Suspense, useCallback, useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { useSearchParams } from "next/navigation";

import { PageLoading } from "@/components/shared/LoadingStates";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { RoleStarterGuide } from "@/components/shared/RoleStarterGuide";

import { useAuthStore } from "@/stores/authStore";
import { useApiResource } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { usePassTypes } from "@/hooks/usePassTypes";
import { getAuthHeaders } from "@/lib/utils";
import type { Person } from "@/lib/types";
import { AuthGuard } from "@/components/shared/AuthGuard";
import {
  Loader2,
  CheckCircle2,
  Send,
  Info,
  Clock
} from "lucide-react";
import { formatDuration } from "@/components/shared/DurationBar";

/* ── shapes ── */

interface PersonsResponse {
  success: boolean;
  data: Person[];
}

interface PermissionRow {
  id: string;
  ticket_number?: string;
  workflow_type?: string;
  status?: string;
  created_at?: string;
}

interface PermissionListData {
  success: boolean;
  data: PermissionRow[];
  total?: number;
}

/* ── helpers ── */

function statusPill(status?: string) {
  const s = (status ?? "PENDING").toUpperCase();
  if (s === "APPROVED" || s === "COMPLETED")
    return "border-emerald-400/30 bg-emerald-400/10 text-action-success";
  if (s === "REJECTED" || s === "CANCELLED")
    return "border-rose-400/30 bg-rose-400/10 text-action-danger";
  if (s === "PENDING")
    return "border-amber-400/30 bg-amber-400/10 text-action-warning";
  return "border-border/30 bg-bg-elevated/10 text-text-muted";
}

function toLocalInputValue(iso: string): string {
  const d = new Date(iso);
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

/* ── main ── */

function PassLeaveSubmissionInner() {
  const user = useAuthStore((s) => s.user);
  const userId = user?.id ?? "";

  const {
    data: persons,
    loading: _personsLoading,
    error: personsError,
    refresh: refreshPersons,
  } = useApiResource<PersonsResponse>("/api/persons?parentId=me", {
    ttlMs: 30_000,
    enabled: !!userId,
  });

  const searchParams = useSearchParams();
  const preselectedWardId = searchParams.get("wardId") ?? "";
  const wards: Person[] = persons?.data ?? [];
  const [wardId, setWardId] = useState<string>(preselectedWardId);
  const [passType, setPassType] = useState<string>("");
  const [from, setFrom] = useState<string>("");
  const [to, setTo] = useState<string>("");
  const [reason, setReason] = useState<string>("");
  const [busy, setBusy] = useState(false);
  const [submitMsg, setSubmitMsg] = useState<{ ok: boolean; text: string } | null>(null);

  const { passTypes, loading: passTypesLoading } = usePassTypes();

  const {
    data: perms,
    loading: permsLoading,
    refresh: refreshPerms,
  } = useApiResource<PermissionListData>(
    "/api/permissions?status=PENDING",
    { ttlMs: 60_000, enabled: !!userId }
  );

  useEffect(() => {
    if (preselectedWardId && wards.some((w) => w.id === preselectedWardId)) {
      setWardId(preselectedWardId);
    } else if (!wardId && wards[0]) {
      setWardId(wards[0].id);
    }
  }, [wards, wardId, preselectedWardId]);

  useEffect(() => {
    if (passTypes.length > 0 && !passType) setPassType(passTypes[0].code);
  }, [passTypes, passType]);

  const refresh = useCallback(async () => {
    await Promise.all([refreshPersons(), refreshPerms()]);
  }, [refreshPersons, refreshPerms]);

  usePolling(refresh, { intervalMs: 60_000, enabled: !!userId });

  const rows = useMemo<PermissionRow[]>(() => {
    const r = perms?.data;
    return Array.isArray(r) ? r : [];
  }, [perms]);

  const pendingRows = rows.filter(
    (r) => (r.status ?? "PENDING").toUpperCase() === "PENDING"
  );

  // Duration preview: from → to, or from + default type duration
  const durationPreview = useMemo(() => {
    const typeMeta = passTypes.find((t) => t.code === passType);
    if (from && to) {
      const ms = new Date(to).getTime() - new Date(from).getTime();
      return ms > 0 ? formatDuration(ms) : null;
    }
    if (from) return formatDuration((typeMeta?.defaultDurationHours ?? 4) * 3_600_000);
    return null;
  }, [from, to, passType, passTypes]);

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!wardId || busy) return;
    setBusy(true);
    setSubmitMsg(null);

    const ward = wards.find((w) => w.id === wardId);
    const wardUserId = ward?.id ?? wardId;
    const typeMeta = passTypes.find((t) => t.code === passType);

    const fromIso = from ? new Date(from).toISOString() : new Date().toISOString();
    let toIso: string;
    if (to) {
      toIso = new Date(to).toISOString();
    } else {
      const t = new Date();
      t.setHours(t.getHours() + (typeMeta?.defaultDurationHours || 4));
      toIso = t.toISOString();
    }

    try {
      const res = await fetch("/api/permissions", {
        method: "POST",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        body: JSON.stringify({
          workflow_type: "hostel",
          student_user_id: wardUserId,
          requested_by: "guardian",
          reason: reason || typeMeta?.description || "Guardian-submitted leave request",
          from: fromIso,
          to: toIso,
          requestedById: user?.id,
          requestedByName: user?.name,
        }),
      });
      const json = await res.json().catch(() => null);
      if (res.ok && json?.success) {
        setSubmitMsg({
          ok: true,
          text: `Request submitted (${json.data?.ticket_number ?? "ticket created"}). Submission only — the approval chain proceeds at the campus offices.`,
        });
        setReason("");
        refreshPerms();
      } else {
        setSubmitMsg({
          ok: false,
          text: json?.error?.message || json?.error || "Failed to submit the request.",
        });
      }
    } catch {
      setSubmitMsg({ ok: false, text: "Network error — please retry." });
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="min-w-0 space-y-6">
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div className="min-w-0">
          <p className="text-2xl font-semibold tracking-tight text-white flex items-center gap-2">
            <Send className="w-6 h-6 text-action-success" />
            Pass &amp; Leave Request Submission
          </p>
          <p className="mt-1 text-sm text-text-muted">
            Submit a pass or leave request for a linked ward
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Student Guardian / Parent"
        purpose="Create and submit outing or leave applications for wards into the campus approval pipeline."
        why="Submitting requests directly guarantees official parent authorization is captured upfront, accelerating approval times."
        contextLabel="Request Submission Portal"
        statusTone="info"
        statusPill={`${wards.length} Ward${wards.length === 1 ? "" : "s"} Available`}
        statusSummary="Guardian submissions initiate official approval workflows. Track submitted tickets in Request Status."
        primaryAction={{ label: "Request Status", href: "/guardian/request-status" }}
        secondaryAction={{ label: "Ward Status", href: "/guardian/child-status" }}
      />

      <RoleStarterGuide
        guideId="guardian-submit"
        title="How Guardian Submissions Work"
        summary="Select your ward and submit a pass or leave request into the campus approval chain."
        steps={[
          "Select ward & dates",
          "Submit to campus approvers",
          "Track status in Request Status",
        ]}
      />

      <div className="surface-card bg-amber-400/10 p-3 text-sm text-action-warning flex items-start gap-2.5">
        <Info className="w-4 h-4 shrink-0 mt-0.5 text-action-warning" />
        <p>
          <strong className="font-semibold text-amber-100">Submission only — no approval authority.</strong>{" "}
          You may submit pass/leave requests on behalf of your wards, but approval is handled by
          the designated campus approval chain (caregiver → principal).
        </p>
      </div>

      {personsError && (
        <div className="surface-card bg-rose-500/10 p-3 text-sm text-rose-600">
          Could not load wards.{" "}
          <button type="button" onClick={() => void refreshPersons()} className="underline font-semibold">
            Retry
          </button>
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        {/* ── submission form ── */}
        <form
          onSubmit={submit}
          className="surface-card bg-bg-surface p-4 space-y-4"
        >
          <h2 className="text-sm font-semibold text-text-secondary uppercase tracking-wide">
            New request
          </h2>

          {wards.length === 0 ? (
            <div className="surface-card bg-bg-base/60 p-6 text-center space-y-2">
              <p className="text-sm font-semibold text-text-secondary">No wards linked to your account</p>
              <p className="text-xs text-text-muted">A student must be linked to your guardian account before you can submit leave requests.</p>
              <div className="pt-2">
                <Link
                  href="/guardian/contact-info"
                  className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-action-primary text-white hover:opacity-90 transition-opacity"
                >
                  Verify Contact &amp; Link Details
                </Link>
              </div>
            </div>
          ) : (
            <>
              <div>
                <label htmlFor="ward" className="block text-xs font-medium text-text-secondary mb-1">
                  Linked ward
                </label>
                <select
                  id="ward"
                  value={wardId}
                  onChange={(e) => setWardId(e.target.value)}
                  disabled={busy}
                  className="surface-card w-full bg-bg-elevated px-3 py-2 text-sm text-text-primary focus:outline-none focus:disabled:opacity-50"
                >
                  {wards.map((w) => (
                    <option key={w.id} value={w.id}>
                      {w.fullName || w.name || "Ward"} · {w.uniqueId || w.roll || ""}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label htmlFor="passType" className="block text-xs font-medium text-text-secondary mb-1">
                  Request type
                </label>
                <select
                  id="passType"
                  value={passType}
                  onChange={(e) => setPassType(e.target.value)}
                  disabled={busy || passTypesLoading}
                  className="surface-card w-full bg-bg-elevated px-3 py-2 text-sm text-text-primary focus:outline-none focus:disabled:opacity-50"
                >
                  {passTypes.map((t) => (
                    <option key={t.code} value={t.code}>
                      {t.name} ({t.defaultDurationHours} hrs)
                    </option>
                  ))}
                </select>
                {passType && (
                  <p className="text-xs text-text-muted mt-1">
                    {passTypes.find((t) => t.code === passType)?.description}
                  </p>
                )}
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label htmlFor="from" className="block text-xs font-medium text-text-secondary mb-1">
                    From
                  </label>
                  <input
                    id="from"
                    type="datetime-local"
                    value={from}
                    onChange={(e) => setFrom(e.target.value)}
                    min={toLocalInputValue(new Date().toISOString())}
                    disabled={busy}
                    className="surface-card w-full bg-bg-elevated px-3 py-2 text-sm text-text-primary focus:outline-none focus:disabled:opacity-50"
                  />
                </div>
                <div>
                  <label htmlFor="to" className="block text-xs font-medium text-text-secondary mb-1">
                    To
                  </label>
                  <input
                    id="to"
                    type="datetime-local"
                    value={to}
                    onChange={(e) => setTo(e.target.value)}
                    disabled={busy}
                    className="surface-card w-full bg-bg-elevated px-3 py-2 text-sm text-text-primary focus:outline-none focus:disabled:opacity-50"
                  />
                </div>
              </div>

              {/* Duration preview */}
              {durationPreview && (
                <div className="rounded-lg border border-border bg-bg-elevated px-3 py-2 flex items-center justify-between text-xs">
                  <span className="inline-flex items-center gap-1 text-text-muted"><Clock className="w-3.5 h-3.5" /> Requested duration</span>
                  <span className="font-semibold text-text-primary tabular-nums">{durationPreview}</span>
                </div>
              )}

              <div>
                <label htmlFor="reason" className="block text-xs font-medium text-text-secondary mb-1">
                  Reason / notes
                </label>
                <textarea
                  id="reason"
                  value={reason}
                  onChange={(e) => setReason(e.target.value)}
                  rows={3}
                  placeholder="Reason for the pass or leave (optional)"
                  disabled={busy}
                  className="surface-card w-full bg-bg-elevated px-3 py-2 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:disabled:opacity-50"
                />
              </div>

              <button
                type="submit"
                disabled={busy || wards.length === 0}
                className="surface-card inline-flex items-center gap-2 px-4 py-2 bg-action-success hover:bg-action-success disabled:opacity-50 text-white text-sm font-semibold w-full sm:w-auto"
              >
                {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <Send className="w-4 h-4" />}
                {busy ? "Submitting…" : "Submit request"}
              </button>

              {submitMsg && (
                <div
                  className={`rounded-lg border p-3 text-sm ${
                    submitMsg.ok
                      ? "border-emerald-400/30 bg-emerald-400/10 text-action-success"
                      : "border-rose-400/30 bg-rose-400/10 text-action-danger"
                  } flex items-start gap-2`}
                >
                  <CheckCircle2 className="w-4 h-4 shrink-0 mt-0.5" />
                  <span>{submitMsg.text}</span>
                </div>
              )}
            </>
          )}
        </form>

        {/* ── ward request status list ── */}
        <div className="surface-card bg-bg-surface p-4 space-y-3 min-w-0">
          <div className="flex items-center justify-between">
            <h2 className="text-sm font-semibold text-text-secondary uppercase tracking-wide">
              Ward request timeline
            </h2>
            <span className="text-xs text-text-muted">
              {pendingRows.length} pending
            </span>
          </div>

          {permsLoading && rows.length === 0 ? (
            <div className="flex items-center gap-2 text-sm text-text-muted py-2">
              <Loader2 className="w-4 h-4 animate-spin" /> Loading requests…
            </div>
          ) : rows.length === 0 ? (
            <div className="surface-card p-6 text-center space-y-2">
              <p className="text-sm font-semibold text-text-secondary">No requests found</p>
              <p className="text-xs text-text-muted">No pass or leave requests have been submitted for your wards yet.</p>
              <div className="pt-2">
                <Link
                  href="/guardian/child-status"
                  className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-bg-elevated text-text-secondary hover:text-text-primary transition-colors"
                >
                  View Ward Status
                </Link>
              </div>
            </div>
          ) : (
            <div className="space-y-2">
              {rows.slice(0, 12).map((r) => (
                <div
                  key={r.id}
                  className="surface-card bg-bg-base/50 p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2 min-w-0"
                >
                  <div className="min-w-0">
                    <p className="text-sm font-medium text-text-primary font-mono">
                      {r.ticket_number || r.id.slice(0, 8)}
                    </p>
                    <p className="text-xs text-text-muted">
                      {r.workflow_type || "—"}
                      {r.created_at ? ` · ${new Date(r.created_at).toLocaleDateString("en-IN")}` : ""}
                    </p>
                  </div>
                  <div className="flex items-center gap-2 shrink-0">
                    <span
                      className={`inline-block px-2 py-0.5 rounded-full text-xs font-medium border whitespace-nowrap ${statusPill(r.status)}`}
                    >
                      {r.status || "PENDING"}
                    </span>
                    <Link
                      href={`/guardian/request-status?ticket=${encodeURIComponent(r.ticket_number ?? r.id)}`}
                      className="text-xs text-action-success hover:underline"
                    >
                      View timeline
                    </Link>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

    </div>
  );
}
export default function PassLeaveSubmissionPage() {
  return (
    <AuthGuard allowedRoles={['guardian', 'parent', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <PassLeaveSubmissionInner />
      </Suspense>
    </AuthGuard>
  );
}
