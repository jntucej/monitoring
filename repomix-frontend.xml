<file path="src/app/(approver)/guardian/request-status/page.tsx">
"use client";

import { Suspense, useCallback, useMemo, useState } from "react";
import { useSearchParams } from "next/navigation";
import Link from "next/link";

import { PageLoading } from "@/components/shared/LoadingStates";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import {
  Loader2,
  Inbox
} from "lucide-react";

import { RequestTimeline } from "@/components/shared/RequestTimeline";
import { useAuthStore } from "@/stores/authStore";
import { useApiResource } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { AuthGuard } from "@/components/shared/AuthGuard";


/* ── shapes ── */

interface PermissionRow {
  id: string;
  ticket_number?: string;
  workflow_type?: string;
  status?: string;
  current_stage?: string;
  created_at?: string;
  student?: { name?: string; student_details?: { roll?: string } | null } | null;
}

interface PermissionListData {
  success: boolean;
  data: PermissionRow[];
  total?: number;
}

/* ── helpers ── */

function statusPill(status?: string) {
  const s = (status ?? "PENDING").toUpperCase();
  if (s === "APPROVED" || s === "COMPLETED")
    return "border-emerald-400/30 bg-emerald-400/10 text-action-success";
  if (s === "REJECTED" || s === "CANCELLED")
    return "border-rose-400/30 bg-rose-400/10 text-action-danger";
  if (s === "ESCALATED")
    return "border-amber-400/30 bg-amber-400/10 text-action-warning";
  if (s === "PENDING")
    return "border-sky-400/30 bg-sky-400/10 text-action-info";
  return "border-border/30 bg-bg-elevated/10 text-text-muted";
}

/* ── main ── */

function RequestStatusPageInner() {
  const searchParams = useSearchParams();
  return <RequestStatusContent ticketParam={searchParams.get("ticket") ?? ""} />;
}

function RequestStatusContent({ ticketParam }: { ticketParam: string }) {
  const user = useAuthStore((s) => s.user);
  const userId = user?.id ?? "";

  const {
    data: perms,
    loading,
    error,
    refresh,
  } = useApiResource<PermissionListData>("/api/permissions?status=PENDING", {
    ttlMs: 30_000,
    enabled: !!userId,
  });

  const rows = useMemo<PermissionRow[]>(() => {
    const r = perms?.data;
    return Array.isArray(r) ? r : [];
  }, [perms]);

  const [selectedTicket, setSelectedTicket] = useState<string>(ticketParam);
  const effectiveTicket =
    rows.some((r) => (r.ticket_number ?? r.id) === selectedTicket) || ticketParam
      ? selectedTicket
      : (rows[0]?.ticket_number ?? rows[0]?.id ?? "");

  const refreshAll = useCallback(async () => {
    void refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 60_000, enabled: !!userId });

  return (
    <div className="min-w-0 space-y-6">
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div className="min-w-0">
          <p className="text-2xl font-semibold tracking-tight text-white flex items-center gap-2">
            <Inbox className="w-6 h-6 text-action-success" />
            Request Status
          </p>
          <p className="mt-1 text-sm text-text-muted">
            Track the approval timeline of pass and leave requests for your wards
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Student Guardian / Parent"
        purpose="Track stage-by-stage approval progress, verifications, and decisions for ward requests."
        why="Tracking stages indicates whether a request is waiting for class teacher sign-off, warden review, or is ready for gate departure."
        contextLabel="Request Lifecycle & Approvals"
        statusTone={rows.length > 0 ? "info" : "ok"}
        statusPill={`${rows.length} Request${rows.length === 1 ? "" : "s"}`}
        statusSummary={
          effectiveTicket
            ? `Viewing timeline for ticket ${effectiveTicket}. Click any request on the left to inspect its path.`
            : rows.length > 0
              ? `Tracking ${rows.length} ward request(s). Select a request to view its stage history.`
              : "No requests found for your wards. Submit a request to initiate approval tracking."
        }
        primaryAction={{ label: "Submit Request", href: "/guardian/pass-leave-submission" }}
        secondaryAction={{ label: "Ward Status", href: "/guardian/child-status" }}
      />

      {error && (
        <div className="surface-card bg-rose-500/10 p-3 text-sm text-rose-600">
          {error}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        {/* request list */}
        <div className="surface-card bg-bg-surface p-4 space-y-3 min-w-0">
          <h2 className="text-sm font-semibold text-text-secondary uppercase tracking-wide">
            Ward requests
          </h2>
          {loading && rows.length === 0 ? (
            <div className="flex items-center gap-2 text-sm text-text-muted">
              <Loader2 className="w-4 h-4 animate-spin" /> Loading requests…
            </div>
          ) : rows.length === 0 ? (
            <div className="surface-card p-6 text-center space-y-2">
              <p className="text-sm font-semibold text-text-secondary">No requests found</p>
              <p className="text-xs text-text-muted">No pass or leave requests have been found for your linked wards.</p>
              <div className="pt-2">
                <Link
                  href="/guardian/pass-leave-submission"
                  className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-action-primary text-white hover:opacity-90 transition-opacity"
                >
                  Submit Pass / Leave
                </Link>
              </div>
            </div>
          ) : (
            <div className="space-y-2 max-h-96 overflow-y-auto pr-1">
              {rows.map((r) => {
                const isActive = effectiveTicket === (r.ticket_number ?? r.id);
                return (
                  <button
                    key={r.id}
                    type="button"
                    onClick={() => setSelectedTicket(r.ticket_number ?? r.id)}
                    className={`w-full rounded-lg border p-3 text-left transition-colors motion-reduce:transition-none ${
                      isActive
                        ? "border-emerald-400/50 bg-emerald-500/10"
                        : "border-border bg-bg-base/50 hover:bg-bg-elevated"
                    }`}
                  >
                    <div className="flex items-center justify-between gap-2">
                      <span className="text-sm font-mono font-medium text-text-primary">
                        {r.ticket_number || r.id.slice(0, 8)}
                      </span>
                      <span
                        className={`inline-block px-2 py-0.5 rounded-full text-xs font-medium border ${statusPill(r.status)}`}
                      >
                        {r.status || "PENDING"}
                      </span>
                    </div>
                    <p className="text-xs text-text-muted mt-1">
                      {r.workflow_type ? r.workflow_type.replace(/_/g, " ") : "—"}
                      {r.student?.name ? ` · ${r.student.name}` : ""}
                      {r.student?.student_details?.roll ? ` (${r.student.student_details.roll})` : ""}
                    </p>
                  </button>
                );
              })}
            </div>
          )}
        </div>

        {/* timeline */}
        <div className="min-w-0">
          {effectiveTicket ? (
            <RequestTimeline ticket={effectiveTicket} />
          ) : (
            <div className="surface-card p-8 text-center text-sm text-text-muted h-full flex flex-col items-center justify-center space-y-2">
              <p className="font-medium text-text-secondary">Select a request</p>
              <p className="text-xs text-text-muted">Choose a request from the list to view its complete approval timeline.</p>
              {rows.length === 0 && (
                <div className="pt-2">
                  <Link
                    href="/guardian/pass-leave-submission"
                    className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-action-primary text-white hover:opacity-90 transition-opacity"
                  >
                    Submit a Request
                  </Link>
                </div>
              )}
            </div>
          )}
        </div>
      </div>

    </div>
  );
}
export default function RequestStatusPagePage() {
  return (
    <AuthGuard allowedRoles={['guardian', 'parent', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <RequestStatusPageInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(approver)/guardian/visit-schedule/page.tsx">
"use client";

import { Suspense, useCallback, useMemo, useState } from "react";

import { PageLoading } from "@/components/shared/LoadingStates";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useApiResource } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { getAuthHeaders } from "@/lib/utils";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { LifefulCalendarAgenda } from "@/components/nav/LifefulCalendarAgenda";
import {
  Loader2,
  AlertTriangle,
  Calendar,
  ChevronLeft,
  ChevronRight,
  Check,
  Bell
} from "lucide-react";

/* ── shapes (mirror /api/campus-extra/calendar response) ── */

interface CalendarEvent {
  id: string;
  category: string;
  title: string;
  date: string;
  time?: string | null;
  location?: string | null;
  owner?: string | null;
}

interface CalendarCategory {
  id: string;
  code: string;
  label: string;
  color: string;
  icon?: string;
}

interface CalendarResponse {
  success: boolean;
  data: {
    events: CalendarEvent[];
    categories: CalendarCategory[];
    followedCategories: string[];
  };
}

const CATEGORY_COLORS: Record<string, string> = {
  examination: "var(--unit-c)",
  workshop: "var(--action-primary)",
  event: "var(--action-success)",
  department: "var(--action-warning)",
  hostel: "var(--action-info)",
  staff_duty: "var(--action-danger)",
  maintenance: "var(--action-success)",
  admin_deadline: "var(--unit-c)",
};

function monthKey(d: Date): string {
  return d.toISOString().slice(0, 7);
}

/* ── main ── */

function VisitScheduleInner() {
  const [currentMonth, setCurrentMonth] = useState(monthKey(new Date()));
  const [view, setView] = useState<"list" | "month">("list");

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<CalendarResponse>(
    `/api/campus-extra/calendar?month=${encodeURIComponent(currentMonth)}`,
    {
      ttlMs: 60_000,
      deps: [currentMonth],
    }
  );

  const refreshAll = useCallback(() => refresh(), [refresh]);
  usePolling(refreshAll, { intervalMs: 60_000, enabled: true });

  const events: CalendarEvent[] = data?.data?.events ?? [];
  const categories: CalendarCategory[] = data?.data?.categories ?? [];
  const followed = data?.data?.followedCategories ?? [];

  const upcoming = useMemo(() => {
    const now = new Date().toISOString();
    return events
      .filter((e) => e.date >= now)
      .sort((a, b) => a.date.localeCompare(b.date))
      .slice(0, 20);
  }, [events]);

  const monthLabel = new Date(currentMonth + "-01").toLocaleDateString("en-IN", {
    month: "long",
    year: "numeric",
  });

  const prevMonth = () => {
    const d = new Date(currentMonth + "-01");
    d.setMonth(d.getMonth() - 1);
    setCurrentMonth(monthKey(d));
  };
  const nextMonth = () => {
    const d = new Date(currentMonth + "-01");
    d.setMonth(d.getMonth() + 1);
    setCurrentMonth(monthKey(d));
  };

  const toggleFollow = async (code: string, reminder: boolean) => {
    const headers = getAuthHeaders();
    await fetch(
      `/api/campus-extra/calendar?follow=${encodeURIComponent(code)}&reminder=${reminder}`,
      { method: "POST", headers }
    );
    await refresh();
  };

  return (
    <div className="min-w-0 space-y-6">
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div className="min-w-0">
          <p className="text-2xl font-semibold tracking-tight text-white flex items-center gap-2">
            <Calendar className="w-4 h-4 text-action-success" />
            Visit Schedule
          </p>
          <p className="mt-1 text-sm text-text-muted">
            Planned campus events, deadlines and visits
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Student Guardian / Parent"
        purpose="Plan and coordinate campus visits around institutional events, holidays, and deadlines."
        why="Checking institutional event dates and holiday schedules prevents traveling during closed campus periods."
        contextLabel="Campus Calendar & Visits"
        statusTone="info"
        statusPill={`${events.length} Event${events.length === 1 ? "" : "s"}`}
        statusSummary={
          events.length > 0
            ? `Viewing ${events.length} scheduled institutional event(s) and visit windows this month.`
            : "No scheduled campus events found for this month."
        }
        primaryAction={{ label: "Submit Pass / Leave", href: "/guardian/pass-leave-submission" }}
        secondaryAction={{ label: "Ward Status", href: "/guardian/child-status" }}
      />

      {error && (
        <div className="surface-card bg-rose-500/10 p-3 text-sm text-rose-600 flex items-center justify-between gap-3">
          <span className="flex items-center gap-2">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            Could not load the campus calendar.
          </span>
          <button
            type="button"
            onClick={() => void refreshAll()}
            className="surface-card inline-flex items-center gap-1.5 bg-rose-500/20 px-3 py-1.5 text-xs font-semibold text-rose-100 hover:bg-rose-500/30"
          >
            Retry
          </button>
        </div>
      )}

      <div className="surface-card bg-bg-surface p-4 sm:p-5 min-w-0">
        {/* header row */}
        <div className="flex items-center justify-between mb-4 flex-wrap gap-2">
          <div className="flex items-center gap-2 min-w-0">
            <Calendar className="h-4 w-4 text-action-success shrink-0" />
            <span className="text-sm font-medium text-text-primary">
              {monthLabel}
            </span>
            <span className="text-xs text-text-muted">
              ({upcoming.length} upcoming)
            </span>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={prevMonth}
              className="surface-card p-1.5 hover:bg-bg-elevated text-text-muted transition-colors motion-reduce:transition-none"
              aria-label="Previous month"
            >
              <ChevronLeft className="h-4 w-4" />
            </button>
            <button
              type="button"
              onClick={nextMonth}
              className="surface-card p-1.5 hover:bg-bg-elevated text-text-muted transition-colors motion-reduce:transition-none"
              aria-label="Next month"
            >
              <ChevronRight className="h-4 w-4" />
            </button>
            <button
              type="button"
              onClick={() => setView(view === "list" ? "month" : "list")}
              className="surface-card px-2.5 py-1 text-xs text-text-muted hover:bg-bg-elevated transition-colors motion-reduce:transition-none"
            >
              {view === "list" ? "Month view" : "List view"}
            </button>
          </div>
        </div>

        {/* followed category pills */}
        {categories.length > 0 && (
          <div className="flex flex-wrap gap-1.5 mb-4">
            {categories.map((cat) => {
              const isFollowed = followed.includes(cat.code);
              return (
                <button
                  key={cat.code}
                  type="button"
                  onClick={() => void toggleFollow(cat.code, !isFollowed)}
                  className={`inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs transition-colors motion-reduce:transition-none ${
                    isFollowed ? "" : "border border-border text-text-muted hover:bg-bg-elevated"
                  }`}
                  style={
                    isFollowed
                      ? {
                          backgroundColor: `${cat.color}25`,
                          borderColor: `${cat.color}50`,
                          color: cat.color,
                        }
                      : undefined
                  }
                >
                  {isFollowed ? <Check className="size-3.5" /> : <Bell className="size-3.5" />}
                  {cat.label}
                </button>
              );
            })}
          </div>
        )}

        {loading ? (
          <div className="py-10 flex items-center justify-center text-sm text-text-muted">
            <Loader2 className="w-4 h-4 animate-spin mr-2" />
            Loading campus calendar…
          </div>
        ) : upcoming.length === 0 ? (
          <div className="surface-card bg-bg-base/60 p-6 text-center space-y-2">
            <p className="text-sm font-semibold text-text-secondary">No upcoming campus events</p>
            <p className="text-xs text-text-muted">No upcoming campus events or visit windows scheduled this month.</p>
            <div className="pt-2">
              <a
                href="/guardian/pass-leave-submission"
                className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-action-primary text-white hover:opacity-90 transition-opacity"
              >
                Plan a Visit Request
              </a>
            </div>
          </div>
        ) : view === "list" ? (
          <div className="space-y-2 max-h-4 overflow-y-auto">
            {upcoming.map((ev) => {
              const color = CATEGORY_COLORS[ev.category] ?? "var(--text-muted)";
              const isFollowed = followed.includes(ev.category);
              return (
                <div
                  key={ev.id}
                  className="surface-card flex items-start gap-3 bg-bg-base/40 p-3"
                >
                  <div
                    className="mt-0.5 size-4 rounded-full shrink-0"
                    style={{ backgroundColor: color }}
                  />
                  <div className="flex-1 min-w-0">
                    <p className="text-sm font-medium text-text-primary truncate">
                      {ev.title}
                    </p>
                    <p className="text-xs text-text-muted mt-0.5">
                      {new Date(ev.date).toLocaleDateString("en-IN", {
                        day: "2-digit",
                        month: "short",
                        year: "numeric",
                      })}
                      {ev.time ? ` · ${ev.time}` : ""}
                      {ev.location ? ` · ${ev.location}` : ""}
                      {ev.owner ? ` · ${ev.owner}` : ""}
                    </p>
                  </div>
                  <button
                    type="button"
                    onClick={() => void toggleFollow(ev.category, !isFollowed)}
                    className="p-1.5 text-text-muted hover:text-text-primary transition-colors motion-reduce:transition-none shrink-0"
                    aria-label="Toggle reminder for this category"
                  >
                    {isFollowed ? (
                      <Bell className="h-4 w-4 text-action-success" />
                    ) : (
                      <Bell className="h-4 w-4" />
                    )}
                  </button>
                </div>
              );
            })}
          </div>
        ) : (
          /* compact month-style grid of events by day */
          <div className="space-y-3 max-h-4 overflow-y-auto">
            {groupedMonth(events).map(([day, dayEvents]) => (
              <div key={day}>
                <p className="text-xs font-semibold uppercase tracking-wide text-text-muted mb-1.5">
                  {new Date(day + "T00:00:00").toLocaleDateString("en-IN", {
                    weekday: "short",
                    day: "2-digit",
                    month: "short",
                  })}
                </p>
                <div className="space-y-1.5">
                  {dayEvents.map((ev) => {
                    const color = CATEGORY_COLORS[ev.category] ?? "var(--text-muted)";
                    return (
                      <div
                        key={ev.id}
                        className="surface-card flex items-center gap-2 px-3 py-1.5 text-xs"
                        style={{
                          backgroundColor: `${color}15`,
                          color,
                        }}
                      >
                        <span className="truncate flex-1">{ev.title}</span>
                        {ev.time && <span className="shrink-0 opacity-70">{ev.time}</span>}
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <LifefulCalendarAgenda
        selectedDateLabel={new Date().toISOString().slice(0, 10)}
        isToday={true}
        items={events.slice(0, 6).map((ev) => ({
          id: ev.id,
          title: ev.title,
          category: ev.category,
          timeRange: ev.time ?? null,
          location: ev.location ?? null,
          status: "upcoming",
        }))}
        quickLinks={[
          { label: "Child Requests", href: "/guardian/child-requests" },
          { label: "Contact Info", href: "/guardian/contact-info" },
        ]}
      />
    </div>
  );
}

function groupedMonth(events: CalendarEvent[]): [string, CalendarEvent[]][] {
  const map = new Map<string, CalendarEvent[]>();
  for (const ev of events) {
    const day = ev.date.slice(0, 10);
    const list = map.get(day) ?? [];
    list.push(ev);
    map.set(day, list);
  }
  return Array.from(map.entries()).sort((a, b) => a[0].localeCompare(b[0]));
}
export default function VisitSchedulePage() {
  return (
    <AuthGuard allowedRoles={['guardian', 'parent', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <VisitScheduleInner />
      </Suspense>
    </AuthGuard>
  );
}
