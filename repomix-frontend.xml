// src/components/RoleThemeProvider.tsx
//
// Wraps a role's layout.tsx and injects the role's identity CSS vars.
// One CSS variable swap changes the entire feel: accent, tint, radius.
//
//   import { RoleThemeProvider } from "@/components/RoleThemeProvider";
//
//   // In layout.tsx:
//   return <RoleThemeProvider>{children}</RoleThemeProvider>;
//
// The provider reads the role from the auth store (post-login) and
// sets --role-accent, --role-tint, --role-radius on the root div.

"use client";

import { useEffect } from "react";
import { useAuthStore } from "@/stores/authStore";
import { getRoleConfig } from "@/config/roles";

// CSS variable map: accent name → hex value
// These are the L1 identity layer — each role gets a distinct palette.
const ACCENT_MAP: Record<string, { accent: string; accentMuted: string; tint: string; radius: string }> = {
  teal:           { accent: "#0f766e", accentMuted: "#5eead4", tint: "#f0fdfa", radius: "0.5rem" },
  "calm-blue":    { accent: "#2563eb", accentMuted: "#93c5fd", tint: "#eff6ff", radius: "0.375rem" },
  slate:          { accent: "#475569", accentMuted: "#94a3b8", tint: "#f8fafc", radius: "0.375rem" },
  indigo:         { accent: "#4338ca", accentMuted: "#818cf8", tint: "#eef2ff", radius: "0.375rem" },
  navy:           { accent: "#1e3a8a", accentMuted: "#60a5fa", tint: "#f8fafc", radius: "0.375rem" },
  yellow:         { accent: "#a16207", accentMuted: "#fde047", tint: "#fefce8", radius: "0.375rem" },
  steel:          { accent: "#475569", accentMuted: "#cbd5e1", tint: "#f0f9ff", radius: "0.5rem" },
  burgundy:       { accent: "#881337", accentMuted: "#fda4af", tint: "#fef2f2", radius: "0.375rem" },
  saffron:        { accent: "#b45309", accentMuted: "#fbbf24", tint: "#fffbeb", radius: "0.5rem" },
  charcoal:       { accent: "#1e293b", accentMuted: "#64748b", tint: "#f8fafc", radius: "0.375rem" },
  "terminal-green":{ accent: "#16a34a", accentMuted: "#4ade80", tint: "#0a0f0a", radius: "0.375rem" },
  sky:            { accent: "#0369a1", accentMuted: "#7dd3fc", tint: "#f0f9ff", radius: "0.5rem" },
  olive:          { accent: "#3f6212", accentMuted: "#a3e635", tint: "#f5f5f4", radius: "0.75rem" },
  earth:          { accent: "#92400e", accentMuted: "#d97706", tint: "#f5f5dc", radius: "0.375rem" },
  "warm-red":     { accent: "#b91c1c", accentMuted: "#f87171", tint: "#fef2f2", radius: "0.375rem" },
  "red-orange":   { accent: "#b91c1c", accentMuted: "#fb923c", tint: "#fff7ed", radius: "0.375rem" },
  amber:          { accent: "#b45309", accentMuted: "#fbbf24", tint: "#fffbeb", radius: "0.375rem" },
  orange:         { accent: "#c2410c", accentMuted: "#fb923c", tint: "#fff7ed", radius: "0.375rem" },
  forest:         { accent: "#166534", accentMuted: "#4ade80", tint: "#f0fdf4", radius: "0.375rem" },
  "royal-purple": { accent: "#7c3aed", accentMuted: "#c4b5fd", tint: "#faf5ff", radius: "0.375rem" },
  graphite:       { accent: "#64748b", accentMuted: "#94a3b8", tint: "#f8fafc", radius: "0.375rem" },
};

export function RoleThemeProvider({ children }: { children: React.ReactNode }) {
  const role = useAuthStore((s) => s.role);
  const cfg = role ? getRoleConfig(role) : undefined;

  useEffect(() => {
    const accentName = cfg?.identity.accent ?? "graphite";
    const colors = ACCENT_MAP[accentName] ?? ACCENT_MAP.graphite;
    const root = document.documentElement;

    root.style.setProperty("--role-accent", colors.accent);
    root.style.setProperty("--role-accent-muted", colors.accentMuted);
    root.style.setProperty("--role-tint", colors.tint);
    root.style.setProperty("--role-radius", colors.radius);

    // Motion preset: set on <html> as data-motion attribute
    root.setAttribute("data-motion", cfg?.identity.motionPreset ?? "calm");

    return () => {
      root.removeAttribute("data-motion");
    };
  }, [cfg?.identity.accent, cfg?.identity.motionPreset, cfg?.identity.radius]);

  return <>{children}</>;
}
</file>

<file path="src/components/SakugaLoadingSplash.tsx">
// src/components/SakugaLoadingSplash.tsx
//
// Full-page sakuga-vfx loading splash for female students (ui_theme='sakuga').
// Replaces the generic PageLoading with an anime-styled progress bar +
// character scene while dashboard widgets load.
//
// Only rendered when data-theme="sakuga" is on <html> — zero impact on
// graphite/default-theme users.
//
// The sakuga-progress custom element is registered by progress.js (loaded
// by ClientProviders when the theme is active). If the element is not yet
// defined on first paint, a static CSS progress bar renders instead; when
// the script arrives, the custom element takes over seamlessly.

"use client";

import { useEffect, useRef, useState, type ReactNode } from "react";

// Register sakuga-progress in JSX.IntrinsicElements so TypeScript accepts it.
// The custom element is defined by /sakuga-vfx/progress.js which loads
// when data-theme="sakuga" is active. The declare global block extends
// the React JSX namespace so the tag can be used in JSX without TS errors.
declare module "react" {
  // eslint-disable-next-line @typescript-eslint/no-namespace
  namespace JSX {
    interface IntrinsicElements {
      "sakuga-progress": React.DetailedHTMLProps<
        React.HTMLAttributes<HTMLElement> & {
          label?: string;
          value?: string;
        },
        HTMLElement & {
          set?: (n: number, instant?: boolean) => void;
          reset?: () => void;
          value?: number;
          done?: boolean;
        }
      >;
    }
  }
}

interface Props {
  children: ReactNode;
  /**
   * Bumped when a widget finishes loading. The splash tracks
   * "how many widgets have settled" via a MutationObserver on
   * data-loading attributes (set by WidgetBoundary on error/retry).
   * If no data-loading attributes are present, the splash auto-dismisses
   * after a short timeout as a fallback.
   */
}

export function SakugaLoadingSplash({ children }: Props) {
  const [isSakuga, setIsSakuga] = useState(false);
  const [splashGone, setSplashGone] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);
  const progressRef = useRef<
    HTMLElement & { set?: (n: number, instant?: boolean) => void }
  >(null);

  // Detect sakuga theme on mount. ClientProviders sets data-theme="sakuga"
  // after auth; we poll briefly to catch it.
  useEffect(() => {
    let cancelled = false;
    let tries = 0;
    const check = () => {
      if (cancelled) return;
      if (document.documentElement.dataset.theme === "sakuga") {
        setIsSakuga(true);
        return;
      }
      if (tries++ < 8) setTimeout(check, 250);
    };
    check();
    return () => { cancelled = true; };
  }, []);

  // Drive the progress bar from real DOM widget settlement (MutationObserver
  // watching [data-loading="true"], [aria-busy="true"], and .animate-pulse
  // skeletons) with a 1.2s max cap so it never stalls or double-plays.
  useEffect(() => {
    if (!isSakuga || splashGone) return;

    const start = performance.now();
    let raf = 0;
    let settled = false;
    const MAX_MS = 1200;

    const countPending = () =>
      document.querySelectorAll(
        '[data-loading="true"], [aria-busy="true"], .animate-pulse',
      ).length;

    let peakPending = Math.max(1, countPending());

    const finish = () => {
      if (settled) return;
      settled = true;
      if (progressRef.current?.set) {
        progressRef.current.set(1, true);
      }
      setTimeout(() => setSplashGone(true), 180);
    };

    const observer = new MutationObserver(() => {
      const pending = countPending();
      if (pending > peakPending) peakPending = pending;
      if (pending === 0 && performance.now() - start > 220) {
        finish();
      }
    });
    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["data-loading", "aria-busy", "class"],
    });

    const tick = (now: number) => {
      if (settled) return;
      const elapsed = now - start;
      const pending = countPending();
      if (pending > peakPending) peakPending = pending;
      const domRatio = pending === 0 ? 1 : Math.max(0.15, 1 - pending / peakPending);
      const timeRatio = Math.min(1, elapsed / MAX_MS);
      const pct = Math.min(1, Math.max(domRatio * 0.85, timeRatio));

      if (progressRef.current?.set) {
        progressRef.current.set(pct, true);
      }

      if ((pending === 0 && elapsed > 220) || elapsed >= MAX_MS) {
        finish();
      } else {
        raf = requestAnimationFrame(tick);
      }
    };

    raf = requestAnimationFrame(tick);
    return () => {
      cancelAnimationFrame(raf);
      observer.disconnect();
    };
  }, [isSakuga, splashGone]);

  // Non-sakuga or splash done: render children directly.
  if (!isSakuga || splashGone) {
    return <>{children}</>;
  }

  return (
    <div className="relative" ref={containerRef}>
      {/* Sakuga loading overlay — covers the viewport while widgets load.
          Uses the sakuga CSS vars (set in globals.css [data-theme="sakuga"]).
          Fallback hex values are for the case where the theme hasn't been
          applied yet (race between theme fetch and first paint). */}
      <div
        data-testid="sakuga-loading-splash"
        className="fixed inset-0 z-50 flex flex-col items-center justify-center"
        style={{
          // var() with hex fallback — a bare "--sk-card" is not a valid CSS
          // value; it must be var(--sk-card). Fallbacks cover the race where
          // the theme vars haven't resolved yet on first paint.
          background: "var(--sk-card)",
        }}
      >
        {/* Character scene — a stylised anime-inspired illustration
            using the sakuga palette (ink, pri, acc, soft). */}
        <div
          data-testid="sakuga-character"
          className="relative mb-6 flex h-32 w-32 items-center justify-center"
          aria-hidden="true"
        >
          {/* Soft accent glow */}
          <div
            className="absolute inset-0 rounded-full opacity-25"
            style={{
              background:
                "radial-gradient(circle at 40% 40%, var(--sk-acc) 0%, transparent 70%)",
            }}
          />
          {/* Anime character — ink outlines, pri uniform, acc tie */}
          <svg
            viewBox="0 0 100 100"
            className="relative h-24 w-24"
            aria-hidden="true"
          >
            {/* hair back */}
            <ellipse cx="50" cy="42" rx="26" ry="24" fill="var(--sk-ink)" />
            {/* face */}
            <circle cx="50" cy="44" r="18" fill="var(--sk-card)" />
            {/* hair front */}
            <path
              d="M 32 38 Q 38 24 50 26 Q 62 24 68 38 L 68 46 Q 60 34 50 36 Q 40 34 32 46 Z"
              fill="var(--sk-ink)"
            />
            {/* eyes */}
            <ellipse cx="43" cy="45" rx="3.5" ry="5" fill="var(--sk-ink)" />
            <ellipse cx="57" cy="45" rx="3.5" ry="5" fill="var(--sk-ink)" />
            {/* eye highlights */}
            <circle cx="44.5" cy="43" r="1.2" fill="var(--sk-card)" />
            <circle cx="58.5" cy="43" r="1.2" fill="var(--sk-card)" />
            {/* blush */}
            <ellipse cx="38" cy="50" rx="4" ry="2.5" fill="var(--sk-acc)" opacity="0.4" />
            <ellipse cx="62" cy="50" rx="4" ry="2.5" fill="var(--sk-acc)" opacity="0.4" />
            {/* mouth */}
            <path
              d="M 47 53 Q 50 55 53 53"
              stroke="var(--sk-ink)"
              strokeWidth="1.2"
              fill="none"
            />
            {/* uniform */}
            <rect x="35" y="60" width="30" height="20" rx="6" fill="var(--sk-pri)" />
            {/* collar */}
            <path d="M 42 60 L 50 68 L 58 60 Z" fill="var(--sk-card)" />
            {/* tie */}
            <path d="M 48 68 L 50 76 L 52 68 Z" fill="var(--sk-acc)" />
            {/* sparkles */}
            <g opacity="0.7">
              <path d="M 20 30 L 22 26 L 24 30 L 22 28 Z" fill="var(--sk-acc)" />
              <path d="M 80 35 L 82 31 L 84 35 L 82 33 Z" fill="var(--sk-pri)" />
              <circle cx="16" cy="50" r="2" fill="var(--sk-soft)" />
              <circle cx="84" cy="55" r="2.5" fill="var(--sk-soft)" />
            </g>
          </svg>
        </div>

        {/* Loading copy — sakuga-flavoured */}
        <p
          data-testid="sakuga-loading-copy"
          className="mb-6 text-sm font-semibold"
          style={{
            color: "var(--sk-ink)",
            letterSpacing: "-0.01em",
          }}
        >
          Loading your campus story…
        </p>

        {/* sakuga-progress VFX — storm cloud riding the bar.
            Rendered as a custom element; if progress.js hasn't registered
            it yet, the element is inert and the fallback bar below shows. */}
        <sakuga-progress
          ref={progressRef}
          label="Loading your campus story"
          data-testid="sakuga-progress"
          style={{ display: "block" }}
        />

        {/* Fallback static progress bar — visible while the VFX element
            hasn't registered yet, or as a secondary indicator. */}
        <div
          data-testid="sakuga-progress-fallback"
          className="mt-4 h-2 w-48 overflow-hidden rounded-full"
          style={{ background: "var(--sk-track)" }}
          role="progressbar"
          aria-label="Loading dashboard"
          aria-valuemin={0}
          aria-valuemax={100}
        >
          <div
            className="h-full rounded-full transition-all duration-300"
            style={{
              width: "100%",
              background: "linear-gradient(90deg, var(--sk-pri), var(--sk-acc))",
            }}
          />
        </div>
      </div>

      {/* Dashboard content renders underneath — hidden until splash is gone.
          Using visibility:hidden (not display:none) so the DOM tree stays
          mounted and widgets can start fetching in parallel. */}
      <div className="invisible" aria-hidden="true">
        {children}
      </div>
    </div>
  );
}
</file>

<file path="src/context/GlassContext.tsx">
"use client";

import { createContext, useContext, useState, useEffect, useCallback, ReactNode, useRef, useMemo } from "react";
import { useReducedMotion } from "framer-motion";
import { useUIStore } from "@/stores/uiStore";
import { useAuthStore } from "@/stores/authStore";
import { GateMonitorWS } from "@/lib/websocket";
import { AlertPayload, GateStatusChangePayload } from "@/lib/mockData";
import { useBreakpoint } from "@/hooks/useBreakpoint";
import { usePathname } from "next/navigation";

export type GateStatus = "entry" | "exit" | "idle" | "warning";
export type PerformanceTier = "splusplus" | "performance" | "legacy" | "emergency" | "high" | "medium" | "low";
export type DisplayMode = "indoor" | "outdoor";
export type SecurityMode = "secure" | "elevated" | "critical";

export interface GateCardState {
  id: string;
  gateId: string;
  name: string;
  status: GateStatus;
  location: string;
  lastUpdate: number;
}

export type { AlertPayload };

interface GlassState {
  displayMode: DisplayMode;
  setDisplayMode: (mode: DisplayMode) => void;
  toggleDisplayMode: () => void;
  isLiveStream: boolean;
  setIsLiveStream: (v: boolean) => void;
  toggleLiveStream: () => void;
  isLiveLoading: boolean;
  triggerLiveRefresh: () => void;
  activeGate: string | null;
  setActiveGate: (id: string | null) => void;
  gateTraffic: number;
  setGateTraffic: (level: number) => void;
  isTouchDevice: boolean;
  prefersReducedMotion: boolean;
  setPrefersReducedMotion: (v: boolean) => void;
  performanceTier: PerformanceTier;
  setPerformanceTier: (v: PerformanceTier) => void;
  isLowEndDevice: boolean;
  securityMode: SecurityMode;
  // --- WEBSOCKET REAL-TIME LIVE DATA ---
  gateStatuses: Record<string, GateStatus>;
  setGateStatus: (gateId: string, status: GateStatus) => void;
  wsConnected: boolean;
  wsReconnecting: boolean;
  wsTransportExhausted: boolean;
  wsError: string | null;
  lastAlertGateId: string | null;
  cards: GateCardState[];
  setCards: React.Dispatch<React.SetStateAction<GateCardState[]>>;
  activeAlerts: AlertPayload[];
  dismissAlert: (timestamp: string) => void;
}

const GlassContext = createContext<GlassState | undefined>(undefined);

const INITIAL_CARDS: GateCardState[] = [
  { id: "card-1", gateId: "gate-1", name: "Gate 1 — Main Entrance", status: "idle", location: "South Campus", lastUpdate: Date.now() },
  { id: "card-2", gateId: "gate-2", name: "Gate 2 — Hostel Block", status: "idle", location: "North Hostel", lastUpdate: Date.now() },
  { id: "card-3", gateId: "gate-3", name: "Gate 3 — Academic Block", status: "idle", location: "East Wing", lastUpdate: Date.now() },
  { id: "card-4", gateId: "gate-4", name: "Gate 4 — Service Entry", status: "idle", location: "West Maintenance", lastUpdate: Date.now() },
];

export function GlassProvider({
  children,
}: {
  children: ReactNode;
  initialDark?: boolean;
}) {
  const store = useUIStore();
  const framerReducedMotion = useReducedMotion();
  const [manualReducedMotion, setPrefersReducedMotion] = useState<boolean>(false);
  const prefersReducedMotion = !!framerReducedMotion || manualReducedMotion;

  const [activeGate, setActiveGateState] = useState<string | null>(null);
  const [gateTraffic, setGateTrafficState] = useState(35);
  const [isTouchDevice, setIsTouchDevice] = useState(false);
  const [displayMode, setDisplayModeState] = useState<DisplayMode>("indoor");

  // --- LIVE TELEMETRY & SINE WAVE REFRESH STATE ---
  // Defaults OFF: the "Live" toggle gates useLiveRefresh's 30-second
  // auto-poll. Leaving it on by default made every roster page that wired
  // useLiveRefresh hammer its API endpoint into the rate-limit budget the
  // moment a user opened it — the 429 flood the user was seeing. Pages
  // that genuinely need a live feed can still flip it on via the toggle.
  const [isLiveStream, setIsLiveStream] = useState<boolean>(false);
  const [isLiveLoading, setIsLiveLoading] = useState<boolean>(false);

  const triggerLiveRefresh = useCallback(() => {
    setIsLiveLoading(true);
    setTimeout(() => {
      setIsLiveLoading(false);
    }, 2800);
  }, []);

  const toggleLiveStream = useCallback(() => {
    setIsLiveStream((prev) => {
      const next = !prev;
      if (next) triggerLiveRefresh();
      return next;
    });
  }, [triggerLiveRefresh]);

  const [cards, setCardsState] = useState<GateCardState[]>(INITIAL_CARDS);
  const [wsConnected, setWsConnected] = useState<boolean>(false);
  const [wsReconnecting, setWsReconnecting] = useState<boolean>(false);
  const [wsTransportExhausted, setWsTransportExhausted] = useState<boolean>(false);
  const [wsError, setWsError] = useState<string | null>(null);
  const [activeAlerts, setActiveAlerts] = useState<AlertPayload[]>([]);

  // --- SECURITY POSTURE — derived from live telemetry signals ---
  const ALERT_AUTO_CLEAR_MS = 10000;
  const CRITICAL_ALERT_TYPES = new Set(['LOCKDOWN', 'UNAUTHORIZED_EXIT', 'GATE_OFFLINE']);
  const securityMode: SecurityMode = useMemo(() => {
    const now = Date.now();
    const active = activeAlerts.filter((a) => now - a.timestamp < ALERT_AUTO_CLEAR_MS);

    const hasCritical = active.some(
      (a) => ((a as any).type && CRITICAL_ALERT_TYPES.has((a as any).type)) || a.severity === "critical"
    );
    if (hasCritical) return "critical";

    const hasElevated = active.some((a) => a.severity === "warning" || (a as any).severity === "high");
    if (hasElevated) return "elevated";

    return 'secure';
  }, [activeAlerts]);

  // --- WEBSOCKET REAL-TIME STATE ---
  const [gateStatuses, setGateStatuses] = useState<Record<string, GateStatus>>({
    "gate-1": "idle",
    "gate-2": "entry",
    "gate-3": "exit",
    "gate-4": "idle",
  });
  const [lastAlertGateId, setLastAlertGateId] = useState<string | null>(null);

  const setGateStatus = useCallback((gateId: string, status: GateStatus) => {
    setGateStatuses((prev) => ({ ...prev, [gateId]: status }));
    setCardsState((prev) =>
      prev.map((card) =>
        card.gateId === gateId ? { ...card, status, lastUpdate: Date.now() } : card
      )
    );
  }, []);

  const dismissAlert = useCallback((timestamp: string) => {
    setActiveAlerts((prev) => prev.filter((a) => a.timestamp.toString() !== timestamp));
  }, []);

  // --- WEBSOCKET LIVE FEED SUBSCRIPTION ---
  const wsRef = useRef<GateMonitorWS | null>(null);
  const pathname = usePathname();
  // The /api/gate/stream SSE endpoint is gated to these roles; opening it for
  // any other role 403s on every mount (the 403 storm on non-operator consoles).
  const userRole = useAuthStore((s) => s.role);
  const GATE_STREAM_ROLES = new Set(["admin", "sysadmin", "operator", "supervisor", "oie"]);
  const roleAllowedGateStream = GATE_STREAM_ROLES.has(userRole ?? "");

  // Public / landing routes never need the gate realtime stream. Opening it
  // there would fire an SSE connection (and a console warning) that the page
  // doesn't use. The app shell and operator kiosk still connect as before.
  const PUBLIC_ROUTE = /^\/(login|about|help|support|campus|visitor|profile|security|settings|forbidden|bootstrap)?\/?$/;
  const shouldConnectRealtime =
    !PUBLIC_ROUTE.test(pathname ?? "/") && roleAllowedGateStream;

  useEffect(() => {
    if (!shouldConnectRealtime) return;

    const isMock = process.env.NEXT_PUBLIC_WS_MOCK === "true";
    // No dedicated WS host in this deployment — point the transport at the
    // app origin so the SSE fallback reaches /api/gate/stream (same-origin).
    const defaultUrl =
      typeof window !== "undefined"
        ? `${window.location.protocol === "https:" ? "wss" : "ws"}://${window.location.host}/api/gate/stream`
        : "ws://localhost:3000/api/gate/stream";
    const wsUrl = process.env.NEXT_PUBLIC_WS_URL || defaultUrl;

    if (wsRef.current) {
      wsRef.current.disconnect();
    }
    const ws = new GateMonitorWS(wsUrl, isMock);
    wsRef.current = ws;

    const unsubTraffic = ws.onTrafficUpdate((newTraffic) => {
      setGateTrafficState(newTraffic);
    });

    const unsubStatus = ws.onGateStatusChange((data: GateStatusChangePayload) => {
      setGateStatuses((prev) => ({ ...prev, [data.gateId]: data.status }));
      setCardsState((prev) =>
        prev.map((card) =>
          card.gateId === data.gateId
            ? { ...card, status: data.status, lastUpdate: data.timestamp }
            : card
        )
      );
    });

    const unsubAlert = ws.onAlert((data: AlertPayload) => {
      setLastAlertGateId(data.gateId);
      setActiveAlerts((prev) => {
        const next = [...prev, data];
        if (next.length > 5) next.shift();
        return next;
      });
      // Auto-clear alert after 10 seconds to avoid stale posture triggers
      setTimeout(() => {
        setActiveAlerts((prev) => prev.filter((a) => a.timestamp !== data.timestamp));
      }, 10000);
    });

  const unsubConn = ws.onConnectionChange((connected, isMockFallback, exhausted) => {
      setWsConnected(connected);
      // Perpetual "Reconnecting" was the bug: once both the WebSocket and the
      // SSE fallback are down, stop claiming we're reconnecting — show Offline.
      setWsReconnecting(!connected && !exhausted && !isMock);
      if (exhausted) setWsTransportExhausted(true);
      if (connected) setWsError(null);
      if (isMockFallback || isMock) {
        setIsLiveStream(false);
      }
    });

    ws.connect();

    return () => {
      unsubTraffic();
      unsubStatus();
      unsubAlert();
      unsubConn();
      ws.disconnect();
      if (wsRef.current === ws) {
        wsRef.current = null;
      }
    };
  }, [shouldConnectRealtime, roleAllowedGateStream]);

  // --- RUNTIME FPS DETECTION & REF-THROTTLED TIER ENGINE ---
  const [performanceTier, setPerformanceTierState] = useState<PerformanceTier>("splusplus");
  const performanceTierRef = useRef<PerformanceTier>("splusplus");
  const frameCountRef = useRef(0);
  const lastFpsCheckRef = useRef(typeof performance !== "undefined" ? performance.now() : 0);

  const setPerformanceTier = useCallback((newTier: PerformanceTier) => {
    if (performanceTierRef.current !== newTier) {
      performanceTierRef.current = newTier;
      setPerformanceTierState(newTier);
    }
  }, []);

  useEffect(() => {
    if (typeof window === "undefined") return;
    const savedMode = localStorage.getItem("gate-monitor-display-mode") as DisplayMode | null;
    if (savedMode === "outdoor" || savedMode === "indoor") {
      setDisplayModeState(savedMode);
      document.documentElement.setAttribute("data-display-mode", savedMode);
    }
  }, []);

  const setDisplayMode = useCallback((mode: DisplayMode) => {
    setDisplayModeState(mode);
    if (typeof window !== "undefined") {
      localStorage.setItem("gate-monitor-display-mode", mode);
      document.documentElement.setAttribute("data-display-mode", mode);
    }
  }, []);

  const toggleDisplayMode = useCallback(() => {
    setDisplayMode(displayMode === "indoor" ? "outdoor" : "indoor");
  }, [displayMode, setDisplayMode]);

  const setActiveGate = useCallback((id: string | null) => {
    setActiveGateState(id);
  }, []);

  const setGateTraffic = useCallback((level: number) => {
    setGateTrafficState(level);
  }, []);

  const setCards = useCallback<React.Dispatch<React.SetStateAction<GateCardState[]>>>((action) => {
    setCardsState(action);
  }, []);

  // Mobile-first performance detection: Force legacy tier and outdoor display mode on mobile devices
  // Uses useBreakpoint instead of raw window.innerWidth for SSR safety
  const breakpoints = useBreakpoint({ sm: '(min-width: 640px)', md: '(min-width: 768px)' });
  const isMobileViewport = !breakpoints.md;

  useEffect(() => {
    if (typeof window === "undefined") return;
    const isTouch = window.matchMedia("(pointer: coarse)").matches;
    const isMobile = isMobileViewport && isTouch;
    if (isMobile) {
      setPerformanceTier("legacy");
      setDisplayModeState("outdoor");
      document.documentElement.setAttribute("data-display-mode", "outdoor");
    }
  }, [setPerformanceTier, isMobileViewport]);

  useEffect(() => {
    if (typeof window === "undefined") return;
    const isTouch = window.matchMedia("(pointer: coarse)").matches;
    // Use pre-computed isMobileViewport instead of raw window.innerWidth
    const isMobile = isMobileViewport && isTouch;
    if (isMobile) {
      setPerformanceTier("legacy");
      return;
    }
    if (prefersReducedMotion) {
      setPerformanceTier("emergency");
      return;
    }

    let animationFrameId: number;
    let stableCount = 0;




































    const measureFps = () => {
      if (document.visibilityState === "hidden") return;

      frameCountRef.current += 1;
      const now = performance.now();
      const delta = now - lastFpsCheckRef.current;

      // Sample every 2000ms (2 seconds) to avoid micro-jitter state updates
      if (delta >= 2000) {
        const fps = Math.round((frameCountRef.current * 1000) / delta);
        const targetTier: PerformanceTier =
          fps >= 55 ? "splusplus" : fps >= 30 ? "performance" : fps >= 15 ? "legacy" : "emergency";

        if (performanceTierRef.current === targetTier) {
          stableCount++;
        } else {
          stableCount = 0;
          performanceTierRef.current = targetTier;
          setPerformanceTierState(targetTier);
        }

        frameCountRef.current = 0;
        lastFpsCheckRef.current = now;

        // Stop after 5 stable samples (~10s) to conserve battery
        if (stableCount >= 5) {
          cancelAnimationFrame(animationFrameId);
          return;
        }
      }

      animationFrameId = requestAnimationFrame(measureFps);
    };

    animationFrameId = requestAnimationFrame(measureFps);

    const onVisibilityChange = () => {
      if (document.visibilityState === "hidden") {
        cancelAnimationFrame(animationFrameId);
      } else {
        stableCount = 0;
        frameCountRef.current = 0;
        lastFpsCheckRef.current = performance.now();
        animationFrameId = requestAnimationFrame(measureFps);
      }
    };

    document.addEventListener("visibilitychange", onVisibilityChange);

    return () => {
      if (animationFrameId) cancelAnimationFrame(animationFrameId);
      document.removeEventListener("visibilitychange", onVisibilityChange);
    };
  }, [prefersReducedMotion, setPerformanceTier]);

  useEffect(() => {
    if (typeof window !== "undefined") {
      setIsTouchDevice(window.matchMedia("(pointer: coarse)").matches);
    }
  }, []);

  const isLowEndDevice = performanceTier === "legacy" || performanceTier === "emergency" || performanceTier === "low";

  // The context value is a plain object literal, which means it is a NEW
  // reference on every GlassProvider render. GlassProvider re-renders on
  // EVERY uiStore tick (toasts, theme, sidebar) because it subscribes to the
  // whole store (useUIStore()). Without memoising, every one of the ~25
  // useGlass() consumers re-renders on any of those ticks — and on a theme
  // toggle that is a full-app re-render, which is the "freeze on theme
  // change" symptom. Memoise on the exact set of values the object exposes.
  const contextValue: GlassState = useMemo(
    () => ({
      displayMode,
      setDisplayMode,
      toggleDisplayMode,
      isLiveStream,
      setIsLiveStream,
      toggleLiveStream,
      isLiveLoading,
      triggerLiveRefresh,
      activeGate,
      setActiveGate,
      gateTraffic,
      setGateTraffic,
      isTouchDevice,
      prefersReducedMotion,
      setPrefersReducedMotion,
      performanceTier,
      setPerformanceTier,
      isLowEndDevice,
      securityMode,
      gateStatuses,
      setGateStatus,
      wsConnected,
      wsReconnecting,
      wsTransportExhausted,
      wsError,
      lastAlertGateId,
      cards,
      setCards,
      activeAlerts,
      dismissAlert,
    }),
    [
      displayMode,
      setDisplayMode,
      toggleDisplayMode,
      isLiveStream,
      triggerLiveRefresh,
      isLiveLoading,
      activeGate,
      gateTraffic,
      isTouchDevice,
      prefersReducedMotion,
      performanceTier,
      isLowEndDevice,
      securityMode,
      gateStatuses,
      setGateStatus,
      wsConnected,
      wsReconnecting,
      wsTransportExhausted,
      wsError,
      lastAlertGateId,
      cards,
      activeAlerts,
      dismissAlert,
      // setDisplayMode / toggleDisplayMode / setIsLiveStream / toggleLiveStream
      // / setActiveGate / setGateTraffic / setPrefersReducedMotion /
      // All exposed setters (setDisplayMode, toggleDisplayMode, setActiveGate,
      // setGateTraffic, setCards) are now useCallback-wrapped so they are
      // stable across provider renders, which keeps the context value memo
      // from re-computing on every parent render.
    ],
  );

  return (
    <GlassContext.Provider value={contextValue}>
      {children}
    </GlassContext.Provider>
  );
}

export const useGlass = () => {
  const context = useContext(GlassContext);
  if (!context) {
    throw new Error("useGlass must be used within a GlassProvider");
  }
  return context;
};
</file>

