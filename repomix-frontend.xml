                <div>
                  <label className="block text-xs font-semibold text-text-muted uppercase mb-1">
                    Department Name
                  </label>
                  <input
                    type="text"
                    required
                    value={editingDept.name || ""}
                    onChange={(e) => setEditingDept({ ...editingDept, name: e.target.value })}
                    placeholder="e.g. Computer Science & Engineering"
                    className="surface-card w-full px-3 py-2 bg-bg-elevated text-sm text-text-primary focus:outline-none focus:"
                  />
                </div>

                <div>
                  <label className="block text-xs font-semibold text-text-muted uppercase mb-1">
                    Head of Department
                  </label>
                  <div className="mt-1">
                    <HodIdInput
                      value={editingDept.hodIdInput || ""}
                      onChange={(v) => setEditingDept({ ...editingDept!, hodIdInput: v })}
                      onResolved={(id) => setEditingDept({ ...editingDept!, hodUserId: id })}
                    />
                  </div>
                  <p className="mt-1 text-xs text-text-muted">
                    Enter any official identifier: student roll · employee ID · unique ID · email.
                  </p>
                </div>

                <div className="surface-card flex justify-end gap-2 pt-4">
                  <button
                    type="button"
                    onClick={() => setEditingDept(null)}
                    className="surface-card px-4 py-2 bg-bg-elevated text-text-muted text-xs font-semibold hover:bg-bg-elevated transition"
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    disabled={!editingDept.code || !editingDept.name || !editingDept.hodUserId}
                    className="surface-card px-4 py-2 bg-action-success text-white text-xs font-semibold hover:bg-action-success transition disabled:opacity-50 disabled:pointer-events-none"
                  >
                    Save Department
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}

        <ConfirmDialog
          open={!!deptToDelete}
          onClose={() => setDeptToDelete(null)}
          title="Delete department?"
          body={`Delete department "${deptToDelete ?? ""}"? This is audited.`}
          confirmText="Delete"
          variant="destructive"
          onConfirm={confirmDelete}
        />
      </div>
    </AuthGuard>
  );
}
