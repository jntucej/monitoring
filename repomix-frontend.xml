"use client";

import { Suspense, useState } from "react";
import Link from "next/link";
import { PageLoading } from "@/components/shared/LoadingStates";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { EmptyState } from "@/components/shared/EmptyState";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useApiResource } from "@/hooks/useApiResource";
import { GraduationCap, ArrowRight } from "lucide-react";

/* /api/faculty/my-classes response */
interface MyClassRow {
  id: string;
  departmentId: string;
  year: number;
  section: string;
  name: string | null;
  capacity: number | null;
  subjectCodes?: string[];
}
interface MyClassesResponse {
  success: boolean;
  data: MyClassRow[];
}

function FacultyClassIndexInner() {
  const [role, setRole] = useState<"class_teacher" | "all">("class_teacher");

  const {
    data,
    loading,
    error,
  } = useApiResource<MyClassesResponse>(
    `/api/faculty/my-classes?role=${role === "all" ? "all" : "class_teacher"}`,
    { ttlMs: 30_000 },
  );

  const classes = data?.data ?? [];

  if (error) {
    return <EmptyState title="Could not load classes" description={String(error)} />;
  }

  if (loading && !data) {
    return <PageLoading />;
  }

  if (classes.length === 0) {
    return (
      <EmptyState
        title="No classes assigned"
        description="You have no classes assigned yet. Check back later or contact your department head."
      />
    );
  }

  return (
    <div className="space-y-3 p-2 min-w-0">
      <ContextSituationBar
        roleLabel="Faculty · Classes"
        purpose="Navigate assigned class sections and view capacity and subject associations."
        why="Selecting a specific section lets you inspect enrolled students, subject timetables, and section statistics."
        contextLabel={role === "class_teacher" ? "Taught Classes" : "All Assigned Classes"}
        statusTone="info"
        statusPill={`${classes.length} classes`}
