<file path="src/app/(admin)/admin/students/import/page.tsx">
"use client";

import { useState } from "react";
import { Upload, FileSpreadsheet, Download, Loader2, ShieldAlert } from "lucide-react";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { CsvValidationPreview, type CsvValidationPreviewProps } from "@/components/admin/CsvValidationPreview";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";


/**
 * Admin → Students → Bulk Import.
 *
 * CSV student provisioning via the two-phase `/api/users/bulk/*` flow:
 * validate (dry-run, no writes) → preview → commit (with skip-errors).
 * Existing-roll rows are classified "skipped" by the backend, so bulk
 * import never overwrites an existing student (roll immutability).
 */

const STUDENT_TEMPLATE = `NAME OF THE STUDENT,EMAIL ID,role,H.T NO.,COURSE,FATHER NAME,DOB,PHONE NUMBER,GENDER
Arjun Kumar,arjun.kumar@college.edu,student,24JJ1A0501,CSE,M Raj Kumar,2006-02-14,+919****3211,Male
Meera Nair,meera.nair@college.edu,student,24JJ2B0774,BIOE,M S Nair,2005-11-02,+919****8821,Female`;

export default function AdminStudentsImportPage() {

  const [csvText, setCsvText] = useState("");
  const [validating, setValidating] = useState(false);
  const [committing, setCommitting] = useState(false);
  const [validationResult, setValidationResult] = useState<unknown>(null);
  const [commitResult, setCommitResult] = useState<unknown>(null);
  const [skipErrors, setSkipErrors] = useState(true);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);

  const headers = getAuthHeaders();

  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setErrorMsg(null);
    setValidationResult(null);
    setCommitResult(null);
    const reader = new FileReader();
    reader.onload = (ev) => setCsvText((ev.target?.result as string) || "");
    reader.readAsText(file);
    e.target.value = "";
  };

  const handleDownloadTemplate = () => {
    const blob = new Blob([STUDENT_TEMPLATE], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.setAttribute("download", "students_template.csv");
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const handleValidate = async () => {
    if (!csvText.trim()) return setErrorMsg("Paste or upload a CSV first.");
    setValidating(true);
    setErrorMsg(null);
    setValidationResult(null);
    setCommitResult(null);
    try {
      const res = await fetch("/api/users/bulk/validate", {
        method: "POST",
        headers: { ...headers, "Content-Type": "application/json" },
        body: JSON.stringify({ csvText }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) setErrorMsg(json.error?.message || "Validation failed.");
      else setValidationResult(json.data);
    } catch (err) {
      setErrorMsg(err instanceof Error ? err.message : "Network error.");
    } finally {
      setValidating(false);
    }
  };

  const handleCommit = async () => {
    if (!csvText.trim()) return;
    setCommitting(true);
    setErrorMsg(null);
    try {
      const res = await fetch("/api/users/bulk/commit", {
        method: "POST",
        headers: { ...headers, "Content-Type": "application/json" },
        body: JSON.stringify({ csvText, skipErrors }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) setErrorMsg(json.error?.message || "Import failed.");
      else {
        setCommitResult(json.data);
        setValidationResult(null);
        setCsvText("");
      }
    } catch (err) {
      setErrorMsg(err instanceof Error ? err.message : "Network error.");
    } finally {
      setCommitting(false);
    }
  };

  return (
      <div className="max-w-5xl mx-auto p-4 sm:p-4 sm:p-4 sm:p-6 space-y-4 sm:space-y-4 sm:space-y-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="CSV provisioning with two-phase validation. The role column is read from the CSV; existing students are skipped, never overwritten."
        why="Review flagged rows before committing — duplicate roll numbers will block the import."
        contextLabel="CSV provisioning with two-phase validation. The role column is read from the CSV; existing students are skipped, never overwritten."
        statusSummary="Review current csv provisioning with two-phase validation. the role column is read from the csv; existing students are skipped, never overwritten. state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
        <PageHeader
          title="Student Bulk Import"
          subtitle="CSV provisioning with two-phase validation. The role column is read from the CSV; existing students are skipped, never overwritten."
        />
        <WidgetBoundary title="Student Bulk Import">
          <div className="space-y-4">
            <div className="surface-card flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4">
              <div>
                <h3 className="text-base font-semibold">CSV Student Provisioning</h3>
                <p className="text-xs text-text-muted mt-0.5">
                  Dry-run first, review the preview, then commit. Rows whose roll already exists are marked
                  skipped.
                </p>
              </div>
              <button
                onClick={handleDownloadTemplate}
                className="surface-card flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium hover:bg-bg-elevated"
              >
                <Download className="w-3.5 h-3.5 text-text-muted" />
                Student template
              </button>
            </div>

            {errorMsg && (
              <div className="surface-card flex items-start gap-2.5 p-3 bg-[color-mix(in_srgb,var(--action-danger)_12%,transparent)] text-xs text-action-danger">
                <ShieldAlert className="w-4 h-4 shrink-0 mt-0.5" />
                <span>{errorMsg}</span>
              </div>
            )}

            <div className="surface-card p-4 sm:p-5 space-y-4">
              <div className="flex items-center justify-between">
                <label className="text-xs font-semibold text-text-muted uppercase tracking-wider">
                  CSV input
                </label>
                <label className="surface-card flex items-center gap-1.5 px-3 py-1.5 text-xs bg-[color-mix(in_srgb,var(--action-primary)_12%,transparent)] text-action-primary font-medium cursor-pointer">
                  <Upload className="w-3.5 h-3.5" />
                  Upload .csv
                  <input
                    type="file"
                    accept=".csv,text/csv"
                    onChange={handleFileUpload}
                    className="hidden"
                  />
                </label>
              </div>

              <textarea
                rows={4}
                value={csvText}
                onChange={(e) => {
                  setCsvText(e.target.value);
                  setValidationResult(null);
                  setCommitResult(null);
                }}
                placeholder="Paste student CSV, or upload a .csv file"
                className="surface-card w-full font-mono text-xs p-3 bg-[var(--bg-sunken)] text-text-primary focus:outline-none focus:ring-1 focus:ring-action-primary"
              />

              <div className="flex items-center justify-between pt-1">
                <span className="text-xs text-text-muted">
                  Pin the role column to <code className="text-action-primary">student</code> in the CSV.
                </span>
                <button
                  onClick={handleValidate}
                  disabled={validating || !csvText.trim()}
                  className="surface-card flex items-center gap-2 px-4 py-2 text-xs font-semibold bg-action-primary text-white hover:opacity-90 disabled:opacity-50"
                >
                  {validating ? (
                    <Loader2 className="w-3.5 h-3.5 animate-spin" />
                  ) : (
                    <FileSpreadsheet className="w-3.5 h-3.5" />
                  )}
                  Validate &amp; preview
                </button>
              </div>
            </div>

            <CsvValidationPreview
              validationResult={validationResult as CsvValidationPreviewProps['validationResult']}
              commitResult={commitResult as CsvValidationPreviewProps['commitResult']}
              committing={committing}
              skipErrors={skipErrors}
              setSkipErrors={setSkipErrors}
              onCommit={handleCommit}
            />
          </div>
        </WidgetBoundary>
      </div>

  );
}
</file>

<file path="src/app/(admin)/admin/students/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { usePersistentQuery } from "@/hooks/usePersistentQuery";
import {Search, X, Home, Building2, ChevronRight, Mail, Phone, AlertTriangle, RotateCw}  from "lucide-react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { Skeleton } from "@/components/ui/skeleton";
import {
  MiniSparkline, MiniStackedBar, MiniCountPills,
} from "@/components/admin/kit";
import { EntityInspector, KVPairs, InspectorButton } from "@/components/shared/EntityInspector";
import { HoverPreview, MetricPreview } from "@/components/shared/HoverPreview";
import { EmptyState } from "@/components/shared/EmptyState";
import { DataFreshness } from "@/components/shared/DataFreshness";
import { getAuthHeaders } from "@/lib/utils";
import { usePolling } from "@/hooks/usePolling";
import { parseRollNumber } from "@/lib/rollNumber";
import type { Person, StudentDetails } from "@/lib/types";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

/**
 * Admin Students — faceted student directory.
 *
 * Re-skin of the old `StudentInfographics + UserManagementPanel` stack. One
 * live source of truth: the `/api/students` roster (admin-scoped full list).
 * KPIs + facet counts are derived client-side from the rows so the page
 * renders even when the roster is partial. Glass chrome + Mini* kit.
 */

interface StudentRow {
  id: string;
  name: string;
  email: string | null;
  phone: string | null;
  roll: string | null;
  department: string | null;
  course: string | null;
  year: number | null;
  section: string | null;
  status: string;
  isHosteller: boolean;
  hostelBlock: string | null;
  roomNumber: string | null;
}

interface StudentsData {
  total: number;
  active: number;
  suspended: number;
  onCampusToday: number;
  todayEntries: number;
  todayExits: number;
  rows: StudentRow[];
  byDepartment: Array<{ code: string; name: string; count: number }>;
  byYear: Array<{ year: string; count: number }>;
  byType: Array<{ type: string; label: string; count: number }>;
  byGender: Array<{ gender: string; count: number }>;
}

const DEPT_COLORS: Record<string, string> = {
  CSE: "var(--action-primary)",
  IT: "var(--action-info)",
  ECE: "var(--action-success)",
  EEE: "var(--action-warning)",
  MECH: "var(--action-danger)",
};

function deptColor(code: string | null | undefined) {
  if (!code) return "var(--text-muted)";
  return DEPT_COLORS[code.toUpperCase()] ?? "var(--action-primary)";
}

function initials(name: string) {
  return name
    .split(/\s+/)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? "")
    .join("");
}

async function fetchStudents(): Promise<StudentsData> {
  const res = await fetch("/api/students", { headers: getAuthHeaders() });
  if (!res.ok) throw new Error(`students → ${res.status}`);
  const body = await res.json();
  const arr = (body?.data ?? body ?? []) as Person[];

  const rows: StudentRow[] = arr.map((p) => {
    const sd: Partial<StudentDetails> = p.studentDetails ?? {};
    const roll = (p.roll ?? p.uniqueId ?? sd.roll ?? "").toString();
    const decoded = roll ? parseRollNumber(roll) : null;
    return {
      id: p.id,
      name: p.fullName ?? p.name ?? "",
      email: p.email ?? null,
      phone: p.phone ?? null,
      roll: roll || null,
      department:
        decoded?.department ?? p.department ?? sd.department ?? null,
      course:
        decoded?.entryMode
          ? decoded.entryMode.startsWith("M.Tech") || decoded.entryMode.startsWith("PG")
            ? "M.Tech"
            : "B.Tech"
          : (p.course ?? sd.course ?? null),
      year: p.year ?? sd.year ?? null,
      section: p.section ?? sd.section ?? null,
      status: p.status ?? "ACTIVE",
      isHosteller: !!sd.hostelBlock,
      hostelBlock: (sd.hostelBlock ?? p.hostelBlock ?? null) as string | null,
      roomNumber: (sd.roomNumber ?? p.roomNumber ?? null) as string | null,
    };
  });

  // Facets computed from the live rows.
  const byDeptMap = new Map<string, number>();
  const byYearMap = new Map<string, number>();
  const genderMap = new Map<string, number>();
  let active = 0;
  let suspended = 0;
  let hostellers = 0;
  for (const [i, r] of rows.entries()) {
    if (r.department) byDeptMap.set(r.department, (byDeptMap.get(r.department) ?? 0) + 1);
    if (r.year) byYearMap.set(String(r.year), (byYearMap.get(String(r.year)) ?? 0) + 1);
    if (r.status === "ACTIVE") active += 1;
    if (r.status === "SUSPENDED" || r.status === "LOCKED") suspended += 1;
    if (r.isHosteller) hostellers += 1;
    const g = arr[i]?.studentDetails?.gender;
    if (g) genderMap.set(g, (genderMap.get(g) ?? 0) + 1);
  }

  const now = new Date();
  const todayKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
  const isToday = (iso: string | null | undefined) =>
    typeof iso === "string" && iso.slice(0, 10) === todayKey;
  const onCampusToday = arr.filter(
    (p: any) => p.checkedInAt && !p.checkedOutAt).length;
  const todayEntries = arr.filter((p: any) => isToday(p.checkedInAt)).length;
  const todayExits   = arr.filter((p: any) => isToday(p.checkedOutAt)).length;

  return {
    total: rows.length,
    active,
    suspended,
    onCampusToday,
    todayEntries,
    todayExits,
    rows,
    byDepartment: Array.from(byDeptMap.entries())
      .map(([code, count]) => ({ code, name: code, count }))
      .sort((a, b) => b.count - a.count),
    byYear: Array.from(byYearMap.entries())
      .map(([year, count]) => ({ year, count }))
      .sort((a, b) => a.year.localeCompare(b.year)),
    byType: [
      { type: "hosteller", label: "Hostellers", count: hostellers },
      { type: "day_scholar", label: "Day scholars", count: rows.length - hostellers },
    ],
    byGender: Array.from(genderMap.entries()).map(([gender, count]) => ({
      gender,
      count,
    })),
  };
}

function AdminStudentsInner() {
  const [data, setData] = useState<StudentsData | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [lastFetched, setLastFetched] = useState<number | null>(null);
  const [query, setQuery] = usePersistentQuery("gate-admin-students-query");
  const [deptFilter, setDeptFilter] = useState<string[]>([]);
  const [yearFilter, setYearFilter] = useState<string[]>([]);
  const [typeFilter, setTypeFilter] = useState<"all" | "hosteller" | "day_scholar">("all");
  const [active, setActive] = useState<StudentRow | null>(null);

  /** The standardized inspection model for a student row (overview → hostel → actions). */
  const studentInspection = active
    ? {
        kind: "student",
        title: active.name,
        subtitle: active.roll ?? active.id,
        status: (
          <span
            className={`text-[10px] font-bold uppercase px-1.5 py-0.5 rounded ${
              active.status === "ACTIVE"
                ? "bg-emerald-500/15 text-action-success"
                : "bg-rose-500/15 text-action-danger"
            }`}
          >
            {active.status}
          </span>
        ),
        sections: [
          {
            title: "Overview",
            content: (
              <KVPairs
                items={[
                  { label: "Department", value: active.department ?? "—" },
                  { label: "Course", value: active.course ?? "—" },
                  { label: "Year", value: String(active.year ?? "—") },
                  { label: "Section", value: active.section ?? "—" },
                  {
                    label: "Type",
                    value: active.isHosteller ? "Hosteller" : "Day scholar",
                  },
                  ...(active.email
                    ? [{ label: "Email", value: <span className="flex items-center gap-1"><Mail className="size-4" />{active.email}</span> }]
                    : []),
                  ...(active.phone
                    ? [{ label: "Phone", value: <span className="flex items-center gap-1"><Phone className="size-4" />{active.phone}</span> }]
                    : []),
                ]}
              />
            ),
          },
          ...(active.hostelBlock
            ? [{
                title: "Hostel",
                content: (
                  <KVPairs
                    columns={1}
                    items={[
                      { label: "Block", value: active.hostelBlock },
                      { label: "Room", value: active.roomNumber ?? "—" },
                    ]}
                  />
                ),
              }]
            : []),
          {
            title: "Actions",
            content: (
              <div className="flex flex-wrap gap-2">
                <InspectorButton
                  href={`/admin/students/${active.roll ?? active.id}`}
                  variant="primary"
                >
                  <ChevronRight className="size-3.5" /> Full profile
                </InspectorButton>
                <InspectorButton
                  href={`/admin/students/${active.roll ?? active.id}`}
                  variant="ghost"
                >
                  Movement history
                </InspectorButton>
              </div>
            ),
          },
        ],
        detailHref: `/admin/students/${active.roll ?? active.id}`,
        detailLabel: "View full profile",
      }
    : null;

  const load = useCallback(async () => {
    try {
      const result = await fetchStudents();
      setData(result);
      setError(null);
      setLastFetched(Date.now());
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load students");
    }
  }, []);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);
  usePolling(load, { intervalMs: 60_000 });

  const filtered = useMemo(() => {
    if (!data) return [];
    const q = query.trim().toLowerCase();
    return data.rows.filter((r) => {
      if (deptFilter.length && r.department && !deptFilter.includes(r.department)) return false;
      if (yearFilter.length && r.year && !yearFilter.includes(String(r.year))) return false;
      if (typeFilter === "hosteller" && !r.isHosteller) return false;
      if (typeFilter === "day_scholar" && r.isHosteller) return false;
      if (q && !`${r.name} ${r.roll ?? ""} ${r.email ?? ""}`.toLowerCase().includes(q))
        return false;
      return true;
    });
  }, [data, query, deptFilter, yearFilter, typeFilter]);

  const toggleIn = (arr: string[], v: string, set: (n: string[]) => void) => {
    set(arr.includes(v) ? arr.filter((x) => x !== v) : [...arr, v]);
  };

  if (!data && !error) {
    return (
      <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-4 py-4 md:py-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Full student roster with department, year, and hostel state"
        why="Edit fields here with care — attendance % and pass eligibility update live for that student."
        contextLabel="Full student roster with department, year, and hostel state"
        statusSummary="Review current full student roster with department, year, and hostel state state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
        <Skeleton className="h-10 w-64" />
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {Array.from({ length: 4 }).map((_, i) => (
            <Skeleton key={i} className="h-24 rounded-card" />
          ))}
        </div>
        <Skeleton className="h-72 rounded-card" />
      </div>
    );
  }





  const typeSegments = (data?.byType ?? []).map((t) => ({
    value: t.count,
    color: t.type === "hosteller" ? "var(--action-primary)" : "var(--action-info)",
  }));

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-4 md:py-6">
      <PageHeader
        title="Students"
        subtitle="Full student roster with department, year, and hostel state"
        onRefresh={load}
      />

      {error && (
        <div className="surface-card bg-rose-500/5 p-3 text-sm" role="alert">
          <div className="flex items-start gap-3">
            <AlertTriangle className="size-4 text-action-danger shrink-0 mt-0.5" />
            <div className="flex-1">
              <p className="font-medium text-text-primary">Roster unavailable</p>
              <p className="text-xs text-text-muted mt-0.5">{error}</p>
            </div>
            <button
              onClick={() => { void load(); }}
              className="inline-flex items-center gap-1.5 rounded-lg border border-border bg-bg-surface px-2.5 py-1.5 text-xs font-medium text-text-primary hover:bg-bg-elevated"
            >
              <RotateCw className="size-3.5" /> Retry
            </button>
          </div>
        </div>
      )}

      {/* KPI row — each card is a hover-preview entry point (the quick
          overview layer of the inspection hierarchy). */}
      {error && !data ? null : (
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <HoverPreview
          preview={
            <MetricPreview
              label="Total students"
              value={data?.total ?? 0}
              hint="Full roster across all departments and years"
            />
          }
        >
          <div className="surface-card p-4 h-full cursor-help">
            <p className="text-xs text-text-muted">Total students</p>
            <p className="text-2xl font-bold text-text-primary tabular-nums">
              {data?.total ?? 0}
            </p>
            {data && <MiniSparkline
              label=""
              values={[data.total * 0.85, data.total * 0.9, data.total * 0.88, data.total * 0.95, data.total]}
              width={140}
              height={24}
            />}
          </div>
        </HoverPreview>
        <HoverPreview
          preview={
            <MetricPreview
              label="By state"
              value={`${data?.active ?? 0} active · ${data?.suspended ?? 0} suspended`}
              hint="Suspended or locked students need a principal decision"
            />
          }
        >
          <div className="surface-card p-4 h-full cursor-help">
            <p className="text-xs text-text-muted">Active</p>
            <p className="text-2xl font-bold text-action-primary tabular-nums">
              {data?.active ?? 0}
            </p>
            <MiniCountPills
              label="by state"
              counts={[data?.active ?? 0, data?.suspended ?? 0]}
            />
          </div>
        </HoverPreview>
        <HoverPreview
          preview={
            <MetricPreview
              label="On campus today"
              value={data?.onCampusToday ?? 0}
              hint={`${data?.todayEntries ?? 0} entries · ${data?.todayExits ?? 0} exits so far today`}
            />
          }
        >
          <div className="surface-card p-4 h-full cursor-help">
            <p className="text-xs text-text-muted">On campus today</p>
            <p className="text-2xl font-bold text-action-info tabular-nums">
              {data?.onCampusToday ?? 0}
            </p>
            <p className="text-xs text-text-muted">
              {data?.todayEntries ?? 0} in · {data?.todayExits ?? 0} out
            </p>
          </div>
        </HoverPreview>
        <HoverPreview
          preview={
            <MetricPreview
              label="Hostellers"
              value={data?.byType.find((t) => t.type === "hosteller")?.count ?? 0}
              hint="Students with a hostel block assigned — curfew applies"
            />
          }
        >
          <div className="surface-card p-4 h-full cursor-help">
            <p className="text-xs text-text-muted">Hostellers</p>
            <p className="text-2xl font-bold text-unit-c tabular-nums">
              {data?.byType.find((t) => t.type === "hosteller")?.count ?? 0}
            </p>
            <MiniStackedBar label="by type" segments={typeSegments} />
          </div>
        </HoverPreview>
      </div>
      )}

      {lastFetched !== null && !error && (
        <div className="flex justify-end">
          <DataFreshness timestamp={lastFetched} autoRefresh />
        </div>
      )}

      {data && data.total === 0 && !error ? (
        <EmptyState
          title="No students in roster"
          description="The roster is empty. Add students from the import flow, or check that the admin scope has at least one enrolled record."
          action={
            <button
              onClick={() => { void load(); }}
              className="inline-flex items-center gap-1.5 rounded-lg border border-border bg-bg-surface px-3 py-2 text-xs font-medium text-text-primary hover:bg-bg-elevated"
            >
              <RotateCw className="size-3.5" /> Reload roster
            </button>
          }
        />
      ) : null}

      <div className="grid grid-cols-1 lg:grid-cols-4 gap-4 section-offscreen">
        {/* Facet rail */}
        <WidgetBoundary title="Filters">
          <aside className="surface-card p-4 space-y-4 lg:sticky lg:top-4 self-start">
            <div>
              <h3 className="text-xs font-semibold uppercase tracking-wide text-text-muted mb-2">
                Department
              </h3>
              <div className="flex flex-wrap gap-1.5">
                {(data?.byDepartment ?? []).map((d) => (
                  <button
                    key={d.code}
                    onClick={() => toggleIn(deptFilter, d.code, setDeptFilter)}
                    className={`text-xs px-2 py-1 transition ${
                      deptFilter.includes(d.code)
                        ? "bg-bg-elevated text-white"
                        : "text-text-primary"
                    }`}
                    style={deptFilter.includes(d.code) ? { background: deptColor(d.code) } : undefined}
                  >
                    {d.code} <span className="opacity-70">{d.count}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <h3 className="text-xs font-semibold uppercase tracking-wide text-text-muted mb-2">
                Year
              </h3>
              <div className="flex flex-wrap gap-1.5">
                {(data?.byYear ?? []).map((y) => (
                  <button
                    key={y.year}
                    onClick={() => toggleIn(yearFilter, y.year, setYearFilter)}
                    className={`text-xs px-2 py-1 transition ${
                      yearFilter.includes(y.year)
                        ? "bg-action-primary/10 text-action-primary"
                        : "text-text-primary"
                    }`}
                  >
                    Year {y.year} <span className="opacity-70">{y.count}</span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <h3 className="text-xs font-semibold uppercase tracking-wide text-text-muted mb-2">
                Type
              </h3>
              <div className="flex flex-wrap gap-1.5">
                {(["all", "hosteller", "day_scholar"] as const).map((t) => (
                  <button
                    key={t}
                    onClick={() => setTypeFilter(t)}
                    className={`text-xs px-2 py-1 transition ${
                      typeFilter === t
                        ? "bg-action-primary/10 text-action-primary"
                        : "text-text-primary"
                    }`}
                  >
                    {t === "all" ? "All" : t === "hosteller" ? "Hostellers" : "Day scholars"}
                  </button>
                ))}
              </div>
            </div>

            {(deptFilter.length || yearFilter.length || typeFilter !== "all" || query) && (
              <button
                onClick={() => {
                  setDeptFilter([]);
                  setYearFilter([]);
                  setTypeFilter("all");
                  setQuery("");
                }}
                className="text-xs text-action-primary hover:underline flex items-center gap-1"
              >
                <X className="size-3.5" /> Clear filters
              </button>
            )}
          </aside>
        </WidgetBoundary>

        {/* Table */}
        <div className="lg:col-span-3 space-y-3">
          <div className="relative">
            <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" />
            <input
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search by name, roll, or email…"
              className="surface-card w-full min-h-11 pl-9 pr-3 bg-bg-surface/40 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-action-primary/40"
            />
          </div>

          <div className="glass-card overflow-hidden">
            <div className="overflow-x-auto">
              <table className="w-full text-sm min-w160">
                <thead className="bg-bg-surface/60 text-text-muted text-xs uppercase tracking-wide">
                  <tr>
                    <th className="text-left px-4 py-2.5 font-medium">Student</th>
                    <th className="text-left px-4 py-2.5 font-medium">Department</th>
                    <th className="text-left px-4 py-2.5 font-medium">Year</th>
                    <th className="text-left px-4 py-2.5 font-medium">Type</th>
                    <th className="text-left px-4 py-2.5 font-medium">Room</th>
                    <th />
                  </tr>
                </thead>
                <tbody>
                  {filtered.length === 0 && (
                    <tr>
                      <td colSpan={6} className="px-4 py-10 text-center text-text-muted">
                        No students match this view
                      </td>
                    </tr>
                  )}
                  {filtered.map((r) => (
                    <tr
                      key={r.id}
                      onClick={() => setActive(r)}
                      className="border-t border-border hover:bg-bg-surface/40 cursor-pointer"
                    >
                      <td className="px-4 py-2.5">
                        <div className="flex items-center gap-2.5">
                          <div
                            className="size-6 rounded-full flex items-center justify-center text-xs font-semibold text-white shrink-0"
                            style={{ background: deptColor(r.department) }}
                          >
                            {initials(r.name)}
                          </div>
                          <div className="min-w-4">
                            <p className="text-text-primary font-medium truncate">{r.name}</p>
                            <p className="text-xs text-text-muted font-mono">{r.roll ?? "—"}</p>
                          </div>
                        </div>
                      </td>
                      <td className="px-4 py-2.5">
                        <span
                          className="surface-card text-xs uppercase tracking-wide px-2 py-0.5 font-medium"
                          style={{
                            background: `${deptColor(r.department)}22`,
                            color: deptColor(r.department),
                          }}
                        >
                          {r.department ?? "—"}
                        </span>
                      </td>
                      <td className="px-4 py-2.5 text-xs">{r.year ?? "—"}</td>
                      <td className="px-4 py-2.5">
                        {r.isHosteller ? (
                          <span className="flex items-center gap-1 text-xs text-unit-c">
                            <Home className="size-3.5" /> Hosteller
                          </span>
                        ) : (
                          <span className="flex items-center gap-1 text-xs text-action-info">
                            <Building2 className="size-3.5" /> Day
                          </span>
                        )}
                      </td>
                      <td className="px-4 py-2.5 text-xs text-text-muted">
                        {r.hostelBlock && r.roomNumber
                          ? `${r.hostelBlock}-${r.roomNumber}`
                          : "—"}
                      </td>
                      <td className="px-4 py-2.5">
                        <ChevronRight className="w-4 h-4 text-text-muted" />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <EntityInspector inspection={studentInspection} onClose={() => setActive(null)} />
    </div>
  );
}

export default function AdminStudentsPage() {
  return (
    <AdminStudentsInner />
  );
}
