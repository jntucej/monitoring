"use client";

import { useState } from "react";
import {
  BookOpen, Loader2, Plus,
} from "lucide-react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { SectionCard } from "@/components/admin/shared/SectionCard";

import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface IngestResult {
  documentId: string;
  chunkCount: number;
  deduped: boolean;
}

/**
 * Admin Knowledge Base — ingest a policy / SOP document into the RAG KB.
 * Backend: POST /api/admin/kb/documents (admin|sysadmin scope, CSRF).
 */
function AdminKbInner() {
  const [busy, setBusy] = useState(false);
  const [result, setResult] = useState<IngestResult | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [draft, setDraft] = useState({ title: "", source: "", content: "", role: "all" });

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    setBusy(true);
    setResult(null);
    setError(null);
    try {
      const roles = draft.role === "all" ? ["all"] : [draft.role];
      const res = await fetch("/api/admin/kb/documents", {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({
          title: draft.title,
          source: draft.source,
          content: draft.content,
          roles,
        }),
      });
      const body = await res.json();
      if (!res.ok || body?.success === false) {
        setError(body?.error?.message ?? "Ingest failed");
      } else {
        const p = body?.data ?? body;
        setResult({
          documentId: p.documentId,
          chunkCount: p.chunkCount ?? 0,
          deduped: p.deduped ?? false,
        });
        setDraft({ title: "", source: "", content: "", role: "all" });
      }
    } catch (e) {
      console.error("kb ingest", e);
      setError("Failed to reach the knowledge-base service.");
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="space-y-6 p-4 md:p-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Ingest policy and SOP documents into the on-campus RAG knowledge base"
        why="Edits appear immediately in the help center and the AI assistant's answer corpus."
        contextLabel="Ingest policy and SOP documents into the on-campus RAG knowledge base"
        statusSummary="Review current ingest policy and sop documents into the on-campus rag knowledge base state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <PageHeader
        title="Knowledge Base"
        subtitle="Ingest policy and SOP documents into the on-campus RAG knowledge base"
      />

      <WidgetBoundary title="Ingest document">
        <form onSubmit={submit}>
          <SectionCard
            title="Ingest a document"
            description="Documents are chunked, embedded, and searchable via the campus RAG. Deduped by source + content hash."
            icon={BookOpen}
            iconTone="accent"
          >
            <div className="space-y-4">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label>
                  <span className="text-xs font-semibold text-text-secondary block mb-1">Title</span>
                  <input
                    required
                    value={draft.title}
                    onChange={(e) => setDraft((d) => ({ ...d, title: e.target.value }))}
                    placeholder="e.g. Gate Security SOP"
                    className="surface-card w-full px-3 py-2.5 bg-bg-elevated text-sm text-text-primary focus:outline-none focus:"
                  />
                </label>
                <label>
                  <span className="text-xs font-semibold text-text-secondary block mb-1">Source (dedupe key)</span>
                  <input
                    required
                    value={draft.source}
                    onChange={(e) => setDraft((d) => ({ ...d, source: e.target.value }))}
                    placeholder="e.g. policy/gate-security"
                    className="surface-card w-full px-3 py-2.5 bg-bg-elevated text-sm text-text-primary focus:outline-none focus:"
                  />
                </label>
              </div>
              <label>
                <span className="text-xs font-semibold text-text-secondary block mb-1">Content</span>
                <textarea
                  required
                  rows={6}
                  value={draft.content}
                  onChange={(e) => setDraft((d) => ({ ...d, content: e.target.value }))}
                  placeholder="Paste the policy / SOP text…"
                  className="surface-card w-full px-3 py-2.5 bg-bg-elevated text-sm text-text-primary focus:outline-none focus: resize-y"
                />
              </label>
              <label>
                <span className="text-xs font-semibold text-text-secondary block mb-1">Audience role</span>
                <select
                  value={draft.role}
                  onChange={(e) => setDraft((d) => ({ ...d, role: e.target.value }))}
                  className="surface-card w-full px-3 py-2.5 bg-bg-elevated text-sm text-text-primary focus:outline-none focus:"
                >
                  <option value="all">All roles</option>
                  <option value="operator">Operator</option>
                  <option value="warden">Warden</option>
                  <option value="faculty">Faculty</option>
                  <option value="student">Student</option>
                </select>
              </label>

              {result && (
                <div className="surface-card bg-emerald-500/10 p-3 text-xs text-action-success flex items-center gap-2.5">
                  <BookOpen className="w-4 h-4 shrink-0" />
                  <span>
                    Ingested {result.chunkCount} chunk{result.chunkCount === 1 ? "" : "s"}
                    {result.deduped ? " (deduped)" : ""} — document {result.documentId.slice(0, 8)}…
                  </span>
                </div>
              )}
              {error && (
                <div className="surface-card bg-rose-500/10 p-3 text-xs text-action-danger flex items-center gap-2.5">
                  <span>{error}</span>
                </div>
              )}

              <div className="flex justify-end">
                <button
                  type="submit"
                  disabled={busy || !draft.title || !draft.source || !draft.content}
                  className="surface-card px-4 py-2.5 bg-action-primary hover:opacity-90 text-white text-xs font-bold disabled:opacity-50 inline-flex items-center gap-2"
                >
                  {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <Plus className="w-4 h-4" />}
                  Ingest Document
                </button>
              </div>
            </div>
          </SectionCard>
        </form>
      </WidgetBoundary>
    </div>
  );
}

export default function AdminKbPage() {
  return (
    
      <AdminKbInner />
    
    

  );
}
</file>

<file path="src/app/(admin)/admin/lockdown/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  ShieldAlert, ShieldOff, Loader2, Clock,
} from "lucide-react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { SectionCard } from "@/components/admin/shared/SectionCard";
import { ConfirmDialog } from "@/components/admin/shared/ConfirmDialog";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface LockdownRow {
  id: string;
  scope: string;
  message: string | null;
  initiatedBy: string | null;
  createdAt: string;
}

/**
 * Admin Lockdown — emergency campus lockdown control.
 * Backend: /api/admin/lockdown (GET active, POST broadcast, DELETE lift).
 * Admin-only (admin|sysadmin|principal|supervisor).
 */
function AdminLockdownInner() {
  const [active, setActive] = useState<LockdownRow | null>(null);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [draft, setDraft] = useState({ scope: "all-gates", message: "" });
  const [confirmLift, setConfirmLift] = useState(false);
  const [confirmBroadcast, setConfirmBroadcast] = useState(false);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const res = await fetch("/api/admin/lockdown", { headers: getAuthHeaders() });
      const body = await res.json();
      setActive(body?.data ?? null);
    } catch (e) {
      console.error("lockdown", e);
      setActive(null);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  const broadcast = async (e?: React.FormEvent) => {
    e?.preventDefault();
    setConfirmBroadcast(false);
    setBusy(true);
    try {
      await fetch("/api/admin/lockdown", {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ scopes: [draft.scope], message: draft.message || null }),
      });
      load();
    } catch (e) {
      console.error("lockdown broadcast", e);
    } finally {
      setBusy(false);
    }
  };

  const lift = async () => {
    setConfirmLift(false);
    setBusy(true);
    try {
      await fetch("/api/admin/lockdown", { method: "DELETE", headers: getAuthHeaders() });
      load();
    } catch (e) {
      console.error("lockdown lift", e);
    } finally {
      setBusy(false);
    }
  };

  if (loading) {
    return (
      <div className="space-y-4 p-4 md:p-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Broadcast or lift a campus-wide gate lockdown"
        why="Broadcasting a lockdown freezes all gate passes instantly — use only for genuine emergencies."
        contextLabel="Broadcast or lift a campus-wide gate lockdown"
        statusSummary="Review current broadcast or lift a campus-wide gate lockdown state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
        <Skeleton className="h-10 w-48" />
        <Skeleton className="h-40 rounded-2xl" />
      </div>
    );
  }

  return (
    <div className="space-y-6 p-4 md:p-6">
      <PageHeader
        title="Emergency Lockdown"
        subtitle="Broadcast or lift a campus-wide gate lockdown"
        onRefresh={load}
      />

      {/* Active state */}
      <WidgetBoundary title="Active lockdown">
        {active ? (
          <SectionCard
            title="Lockdown in effect"
            description={`Scope: ${active.scope}`}
            icon={ShieldAlert}
            iconTone="accent"
          >
            <div className="space-y-3">
              <div className="surface-card bg-rose-500/10 p-3 text-xs text-action-danger flex items-start gap-2.5">
                <ShieldAlert className="w-4 h-4 shrink-0 mt-0.5" />
                <span>
                  Gates are in lockdown mode. Unauthorized movement is being blocked
                  across the {active.scope} scope.
                </span>
              </div>
              {active.message && (
                <p className="text-sm text-text-secondary">
                  <strong>Message:</strong> {active.message}
                </p>
              )}
              <div className="text-xs text-text-muted flex items-center gap-1.5">
                <Clock className="w-3.5 h-3.5" />
                Since {new Date(active.createdAt).toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })}
              </div>
              <div className="flex">
                <button
                  onClick={() => setConfirmLift(true)}
                  disabled={busy}
                  className="surface-card inline-flex items-center gap-2 px-4 py-2.5 bg-action-danger hover:bg-action-danger text-white text-xs font-bold disabled:opacity-50"
                >
                  {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <ShieldOff className="w-4 h-4" />}
                  Lift Lockdown
                </button>
              </div>
            </div>
          </SectionCard>
        ) : (
          <SectionCard
            title="No active lockdown"
            description="All gates are in normal operation"
            icon={ShieldOff}
            iconTone="default"
          >
            <p className="text-sm text-text-secondary">
              The campus is in normal operation. Use the broadcast form below to initiate
              an emergency lockdown.
            </p>
          </SectionCard>
        )}
      </WidgetBoundary>

      {/* Broadcast form */}
      {!active && (
        <WidgetBoundary title="Broadcast lockdown">
          <form onSubmit={(e) => { void broadcast(e); }}>
            <SectionCard
              title="Initiate lockdown"
              description="Sends an immediate lockdown broadcast to the selected gate scope"
              icon={ShieldAlert}
              iconTone="accent"
            >
              <div className="space-y-4">
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <label>
                    <span className="text-xs font-semibold text-text-secondary block mb-1">Scope</span>
                    <select
                      value={draft.scope}
                      onChange={(e) => setDraft((d) => ({ ...d, scope: e.target.value }))}
                      className="surface-card w-full px-3 py-2.5 bg-bg-elevated text-sm text-text-primary focus:outline-none focus:"
                    >
                      <option value="all-gates">All gates</option>
                      <option value="entry">Entry gates</option>
                      <option value="exit">Exit gates</option>
                      <option value="hostel">Hostel gates</option>
                    </select>
                  </label>
                  <label className="sm:col-span-2">
                    <span className="text-xs font-semibold text-text-secondary block mb-1">
                      Broadcast message (optional)
                    </span>
                    <input
                      type="text"
                      value={draft.message}
                      onChange={(e) => setDraft((d) => ({ ...d, message: e.target.value }))}
                      placeholder="e.g. Emergency: seal campus"
                      className="surface-card w-full px-3 py-2.5 bg-bg-elevated text-sm text-text-primary focus:outline-none focus:"
                    />
                  </label>
                </div>
                <div className="surface-card bg-amber-500/10 p-3 text-xs text-amber-700/90 flex items-start gap-2.5">
                  <ShieldAlert className="w-4 h-4 shrink-0 mt-0.5" />
                  <span>
                    Broadcasting a lockdown immediately blocks gate movement in the
                    selected scope. Use only for genuine emergencies.
                  </span>
                </div>
                <div className="flex justify-end">
                  <button
                    type="button"
                    onClick={() => setConfirmBroadcast(true)}
                    disabled={busy}
                    className="surface-card px-5 py-2.5 bg-action-danger hover:bg-action-danger text-white text-xs font-bold disabled:opacity-50 inline-flex items-center gap-2"
                  >
                    {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <ShieldAlert className="w-4 h-4" />}
                    Broadcast Lockdown
                  </button>
                </div>
              </div>
            </SectionCard>
          </form>
        </WidgetBoundary>
      )}

      <ConfirmDialog
        open={confirmLift}
        onClose={() => setConfirmLift(false)}
        title="Lift lockdown?"
        body="All gates will return to normal operation immediately. This action is audited."
        confirmText="Lift Lockdown"
        variant="destructive"
        onConfirm={lift}
      />
      <ConfirmDialog
        open={confirmBroadcast}
        onClose={() => setConfirmBroadcast(false)}
        title="Broadcast lockdown?"
        body={`Gates in the ${draft.scope} scope will be locked immediately. This action is audited.`}
        confirmText="Broadcast"
        variant="destructive"
        onConfirm={() => { void broadcast(); }}
      />
    </div>
  );
}

export default function AdminLockdownPage() {
  return (
    
      <AdminLockdownInner />
    
    

  );
}
</file>

