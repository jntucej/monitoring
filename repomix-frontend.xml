"use client";

import { useCallback, useEffect, useState } from "react";
import Link from "next/link";
import { CheckCircle2, Clock, Loader2, RefreshCw, Sparkles } from "lucide-react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { EmptyState } from "@/components/shared/EmptyState";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { useIsSakuga } from "@/components/student/useIsSakuga";
import {
  SPECIAL_CATEGORIES, MEAL_LABEL,
  effectiveEventStatus, canIssueToken, countdownLabel,
  type SpecialEvent, type SpecialItemCategory,
} from "@/lib/mess-reviews";

// JSX declaration for sakuga-button
type SakugaButtonProps = Record<string, unknown> & { children?: React.ReactNode };
declare module "react" {
  // eslint-disable-next-line @typescript-eslint/no-namespace
  namespace JSX {
    interface IntrinsicElements {
      "sakuga-button": SakugaButtonProps;
    }
  }
}

const CAT_TONE = Object.fromEntries(
  SPECIAL_CATEGORIES.map((c) => [c.value, c.tone]),
) as Record<SpecialItemCategory, string>;
const CAT_LABEL = Object.fromEntries(
  SPECIAL_CATEGORIES.map((c) => [c.value, c.label]),
) as Record<SpecialItemCategory, string>;

export function SpecialItemSelector() {
  const addToast = useUIStore((s) => s.addToast);
  const isSakuga = useIsSakuga();
  const [events, setEvents] = useState<SpecialEvent[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [selections, setSelections] = useState<Record<string, Set<string>>>({});
  const [savingEventId, setSavingEventId] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch("/api/mess/special-events", { headers: getAuthHeaders(), cache: "no-store" });
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load events");
      const list: SpecialEvent[] = body.data.events ?? [];
      setEvents(list);
      setSelections((prev) => {
        const next: Record<string, Set<string>> = {};
        for (const ev of list) next[ev.id] = new Set(prev[ev.id] ?? ev.myItemIds);
        return next;
      });
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load events");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void load(); }, [load]);

  const toggle = (eventId: string, itemId: string) => {
    setSelections((prev) => {
      const set = new Set(prev[eventId] ?? []);
      if (set.has(itemId)) set.delete(itemId);
      else set.add(itemId);
      return { ...prev, [eventId]: set };
    });
  };

  const save = async (ev: SpecialEvent) => {
    setSavingEventId(ev.id);
    try {
      const itemIds = Array.from(selections[ev.id] ?? []);
      const res = await fetch(`/api/mess/special-events/${ev.id}/interests`, {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ itemIds }),
      });
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Save failed");
      addToast({ message: "Your selection is saved", variant: "success" });
      setEvents((prev) => prev.map((e) => e.id === ev.id ? { ...e, myItemIds: itemIds } : e));
    } catch (e) {
      addToast({ message: e instanceof Error ? e.message : "Save failed", variant: "error" });
    } finally {
      setSavingEventId(null);
    }
  };

  if (loading) {
    return (
      <div className="space-y-3">
        {Array.from({ length: 2 }).map((_, i) => <Skeleton key={i} className="h-40 w-full" />)}
      </div>
    );
  }

  if (error) {
    return (
      <div className="surface-card bg-rose-500/10 p-4 text-sm text-action-danger">
        {error}
        <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
      </div>
    );
  }

  if (events.length === 0) {
    return (
      <EmptyState
        title="No special items yet"
        description="Your mess in-charge will announce special items ahead of the event."
        icon={<Sparkles className="size-6" />}
      />
    );
  }

  return (
    <WidgetBoundary title="Special Items">
      <div className="space-y-4">
        <div className="flex items-center justify-between gap-3">
          <div>
            <h2 className="text-lg font-semibold text-text-primary">Special Items</h2>
            <p className="text-sm text-text-muted">
              Choose the special items you want. You can change your selection until the deadline.
            </p>
          </div>
          <button
            type="button"
            onClick={() => void load()}
            className="surface-card inline-flex items-center gap-2 px-3 py-2 text-sm text-text-secondary hover:bg-bg-surface"
          >
            <RefreshCw className="h-4 w-4" /> Refresh
          </button>
        </div>

        {events.map((ev) => {
          const status = effectiveEventStatus(ev);
          const open = status === "OPEN";
          const selected = selections[ev.id] ?? new Set<string>();
          const canGetToken = canIssueToken(ev);
          const grouped = ev.items.reduce<Record<SpecialItemCategory, typeof ev.items>>(
            (acc, it) => {
              (acc[it.category] ??= []).push(it);
              return acc;
            },
            { VEG: [], NON_VEG: [], SWEET: [], OTHER: [] },
          );

          return (
            <div key={ev.id} className="surface-card bg-bg-surface/60 p-4">
              <div className="mb-3 flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h3 className="text-base font-semibold text-text-primary">{ev.title}</h3>
                  <p className="text-xs text-text-muted">
                    {ev.eventDate} · {MEAL_LABEL[ev.mealType]}
                    {ev.notes ? ` · ${ev.notes}` : ""}
                  </p>
                </div>
                <div className="flex items-center gap-2 text-xs">
                  <span className={`inline-flex items-center gap-1 rounded-full border px-2 py-0.5 ${
                    open ? "border-emerald-500/40 text-action-success" : "border-border/40 text-text-muted"
                  }`}>
                    <Clock className="size-3.5" />
                    {open ? countdownLabel(ev.interestDeadline) : status}
                  </span>
                </div>
              </div>

              {(Object.keys(grouped) as SpecialItemCategory[]).map((cat) =>
                grouped[cat].length === 0 ? null : (
                  <div key={cat} className="mb-3">
                    <div className="mb-1.5 text-xs font-semibold uppercase tracking-wide text-text-muted">
                      {CAT_LABEL[cat]}
                    </div>
                    <div className="flex flex-wrap gap-2">
                      {grouped[cat].map((it) => {
                        const isOn = selected.has(it.id);
                        return (
                          <button
                            key={it.id}
                            type="button"
                            disabled={!open}
                            onClick={() => toggle(ev.id, it.id)}
                            className={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition ${
                              isOn ? CAT_TONE[cat] : "border-border text-text-secondary"
                            } ${!open ? "opacity-60" : "hover:brightness-110"}`}
                          >
                            {isOn ? <CheckCircle2 className="h-4 w-4" /> : <span className="h-4 w-4 border border-current" />}
                            {it.label}
                          </button>
                        );
                      })}
                    </div>
                  </div>
                ),
              )}

              {open && (
                <div className="mt-2 flex items-center justify-between">
                  <span className="text-xs text-text-muted">{selected.size} selected</span>
                  {isSakuga ? (
                    <sakuga-button
                      variant="primary"
                      disabled={savingEventId === ev.id}
                      onClick={() => void save(ev)}
                      label="Save selection"
                    >
                      Save selection
                    </sakuga-button>
                  ) : (
                    <button
                      type="button"
                      disabled={savingEventId === ev.id}
                      onClick={() => void save(ev)}
                      className="surface-card inline-flex items-center gap-2 bg-action-primary px-3 py-2 text-sm font-medium text-white disabled:opacity-60"
                    >
                      {savingEventId === ev.id ? <Loader2 className="h-4 w-4 animate-spin" /> : <CheckCircle2 className="h-4 w-4" />}
                      Save selection
                    </button>
                  )}
                </div>
              )}

              {canGetToken && ev.myItemIds.length > 0 && (
                <div className="surface-card mt-3 flex items-center justify-between gap-2 bg-emerald-500/5 p-2">
                  <div className="text-xs text-text-secondary">
                    Serving window is open. Get your token to redeem your meal.
                  </div>
                  <Link
                    href={`/student/mess/token/${ev.id}`}
                    className="surface-card bg-emerald-500/90 px-3 py-1.5 text-xs font-medium text-white"
                  >
                    Get token →
                  </Link>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </WidgetBoundary>
  );
}
</file>

<file path="src/components/mess/TokenVerifier.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import jsQR from "jsqr";
import {
  Camera, CheckCircle2, KeyRound, Loader2, ScanLine, XCircle,
} from "lucide-react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { SectionCard } from "@/components/admin/shared/SectionCard";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";

interface VerifyResult {
  ok: true;
  tokenId: string;
  userId: string;
  name: string;
  uniqueId: string;
  itemIds: string[];
  itemLabels: string[];
  method: "QR" | "MANUAL";
  expiresAt: string;
}





type Step =
  | { kind: "idle" }
  | { kind: "scanning" }
  | { kind: "verifying" }
  | { kind: "ready"; result: VerifyResult; token: string | null }
  | { kind: "error"; message: string; code: string };

/**
 * Serving-counter UI for the special-event meal token:
 *  - Scan the student's QR token (single-use, signed), or
 *  - Enter roll + 6-character manual code.
 * Verify is non-destructive; "Serve meal" atomically consumes the token.
 */
export function TokenVerifier({ eventId }: { eventId: string }) {
  const addToast = useUIStore((s) => s.addToast);
  const [step, setStep] = useState<Step>({ kind: "idle" });
  const [mode, setMode] = useState<"QR" | "MANUAL">("QR");
  const [roll, setRoll] = useState("");
  const [code, setCode] = useState("");

  // Direct camera scan (opaque token — NOT the gate roll normalizer).
  const videoRef = useRef<HTMLVideoElement | null>(null);
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const rafRef = useRef<number | null>(null);
  const lastScanRef = useRef(0);
  const scanningRef = useRef(false);

  const stopCamera = useCallback(() => {
    scanningRef.current = false;
    if (rafRef.current) { cancelAnimationFrame(rafRef.current); rafRef.current = null; }
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
    }
    if (videoRef.current) videoRef.current.srcObject = null;
  }, []);

  const openCamera = useCallback(async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "environment" },
      });
      streamRef.current = stream;
      scanningRef.current = true;
      if (videoRef.current) {
        videoRef.current.srcObject = stream;
        await videoRef.current.play();
      }
      const tick = () => {
        if (!scanningRef.current || !videoRef.current || !canvasRef.current) return;
        const v = videoRef.current;
        const c = canvasRef.current;
        if (v.readyState === 4 && c.width > 0) {
          c.width = v.videoWidth;
          c.height = v.videoHeight;
          const ctx = c.getContext("2d", { willReadFrequently: true });
          if (ctx) {
            ctx.drawImage(v, 0, 0, c.width, c.height);
            const img = ctx.getImageData(0, 0, c.width, c.height);
            const now = Date.now();
            if (now - lastScanRef.current > 150) {
              const detected = jsQR(img.data, img.width, img.height, { inversionAttempts: "dontInvert" });
              if (detected?.data) {
                lastScanRef.current = now;
                const qrToken = detected.data;
                stopCamera();
                setStep({ kind: "verifying" });
                void verify("QR", qrToken);
                return;
              }
            }
          }
          rafRef.current = requestAnimationFrame(tick);
        }
      };
      rafRef.current = requestAnimationFrame(tick);
    } catch {
      addToast({ message: "Camera unavailable — use manual code", variant: "error" });
      stopCamera();
    }
  }, [stopCamera, addToast]);

  useEffect(() => () => { stopCamera(); }, [stopCamera]);

  const verify = useCallback(
    async (m: "QR" | "MANUAL", qrToken?: string) => {
      setStep({ kind: "verifying" });
      try {
        const payload: Record<string, unknown> = { mode: m, serve: false };
        if (m === "QR") payload.qrToken = qrToken;
        else { payload.roll = roll; payload.manualCode = code; }
        const res = await fetch(`/api/mess/special-events/${eventId}/token/verify`, {
          method: "POST",
          headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const body = await res.json().catch(() => null);
        if (!res.ok || body?.data == null) {
          const err = body?.message ?? "Verification failed";
          const c = body?.error ?? "VERIFY_FAILED";
          setStep({ kind: "error", code: String(c), message: err });
          return;
        }
        if (body?.data == null) {
          const err = body?.message ?? "Verification failed";
          const c = body?.error ?? "VERIFY_FAILED";
          setStep({ kind: "error", code: String(c), message: err });
          return;
        }
        const r = body.data.result as VerifyResult;
        setStep({ kind: "ready", result: r, token: m === "QR" ? qrToken ?? null : null });
      } catch (e) {
        setStep({ kind: "error", code: "NETWORK", message: e instanceof Error ? e.message : "Network error" });
      }
    },
    [addToast, eventId, roll, code],
  );

  const serve = async () => {
    if (step.kind !== "ready") return;
    setStep({ kind: "verifying" });
    try {
      const m = step.result.method;
      const payload: Record<string, unknown> = { mode: m, serve: true };
      if (m === "QR") payload.qrToken = step.token;
      else { payload.roll = step.result.uniqueId; payload.manualCode = code; }
      const res = await fetch(`/api/mess/special-events/${eventId}/token/verify`, {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) {
        addToast({ message: body?.message ?? "Serve failed", variant: "error" });
        setStep({ kind: "ready", result: step.result, token: step.token });
        return;
      }
      const r = body.data.result as VerifyResult;
      addToast({ message: `Served to ${r.name}`, variant: "success" });
      setStep({ kind: "idle" });
      setRoll(""); setCode("");
    } catch (e) {
      addToast({ message: e instanceof Error ? e.message : "Serve failed", variant: "error" });
      if (step.kind === "ready") setStep({ kind: "ready", result: step.result, token: step.token });
    }
  };

  const reset = () => { stopCamera(); setStep({ kind: "idle" }); setRoll(""); setCode(""); };

  return (
    <WidgetBoundary title="Token verifier">
      <div className="space-y-4">
        <div className="surface-card flex gap-1 bg-bg-surface/60 p-1">
          <button
            type="button"
            onClick={() => { stopCamera(); setMode("QR"); if (step.kind !== "idle") reset(); }}
            className={`flex flex-1 items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-medium ${mode === "QR" ? "bg-action-primary text-white" : "text-text-secondary"}`}
          >
            <Camera className="h-4 w-4" /> Scan QR
          </button>
          <button
            type="button"
            onClick={() => { stopCamera(); setMode("MANUAL"); }}
            className={`flex flex-1 items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-medium ${mode === "MANUAL" ? "bg-action-primary text-white" : "text-text-secondary"}`}
          >
            <KeyRound className="h-4 w-4" /> Manual code
          </button>
        </div>

        {/* Opaque QR viewfinder — renders only while scanning. */}
        {step.kind === "scanning" && (
          <div className="space-y-2">
            <div className="relative overflow-hidden rounded-xl border border-border bg-black">
              <video ref={videoRef} className="h-48 w-full object-cover" muted playsInline />
              <canvas ref={canvasRef} className="hidden" />
            </div>
            <button type="button" onClick={reset} className="surface-card w-full px-3 py-2 text-sm">
              Cancel
            </button>
          </div>
        )}

        {step.kind === "idle" && mode === "QR" && (
          <button
            type="button"
            onClick={() => { setStep({ kind: "scanning" }); void openCamera(); }}
            className="surface-card flex w-full flex-col items-center gap-2 py-12 text-sm text-text-secondary hover:bg-bg-elevated"
          >
            <Camera className="size-6" />
            Tap to open the camera and scan the student&#39;s QR token
          </button>
        )}

        {step.kind === "idle" && mode === "MANUAL" && (
          <form
            onSubmit={(e) => { e.preventDefault(); void verify("MANUAL"); }}
            className="grid gap-3 md:grid-cols-2"
          >
            <label className="text-sm text-text-secondary">
              Roll / Unique ID
              <input
                value={roll}
                onChange={(e) => setRoll(e.target.value.toUpperCase())}
                placeholder="24JJ1A0501"
                className="surface-card mt-1 w-full bg-[var(--bg)] px-3 py-2 font-mono text-sm"
              />
            </label>
            <label className="text-sm text-text-secondary">
              6-character code
              <input
                value={code}
                onChange={(e) => setCode(e.target.value.toUpperCase())}
                placeholder="ABC234"
                maxLength={6}
                className="surface-card mt-1 w-full bg-[var(--bg)] px-3 py-2 font-mono text-sm tracking-widest"
              />
            </label>
            <div className="md:col-span-2">
              <button
                type="submit"
                disabled={!roll || code.length !== 6}
                className="surface-card bg-action-primary px-4 py-2 text-sm font-medium text-white disabled:opacity-60"
              >
                Verify
              </button>
            </div>
          </form>
        )}

        {step.kind === "verifying" && (
          <div className="flex items-center gap-2 text-sm text-text-muted">
            <Loader2 className="h-4 w-4 animate-spin" /> Verifying…
          </div>
        )}

        {step.kind === "error" && (
          <div className="surface-card bg-rose-500/10 p-3 text-sm text-action-danger">
            <XCircle className="mr-1 inline h-4 w-4" /> {step.message}
            <button type="button" onClick={reset} className="ml-2 underline">Try again</button>
          </div>
        )}

        {step.kind === "ready" && (
          <SectionCard title="Ready to serve" description={`Verified via ${step.result.method}`}>
            <div className="grid gap-3 md:grid-cols-2">
              <div className="space-y-1">
                <div className="text-lg font-semibold text-text-primary">{step.result.name}</div>
                <div className="font-mono text-sm text-text-secondary">{step.result.uniqueId}</div>
              </div>
              <div>
                <div className="text-xs uppercase tracking-wide text-text-muted">Selected items</div>
                <ul className="mt-1 space-y-1 text-sm text-text-primary">
                  {step.result.itemLabels.map((l, i) => (
                    <li key={step.result.itemIds[i]} className="flex items-center gap-2">
                      <CheckCircle2 className="size-3.5 text-action-success" /> {l}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <div className="mt-4 flex items-center justify-end gap-2">
              <button type="button" onClick={reset} className="surface-card px-3 py-2 text-sm">
                Cancel
              </button>
              <button
                type="button"
                onClick={() => void serve()}
                className="surface-card inline-flex items-center gap-2 bg-action-success px-3 py-2 text-sm font-medium text-white"
              >
                <ScanLine className="h-4 w-4" /> Serve meal
              </button>
            </div>
          </SectionCard>
        )}
      </div>
    </WidgetBoundary>
  );
}
