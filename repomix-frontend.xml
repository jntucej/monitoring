<file path="src/app/exam-branch/discrepancies/page.tsx">
"use client";

import { Suspense, useCallback, useMemo } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import {
  AlertTriangle,
  ArrowRight,
  CircleAlert,
  ShieldAlert,
} from "lucide-react";

/* /api/alerts response shape */
interface AlertItem {
  id: string;
  severity: "low" | "medium" | "high" | "critical";
  title: string;
  message: string;
  gateId?: string;
  studentRoll?: string;
  timestamp: string;
  resolved: boolean;
  visibleToRoles?: string[];
  minTier?: number;
}

interface AlertsResponse {
  success: boolean;
  data: AlertItem[];
}

const SEVERITY_STYLES: Record<
  AlertItem["severity"],
  { badge: string; dot: string }
> = {
  critical: {
    badge: "bg-rose-500/15 text-action-danger border border-rose-500/30",
    dot: "bg-action-danger",
  },
  high: {
    badge: "bg-amber-500/15 text-action-warning border border-amber-500/30",
    dot: "bg-action-warning",
  },
  medium: {
    badge: "bg-yellow-500/15 text-yellow-300 border border-yellow-500/30",
    dot: "bg-yellow-400",
  },
  low: {
    badge: "bg-sky-500/15 text-action-info border border-sky-500/30",
    dot: "bg-action-info",
  },
};

function ExamBranchDiscrepanciesInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "exam_branch") as Role;
  const tier = getRoleTier(role);

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<AlertsResponse>("/api/alerts?resolved=false", {
    ttlMs: 30_000,
  });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const alerts = useMemo<AlertItem[]>(() => data?.data ?? [], [data]);

  const criticalCount = alerts.filter((a) => a.severity === "critical").length;
  const highCount = alerts.filter((a) => a.severity === "high").length;
  const totalOpen = alerts.length;

  /* /api/alerts is restricted to [admin, sysadmin, supervisor, principal].
   * exam_branch will receive a 403 — handle it gracefully with an empty state
   * and the "restricted access" note below. */
  const forbidden =
    typeof error === "string" && (error.includes("403") || error.includes("FORBIDDEN"));

  return (
    <div className="mx-auto max-w-7xl space-y-6 px-4 py-6 md:px-6 min-w-0">
      <Link
        href="/exam-branch"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Overview
      </Link>

      {/* Toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Exam Branch"
        purpose="Detect and resolve candidate identity mismatches, hall inconsistencies, and attendance flags."
        why="Resolving candidate identity and hall allocation flags promptly prevents disruptions and security stops on exam day."
        contextLabel="Exam Discrepancies"
        statusTone={alerts.length > 0 ? "warn" : "ok"}
        statusPill={alerts.length > 0 ? `${alerts.length} flags` : "Zero flags"}
        statusSummary={
          alerts.length > 0
            ? `${alerts.length} discrepancy record${alerts.length === 1 ? "" : "s"} identified across exam seating and hall verification.`
            : "No active exam discrepancy flags detected."
        }
        primaryAction={{ label: "Verification Desk", href: "/exam-branch/verification" }}
        secondaryActions={[
          { label: "Pass Queue", href: "/exam-branch" },
          { label: "OIE Requests", href: "/exam-branch/oie-approval-requests" },
        ]}
      />

      {error && !forbidden && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">Discrepancies unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      {/* KPI cards */}
      <WidgetBoundary title="Discrepancy Summary">
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 min-w-0">
          <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
            <p className="text-xs text-text-muted uppercase tracking-wide">Open Discrepancies</p>
            <p className="mt-1 text-2xl font-bold text-white">{totalOpen}</p>
            <p className="text-xs text-text-muted">Unresolved alerts visible to this role</p>
          </div>
          <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
            <p className="text-xs text-text-muted uppercase tracking-wide">Critical</p>
            <p
              className={`mt-1 text-2xl font-bold ${
                criticalCount > 0 ? "text-action-danger" : "text-text-muted"
              }`}
            >
              {criticalCount}
            </p>
            <p className="text-xs text-text-muted">Requires immediate attention</p>
          </div>
          <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
            <p className="text-xs text-text-muted uppercase tracking-wide">High</p>
            <p
              className={`mt-1 text-2xl font-bold ${
                highCount > 0 ? "text-action-warning" : "text-text-muted"
              }`}
            >
              {highCount}
            </p>
            <p className="text-xs text-text-muted">Elevated severity — escalate if unresolved</p>
          </div>
        </div>
      </WidgetBoundary>

      {/* Discrepancy list */}
      <WidgetBoundary title="Attendance Discrepancies">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <CircleAlert className="w-4 h-4 text-action-danger shrink-0" />
              <span className="text-sm font-semibold text-white truncate">
                Flagged Discrepancies
              </span>
            </div>
            <span className="text-xs text-text-muted shrink-0">{totalOpen} open</span>
          </div>

          {forbidden ? (
            <div className="p-6 text-center min-w-0">
              <ShieldAlert className="size-4 mx-auto text-text-muted mb-2" />
              <p className="text-sm text-text-muted">
                Access to live discrepancies is restricted.
              </p>
              <p className="text-xs text-text-muted mt-1">
                The alerts feed is limited to administrative roles. Contact your
                supervisor or admin if you need attendance discrepancy details.
              </p>
            </div>
          ) : busy ? (
            <div className="p-4 space-y-3 min-w-0">
              {Array.from({ length: 3 }).map((_, i) => (
                <div
                  key={i}
                  className="h-4 rounded-lg border border-border bg-bg-surface/40 animate-pulse motion-reduce:animate-none"
                />
              ))}
            </div>
          ) : alerts.length === 0 ? (
            <div className="p-6 text-center min-w-0">
              <CircleAlert className="size-4 mx-auto text-action-success mb-2" />
              <p className="text-sm text-text-muted">
                No open discrepancies.
              </p>
              <p className="text-xs text-text-muted mt-1">
                Attendance and access discrepancies appear here when they are
                flagged by the gate system.
              </p>
            </div>
          ) : (
            <ul className="divide-y divide-slate-800 min-w-0">
              {alerts.map((alert) => {
                const sev = SEVERITY_STYLES[alert.severity] ?? SEVERITY_STYLES.low;
                return (
                  <li
                    key={alert.id}
                    className="px-4 py-3 flex flex-col gap-1.5 min-w-0"
                  >
                    <div className="flex flex-wrap items-center gap-2 min-w-0">
                      <span
                        className={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-semibold ${sev.badge}`}
                      >
                        <span className={`size-0 rounded-full ${sev.dot}`} />
                        {alert.severity.toUpperCase()}
                      </span>
                      <span className="text-sm font-medium text-white min-w-0 flex-1 truncate">
                        {alert.title}
                      </span>
                    </div>
                    <p className="text-xs text-text-muted min-w-0 break-words">
                      {alert.message}
                    </p>
                    <div className="flex flex-wrap items-center gap-3 text-xs text-text-muted min-w-0">
                      <span>
                        {new Date(alert.timestamp).toLocaleString([], {
                          month: "short",
                          day: "numeric",
                          hour: "2-digit",
                          minute: "2-digit",
                        })}
                      </span>
                      {alert.gateId && <span>gate: {alert.gateId}</span>}
                      {alert.studentRoll && <span>roll: {alert.studentRoll}</span>}
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </WidgetBoundary>

    </div>
  );
}

export default function ExamBranchDiscrepanciesPage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <ExamBranchDiscrepanciesInner />
    </Suspense>
  );
}
