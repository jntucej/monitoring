                  </p>
                  <p className="text-xs text-text-muted">Live presence snapshot.</p>
                </div>
              </div>

              {data?.departmentSummaries && data.departmentSummaries.length > 0 && (
                <div className="mt-4 min-w-0">
                  <p className="text-xs font-semibold uppercase tracking-wide text-text-muted mb-2">Department Breakdown</p>
                  <div className="overflow-x-auto -mx-4 px-4">
                    <table className="w-full text-sm">
