<file path="src/app/(sysadmin)/sysadmin/navigation/page.tsx">
"use client";


import { useEffect, useState } from "react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { ConfirmDialog } from "@/components/shared/ConfirmDialog";
import { Layout, Plus, Trash2, Edit3, CheckCircle2, ShieldAlert, Layers } from "lucide-react";
import { useApi } from "@/hooks/useApi";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface NavItem {
  id?: string;
  roleCode: string;
  groupLabel: string;
  href: string;
  label: string;
  icon: string;
  badge?: string | null;
  order: number;
}

export default function NavigationEditorPage() {
const api = useApi();

  const [navItems, setNavItems] = useState<NavItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedRole, setSelectedRole] = useState("sysadmin");
  const [editingItem, setEditingItem] = useState<Partial<NavItem> | null>(null);
  const [statusMsg, setStatusMsg] = useState<{ type: "success" | "error"; text: string } | null>(null);
  const [navToDelete, setNavToDelete] = useState<string | null>(null);

  const fetchNav = async (role: string) => {
    setLoading(true);
    try {
      const res = await fetch(`/api/config/navigation?role=${role}`, { headers: api.getHeaders() });
      const json = await res.json();
      if (json.success) {
        const flat: NavItem[] = json.raw || [];
        setNavItems(flat);
      }
    } catch {
      setStatusMsg({ type: "error", text: "Failed to load navigation configuration" });
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchNav(selectedRole);
  }, [selectedRole]);

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!editingItem?.href || !editingItem?.label) return;

    try {
      const res = await fetch("/api/config/navigation", {
        method: "POST",
        headers: { ...api.getHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ ...editingItem, roleCode: selectedRole }),
      });
      const json = await res.json();
      if (json.success) {
        setStatusMsg({ type: "success", text: `Saved navigation item '${editingItem.label}'` });
        setEditingItem(null);
        fetchNav(selectedRole);
      } else {
        setStatusMsg({ type: "error", text: json.error?.message || "Failed to save navigation item" });
      }
    } catch {
      setStatusMsg({ type: "error", text: "Network error saving navigation item" });
    }
  };

  const handleDelete = (id: string) => setNavToDelete(id);

  const confirmDeleteNav = async () => {
    if (!navToDelete) return;
    try {
      const res = await fetch(`/api/config/navigation?id=${navToDelete}`, {
        method: "DELETE",
        headers: api.getHeaders(),
      });
      const json = await res.json();
      if (json.success) {
        setStatusMsg({ type: "success", text: "Deleted navigation item" });
        fetchNav(selectedRole);
      } else {
        setStatusMsg({ type: "error", text: json.error?.message || "Failed to delete" });
      }
    } catch {
      setStatusMsg({ type: "error", text: "Network error deleting nav item" });
    } finally {
      setNavToDelete(null);
    }
  };

  return (
    <AuthGuard allowedRoles={["sysadmin"]}>
      <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <ContextSituationBar
        roleLabel="System Admin"
        purpose="Manage and monitor navigation for campus operations."
        why="Broken links here appear in the user's sidebar — fix them before the next release."
        contextLabel="Navigation"
        statusSummary="Review current navigation state and take action below."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "System Health", href: "/sysadmin/health" }}
      />
        <div className="flex items-center justify-between flex-wrap gap-4">
          <div>
            <p className="text-2xl font-bold text-text-primary flex items-center gap-2">
              <Layout className="w-5 h-5 text-action-primary" />
              Dynamic Sidebar Navigation Editor
            </p>
            <p className="text-sm text-text-muted">
              Customize sidebar links, labels, group headers, and icons dynamically per role
            </p>
          </div>
          <button
            type="button"
            onClick={() =>
              setEditingItem({
                roleCode: selectedRole,
                groupLabel: "Menu",
                href: "/",
                label: "",
                icon: "FileText",
                order: navItems.length + 1,
              })
            }
            className="surface-card px-4 py-2 min-h-11 bg-action-primary hover:bg-blue-600 text-white font-semibold text-xs flex items-center gap-2 transition"
          >
            <Plus className="w-4 h-4" /> Add Nav Item
          </button>
        </div>

        {statusMsg && (
          <div
            className={`p-4 rounded-xl border text-sm flex items-center gap-2 ${
              statusMsg.type === "success"
                ? "bg-emerald-500/10 border-emerald-500/30 text-action-success"
                : "bg-rose-500/10 border-rose-500/30 text-action-danger"
            }`}
          >
            {statusMsg.type === "success" ? <CheckCircle2 className="w-5 h-5" /> : <ShieldAlert className="w-5 h-5" />}
            {statusMsg.text}
          </div>
        )}

        {/* Role tabs */}
        <div className="flex gap-2 overflow-x-auto pb-2">
          {["sysadmin", "admin", "principal", "warden", "operator", "faculty", "student", "parent"].map((role) => (
            <button
              type="button"
              key={role}
              onClick={() => setSelectedRole(role)}
              className={`px-4 py-2 min-h-11 rounded-xl text-xs font-bold uppercase tracking-wider transition ${
                selectedRole === role
                  ? "bg-action-primary text-white shadow-lg shadow-blue-500/20"
                  : "bg-bg-surface border border-border text-text-muted hover:text-white"
              }`}
            >
              {role}
            </button>
          ))}
        </div>

        <div className="rounded-xl border border-border bg-bg-surface overflow-hidden">
          {loading ? (
            <div className="p-8 text-center text-text-muted text-sm animate-pulse">
              Loading navigation manifest for {selectedRole}…
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full text-left text-sm min-w175">
                <thead className="bg-bg-elevated border-b border-border text-text-muted uppercase text-xs">
                  <tr>
                    <th className="p-4">Order</th>
                    <th className="p-4">Group Header</th>
                    <th className="p-4">Link Label</th>
                    <th className="p-4">Target Href</th>
                    <th className="p-4">Icon</th>
                    <th className="p-4 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-border">
                  {navItems.map((item) => (
                    <tr key={item.id} className="hover:bg-bg-elevated/50 transition">
                      <td className="p-4 font-mono text-xs text-text-muted">{item.order}</td>
                      <td className="p-4 font-medium text-text-muted">{item.groupLabel}</td>
                      <td className="p-4 font-semibold text-text-primary flex items-center gap-2">
                        <Layers className="w-4 h-4 text-action-primary" />
                        {item.label}
                      </td>
                      <td className="p-4 font-mono text-xs text-action-primary">{item.href}</td>
                      <td className="p-4 font-mono text-xs text-text-muted">{item.icon}</td>
                      <td className="p-4 text-right space-x-2">
                        <button
                          type="button"
                          onClick={() => setEditingItem(item)}
                          className="surface-card p-1.5 bg-bg-elevated hover:text-action-primary transition"
                        >
                          <Edit3 className="w-4 h-4" />
                        </button>
                        <button
                          type="button"
                          onClick={() => item.id && handleDelete(item.id)}
                          className="surface-card p-1.5 bg-rose-500/10 text-action-danger hover:bg-rose-500/20 transition"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>

        {editingItem && (
          <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
            <div className="surface-card bg-bg-surface max-w-md w-full p-6 space-y-4">
              <h3 className="text-lg font-bold text-text-primary">
                {editingItem.id ? "Edit Nav Item" : "New Nav Item"} ({selectedRole})
              </h3>

              <form onSubmit={handleSave} className="space-y-4">
                <div>
                  <label className="block text-xs font-semibold text-text-muted uppercase mb-1">
                    Group Label
                  </label>
                  <input
                    type="text"
                    required
                    value={editingItem.groupLabel || ""}
                    onChange={(e) => setEditingItem({ ...editingItem, groupLabel: e.target.value })}
                    placeholder="e.g. Monitoring"
                    className="surface-card w-full px-3 py-2 bg-bg-elevated text-sm text-text-primary focus:outline-none focus:"
                  />
                </div>

                <div>
                  <label className="block text-xs font-semibold text-text-muted uppercase mb-1">
                    Link Label
                  </label>
                  <input
                    type="text"
                    required
                    value={editingItem.label || ""}
                    onChange={(e) => setEditingItem({ ...editingItem, label: e.target.value })}
                    placeholder="e.g. Live Gates"
                    className="surface-card w-full px-3 py-2 bg-bg-elevated text-sm text-text-primary focus:outline-none focus:"
                  />
                </div>

                <div>
                  <label className="block text-xs font-semibold text-text-muted uppercase mb-1">
                    Target Href
                  </label>
                  <input
                    type="text"
                    required
                    value={editingItem.href || ""}
                    onChange={(e) => setEditingItem({ ...editingItem, href: e.target.value })}
                    placeholder="e.g. /sysadmin/gates"
                    className="surface-card w-full px-3 py-2 bg-bg-elevated text-sm font-mono text-text-primary focus:outline-none focus:"
                  />
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label className="block text-xs font-semibold text-text-muted uppercase mb-1">
                      Lucide Icon Name
                    </label>
                    <input
                      type="text"
                      required
                      value={editingItem.icon || ""}
                      onChange={(e) => setEditingItem({ ...editingItem, icon: e.target.value })}
                      placeholder="e.g. DoorOpen"
                      className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm font-mono text-text-primary focus:outline-none focus:"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-semibold text-text-muted uppercase mb-1">
                      Display Order
                    </label>
                    <input
                      type="number"
                      required
                      value={editingItem.order ?? 1}
                      onChange={(e) => setEditingItem({ ...editingItem, order: Number(e.target.value) })}
                      className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm font-mono text-text-primary focus:outline-none focus:"
                    />
                  </div>
                </div>

                <div className="surface-card flex justify-end gap-2 pt-4">
                  <button
                    type="button"
                    onClick={() => setEditingItem(null)}
                    className="surface-card px-4 py-2 min-h-11 bg-bg-elevated text-text-muted text-xs font-semibold hover:bg-bg-elevated transition"
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    className="surface-card px-4 py-2 min-h-11 bg-action-primary text-white text-xs font-semibold hover:bg-blue-600 transition"
                  >
                    Save Item
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}

        <ConfirmDialog
          open={!!navToDelete}
          onClose={() => setNavToDelete(null)}
          title="Delete navigation item?"
          body="Delete this navigation item? This is audited."
          confirmText="Delete"
          variant="destructive"
          onConfirm={confirmDeleteNav}
        />
      </div>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(sysadmin)/sysadmin/notifications/page.tsx">
"use client";

import { useState } from "react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useDashboardData } from "@/hooks/useDashboardData";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageHeader } from "@/components/shared/PageHeader";
import { Skeleton } from "@/components/ui/skeleton";
import { NotificationsContent } from "@/components/sysadmin/domains/platform/NotificationsContent";
import { NotificationsDrawer } from "@/components/sysadmin/domains/platform/NotificationsDrawer";
import type {
  NotificationsData,
  NotificationsEntity,
} from "@/components/sysadmin/domains/platform/types";

export default function NotificationsPage() {
  const { data, loading, error, refresh } = useDashboardData<NotificationsData>(
    "/api/admin/platform/notifications/overview",
    { ttlMs: 180000, pollMs: 60000 },
  );

  const [selected, setSelected] = useState<NotificationsEntity | null>(null);

  return (
    <WidgetBoundary>
      <PageHeader title="Notifications" onRefresh={refresh} />
      {loading && !data ? (
        <Skeleton className="h-64 w-full" />
      ) : error && !data ? (
        <div>
          <ContextSituationBar
            roleLabel="System Admin"
            purpose="Manage the global notification pipeline: delivery logs, channel health, and queue state."
            contextLabel="Sysadmin Notifications"
            why="Stalled notifications here will silently block student and staff alerts until the pipeline is cleared."
            statusSummary="Review the current state and take action below."
          />
          <div
            role="alert"
            className="surface-card p-4 text-sm"
            style={{
              borderColor: "var(--action-danger)",
              background: "color-mix(in srgb, var(--action-danger) 10%, transparent)",
              color: "var(--action-danger)",
            }}
          >
            Failed to load Notifications: {String(error)}
          </div>
        </div>
      ) : data ? (
        <NotificationsContent data={data} onRowClick={setSelected} />
      ) : null}
      <NotificationsDrawer
        entity={selected}
        onClose={() => setSelected(null)}
        onMutate={() => {
          setSelected(null);
          void refresh();
        }}
      />
    </WidgetBoundary>
  );
}
</file>

<file path="src/app/(sysadmin)/sysadmin/parents/page.tsx">
"use client";

import { useState, useCallback, useEffect } from "react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { useUIStore } from "@/stores/uiStore";
import { useApi } from "@/hooks/useApi";
import { ConfirmDialog } from "@/components/shared/ConfirmDialog";
import {Users, Plus, Search, Link as LinkIcon, Unlink, Check, Copy, KeyRound, X, Loader2, UserCheck}  from "lucide-react";
import { usePersistentQuery } from "@/hooks/usePersistentQuery";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface ParentRow {
  id: string;
  name: string;
  email?: string;
  phone?: string;
  uniqueId?: string;
  role?: string;
  children: Array<{
    id: string;
    name: string;
    roll?: string;
    uniqueId?: string;
    department?: string;
  }>;
}

interface StudentOption {
  id: string;
  name: string;
  roll?: string;
  uniqueId?: string;
  department?: string;
  parentUser?: { id: string; name: string } | null;
}

interface CreatedParent {
  id: string;
  name: string;
  email: string;
  plainPassword?: string;
  uniqueId?: string;
}

function EnrollmentCodeModal({ userId, userName, onClose }: { userId: string; userName: string; onClose: () => void }) {
  const api = useApi();
  const { addToast } = useUIStore();
  const [loading, setLoading] = useState(false);
  const [codeData, setCodeData] = useState<{ code?: string; expiresAt?: string } | null>(null);

  const generateCode = async () => {
    setLoading(true);
    try {
      const res = await fetch(`/api/admin/users/${userId}/enrollment-code`, {
        method: "POST",
        headers: { ...api.getHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ purpose: "web_bootstrap" }),
      });
      const json = await res.json();
      if (res.ok && json.success !== false) {
        setCodeData(json.data || json);
      } else {
        addToast({ variant: "error", title: "Error", message: json.error?.message || "Failed to generate enrollment code." });
      }
    } catch {
      addToast({ variant: "error", title: "Network error", message: "Could not generate code." });
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4">
      <ContextSituationBar
        roleLabel="System Admin"
        purpose="Manage and monitor parents for campus operations."
        why="Use this view to audit parent access and remove stale or unverified links."
        contextLabel="Parents"
        statusSummary="Review current parents state and take action below."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "System Health", href: "/sysadmin/health" }}
      />
      <div className="surface-card bg-bg-elevated w-full max-w-md p-5 space-y-4">
        <div className="flex items-center justify-between">
          <h2 className="text-base font-bold text-white flex items-center gap-2">
            <KeyRound className="w-4 h-4 text-unit-c" /> Enrollment Code — {userName}
          </h2>
          <button type="button" onClick={onClose} className="text-text-muted hover:text-white"><X className="w-5 h-5" /></button>
        </div>
        <p className="text-xs text-text-muted">
          Generate a one-time secure onboarding code for this parent to set their password and sign in directly.
        </p>
        {codeData?.code ? (
          <div className="surface-card p-4 bg-bg-surface text-center space-y-2">
            <span className="text-xs uppercase font-bold text-text-muted block">Secure Code</span>
            <span className="text-2xl font-mono font-black text-action-success tracking-wider">{codeData.code}</span>
            <p className="text-xs text-text-muted">Provide this code to the guardian. Expires in 24 hours.</p>
          </div>
        ) : (
          <button type="button" onClick={generateCode} disabled={loading}
            className="surface-card w-full py-2.5 bg-unit-c hover:bg-unit-c text-white font-bold text-xs flex items-center justify-center gap-2 disabled:opacity-50">
            {loading ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <KeyRound className="w-3.5 h-3.5" />}
            Generate Onboarding Code
          </button>
        )}
        <div className="flex justify-end pt-2">
          <button type="button" onClick={onClose} className="surface-card px-4 py-2 bg-bg-elevated hover:bg-bg-elevated text-text-secondary text-xs font-semibold">Done</button>
        </div>
      </div>
    </div>
  );
}

export default function SysAdminParentsPage() {
  const api = useApi();
  const { addToast } = useUIStore();

  const [parents, setParents] = useState<ParentRow[]>([]);
  const [unlinkedStudents, setUnlinkedStudents] = useState<StudentOption[]>([]);
  const [_loading, setLoading] = useState(false);
  const [query, setQuery] = usePersistentQuery("gate-sysadmin-parents-query");

  const [showCreate, setShowCreate] = useState(false);
  const [createForm, setCreateForm] = useState({ name: "", email: "", phone: "", studentRoll: "" });
  const [creating, setCreating] = useState(false);
  const [createdResult, setCreatedResult] = useState<CreatedParent | null>(null);
  const [copied, setCopied] = useState(false);

  const [linkTarget, setLinkTarget] = useState<{ student: StudentOption } | null>(null);
  const [linkParentId, setLinkParentId] = useState("");
  const [linkBusy, setLinkBusy] = useState(false);

  const [enrollmentUser, setEnrollmentUser] = useState<{ id: string; name: string } | null>(null);
  const [unlinkTarget, setUnlinkTarget] = useState<{ parent: ParentRow; child: ParentRow["children"][0] } | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const [pRes, sRes] = await Promise.all([
        fetch("/api/parents", { headers: api.getHeaders(), cache: "no-store" }),
        fetch("/api/students", { headers: api.getHeaders(), cache: "no-store" }),
      ]);
      const pJson = await pRes.json();
      const sJson = await sRes.json();
      if (pRes.ok && pJson.success) setParents(pJson.data || []);
      if (sRes.ok && sJson.success) {
        const students: StudentOption[] = Array.isArray(sJson.data) ? sJson.data : [];
        setUnlinkedStudents(students);
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to load parent telemetry." });
    } finally {
      setLoading(false);
    }
  }, [addToast, api]);

  useEffect(() => { load(); }, [load]);

  const createParent = async (e: React.FormEvent) => {
    e.preventDefault();
    setCreating(true);
    try {
      const res = await fetch("/api/parents", {
        method: "POST",
        headers: { ...api.getHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify(createForm),
      });
      const json = await res.json();
      if (res.ok && json.success !== false) {
        const created: CreatedParent = json.data || json;
        setCreatedResult(created);
        addToast({ variant: "success", title: "Created", message: "Guardian account registered successfully." });
        setCreateForm({ name: "", email: "", phone: "", studentRoll: "" });
        load();
      } else {
        addToast({ variant: "error", title: "Error", message: json.error?.message || "Failed to create guardian." });
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to create guardian." });
    } finally {
      setCreating(false);
    }
  };

  const handleLink = async () => {
    if (!linkTarget || !linkParentId) return;
    setLinkBusy(true);
    try {
      const res = await fetch("/api/parents/link", {
        method: "POST",
        headers: { ...api.getHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ studentId: linkTarget.student.id, parentUserId: linkParentId }),
      });
      const json = await res.json();
      if (res.ok && json.success !== false) {
        addToast({ variant: "success", title: "Linked", message: `Successfully linked ${linkTarget.student.name} to guardian.` });
        setLinkTarget(null);
        setLinkParentId("");
        load();
      } else {
        addToast({ variant: "error", title: "Error", message: json.error?.message || "Failed to link guardian." });
      }
    } catch {
      addToast({ variant: "error", title: "Network error", message: "Could not link guardian." });
    } finally {
      setLinkBusy(false);
    }
  };

  const handleUnlink = (parent: ParentRow, child: ParentRow["children"][0]) => {
    setUnlinkTarget({ parent, child });
  };

  const confirmUnlink = async () => {
    if (!unlinkTarget) return;
    const { parent, child } = unlinkTarget;
    try {
      const res = await fetch("/api/parents/link", {
        method: "POST",
        headers: { ...api.getHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ studentId: child.id, parentUserId: null }),
      });
      const json = await res.json().catch(() => ({ success: false }));
      if (res.ok && json.success) {
        addToast({ variant: "success", title: "Unlinked", message: `${child.name} unlinked from ${parent.name}.` });
        load();
      } else {
        addToast({ variant: "error", title: "Error", message: json.error?.message || "Failed to unlink." });
      }
    } catch {
      addToast({ variant: "error", title: "Network error", message: "Could not unlink." });
    } finally {
      setUnlinkTarget(null);
    }
  };

  const copyPassword = async (pw: string) => {
    try {
      if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(pw);
      else {
        const ta = document.createElement("textarea");
        ta.value = pw;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        document.body.removeChild(ta);
      }
      setCopied(true);
      setTimeout(() => setCopied(false), 1500);
    } catch {
      // password is shown on-screen regardless
    }
  };

  return (
    <AuthGuard allowedRoles={["sysadmin", "admin"]}>
      <div className="space-y-6">
        {/* Header */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <p className="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
              <Users className="size-5 text-unit-c" />
              Parents &amp; Guardians Registry
            </p>
            <p className="text-sm text-text-muted mt-1">Manage guardian accounts, student-parent relationships, and portal access credentials.</p>
          </div>
          <button type="button" onClick={() => { setShowCreate(true); setCreatedResult(null); }}
            className="surface-card flex items-center gap-2 px-4 py-2.5 bg-unit-c text-white text-sm font-semibold hover:bg-unit-c self-start">
            <Plus className="w-4 h-4" /> Register New Parent
          </button>
        </div>

        {/* Search */}
        <div className="relative">
          <Search className="w-4 h-4 text-text-muted absolute left-3.5 top-3" />
          <input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Search guardians by name, email, phone or student roll…"
            className="surface-card w-full pl-10 pr-4 py-2.5 bg-bg-elevated text-sm text-white placeholder:text-text-muted focus:outline-none focus:"
          />
        </div>

        {/* Parents grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {parents
            .filter((p) => {
              if (!query.trim()) return true;
              const q = query.toLowerCase();
              return (
                p.name?.toLowerCase().includes(q) ||
                p.email?.toLowerCase().includes(q) ||
                p.phone?.toLowerCase().includes(q) ||
                p.children?.some((c) => c.name?.toLowerCase().includes(q) || c.roll?.toLowerCase().includes(q))
              );
            })
            .map((p) => (
              <div key={p.id} className="surface-card bg-bg-elevated p-5 space-y-4">
                <div className="flex items-start justify-between gap-3">
                  <div>
                    <h3 className="text-base font-bold text-white flex items-center gap-2">
                      <UserCheck className="w-4 h-4 text-unit-c" /> {p.name}
                    </h3>
                    <p className="text-xs text-text-muted mt-0.5">{p.email || "No email"} · {p.phone || "No phone"}</p>
                  </div>
                  <div className="flex items-center gap-1.5 shrink-0">
                    <button type="button" onClick={() => setEnrollmentUser({ id: p.id, name: p.name })}
                      className="surface-card px-2.5 py-1.5 bg-violet-500/10 hover:bg-violet-500/20 text-unit-c text-xs font-semibold flex items-center gap-1" title="Generate enrollment code">
                      <KeyRound className="w-3.5 h-3.5" /> Code
                    </button>
                  </div>
                </div>

                {/* Linked children */}
                <div className="surface-card space-y-2 pt-2">
                  <span className="text-xs font-bold uppercase tracking-wider text-text-muted">Linked Students</span>
                  {p.children && p.children.length > 0 ? (
                    <div className="space-y-1.5">
                      {p.children.map((c) => (
                        <div key={c.id} className="surface-card flex items-center justify-between gap-2 px-3 py-2 bg-bg-surface text-xs">
                          <div>
                            <span className="font-semibold text-white">{c.name}</span>
                            <span className="font-mono text-unit-c ml-2">{c.roll || c.uniqueId}</span>
                            <span className="text-text-muted ml-2">({c.department || "General"})</span>
                          </div>
                          <button type="button" onClick={() => handleUnlink(p, c)}
                            className="text-text-muted hover:text-action-danger p-1" title="Unlink student">
                            <Unlink className="w-3.5 h-3.5" />
                          </button>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p className="text-xs text-text-muted italic">No students linked to this guardian yet.</p>
                  )}
                </div>
              </div>
            ))}
        </div>

        {/* Unlinked students section */}
        <div className="surface-card bg-bg-elevated p-5 space-y-4">
          <h3 className="text-sm font-bold text-white flex items-center gap-2">
            <LinkIcon className="w-4 h-4 text-action-success" /> Students Awaiting Guardian Link
          </h3>
          <div className="overflow-x-auto">
            <table className="w-full text-xs text-left">
              <thead>
                <tr className="text-text-muted uppercase border-b border-border">
                  <th className="pb-2.5 px-3">Student</th>
                  <th className="pb-2.5 px-3">Roll / ID</th>
                  <th className="pb-2.5 px-3">Department</th>
                  <th className="pb-2.5 px-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800/50">
                {unlinkedStudents.map((s) => (
                  <tr key={s.id} className="hover:bg-bg-surface/40">
                    <td className="py-2.5 px-3 font-semibold text-white">{s.name}</td>
                    <td className="py-2.5 px-3 font-mono text-text-secondary">{s.roll || s.uniqueId}</td>
                    <td className="py-2.5 px-3 text-text-muted">{s.department || "—"}</td>
                    <td className="py-2.5 px-3 text-right">
                      <button type="button" onClick={() => setLinkTarget({ student: s })}
                        className="surface-card px-2.5 py-1 bg-action-success hover:bg-action-success text-white font-bold">
                        Link Guardian
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Create modal */}
        {showCreate && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4">
            <form onSubmit={createParent} className="surface-card bg-bg-elevated w-full max-w-md p-5 space-y-4">
              <div className="flex items-center justify-between">
                <h2 className="text-lg font-bold text-white flex items-center gap-2">
                  <Plus className="w-5 h-5 text-unit-c" /> Register Parent / Guardian
                </h2>
                <button type="button" onClick={() => setShowCreate(false)} className="text-text-muted hover:text-white"><X className="w-5 h-5" /></button>
              </div>

              {createdResult ? (
                <div className="space-y-4 py-2">
                  <div className="surface-card p-4 bg-emerald-500/10 text-action-success text-xs space-y-1">
                    <p className="font-bold">Guardian Account Created Successfully!</p>
                    <p>Name: {createdResult.name}</p>
                    <p>Email: {createdResult.email}</p>
                    {createdResult.plainPassword && (
                      <div className="surface-card mt-2 pt-2 flex items-center justify-between">
                        <span className="surface-card font-mono bg-black/30 px-2 py-1 text-white">{createdResult.plainPassword}</span>
                        <button type="button" onClick={() => copyPassword(createdResult.plainPassword!)}
                          className="surface-card px-2.5 py-1 bg-action-success text-white font-bold text-xs flex items-center gap-1">
                          {copied ? <Check className="w-3.5 h-3.5" /> : <Copy className="w-3.5 h-3.5" />} {copied ? "Copied" : "Copy Password"}
                        </button>
                      </div>
                    )}
                  </div>
                  <div className="flex justify-end pt-2">
                    <button type="button" onClick={() => { setShowCreate(false); setCreatedResult(null); }}
                      className="surface-card px-4 py-2 bg-unit-c text-white text-xs font-bold">Done</button>
                  </div>
                </div>
              ) : (
                <>
                  <div className="space-y-3 text-xs">
                    <div>
                      <label className="text-text-muted block mb-1">Full Name *</label>
                      <input required value={createForm.name} onChange={(e) => setCreateForm({ ...createForm, name: e.target.value })}
                        placeholder="e.g. Rajesh Sharma" className="surface-card w-full px-3 py-2 bg-bg-surface text-white focus:outline-none focus:" />
                    </div>
                    <div>
                      <label className="text-text-muted block mb-1">Email (portal login) *</label>
                      <input type="email" required value={createForm.email} onChange={(e) => setCreateForm({ ...createForm, email: e.target.value })}
                        placeholder="e.g. rajesh@example.com" className="surface-card w-full px-3 py-2 bg-bg-surface text-white focus:outline-none focus:" />
                    </div>
                    <div>
                      <label className="text-text-muted block mb-1">Phone Number</label>
                      <input value={createForm.phone} onChange={(e) => setCreateForm({ ...createForm, phone: e.target.value })}
                        placeholder="e.g. +91 9876543210" className="surface-card w-full px-3 py-2 bg-bg-surface text-white focus:outline-none focus:" />
                    </div>
                    <div>
                      <label className="text-text-muted block mb-1">Student Roll Number (optional auto-link)</label>
                      <input value={createForm.studentRoll} onChange={(e) => setCreateForm({ ...createForm, studentRoll: e.target.value })}
                        placeholder="e.g. 24JJ1A0501" className="surface-card w-full px-3 py-2 bg-bg-surface text-white font-mono focus:outline-none focus:" />
                    </div>
                  </div>
                  <div className="flex justify-end gap-2 pt-2">
                    <button type="button" onClick={() => setShowCreate(false)} className="surface-card px-4 py-2 hover:bg-bg-elevated text-text-secondary text-xs font-semibold">Cancel</button>
                    <button type="submit" disabled={creating} className="surface-card px-4 py-2 bg-unit-c hover:bg-unit-c text-white text-xs font-bold disabled:opacity-50">
                      {creating ? "Creating..." : "Register Guardian"}
                    </button>
                  </div>
                </>
              )}
            </form>
          </div>
        )}

        {/* Link guardian modal */}
        {linkTarget && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4">
            <div className="bg-bg-elevated border border-border rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
              <div className="surface-card p-5 flex items-center justify-between">
                <h3 className="font-bold text-white flex items-center gap-2">
                  <LinkIcon className="w-4 h-4 text-action-success" /> Link Guardian to Student
                </h3>
                <button type="button" onClick={() => setLinkTarget(null)} className="surface-card p-1 hover:bg-bg-elevated text-text-muted">
                  <X className="w-4 h-4" />
                </button>
              </div>
              <div className="p-5 space-y-4">
                <p className="text-xs text-text-muted">
                  Linking <strong className="text-white">{linkTarget.student.name}</strong> ({linkTarget.student.roll}) to a
                  guardian. If no suitable guardian exists, create one from the New Parent button.
                </p>

                <div>
                  <label className="text-xs font-semibold text-text-muted block mb-1" htmlFor="guardian">Guardian</label>
                  <select id="guardian"
                    value={linkParentId}
                    onChange={(e) => setLinkParentId(e.target.value)}
                    className="surface-card w-full px-3 py-2 bg-bg-surface text-sm text-white focus:outline-none focus:"
                  >
                    <option value="">Select guardian…</option>
                    {parents.map((p) => (
                      <option key={p.id} value={p.id}>
                        {p.name} {p.uniqueId ? `(${p.uniqueId})` : ""}
                      </option>
                    ))}
                  </select>
                </div>

                <div className="flex justify-end gap-2">
                  <button
                    type="button"
                    onClick={() => setLinkTarget(null)}
                    className="surface-card px-4 py-2 bg-bg-elevated text-text-secondary text-xs font-semibold hover:bg-bg-elevated"
                  >
                    Cancel
                  </button>
                  <button
                    type="button"
                    onClick={handleLink}
                    disabled={linkBusy || !linkParentId}
                    className="surface-card px-4 py-2 bg-unit-c text-white text-xs font-semibold hover:bg-unit-c disabled:opacity-50 flex items-center gap-2"
                  >
                    {linkBusy ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <LinkIcon className="w-3.5 h-3.5" />}
                    Link
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Enrollment code modal */}
        {enrollmentUser && (
          <EnrollmentCodeModal
            userId={enrollmentUser.id}
            userName={enrollmentUser.name}
            onClose={() => setEnrollmentUser(null)}
          />
        )}

        <ConfirmDialog
          open={!!unlinkTarget}
          onClose={() => setUnlinkTarget(null)}
          title="Unlink student?"
          body={unlinkTarget ? `Unlink ${unlinkTarget.child.name} from ${unlinkTarget.parent.name}?` : ""}
          confirmText="Unlink"
          variant="destructive"
          onConfirm={confirmUnlink}
        />
      </div>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(sysadmin)/sysadmin/people/page.tsx">
"use client";
// src/app/(sysadmin)/sysadmin/people/page.tsx
// PEOPLE sysadmin page (faceted-table + drawer, pollMs 60000).
// The layout enforces withAuthorization + withRateLimit; this client page pulls
// the aggregated payload and renders the faceted table + KPIs + cohort matrix,
// opening the PeopleDrawer on row click (no route change). L4 trace drawer
// surfaces in parallel — record-trace diagnostics + canonical sysadmin routes
// (sessions / audit / runbooks).

import { useState, useCallback } from "react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useDashboardData } from "@/hooks/useDashboardData";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageHeader } from "@/components/shared/PageHeader";
import { Skeleton } from "@/components/ui/skeleton";
import { PeopleContent } from "@/components/sysadmin/domains/identity/PeopleContent";
import { PeopleDrawer } from "@/components/sysadmin/domains/identity/PeopleDrawer";
import {
  SysAdminTraceDrawer,
  type SysAdminTraceTarget,
} from "@/components/nav/level4/SysAdminTraceDrawer";
import type {
  PersonRow,
  PeopleData,
} from "@/components/sysadmin/domains/identity/types";

function buildUserTrace(row: PersonRow): SysAdminTraceTarget {
  return {
    entityType: "user",
    identifier: row.id,
    label: row.name,
    diagnostics: [
      { label: "role", value: row.role },
      { label: "state", value: row.state },
      { label: "email", value: row.email },
      {
        label: "2FA",
        value: row.two_factor_enabled ? "enabled" : "disabled",
      },
      {
        label: "sessions",
        value: String(row.sessions_count),
      },
      {
        label: "last login",
        value: row.last_login_at
          ? new Date(row.last_login_at).toLocaleString("en-IN")
          : "never",
      },
    ],
    traceRoutes: [
      { label: "sessions", href: "/sysadmin/sessions" },
      { label: "audit", href: "/sysadmin/audit" },
      { label: "runbooks", href: "/sysadmin/runbooks" },
    ],
  };
}

export default function PeoplePage() {
  const { data, loading, error, refresh } = useDashboardData<PeopleData>(
    "/api/admin/people/overview",
    { ttlMs: 180_000, pollMs: 60_000 },
  );

  // Drawer state: the clicked row (or null when closed). No route change.
  const [selectedRow, setSelectedRow] = useState<PersonRow | null>(null);

  const openRow = useCallback(
    (id: string) => {
      const row = data?.rows?.find((r) => r.id === id) ?? null;
      setSelectedRow(row);
    },
    [data],
  );

  const trace: SysAdminTraceTarget | null = selectedRow
    ? buildUserTrace(selectedRow)
    : null;

  return (
    <WidgetBoundary>
      <PageHeader title="People" subtitle="Identity directory" onRefresh={refresh} />
      {loading && !data ? (
        <Skeleton className="h-64 w-full" />
      ) : (
        <>
                <ContextSituationBar
        roleLabel="System Admin"
        purpose="System-level view of every person record across the campus: students, faculty, staff, and guardians."
        contextLabel="Sysadmin People"
        why="Use this view to cross-reference identity data before a bulk import or migration."
        statusSummary="Review the current state and take action below."
      />
<div className="section-offscreen">
            <PeopleContent data={data} loading={loading} error={error} onRowClick={openRow} />
          </div>
          <PeopleDrawer row={selectedRow} onClose={() => setSelectedRow(null)} />
          <SysAdminTraceDrawer
            trace={trace}
            onClose={() => setSelectedRow(null)}
          />
        </>
      )}
    </WidgetBoundary>
  );
}
</file>

