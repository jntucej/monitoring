        <p className="text-[10px] text-text-muted">
          Policies are defined in <code className="text-text-secondary">lib/conduct.ts</code>.
          Admin edits migrate to a DB table in a later phase.
        </p>
      </div>
    </WidgetBoundary>
  );
}

export default ConductPolicies;
