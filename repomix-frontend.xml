<file path="src/components/admin/sms/SmsComposer.tsx">
"use client";

import { useEffect, useState } from "react";
import { Send, Loader2, MessageSquare, AlertTriangle } from "lucide-react";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { useToast } from "@/components/ui/toast";
import { getAuthHeaders } from "@/lib/utils";

interface Tpl {
  code: string;
  label: string;
  body: string;
  variables: string[];
  dlt_template_id: string | null;
  category: string;
}

const SEGMENTS = [
  "all_parents",
  "all_students",
  "hostellers",
  "day_scholars",
] as const;

export function SmsComposer() {
  const [templates, setTemplates] = useState<Tpl[]>([]);
  const [code, setCode] = useState("");
  const [segment, setSegment] = useState<(typeof SEGMENTS)[number]>("all_parents");
  const [vars, setVars] = useState<Record<string, string>>({});
  const [sending, setSending] = useState(false);
  const { addToast } = useToast();

  useEffect(() => {
    fetch("/api/admin/sms/templates", { headers: getAuthHeaders() })
      .then((r) => r.json())
      .then((j) => {
        if (j.success) setTemplates(j.data.templates as Tpl[]);
      })
      .catch(() => addToast({ variant: "error", title: "Failed", message: "Could not load SMS templates." }));
  }, [addToast]);

  const tpl = templates.find((t) => t.code === code);

  const submit = async () => {
    if (!code) return;
    setSending(true);
    try {
      const res = await fetch("/api/admin/sms/compose", {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ templateCode: code, segment, vars, priority: "normal" }),
      });
      const json = await res.json();
      if (json.success) {
        addToast({
          variant: "success",
          title: "Queued",
          message: `${json.data.queued} SMS queued for dispatch.`,
        });
      } else {
        addToast({
          variant: "error",
          title: "Failed",
          message: json.message ?? json.error ?? "Failed to queue SMS batch.",
        });
      }
    } catch {
      addToast({ variant: "error", title: "Network error", message: "Could not reach the server." });
    } finally {
      setSending(false);
    }
  };

  return (
    <div className="space-y-4 max-w-3xl">
      <Card className="p-4 space-y-3">
        <h3 className="font-semibold flex items-center gap-2 text-sm">
          <MessageSquare className="w-4 h-4" aria-hidden="true" /> Template
        </h3>
        <select
          className="surface-card w-full bg-bg-surface px-2 py-2 text-sm"
          value={code}
          onChange={(e) => {
            setCode(e.target.value);
            setVars({});
          }}
          aria-label="Select SMS template"
        >
          <option value="">— select —</option>
          {templates.map((t) => (
            <option key={t.code} value={t.code}>
              {t.label}
              {!t.dlt_template_id ? "  (⚠ no DLT ID yet)" : ""}
            </option>
          ))}
        </select>

        {tpl && (
          <>
            <pre className="surface-card text-xs p-2 bg-bg-elevated whitespace-pre-wrap overflow-x-auto">
              {tpl.body}
            </pre>
            <p className="text-xs text-text-muted">
              Variables: {tpl.variables.length ? tpl.variables.join(", ") : "none"}
            </p>
            {!tpl.dlt_template_id && (
              <div className="surface-card flex items-start gap-2 text-xs text-action-warning bg-action-warning/10 p-2">
                <AlertTriangle className="w-3.5 h-3.5 mt-0.5 shrink-0" aria-hidden="true" />
                <span>
                  This template has no DLT_TEMPLATE_ID yet. SMS will queue as &ldquo;failed&rdquo; and
                  retry automatically once the sysadmin registers the template and fills in the ID.
                </span>
              </div>
            )}
            {tpl.variables.map((v) => (
              <Input
                key={v}
                placeholder={v}
                value={vars[v] ?? ""}
                onChange={(e) => setVars((x) => ({ ...x, [v]: e.target.value }))}
                label={v}
                className="text-sm"
              />
            ))}
          </>
        )}
      </Card>

      <Card className="p-4 space-y-3">
        <h3 className="font-semibold text-sm">Recipient segment</h3>
        <div className="grid grid-cols-2 gap-2">
          {SEGMENTS.map((s) => (
            <button
              key={s}
              type="button"
              onClick={() => setSegment(s)}
              aria-pressed={segment === s}
              className={`px-3 py-2 rounded border text-sm transition-colors ${
                segment === s
                  ? "bg-action-primary/20 border-action-primary text-text-primary"
                  : "border-border text-text-secondary hover:bg-bg-elevated"
              }`}
            >
              {s.replace(/_/g, " ")}
            </button>
          ))}
        </div>
      </Card>

      <Button onClick={submit} disabled={!code || sending}>
        {sending ? (
          <Loader2 className="w-4 h-4 animate-spin" aria-hidden="true" />
        ) : (
          <Send className="w-4 h-4" aria-hidden="true" />
        )}
        {sending ? "Queueing…" : "Queue SMS"}
      </Button>
    </div>
  );
}
</file>

<file path="src/components/admin/sms/SmsTemplates.tsx">
"use client";

import { useEffect, useState } from "react";
import { RefreshCw, Save, FileText } from "lucide-react";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { useToast } from "@/components/ui/toast";
import { getAuthHeaders } from "@/lib/utils";

interface Tpl {
  code: string;
  label: string;
  body: string;
  variables: string[];
  sender_id: string;
  dlt_template_id: string | null;
  category: string;
  is_active: boolean;
}

export function SmsTemplates() {
  const [templates, setTemplates] = useState<Tpl[]>([]);
  const [selected, setSelected] = useState<Tpl | null>(null);
  const [editBody, setEditBody] = useState("");
  const [editDltId, setEditDltId] = useState("");
  const [editLabel, setEditLabel] = useState("");
  const [saving, setSaving] = useState(false);
  const { addToast } = useToast();

  const load = async () => {
    try {
      const res = await fetch("/api/admin/sms/templates?all=true", { headers: getAuthHeaders() });
      const json = await res.json();
      if (json.success) {
        setTemplates(json.data.templates as Tpl[]);
      }
    } catch {
      addToast({ variant: "error", title: "Failed", message: "Could not load SMS templates." });
    }
  };

  useEffect(() => {
    load();
  }, [addToast]);

  const selectTpl = (t: Tpl) => {
    setSelected(t);
    setEditBody(t.body);
    setEditDltId(t.dlt_template_id ?? "");
    setEditLabel(t.label);
  };

  const save = async () => {
    if (!selected) return;
    setSaving(true);
    try {
      const res = await fetch(`/api/admin/sms/templates/${selected.code}`, {
        method: "PATCH",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({
          label: editLabel,
          body: editBody,
          dlt_template_id: editDltId.trim() || null,
        }),
      });
      const json = await res.json();
      if (json.success) {
        addToast({ variant: "success", title: "Saved", message: `Template '${selected.code}' updated.` });
        load();
      } else {
        addToast({ variant: "error", title: "Failed", message: json.message ?? "Could not save template." });
      }
    } catch {
      addToast({ variant: "error", title: "Network error", message: "Could not save template." });
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="space-y-4 max-w-4xl">
      <div className="flex items-center justify-between">
        <h2 className="text-lg font-semibold flex items-center gap-2">
          <FileText className="w-5 h-5" aria-hidden="true" /> SMS Templates
        </h2>
        <Button variant="secondary" size="sm" onClick={load}>
          <RefreshCw className="w-3.5 h-3.5" aria-hidden="true" /> Refresh
        </Button>
      </div>

      <div className="grid md:grid-cols-[240px_1fr] gap-4">
        <div className="space-y-1">
          {templates.map((t) => (
            <button
              key={t.code}
              type="button"
              onClick={() => selectTpl(t)}
              aria-pressed={selected?.code === t.code}
              className={`w-full text-left px-3 py-2 rounded text-sm transition-colors ${
                selected?.code === t.code
                  ? "bg-action-primary/20 text-text-primary"
                  : "hover:bg-bg-elevated text-text-secondary"
              }`}
            >
              <span className="font-medium">{t.label}</span>
              <span className="block text-xs text-text-muted">{t.code}</span>
            </button>
          ))}
        </div>

        {selected && (
          <Card className="p-4 space-y-3">
            <div>
              <label className="text-xs font-medium text-text-muted uppercase">Label</label>
              <Input
                value={editLabel}
                onChange={(e) => setEditLabel(e.target.value)}
                className="mt-1"
              />
            </div>
            <div>
              <label className="text-xs font-medium text-text-muted uppercase">
                DLT Template ID
                {!selected.dlt_template_id && " (not registered yet)"}
              </label>
              <Input
                value={editDltId}
                onChange={(e) => setEditDltId(e.target.value)}
                placeholder="Fill in after DLT registration"
                className="mt-1 font-mono text-sm"
              />
            </div>
            <div>
              <label className="text-xs font-medium text-text-muted uppercase">Body</label>
              <textarea
                value={editBody}
                onChange={(e) => setEditBody(e.target.value)}
                rows={4}
                className="surface-card mt-1 w-full bg-bg-surface p-2 text-sm font-mono"
              />
              <p className="text-xs text-text-muted mt-1">
                Variables: {selected.variables.length ? selected.variables.map((v) => `{#${v}#}`).join("  ") : "none"}
              </p>
            </div>
            <div>
              <Button onClick={save} disabled={saving} size="sm">
                <Save className="w-3.5 h-3.5" aria-hidden="true" /> {saving ? "Saving…" : "Save"}
              </Button>
            </div>
          </Card>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/admin/AdminAuditLogViewer.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { ChevronLeft, ChevronRight, History, Download, RefreshCw } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { generateCSV } from "@/lib/export";
import { EntityInspector, KVPairs, InspectorButton, Timeline } from "@/components/shared/EntityInspector";

type Scope = "campus" | "all";

interface AuditItem {
  id: string;
  action: string;
  userId: string | null;
  userName: string | null;
  userRole: string | null;
  details: Record<string, unknown>;
  timestamp: string;
}

interface AuditTimelineEntry {
  label: string;
  time?: string;
  detail?: string;
  tone?: "ok" | "warn" | "danger" | "neutral";
}

/**
 * Build the timeline for an audit event: the event itself plus any
 * structured entries embedded in `details` (e.g. before/after payloads,
 * related ticket / case ids). No relationships are invented — every entry
 * comes straight from the /api/admin/audit-logs response.
 */
function auditEventTimeline(item: AuditItem): AuditTimelineEntry[] {
  const entries: AuditTimelineEntry[] = [
    {
      label: item.action,
      time: item.timestamp ? new Date(item.timestamp).toLocaleString("en-IN") : undefined,
      detail: [item.userName ?? item.userId, item.userRole].filter(Boolean).join(" · ") || undefined,
      tone: "neutral",
    },
  ];

  const d = item.details;
  if (d && typeof d === "object") {
    // Surface any "before" / "after" style payloads as a second entry so the
    // timeline shows the state transition without a separate detail fetch.
    const before = (d as Record<string, unknown>).before;
    const after = (d as Record<string, unknown>).after;
    if (before !== undefined || after !== undefined) {
      entries.push({
        label: "State transition",
        detail: [before !== undefined ? `before: ${JSON.stringify(before)}` : null, after !== undefined ? `after: ${JSON.stringify(after)}` : null]
          .filter(Boolean)
          .join(" · ") || undefined,
        tone: "warn",
      });
    }
  }

  return entries;
}

const PAGE_SIZE = 25;

/**
 * Admin campus-split audit trail viewer.
 *
 * Consumes /api/admin/audit-logs which already filters out infra-noise
 * actions for the campus scope. The "all" scope is sysadmin-only and is
 * enforced server-side against the DB role, so the client only surfaces the
 * toggle and lets the API respond with 403 for non-sysadmins.
 */
export function AdminAuditLogViewer({ canViewAll }: { canViewAll?: boolean }) {
  const [scope, setScope] = useState<Scope>("campus");
  const [items, setItems] = useState<AuditItem[]>([]);
  const [total, setTotal] = useState(0);
  const [page, setPage] = useState(1);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const [actionFilter, setActionFilter] = useState("");
  const [userIdFilter, setUserIdFilter] = useState("");
  const [fromFilter, setFromFilter] = useState("");
  const [toFilter, setToFilter] = useState("");
  const [reloadKey, setReloadKey] = useState(0);
  const [active, setActive] = useState<AuditItem | null>(null);

  // Generation counter guards against a stale in-flight response (fast
  // page/scope/refresh changes) clobbering newer state.
  const reqGen = useRef(0);

  const fetchLogs = useCallback(
    async (s: Scope, p: number) => {
      const gen = ++reqGen.current;
      setLoading(true);
      setError(null);
      try {
        const params = new URLSearchParams();
        params.set("scope", s);
        if (actionFilter) params.set("action", actionFilter);
        if (userIdFilter) params.set("userId", userIdFilter);
        if (fromFilter) params.set("from", new Date(fromFilter).toISOString());
        if (toFilter) params.set("to", new Date(toFilter).toISOString());
        params.set("page", p.toString());
        params.set("pageSize", PAGE_SIZE.toString());

        const res = await fetch(`/api/admin/audit-logs?${params.toString()}`, {
          headers: getAuthHeaders(),
          cache: "no-store",
        });
        const json = await res.json();

        if (gen !== reqGen.current) return; // a newer request superseded this one
        if (res.ok && json.success) {
          setItems(Array.isArray(json.items) ? json.items : []);
          setTotal(json.total ?? 0);
        } else {
          const msg =
            typeof json.error === "string"
              ? json.error
              : json.error?.message ?? "Failed to load audit logs";
          setError(msg);
          setItems([]);
          setTotal(0);
        }
      } catch (err) {
        if (gen === reqGen.current) {
          setError(err instanceof Error ? err.message : "Network error");
        }
      } finally {
        if (gen === reqGen.current) setLoading(false);
      }
    },
    [actionFilter, userIdFilter, fromFilter, toFilter]
  );

  useEffect(() => {
    void fetchLogs(scope, page);
  }, [page, scope, reloadKey, fetchLogs]);

  const handleExport = async () => {
    if (items.length === 0) return;
    const exportData = items.map((l) => ({
      Timestamp: l.timestamp ? new Date(l.timestamp).toLocaleString("en-IN") : "",
      Action: l.action,
      "User Name": l.userName || "N/A",
      Role: l.userRole || "N/A",
      "User ID": l.userId || "",
      Details: JSON.stringify(l.details ?? {}),
    }));
    const result = await generateCSV(exportData, `audit_logs_${scope}_${new Date().toISOString().slice(0, 10)}`);
    if (result.success && result.data) {
      const blob = new Blob([result.data], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", result.filename);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    }
  };

  const totalPages = Math.ceil(total / PAGE_SIZE) || 1;

  return (
    <div className="space-y-4">
      <div className="flex flex-col sm:flex-row justify-between sm:items-center gap-3">
        <div className="flex items-center gap-2">
          <span className="text-xs font-semibold text-text-muted uppercase tracking-wide">Scope</span>
          {(["campus", "all"] as const).map((s) => {
            const disabled = s === "all" && !canViewAll;
            return (
              <button
                key={s}
                onClick={() => {
                  if (disabled) return;
                  setScope(s);
                  setPage(1);
                }}
                disabled={disabled}
                title={
                  s === "all"
                    ? "Shows the full, unfiltered trail. Requires the sysadmin role."
                    : "Campus operational events, infra-noise filtered out."
                }
                className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
                  scope === s
                    ? "bg-action-primary text-white"
                    : "bg-bg-surface text-text-muted border border-border"
                } disabled:opacity-40 disabled:cursor-not-allowed`}
              >
                {s === "campus" ? "Campus" : "All (sysadmin)"}
              </button>
            );
          })}
        </div>

        <div className="flex items-center gap-2">
          <button
            type="button"
            onClick={() => setReloadKey((k) => k + 1)}
            disabled={loading}
            aria-label="Refresh audit logs"
            title="Refresh audit logs"
            className="surface-card p-1.5 text-xs bg-bg-elevated flex items-center gap-1.5 hover:bg-bg-base"
          >
            <RefreshCw className={`w-3.5 h-3.5 ${loading ? "animate-spin" : ""}`} aria-hidden />
          </button>
          <button
            type="button"
            onClick={handleExport}
            disabled={items.length === 0}
            aria-label="Export audit logs to CSV"
            title="Export audit logs to CSV"
            className="surface-card p-1.5 text-xs bg-bg-elevated flex items-center gap-1.5 hover:bg-bg-base disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <Download className="w-3.5 h-3.5" aria-hidden />
          </button>
        </div>
      </div>

      <p className="text-xs text-text-muted">
        {scope === "campus"
          ? "Campus scope hides infra-noise actions (auth, MFA, sessions, backups, retention, migrations, metrics, security, RLS)."
          : "All scope shows the complete trail. This view requires the sysadmin role."}
      </p>

      {/* Filters */}
      <div className="grid grid-cols-1 sm:grid-cols-4 gap-3">
        <input
          value={actionFilter}
          onChange={(e) => setActionFilter(e.target.value)}
          placeholder="Action (e.g. GATE_ONLINE)"
          aria-label="Filter by action"
          className="surface-card px-3 py-2 text-sm bg-bg-surface text-text-primary"
        />
        <input
          value={userIdFilter}
          onChange={(e) => setUserIdFilter(e.target.value)}
          placeholder="User ID"
          aria-label="Filter by user ID"
          className="surface-card px-3 py-2 text-sm bg-bg-surface text-text-primary"
        />
        <input
          type="date"
          value={fromFilter}
          onChange={(e) => setFromFilter(e.target.value)}
          aria-label="From date"
          title="From date"
          className="surface-card px-3 py-2 text-sm bg-bg-surface text-text-primary"
        />
        <input
          type="date"
          value={toFilter}
          onChange={(e) => setToFilter(e.target.value)}
          aria-label="To date"
          title="To date"
          className="surface-card px-3 py-2 text-sm bg-bg-surface text-text-primary"
        />
      </div>
      <div className="flex items-center gap-2">
        <button
          onClick={() => {
            setPage(1);
            setReloadKey((k) => k + 1);
          }}
          className="surface-card px-3 py-1.5 text-sm font-medium bg-action-primary text-white"
        >
          Apply
        </button>
        <button
          onClick={() => {
            setActionFilter("");
            setUserIdFilter("");
            setFromFilter("");
            setToFilter("");
            setPage(1);
          }}
          className="surface-card px-3 py-1.5 text-sm font-medium bg-bg-surface text-text-muted"
        >
          Reset
        </button>
      </div>

      {/* Table */}
      <div className="bg-bg-surface rounded-xl border border-border overflow-hidden">
        {error ? (
          <div className="p-6 text-action-danger text-sm flex items-center gap-2">
            <History className="w-4 h-4" /> {error}
          </div>
        ) : loading ? (
          <div className="p-8 text-center text-sm text-text-muted">Loading audit telemetry...</div>
        ) : items.length === 0 ? (
          <div className="p-8 text-center text-sm text-text-muted">No audit records found.</div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-sm min-w-[750px]">
              <thead className="bg-bg-elevated text-xs text-text-muted uppercase font-semibold border-b border-border">
                <tr>
                  <th className="py-2.5 px-4">Timestamp</th>
                  <th className="py-2.5 px-4">Action</th>
                  <th className="py-2.5 px-4">Actor</th>
                  <th className="py-2.5 px-4">Role</th>
                  <th className="py-2.5 px-4">Details</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {items.map((l) => (
                  <tr
                    key={l.id || l.timestamp}
                    onClick={() => setActive(l)}
                    className="hover:bg-bg-elevated cursor-pointer"
                  >
                    <td className="py-2.5 px-4 text-xs text-text-muted whitespace-nowrap">
                      {l.timestamp ? new Date(l.timestamp).toLocaleString("en-IN") : "—"}
                    </td>
                    <td className="py-2.5 px-4">
                      <code className="surface-card text-xs bg-bg-elevated px-1.5 py-0.5 text-action-success">
                        {l.action}
                      </code>
                    </td>
                    <td className="py-2.5 px-4 text-xs">{l.userName || l.userId || "N/A"}</td>
                    <td className="py-2.5 px-4 text-xs text-text-muted">{l.userRole || "—"}</td>
                    <td className="py-2.5 px-4 text-xs text-text-muted max-w-xs">
                      <span className="line-clamp-2">{JSON.stringify(l.details ?? {})}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <div className="surface-card p-3 flex items-center justify-between text-xs text-text-muted">
          <span>Total: {total} items</span>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={() => setPage((p) => Math.max(p - 1, 1))}
              disabled={page <= 1}
              aria-label="Previous page"
              title="Previous page"
              className="surface-card p-1 disabled:opacity-40"
            >
              <ChevronLeft className="w-3.5 h-3.5" aria-hidden />
            </button>
            <span>{page} / {totalPages}</span>
            <button
              type="button"
              onClick={() => setPage((p) => Math.min(p + 1, totalPages))}
              disabled={page >= totalPages}
              aria-label="Next page"
              title="Next page"
              className="surface-card p-1 disabled:opacity-40"
            >
              <ChevronRight className="w-3.5 h-3.5" aria-hidden />
            </button>
          </div>
        </div>
      </div>

      <EntityInspector
        inspection={
          active
            ? {
                kind: "audit_event",
                title: active.action,
                subtitle: active.id ?? active.timestamp,
                status: (
                  <span className="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-emerald-500/15 text-action-success">
                    RECORDED
                  </span>
                ),
                sections: [
                  {
                    title: "Overview",
                    content: (
                      <KVPairs
                        items={[
                          { label: "Action", value: <code className="font-mono">{active.action}</code> },
                          { label: "Actor", value: active.userName || active.userId || "—" },
                          { label: "Role", value: active.userRole ?? "—" },
                          {
                            label: "Recorded",
                            value: active.timestamp
                              ? new Date(active.timestamp).toLocaleString("en-IN")
                              : "—",
                          },
                        ]}
                      />
                    ),
                  },
                  {
                    title: "Details",
                    collapsible: true,
                    content: (
                      <pre className="text-xs font-mono whitespace-pre-wrap break-all max-h-60 overflow-auto surface-card bg-bg-elevated p-3">
                        {JSON.stringify(active.details ?? {}, null, 2)}
                      </pre>
                    ),
                  },
                  {
                    title: "Timeline",
                    collapsible: true,
                    content: (
                      <Timeline
                        items={auditEventTimeline(active)}
                      />
                    ),
                  },
                  {
                    title: "Actions",
                    content: (
                      <div className="flex flex-wrap gap-2">
                        <InspectorButton href="/admin/audit-logs" variant="primary">
                          <ChevronRight className="size-3.5" /> All audit events
                        </InspectorButton>
                      </div>
                    ),
                  },
                ],
                detailHref: "/admin/audit-logs",
                detailLabel: "Full audit trail",
              }
            : null
        }
        onClose={() => setActive(null)}
      />
    </div>
  );
}
