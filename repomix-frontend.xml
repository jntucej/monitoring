              </p>
            ) : (
              <Skeleton className="h-8 w-24" />
            )}
          </div>
        </WidgetBoundary>
      </div>

      {/* Charts */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <WidgetBoundary title="Traffic Volume">
          <div className="surface-card p-4 sm:p-5 space-y-4">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h3 className="text-sm font-semibold text-text-primary">Gate Traffic Flow</h3>
                <p className="text-xs text-text-muted">Entries versus exits over time</p>
              </div>
              <ChartTypeSwitcher value={trafficType} onChange={setTrafficType} />
            </div>
            {data ? (
              <ChartRenderer
                type={trafficType}
                data={trafficData}
                series={trafficSeries}
                xKey="date"
                height={280}
              />
            ) : (
              <Skeleton className="h70 w-full rounded-xl" />
            )}
          </div>
        </WidgetBoundary>

        <WidgetBoundary title="Campus Occupancy">
          <div className="surface-card p-4 sm:p-5 space-y-4">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h3 className="text-sm font-semibold text-text-primary">On-Campus Occupancy</h3>
