<file path="src/components/complaints/ComplaintConsole.tsx">
"use client";
// src/components/complaints/ComplaintConsole.tsx

import { useCallback, useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { HoverPreview, MetricPreview } from "@/components/shared/HoverPreview";
import { getAuthHeaders, cn } from "@/lib/utils";
import { useExport } from "@/hooks/useExport";
import { usePolling } from "@/hooks/usePolling";
import { getComplaintRulesForRole } from "@/lib/complaint-rules";
import { SmartTextRef } from "@/components/nav/SmartTextRef";
import {
  FileDown,
  AlertTriangle,
  Clock,
  TrendingUp,
  TrendingDown,
  GitBranch,
} from "lucide-react";

interface ComplaintItem {
  id: string;
  complaintNumber: string;
  categoryCode: string;
  categoryLabel: string;
  title: string;
  priority: string;
  status: string;
  currentOwnerRole: string;
  slaDeadline: string | null;
  createdAt: string;
  raisedByName: string | null;
}

type PeriodKey = "all" | "this-week" | "this-month" | "last-month";

function periodBounds(key: PeriodKey): { from?: string; to?: string } {
  const now = new Date();
  const d = (x: Date) => x.toISOString().slice(0, 10);
  switch (key) {
    case "this-week": {
      const start = new Date(now);
      start.setDate(now.getDate() - ((now.getDay() + 6) % 7));
      return { from: d(start) };
    }
    case "this-month":
      return { from: d(new Date(now.getFullYear(), now.getMonth(), 1)) };
    case "last-month":
      return {
        from: d(new Date(now.getFullYear(), now.getMonth() - 1, 1)),
        to: d(new Date(now.getFullYear(), now.getMonth(), 0)),
      };
    default:
      return {};
  }
}

/** Seconds until SLA deadline; negative = overdue. */
function slaSecondsLeft(deadline: string | null): number | null {
  if (!deadline) return null;
  return Math.floor((new Date(deadline).getTime() - Date.now()) / 1000);
}

export function ComplaintConsole({
  role,
  basePath,
  filterStatus,
  title = "Complaints",
}: {
  role: string;
  basePath: string;
  filterStatus?: string;
  title?: string;
}) {
  const [complaints, setComplaints] = useState<ComplaintItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [status, setStatus] = useState(filterStatus ?? "");
  const [period, setPeriod] = useState<PeriodKey>("all");
  const [mine, setMine] = useState(role === "student" ? "true" : "false");
  const { exportCSV } = useExport();

  const { from, to } = useMemo(() => periodBounds(period), [period]);

  const load = useCallback(async () => {
    setLoading(true);
    const params = new URLSearchParams();
    if (status) params.set("status", status);
    if (mine === "true") params.set("mine", "true");
    if (from) params.set("from", from);
    if (to) params.set("to", to);
    const r = await fetch(`/api/complaints?${params.toString()}`, { headers: getAuthHeaders() });
    const j = await r.json();
    setComplaints(j.data?.complaints ?? []);
    setLoading(false);
  }, [status, mine, from, to]);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  usePolling(load, { intervalMs: 30_000, enabled: true });

  // Resolution stats for the visible set
  const stats = useMemo(() => {
    const resolved = complaints.filter((c) => c.status === "resolved" || c.status === "closed");
    const overdue = complaints.filter(
      (c) => slaSecondsLeft(c.slaDeadline) !== null && slaSecondsLeft(c.slaDeadline)! < 0 && c.status !== "resolved" && c.status !== "closed"
    );
    return {
      total: complaints.length,
      resolved: resolved.length,
      resolutionRate: complaints.length > 0 ? Math.round((resolved.length / complaints.length) * 100) : 0,
      overdue: overdue.length,
    };
  }, [complaints]);

  const handleExport = () => {
    exportCSV(
      complaints.map((c) => ({
        ticket: c.complaintNumber,
        title: c.title,
        category: c.categoryLabel,
        status: c.status,
        owner: c.currentOwnerRole,
        createdAt: c.createdAt,
        sla: c.slaDeadline ?? "—",
      })),
      [
        { key: "ticket", header: "Ticket" },
        { key: "title", header: "Title" },
        { key: "category", header: "Category" },
        { key: "status", header: "Status" },
        { key: "owner", header: "Owner" },
        { key: "createdAt", header: "Raised" },
        { key: "sla", header: "SLA" },
      ],
      `complaints_${period}.csv`
    );
  };

  const PERIODS: Array<{ key: PeriodKey; label: string }> = [
    { key: "all", label: "All time" },
    { key: "this-week", label: "This week" },
    { key: "this-month", label: "This month" },
    { key: "last-month", label: "Last month" },
  ];

  return (
    <div className="space-y-4 max-w-6xl mx-auto">
      <div className="flex justify-between items-center flex-wrap gap-2">
        <h1 className="text-2xl font-semibold">{title}</h1>
        <div className="flex items-center gap-2">
          {role === "student" && (
            <Link href="/student/complaints/new" className="surface-card px-4 py-2 bg-bg-surface text-white text-sm">
              Raise complaint
            </Link>
          )}
          <button
            type="button"
            onClick={handleExport}
            disabled={complaints.length === 0}
            className="inline-flex items-center gap-1 px-3 py-2 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
          >
            <FileDown className="h-3.5 w-3.5" /> Export
          </button>
        </div>
      </div>

      {/* Period + status filter */}
      <div className="flex items-center gap-3 flex-wrap">
        <div className="inline-flex gap-0.5 bg-bg-elevated p-1">
          {PERIODS.map(({ key, label }) => (
            <button
              key={key}
              type="button"
              onClick={() => setPeriod(key)}
              className={cn(
                "rounded-md px-2.5 py-1 text-xs font-medium transition-colors",
                period === key ? "bg-action-primary text-white" : "text-text-secondary hover:bg-bg-surface"
              )}
            >
              {label}
            </button>
          ))}
        </div>
        <select value={status} onChange={(e) => setStatus(e.target.value)} className="surface-card p-2 text-sm">
          <option value="">All statuses</option>
          <option value="submitted">Submitted</option>
          <option value="acknowledged">Acknowledged</option>
          <option value="in_progress">In Progress</option>
          <option value="resolved">Resolved</option>
          <option value="closed">Closed</option>
        </select>
        {role !== "student" && (
          <select value={mine} onChange={(e) => setMine(e.target.value)} className="surface-card p-2 text-sm">
            <option value="false">Queue ({role})</option>
            <option value="true">My filings</option>
          </select>
        )}
      </div>

      {/* Stats strip */}
      {complaints.length > 0 && (
        <div className="grid grid-cols-3 gap-3">
          <div className="bg-bg-elevated p-2.5">
            <p className="text-xs text-text-muted">Resolution rate</p>
            <div className="flex items-center gap-1.5 mt-1">
              <span className="text-xl font-bold text-text-primary tabular-nums">{stats.resolutionRate}%</span>
              {stats.resolutionRate >= 50 ? (
                <TrendingUp className="h-4 w-4 text-action-success" />
              ) : (
                <TrendingDown className="h-4 w-4 text-action-danger" />
              )}
            </div>
            <p className="text-xs text-text-muted">{stats.resolved}/{stats.total} resolved</p>
          </div>
          <div className="bg-bg-elevated p-2.5">
            <p className="text-xs text-text-muted">Overdue SLA</p>
            <div className="flex items-center gap-1.5 mt-1">
              <span className="text-xl font-bold text-action-danger tabular-nums">{stats.overdue}</span>
              {stats.overdue > 0 && <AlertTriangle className="h-4 w-4 text-action-danger" />}
            </div>
            <p className="text-xs text-text-muted">past deadline, unresolved</p>
          </div>
          <div className="bg-bg-elevated p-2.5">
            <p className="text-xs text-text-muted">Total (period)</p>
            <span className="text-xl font-bold text-text-primary tabular-nums block mt-1">{stats.total}</span>
            <p className="text-xs text-text-muted">{period === "all" ? "all time" : period}</p>
          </div>
        </div>
      )}

      {loading ? (
        <p className="text-sm text-text-muted">Loading…</p>
      ) : complaints.length === 0 ? (
        <p className="text-sm text-text-muted">No complaints found.</p>
      ) : (
        <div className="border rounded divide-y bg-white">
          {complaints.map((c) => {
            const slaLeft = slaSecondsLeft(c.slaDeadline);
            const isOverdue = slaLeft !== null && slaLeft < 0 && c.status !== "resolved" && c.status !== "closed";
            const slaHours = slaLeft !== null ? Math.abs(Math.round(slaLeft / 3600)) : null;
            const rules = getComplaintRulesForRole(
              { role },
              {
                id: c.id,
                complaintNumber: c.complaintNumber,
                category: c.categoryLabel,
                status: c.status,
                currentStage: c.currentOwnerRole,
              },
            );
            return (
              <Link
                key={c.id}
                href={`${basePath}/${c.id}`}
                data-role-tier={rules.tierLabel.split("•")[0].trim().toLowerCase().replace(/\s+/g, "-")}
                data-event-mode={rules.mode}
                className="block p-2.5 hover:bg-bg-elevated transition"
              >
                <HoverPreview
                  preview={
                    <MetricPreview
                      label={c.categoryLabel}
                      value={c.title}
                      hint={`Owner ${c.currentOwnerRole} · ${
                        c.slaDeadline && new Date(c.slaDeadline).getTime() < Date.now() && c.status !== "resolved" && c.status !== "closed"
                          ? "SLA breached"
                          : "within SLA"
                      }`}
                    />
                  }
                >
                <div className="flex justify-between items-start">
                  <div>
                    <span className="font-mono text-xs text-text-muted">{c.complaintNumber}</span>
                    <h2 className="font-medium text-text-primary">
                      <SmartTextRef text={c.title} currentPath={basePath} />
                    </h2>
                    <p className="text-xs text-text-muted mt-0.5">
                      {c.categoryLabel} · Owner: <span className="font-mono">{c.currentOwnerRole}</span>
                    </p>
                  </div>
                  <div className="text-right space-y-1">
                    <span
                      className={cn(
                        "inline-block px-2 py-0.5 rounded-full text-xs font-medium uppercase",
                        c.status === "resolved" || c.status === "closed"
                          ? "bg-action-success/10 text-action-success"
                          : isOverdue
                            ? "bg-action-danger/10 text-action-danger"
                            : "bg-action-warning/10 text-action-warning"
                      )}
                    >
                      {c.status}
                    </span>
                    {slaHours !== null && !isOverdue && c.status !== "resolved" && c.status !== "closed" && (
                      <p className="text-xs text-text-muted flex items-center gap-1 justify-end">
                        <Clock className="h-3 w-3" /> SLA: {slaHours}h left
                      </p>
                    )}
                    {isOverdue && (
                      <div className="flex items-center gap-1 justify-end">
                        <AlertTriangle className="h-3 w-3 text-action-danger" />
                        <span className="text-xs font-medium text-action-danger">SLA breached — escalate</span>
                        <GitBranch className="h-3 w-3 text-action-danger/80" />
                      </div>
                    )}
                    <p className="text-xs text-text-muted">{new Date(c.createdAt).toLocaleDateString()}</p>
                  </div>
                </div>
                </HoverPreview>
              </Link>
            );
          })}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/complaints/ComplaintDetail.tsx">
"use client";
// src/components/complaints/ComplaintDetail.tsx

import { useCallback, useEffect, useState } from "react";
import { useParams } from "next/navigation";
import { getAuthHeaders } from "@/lib/utils";
import { useToast } from "@/components/ui/toast";
import { ComplaintTimeline } from "@/components/shared/complaints/ComplaintTimeline";
import { useAuthStore } from "@/stores/authStore";
import { resolveComplaintAbility, makeViewer } from "@/lib/record-abilities";
import { getComplaintRulesForRole } from "@/lib/complaint-rules";
import { RecordAbilityBanner } from "@/components/shared/RecordAbilityBanner";
import { SmartTextRef } from "@/components/nav/SmartTextRef";

export function ComplaintDetail({ role }: { role: string }) {
  const params = useParams();
  const id = params?.id as string;
  const { addToast } = useToast();
  const [data, setData] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [noteText, setNoteText] = useState("");
  const [resolutionSummary, setResolutionSummary] = useState("");
  const [rating, setRating] = useState(5);
  const [feedbackComment, setFeedbackComment] = useState("");
  const [file, setFile] = useState<File | null>(null);

  const load = useCallback(async () => {
    if (!id) return;
    setLoading(true);
    const r = await fetch(`/api/complaints/${id}`, { headers: getAuthHeaders() });
    const j = await r.json();
    setData(j.data);
    setLoading(false);
  }, [id]);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  const [actionError, setActionError] = useState<string | null>(null);

  const patchAction = async (action: string, extra: Record<string, unknown> = {}) => {
    setActionError(null);
    const prevData = data;

    // Optimistic local update
    if (data?.complaint) {
      const nextStatus =
        action === "resolve"
          ? "resolved"
          : action === "in_progress"
            ? "in_progress"
            : action === "acknowledge"
              ? "acknowledged"
              : action === "escalate"
                ? "escalated"
                : data.complaint.status;
      const nextTimeline =
        action === "add_note" && typeof extra.note === "string"
          ? [
              ...(data.timeline ?? []),
              {
                id: `optimistic-${Date.now()}`,
                action: "note",
                status: nextStatus,
                ownerRole: role,
                notes: extra.note,
                dueAt: null,
              },
            ]
          : data.timeline;
      setData({
        ...data,
        complaint: { ...data.complaint, status: nextStatus },
        timeline: nextTimeline,
      });
    }

    try {
      const r = await fetch(`/api/complaints/${id}`, {
        method: "PATCH",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ action, ...extra }),
      });
      const j = await r.json().catch(() => ({}));
      if (r.ok && j.success) {
        load();
      } else {
        // Rollback on failure (including 403 / 409)
        setData(prevData);
        const msg =
          r.status === 403
            ? "Permission denied (403): your role cannot perform this action."
            : r.status === 409
              ? "Conflict (409): this complaint was updated elsewhere. Rolled back."
              : j.error?.message ?? `Action failed (HTTP ${r.status})`;
        setActionError(msg);
      }
    } catch {
      setData(prevData);
      setActionError("Network error — changes rolled back.");
    }
  };

  const addNote = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!noteText.trim()) return;
    await patchAction("add_note", { note: noteText });
    setNoteText("");
  };

  const resolveComplaint = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!resolutionSummary.trim()) return;
    await patchAction("resolve", { resolutionSummary });
    setResolutionSummary("");
  };

  const submitFeedback = async (e: React.FormEvent) => {
    e.preventDefault();
    const r = await fetch(`/api/complaints/${id}/feedback`, {
      method: "POST",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({ rating, comment: feedbackComment }),
    });
    const j = await r.json();
    if (j.success) load();
    else addToast({ variant: "error", message: j.error?.message ?? "Failed to submit feedback" });
  };

  const uploadAttachment = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!file) return;
    const form = new FormData();
    form.append("files", file);
    const r = await fetch(`/api/complaints/${id}/attachments`, {
      method: "POST",
      headers: getAuthHeaders(),
      body: form,
    });
    const j = await r.json();
    if (j.success) {
      setFile(null);
      load();
    } else addToast({ variant: "error", message: j.error?.message ?? "Upload failed" });
  };

  if (loading) return <p className="text-text-muted">Loading…</p>;
  if (!data?.complaint) return <p className="text-text-muted">Complaint not found.</p>;

  const c = data.complaint;

  const isAuthority = role !== "student";

  // Role-ability layer: why THIS role is on this complaint. The real action
  // buttons below are still gated by `role` + status; this is the reason
  // banner + the role's next-step pivots.
  const viewer = makeViewer(role, {
    userId: useAuthStore.getState().user?.id ?? "",
    hostelScope: useAuthStore.getState().user?.studentDetails?.hostelBlock ?? null,
  });
  const ability = resolveComplaintAbility(
    {
      id: c.id ?? id,
      complaint_number: c.complaintNumber,
      category: c.categoryLabel ?? c.category,
      status: c.status,
      current_stage: c.currentOwnerRole,
      raised_by_user_id: c.filer_user_id ?? c.raised_by_user_id,
      hostel_scope: c.hostel_scope ?? null,
    },
    viewer,
  );

  const complaintRules = getComplaintRulesForRole(
    {
      role,
      userId: useAuthStore.getState().user?.id ?? "",
      hostelScope: useAuthStore.getState().user?.studentDetails?.hostelBlock ?? null,
    },
    {
      id: c.id ?? id,
      complaintNumber: c.complaintNumber,
      category: c.categoryLabel ?? c.category,
      status: c.status ?? "OPEN",
      currentStage: c.currentOwnerRole,
      raisedByUserId: c.filer_user_id ?? c.raised_by_user_id,
      hostelScope: c.hostel_scope ?? null,
    },
  );

  return (
    <div
      className="max-w-4xl mx-auto space-y-6"
      data-role-tier={complaintRules.tierLabel.split("•")[0].trim().toLowerCase().replace(/\s+/g, "-")}
      data-event-mode={complaintRules.mode}
    >
      <div className="surface-card pb-4">
        <span className="font-mono text-xs text-text-muted">{c.complaintNumber}</span>
        <h1 className="text-2xl font-semibold text-text-primary mt-1">{c.title}</h1>
        <p className="text-sm text-text-muted mt-1">
          {c.categoryLabel} · Status: <strong className="uppercase">{c.status}</strong> · Owner:{" "}
          <span className="font-mono">{c.currentOwnerRole}</span>
        </p>
      </div>

      {/* Role-ability banner: why this role is on this complaint */}
      <RecordAbilityBanner
        ability={ability}
        fullRoute={role === "student" ? `/student/complaints/${id}` : `/complaints/${id}`}
      />

      {actionError && (
        <div
          role="alert"
          data-testid="complaint-action-error"
          className="surface-card bg-rose-500/10 px-3 py-2 text-xs text-action-danger"
        >
          {actionError}
        </div>
      )}

      <div className="surface-card bg-bg-elevated p-2.5 space-y-2">
        <h2 className="font-medium text-text-primary">Description</h2>
        <p className="text-sm text-text-muted whitespace-pre-wrap">
          <SmartTextRef text={c.description ?? ""} currentPath="/complaints" />
        </p>
      </div>

      {(c.targetRole || c.targetUserId || c.presenceMark) && (
        <div
          data-testid="complaint-hierarchy-target"
          className="surface-card bg-bg-elevated p-2.5 space-y-1 text-xs"
        >
          <h2 className="font-medium text-text-primary">Hierarchy Target &amp; Presence</h2>
          <div className="flex flex-wrap gap-2 text-text-muted">
            {c.targetRole && (
              <span>
                Target Role: <strong className="text-text-primary">{c.targetRole}</strong>
              </span>
            )}
            {c.targetUserId && (
              <span>
                Person: <strong className="font-mono text-text-primary">{c.targetUserId}</strong>
              </span>
            )}
            {c.presenceMark && (
              <span>
                Presence: <strong className="text-text-primary">{c.presenceMark}</strong>
              </span>
            )}
          </div>
          {c.presenceNote && (
            <p className="text-text-muted">{c.presenceNote}</p>
          )}
        </div>
      )}

      {c.respondent_details && (
        <div className="surface-card bg-bg-elevated p-2.5 space-y-2">
          <h2 className="font-medium text-text-primary">About</h2>
          <p className="text-sm text-text-muted">
            <span className="font-medium text-text-primary font-mono">
              <SmartTextRef text={c.respondent_details} currentPath="/complaints" />
            </span>
            <p className="mt-1 text-xs text-text-muted">
              The person this complaint concerns, as identified by the filer.
            </p>
          </p>
        </div>
      )}

      {/* Lifecycle timeline (the TRACK step) */}
      <div className="surface-card bg-bg-elevated p-2.5">
        <h2 className="font-medium text-text-primary mb-3">Status timeline</h2>
        <ComplaintTimeline
          events={(data.timeline ?? []).map((t: { status: string; at: string; note?: string }) => ({
            status: t.status,
            at: t.at,
            note: t.note,
          }))}
          currentStatus={c.status}
        />
        {c.resolutionSummary && (
          <div className="mt-3 pt-3">
            <h3 className="font-medium text-action-success">Resolution Summary</h3>
            <p className="text-sm text-action-success">{c.resolutionSummary}</p>
          </div>
        )}
      </div>

      {/* Authority Action Buttons */}
      {isAuthority && (
        <div className="flex gap-2 flex-wrap">
          {c.status === "submitted" && (
            <button onClick={() => patchAction("acknowledge")} className="px-3 py-1.5 bg-action-info text-white text-sm">
              Acknowledge
            </button>
          )}
          {["submitted", "acknowledged"].includes(c.status) && (
            <button onClick={() => patchAction("start")} className="px-3 py-1.5 bg-action-warning text-white text-sm">
              Start work
            </button>
          )}
          {["submitted", "acknowledged", "in_progress"].includes(c.status) && (
            <div className="w-full mt-2 pt-2 flex gap-2 items-center">
              <input
                placeholder="Resolution summary…"
                value={resolutionSummary}
                onChange={(e) => setResolutionSummary(e.target.value)}
                className="p-1.5 text-sm flex-1 border border-border"
              />
              <button onClick={resolveComplaint} className="px-3 py-1.5 bg-action-success text-white text-sm">
                Resolve
              </button>
            </div>
          )}
          <button onClick={() => patchAction("escalate")} className="px-3 py-1.5 bg-bg-elevated text-white text-sm">
            Forward / Escalate
          </button>
          <button onClick={() => patchAction("reject")} className="px-3 py-1.5 bg-action-danger text-white text-sm">
            Reject
          </button>
        </div>
      )}

      {/* Student action buttons: cancel (within 24h) */}
      {role === "student" && !["resolved", "closed", "rejected"].includes(c.status) && (
        <div className="surface-card flex gap-2 p-2.5 bg-bg-elevated">
          <button
            onClick={() => patchAction("cancel")}
            className="px-3 py-1.5 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-600 text-xs font-medium hover:bg-rose-500/20"
          >
            Cancel complaint (within 24h)
          </button>
          {c.slaDeadline && new Date(c.slaDeadline).getTime() < Date.now() && (
            <button
              onClick={() => patchAction("escalate")}
              className="px-3 py-1.5 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-600 text-xs font-medium hover:bg-amber-500/20"
            >
              Escalate (SLA breached)
            </button>
          )}
        </div>
      )}

      {/* Feedback section for student when resolved */}
      {role === "student" && ["resolved", "awaiting_verification"].includes(c.status) && !data.feedback && (
        <form onSubmit={submitFeedback} className="surface-card p-2.5 bg-action-success/10 space-y-3">
          <h2 className="font-medium text-text-primary">Leave resolution feedback</h2>
          <div className="flex gap-2 items-center">
            <label className="text-sm">Rating (1-5):</label>
            <select value={rating} onChange={(e) => setRating(Number(e.target.value))} className="surface-card p-1 text-sm">
              <option value="5">5 - Excellent</option>
              <option value="4">4 - Good</option>
              <option value="3">3 - Average</option>
              <option value="2">2 - Bad</option>
              <option value="1">1 - Very Bad</option>
            </select>
          </div>
          <textarea
            placeholder="Comments (optional)"
            value={feedbackComment}
            onChange={(e) => setFeedbackComment(e.target.value)}
            className="surface-card w-full p-2 text-sm bg-bg-surface"
          />
          <button type="submit" className="surface-card px-3 py-1.5 bg-action-success text-white text-sm">
            Submit & Close
          </button>
        </form>
      )}

      {/* Tasks / Timeline */}
      <div className="space-y-3">
        <h2 className="font-medium text-text-primary">Timeline & Tasks</h2>
        <div className="surface-card divide-y text-sm">
          {data.tasks.map((t: any) => (
            <div key={t.id} className="p-3 space-y-1">
              <div className="flex justify-between font-medium">
                <span>{t.action}</span>
                <span className="uppercase text-xs text-text-muted font-mono">{t.status}</span>
              </div>
              <p className="text-xs text-text-muted">Role: {t.ownerRole} · Due: {t.dueAt ? new Date(t.dueAt).toLocaleString() : "None"}</p>
              {t.notes && <p className="surface-card text-text-muted mt-1 bg-bg-elevated p-2 font-mono"><SmartTextRef text={t.notes} currentPath="/complaints" /></p>}
            </div>
          ))}
        </div>

        {/* Add Note */}
        <form onSubmit={addNote} className="flex gap-2 pt-2">
          <input
            placeholder="Add internal note / comment…"
            value={noteText}
            onChange={(e) => setNoteText(e.target.value)}
            className="surface-card p-2 text-sm flex-1"
          />
          <button type="submit" className="surface-card px-3 py-2 bg-bg-elevated text-white text-sm">
            Post note
          </button>
        </form>
      </div>

      {/* Attachments */}
      <div className="surface-card space-y-3 pt-4">
        <h2 className="font-medium text-text-primary">Attachments</h2>
        <div className="flex flex-wrap gap-2">
          {data.attachments.map((a: any) => (
            <a
              key={a.id}
              href={`/api/complaints/${id}/attachments/${a.id}`}
              target="_blank"
              rel="noreferrer"
              className="surface-card px-3 py-1.5 bg-bg-surface text-xs hover:bg-bg-elevated flex items-center gap-1.5"
            >
              <span>{a.name}</span>
              {a.internal && <span className="surface-card text-xs bg-action-warning/20 text-action-warning px-1">Internal</span>}
            </a>
          ))}
        </div>
        <form onSubmit={uploadAttachment} className="flex gap-2 items-center pt-2">
          <input type="file" onChange={(e) => setFile(e.target.files?.[0] ?? null)} className="text-sm" />
          <button type="submit" disabled={!file} className="surface-card px-3 py-1.5 bg-bg-elevated text-white text-sm">
            Upload file
          </button>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="src/components/complaints/ComplaintForm.tsx">
"use client";
// src/components/complaints/ComplaintForm.tsx

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { getAuthHeaders } from "@/lib/utils";
import { useToast } from "@/components/ui/toast";
import { useIsSakuga } from "@/components/student/useIsSakuga";
import {
  HierarchyTargetPicker,
  type HierarchyTargetSelection,
  type RoleCandidatePerson,
} from "@/components/complaints/HierarchyTargetPicker";

export function ComplaintForm() {
  const router = useRouter();
  const { addToast } = useToast();
  const isSakuga = useIsSakuga();
  const [categories, setCategories] = useState<any[]>([]);
  const [selectedCode, setSelectedCode] = useState("");
  const [form, setForm] = useState({
    title: "",
    description: "",
    location: "",
    priority: "medium",
    isAnonymous: false,
    girlsCell: false,
    respondentDetails: "",
  });
  const [busy, setBusy] = useState(false);
  const [target, setTarget] = useState<HierarchyTargetSelection>({
    targetRole: "caretaker",
    targetUserId: null,
    presenceMark: "unknown",
    presenceNote: "",
  });
  const [peopleInRole, setPeopleInRole] = useState<RoleCandidatePerson[]>([]);
  const [loadingPeople, setLoadingPeople] = useState(false);

  useEffect(() => {
    let cancelled = false;
    setLoadingPeople(true);
    fetch(`/api/persons?role=${encodeURIComponent(target.targetRole)}&limit=50`, {
      headers: getAuthHeaders(),
    })
      .then((r) => r.json())
      .then((j) => {
        if (cancelled) return;
        const list = Array.isArray(j?.data) ? j.data : [];
        setPeopleInRole(
          list.map((p: { id: string; fullName?: string; name?: string; designation?: string | null; department?: string | null; isOnCampus?: boolean | null }) => ({
            id: p.id,
            name: p.fullName || p.name || p.id,
            designation: p.designation ?? null,
            departmentOrScope: p.department ?? null,
            isOnCampus: p.isOnCampus ?? null,
          })),
        );
      })
      .catch(() => {
        if (!cancelled) setPeopleInRole([]);
      })
      .finally(() => {
        if (!cancelled) setLoadingPeople(false);
      });
    return () => {
      cancelled = true;
    };
  }, [target.targetRole]);

  useEffect(() => {
    (async () => {
      const r = await fetch("/api/complaints/categories", { headers: getAuthHeaders() });
      const j = await r.json();
      setCategories(j.data?.categories ?? []);
    })();
  }, []);

  const selected = categories.find((c) => c.code === selectedCode);

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    setBusy(true);
    const r = await fetch("/api/complaints", {
      method: "POST",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({
        categoryCode: selectedCode,
        ...form,
        targetRole: target.targetRole,
        targetUserId: target.targetUserId,
        presenceMark: target.presenceMark,
        presenceNote: target.presenceNote,
      }),
    });
    const j = await r.json();
    setBusy(false);
    if (j.success) router.push(`/student/complaints/${j.data.complaintId}`);
    else addToast({ variant: "error", message: j.error?.message ?? "Failed to submit complaint" });
  };

  return (
    <form onSubmit={submit} className="surface-card max-w-2xl space-y-4 p-6 bg-white">
      <div>
        <label className="block text-sm font-medium text-text-muted mb-1" htmlFor="complaint-category">Complaint Category</label>
        <select id="complaint-category"
          required
          value={selectedCode}
          onChange={(e) => setSelectedCode(e.target.value)}
          className="surface-card w-full p-2 text-sm"
        >
          <option value="">Select category…</option>
          {categories.map((c) => (
            <option key={c.code} value={c.code}>
              {c.code} — {c.label}
            </option>
          ))}
        </select>
        {selected && (
          <p className="text-xs text-text-muted mt-1">
            Will route to: <strong className="font-mono">{selected.ownerRole}</strong> · SLA {selected.slaHours}h
            {selected.isStatutory && " · statutory category"}
          </p>
        )}
      </div>

      <div>
        <label className="block text-sm font-medium text-text-muted mb-1" htmlFor="title">Title</label>
        {isSakuga ? (
          <sakuga-input
            id="title"
            required
            placeholder="Brief summary of the issue"
            value={form.title}
            onChange={((e: unknown) => setForm({ ...form, title: (e as any).target?.value ?? '' })) as any}
            label="complaint title"
            className="w-full"
          />
        ) : (
          <input id="title"
            required
            placeholder="Brief summary of the issue"
            value={form.title}
            onChange={(e) => setForm({ ...form, title: e.target.value })}
            className="surface-card w-full p-2 text-sm"
          />
        )}
      </div>

      <div>
        <label className="block text-sm font-medium text-text-muted mb-1" htmlFor="description">Description</label>
        <textarea id="description"
          required
          rows={5}
          placeholder="Provide detailed information…"
          value={form.description}
          onChange={(e) => setForm({ ...form, description: e.target.value })}
          className="surface-card w-full p-2 text-sm"
        />
      </div>

      <div>
        <label className="block text-sm font-medium text-text-muted mb-1" htmlFor="location-optional">Location (optional)</label>
        <input id="location-optional"
          placeholder="e.g. Hostel A, Room 204"
          value={form.location}
          onChange={(e) => setForm({ ...form, location: e.target.value })}
          className="surface-card w-full p-2 text-sm"
        />
      </div>

      <div>
        <label className="block text-sm font-medium text-text-muted mb-1" htmlFor="respondent-optional">
          This complaint is about (optional)
        </label>
        <input id="respondent-optional"
          placeholder="Who it concerns — a roll / employee ID, or details identifying the person (e.g. 'Physics faculty, Dr. X, office 204')"
          value={form.respondentDetails}
          onChange={(e) => setForm({ ...form, respondentDetails: e.target.value })}
          className="surface-card w-full p-2 text-sm"
        />
        <p className="mt-1 text-xs text-text-muted">
          Leave blank if the complaint is not about a specific person. Details you provide are
          shared with the reviewing authority only.
        </p>
      </div>

      <div className="surface-card space-y-2 pt-2">
        {selected?.anonymousAllowed && (
          isSakuga ? (
            <div className="flex gap-2 items-center text-sm">
              <sakuga-checkbox
                checked={form.isAnonymous}
                onChange={((e: unknown) => setForm({ ...form, isAnonymous: Boolean((e as any).target?.checked ?? (e as any)) })) as any}
                label="anonymous"
              >
                Submit anonymously
              </sakuga-checkbox>
            </div>
          ) : (
            <label className="flex gap-2 items-center text-sm">
              <input
                type="checkbox"
                checked={form.isAnonymous}
                onChange={(e) => setForm({ ...form, isAnonymous: e.target.checked })}
              />
              <span>Submit anonymously</span>
            </label>
          )
        )}
        {selected?.girlsCellEligible && (
          isSakuga ? (
            <div className="flex gap-2 items-center text-sm">
              <sakuga-checkbox
                checked={form.girlsCell}
                onChange={((e: unknown) => setForm({ ...form, girlsCell: Boolean((e as any).target?.checked ?? (e as any)) })) as any}
                label="girls-cell"
              >
                Route to Girls Grievance Cell
              </sakuga-checkbox>
            </div>
          ) : (
            <label className="flex gap-2 items-center text-sm">
              <input
                type="checkbox"
                checked={form.girlsCell}
                onChange={(e) => setForm({ ...form, girlsCell: e.target.checked })}
              />
              <span>Route to Girls Grievance Cell</span>
            </label>
          )
        )}
      </div>

      <HierarchyTargetPicker
        peopleInRole={peopleInRole}
        loadingPeople={loadingPeople}
        value={target}
        onChange={setTarget}
      />

      {isSakuga ? (
        <div className="flex justify-center">
          <sakuga-button
            type="submit"
            disabled={busy || !selectedCode}
            variant="primary"
            label={busy ? "Submitting…" : "Submit complaint"}
          >
            {busy ? "Submitting…" : "Submit complaint"}
          </sakuga-button>
        </div>
      ) : (
        <button
          type="submit"
          disabled={busy || !selectedCode}
          className="surface-card px-4 py-2 bg-bg-surface text-white text-sm font-medium disabled:opacity-50"
        >
          {busy ? "Submitting…" : "Submit complaint"}
        </button>
      )}
    </form>
  );
}
</file>

<file path="src/components/complaints/ComplaintMonthlyReviewPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  MessageSquare,
  AlertTriangle,
  CheckCircle,
  Clock,
  TrendingUp,
  TrendingDown,
  Minus,
  FileDown,
  RefreshCw,
} from "lucide-react";
import { usePeriod } from "@/hooks/usePeriod";
import { useExport } from "@/hooks/useExport";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface ComplaintReviewPayload {
  data: {
    period: string;
    range: { from: string; to: string };
    summary: {
      total: number;
      resolved: number;
      open: number;
      avgResolutionHours: number;
      lastMonthTotal: number;
      lastMonthResolved: number;
      totalDelta: number;
      resolutionRate: number;
    };
    trend: Array<{ day: string; count: number }>;
    topCategories: Array<{ code: string; count: number }>;
  };
}

// ── Component ─────────────────────────────────────────────────────────────

export function ComplaintMonthlyReviewPanel() {
  const { period, setPeriod } = usePeriod("this-month");
  const { exportCSV } = useExport();
  const [data, setData] = useState<ComplaintReviewPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `/api/complaints/monthly-review?period=${period.key === "all-time" ? "this-month" : period.key}`,
        { headers: getAuthHeaders(), cache: "no-store" }
      );
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load");
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [period.key]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      [
        ...data.trend.map((t) => ({ day: t.day, complaints: t.count })),
        { day: "TOTAL", complaints: data.summary.total },
        { day: "RESOLVED", complaints: data.summary.resolved },
        { day: "OPEN", complaints: data.summary.open },
      ],
      [
        { key: "day", header: "Day" },
        { key: "complaints", header: "Count" },
      ],
      `complaints_${data.period.replace(/\s/g, "_")}.csv`
    );
  };

  const s = data?.summary;
  const trendMax = Math.max(1, ...(data?.trend.map((t) => t.count ?? 0) ?? [0]));

  return (
    <WidgetBoundary name="ComplaintMonthlyReviewPanel" resetKey={period.key}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <MessageSquare className="h-4 w-4 text-action-danger shrink-0" />
            <div>
              <h2 className="text-sm font-semibold text-text-primary">Complaints Monthly Review</h2>
              <p className="text-xs text-text-muted">Trend, resolution time & top categories</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              disabled={!data}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
            <button
              type="button"
              onClick={() => void load()}
              className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-surface"
            >
              <RefreshCw className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        <PeriodPicker value={period} onChange={setPeriod} allowCustom={false} />

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <Skeleton className="h-14 rounded-xl" />
            <Skeleton className="h-32 rounded-xl" />
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-rose-500/10 p-4 text-sm text-rose-600">
            <AlertTriangle className="h-4 w-4 inline mr-1" /> {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {s && !loading && (
          <>
            {/* KPI row */}
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div className="rounded-xl border border-border bg-bg-elevated p-4">
                <p className="text-xs text-text-muted">Complaints</p>
                <div className="flex items-center gap-1.5 mt-1">
                  <span className="text-2xl font-bold text-text-primary tabular-nums">{s.total}</span>
                  {s.lastMonthTotal > 0 && (
                    <DeltaBadge value={s.total} reference={s.lastMonthTotal} label="" higherIsBetter={false} />
                  )}
                </div>
              </div>

              <div className="rounded-xl border border-border bg-bg-elevated p-4">
                <p className="text-xs text-text-muted">Resolution rate</p>
                <p className="text-2xl font-bold text-text-primary tabular-nums mt-1">{s.resolutionRate}%</p>
                <p className="text-xs text-text-muted">{s.resolved}/{s.total} resolved</p>
              </div>

              <div className="rounded-xl border border-border bg-bg-elevated p-4">
                <p className="text-xs text-text-muted">Avg resolution</p>
                <div className="flex items-center gap-1.5 mt-1">
                  <Clock className="h-4 w-4 text-text-muted" />
                  <span className="text-2xl font-bold text-text-primary tabular-nums">{s.avgResolutionHours}h</span>
                </div>
              </div>

              <div className="rounded-xl border border-border bg-bg-elevated p-4">
                <p className="text-xs text-text-muted">Open</p>
                <p className={cn("text-2xl font-bold tabular-nums mt-1", s.open > 0 ? "text-rose-500" : "text-emerald-500")}>
                  {s.open}
                </p>
              </div>
            </div>

            {/* Trend bar chart */}
            {data && data.trend.length > 0 && (
              <div className="rounded-xl border border-border bg-bg-elevated p-4">
                <p className="text-xs font-medium text-text-muted mb-3">Daily trend</p>
                <div className="flex items-end gap-0.5 h-24">
                  {data.trend.map((t) => (
                    <div key={t.day} className="flex-1 flex flex-col items-center gap-0.5 min-w-0">
                      <div
                        className={cn(
                          "w-full rounded-t-sm transition-all",
                          t.count === 0 ? "bg-bg-surface" : "bg-rose-500/70"
                        )}
                        style={{ height: `${Math.max(4, (t.count / trendMax) * 80)}px` }}
                        title={`${t.day}: ${t.count}`}
                      />
                      <span className="text-[9px] text-text-muted tabular-nums">{t.day.slice(8)}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Top categories */}
            {data && data.topCategories.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">Top categories</p>
                <div className="flex flex-wrap gap-2">
                  {data.topCategories.map((c) => (
                    <div
                      key={c.code}
                      className="rounded-lg bg-bg-elevated border border-border px-3 py-2 text-xs flex items-center gap-2"
                    >
                      <span className="font-medium text-text-primary">{c.code}</span>
                      <span className="text-rose-500 font-bold tabular-nums">{c.count}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </>
        )}

        {s && s.total === 0 && !loading && (
          <EmptyState title="No complaints in this period" description="A clean month!" />
        )}
      </div>
    </WidgetBoundary>
  );
}

export default ComplaintMonthlyReviewPanel;
</file>

<file path="src/components/complaints/HierarchyTargetPicker.tsx">
"use client";

import React from "react";

export type PresenceMark = "present" | "not_present" | "unknown";

export interface HierarchyRoleOption {
  roleCode: string;
  label: string;
}

export interface RoleCandidatePerson {
  id: string;
  name: string;
  designation?: string | null;
  departmentOrScope?: string | null;
  isOnCampus?: boolean | null;
}

export interface HierarchyTargetSelection {
  targetRole: string;
  targetUserId: string | null; // null = any available person in targetRole
  presenceMark: PresenceMark;
  presenceNote: string;
}

export const HIERARCHY_ROLE_OPTIONS: HierarchyRoleOption[] = [
  { roleCode: "caretaker", label: "Caretaker" },
  { roleCode: "hostel_manager", label: "Hostel Manager" },
  { roleCode: "deputy_warden", label: "Deputy Warden" },
  { roleCode: "hod", label: "Head of Department (HOD)" },
  { roleCode: "faculty", label: "Faculty" },
  { roleCode: "emo", label: "Estate / Maintenance (EMO)" },
  { roleCode: "exam_branch", label: "Exam Branch" },
  { roleCode: "principal", label: "Principal (Warden)" },
  { roleCode: "admin", label: "Admin" },
];

export function HierarchyTargetPicker({
  roles = HIERARCHY_ROLE_OPTIONS,
  peopleInRole,
  loadingPeople = false,
  value,
  onChange,
}: {
  roles?: HierarchyRoleOption[];
  peopleInRole: RoleCandidatePerson[];
  loadingPeople?: boolean;
  value: HierarchyTargetSelection;
  onChange: (next: HierarchyTargetSelection) => void;
}) {
  return (
    <div
      data-testid="hierarchy-target-picker"
      className="surface-card bg-bg-surface p-3.5 space-y-3"
    >
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {/* 1. Target role in hierarchy */}
        <div className="space-y-1">
          <label className="text-xs font-semibold text-text-muted">
            Direct To Hierarchy Role
          </label>
          <select
            value={value.targetRole}
            onChange={(e) =>
              onChange({
                ...value,
                targetRole: e.target.value,
                targetUserId: null,
              })
            }
            className="w-full rounded-lg border border-border bg-bg-base px-2.5 py-2 text-xs font-medium text-text-primary"
          >
            {roles.map((r) => (
              <option key={r.roleCode} value={r.roleCode}>
                {r.label}
              </option>
            ))}
          </select>
        </div>

        {/* 2. Optional specific person from that role */}
        <div className="space-y-1">
          <label className="text-xs font-semibold text-text-muted">
            Specific Person (Optional)
          </label>
          <select
            disabled={loadingPeople}
            value={value.targetUserId ?? ""}
            onChange={(e) =>
              onChange({
                ...value,
                targetUserId: e.target.value ? e.target.value : null,
              })
            }
            className="w-full rounded-lg border border-border bg-bg-base px-2.5 py-2 text-xs font-medium text-text-primary disabled:opacity-60"
          >
            <option value="">
              {loadingPeople ? "Loading people..." : "Any available person in this role"}
            </option>
            {peopleInRole.map((p) => (
              <option key={p.id} value={p.id}>
                {p.name}
                {p.designation ? ` — ${p.designation}` : ""}
                {p.isOnCampus === true
                  ? " (On Campus)"
                  : p.isOnCampus === false
                  ? " (Off Campus)"
                  : ""}
              </option>
            ))}
          </select>
        </div>
      </div>

      {/* 3. Presence / availability mark */}
      <div className="space-y-1.5 pt-2 border-t border-border">
        <span className="text-xs font-semibold text-text-muted">
          Presence / Availability Mark
        </span>
        <div className="flex flex-wrap gap-2">
          {(
            [
              { id: "present", label: "Marked Present" },
              { id: "not_present", label: "Not Present / Absent" },
              { id: "unknown", label: "Not Checked" },
            ] as const
          ).map((opt) => {
            const active = value.presenceMark === opt.id;
            return (
              <button
                key={opt.id}
                type="button"
                onClick={() => onChange({ ...value, presenceMark: opt.id })}
                className={`rounded-lg border px-2.5 py-1 text-xs font-medium transition-colors ${
                  active
                    ? "border-action-primary bg-action-primary text-white"
                    : "border-border bg-bg-base text-text-primary hover:bg-bg-elevated"
                }`}
              >
                {opt.label}
              </button>
            );
          })}
        </div>

        <input
          type="text"
          value={value.presenceNote}
          onChange={(e) => onChange({ ...value, presenceNote: e.target.value })}
          placeholder="Optional presence/location context (e.g., not in office at 11:00 AM, block B)..."
          className="mt-1.5 w-full rounded-lg border border-border bg-bg-base px-2.5 py-1.5 text-xs text-text-primary"
        />
      </div>
    </div>
  );
}
</file>

<file path="src/components/dashboard/dashboard-shared.tsx">
/* ------------------------------------------------------------------ *
 *  Dashboard shared primitives — small presentational building blocks
 *  reused across the dashboard pages.
 * ------------------------------------------------------------------ */

import type { ReactNode } from "react";

interface CardDivProps {
  children: ReactNode;
