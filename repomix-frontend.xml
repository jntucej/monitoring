                    <span className="text-3xl font-bold text-text-primary tabular-nums">{s.total}</span>
                    {s.lastMonthTotal > 0 && (
                      <DeltaBadge value={s.total} reference={s.lastMonthTotal} label="vs LM" />
                    )}
