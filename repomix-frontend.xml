<file path="src/components/security/GateLogsPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";

interface GateOption {
  id: string;
  name: string;
  gate_id: string | null;
}

interface GateLogRow {
  id: string;
  roll_no: string | null;
  person_name: string | null;
  direction: string | null;
  timestamp: string;
  operator_name: string | null;
  outcome: string | null;
  curfew_violation: boolean | null;
}

export function GateLogsPanel() {
  const [gates, setGates] = useState<GateOption[]>([]);
  const [gateId, setGateId] = useState("");
  const [filter, setFilter] = useState("");
  const [logs, setLogs] = useState<GateLogRow[]>([]);

  useEffect(() => {
    fetch("/api/security/locations")
      .then((r) => r.json())
      .then((j) => {
        const list: GateOption[] = (j?.data?.locations ?? []).filter(
          (l: GateOption) => Boolean(l.gate_id),
        );
        setGates(list);
        if (list[0]?.gate_id) setGateId(list[0].gate_id);
      })
      .catch(() => {});
  }, []);

  const loadLogs = useCallback(() => {
    if (!gateId) return;
    fetch(`/api/security/gates/${gateId}/logs?q=${encodeURIComponent(filter)}`)
      .then((r) => r.json())
      .then((j) => setLogs(j?.data?.logs ?? []))
      .catch(() => {});
  }, [gateId, filter]);

  useEffect(() => {
    loadLogs();
  }, [loadLogs]);

  return (
    <div className="space-y-4">
      <div className="flex flex-wrap items-center gap-2">
        <select
          value={gateId}
          onChange={(e) => setGateId(e.target.value)}
          className="border border-border bg-background px-3 py-1.5 text-sm text-foreground"
        >
          {gates.length === 0 && <option value="">No geo-linked gates yet</option>}
          {gates.map((g) => (
            <option key={g.id} value={g.gate_id ?? ""}>
              {g.name}
            </option>
          ))}
        </select>
        <input
          type="text"
          value={filter}
          onChange={(e) => setFilter(e.target.value)}
          placeholder="Type to filter roll, name, direction..."
          className="flex-1 border border-border bg-background px-3 py-1.5 text-sm text-foreground"
        />
        {gateId && (
          <a
            href={`/api/security/gates/${gateId}/logs.csv`}
            className="bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground"
          >
            Download CSV
          </a>
        )}
      </div>

      <div className="divide-y divide-border">
        {logs.length === 0 ? (
          <div className="py-4 text-xs text-muted-foreground">No movement logs for this gate.</div>
        ) : (
          logs.map((l) => (
            <div key={l.id} className="flex items-center justify-between py-2 text-sm text-foreground">
              <span>
                <strong>{l.direction}</strong> • {l.roll_no ?? "—"} {l.person_name ?? ""}
                {l.curfew_violation ? " (CURFEW)" : ""}
              </span>
              <span className="text-xs text-muted-foreground">
                {new Date(l.timestamp).toLocaleString()} • {l.operator_name ?? "System"}
              </span>
            </div>
          ))
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/security/GuardOnShift.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import { SosInbox, type OfferedDispatch } from "./SosInbox";
import { SosResponder } from "./SosResponder";

export function GuardOnShift() {
  const [shiftInfo, setShiftInfo] = useState<{ post_kind: string; gate_id: string | null } | null>(null);
  const [dispatches, setDispatches] = useState<Array<OfferedDispatch & { status: string }>>([]);

  const loadDispatches = useCallback(() => {
    fetch("/api/sos/me")
      .then((r) => r.json())
      .then((j) => setDispatches(j?.data?.dispatches ?? []))
      .catch(() => {});
  }, []);

  useEffect(() => {
    loadDispatches();
    const id = setInterval(loadDispatches, 5000);
    return () => clearInterval(id);
  }, [loadDispatches]);

  useEffect(() => {
    const ping = () => {
      if (typeof navigator !== "undefined" && navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            fetch("/api/security/ping", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                lat: pos.coords.latitude,
                lng: pos.coords.longitude,
                accuracy_m: Math.round(pos.coords.accuracy),
              }),
            })
              .then((r) => r.json())
              .then((j) => {
                if (j?.data?.post_kind) setShiftInfo(j.data);
              })
              .catch(() => {});
          },
          () => {},
        );
      }
    };
    ping();
    const id = setInterval(ping, 30_000);
    return () => clearInterval(id);
  }, []);

  const offered = dispatches.find((d) => d.status === "offered");
  const active = dispatches.find((d) => ["accepted", "en_route", "on_scene"].includes(d.status));

  return (
    <div className="space-y-4">
      <div className="border-b border-border pb-2 text-sm text-foreground">
        {shiftInfo
          ? shiftInfo.post_kind === "gate"
            ? `On shift: Gate Post (${shiftInfo.gate_id ?? "assigned"})`
            : `On shift: ${shiftInfo.post_kind} — no gate scan`
          : "Shift status: awaiting GPS ping / check-in"}
      </div>

      {offered && <SosInbox offer={offered} onUpdated={loadDispatches} />}
      {active && (
        <SosResponder
          sosId={active.sos_id}
          dispatchId={active.id}
          status={active.status}
          onUpdated={loadDispatches}
        />
      )}
    </div>
  );
}
</file>

<file path="src/components/security/GuardStatsPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";

interface GuardStat {
  operator_id: string;
  operator_code: string;
  operator_name: string;
  total_shifts: number;
  extra_shifts: number;
  no_shows: number;
  hours_worked: number;
  sos_accepted: number;
  sos_cleared: number;
  avg_ack_seconds: number | null;
}

export function GuardStatsPanel() {
  const [guards, setGuards] = useState<GuardStat[]>([]);
  const [filter, setFilter] = useState("");
  const [noticeMsg, setNoticeMsg] = useState("");

  const load = useCallback(() => {
    fetch("/api/security/stats?days=30")
      .then((r) => r.json())
      .then((j) => setGuards(j?.data?.guards ?? []))
      .catch(() => {});
  }, []);

  useEffect(() => {
    load();
  }, [load]);

  async function notifyGuard(operatorId: string, name: string) {
    const msg = noticeMsg.trim() || `Supervisor check-in for ${name}`;
    await fetch("/api/security/notify", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        operator_id: operatorId,
        title: "Supervisor Notice",
        message: msg,
        priority: "high",
      }),
    });
    setNoticeMsg("");
  }

  const filtered = guards.filter(
    (g) =>
      !filter.trim() ||
      g.operator_name.toLowerCase().includes(filter.toLowerCase()) ||
      g.operator_code.toLowerCase().includes(filter.toLowerCase()),
  );

  return (
    <div className="space-y-4">
      <div className="flex flex-wrap gap-2">
        <input
          type="text"
          value={filter}
          onChange={(e) => setFilter(e.target.value)}
