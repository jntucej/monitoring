<file path="src/components/shared/EmergencyPlaybook.tsx">
"use client";
import { errMsg } from "@/lib/err-msg";
import { useEffect, useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { X, Siren, Lock, Megaphone, Phone, Snowflake, Loader2, Check } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";

import { useUIStore } from "@/stores/uiStore";

type Action = {
  id: string;
  label: string;
  description: string;
  icon: typeof Siren;
  tone: "critical" | "warning" | "neutral";
  endpoint?: string;
  body?: any;
  confirm: string;
};

const ACTIONS: Action[] = [
  { id: "lockdown",  label: "Lock down gates",  description: "Freeze all entry/exit",   icon: Lock,      tone: "critical", endpoint: "/api/admin/lockdown", body: { scopes: ["ALL"], message: "Emergency lockdown" }, confirm: "Lock down all gates?" },
  { id: "broadcast", label: "Campus broadcast", description: "Push alert to everyone",  icon: Megaphone, tone: "critical", endpoint: "/api/admin/announcements", body: { priority: "critical", audience: "all", title: "Emergency notice" }, confirm: "Broadcast to entire campus?" },
  { id: "freeze",    label: "Freeze admissions", description: "Pause visitor intake",   icon: Snowflake, tone: "warning",  endpoint: "/api/visitors/freeze", body: { enabled: true }, confirm: "Freeze visitor admissions?" },
  { id: "vp",        label: "Notify VP",        description: "Alert Vice Principal",    icon: Phone,     tone: "neutral",  endpoint: "/api/notifications", body: { to_role: "vice_principal", severity: "critical" }, confirm: "Notify VP?" },
];

export function EmergencyPlaybook({
  open, onClose,
}: {
  open: boolean;
  onClose: () => void;
}) {
  const addToast = useUIStore((s) => s.addToast);
  const [pending, setPending] = useState<string | null>(null);
  const [confirming, setConfirming] = useState<Action | null>(null);

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") onClose(); };
    if (open) window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open, onClose]);

  const fire = async (a: Action) => {
    if (!a.endpoint) return;
    setPending(a.id);
    try {
      const res = await fetch(a.endpoint, {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify(a.body ?? {}),
      });
      if (!res.ok) throw new Error(await res.text());
      addToast({ variant: "success", message: `${a.label} executed` });
      setConfirming(null);
      onClose();
    } catch (e) {
      addToast({ variant: "error", message: errMsg(e) ?? "Failed" });
    } finally {
      setPending(null);
    }
  };

  return (
    <AnimatePresence>
      {open && (
        <>
          <motion.div
            initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}
            onClick={onClose}
            className="fixed inset-0 z-[var(--z-modal)] bg-black/60 backdrop-blur-sm"
          />
          <motion.div
            initial={{ x: "100%" }} animate={{ x: 0 }} exit={{ x: "100%" }}
            transition={{ type: "spring", damping: 26, stiffness: 260 }}
            className="surface-card fixed right-0 top-0 z-[var(--z-modal)] h-full w-full max-w-md max-w-[100vw] overflow-y-auto bg-bg-surface p-6"
          >
            <div className="flex items-start justify-between">
              <div>
                <div className="surface-card inline-flex items-center gap-2 bg-rose-500/10 px-3 py-1 text-xs font-medium text-action-danger">
                  <Siren className="size-3.5" /> Emergency playbook
                </div>
                <p className="mt-3 text-sm text-text-muted">
                  One-tap actions. Each is audit-logged.
                </p>
              </div>
              <button onClick={onClose}
                className="surface-card p-1.5 text-text-muted hover:bg-[var(--bg-subtle)]">
                <X className="h-4 w-4" />
              </button>
            </div>

            <div className="mt-6 space-y-3">
              {ACTIONS.map((a) => {
                const Icon = a.icon;
                const isPending = pending === a.id;
                const tone =
                  a.tone === "critical" ? "border-rose-500/30 bg-rose-500/5 text-action-danger"
                  : a.tone === "warning" ? "border-amber-500/30 bg-amber-500/5 text-action-warning"
                  : "border-border bg-[var(--bg-subtle)] text-text-primary";
                return (
                  <button
                    key={a.id}
                    onClick={() => setConfirming(a)}
                    disabled={isPending}
                    className={`flex w-full items-center gap-3 rounded-xl border p-4 text-left transition-transform hover:-translate-y-0.5 disabled:opacity-50 ${tone}`}
                  >
                    <Icon className="h-5 w-5 shrink-0" />
                    <div className="min-w-0 flex-1">
                      <div className="text-sm font-medium">{a.label}</div>
                      <div className="text-xs text-text-muted">{a.description}</div>
                    </div>
                    {isPending && <Loader2 className="h-4 w-4 animate-spin" />}
                  </button>
                );
              })}
            </div>

            {confirming && (
              <motion.div
                initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }}
                className="surface-card mt-6 bg-[var(--bg-subtle)] p-4"
              >
                <p className="text-sm text-text-primary">{confirming.confirm}</p>
                <div className="mt-3 flex gap-2">
                  <button
                    onClick={() => fire(confirming)}
                    disabled={pending === confirming.id}
                    className="surface-card inline-flex items-center gap-1 bg-action-danger px-3 py-1.5 text-xs font-medium text-white hover:bg-action-danger disabled:opacity-50"
                  >
                    {pending === confirming.id ? <Loader2 className="size-3.5 animate-spin" /> : <Check className="size-3.5" />}
                    Confirm
                  </button>
                  <button
                    onClick={() => setConfirming(null)}
                    className="surface-card px-3 py-1.5 text-xs font-medium text-text-muted hover:bg-bg-surface"
                  >
                    Cancel
                  </button>
                </div>
              </motion.div>
            )}
          </motion.div>
        </>
      )}
    </AnimatePresence>
  );
}
</file>

<file path="src/components/shared/EmptyState.tsx">
"use client";

/**
 * EmptyState — a reusable empty/zero-state UI component.
 *
 * Issue issue-391: the live region is decoupled from the visual content so
 * screen readers only announce when the message *changes*, not on every
 * parent re-render (which would fire on every keypress in a filter list).
 *
 * Issue issue-397: wraps content in `relative z-10` so it renders above modal
 * backdrops that use isolation/z-index stacking on Safari.
 *
 * Issue issue-402: in development, warns when an `action` element has no onClick
 * handler and is not disabled — catching silent no-op buttons before they ship.
 */

import { useEffect, useRef, useState } from "react";
import type { ReactNode } from "react";

export interface EmptyStateProps {
  title: string;
  description?: string;
  icon?: ReactNode;
  action?: ReactNode;
  className?: string;
  /** Distinguishes a clear queue from a filtered-out view or restricted/unavailable endpoint. */
  reason?: "clear_queue" | "filtered_out" | "restricted";
}

// Issue issue-402: dev-only guard to catch action buttons with no click handler.
function warnActionWithNoHandler(action: ReactNode): void {
  if (process.env.NODE_ENV !== "development") return;
  if (!action || typeof action !== "object") return;
  const node = action as React.ReactElement<{ onClick?: unknown; disabled?: unknown }>;
  if ("props" in node) {
    const hasHandler = typeof node.props?.onClick === "function" || node.props?.disabled;
    if (!hasHandler) {
      console.warn(
        "[EmptyState] `action` element has no onClick handler and is not disabled. " +
          "It will render as an inert button. Add an onClick or disable it.",
        node,
      );
    }
  }
}

export function EmptyState({
  title,
  description,
  icon,
  action,
  className = "",
  reason,
}: EmptyStateProps) {
  warnActionWithNoHandler(action);

  // Issue issue-391: track the last announced message so the live region only
  // updates when the content *changes*. Re-renders with the same text are
  // silent — prevents screen readers from re-announcing on every keystroke
  // in a filtered list that mounts EmptyState mid-interaction.
  const announcement = `${title}${description ? `. ${description}` : ""}`;
  const [announced, setAnnounced] = useState<string | null>(null);
  const isFirst = useRef(true);

  useEffect(() => {
    if (isFirst.current) {
      // Announce on first mount
      isFirst.current = false;
      setAnnounced(announcement);
      return;
    }
    if (announcement !== announced) {
      setAnnounced(announcement);
    }
  }, [announcement]); // eslint-disable-line react-hooks/exhaustive-deps

  return (
    <>
      {/* Visually hidden live region — only updated when the message changes */}
      <div
        role="status"
        aria-live="polite"
        aria-atomic="true"
        className="sr-only"
      >
        {announced}
      </div>

      {/* Issue issue-397: z-10 ensures this content renders above modal backdrops
          that create a new stacking context (e.g. Safari + isolation:isolate) */}
      <div
        className={`relative z-10 flex flex-col items-center justify-center py-12 px-4 text-center ${className}`}
      >
        {icon && (
          <div className="mb-4 text-text-muted opacity-60" aria-hidden="true">
            {icon}
          </div>
        )}

        {reason && (
          <span className="mb-2 rounded-full border border-border bg-bg-elevated px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-text-muted">
            {reason === "clear_queue"
              ? "Queue Clear"
              : reason === "filtered_out"
              ? "Filtered Scope"
              : "Restricted / Unavailable"}
          </span>
        )}

        <h3 className="text-sm font-semibold text-text-secondary mb-1">{title}</h3>

        {description && (
          <p className="text-xs text-text-muted max-w-xs">{description}</p>
        )}

        {action && <div className="mt-4">{action}</div>}{!action && <p className="mt-4 text-xs text-text-muted opacity-60">No action available</p>}
      </div>
    </>
  );
}

export default EmptyState;
</file>

<file path="src/components/shared/EntityInspector.tsx">
"use client";

import { useEffect, useRef, useState, type ReactNode } from "react";
import { X, AlertTriangle, Lock, FileSearch } from "lucide-react";
import { cn } from "@/lib/utils";
import { PivotStrip, type PivotItem } from "@/components/shared/PivotStrip";

export interface InspectionSection {
  /** Section title (e.g. "Overview", "Context", "History", "Actions"). */
  title: string;
  /** Optional icon next to the title. */
  icon?: ReactNode;
  /** The section body. Rendered inside the panel's flow. */
  content: ReactNode;
  /**
   * Collapsible on demand: when true, the section starts collapsed and the
   * user expands it. Used for history/relationships that may be long.
   */
  collapsible?: boolean;
}

export interface EntityInspection {
  /** The entity kind, e.g. "student" | "gate" | "alert" | "case". */
  kind: string;
  /** Display name (e.g. "Priya Sharma" / "Main Gate" / "Critical breach"). */
  title: string;
  /** Compact subtitle / identifier (roll no, gate code, timestamp). */
  subtitle?: string | null;
  /** One-line state descriptor shown next to the title (e.g. "ACTIVE"). */
  status?: ReactNode;
  /** Sections in display order: overview → context → history → actions. */
  sections: InspectionSection[];
  /**
   * Primary "go to full detail" link (the deepest level of the hierarchy).
   * Rendered as a footer CTA. Omit when the panel IS the full detail.
   */
  detailHref?: string;
  detailLabel?: string;
}

/**
 * The lifecycle state of the inspector when it is open but the
 * `EntityInspection` model has not (yet) resolved. The page or the
 * `useEntityResolver` hook drives this; `EntityInspector` renders the
 * matching placeholder.
 *
 * Design rule 31: the inspector must always show a meaningful state —
 * never a blank panel.
 */
export type InspectorState =
  | "loading"      // skeleton shimmer
  | "empty"        // "No related records"
  | "error"        // retry button
  | "unauthorized" // "You do not have permission"
  | "missing";     // record not found

export interface EntityInspectorProps {
  /** The open inspection (null = closed). */
  inspection: EntityInspection | null;
  onClose: () => void;
  /**
   * Optional: when `inspection` is null and the inspector is still open
   * (e.g. a resolver is in flight), show the matching placeholder state.
   * Default: "loading".
   */
  state?: InspectorState;
  /** Error message shown in the "error" state. */
  errorMessage?: string;
  /** Called when the user clicks "Retry" in the error state. */
  onRetry?: () => void;
  /** Optional: renders a slot behind the panel content (e.g. a backdrop). */
  className?: string;
  /**
   * Optional: coarse capability gate for the "Actions" section. When
   * `canAct === false`, every `<InspectorButton>` inside the Actions
   * section is hidden and replaced with a muted read-only note via the
   * `ActionGate` helper. Pass through to a wrapping `<ActionGate>` (or
   * leave unset when the model already wraps its own buttons).
   *
   * Navigation-only "Open full detail" / "View full detail" CTAs are
   * NOT gated: those are links, not writes.
   */
  canAct?: boolean;
  /**
   * Optional: a custom read-only note rendered in the Actions section in
   * place of the buttons when `canAct === false`. Defaults to a generic
   * "Acting on this record requires elevated permissions" copy.
   */
  canActFallbackNote?: ReactNode;
  /** Optional agent-inspectable tier & mode hooks. */
  dataRoleTier?: string;
  dataEventMode?: string;
  /** Optional back handler when navigating a multi-hop inspect stack. */
  onBack?: () => void;
  /** Optional Zone 3 relational pivot pills. */
  pivots?: PivotItem[];
}

/**
 * EntityInspector — the standardized "inspect" experience for the Gate
 * Monitor app.
 *
 * Every major entity (student, gate, alert, case, pass, shift, incident)
 * exposes the SAME predictable progressive-disclosure hierarchy:
 *
 *   ELEMENT
 *      → Quick overview      (sections[0])
 *      → Context             (sections[1])
 *      → History/relations   (sections[2], collapsible)
 *      → Actions             (sections[3] + footer CTA)
 *      → Full detail page    (detailHref footer link)
 *
 * It renders as a right-side drawer (bottom sheet on mobile) so the user
 * never leaves the current page while inspecting. The component is
 * presentational + data-agnostic: it takes an `EntityInspection` model,
 * not entity-specific props, so every dashboard composes the same panel
 * from its own entity.
 *
 * Behavior:
 *   - Closes on Esc, on backdrop click, or on the close button.
 *   - Closes on focus-out of the panel (tabbing away).
 *   - Long sections collapse behind a toggle (a11y: aria-expanded).
 *   - No layout shift: the drawer is position:fixed and overlays.
 *   - Focus moves into the panel on open and back to the trigger on close.
 *   - When `inspection` is null the panel shows a state placeholder
 *     (loading / empty / error / unauthorized / missing) per design rule 31.
 */
export function EntityInspector({
  inspection,
  onClose,
  state,
  errorMessage,
  onRetry,
  className,
  canAct,
  canActFallbackNote,
  dataRoleTier,
  dataEventMode,
  onBack,
  pivots,
}: EntityInspectorProps) {
  // When the caller passes no explicit `state`, the panel is considered
  // "closed" when inspection is null → render nothing (a stuck "loading"
  // overlay covering the whole page is the /principal bug). When the caller
  // DOES pass an explicit `state` (the documented resolver-in-flight case),
  // keep the panel open with the placeholder so the user always sees a
  // meaningful panel (design rule 31).
  const stateProvided = state !== undefined;
  const inspectorState = state ?? "loading";
  const [collapsed, setCollapsed] = useState<Record<number, boolean>>({});
  const panelRef = useRef<HTMLDivElement>(null);
  const closeBtnRef = useRef<HTMLButtonElement>(null);
  const prevFocusRef = useRef<HTMLElement | null>(null);

  // Reset collapsed state whenever a new inspection opens.
  useEffect(() => {
    setCollapsed({});
  }, [inspection?.kind, inspection?.title]);

  // ── focus management ─────────────────────────────────────────────────────
  // On open: move focus into the panel (to the close button, the first
  // focusable element). On close: restore focus to the previously focused
  // element so the user's keyboard position is not lost.
  useEffect(() => {
    if (inspection) {
      // Save the element that had focus before the inspector opened.
      prevFocusRef.current = document.activeElement as HTMLElement;
      // Move focus into the panel.
      requestAnimationFrame(() => {
        closeBtnRef.current?.focus();
      });
    } else if (prevFocusRef.current) {
      // Restore focus to the element that was focused before the panel opened.
      prevFocusRef.current.focus();
      prevFocusRef.current = null;
    }
  }, [inspection]);

  // Esc to close + body scroll lock.
  useEffect(() => {
    if (!inspection && !stateProvided) return;
    const prevOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") onClose();
    };
    window.addEventListener("keydown", onKey);
    return () => {
      document.body.style.overflow = prevOverflow;
      window.removeEventListener("keydown", onKey);
    };
  }, [inspection, stateProvided, onClose]);

  // Closed state: no inspection model and no in-flight resolver state was
  // explicitly requested. Render nothing — a stuck "loading" overlay covering
  // the whole page (the old behavior) is what made /principal and friends
  // look broken. Callers that are genuinely mid-resolve keep the panel open
  // by passing an explicit `state` prop, in which case the placeholder below
  // still renders so the user always sees a meaningful panel (rule 31).
  if (!inspection && inspectorState === "loading" && !stateProvided) {
    return null;
  }

  // If there is no inspection model, render the state placeholder.
  if (!inspection) {
    return (
      <div
        className="fixed inset-0 z-[80] flex justify-end"
        role="dialog"
        aria-modal="true"
        aria-label="Entity inspector"
      >
        <div
          className="absolute inset-0 bg-black/40 backdrop-blur-sm"
          onClick={onClose}
          aria-hidden="true"
        />
        <aside
          className={cn(
            "surface-card relative w-full max-w-md h-full overflow-y-auto bg-bg-surface p-5 flex flex-col",
            className,
          )}
        >
          <header className="flex items-center justify-between mb-4">
            <p className="text-xs text-text-muted">Inspector</p>
            <button
              ref={closeBtnRef}
              onClick={onClose}
              className="surface-card min-h-9 min-w-9 shrink-0 flex items-center justify-center hover:bg-bg-surface/60 text-text-primary focus-visible:ring-2 focus-visible:ring-action-primary focus-visible:outline-none"
              aria-label="Close inspector"
            >
              <X className="size-4" />
            </button>
          </header>
          <InspectorStatePlaceholder
            state={inspectorState}
            errorMessage={errorMessage}
            onRetry={onRetry}
          />
        </aside>
      </div>
    );
  }

  const { kind, title, subtitle, status, sections, detailHref, detailLabel } = inspection;

  // Zone 4: Role-ordered sections (Approvers: Context/Eligibility -> History -> Overview;
  // Operators: Overview/Validity -> History -> Context; SysAdmins: Context/Metadata -> History -> Actions).
  const orderedSections = (() => {
    if (!dataRoleTier || sections.length <= 1) return sections;
    const score = (s: InspectionSection): number => {
      const t = s.title.toLowerCase();
      if (t.includes("action")) return 90;
      if (dataRoleTier === "tier-2" || dataRoleTier === "tier-3") {
        if (t.includes("eligib") || t.includes("context") || t.includes("scope")) return 10;
        if (t.includes("chain") || t.includes("history") || t.includes("timeline")) return 20;
        return 30;
      }
      if (dataRoleTier === "tier-1") {
        if (t.includes("overview") || t.includes("valid") || t.includes("identity")) return 10;
        if (t.includes("scan") || t.includes("history") || t.includes("timeline")) return 20;
        return 30;
      }
      if (dataRoleTier === "tier-4") {
        if (t.includes("meta") || t.includes("state") || t.includes("context")) return 10;
        if (t.includes("session") || t.includes("audit") || t.includes("history")) return 20;
        return 30;
      }
      return 50;
    };
    return [...sections].sort((a, b) => score(a) - score(b));
  })();

  return (
    <div className="fixed inset-0 z-[80] flex justify-end" role="dialog" aria-modal="true" aria-label={`Inspect ${kind}: ${title}`}>
      {/* Backdrop */}
      <div
        className="absolute inset-0 bg-black/40 backdrop-blur-sm"
        onClick={onClose}
        aria-hidden="true"
      />

      {/* Drawer */}
      <aside
        ref={panelRef}
        data-testid="inspector-drawer"
        data-inspector-open="true"
        data-role-tier={dataRoleTier}
        data-event-mode={dataEventMode}
        className={cn(
          "surface-card relative w-full sm:max-w-lg md:max-w-xl h-full overflow-y-auto bg-bg-surface p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]",
          className,
        )}
      >
        <header className="flex items-start justify-between gap-3 mb-4">
          <div className="min-w-0">
            <div className="flex items-center gap-2">
              {onBack ? (
                <button
                  type="button"
                  onClick={onBack}
                  data-testid="inspector-back"
                  className="text-[11px] font-semibold text-action-primary hover:underline focus-visible:ring-2 focus-visible:ring-action-primary focus-visible:outline-none rounded"
                >
                  &larr; Back
                </button>
              ) : null}
              <p className="text-[10px] font-semibold uppercase tracking-widest text-text-muted">
                {kind}
              </p>
            </div>
            <div className="flex items-center gap-2 mt-1 flex-wrap">
              <h2 className="text-lg font-semibold text-text-primary truncate">{title}</h2>
              {status ? <span className="shrink-0">{status}</span> : null}
            </div>
            {subtitle ? (
              <p className="text-xs font-mono text-text-muted mt-0.5 truncate">{subtitle}</p>
            ) : null}
          </div>
          <button
            ref={closeBtnRef}
            onClick={onClose}
            className="surface-card min-h-9 min-w-9 shrink-0 flex items-center justify-center hover:bg-bg-surface/60 text-text-primary focus-visible:ring-2 focus-visible:ring-action-primary focus-visible:outline-none"
            aria-label="Close inspector"
          >
            <X className="size-4" />
          </button>
        </header>

        {pivots && pivots.length > 0 ? (
          <div className="mb-4">
            <PivotStrip pivots={pivots} />
          </div>
        ) : null}

        <div className="space-y-4">
          {orderedSections.map((s, i) => {
            const isCollapsible = s.collapsible === true;
            const isCollapsed = !!collapsed[i];
            const isActions = s.title === "Actions" && canAct === false;
            const sectionContent = isActions ? (
              canActFallbackNote ?? (
                <p className="text-xs text-text-muted">
                  Acting on this record requires elevated permissions.
                </p>
              )
            ) : s.content;
            return (
              <section key={i} className="space-y-2">
                {isCollapsible ? (
                  <button
                    type="button"
                    onClick={() => setCollapsed((c) => ({ ...c, [i]: !c[i] }))}
                    aria-expanded={!isCollapsed}
                    className="w-full flex items-center justify-between text-xs font-semibold uppercase tracking-wide text-text-muted hover:text-text-primary"
                  >
                    <span className="flex items-center gap-1.5">{s.icon}{s.title}</span>
                    <span className="text-text-muted">{isCollapsed ? "Expand" : "Collapse"}</span>
                  </button>
                ) : (
                  <h3 className="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-text-muted">
                    {s.icon}
                    {s.title}
                  </h3>
                )}
                {!isCollapsed && <div className="surface-card bg-bg-surface p-3">{sectionContent}</div>}
              </section>
            );
          })}
        </div>

        {detailHref ? (
          <div className="mt-6 pt-4 border-t border-border">
            <a
              href={detailHref}
              className="inline-flex items-center gap-1.5 text-xs font-semibold text-action-primary hover:underline"
            >
              {detailLabel ?? "View full detail"}
            </a>
          </div>
        ) : null}
      </aside>
    </div>
  );
}

/* ── state placeholder (design rule 31: never show a blank panel) ─────── */

function InspectorStatePlaceholder({
  state,
  errorMessage,
  onRetry,
}: {
  state: InspectorState;
  errorMessage?: string;
  onRetry?: () => void;
}) {
  switch (state) {
    case "loading":
      return (
        <div className="space-y-4 animate-pulse" role="status" aria-live="polite">
          <div className="h-4 w-2/3 bg-bg-elevated rounded" />
          <div className="h-3 w-1/3 bg-bg-elevated rounded" />
          <div className="space-y-2 mt-6">
            {[0, 1, 2, 3].map((i) => (
              <div key={i} className="h-3 bg-bg-elevated rounded" style={{ width: `${100 - i * 10}%` }} />
            ))}
          </div>
          <div className="space-y-2 mt-4">
            {[0, 1, 2].map((i) => (
              <div key={i} className="h-3 bg-bg-elevated rounded" style={{ width: `${90 - i * 10}%` }} />
            ))}
          </div>
        </div>
      );
    case "empty":
      return (
        <div className="flex flex-col items-center justify-center py-12 text-center" role="status">
          <FileSearch className="size-8 text-text-muted mb-3" />
          <p className="text-sm font-medium text-text-primary">No related records</p>
          <p className="text-xs text-text-muted mt-1">
            This entity has no associated data to display.
          </p>
        </div>
      );
    case "error":
      return (
        <div className="flex flex-col items-center justify-center py-12 text-center" role="alert">
          <AlertTriangle className="size-8 text-action-danger mb-3" />
          <p className="text-sm font-medium text-text-primary">Failed to load</p>
          {errorMessage ? (
            <p className="text-xs text-text-muted mt-1">{errorMessage}</p>
          ) : null}
          {onRetry ? (
            <button
              type="button"
              onClick={onRetry}
              className="mt-4 text-xs font-semibold text-action-primary hover:underline focus-visible:ring-2 focus-visible:ring-action-primary focus-visible:outline-none rounded"
            >
              Retry
            </button>
          ) : null}
        </div>
      );
    case "unauthorized":
      return (
        <div className="flex flex-col items-center justify-center py-12 text-center" role="alert">
          <Lock className="size-8 text-action-warning mb-3" />
          <p className="text-sm font-medium text-text-primary">You do not have permission</p>
          <p className="text-xs text-text-muted mt-1">
            Contact an administrator if you believe this is an error.
          </p>
        </div>
      );
    case "missing":
      return (
        <div className="flex flex-col items-center justify-center py-12 text-center" role="status">
          <FileSearch className="size-8 text-text-muted mb-3" />
          <p className="text-sm font-medium text-text-primary">Record not found</p>
          <p className="text-xs text-text-muted mt-1">
            This entity may have been deleted or the link is stale.
          </p>
        </div>
      );
  }
}

/* ------------------------------------------------------------------ */
/*  Helper: a simple key/value block for the "Overview" section.      */
/* ------------------------------------------------------------------ */
export function KVPairs({
  items,
  columns = 2,
}: {
  items: Array<{ label: string; value: ReactNode }>;
  columns?: 1 | 2;
}) {
  return (
    <dl className={cn("grid gap-2.5 text-xs", columns === 2 ? "grid-cols-2" : "grid-cols-1")}>
      {items.map((it, i) => (
        <div key={i} className={columns === 1 ? "col-span-2" : undefined}>
          <dt className="text-text-muted">{it.label}</dt>
          <dd className="text-text-primary mt-0.5">{it.value}</dd>
        </div>
      ))}
    </dl>
  );
}

/* ------------------------------------------------------------------ */
/*  Helper: a compact timeline for the "History" section.             */
/* ------------------------------------------------------------------ */
export function Timeline({
  items,
  emptyLabel = "No history yet.",
}: {
  items: Array<{ label: string; time?: string; detail?: string; tone?: "ok" | "warn" | "danger" | "neutral" }>;
  emptyLabel?: string;
}) {
  if (items.length === 0) {
    return <p className="text-xs text-text-muted">{emptyLabel}</p>;
  }
  const toneClass: Record<string, string> = {
    ok: "bg-emerald-500",
    warn: "bg-amber-500",
    danger: "bg-rose-500",
    neutral: "bg-bg-elevated",
  };
  return (
    <ol className="relative border-l border-border ml-1.5 space-y-3">
      {items.map((it, i) => (
        <li key={i} className="ml-4">
          <span
            className={cn(
              "absolute -left-[5px] size-2.5 rounded-full ring-2 ring-bg-surface",
              toneClass[it.tone ?? "neutral"],
            )}
          />
          <p className="text-xs font-medium text-text-primary">{it.label}</p>
          {it.detail ? <p className="text-[11px] text-text-muted mt-0.5">{it.detail}</p> : null}
          {it.time ? <p className="text-[10px] text-text-muted mt-0.5">{it.time}</p> : null}
        </li>
      ))}
    </ol>
  );
}

/* ------------------------------------------------------------------ */
/*  Helper: an action button row for the "Actions" section.           */
/* ------------------------------------------------------------------ */
export function ActionRow({
  children,
}: {
  children: ReactNode;
}) {
  return <div className="flex flex-wrap gap-2">{children}</div>;
}

/**
 * ActionGate — the coarse capability gate for inspector action bars.
 *
 * Renders `children` only when `canAct` is truthy; otherwise renders
 * `fallbackNote` (defaulting to a muted "requires elevated permissions"
 * note). Compose with `useCanActEntity(kind)` to drive the boolean
 * from the central `canActOnEntity` map. Navigation-only buttons
 * ("Open full detail") are NOT wrapped in `ActionGate` — they are
 * links, not writes.
 */
export function ActionGate({
  canAct,
  fallbackNote,
  children,
}: {
  canAct: boolean;
  fallbackNote?: ReactNode;
  children: ReactNode;
}) {
  if (canAct) return <>{children}</>;
  return (
    <div className="text-xs text-text-muted">
      {fallbackNote ??
        "Acting on this record requires elevated permissions."}
    </div>
  );
}

export function InspectorButton({
  children,
  href,
  onClick,
  variant = "primary",
  disabled,
}: {
  children: ReactNode;
  href?: string;
  onClick?: () => void;
  variant?: "primary" | "ghost" | "danger";
  disabled?: boolean;
}) {
  const base =
    "inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 min-h-8 rounded transition disabled:opacity-40 disabled:pointer-events-none focus-visible:ring-2 focus-visible:ring-action-primary focus-visible:outline-none";
  const styles: Record<string, string> = {
    primary: "bg-action-primary text-white hover:opacity-90",
    ghost: "surface-card bg-bg-elevated text-text-primary hover:bg-bg-surface",
    danger: "bg-rose-500/15 text-action-danger hover:bg-rose-500/25",
  };
  const cls = cn(base, styles[variant]);
  if (href) {
    return (
      <a href={href} className={cls} onClick={onClick}>
        {children}
      </a>
    );
  }
  return (
    <button type="button" onClick={onClick} disabled={disabled} className={cls}>
      {children}
    </button>
  );
}
