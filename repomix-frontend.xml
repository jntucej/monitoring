<file path="src/components/engagement/CampusFeed.tsx">
"use client";

/**
 * Campus Feed — merged official announcements + campus events.
 * Each entry shows its publisher and last-updated time; items created
 * by admins/sysadmins carry a "Verified notice" badge.
 *
 * Filters: all / announcements / events / followed.
 * All data comes from /api/campus/feed (server-authorized).
 */
import { useCallback, useEffect, useMemo, useState } from "react";
import {
  Megaphone,
  CalendarDays,
  ShieldCheck,
  User,
  Clock,
  Inbox,
  Loader2,
  Star,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

type FeedFilter = "all" | "announcements" | "events" | "followed";

const FILTERS: Array<{ id: FeedFilter; label: string }> = [
  { id: "all", label: "All" },
  { id: "announcements", label: "Announcements" },
  { id: "events", label: "Events" },
  { id: "followed", label: "Followed" },
];

interface FeedAnnouncement {
  id: string;
  title: string;
  message: string;
  priority: string;
  publisher: string;
  isOfficial: boolean;
  lastUpdated: string | null;
  followed: boolean;
}

interface FeedEvent {
  id: string;
  title: string;
  description: string;
  category: string;
  location: string | null;
  startsAt: string;
  endsAt: string | null;
  publisher: string;
  isOfficial: boolean;
  lastUpdated: string | null;
}

interface FeedData {
  announcements: FeedAnnouncement[];
  events: FeedEvent[];
  followedCount: number;
}

function formatWhen(iso: string | null): string | null {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return d.toLocaleString(undefined, {
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function VerifiedBadge() {
  return (
    <span
      className="surface-card inline-flex items-center gap-1 bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-action-success"
      title="Published by an administrator"
    >
      <ShieldCheck className="size-3.5" aria-hidden />
      Verified notice
    </span>
  );
}

export function CampusFeed({ limit = 20 }: { limit?: number }) {
  const [filter, setFilter] = useState<FeedFilter>("all");
  const [data, setData] = useState<FeedData | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(
    async (f: FeedFilter) => {
      try {
        setLoading(true);
        const res = await fetch(`/api/campus/feed?filter=${encodeURIComponent(f)}`, {
          headers: getAuthHeaders(),
          cache: "no-store",
        });
        const json = await res.json().catch(() => null);
        if (!res.ok || !json?.success) {
          throw new Error(json?.error?.message ?? "Failed to load feed");
        }
        setData(json.data as FeedData);
        setError(null);
      } catch (e) {
        setError(e instanceof Error ? e.message : "Failed to load feed");
      } finally {
        setLoading(false);
      }
    },
    []
  );

  useEffect(() => {
    void load(filter);
  }, [filter, load]);

  const items = useMemo(() => {
    if (!data) return [];
    const out: Array<{
      key: string;
      kind: "announcement" | "event";
      title: string;
      body: string;
      meta: string;
      isOfficial: boolean;
      followed: boolean;
    }> = [];
    for (const a of data.announcements) {
      out.push({
        key: `ann-${a.id}`,
        kind: "announcement",
        title: a.title,
        body: a.message,
        meta: `${formatWhen(a.lastUpdated) ?? "updated"} · ${a.publisher}`,
        isOfficial: a.isOfficial,
        followed: a.followed,
      });
    }
    for (const e of data.events) {
      out.push({
        key: `ev-${e.id}`,
        kind: "event",
        title: e.title,
        body: e.description,
        meta: `${formatWhen(e.startsAt) ?? "scheduled"} · ${e.publisher}`,
        isOfficial: e.isOfficial,
        followed: false,
      });
    }
    return out.slice(0, limit);
  }, [data, limit]);

  return (
    <WidgetBoundary title="Campus Feed">
      <section aria-label="Campus feed" className="surface-card bg-bg-surface p-5 min-w-0">
        <div className="flex items-center justify-between gap-3">
          <h2 className="flex items-center gap-2 text-sm font-bold text-text-primary">
            <Megaphone className="h-4 w-4 text-action-primary" aria-hidden />
            Campus Feed
          </h2>
          <div className="flex flex-wrap items-center gap-1.5" role="tablist" aria-label="Feed filter">
            {FILTERS.map((f) => (
              <button
                key={f.id}
                type="button"
                role="tab"
                aria-selected={filter === f.id}
                onClick={() => setFilter(f.id)}
                className={`rounded-lg px-2.5 py-1 text-xs font-medium transition-colors motion-reduce:transition-none ${
                  filter === f.id
                    ? "bg-indigo-500/20 text-action-primary"
                    : "text-text-muted hover:text-text-primary"
                }`}
              >
                {f.label}
              </button>
            ))}
          </div>
        </div>

        {filter === "followed" && data ? (
          <p className="mt-2 text-xs text-text-muted">
            {data.followedCount === 0
              ? "You haven't followed any announcements yet."
              : `${data.followedCount} followed announcement${data.followedCount === 1 ? "" : "s"}.`}
          </p>
        ) : null}

        {loading && !data ? (
          <div className="mt-8 flex items-center justify-center gap-2 py-8 text-sm text-text-muted" role="status">
            <Loader2 className="h-4 w-4 animate-spin motion-reduce:animate-none" aria-hidden />
            Loading feed…
          </div>
        ) : error && !data ? (
          <div className="surface-card mt-6 bg-rose-500/10 p-3 text-sm text-rose-600">{error}</div>
        ) : items.length === 0 ? (
          <div className="mt-6 flex flex-col items-center gap-2 py-8 text-center text-text-muted">
            <Inbox className="h-6 w-6 opacity-50" aria-hidden />
            <p className="text-sm">Nothing here yet.</p>
          </div>
        ) : (
          <ul className="mt-4 space-y-3" aria-label="Feed items">
            {items.map((item) => (
              <li
                key={item.key}
                className="surface-card bg-[var(--bg-raised)]/40 p-3.5"
              >
                <div className="flex items-start justify-between gap-2">
                  <div className="flex min-w-0 items-center gap-2">
                    {item.kind === "announcement" ? (
                      <Megaphone className="h-4 w-4 shrink-0 text-action-warning" aria-hidden />
                    ) : (
                      <CalendarDays className="h-4 w-4 shrink-0 text-action-info" aria-hidden />
                    )}
                    <p className="truncate text-sm font-semibold text-text-primary">{item.title}</p>
                    {item.isOfficial && <VerifiedBadge />}
                    {item.followed && (
                      <span className="surface-card inline-flex items-center gap-1 bg-indigo-500/15 px-2 py-0.5 text-xs font-medium text-action-primary">
                        <Star className="size-3.5" aria-hidden />
                        Followed
                      </span>
                    )}
                  </div>
                </div>
                <p className="mt-1.5 line-clamp-2 text-xs text-text-muted">{item.body}</p>
                <p className="mt-1.5 flex flex-wrap items-center gap-1 text-xs text-text-muted">
                  <User className="size-3.5" aria-hidden />
                  {item.meta}
                  <span aria-hidden>·</span>
                  <Clock className="size-3.5" aria-hidden />
                  <span>{new Date().toLocaleDateString()}</span>
                </p>
              </li>
            ))}
          </ul>
        )}
      </section>
    </WidgetBoundary>
  );
}
</file>

<file path="src/components/engagement/Communities.tsx">
"use client";

/**
 * Communities — moderated discussion communities widget.
 *
 * Lists the campus communities with join/leave controls; the selected
 * community shows its approved posts (with a "pending moderation" hint
 * on the caller's own pending posts), a post composer (disabled for
 * non-members), a per-post report/flag control, and a moderate menu
 * (approve / hide / unhide) that is visible only to moderators/admins.
 *
 * All data comes from /api/campus/communities/* (server-authorized);
 * pending/hidden posts are readable only by their author or a
 * moderator/admin — enforced in the API, not in this component.
 */
import { useCallback, useEffect, useState } from "react";
import {
  Users,
  UserPlus,
  UserMinus,
  MessageSquarePlus,
  Flag,
  ShieldCheck,
  EyeOff,
  Check,
  Clock,
  Inbox,
  Loader2,
  BrainCircuit,
  Shield,
  Code,
  Bot,
  Rocket,
  Dumbbell,
  HeartHandshake,
  Plus,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

type MembershipRole = "member" | "moderator" | "admin";

interface Community {
  id: string;
  name: string;
  description: string | null;
  icon: string | null;
  isModerated: boolean;
  memberCount: number;
  isMember: boolean;
  myRole: MembershipRole | null;
  canModerate: boolean;
}

interface CommunityPost {
  id: string;
  title: string;
  body: string;
  status: "pending" | "approved" | "hidden";
  author: string;
  reportedCount: number;
  isOwn: boolean;
  createdAt: string | null;
}

interface PostsData {
  isMember: boolean;
  myRole: MembershipRole | null;
  canModerate: boolean;
  posts: CommunityPost[];
}

const COMMUNITY_ICONS: Record<string, typeof Users> = {
  brain: BrainCircuit,
  braincircuit: BrainCircuit,
  "brain-circuit": BrainCircuit,
  shield: Shield,
  code: Code,
  bot: Bot,
  rocket: Rocket,
  dumbbell: Dumbbell,
  "heart-handshake": HeartHandshake,
};

function iconFor(name: string | null, fallback: string | null): typeof Users {
  const key = (name ?? fallback ?? "").toLowerCase().replace(/[\s-]+/g, "");
  return COMMUNITY_ICONS[key] ?? Users;
}

function communityFetch<T>(path: string, init?: RequestInit): Promise<{ ok: boolean; status: number; json: T | null }> {
  return fetch(path, {
    ...init,
    headers: { "Content-Type": "application/json", ...getAuthHeaders(), ...(init?.headers ?? {}) },
    cache: "no-store",
  }).then(async (res) => ({
    ok: res.ok,
    status: res.status,
    json: await res.json().catch(() => null),
  }));
}

interface CommunityResponse {
  success: boolean;
  data?: { communities: Community[] };
  error?: { message?: string };
}

interface PostsResponse {
  success: boolean;
  data?: PostsData;
  error?: { message?: string };
}

interface ActionResponse {
  success: boolean;
  data?: { status?: string };
  error?: { message?: string };
}

function formatWhen(iso: string | null): string | null {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return d.toLocaleDateString(undefined, { month: "short", day: "numeric" });
}

export function Communities() {
  const [communities, setCommunities] = useState<Community[]>([]);
  const [selected, setSelected] = useState<Community | null>(null);
  const [posts, setPosts] = useState<PostsData | null>(null);
  const [loadingCommunities, setLoadingCommunities] = useState(true);
  const [loadingPosts, setLoadingPosts] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [action, setAction] = useState<string | null>(null);
  const [composerOpen, setComposerOpen] = useState(false);
  const [title, setTitle] = useState("");
  const [text, setText] = useState("");
  const [reportReason, setReportReason] = useState<Record<string, string>>({});
  const [reportTarget, setReportTarget] = useState<string | null>(null);

  const loadCommunities = useCallback(async () => {
    try {
      setLoadingCommunities(true);
      const { ok, json } = await communityFetch<CommunityResponse>("/api/campus/communities");
      if (!ok || !json?.success) {
        throw new Error(json?.error?.message ?? "Failed to load communities");
      }
      setCommunities(json.data?.communities ?? []);
      setError(null);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load communities");
    } finally {
      setLoadingCommunities(false);
    }
  }, []);

  const loadPosts = useCallback(
    async (communityId: string) => {
      try {
        setLoadingPosts(true);
        const { ok, json } = await communityFetch<PostsResponse>(
          `/api/campus/communities/${encodeURIComponent(communityId)}/posts`
        );
        if (!ok || !json?.success) {
          throw new Error(json?.error?.message ?? "Failed to load posts");
        }
        setPosts(json.data ?? null);
        setError(null);
      } catch (e) {
        setError(e instanceof Error ? e.message : "Failed to load posts");
      } finally {
        setLoadingPosts(false);
      }
    },
    []
  );

  useEffect(() => {
    void loadCommunities();
  }, [loadCommunities]);

  useEffect(() => {
    if (selected) {
      void loadPosts(selected.id);
      setComposerOpen(false);
      setTitle("");
      setText("");
    } else {
      setPosts(null);
    }
  }, [selected, loadPosts]);

  async function runCommunityAction(fn: () => Promise<{ ok: boolean; status: number; json: ActionResponse | null }>, doneMsg: string) {
    setAction(doneMsg);
    const res = await fn();
    setAction(null);
    if (!res.ok) {
      setError(res.json?.error?.message ?? "Action failed");
      return;
    }
    void loadCommunities();
    if (selected) void loadPosts(selected.id);
  }

  const join = () => {
    if (!selected) return;
    void runCommunityAction(
      () => communityFetch<ActionResponse>(`/api/campus/communities/${encodeURIComponent(selected.id)}/join`, { method: "POST" }),
      "Joining…"
    );
  };

  const leave = () => {
    if (!selected) return;
    void runCommunityAction(
      () =>
        communityFetch<ActionResponse>(
          `/api/campus/communities/${encodeURIComponent(selected.id)}/leave`,
          { method: "POST" }
        ),
      "Leaving…"
    );
  };

  const createPost = async () => {
    if (!selected || !title.trim() || !text.trim()) return;
    const res = await communityFetch<ActionResponse>(`/api/campus/communities/${encodeURIComponent(selected.id)}/posts`, {
      method: "POST",
      body: JSON.stringify({ title: title.trim(), body: text.trim() }),
    });
    if (!res.ok) {
      setError(res.json?.error?.message ?? "Could not post");
      return;
    }
    setTitle("");
    setText("");
    setComposerOpen(false);
    void loadPosts(selected.id);
  };

  const moderate = async (postId: string, modAction: "approve" | "hide" | "unhide") => {
    if (!selected) return;
    const res = await communityFetch<ActionResponse>(`/api/campus/communities/${encodeURIComponent(selected.id)}/moderate`, {
      method: "POST",
      body: JSON.stringify({ postId, action: modAction }),
    });
    if (!res.ok) {
      setError(res.json?.error?.message ?? "Moderation failed");
      return;
    }
    void loadPosts(selected.id);
  };

  const report = async (postId: string) => {
    if (!selected) return;
    const reason = (reportReason[postId] ?? "").trim();
    if (!reason) return;
    const res = await communityFetch<ActionResponse>(`/api/campus/communities/${encodeURIComponent(selected.id)}/report`, {
      method: "POST",
      body: JSON.stringify({ postId, reason }),
    });
    if (!res.ok) {
      setError(res.json?.error?.message ?? "Could not report");
      return;
    }
    setReportReason((r) => ({ ...r, [postId]: "" }));
    setReportTarget(null);
    void loadPosts(selected.id);
  };

  const selectedData = selected ? posts : null;
  const canModerateSelected = selectedData?.canModerate ?? false;
  const canCompose = Boolean(selected?.isMember || canModerateSelected);

  return (
    <WidgetBoundary title="Communities">
      <section aria-label="Campus communities" className="surface-card bg-bg-surface p-5 min-w-0">
        <div className="flex items-center justify-between gap-3">
          <h2 className="flex items-center gap-2 text-sm font-bold text-text-primary">
            <Users className="h-4 w-4 text-unit-c" aria-hidden />
            Communities
          </h2>
          <p className="text-xs text-text-muted">
            All communities are moderated — new posts await review
          </p>
        </div>

        {loadingCommunities && communities.length === 0 ? (
          <div className="mt-6 flex items-center justify-center gap-2 py-8 text-sm text-text-muted" role="status">
            <Loader2 className="h-4 w-4 animate-spin motion-reduce:animate-none" aria-hidden />
            Loading communities…
          </div>
        ) : error && communities.length === 0 ? (
          <div className="surface-card mt-5 bg-rose-500/10 p-3 text-sm text-rose-600">{error}</div>
        ) : communities.length === 0 ? (
          <div className="mt-6 flex flex-col items-center gap-2 py-8 text-center text-text-muted">
            <Inbox className="h-6 w-6 opacity-50" aria-hidden />
            <p className="text-sm">No communities yet — administrators can create one.</p>
          </div>
        ) : (
          <>
            <div className="mt-4 flex gap-2 overflow-x-auto pb-1" role="tablist" aria-label="Choose a community">
              {communities.map((c) => {
                const Icon = iconFor(c.icon, c.name);
                const active = selected?.id === c.id;
                return (
                  <button
                    key={c.id}
                    type="button"
                    role="tab"
                    aria-selected={active}
                    onClick={() => setSelected(active ? null : c)}
                    className={`flex shrink-0 items-center gap-2 rounded-xl border px-3 py-2 text-left transition-colors motion-reduce:transition-none ${
                      active
                        ? "border-violet-500/50 bg-violet-500/15"
                        : "border-border bg-[var(--bg-raised)]/30 hover:bg-[var(--bg-raised)]/60"
                    }`}
                  >
                    <Icon className="h-4 w-4 shrink-0 text-unit-c" aria-hidden />
                    <span className="min-w-0">
                      <span className="block truncate text-xs font-semibold text-text-primary">{c.name}</span>
                      <span className="flex items-center gap-1 text-xs text-text-muted">
                        <Users className="size-3.5" aria-hidden />
                        {c.memberCount}
                        {c.isMember && (
                          <span className="surface-card ml-1 bg-violet-500/20 px-1.5 text-xs font-semibold text-unit-c">
                            {c.myRole ?? "member"}
                          </span>
                        )}
                      </span>
                    </span>
                  </button>
                );
              })}
            </div>

            {selected ? (
              <div className="surface-card mt-4 bg-[var(--bg-raised)]/30 p-4">
                <div className="flex flex-wrap items-center justify-between gap-2">
                  <div className="min-w-0">
                    <h3 className="truncate text-sm font-bold text-text-primary">{selected.name}</h3>
                    {selected.description && (
                      <p className="mt-0.5 line-clamp-2 text-xs text-text-muted">{selected.description}</p>
                    )}
                  </div>
                  <div className="flex items-center gap-1.5">
                    {action && (
                      <span className="flex items-center gap-1 text-xs text-text-muted">
                        <Loader2 className="size-3.5 animate-spin motion-reduce:animate-none" aria-hidden />
                        {action}
                      </span>
                    )}
                    {selected.isMember ? (
                      <button
                        type="button"
                        onClick={() => void leave()}
                        className="surface-card inline-flex items-center gap-1 bg-bg-surface px-2.5 py-1 text-xs font-medium text-text-muted hover:text-action-danger motion-safe:transition-colors motion-reduce:transition-none disabled:opacity-50"
                      >
                        <UserMinus className="h-3.5 w-3.5" aria-hidden />
                        Leave
                      </button>
                    ) : (
                      <button
                        type="button"
                        onClick={() => void join()}
                        className="surface-card inline-flex items-center gap-1 bg-violet-500/15 px-2.5 py-1 text-xs font-semibold text-unit-c hover:bg-violet-500/25 motion-safe:transition-colors motion-reduce:transition-none disabled:opacity-50"
                      >
                        <UserPlus className="h-3.5 w-3.5" aria-hidden />
                        Join
                      </button>
                    )}
                  </div>
                </div>

                {canCompose ? (
                  <div className="mt-3">
                    {composerOpen ? (
                      <div className="surface-card bg-bg-surface p-3">
                        <input
                          value={title}
                          onChange={(e) => setTitle(e.target.value)}
                          placeholder="Title"
                          aria-label="Post title"
                          maxLength={200}
                          className="surface-card w-full bg-[var(--bg-raised)] px-2 py-1.5 text-xs text-text-primary outline-none focus:"
                        />
                        <textarea
                          value={text}
                          onChange={(e) => setText(e.target.value)}
                          placeholder="Share something with the community…"
                          aria-label="Post body"
                          rows={3}
                          maxLength={5000}
                          className="surface-card mt-2 w-full resize-y bg-[var(--bg-raised)] px-2 py-1.5 text-xs text-text-primary outline-none focus:"
                        />
                        <div className="mt-2 flex items-center justify-between gap-2">
                          <p className="text-xs text-text-muted">
                            {canModerateSelected ? "Posts publish immediately." : "Your post will be reviewed by moderators."}
                          </p>
                          <div className="flex items-center gap-1.5">
                            <button
                              type="button"
                              onClick={() => setComposerOpen(false)}
                              className="surface-card px-2 py-1 text-xs text-text-muted"
                            >
                              Cancel
                            </button>
                            <button
                              type="button"
                              onClick={() => void createPost()}
                              disabled={!title.trim() || !text.trim()}
                              className="surface-card inline-flex items-center gap-1 bg-violet-500/15 px-2 py-1 text-xs font-semibold text-unit-c disabled:opacity-40"
                            >
                              <MessageSquarePlus className="h-3.5 w-3.5" aria-hidden />
                              Post
                            </button>
                          </div>
                        </div>
                      </div>
                    ) : (
                      <button
                        type="button"
                        onClick={() => setComposerOpen(true)}
                        className="surface-card flex w-full items-center gap-2 bg-bg-surface/60 px-3 py-2.5 text-xs text-text-muted hover:text-text-primary motion-safe:transition-colors motion-reduce:transition-none"
                      >
                        <Plus className="h-3.5 w-3.5" aria-hidden />
                        Start a discussion in {selected.name}
                      </button>
                    )}
                  </div>
                ) : (
                  <p className="surface-card mt-3 bg-bg-surface/50 px-3 py-2.5 text-xs text-text-muted">
                    Join {selected.name} to start a discussion.
                  </p>
                )}

                {loadingPosts ? (
                  <div className="mt-4 flex items-center gap-2 py-4 text-xs text-text-muted" role="status">
                    <Loader2 className="h-4 w-4 animate-spin motion-reduce:animate-none" aria-hidden />
                    Loading posts…
                  </div>
                ) : selectedData && selectedData.posts.length === 0 ? (
                  <p className="mt-4 flex items-center gap-2 py-2 text-xs text-text-muted">
                    <Inbox className="h-4 w-4 opacity-50" aria-hidden />
                    No posts here yet.
                  </p>
                ) : selectedData ? (
                  <ul className="mt-4 space-y-2.5" aria-label="Community posts">
                    {selectedData.posts.map((p) => {
                      const showModerateMenu = canModerateSelected;
                      const pendingHint = p.status === "pending" && (p.isOwn || canModerateSelected);
                      const hiddenHint = p.status === "hidden" && (p.isOwn || canModerateSelected);
                      return (
                        <li key={p.id} className="surface-card bg-bg-surface/60 p-3">
                          <div className="flex items-start justify-between gap-2">
                            <div className="min-w-0">
                              <p className="truncate text-xs font-semibold text-text-primary">{p.title}</p>
                              <p className="mt-1 line-clamp-3 text-xs text-text-muted">{p.body}</p>
                              <p className="mt-1.5 flex flex-wrap items-center gap-1.5 text-xs text-text-muted">
                                <span className="font-medium text-text-primary">{p.author}</span>
                                <span aria-hidden>·</span>
                                <Clock className="size-3.5" aria-hidden />
                                {formatWhen(p.createdAt) ?? "recently"}
                                {p.isOwn && pendingHint && (
                                  <span className="surface-card inline-flex items-center gap-1 bg-amber-500/15 px-2 py-0.5 font-semibold text-action-warning">
                                    <ShieldCheck className="size-3.5" aria-hidden />
                                    pending moderation
                                  </span>
                                )}
                                {hiddenHint && (
                                  <span className="surface-card inline-flex items-center gap-1 bg-rose-500/15 px-2 py-0.5 font-semibold text-action-danger">
                                    <EyeOff className="size-3.5" aria-hidden />
                                    hidden
                                  </span>
                                )}
                              </p>
                            </div>
                            {showModerateMenu && (
                              <div className="flex shrink-0 items-center gap-1" role="menu" aria-label={`Moderate ${p.title}`}>
                                {p.status !== "approved" && (
                                  <button
                                    type="button"
                                    onClick={() => void moderate(p.id, "approve")}
                                    title="Approve post"
                                    className="surface-card inline-flex items-center gap-1 bg-emerald-500/15 px-2 py-1 text-xs font-semibold text-action-success hover:bg-emerald-500/25"
                                  >
                                    <Check className="size-3.5" aria-hidden />
                                    Approve
                                  </button>
                                )}
                                {p.status !== "hidden" && (
                                  <button
                                    type="button"
                                    onClick={() => void moderate(p.id, "hide")}
                                    title="Hide post"
                                    className="surface-card inline-flex items-center gap-1 bg-rose-500/15 px-2 py-1 text-xs font-semibold text-action-danger hover:bg-rose-500/25"
                                  >
                                    <EyeOff className="size-3.5" aria-hidden />
                                    Hide
                                  </button>
                                )}
                              </div>
                            )}
                          </div>
                          <div className="mt-2 flex flex-wrap items-center gap-2">
                            {reportTarget === p.id ? (
                              <div className="flex w-full items-center gap-1.5">
                                <input
                                  value={reportReason[p.id] ?? ""}
                                  onChange={(e) => setReportReason((r) => ({ ...r, [p.id]: e.target.value }))}
                                  placeholder="Why is this post a problem?"
                                  aria-label="Report reason"
                                  maxLength={500}
                                  className="surface-card min-w-0 flex-1 bg-[var(--bg-raised)] px-2 py-1 text-xs text-text-primary outline-none focus:"
                                />
                                <button
                                  type="button"
                                  onClick={() => void report(p.id)}
                                  disabled={!(reportReason[p.id] ?? "").trim()}
                                  className="surface-card bg-rose-500/15 px-2 py-1 text-xs font-semibold text-action-danger disabled:opacity-40"
                                >
                                  Send
                                </button>
                                <button
                                  type="button"
                                  onClick={() => setReportTarget(null)}
                                  className="surface-card px-2 py-1 text-xs text-text-muted"
                                >
                                  Cancel
                                </button>
                              </div>
                            ) : (
                              <button
                                type="button"
                                onClick={() => setReportTarget(p.id)}
                                disabled={!selectedData.isMember}
                                className="surface-card inline-flex items-center gap-1 px-1.5 py-1 text-xs text-text-muted hover:text-action-danger disabled:opacity-30"
                              >
                                <Flag className="size-3.5" aria-hidden />
                                Report
                                {p.reportedCount > 0 ? ` (${p.reportedCount})` : ""}
                              </button>
                            )}
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                ) : null}
              </div>
            ) : (
              <p className="mt-4 text-xs text-text-muted">Select a community above to view its discussions.</p>
            )}
          </>
        )}
      </section>
    </WidgetBoundary>
  );
}
</file>

<file path="src/components/engagement/EngagementWidgets.tsx">
"use client";

/**
 * EngagementWidgets — composes the full Campus Engagement module into a
 * responsive dashboard grid. Widget ordering and pinning come from
 * `useEngagementStore`; notification preferences (quiet hours / daily
 * summary) gate which extra reminder text is shown in the card.
 *
 * The composition renders each widget inside its own WidgetBoundary so
 * one widget failing never takes down the rest.
 */
import type { ReactElement } from "react";
import { useMemo } from "react";
import {
  useEngagementStore,
  resolveWidgetOrder,
  ENGAGEMENT_WIDGET_IDS,
  type EngagementWidgetId,
} from "@/stores/engagementStore";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { useEffectivePref } from "@/hooks/useEffectivePref";
import { MyCampusProfile } from "./MyCampusProfile";
import { CampusFeed } from "./CampusFeed";
import { EventsPanel } from "./EventsPanel";
import { Achievements } from "./Achievements";
import { PersonalGoals } from "./PersonalGoals";
import { CampusAssistant } from "./CampusAssistant";
import { SemesterRecap } from "./SemesterRecap";
import { DashboardCustomizer } from "./DashboardCustomizer";

const WIDGETS: Record<EngagementWidgetId, () => ReactElement | null> = {
  profile: () => <MyCampusProfile />,
  feed: () => <CampusFeed limit={12} />,
  events: () => <EventsPanel limit={6} />,
  achievements: () => <Achievements />,
  goals: () => <PersonalGoals />,
  assistant: () => <CampusAssistant />,
  recap: () => <SemesterRecap />,
  notifications: () => <NotificationPrefsSummary />,
};

/**
 * The "notifications" widget renders a compact summary of the user's
 * notification preferences from the engagement store. It does NOT
 * replace the NotificationCenter panel the app already ships; it is
 * only the engagement-module's own quiet-hours / daily-summary view.
 */
function NotificationPrefsSummary() {
  const prefs = useEngagementStore((s) => s.notificationPrefs);
  const quietActive =
    prefs.quietHours &&
    (() => {
      const now = new Date();
      const cur = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
      if (prefs.quietHoursFrom <= prefs.quietHoursTo) {
        return cur >= prefs.quietHoursFrom && cur < prefs.quietHoursTo;
      }
      return cur >= prefs.quietHoursFrom || cur < prefs.quietHoursTo; // overnight
    })();

  return (
    <section
      aria-label="Notification preferences summary"
      className="surface-card bg-bg-surface p-5 min-w-0"
    >
      <h2 className="text-sm font-bold text-text-primary">
        Notification preferences
      </h2>
      <ul className="mt-3 space-y-2 text-xs text-text-muted">
        <li>
          <strong className="text-text-primary">Quiet hours</strong>:{" "}
          {prefs.quietHours
            ? `${prefs.quietHoursFrom}–${prefs.quietHoursTo}${quietActive ? " · active now" : ""}`
            : "off"}
        </li>
        <li>
          <strong className="text-text-primary">Daily summary</strong>:{" "}
          {prefs.dailySummary ? `at ${prefs.dailySummaryTime}` : "off"}
        </li>
        <li>
          <strong className="text-text-primary">Event reminders</strong>:{" "}
          {prefs.eventReminders ? "on" : "off"}
        </li>
        <li>
          <strong className="text-text-primary">Announcement alerts</strong>:{" "}
          {prefs.announcementAlerts ? "on" : "off"}
        </li>
      </ul>
      <p className="mt-3 text-xs text-text-muted">
        Preferences only change how digests are surfaced to you — delivery
        permissions are always enforced by the server.
      </p>
    </section>
  );
}

export function EngagementWidgets() {
  const storeOrder = useEngagementStore((s) => s.widgetOrder);
  const pinnedWidgets = useEngagementStore((s) => s.pinnedWidgets);

  // Taste layer: the effective widget order is the 5-layer cascade —
  //   policy > user (store) > trait > persona > role > system.
  // The store holds the user's saved order; when the user hasn't saved one,
  // the trait + persona defaults supply it. Engagement widget ids are:
  // profile, feed, events, achievements, goals, assistant, recap, notifications.
  const prefOrder = useEffectivePref<EngagementWidgetId[]>("dashboard.engagementWidgetOrder");
  const widgetOrder = storeOrder.length > 0 ? storeOrder : prefOrder.value ?? [];

  const order = useMemo(
    () => resolveWidgetOrder({ widgetOrder, pinnedWidgets }),
    [widgetOrder, pinnedWidgets]
  );

  return (
    <div className="space-y-6">
      <WidgetBoundary title="Engagement dashboard">
        <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {order.map((id) => {
            const Render = WIDGETS[id];
            if (!Render) return null;
            return <Render key={id} />;
          })}
        </div>
      </WidgetBoundary>

      <DashboardCustomizer />
    </div>
  );
}
</file>

