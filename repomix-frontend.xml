<file path="src/components/admin/WorkerTypeAndBlockPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";

interface WorkerType {
  id: string;
  code: string;
  label: string;
}

interface WorkerUser {
  id: string;
  unique_id: string;
  name: string;
}

interface PlaceRow {
  id: string;
  code: string;
  name: string;
  kind: string;
  occupant_type: string;
}

interface AssignmentRow {
  id: string;
  worker_name: string;
  worker_code: string;
  worker_type_label: string | null;
  worker_type_code: string;
  block_id: string | null;
  occupant_type?: string | null;
  shift_name: string;
}

interface AttendanceLog {
  id: string;
  worker_name: string;
  worker_code: string;
  worker_type_label: string | null;
  direction: string;
  block_id: string | null;
  logged_at: string;
}

export function WorkerTypeAndBlockPanel() {
  const [types, setTypes] = useState<WorkerType[]>([]);
  const [workers, setWorkers] = useState<WorkerUser[]>([]);
  const [places, setPlaces] = useState<PlaceRow[]>([]);
  const [assignments, setAssignments] = useState<AssignmentRow[]>([]);
  const [logs, setLogs] = useState<AttendanceLog[]>([]);

  const [newCode, setNewCode] = useState("");
  const [newLabel, setNewLabel] = useState("");

  const [placeCode, setPlaceCode] = useState("");
  const [placeName, setPlaceName] = useState("");
  const [placeKind, setPlaceKind] = useState("hostel_block");
  const [occupantType, setOccupantType] = useState("students");

  const [workerId, setWorkerId] = useState("");
  const [typeCode, setTypeCode] = useState("kitchen");
  const [blockId, setBlockId] = useState("");
  const [shiftName, setShiftName] = useState("Morning");

  const load = useCallback(() => {
    fetch("/api/workers/types")
      .then((r) => r.json())
      .then((j) => setTypes(j?.data?.types ?? []))
      .catch(() => {});
    fetch("/api/security/locations")
      .then((r) => r.json())
      .then((j) => {
        const list: PlaceRow[] = j?.data?.locations ?? [];
        setPlaces(list);
        if (list[0]?.name && !blockId) setBlockId(list[0].name);
      })
      .catch(() => {});
    fetch("/api/workers/assignments")
      .then((r) => r.json())
      .then((j) => {
        setAssignments(j?.data?.assignments ?? []);
        const wList: WorkerUser[] = j?.data?.workers ?? [];
        setWorkers(wList);
        if (wList[0]?.id && !workerId) setWorkerId(wList[0].id);
      })
      .catch(() => {});
    fetch("/api/workers/attendance")
      .then((r) => r.json())
      .then((j) => setLogs(j?.data?.logs ?? []))
      .catch(() => {});
  }, [workerId, blockId]);

  useEffect(() => {
    load();
  }, [load]);

  async function addType(e: React.FormEvent) {
    e.preventDefault();
    if (!newCode.trim() || !newLabel.trim()) return;
    await fetch("/api/workers/types", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ code: newCode.trim(), label: newLabel.trim() }),
    });
    setNewCode("");
    setNewLabel("");
    load();
  }

  async function addPlace(e: React.FormEvent) {
    e.preventDefault();
    if (!placeCode.trim() || !placeName.trim()) return;
    await fetch("/api/security/locations", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        code: placeCode.trim(),
        name: placeName.trim(),
        kind: placeKind,
        occupant_type: occupantType,
      }),
    });
    setPlaceCode("");
    setPlaceName("");
    load();
  }

  async function assignWorker(e: React.FormEvent) {
    e.preventDefault();
    if (!workerId) return;
    await fetch("/api/workers/assignments", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        worker_id: workerId,
        worker_type_code: typeCode,
        block_id: blockId.trim() || null,
        shift_name: shiftName,
      }),
    });
    load();
  }

  return (
    <div className="space-y-6 pt-6">
      <h2 className="text-base font-semibold text-foreground">
        Worker Types, Places of Work, Block Assignments & In/Out Logs
      </h2>

      <form onSubmit={addPlace} className="grid gap-2 sm:grid-cols-5">
        <input
          type="text"
          value={placeCode}
          onChange={(e) => setPlaceCode(e.target.value)}
          placeholder="Place code (e.g. BLOCK_A)"
          className="border-b border-border py-1.5 text-xs text-foreground"
          required
        />
        <input
          type="text"
          value={placeName}
          onChange={(e) => setPlaceName(e.target.value)}
          placeholder="Place name (e.g. Boys Hostel Block A)"
          className="border-b border-border py-1.5 text-xs text-foreground"
          required
        />
        <select
          value={placeKind}
          onChange={(e) => setPlaceKind(e.target.value)}
          className="border-b border-border py-1.5 text-xs text-foreground"
        >
          <option value="hostel_block">Hostel Block</option>
          <option value="building">Academic / Faculty Block</option>
          <option value="canteen">Kitchen / Canteen</option>
          <option value="lab">Lab</option>
          <option value="library">Library</option>
          <option value="open_area">Campus Grounds</option>
        </select>
        <select
          value={occupantType}
          onChange={(e) => setOccupantType(e.target.value)}
          className="border-b border-border py-1.5 text-xs text-foreground"
        >
          <option value="students">Occupants: Students</option>
          <option value="faculty">Occupants: Faculty</option>
          <option value="staff">Occupants: Staff</option>
          <option value="mixed">Occupants: Mixed</option>
        </select>
        <button type="submit" className="bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground">
          Define Place
        </button>
      </form>

      <form onSubmit={addType} className="flex flex-wrap gap-2">
        <input
          type="text"
          value={newCode}
          onChange={(e) => setNewCode(e.target.value)}
          placeholder="Type code (e.g. carpentry)"
          className="border-b border-border py-1.5 text-xs text-foreground"
          required
        />
        <input
          type="text"
          value={newLabel}
          onChange={(e) => setNewLabel(e.target.value)}
          placeholder="Respectful label (e.g. Carpentry & Woodwork)"
          className="flex-1 border-b border-border py-1.5 text-xs text-foreground"
          required
        />
        <button type="submit" className="bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground">
          Add Worker Type
        </button>
      </form>

      <form onSubmit={assignWorker} className="grid gap-2 sm:grid-cols-5">
        <select
          value={workerId}
          onChange={(e) => setWorkerId(e.target.value)}
          className="border-b border-border py-1.5 text-xs text-foreground"
        >
          {workers.map((w) => (
            <option key={w.id} value={w.id}>
              {w.name} ({w.unique_id})
            </option>
          ))}
        </select>
        <select
          value={typeCode}
          onChange={(e) => setTypeCode(e.target.value)}
          className="border-b border-border py-1.5 text-xs text-foreground"
        >
          {types.map((t) => (
            <option key={t.id} value={t.code}>
              {t.label}
            </option>
          ))}
        </select>
        {places.length > 0 ? (
          <select
            value={blockId}
            onChange={(e) => setBlockId(e.target.value)}
            className="border-b border-border py-1.5 text-xs text-foreground"
          >
            {places.map((p) => (
              <option key={p.id} value={p.name}>
                {p.name} ({p.occupant_type})
              </option>
            ))}
          </select>
        ) : (
          <input
            type="text"
            value={blockId}
            onChange={(e) => setBlockId(e.target.value)}
            placeholder="Place / Block"
            className="border-b border-border py-1.5 text-xs text-foreground"
          />
        )}
        <select
          value={shiftName}
          onChange={(e) => setShiftName(e.target.value)}
          className="border-b border-border py-1.5 text-xs text-foreground"
        >
          <option value="Morning">Morning (06:00–14:00)</option>
          <option value="Evening">Evening (14:00–22:00)</option>
          <option value="Night">Night (22:00–06:00)</option>
        </select>
        <button type="submit" className="bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground">
          Assign Place & Shift
        </button>
      </form>

      <div className="grid gap-6 md:grid-cols-2">
        <div>
          <h3 className="text-xs font-semibold uppercase text-muted-foreground">
            Active Place Assignments ({assignments.length})
          </h3>
          <div className="mt-2 divide-y divide-border">
            {assignments.map((a) => (
              <div key={a.id} className="py-1.5 text-xs text-foreground">
                <strong>{a.worker_name}</strong> ({a.worker_code}) —{" "}
                {a.worker_type_label ?? a.worker_type_code} • {a.block_id ?? "Campus"}
                {a.occupant_type ? ` (${a.occupant_type})` : ""} • {a.shift_name}
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 className="text-xs font-semibold uppercase text-muted-foreground">
            Recent Worker In/Out Logs ({logs.length})
          </h3>
          <div className="mt-2 divide-y divide-border">
            {logs.slice(0, 15).map((l) => (
              <div key={l.id} className="flex justify-between py-1.5 text-xs text-foreground">
                <span>
                  <strong>{l.direction}</strong> • {l.worker_name} ({l.worker_type_label ?? "Support"}) •{" "}
                  {l.block_id ?? "Campus"}
                </span>
                <span className="text-muted-foreground">{new Date(l.logged_at).toLocaleTimeString()}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/security/PlacesEditor.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";

interface PlaceRow {
  id: string;
  code: string;
  name: string;
  kind: string;
  lat: number;
  lng: number;
  radius_m: number;
  active: boolean;
}

export function PlacesEditor() {
  const [places, setPlaces] = useState<PlaceRow[]>([]);
  const [filter, setFilter] = useState("");
  const [code, setCode] = useState("");
  const [name, setName] = useState("");
  const [kind, setKind] = useState("open_area");
  const [lat, setLat] = useState("17.9784");
  const [lng, setLng] = useState("79.5942");
  const [radiusM, setRadiusM] = useState("30");

  function useMyGps() {
    if (typeof navigator !== "undefined" && navigator.geolocation) {
      navigator.geolocation.getCurrentPosition((pos) => {
        setLat(pos.coords.latitude.toFixed(6));
        setLng(pos.coords.longitude.toFixed(6));
      });
    }
  }

  const load = useCallback(() => {
    fetch("/api/security/locations")
      .then((r) => r.json())
      .then((j) => setPlaces(j?.data?.locations ?? []))
      .catch(() => {});
  }, []);

  useEffect(() => {
    load();
  }, [load]);

  async function addPlace(e: React.FormEvent) {
    e.preventDefault();
    const r = await fetch("/api/security/locations", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        code: code.trim(),
        name: name.trim(),
        kind,
        lat: Number(lat),
        lng: Number(lng),
        radius_m: Number(radiusM),
      }),
    });
    if (r.ok) {
      setCode("");
      setName("");
      load();
    }
  }

  return (
    <div className="space-y-4">
      <form onSubmit={addPlace} className="grid gap-2 sm:grid-cols-6">
        <input
          type="text"
          value={code}
          onChange={(e) => setCode(e.target.value)}
          placeholder="CODE"
          className="border border-border bg-background px-2 py-1.5 text-sm text-foreground"
          required
        />
        <input
          type="text"
          value={name}
          onChange={(e) => setName(e.target.value)}
          placeholder="Location name"
          className="border border-border bg-background px-2 py-1.5 text-sm text-foreground sm:col-span-2"
          required
        />
        <select
          value={kind}
          onChange={(e) => setKind(e.target.value)}
          className="border border-border bg-background px-2 py-1.5 text-sm text-foreground"
        >
          {["gate", "building", "hostel_block", "open_area", "lab", "library", "canteen", "parking", "junction", "sos_point"].map((k) => (
            <option key={k} value={k}>
              {k}
            </option>
          ))}
        </select>
        <input
          type="text"
          value={`${lat},${lng}`}
          onChange={(e) => {
            const [a, b] = e.target.value.split(",");
            if (a !== undefined) setLat(a.trim());
            if (b !== undefined) setLng(b.trim());
          }}
          placeholder="lat,lng"
          className="border border-border bg-background px-2 py-1.5 text-sm text-foreground"
        />
        <button type="button" onClick={useMyGps} className="border border-border px-2 py-1.5 text-xs text-foreground">
          Use GPS
        </button>
        <button type="submit" className="bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground">
          Add Place
        </button>
      </form>

      <input
        type="text"
        value={filter}
        onChange={(e) => setFilter(e.target.value)}
        placeholder="Type to filter places by code, name, or kind..."
        className="w-full border-b border-border py-1.5 text-sm text-foreground"
      />

      <div className="divide-y divide-border">
        {places
          .filter(
            (p) =>
              !filter.trim() ||
              p.code.toLowerCase().includes(filter.toLowerCase()) ||
              p.name.toLowerCase().includes(filter.toLowerCase()) ||
              p.kind.toLowerCase().includes(filter.toLowerCase()),
          )
          .map((p) => (
          <div key={p.id} className="flex items-center justify-between py-2 text-sm text-foreground">
            <span>
              <strong>{p.code}</strong> — {p.name} ({p.kind})
            </span>
            <span className="font-mono text-xs text-muted-foreground">
              {p.lat.toFixed(4)}, {p.lng.toFixed(4)} • r={p.radius_m}m
            </span>
          </div>
        ))}
      </div>
    </div>
  );
}
</file>

<file path="src/components/security/ShiftPublisher.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";

interface ShiftRow {
  id: string;
  shift_date: string;
  template_name: string | null;
  status: string;
  is_extra?: boolean;
  extra_reason?: string | null;
}

interface PendingSlot {
  post_id: string;
  name: string;
  location_name: string;
  shift_id: string;
  shift_date: string;
  assigned_count: number;
  min_guards: number;
}

interface HandoverRow {
  id: string;
  post_name: string;
  from_name: string;
  to_name: string;
  status: string;
  notes: string | null;
}

export function ShiftPublisher() {
  const [shifts, setShifts] = useState<ShiftRow[]>([]);
  const [pending, setPending] = useState<PendingSlot[]>([]);
  const [handovers, setHandovers] = useState<HandoverRow[]>([]);
  const [shiftDate, setShiftDate] = useState(() => new Date().toISOString().slice(0, 10));
  const [extraPostId, setExtraPostId] = useState("");
  const [extraOpId, setExtraOpId] = useState("");
  const [extraReason, setExtraReason] = useState("");

  const load = useCallback(() => {
    fetch("/api/security/shifts")
      .then((r) => r.json())
      .then((j) => setShifts(j?.data?.shifts ?? []))
      .catch(() => {});
    fetch("/api/security/shifts/pending-slots")
      .then((r) => r.json())
      .then((j) => setPending(j?.data?.pending_slots ?? []))
      .catch(() => {});
    fetch("/api/security/shifts/handover")
      .then((r) => r.json())
      .then((j) => setHandovers(j?.data?.handovers ?? []))
      .catch(() => {});
  }, []);

  useEffect(() => {
    load();
  }, [load]);

  async function publishToday() {
    await fetch("/api/security/shifts/publish", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ shift_date: shiftDate }),
    });
    load();
  }

  async function createExtraShift(e: React.FormEvent) {
    e.preventDefault();
    if (!extraPostId.trim() || !extraOpId.trim()) return;
    const startsAt = new Date().toISOString();
    const endsAt = new Date(Date.now() + 4 * 3600 * 1000).toISOString();
    await fetch("/api/security/shifts/extra", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        post_id: extraPostId.trim(),
        operator_id: extraOpId.trim(),
        starts_at: startsAt,
        ends_at: endsAt,
        reason: extraReason.trim() || "Extra coverage",
      }),
    });
    setExtraPostId("");
    setExtraOpId("");
    setExtraReason("");
    load();
  }

  async function acceptHandover(id: string) {
    await fetch(`/api/security/shifts/handover/${id}/accept`, { method: "POST" });
    load();
  }

  return (
    <div className="space-y-6">
      <div className="flex items-center gap-3">
        <input
          type="date"
          value={shiftDate}
          onChange={(e) => setShiftDate(e.target.value)}
          className="border border-border bg-background px-3 py-1.5 text-sm text-foreground"
        />
        <button
          type="button"
          onClick={publishToday}
          className="bg-primary px-4 py-1.5 text-xs font-semibold text-primary-foreground"
        >
          Publish Shifts
        </button>
      </div>

      {pending.length > 0 && (
        <div className="space-y-1">
          <h3 className="text-xs font-semibold uppercase text-destructive">
            Pending Place Slots ({pending.length})
          </h3>
          <div className="divide-y divide-border">
            {pending.map((p) => (
              <div key={`${p.shift_id}-${p.post_id}`} className="flex justify-between py-1.5 text-xs text-foreground">
                <span>
                  {p.name} ({p.location_name}) — {p.shift_date.slice(0, 10)}
                </span>
                <span className="text-destructive">
                  {p.assigned_count}/{p.min_guards} assigned
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      <form onSubmit={createExtraShift} className="grid gap-2 sm:grid-cols-4">
        <input
          type="text"
          value={extraPostId}
          onChange={(e) => setExtraPostId(e.target.value)}
          placeholder="Post UUID"
          className="border border-border bg-background px-2 py-1.5 text-xs text-foreground"
          required
        />
        <input
          type="text"
          value={extraOpId}
          onChange={(e) => setExtraOpId(e.target.value)}
          placeholder="Guard UUID"
          className="border border-border bg-background px-2 py-1.5 text-xs text-foreground"
          required
        />
        <input
          type="text"
          value={extraReason}
          onChange={(e) => setExtraReason(e.target.value)}
          placeholder="Extra shift reason"
          className="border border-border bg-background px-2 py-1.5 text-xs text-foreground"
        />
        <button type="submit" className="bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground">
          Assign Extra Shift
        </button>
      </form>

      {handovers.length > 0 && (
        <div className="space-y-1">
          <h3 className="text-xs font-semibold uppercase text-muted-foreground">Shift Handovers</h3>
          <div className="divide-y divide-border">
            {handovers.map((h) => (
              <div key={h.id} className="flex items-center justify-between py-2 text-xs text-foreground">
                <span>
                  {h.post_name}: {h.from_name} → {h.to_name} ({h.status})
                </span>
                {h.status === "pending" && (
                  <button
                    type="button"
                    onClick={() => acceptHandover(h.id)}
                    className="border border-border px-2 py-0.5 text-xs text-primary"
                  >
                    Accept Handover
                  </button>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <div className="divide-y divide-border">
        {shifts.map((s) => (
          <div key={s.id} className="flex items-center justify-between py-2 text-sm text-foreground">
            <span>
              {s.shift_date.slice(0, 10)} • {s.is_extra ? `Extra (${s.extra_reason ?? "coverage"})` : s.template_name ?? "Shift"}
            </span>
            <span className="text-xs font-medium uppercase text-primary">{s.status}</span>
          </div>
        ))}
      </div>
    </div>
  );
}
</file>

