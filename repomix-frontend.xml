<file path="src/components/shared/ScheduleStrip.tsx">
/**
 * ScheduleStrip — horizontal strip of upcoming items with relative "in X min".
 * `items` should be sorted ascending by start. Shows up to `maxVisible`.
 */
import React from "react";
import { Clock } from "lucide-react";
import { cn } from "@/lib/utils";

export interface ScheduleItem {
  id: string;
  title: string;
  /** Subtitle, e.g. room / faculty / gate */
  subtitle?: string;
  start: string; // ISO
  end: string; // ISO
}

export interface ScheduleStripProps {
  items: ScheduleItem[];
  maxVisible?: number;
  className?: string;
}

function relativeTime(iso: string, now: number): string {
  const t = new Date(iso).getTime();
  const diff = t - now;
  const abs = Math.abs(diff);
  const min = Math.round(abs / 60000);
  if (min < 60) return diff > 0 ? `in ${min} min` : `${min} min ago`;
  const hr = Math.round(min / 60);
  if (hr < 24) return diff > 0 ? `in ${hr} h` : `${hr} h ago`;
  const day = Math.round(hr / 24);
  return diff > 0 ? `in ${day} d` : `${day} d ago`;
}

export function ScheduleStrip({ items, maxVisible = 4, className }: ScheduleStripProps) {
  if (items.length === 0) return null;

  const now = Date.now();
  const visible = items.slice(0, maxVisible);
  const next = items.find((i) => new Date(i.start).getTime() >= now) ?? items[0];
  const nextStart = new Date(next.start).getTime();
  const remaining = items.filter((i) => new Date(i.start).getTime() >= now).length;

  return (
    <div className={cn("rounded-xl border border-border bg-bg-surface p-3", className)}>
      {/* Next up */}
      <div className="flex items-center gap-2 mb-2.5">
        <div className="p-1.5 rounded-lg bg-action-primary/10 text-action-primary shrink-0">
          <Clock className="h-4 w-4" />
        </div>
        <div className="min-w-0">
          <p className="text-xs font-medium text-text-muted">Next up</p>
          <p className="text-sm font-semibold text-text-primary truncate">
            {next.title}
            {next.subtitle ? <span className="font-normal text-text-muted"> · {next.subtitle}</span> : null}
          </p>
        </div>
        <div className="ml-auto text-right shrink-0">
          <p className="text-sm font-mono font-semibold text-action-primary">
            {relativeTime(next.start, now)}
          </p>
          {remaining > 1 && (
            <p className="text-[10px] text-text-muted">{remaining} more today</p>
          )}
        </div>
      </div>

      {/* Strip */}
      <div className="flex gap-2 overflow-x-auto">
        {visible.map((item) => {
          const past = new Date(item.end).getTime() < now;
          const current =
            !past && new Date(item.start).getTime() <= now;
          return (
            <div
              key={item.id}
              className={cn(
                "shrink-0 rounded-lg border px-2.5 py-1.5 text-xs min-w-[110px]",
                current
                  ? "border-action-primary bg-action-primary/10 text-action-primary"
                  : past
                    ? "border-border bg-bg-elevated text-text-muted opacity-50"
                    : "border-border bg-bg-elevated text-text-secondary"
              )}
            >
              <p className="font-medium truncate">{item.title}</p>
              <p className="text-[10px] text-text-muted">
                {new Date(item.start).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })}
              </p>
            </div>
          );
        })}
      </div>
    </div>
  );
}

export default ScheduleStrip;
</file>

<file path="src/components/shared/ScrollEdgeBlue.tsx">
"use client";

import React, { useEffect, useRef } from "react";
import { cn } from "@/lib/utils";

/**
 * ScrollEdgeBlue — a scroll-linked, progressive variable-blue blur veil that
 * fades in at the top and bottom edges of a scroll container.
 *
 * The component only writes two CSS variables (`--edge-top`, `--edge-bottom`)
 * on the container element as the user scrolls; the actual blur is composited
 * entirely in CSS (see .scroll-edge-blue in globals.css). Zero work on the
 * paint path — the scroll listener is a cheap passive read + two style
 * writes. The veil is invisible at the exact edge and ramps up over ~140px,
 * so the sharp-focus zone in the center of the content is what the eye rests
 * on.
 *
 * Respects prefers-reduced-motion: when reduced, the CSS disables the ramp and
 * applies a constant subtle veil instead.
 */
export interface ScrollEdgeBlueProps {
  children: React.ReactNode;
  /** Extra classes to merge into the scroll container. */
  className?: string;
  /** Pass true to use the banded (3-layer) blur variant. */
  banded?: boolean;
}

export function ScrollEdgeBlue({
  children,
  className,
  banded = false,
}: ScrollEdgeBlueProps) {
  const ref = useRef<HTMLDivElement | null>(null);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;

    const onScroll = () => {
      const top = el.scrollTop;
      const max = Math.max(0, el.scrollHeight - el.clientHeight);
      const bottom = Math.max(0, max - top);
      // If container is not scrollable, don't show edge blur
      const topVar = max > 0 ? Math.min(1, top / 140) : 0;
      const bottomVar = max > 0 ? Math.min(1, bottom / 140) : 0;
      el.style.setProperty("--edge-top", String(topVar));
      el.style.setProperty("--edge-bottom", String(bottomVar));
    };

    el.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    // Observe size changes of the container or its content to recompute blur immediately
    let ro: ResizeObserver | null = null;
    if (typeof ResizeObserver !== "undefined") {
      ro = new ResizeObserver(() => {
        onScroll();
      });
      ro.observe(el);
      if (el.firstElementChild) {
        ro.observe(el.firstElementChild);
      }
    }

    onScroll();

    return () => {
      el.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      if (ro) ro.disconnect();
    };
  }, []);

  return (
    <div
      ref={ref}
      className={cn(
        "scroll-edge-blue h-full overflow-y-auto relative",
        banded && "scroll-edge-blue-banded",
        className
      )}
    >
      {children}
    </div>
  );
}

export default ScrollEdgeBlue;
</file>

