                      </td>

                      <td className="px-6 py-4">
                        {st.isVerified ? (
                          <span className="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium bg-emerald-500/10 text-emerald-400">
                            <CheckCircle2 className="w-3.5 h-3.5" />
                            Verified
