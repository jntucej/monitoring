      </WidgetBoundary>

      <WidgetBoundary title="Gate Telemetry & Device Status">
        {loadingDevices && devices.length === 0 ? (
          <PageLoading />
        ) : (
          <GateDeviceTracker devices={devices} />
        )}
      </WidgetBoundary>

      <EntityInspector inspection={gateInspectionModel} onClose={() => setActiveGate(null)} />
    </div>
  );
}
