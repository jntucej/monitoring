<file path="src/components/sysadmin/domains/overview/CommandCenterContent.tsx">
"use client";

/**
 * CommandCenterContent — the body of the sysadmin Command Center.
 *
 * Renders the three-region cockpit from the overview payload:
 *   1. Status hero  — overall health dot + label + MFA / backup readouts.
 *   2. KPI tiles    — 4 headline numbers (grid 2-up / 4-up).
 *   3. Topology     — live service FlowMap (click → /sysadmin/health?service=).
 *   4. Attention queue — derived actionable items, or a "nominal" state.
 *
 * Purely presentational: the layout's `useDashboardData` owns fetching;
 * `onRefresh` is threaded back to the PageHeader refresh button.
 */
import Link from "next/link";
import {
  CheckCircle2,
  AlertTriangle,
  XCircle,
  Users,
  Inbox,
  Bell as BellIcon,
  Activity,
  Database,
  Server,
  ShieldAlert,
  Clock,
  ChevronRight,
} from "lucide-react";
import { cn } from "@/lib/utils";
import { FlowMap } from "@/components/sysadmin/kit/viz";
import { MiniSparkline } from "@/components/sysadmin/kit/sidebar";
import { HoverPreview, MetricPreview } from "@/components/shared/HoverPreview";
import { ServiceInspector } from "./ServiceInspector";
import type { CommandCenterData } from "./types";
import { useState } from "react";

export interface CommandCenterContentProps {
  data: CommandCenterData | null;
  onRefresh: () => void;
}

// ── helpers ───────────────────────────────────────────────────────────────

/** "ok" if none bad, "warn" if only warn/degraded, "error" if any error/offline. */
function overallStatus(health: string[]): "ok" | "warn" | "error" {
  let level: "ok" | "warn" | "error" = "ok";
  for (const h of health) {
    const s = h.toLowerCase();
    if (s === "error" || s === "offline" || s === "unhealthy") {
      return "error";
    }
    if (s === "warn" || s === "degraded") level = "warn";
  }
  return level;
}

function avg(nums: number[]): number {
  if (nums.length === 0) return 0;
  return nums.reduce((a, b) => a + b, 0) / nums.length;
}

const STATUS_COLOR: Record<"ok" | "warn" | "error", string> = {
  ok: "var(--action-primary)",
  warn: "var(--action-warning)",
  error: "var(--action-danger)",
};

const STATUS_LABEL: Record<"ok" | "warn" | "error", string> = {
  ok: "All systems operational",
  warn: "Degraded performance",
  error: "Outage in progress",
};

// ── KPI tile ──────────────────────────────────────────────────────────────

interface KpiTile {
  id: string;
  label: string;
  value: string | number;
  hint?: string;
  icon: React.ComponentType<{ className?: string }>;
  tone?: "ok" | "warn" | "error";
  href?: string;
  spark?: number[];
}

function KpiCard({ tile }: { tile: KpiTile }) {
  const tone = tile.tone ?? "ok";
  const toneColor =
    tone === "error"
      ? "var(--action-danger)"
      : tone === "warn"
        ? "var(--action-warning)"
        : "var(--action-primary)";

  const body = (
    <div className="surface-card bg-bg-surface p-4 flex flex-col gap-2">
      <div className="flex items-center justify-between gap-2">
        <div className="flex items-center gap-2 min-w-4">
          <span
            className="inline-flex items-center justify-center size-5 rounded-lg shrink-0"
            style={{
              backgroundColor: `color-mix(in srgb, ${toneColor} 16%, transparent)`,
            }}
          >
            <tile.icon
              className="h-4 w-4"
               
            />
          </span>
          <span className="text-xs font-medium text-text-muted truncate">
            {tile.label}
          </span>
        </div>
        {tile.spark && tile.spark.length > 1 && (
          <MiniSparkline
            label={`${tile.label} trend`}
            values={tile.spark}
            color={toneColor}
            width={40}
            height={14}
            className="shrink-0"
          />
        )}
      </div>
      <div
        className="text-2xl font-semibold tracking-tight"
        style={{ color: tile.tone ? toneColor : "var(--text-primary)" }}
      >
        {tile.value}
      </div>
      {tile.hint && (
        <div className="text-xs text-text-muted -mt-1">
          {tile.hint}
        </div>
      )}
    </div>
  );

  // Every KPI tile is a hover-preview entry point (the quick layer of the
  // inspection hierarchy); the click still navigates to the matching view
  // (the deepest layer) without losing the tile's context.
  return tile.href ? (
    <HoverPreview
      preview={
        <MetricPreview
          label={tile.label}
          value={String(tile.value)}
          hint={tile.hint}
        />
      }
    >
      <Link
        href={tile.href}
        className="block hover:ring-2 hover:ring-action-primary/30 rounded-2xl transition-shadow"
      >
        {body}
      </Link>
    </HoverPreview>
  ) : (
    body
  );
}

// ── main ──────────────────────────────────────────────────────────────────

export function CommandCenterContent({ data }: CommandCenterContentProps) {
  const [inspectedService, setInspectedService] = useState<string | null>(null);
  if (!data) return null;
  const health = data.command?.health ?? [];
  const status = overallStatus(health);
  const backup = data.data?.backupFreshness ?? 0;

  const errorAvg = avg(data.monitoring?.errorRate24h ?? []);
  const openAlerts =
    (data.alerts?.critical ?? 0) +
    (data.alerts?.high ?? 0) +
    (data.alerts?.medium ?? 0) +
    (data.alerts?.low ?? 0);
  const pendingApprovals = data.counts?.["access"] ?? 0;
  const driftCount =
    (data.platform?.envDrift ?? 0) + (data.platform?.schemaDrift ?? 0);

  // ── KPI tiles
  const tiles: KpiTile[] = [
    {
      id: "users",
      label: "Active users",
      value: data.identity?.active ?? 0,
      hint: `${data.identity?.suspended ?? 0} suspended`,
      icon: Users,
      href: "/sysadmin/people",
      tone: "ok",
    },
    {
      id: "approvals",
      label: "Pending approvals",
      value: pendingApprovals,
      hint: pendingApprovals > 0 ? "Action required" : "Inbox clear",
      icon: Inbox,
      href: "/sysadmin/access",
      tone: pendingApprovals > 0 ? "warn" : "ok",
    },
    {
      id: "alerts",
      label: "Open alerts",
      value: openAlerts,
      hint: `${data.alerts?.critical ?? 0} critical`,
      icon: BellIcon,
      href: "/sysadmin/alerts",
      tone:
        (data.alerts?.critical ?? 0) > 0
          ? "error"
          : (data.alerts?.high ?? 0) > 0
            ? "warn"
            : "ok",
    },
    {
      id: "errors",
      label: "Error rate 24h",
      value: `${errorAvg.toFixed(1)}%`,
      hint: "avg hourly",
      icon: Activity,
      href: "/sysadmin/health",
      tone: errorAvg > 5 ? "warn" : "ok",
      spark: data.monitoring?.errorRate24h,
    },
  ];

  // ── Service topology (map health[i] onto the known service set)
  const serviceNames = ["caddy", "web", "postgres", "redis", "worker"];
  const nodes = serviceNames.map((id, i) => ({
    id,
    label: id,
    status: (health[i] ?? "ok") as
      | "ok"
      | "warn"
      | "error"
      | "info"
      | "neutral",
  }));
  const edges = [
    { from: "caddy", to: "web" },
    { from: "web", to: "postgres", latencyMs: 4 },
    { from: "web", to: "redis", latencyMs: 2 },
    { from: "worker", to: "postgres", latencyMs: 12 },
  ];

  // ── Attention queue (derived, most-severe first)
  type Item = {
    id: string;
    title: string;
    detail: string;
    icon: React.ComponentType<{ className?: string; style?: React.CSSProperties }>;
    tone: "error" | "warn" | "ok";
    href: string;
  };
  const items: Item[] = [];
  if ((data.data?.backupFreshness ?? 1) < 0.5) {
    items.push({
      id: "backup",
      title: "Backup is stale",
      detail: `Latest backup freshness ${Math.round((data.data?.backupFreshness ?? 0) * 100)}%`,
      icon: Database,
      tone: "warn",
      href: "/sysadmin/backup",
    });
  }
  if ((data.alerts?.critical ?? 0) > 0) {
    items.push({
      id: "crit",
      title: "Critical alerts open",
      detail: `${data.alerts.critical} critical ${openAlerts > data.alerts.critical ? `· ${openAlerts} total` : ""}`,
      icon: AlertTriangle,
      tone: "error",
      href: "/sysadmin/alerts",
    });
  }
  if (driftCount > 0) {
    items.push({
      id: "drift",
      title: "Configuration drift",
      detail: `${driftCount} ${driftCount === 1 ? "diff" : "diffs"} across env/schema`,
      icon: ShieldAlert,
      tone: "warn",
      href: "/sysadmin/system",
    });
  }

  const toneColor = STATUS_COLOR[status];

  return (
    <div className="space-y-6">
      {/* ── Status hero */}
      <section
        aria-label="System status"
        className="surface-card bg-bg-surface p-5 flex flex-wrap items-center gap-4"
      >
        <div className="flex items-center gap-3 flex-1 min-w-4">
          <span
            className="inline-flex items-center justify-center size-5 rounded-xl shrink-0"
            style={{
              backgroundColor: `color-mix(in srgb, ${toneColor} 18%, transparent)`,
            }}
          >
            {status === "error" ? (
              <XCircle className="h-5 w-5" style={{ color: toneColor }} />
            ) : status === "warn" ? (
              <AlertTriangle className="h-5 w-5" style={{ color: toneColor }} />
            ) : (
              <CheckCircle2 className="h-5 w-5" style={{ color: toneColor }} />
            )}
          </span>
          <div className="min-w-4">
            <p
              className="text-lg font-semibold tracking-tight truncate"
              style={{ color: toneColor }}
            >
              {STATUS_LABEL[status]}
            </p>
            <p className="text-xs text-text-muted mt-0.5 truncate">
              {health.length || 0} services · {STATUS_LABEL[status].toLowerCase()}
            </p>
          </div>
        </div>
        <div className="flex flex-wrap items-center gap-4 text-xs text-text-muted">
          <span className="inline-flex items-center gap-1.5">
            <span
              className="inline-block size-4 rounded-full"
              style={{ backgroundColor: backup < 0.5 ? "var(--action-danger)" : "var(--action-primary)" }}
            />
            Backup freshness {Math.round(backup * 100)}%
          </span>
        </div>
      </section>

      {/* ── KPI tiles */}
      <section
        aria-label="Key metrics"
        className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3"
      >
        {tiles.map((t) => (
          <KpiCard key={t.id} tile={t} />
        ))}
      </section>

      {/* ── Topology + attention queue */}
      <div className="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <section
          aria-label="Service topology"
          className="surface-card lg:col-span-2 bg-bg-surface p-4"
        >
          <div className="flex items-center gap-2 mb-3">
            <Server className="h-4 w-4 text-text-muted" />
            <h2 className="text-sm font-semibold text-text-primary">
              Service topology
            </h2>
            <span className="text-xs text-text-muted ml-auto">
              click a node to inspect
            </span>
          </div>
          <FlowMap
            nodes={nodes}
            edges={edges}
            height={220}
            onNodeClick={(id) => {
              setInspectedService(id);
            }}
          />
          {inspectedService && (
            <ServiceInspector
              serviceId={inspectedService}
              onClose={() => setInspectedService(null)}
            />
          )}
        </section>

        <section
          aria-label="Attention queue"
          className="surface-card lg:col-span-1 bg-bg-surface p-4 flex flex-col"
        >
          <div className="flex items-center gap-2 mb-3">
            <Clock className="h-4 w-4 text-text-muted" />
            <h2 className="text-sm font-semibold text-text-primary">
              Attention
            </h2>
          </div>

          {items.length === 0 ? (
            <div className="flex-1 flex flex-col items-center justify-center text-center py-8">
              <CheckCircle2 className="size-5 text-action-primary mb-3" />
              <p className="text-sm font-medium text-text-primary">
                All systems nominal
              </p>
              <p className="text-xs text-text-muted mt-1">
                Nothing needs attention right now.
              </p>
            </div>
          ) : (
            <ul className="space-y-2">
              {items.map((it) => {
                const c =
                  it.tone === "error"
                    ? "var(--action-danger)"
                    : it.tone === "warn"
                      ? "var(--action-warning)"
                      : "var(--action-primary)";
                return (
                  <li key={it.id}>
                    <Link
                      href={it.href}
                      className={cn(
                        "flex items-center gap-3 rounded-xl border border-border p-3",
                        "hover:border-action-primary/40 hover:bg-bg-elevated transition-colors"
                      )}
                    >
                      <span
                        className="inline-flex items-center justify-center size-5 rounded-lg shrink-0"
                        style={{
                          backgroundColor: `color-mix(in srgb, ${c} 16%, transparent)`,
                        }}
                      >
                        <it.icon className="h-4 w-4" style={{ color: c }} />
                      </span>
                      <span className="min-w-4 flex-1">
                        <span className="block text-sm font-medium text-text-primary truncate">
                          {it.title}
                        </span>
                        <span className="block text-xs text-text-muted truncate">
                          {it.detail}
                        </span>
                      </span>
                      <ChevronLink />
                    </Link>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      </div>
    </div>
  );
}

function ChevronLink() {
  return (
    <svg
      className="h-4 w-4 shrink-0 text-text-muted"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth={2}
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      <path d="m9 18 6-6-6-6" />
    </svg>
  );
}
</file>

<file path="src/components/sysadmin/domains/overview/ServiceInspector.tsx">
"use client";

import { useEffect, useState } from "react";
import { Database, Server, Cpu, HardDrive, Globe, ChevronRight } from "lucide-react";
import { cn } from "@/lib/utils";
import { cachedFetch } from "@/hooks/useApiResource";
import { EntityInspector, KVPairs, InspectorButton, Timeline, type EntityInspection } from "@/components/shared/EntityInspector";
import type { HealthData } from "@/components/sysadmin/domains/monitoring/types";

const SERVICE_META: Record<string, { icon: React.ComponentType<{ className?: string; style?: React.CSSProperties }>; label: string; detail: string; section: keyof HealthData }> = {
  caddy: {
    icon: Globe,
    label: "Caddy Reverse Proxy",
    detail: "TLS termination and routing. Status reflects environment readiness.",
    section: "app",
  },
  web: {
    icon: Server,
    label: "Web Application",
    detail: "Next.js app server handling API and UI requests.",
    section: "app",
  },
  postgres: {
    icon: Database,
    label: "PostgreSQL Database",
    detail: "Primary data store. Connection counts and pool usage below.",
    section: "database",
  },
  redis: {
    icon: HardDrive,
    label: "Redis Cache / Queue",
    detail: "In-memory cache and job queue backend.",
    section: "redis",
  },
  worker: {
    icon: Cpu,
    label: "Background Worker",
    detail: "Processes async jobs, notifications, and scheduled tasks.",
    section: "redis",
  },
};

/**
 * ServiceInspector — the sysadmin service-node inspector.
 *
 * Renders the shared `EntityInspector` drawer (not an inline card) with a
 * standardized `EntityInspection` model for the selected service, so the
 * service topology click exposes the same progressive-disclosure hierarchy
 * every other record in the app uses:
 *
 *   overview (status + key metric) → context (24h trend / pool / queue)
 *   → actions (jump to the matching health page).
 *
 * Data is lazy-loaded from `/api/admin/health/overview` via `cachedFetch`
 * (the same fetcher the dashboard uses); the model is built locally from
 * the response so no new API surface is required. Loading / error / not-
 * found states are exposed through the inspector's state placeholders.
 */

function serviceInspectionModel(
  serviceId: string,
  data: HealthData | null,
  health: string | undefined,
): EntityInspection {
  const meta = SERVICE_META[serviceId];
  const Icon = meta?.icon ?? Server;
  const label = meta?.label ?? serviceId;
  const detail = meta?.detail ?? "";
  const state = health?.toLowerCase() ?? "unknown";
  const tone: "ok" | "warn" | "danger" | "neutral" =
    state === "ok" || state === "online" ? "ok"
    : state === "warn" || state === "degraded" ? "warn"
    : state === "error" || state === "offline" || state === "unhealthy" ? "danger"
    : "neutral";

  const toneClass: Record<string, string> = {
    ok: "bg-emerald-500/15 text-action-success",
    warn: "bg-amber-500/15 text-action-warning",
    danger: "bg-rose-500/15 text-action-danger",
    neutral: "bg-bg-elevated text-text-muted",
  };

  // ── overview KVPairs (section 1) ───────────────────────────────────────
  const overviewItems: Array<{ label: string; value: React.ReactNode }> = [
    {
      label: "Status",
      value: (
        <span className={`inline-block px-1.5 py-0.5 rounded text-[10px] font-bold uppercase ${toneClass[tone]}`}>
          {state.toUpperCase()}
        </span>
      ),
    },
  ];
  if (meta?.section === "app") {
    const rate = data?.app?.errorRate24h ?? [];
    const avg = rate.length ? rate.reduce((a, b) => a + b, 0) / rate.length : 0;
    overviewItems.push({ label: "24h avg error rate", value: `${(avg * 100).toFixed(2)}%` });
  } else if (meta?.section === "database") {
    if (data?.database) {
      overviewItems.push({ label: "Active connections", value: String(data.database.conns) });
      overviewItems.push({ label: "Pool slots", value: String(data.database.pool) });
    }
  } else if (meta?.section === "redis") {
    if (data?.redis) {
      overviewItems.push({
        label: "Worker",
        value: data.redis.worker_healthy ? "Healthy" : "Degraded",
      });
      overviewItems.push({ label: "Queue depth", value: String(data.redis.queue_depth) });
    }
  }

  // ── context (section 2, collapsible where it is long) ──────────────────
  const contextItems: Array<{ label: string; value: React.ReactNode }> = [];
  if (meta?.section === "app") {
    const rate = data?.app?.errorRate24h ?? [];
    contextItems.push({
      label: "Last 5 samples",
      value: rate.length
        ? rate.slice(-5).map((v) => `${Math.round(v * 100)}%`).join(" · ")
        : "—",
    });
  }
  if (meta?.section === "database" && data?.database) {
    contextItems.push({ label: "Section", value: "database" });
  }
  if (meta?.section === "redis" && data?.redis) {
    contextItems.push({ label: "Section", value: "redis" });
  }

  const sections: EntityInspection["sections"] = [
    {
      title: "Overview",
      content: <KVPairs items={overviewItems} columns={1} />,
    },
    ...(contextItems.length
      ? [{
          title: "Context",
          collapsible: true,
          content: <KVPairs items={contextItems} columns={1} />,
        }]
      : []),
    {
      title: "Service detail",
      content: (
        <div className="space-y-2">
          <div className="flex items-center gap-2">
            <span
              className="inline-flex items-center justify-center size-6 rounded-lg"
              style={{
                backgroundColor:
                  "color-mix(in srgb, var(--action-primary) 16%, transparent)",
              }}
            >
              <Icon className="h-3.5 w-3.5 text-action-primary" />
            </span>
            <p className="text-sm font-semibold text-text-primary">{label}</p>
          </div>
          <p className="text-xs text-text-muted">{detail}</p>
          {!data ? (
            <p className="text-xs text-text-muted">Health data not loaded yet.</p>
          ) : null}
        </div>
      ),
    },
    {
      title: "Timeline",
      collapsible: true,
      content: (
        <Timeline
          items={[
            {
              label: "Service health",
              detail: state.toUpperCase(),
              tone,
            },
          ]}
        />
      ),
    },
    {
      title: "Actions",
      content: (
        <div className="flex flex-wrap gap-2">
          <InspectorButton href="/sysadmin/health" variant="primary">
            <ChevronRight className="size-3.5" /> Full health dashboard
          </InspectorButton>
        </div>
      ),
    },
  ];

  return {
    kind: "service",
    title: label,
    subtitle: serviceId,
    status: (
      <span className={`text-[10px] font-bold uppercase px-1.5 py-0.5 rounded ${toneClass[tone]}`}>
        {state.toUpperCase()}
      </span>
    ),
    sections,
    detailHref: "/sysadmin/health",
    detailLabel: "Open health dashboard",
  };
}

export function ServiceInspector({ serviceId, onClose }: { serviceId: string; onClose: () => void }) {
  const [data, setData] = useState<HealthData | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  // Lazy-load health details on mount; cachedFetch handles auth headers.
  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    setError(null);
    cachedFetch<{ data: HealthData }>("/api/admin/health/overview")
      .then((json) => {
        if (cancelled) return;
        setData(json.data);
        setLoading(false);
      })
      .catch((err: unknown) => {
        if (cancelled) return;
        setError(err instanceof Error ? err.message : String(err));
        setLoading(false);
      });
    return () => { cancelled = true; };
  }, [serviceId]);

  const meta = SERVICE_META[serviceId];
  if (!meta) return null;

  // While the health payload is still in flight or failed, surface the
  // state through the inspector's built-in placeholder (design rule 31:
  // the inspector never shows a blank panel).
  const health = undefined;
  const model = data
    ? serviceInspectionModel(serviceId, data, health)
    : null;

  if (error) {
    return (
      <EntityInspector
        inspection={null}
        onClose={onClose}
        state="error"
        errorMessage={error}
      />
    );
  }
  if (loading || !model) {
    return (
      <EntityInspector inspection={null} onClose={onClose} state="loading" />
    );
  }

  return <EntityInspector inspection={model} onClose={onClose} />;
}
</file>

