<file path="src/components/student/ThemePicker.tsx">
"use client";

// ThemePicker — let the user switch between the two shipped UI skins:
//   graphite (professional, neutral)  |  sakuga (anime, lavender/purple)
//
// Persists via PATCH /api/preferences/theme (Bearer-JWT + same-origin CSRF),
// and applies the CSS override immediately (no reload) for live feedback.
// The loader in ClientProviders re-applies on the next mount, so this also
// survives navigation. Rendered inside the student Account/Profile section.
//
// Taste-layer integration: theme is the `appearance.theme` preference key.
// If a future policy pins the theme (rank "required"), the picker shows the
// 🔒 LockedByPolicy chip and disables the buttons — the shell still renders,
// but the choice is governed by the resolver, not hardcoded.
//
// It is theme-agnostic: it shows in BOTH themes so the user can switch away
// from sakuga back to graphite (a sakuga-only control would be impossible
// to reverse from).

import { useEffect, useState } from "react";
import { getAuthHeaders } from "@/lib/utils";
import { cn } from "@/lib/utils";
import { Palette, Check, Loader2, Lock } from "lucide-react";
import { LockedByPolicy } from "@/components/shared/LockedByPolicy";
import { useEffectivePref } from "@/hooks/useEffectivePref";
import { useAuthStore } from "@/stores/authStore";
import { SakuraDualThemeControl } from "@/components/nav/SakuraDualThemeControl";

type ThemeName = "graphite" | "sakuga";

// Theme availability by gender:
//   female → graphite + sakuga (can switch)
//   male   → graphite only (sakuga hidden, locked to graphite)
//   null/unknown → graphite only
const THEMES: { id: ThemeName; label: string; sub: string; swatch: string }[] = [
  {
    id: "graphite",
    label: "Graphite",
    sub: "Professional, neutral",
    swatch: "linear-gradient(135deg, var(--color-text-primary), var(--color-text-secondary))",
  },
  {
    id: "sakuga",
    label: "Sakuga",
    sub: "Anime, lavender",
    swatch: "linear-gradient(135deg, var(--sk-card), var(--sk-pri, var(--color-primary)) 60%, var(--sk-acc, var(--color-danger)))",
  },
];

export function ThemePicker() {
  const [current, setCurrent] = useState<ThemeName | null>(null);
  const [saving, setSaving] = useState<ThemeName | null>(null);
  const [error, setError] = useState<string | null>(null);
  const user = useAuthStore((s) => s.user);

  // Gender-gated theme availability
  const isFemale = user?.studentDetails?.gender === "female";
  const availableThemes = isFemale ? THEMES : THEMES.filter((t) => t.id === "graphite");

  // Taste layer: is the theme pinned by policy? (rank "required")
  const themePref = useEffectivePref<ThemeName>("appearance.theme");

  useEffect(() => {
    let cancelled = false;
    fetch("/api/preferences/theme", { headers: getAuthHeaders() })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!cancelled && d?.ui_theme) setCurrent(d.ui_theme as ThemeName);
      })
      .catch(() => {});
    return () => {
      cancelled = true;
    };
  }, []);

  // Effective theme: policy-pinned value when locked, else the user's choice.
  const effectiveTheme: ThemeName | null = themePref.locked ? themePref.value : current;

  const apply = async (name: ThemeName) => {
    if (themePref.locked) {
      // Required rank: the choice is governed by policy. Stored for audit only.
      setError("Theme is set by institute and cannot be changed.");
      return;
    }
    setSaving(name);
    setError(null);
    try {
      const res = await fetch("/api/preferences/theme", {
        method: "PATCH",
        headers: getAuthHeaders(),
        body: JSON.stringify({ ui_theme: name }),
      });
      const ok = res.ok;
      // Apply the CSS override NOW so the user sees the switch without a reload.
      // (ClientProviders re-applies on the next mount / navigation.)
      if (name === "sakuga") document.documentElement.setAttribute("data-theme", "sakuga");
      else document.documentElement.removeAttribute("data-theme");
      if (!ok) setError("Couldn't save — please try again.");
      setCurrent(name);
    } catch {
      setError("Couldn't save — please try again.");
    } finally {
      setSaving(null);
    }
  };

  return (
    <section
      aria-label="Appearance"
      className="surface-card p-4 md:p-5"
    >
      <div className="mb-3 flex items-center gap-2">
        <Palette className="h-4 w-4 text-action-primary" />
        <p className="text-xs font-bold uppercase tracking-wider text-text-muted">
          Appearance
        </p>
        {themePref.locked && <LockedByPolicy compact reason="Theme set by institute" />}
      </div>

      <div className="grid grid-cols-2 gap-3">
        {availableThemes.map((t) => {
          const active = (themePref.locked ? effectiveTheme : current) === t.id;
          return (
            <button
              key={t.id}
              type="button"
              onClick={() => apply(t.id)}
              disabled={saving !== null || themePref.locked}
              aria-pressed={active}
              className={cn(
                "group relative flex items-center gap-3 rounded-xl border p-3 text-left transition-all",
                active
                  ? "border-action-primary ring-2 ring-action-primary/30 bg-surface-raised"
                  : "border-border hover:border-border-strong bg-bg-surface",
              )}
            >
              <span
                aria-hidden
                className="size-9 shrink-0 rounded-lg border border-border/40 shadow-sm"
                style={{ background: t.swatch }}
              />
              <span className="min-w-0">
                <span className="block truncate text-sm font-semibold text-text-primary">
                  {t.label}
                </span>
                <span className="block truncate text-xs text-text-muted">{t.sub}</span>
              </span>
              {saving === t.id ? (
                <Loader2 className="absolute right-3 top-3 h-4 w-4 animate-spin text-text-muted" />
              ) : active ? (
                <Check className="absolute right-3 top-3 h-4 w-4 text-action-success" />
              ) : null}
            </button>
          );
        })}
      </div>

      {error && <p className="mt-3 text-xs text-action-danger">{error}</p>}
      <p className="mt-3 text-xs text-text-muted">
        Switching applies instantly and is saved to your account.
      </p>
      <div className="mt-4">
        <SakuraDualThemeControl />
      </div>
    </section>
  );
}

export default ThemePicker;
</file>

<file path="src/components/supervisor/GateClaimCodePanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  KeyRound,
  Copy,
  Check,
  Trash2,
  RefreshCw,
  Loader2,
  ListOrdered,
  ShieldCheck,
} from "lucide-react";
import { useAuthStore } from "@/stores/authStore";

interface ClaimGate {
  id: string;
  name: string;
  gateCode?: string;
  gate_code?: string;
}

interface ClaimRow {
  id: string;
  gate_id: string;
  gate_name: string | null;
  operator_name_label: string | null;
  expires_at: string;
  used_at: string | null;
  revoked: boolean;
  created_at: string;
}

function formatExpiry(iso: string): string {
  try {
    return new Date(iso).toLocaleString([], { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
  } catch {
    return iso;
  }
}

/**
 * Supervisor gate-claim code generator + active-code list.
 *
 * The supervisor picks a gate, mints a one-time human-readable claim string
 * (NOT a bare numeric PIN), shows it to / reads it aloud to an operator, who
 * then enters it at the kiosk or operator console to claim that gate. Only the
 * SHA-256 hash is stored — the plaintext appears exactly once, right here.
 */
export function GateClaimCodePanel() {
  const token = useAuthStore((s) => s.token);
  const authHeaders = { Authorization: `Bearer ${token ?? ""}` };

  const [gates, setGates] = useState<ClaimGate[]>([]);
  const [selectedGateId, setSelectedGateId] = useState<string>("");
  const [label, setLabel] = useState("");
  const [generating, setGenerating] = useState(false);

  const [freshCode, setFreshCode] = useState<{ code: string; gateName: string; expiresAt: string } | null>(null);
  const [copied, setCopied] = useState(false);

  const [codes, setCodes] = useState<ClaimRow[]>([]);
  const [loadingCodes, setLoadingCodes] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [busyRevoke, setBusyRevoke] = useState<string | null>(null);

  const loadGates = useCallback(async () => {
    try {
      const res = await fetch("/api/gates", { headers: authHeaders, cache: "no-store" });
      const body = await res.json();
      const raw: any[] = Array.isArray(body?.data) ? body.data : Array.isArray(body) ? body : [];
      const active = raw.filter((g) => g.is_active !== false && g.isActive !== false);
      setGates(active);
      if (active.length > 0 && !selectedGateId) setSelectedGateId(active[0].id);
    } catch {
      /* no gates — panel just shows empty state */
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [token]);

  const loadCodes = useCallback(async () => {
    setLoadingCodes(true);
    setError(null);
    try {
      const res = await fetch("/api/supervisor/claim-codes", { headers: authHeaders, cache: "no-store" });
      const body = await res.json();
      if (body?.success) {
        setCodes(Array.isArray(body.data?.codes) ? body.data.codes : []);
      } else {
        setError(body?.error?.message || "Failed to load active claim codes.");
      }
    } catch {
      setError("Failed to load active claim codes.");
    } finally {
      setLoadingCodes(false);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [token]);

  useEffect(() => { loadGates(); }, [loadGates]);
  useEffect(() => { loadCodes(); }, [loadCodes]);

  const generate = async () => {
    if (!selectedGateId) return;
    setGenerating(true);
    setError(null);
    setFreshCode(null);
    setCopied(false);
    try {
      const res = await fetch("/api/supervisor/claim-codes", {
        method: "POST",
        headers: { ...authHeaders, "Content-Type": "application/json" },
        body: JSON.stringify({ gateId: selectedGateId, label: label || undefined }),
      });
      const body = await res.json();
      if (body?.success) {
        setFreshCode({
          code: body.data.code,
          gateName: body.data.gateName ?? selectedGateId,
          expiresAt: body.data.expiresAt,
        });
        setLabel("");
        loadCodes();
      } else {
        setError(body?.error?.message || "Failed to generate code.");
      }
    } catch {
      setError("Failed to generate code.");
    } finally {
      setGenerating(false);
    }
  };

  const copyCode = async (code: string) => {
    try {
      await navigator.clipboard.writeText(code);
      setCopied(true);
      setTimeout(() => setCopied(false), 1600);
    } catch {
      /* clipboard blocked — the code is still visible to select */
    }
  };

  const revoke = async (code: string) => {
    setBusyRevoke(code);
    try {
      await fetch("/api/supervisor/claim-codes", {
        method: "DELETE",
        headers: { ...authHeaders, "Content-Type": "application/json" },
        body: JSON.stringify({ code }),
      });
      loadCodes();
    } finally {
      setBusyRevoke(null);
    }
  };

  const activeCodes = codes.filter((c) => !c.revoked && !c.used_at);

  return (
    <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
      <div className="surface-card px-4 py-3 flex items-center justify-between gap-3">
        <div className="flex items-center gap-2 min-w-0">
          <KeyRound className="w-4 h-4 text-action-success shrink-0" />
          <h2 className="text-sm font-semibold text-text-primary truncate">
            Gate Claim Codes
          </h2>
          <span className="text-xs text-text-muted hidden sm:inline">
            generate a code, hand it to the operator, they enter it at the kiosk to claim this gate
          </span>
        </div>
        <button
          type="button"
          onClick={loadCodes}
          className="surface-card p-1.5 text-text-muted hover:text-text-primary hover:bg-bg-elevated/60 flex items-center"
          title="Refresh"
        >
          <RefreshCw className="w-3.5 h-3.5" />
        </button>
      </div>

      {/* Generate */}
      <div className="p-4 space-y-3">
        <div className="flex flex-col sm:flex-row gap-3">
          <label className="flex-1 min-w-0">
            <span className="block text-xs font-semibold text-text-muted mb-1">Gate</span>
            <select
              value={selectedGateId}
              onChange={(e) => setSelectedGateId(e.target.value)}
              disabled={gates.length === 0}
              className="surface-card w-full px-3 py-2 bg-bg-surface text-sm text-text-primary focus:ring-2 focus:ring-emerald-500/40 outline-none disabled:opacity-50"
            >
              {gates.length === 0 && <option value="">No active gates</option>}
              {gates.map((g) => (
                <option key={g.id} value={g.id}>
                  {g.name} {g.gateCode || g.gate_code ? `(${g.gateCode || g.gate_code})` : ""}
                </option>
              ))}
            </select>
          </label>
          <label className="flex-1 min-w-0">
            <span className="block text-xs font-semibold text-text-muted mb-1">
              Operator name (optional, shown in the list)
            </span>
            <input
              type="text"
              value={label}
              onChange={(e) => setLabel(e.target.value)}
              placeholder="e.g. Ravi"
              className="surface-card w-full px-3 py-2 bg-bg-surface text-sm text-text-primary placeholder:text-text-muted focus:ring-2 focus:ring-emerald-500/40 outline-none"
            />
          </label>
          <div className="flex items-end">
            <button
              type="button"
              onClick={generate}
              disabled={!selectedGateId || generating}
              className="surface-card px-4 py-2 bg-action-success hover:bg-action-success disabled:opacity-40 text-white text-xs font-bold flex items-center gap-2 transition"
            >
              {generating ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <KeyRound className="w-3.5 h-3.5" />}
              Generate 6-digit code
            </button>
          </div>
        </div>

        {error && (
          <div className="surface-card p-2.5 bg-rose-500/10 text-action-danger text-xs font-medium">
            {error}
          </div>
        )}

        {freshCode && (
          <div className="surface-card p-4 bg-emerald-500/10 space-y-3">
            <div className="flex items-center gap-2 text-xs font-semibold text-action-success">
              <ShieldCheck className="w-4 h-4" />
              New 6-digit code for <span className="font-bold">{freshCode.gateName}</span> — valid until{" "}
              {formatExpiry(freshCode.expiresAt)}
            </div>
            <div className="flex flex-col sm:flex-row gap-2 sm:items-center">
              <code className="surface-card flex-1 px-3 py-3 bg-bg-elevated font-mono text-3xl tracking-[0.4em] text-action-success select-all text-center">
                {freshCode.code}
              </code>
              <button
                type="button"
                onClick={() => copyCode(freshCode.code)}
                className="surface-card px-4 py-3 bg-bg-elevated hover:bg-bg-elevated text-text-primary text-xs font-bold flex items-center justify-center gap-2 transition min-w21"
              >
                {copied ? <Check className="w-4 h-4 text-action-success" /> : <Copy className="w-4 h-4" />}
                {copied ? "Copied" : "Copy"}
              </button>
            </div>
            <p className="text-xs text-emerald-700/70">
              Give this 6-digit code to the operator. They enter it before it expires to claim the gate —
              one-time use, shown only once.
            </p>
          </div>
        )}
      </div>

      {/* Active codes list */}
      <div className="px-4 pb-4">
        <div className="flex items-center gap-2 mb-2 text-xs font-semibold text-text-muted uppercase tracking-wide">
          <ListOrdered className="w-3.5 h-3.5" />
          Active codes ({activeCodes.length})
        </div>
        {loadingCodes ? (
          <div className="p-4 flex items-center gap-2 text-xs text-text-muted">
            <Loader2 className="w-4 h-4 animate-spin" /> Loading…
          </div>
        ) : activeCodes.length === 0 ? (
          <div className="p-4 text-xs text-text-muted">
            No active claim codes. Generate one above — its plaintext is not recoverable after that.
          </div>
        ) : (
          <ul className="divide-y divide-slate-800/60">
            {activeCodes.map((c) => (
              <li key={c.id} className="py-2.5 flex items-center justify-between gap-3">
                <div className="min-w-0">
                  <div className="text-sm text-text-primary font-medium truncate">
                    {c.gate_name || c.gate_id}
                    {c.operator_name_label ? (
                      <span className="ml-2 text-xs text-text-muted">for {c.operator_name_label}</span>
                    ) : null}
                  </div>
                  <div className="text-xs text-text-muted">
                    expires {formatExpiry(c.expires_at)}
                  </div>
                </div>
                <button
                  type="button"
                  onClick={() => revoke(c.id)}
                  disabled={busyRevoke === c.id}
                  className="surface-card px-2.5 py-1.5 bg-bg-elevated hover:bg-rose-500/20 hover:text-action-danger text-text-muted text-xs font-semibold flex items-center gap-1.5 transition disabled:opacity-50"
                  title="Revoke this code"
                >
                  {busyRevoke === c.id ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Trash2 className="w-3.5 h-3.5" />}
                  Revoke
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/supervisor/PostTimetableBoard.tsx">
"use client";

import React from "react";
import {
  MapPin,
  Clock,
  UserCheck,
  AlertTriangle,
  RefreshCw,
} from "lucide-react";
import {
  resolvePostCoverageAndAlerts,
  type GuardPostAssignment,
  type LocationIncidentAlert,
} from "@/lib/security-post-dispatch";

export function PostTimetableBoard({
  assignments,
  incidents,
  onReassignPost,
}: {
  assignments: GuardPostAssignment[];
  incidents: LocationIncidentAlert[];
  onReassignPost?: (postId: string) => void;
}) {
  const posts = resolvePostCoverageAndAlerts(assignments, incidents);

  return (
    <section data-testid="supervisor-post-timetable" className="space-y-3">
      <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3.5">
        {posts.map((post) => (
          <div
            key={post.postId}
            className={`surface-card bg-bg-surface p-4 space-y-3 ${
              post.uncovered || post.openIncidents.length > 0
                ? "border-amber-500/60"
                : ""
            }`}
          >
            <div className="flex items-start justify-between gap-2">
              <div>
                <h3 className="text-sm font-bold flex items-center gap-1.5 text-text-primary">
                  <MapPin className="h-4 w-4 text-action-primary" />
                  <span>{post.postName}</span>
                </h3>
                <p className="text-xs text-text-muted mt-0.5">
                  {post.activeGuardsCount} on post • {post.dispatchedCount}{" "}
                  responding
                </p>
              </div>

              {post.uncovered ? (
                <span className="inline-flex items-center gap-1 rounded-full bg-rose-500/15 px-2.5 py-0.5 text-[11px] font-semibold text-action-danger">
                  <AlertTriangle className="h-3 w-3" /> Uncovered
                </span>
              ) : (
                <span className="inline-flex items-center gap-1 rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-[11px] font-semibold text-action-success">
                  <UserCheck className="h-3 w-3" /> Covered
                </span>
              )}
            </div>

            <div className="space-y-2">
              {post.guards.length === 0 ? (
                <p className="text-xs text-text-muted italic">
                  No guard scheduled at this post for the current window.
                </p>
              ) : (
                post.guards.map((g) => (
                  <div
                    key={g.assignmentId}
                    className="surface-card bg-bg-elevated/50 px-3 py-2 flex items-center justify-between gap-2 text-xs"
                  >
                    <div className="min-w-0">
                      <p className="font-semibold truncate text-text-primary">
                        {g.guardName}
                      </p>
                      <p className="text-[11px] text-text-muted inline-flex items-center gap-1">
                        <Clock className="h-3 w-3" /> {g.shiftLabel} •{" "}
                        {g.roleAtPost}
                      </p>
                    </div>
                    <span className="shrink-0 surface-card bg-bg-surface px-2 py-0.5 font-mono text-[10px] font-semibold text-text-primary">
                      {g.dutyStatus}
                    </span>
                  </div>
                ))
              )}
            </div>

            <div className="flex items-center justify-between gap-2 pt-2 border-t border-border text-xs">
              <span className="text-text-muted">
                {post.openIncidents.length > 0
                  ? `${post.openIncidents.length} active alert(s) here`
                  : "No open alerts"}
              </span>

              {onReassignPost && (
                <button
                  type="button"
                  onClick={() => onReassignPost(post.postId)}
                  className="surface-card inline-flex items-center gap-1 bg-bg-elevated px-2.5 py-1 font-medium text-text-primary hover:bg-bg-surface"
                >
                  <RefreshCw className="h-3 w-3" />
                  <span>Assign / Cover</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  );
}
