<file path="src/components/shared/complaints/ComplaintTimeline.tsx">
/**
 * shared/complaints/ComplaintTimeline.tsx — the complaint's lifecycle
 * (raised → acknowledged → assigned → in_progress → resolved). Reuses the
 * existing RequestTimeline shape. The "TRACK" step of the complaint loop.
 */

"use client";

import { CheckCircle2, Clock, ArrowRight } from "lucide-react";
import { cn } from "@/lib/utils";

export interface ComplaintTimelineEvent {
  status: string;
  at: string;
  note?: string;
}

export interface ComplaintTimelineProps {
  events: ComplaintTimelineEvent[];
  /** The current status (for the "now" marker). */
  currentStatus?: string;
  className?: string;
}

const STATUS_ORDER = [
  "submitted",
  "acknowledged",
  "assigned",
  "in_progress",
  "resolved",
];

export function ComplaintTimeline({
  events,
  currentStatus,
  className,
}: ComplaintTimelineProps) {
  // Build the ordered steps: which statuses have happened + timestamps.
  const happened = new Set(events.map((e) => e.status));
  const isDone = (s: string) =>
    happened.has(s) ||
    (currentStatus === "resolved" ? STATUS_ORDER.indexOf(s) <= STATUS_ORDER.indexOf("resolved") : false);

  return (
    <div className={cn("space-y-0", className)}>
      {STATUS_ORDER.map((status, i) => {
        const done = isDone(status);
        const isCurrent = status === currentStatus;
        const event = events.find((e) => e.status === status);
        const isLast = i === STATUS_ORDER.length - 1;
        return (
          <div key={status} className="relative flex gap-3">
            {/* Line */}
            {!isLast && (
              <div
                className={cn(
                  "absolute left-[11px] top-6 h-[calc(100%-0.5rem)] w-0.5",
                  done ? "bg-action-primary/40" : "bg-border",
                )}
              />
            )}
            {/* Dot */}
            <div
              className={cn(
                "relative z-10 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border text-[10px]",
                done
                  ? "border-action-primary bg-action-primary/10 text-action-primary"
                  : "border-border bg-bg text-text-muted",
                isCurrent && "ring-2 ring-action-primary/30",
              )}
            >
              {done ? <CheckCircle2 className="h-3.5 w-3.5" /> : i === 0 ? <Clock className="h-3 w-3" /> : <ArrowRight className="h-3 w-3" />}
            </div>
            {/* Label */}
            <div className="flex-1 pb-5">
              <p className={cn("text-xs font-medium capitalize", done ? "text-text" : "text-text-muted")}>
                {status.replace("_", " ")}
                {isCurrent && <span className="ml-2 text-[10px] text-action-primary">← current</span>}
              </p>
              {event?.at && (
                <p className="text-[11px] text-text-muted">
                  {new Date(event.at).toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })}
                </p>
              )}
              {event?.note && <p className="text-[11px] text-text-muted italic">"{event.note}"</p>}
            </div>
          </div>
        );
      })}
    </div>
  );
}

export default ComplaintTimeline;
</file>

<file path="src/components/shared/complaints/EscalateComplaintButton.tsx">
/**
 * shared/complaints/EscalateComplaintButton.tsx — the "ESCALATE" step.
 * When a complaint breaches SLA (or the user wants it faster), escalate
 * via the LADDER (nextActor). Shows the SLA countdown + the escalate
 * button.
 */

"use client";

import { useState } from "react";
import { ArrowUpRight, Loader2 } from "lucide-react";
import { cn } from "@/lib/utils";
import { getAuthHeaders } from "@/lib/utils";

export interface EscalateComplaintButtonProps {
  complaintId: string;
  /** The SLA deadline (ISO). When now > deadline, the complaint is breached. */
  slaDeadline?: string;
  /** Class name. */
  className?: string;
}

export function EscalateComplaintButton({
  complaintId,
  slaDeadline,
  className,
}: EscalateComplaintButtonProps) {
  const [escalating, setEscalating] = useState(false);
  const [done, setDone] = useState(false);

  const breach = slaDeadline ? Date.now() > new Date(slaDeadline).getTime() : false;

  const escalate = async () => {
    if (escalating || done) return;
    setEscalating(true);
    try {
      const res = await fetch(`/api/complaints/${complaintId}/escalate`, {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({}),
      });
      if (res.ok) setDone(true);
    } finally {
      setEscalating(false);
    }
  };

  return (
    <div className={cn("flex items-center gap-2", className)}>
      {breach && !done && (
        <span className="rounded bg-red-500/10 px-1.5 py-0.5 text-[10px] font-medium text-red-400">
          SLA breached
        </span>
      )}
      <button
        type="button"
        onClick={escalate}
        disabled={escalating || done}
        className={cn(
          "flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors disabled:opacity-50",
          breach
            ? "border-red-500/40 text-red-400 hover:bg-red-500/10"
            : "border-border text-text-secondary hover:bg-bg-elevated",
        )}
      >
        {escalating ? (
          <Loader2 className="h-3.5 w-3.5 animate-spin" />
        ) : done ? (
          "Escalated ✓"
        ) : (
          <>
            <ArrowUpRight className="h-3.5 w-3.5" />
            Escalate
          </>
        )}
      </button>
    </div>
  );
}

export default EscalateComplaintButton;
</file>

<file path="src/components/shared/complaints/ResolutionRating.tsx">
/**
 * shared/complaints/ResolutionRating.tsx — "Was this resolution helpful?"
 * star rating after a complaint/pass is resolved. Step 5 (VERIFY) of the
 * complaint loop. Also used for pass return feedback.
 */

"use client";

import { useState } from "react";
import { Star, Check } from "lucide-react";
import { cn } from "@/lib/utils";
import { getAuthHeaders } from "@/lib/utils";

export interface ResolutionRatingProps {
  /** The entity kind (drives the API endpoint). */
  kind: "complaint" | "pass";
  /** The entity id. */
  id: string;
  /** Existing rating (0–5) when already rated. */
  existing?: number | null;
  /** Label (default "Rate this resolution"). */
  label?: string;
  className?: string;
}

export function ResolutionRating({
  kind,
  id,
  existing,
  label = "Rate this resolution",
  className,
}: ResolutionRatingProps) {
  const [rating, setRating] = useState<number | null>(existing ?? null);
  const [hover, setHover] = useState(0);
  const [saving, setSaving] = useState(false);

  const endpoint =
    kind === "complaint" ? `/api/complaints/${id}/rate` : `/api/passes/${id}/feedback`;

  const submit = async (stars: number) => {
    if (saving) return;
    setSaving(true);
    try {
      await fetch(endpoint, {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ rating: stars }),
      });
      setRating(stars);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className={cn("flex items-center gap-2", className)}>
      <span className="text-xs text-text-muted">{label}</span>
      <div className="flex gap-0.5">
        {[1, 2, 3, 4, 5].map((s) => (
          <button
            key={s}
            type="button"
            onClick={() => submit(s)}
            onMouseEnter={() => setHover(s)}
            onMouseLeave={() => setHover(0)}
            disabled={saving}
            aria-label={`${s} stars`}
          >
            <Star
              className={cn(
                "h-4 w-4 transition-colors",
                (hover || rating || 0) >= s
                  ? "fill-amber-400 text-amber-400"
                  : "text-text-muted/40",
              )}
            />
          </button>
        ))}
      </div>
      {rating && (
        <span className="flex items-center gap-0.5 text-[11px] text-green-400">
          <Check className="h-3 w-3" /> {rating}/5
        </span>
      )}
    </div>
  );
}

export default ResolutionRating;
</file>

<file path="src/components/shared/documents/DocumentStatusCard.tsx">
/**
 * shared/documents/DocumentStatusCard.tsx — the document's lifecycle:
 * pending → verified / rejected (with reason) + the track timeline +
 * re-upload-with-reason. Steps 2 (STATUS) + 4 (TRACK) + 6 (ESCALATE)
 * of the document loop.
 */

"use client";

import { useState } from "react";
import { FileCheck, FileQuestion, Clock, RotateCw, GitBranch, Loader2 } from "lucide-react";
import { cn } from "@/lib/utils";
import { getAuthHeaders } from "@/lib/utils";
import { useDisputes } from "@/hooks/useDisputes";
import { DocumentTrackTimeline, type DocTimelineEvent } from "@/components/shared/documents/DocumentTrackTimeline";

export interface DocumentStatusCardProps {
  /** The permission/pass id the document belongs to. */
  ticketId: string;
  /** The ticket number (human-readable, shown in the header). */
  ticketNumber?: string;
  /** The document's current status. */
  status: "pending" | "verified" | "rejected";
  /** Rejection reason (when rejected). */
  reason?: string;
  /** The document URL (for the download / receipt link). */
  documentUrl?: string;
  /** When submitted. */
  submittedAt?: string;
  /** When verified. */
  verifiedAt?: string;
  className?: string;
}

export function DocumentStatusCard({
  ticketId,
  ticketNumber,
  status,
  reason,
  documentUrl,
  submittedAt,
  verifiedAt,
  className,
}: DocumentStatusCardProps) {
  const { create } = useDisputes();
  const [showReupload, setShowReupload] = useState(false);
  const [disputed, setDisputed] = useState(false);
  const [showTrack, setShowTrack] = useState(false);
  const [track, setTrack] = useState<DocTimelineEvent[] | null>(null);
  const [trackLoading, setTrackLoading] = useState(false);

  // The TRACK step: fetch the ticket's status-change timeline on demand.
  const loadTrack = async () => {
    if (showTrack || trackLoading) return;
    setShowTrack(true);
    setTrackLoading(true);
    try {
      const res = await fetch(
        `/api/permissions/${encodeURIComponent(ticketNumber ?? ticketId)}/track`,
        { headers: getAuthHeaders() },
      );
      if (res.ok) {
        const data = await res.json();
        setTrack(
          (data.events ?? []).map((e: Record<string, unknown>) => ({
            status: (e.action as string) ?? "submitted",
            at: (e.timestamp as string) ?? new Date().toISOString(),
            by: e.actor as string | undefined,
          })),
        );
      }
    } finally {
      setTrackLoading(false);
    }
  };

  const meta = {
    pending: { Icon: Clock, label: "Pending review", accent: "text-amber-400", bg: "bg-amber-500/10" },
    verified: { Icon: FileCheck, label: "Verified", accent: "text-green-400", bg: "bg-green-500/10" },
    rejected: { Icon: FileQuestion, label: "Rejected", accent: "text-red-400", bg: "bg-red-500/10" },
  }[status];

  const Icon = meta.Icon;

  const reupload = async () => {
    setShowReupload(false);
    // Trigger the re-upload via the existing document endpoint.
    window.location.href = `/student/passes?ticket=${ticketId}&reupload=1`;
  };

  const dispute = async () => {
    const d = await create({
      entity_type: "document",
      entity_id: ticketId,
      reason: "document_rejection_disputed",
      evidence: { rejection_reason: reason },
    });
    if (d) setDisputed(true);
  };

  return (
    <div className={cn("surface-card p-4 space-y-3", className)}>
      {/* Status banner */}
      <div className={cn("flex items-center gap-2 rounded-lg px-3 py-2", meta.bg)}>
        <Icon className={cn("h-4 w-4", meta.accent)} />
        <div>
          <p className={cn("text-xs font-medium", meta.accent)}>
            {ticketNumber ? `${ticketNumber} · ` : ""}
            {meta.label}
          </p>
          {submittedAt && (
            <p className="text-[10px] text-text-muted">
              Submitted {new Date(submittedAt).toLocaleDateString("en-IN", { day: "2-digit", month: "short" })}
            </p>
          )}
        </div>
      </div>

      {/* Rejection reason + actions */}
      {status === "rejected" && reason && (
        <div className="rounded-lg bg-bg-elevated px-3 py-2 text-xs text-text-muted">
          <p className="font-medium text-text">Why: {reason}</p>
          <div className="mt-2 flex gap-2">
            <button
              type="button"
              onClick={reupload}
              className={cn(
                "flex items-center gap-1 rounded-lg border border-border px-2.5 py-1 text-[11px] text-text-secondary hover:bg-bg",
                showReupload && "border-action-primary text-action-primary",
              )}
            >
              <RotateCw className="h-3 w-3" />
              Re-upload
            </button>
            <button
              type="button"
              onClick={dispute}
              disabled={disputed}
              className="rounded-lg border border-border px-2.5 py-1 text-[11px] text-text-secondary hover:bg-bg disabled:opacity-50"
            >
              {disputed ? "Disputed ✓" : "I disagree"}
            </button>
          </div>
        </div>
      )}

      {/* Verified: receipt */}
      {status === "verified" && verifiedAt && (
        <p className="text-[11px] text-text-muted">
          Verified {new Date(verifiedAt).toLocaleDateString("en-IN", { day: "2-digit", month: "short" })}
        </p>
      )}

      {/* Document link */}
      {documentUrl && (
        <a
          href={documentUrl}
          target="_blank"
          rel="noreferrer"
          className="text-[11px] text-action-primary/80 underline hover:text-action-primary"
        >
          View document
        </a>
      )}

      {/* The TRACK step: expandable status-change timeline */}
      <button
        type="button"
        onClick={loadTrack}
        className="flex items-center gap-1 text-[11px] text-text-muted underline hover:text-text"
      >
        {trackLoading ? <Loader2 className="h-3 w-3 animate-spin" /> : <GitBranch className="h-3 w-3" />}
        {showTrack ? "Hide timeline" : "Status timeline"}
      </button>
      {showTrack && track && track.length > 0 && (
        <DocumentTrackTimeline events={track} className="pt-2" />
      )}
      {showTrack && track && track.length === 0 && (
        <p className="text-[11px] text-text-muted">No status changes recorded yet.</p>
      )}
    </div>
  );
}

export default DocumentStatusCard;
</file>

<file path="src/components/shared/documents/DocumentTrackTimeline.tsx">
/**
 * shared/documents/DocumentTrackTimeline.tsx — the document's "TRACK"
 * step: submitted → (verified | rejected). Shows the timeline of status
 * changes for a single document, from the /api/permissions/[ticket]/document
 * shape. Reuses the timeline visual style from ComplaintTimeline.
 */

"use client";

import { CheckCircle2, XCircle, Clock, FileQuestion } from "lucide-react";
import { cn } from "@/lib/utils";

export interface DocTimelineEvent {
  /** The action/stage label — free-form from the permission workflow
      (e.g. "submitted", "approved", "forwarded", "escalated"). */
  status: string;
  at: string;
  by?: string;
}

export interface DocumentTrackTimelineProps {
  events: DocTimelineEvent[];
  /** Class name. */
  className?: string;
}

const KNOWN_ICONS: Record<string, React.ComponentType<{ className?: string }>> = {
  submitted: Clock,
  reviewed: FileQuestion,
  verified: CheckCircle2,
  rejected: XCircle,
};

const KNOWN_ACCENT: Record<string, string> = {
  submitted: "text-text-muted",
  reviewed: "text-blue-400",
  verified: "text-green-400",
  rejected: "text-red-400",
};

function iconFor(status: string): React.ComponentType<{ className?: string }> {
  return KNOWN_ICONS[status] ?? Clock;
}
function accentFor(status: string): string {
  return KNOWN_ACCENT[status] ?? "text-text-muted";
}

export function DocumentTrackTimeline({ events, className }: DocumentTrackTimelineProps) {
  if (events.length === 0) {
    return (
      <p className={cn("text-xs text-text-muted", className)}>No status changes recorded yet.</p>
    );
  }

  return (
    <div className={cn("space-y-0", className)}>
      {events.map((ev, i) => {
        const Icon = iconFor(ev.status);
        const isLast = i === events.length - 1;
        return (
          <div key={`${ev.status}-${i}`} className="relative flex gap-3">
            {!isLast && (
              <div className="absolute left-[11px] top-6 h-[calc(100%-0.5rem)] w-0.5 bg-border" />
            )}
            <div
              className={cn(
                "relative z-10 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border bg-bg",
                accentFor(ev.status),
              )}
            >
              <Icon className="h-3.5 w-3.5" />
            </div>
            <div className="flex-1 pb-5">
              <p className={cn("text-xs font-medium capitalize", accentFor(ev.status))}>
                {ev.status}
                {ev.by ? <span className="ml-1.5 text-[10px] text-text-muted">by {ev.by}</span> : null}
              </p>
              <p className="text-[11px] text-text-muted">
                {new Date(ev.at).toLocaleString("en-IN", {
                  day: "2-digit",
                  month: "short",
                  hour: "2-digit",
                  minute: "2-digit",
                })}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  );
}

export default DocumentTrackTimeline;
</file>

<file path="src/components/shared/documents/MyDocuments.tsx">
/**
 * shared/documents/MyDocuments.tsx — the student's document loop: which
 * passes need a document, each doc's verified/pending/rejected status,
 * the track timeline, and re-upload-with-reason. Steps 2 (STATUS) +
 * 4 (TRACK) + 6 (ESCALATE). Reuses DocumentStatusCard per ticket.
 */

"use client";

import { useEffect, useState } from "react";
import { Loader2, FileText } from "lucide-react";
import { cn, getAuthHeaders } from "@/lib/utils";
import { DocumentStatusCard } from "@/components/shared/documents/DocumentStatusCard";

export interface DocRow {
  ticketId: string;
  ticketNumber: string;
  status: "pending" | "verified" | "rejected";
  documentUrl?: string;
  submittedAt?: string;
  verifiedAt?: string;
  reason?: string;
  /** The pass type / why a doc is needed. */
  passType?: string;
}

export interface MyDocumentsProps {
  /** Class name. */
  className?: string;
}

/** Map the permissions status → doc status. */
function toDocStatus(s: string | null | undefined): DocRow["status"] {
  const u = (s ?? "").toUpperCase();
  if (u === "REJECTED" || u === "DOC_REJECTED") return "rejected";
  if (u === "APPROVED" || u === "VERIFIED" || u === "ACTIVE" || u === "RETURNED" || u === "COMPLETED")
    return "verified";
  return "pending";
}

export function MyDocuments({ className }: MyDocumentsProps) {
  const [rows, setRows] = useState<DocRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = async () => {
    try {
      const res = await fetch("/api/permissions?scope=mine", { headers: getAuthHeaders() });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const list: any[] = data.items ?? data.data ?? (Array.isArray(data) ? data : []);
      setRows(
        list
          .filter((p) => p.documentUrl || p.document_url)
          .map((p) => ({
            ticketId: p.id,
            ticketNumber: p.ticketNumber ?? p.ticket_number ?? p.id,
            status: toDocStatus(p.status ?? p.finalStatus),
            documentUrl: p.documentUrl ?? p.document_url,
            submittedAt: p.requestedAt ?? p.requested_at ?? p.createdAt,
            verifiedAt: p.updatedAt ?? p.verifiedAt,
            passType: p.reason ?? p.workflowType,
          })),
      );
      setError(null);
    } catch (e) {
      setError((e as Error).message);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    load();
  }, []);

  if (loading) {
    return (
      <div className={cn("flex items-center gap-2 py-4 text-xs text-text-muted", className)}>
        <Loader2 className="h-4 w-4 animate-spin" />
        Loading documents…
      </div>
    );
  }

  return (
    <div className={cn("space-y-3", className)}>
      {error && <p className="text-xs text-text-muted">Could not load documents ({error}).</p>}
      {rows.length === 0 && !error && (
        <div className="flex items-center gap-2 py-4 text-xs text-text-muted">
          <FileText className="h-4 w-4" />
          No documents uploaded. When a pass needs proof (medical, ID), it shows here with its
          verification status.
        </div>
      )}
      {rows.map((row) => (
        <DocumentStatusCard
          key={row.ticketId}
          ticketId={row.ticketId}
          ticketNumber={row.ticketNumber}
          status={row.status}
          documentUrl={row.documentUrl}
          submittedAt={row.submittedAt}
          verifiedAt={row.verifiedAt}
          reason={row.reason}
        />
      ))}
    </div>
  );
}

export default MyDocuments;
</file>

<file path="src/components/shared/events/EventDisputeForm.tsx">
/**
 * shared/events/EventDisputeForm.tsx — "I was there" dispute for events.
 * Step 7 of the event loop: the user attended but wasn't marked. Uploads
 * proof (selfie, photo, friend confirm) and routes to the organizer via
 * the universal dispute API.
 */

"use client";

import { useState } from "react";
import { Send, Upload, X } from "lucide-react";
import { cn } from "@/lib/utils";
import { useDisputes } from "@/hooks/useDisputes";

export interface EventDisputeFormProps {
  eventId: string;
  /** Called after the dispute is created. */
  onSubmitted?: () => void;
  className?: string;
}

export function EventDisputeForm({ eventId, onSubmitted, className }: EventDisputeFormProps) {
  const { create } = useDisputes();
  const [reason, setReason] = useState("I attended but was not marked present.");
  const [proofType, setProofType] = useState<"selfie" | "photo" | "friend">("selfie");
  const [proofNote, setProofNote] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [submitted, setSubmitted] = useState(false);

  const submit = async () => {
    if (submitting || !reason.trim()) return;
    setSubmitting(true);
    const dispute = await create({
      entity_type: "event",
      entity_id: eventId,
      reason: reason.trim(),
      evidence: { proof_type: proofType, proof_note: proofNote.trim() || undefined },
    });
    setSubmitting(false);
    if (dispute) {
      setSubmitted(true);
      onSubmitted?.();
    }
  };

  if (submitted) {
    return (
      <div className={cn("rounded-lg bg-green-500/10 px-4 py-3 text-xs text-green-400", className)}>
        ✓ Dispute submitted. The organizer will review within 48h. Track it in
        <a href="/student/profile" className="underline"> My Disputes</a>.
      </div>
    );
  }

  return (
    <div className={cn("space-y-3", className)}>
      <p className="text-xs font-semibold text-text-muted">I was there — dispute</p>

      {/* Proof type */}
      <div className="flex gap-1.5">
        {(["selfie", "photo", "friend"] as const).map((t) => (
          <button
            key={t}
            type="button"
            onClick={() => setProofType(t)}
            className={cn(
              "rounded-full border px-2.5 py-1 text-[10px] capitalize transition-colors",
              proofType === t
                ? "border-action-primary bg-action-primary/10 text-action-primary"
                : "border-border text-text-muted",
            )}
          >
            {t === "selfie" ? "Selfie" : t === "photo" ? "Photo" : "Friend confirm"}
          </button>
        ))}
      </div>

      {/* Reason */}
      <textarea
        value={reason}
        onChange={(e) => setReason(e.target.value)}
        rows={2}
        placeholder="What happened? (e.g. I was at the venue but not scanned)"
        className="w-full rounded-lg border border-border bg-bg px-3 py-2 text-xs text-text placeholder:text-text-muted/50"
      />

      {/* Proof note */}
      <input
        value={proofNote}
        onChange={(e) => setProofNote(e.target.value)}
        placeholder="Optional: who was with you / where exactly"
        className="w-full rounded-lg border border-border bg-bg px-3 py-2 text-xs text-text placeholder:text-text-muted/50"
      />

      <button
        type="button"
        onClick={submit}
        disabled={submitting || !reason.trim()}
        className="flex items-center gap-2 rounded-lg bg-action-primary px-4 py-2 text-xs font-medium text-bg hover:bg-action-primary/90 disabled:opacity-50"
      >
        <Send className="h-3.5 w-3.5" />
        {submitting ? "Submitting…" : "Submit dispute"}
      </button>
    </div>
  );
}

export default EventDisputeForm;
</file>

<file path="src/components/shared/events/EventFeedbackSheet.tsx">
/**
 * shared/events/EventFeedbackSheet.tsx — the VERIFY step of the event
 * loop: rate an attended event (1-5) + tag chips + note. POSTs to
 * /api/campus/events/[id]/feedback. Shows the existing rating when set.
 */

"use client";

import { useEffect, useState } from "react";
import { Star, X, Loader2, Check } from "lucide-react";
import { cn, getAuthHeaders } from "@/lib/utils";

export interface EventFeedbackSheetProps {
  event: { id: string; title: string; attendedAt?: string } | null;
  onClose: () => void;
  className?: string;
}

const TAGS = ["Great", "Learned a lot", "Organized", "Crowded", "Long wait", "Good food", "Inspiring", "Could improve"];

export function EventFeedbackSheet({ event, onClose, className }: EventFeedbackSheetProps) {
  const [rating, setRating] = useState(0);
  const [tags, setTags] = useState<string[]>([]);
  const [note, setNote] = useState("");
  const [existing, setExisting] = useState<number | null>(null);
  const [saving, setSaving] = useState(false);
  const [done, setDone] = useState(false);

  useEffect(() => {
    setRating(0);
    setTags([]);
    setNote("");
    setDone(false);
  }, [event?.id]);

  if (!event) return null;

  const toggleTag = (t: string) =>
    setTags((prev) => (prev.includes(t) ? prev.filter((x) => x !== t) : prev.length < 4 ? [...prev, t] : prev));

  const submit = async () => {
    if (rating < 1 || saving) return;
    setSaving(true);
    try {
      await fetch(`/api/campus/events/${event.id}/feedback`, {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ rating, tags, note: note || undefined }),
      });
      setDone(true);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className={cn("fixed inset-0 z-50 flex items-end bg-black/40 sm:items-center", className)}>
      <div className="w-full rounded-t-xl bg-bg-elevated p-4 sm:max-w-md sm:rounded-xl">
        <div className="flex items-start justify-between gap-2">
          <div>
            <p className="text-xs text-text-muted">Event feedback</p>
            <h3 className="text-base font-semibold text-text-primary">{event.title}</h3>
          </div>
          <button type="button" onClick={onClose} className="rounded p-1 text-text-muted hover:bg-bg" aria-label="Close">
            <X className="h-4 w-4" />
          </button>
        </div>

        {done ? (
          <div className="flex items-center gap-2 py-6 text-sm text-green-400">
            <Check className="h-4 w-4" /> Thanks — your rating is in. It feeds your achievements + the organizer's view.
          </div>
        ) : (
          <>
            {/* Rating */}
            <div className="mt-4">
              <p className="text-[10px] uppercase tracking-wide text-text-muted">How was it?</p>
              <div className="mt-1 flex gap-1">
                {[1, 2, 3, 4, 5].map((s) => (
                  <button key={s} type="button" onClick={() => setRating(s)} aria-label={`${s} stars`}>
                    <Star
                      className={cn("h-6 w-6", rating >= s ? "fill-amber-400 text-amber-400" : "text-text-muted/40")}
                    />
                  </button>
                ))}
              </div>
            </div>

            {/* Tags */}
            <div className="mt-4">
              <p className="text-[10px] uppercase tracking-wide text-text-muted">Tags (optional, max 4)</p>
              <div className="mt-1.5 flex flex-wrap gap-1.5">
                {TAGS.map((t) => (
                  <button
                    key={t}
                    type="button"
                    onClick={() => toggleTag(t)}
                    className={cn(
                      "rounded-full border px-2.5 py-1 text-[11px] transition-colors",
                      tags.includes(t)
                        ? "border-action-primary/40 bg-action-primary/10 text-action-primary"
                        : "border-border text-text-muted hover:bg-bg",
                    )}
                  >
                    {t}
                  </button>
                ))}
              </div>
            </div>

            {/* Note */}
            <textarea
              value={note}
              onChange={(e) => setNote(e.target.value)}
              maxLength={500}
              rows={2}
              placeholder="Anything to add? (optional)"
              className="mt-3 w-full rounded-lg border border-border bg-bg p-2 text-xs text-text placeholder:text-text-muted/50 focus:outline-none focus:ring-1 focus:ring-action-primary"
            />

            <button
              type="button"
              onClick={submit}
              disabled={rating < 1 || saving}
              className="mt-3 flex w-full items-center justify-center gap-1.5 rounded-lg bg-action-primary px-4 py-2 text-sm font-medium text-white hover:bg-action-primary/90 disabled:opacity-50"
            >
              {saving ? <Loader2 className="h-4 w-4 animate-spin" /> : "Submit feedback"}
            </button>
          </>
        )}
      </div>
    </div>
  );
}

export default EventFeedbackSheet;
</file>

<file path="src/components/shared/events/EventRsvpBar.tsx">
/**
 * shared/events/EventRsvpBar.tsx — the RSVP action bar for an event.
 * [Going] [Interested] [Not going] [Waitlist] → POST /api/campus/events/:id/register
 * Shows the user's current status (from event_registrations) and lets them
 * switch. This is step 2 (CONFIRM) of the event loop.
 */

"use client";

import { useState } from "react";
import { Check, X, Clock, UserPlus } from "lucide-react";
import { cn } from "@/lib/utils";
import { getAuthHeaders } from "@/lib/utils";

type RsvpStatus = "going" | "interested" | "not_going" | "waitlist" | "cancelled";

const OPTIONS: { id: RsvpStatus; label: string; Icon: React.ComponentType<{ className?: string }> }[] = [
  { id: "going", label: "Going", Icon: Check },
  { id: "interested", label: "Interested", Icon: Clock },
  { id: "waitlist", label: "Waitlist", Icon: UserPlus },
  { id: "not_going", label: "Not going", Icon: X },
];

export interface EventRsvpBarProps {
  eventId: string;
  /** The user's RSVP status (from the registrations query). */
  currentStatus?: RsvpStatus | null;
  /** Called after a successful RSVP change. */
  onChanged?: (status: RsvpStatus) => void;
  className?: string;
}

export function EventRsvpBar({ eventId, currentStatus, onChanged, className }: EventRsvpBarProps) {
  const [pending, setPending] = useState<RsvpStatus | null>(null);

  const rsvp = async (status: RsvpStatus) => {
    if (pending) return;
    setPending(status);
    try {
      const res = await fetch(`/api/campus/events/${eventId}/register`, {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ status: status === "not_going" ? "cancelled" : status }),
      });
      if (res.ok) onChanged?.(status);
    } finally {
      setPending(null);
    }
  };

  return (
    <div className={cn("flex flex-wrap gap-1.5", className)}>
      {OPTIONS.map(({ id, label, Icon }) => {
        const active = currentStatus === id;
        return (
          <button
            key={id}
            type="button"
            onClick={() => rsvp(id)}
            disabled={pending !== null}
            className={cn(
              "flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors disabled:opacity-50",
              active
                ? "border-action-primary bg-action-primary/10 text-action-primary"
                : "border-border text-text-secondary hover:border-text-muted",
            )}
          >
            {pending === id ? (
              <Clock className="h-3.5 w-3.5 animate-spin" />
            ) : (
              <Icon className={cn("h-3.5 w-3.5", active && "text-action-primary")} />
            )}
            {label}
          </button>
        );
      })}
    </div>
  );
}

export default EventRsvpBar;
</file>

<file path="src/components/shared/events/MyEventsPage.tsx">
/**
 * shared/events/MyEventsPage.tsx — the student's "My Events" page.
 * The full event loop: discover → confirm (RSVP) → check-in → track →
 * feedback → dispute. Shows upcoming + past events with the user's RSVP
 * status, live check-in, and the dispute form for unmarked attendance.
 */

"use client";

import { useEffect, useMemo, useState } from "react";
import { Loader2 } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { EventRsvpBar } from "@/components/shared/events/EventRsvpBar";
import { MyEventStatusCard } from "@/components/shared/events/MyEventStatusCard";
import { EventDisputeForm } from "@/components/shared/events/EventDisputeForm";

interface MyEvent {
  id: string;
  title: string;
  location?: string;
  starts_at: string;
  ends_at?: string;
  category?: string;
}

interface MyEventRow {
  event: MyEvent;
  rsvp: "going" | "interested" | "waitlist" | "cancelled" | null;
  checkedIn: boolean;
}

export function MyEventsPage() {
  const [rows, setRows] = useState<MyEventRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [tab, setTab] = useState<"upcoming" | "past">("upcoming");
  const [disputeFor, setDisputeFor] = useState<string | null>(null);

  const fetchEvents = async () => {
    try {
      const eventsRes = await fetch("/api/campus/events?limit=30", { headers: getAuthHeaders() });
      const eventsData = eventsRes.ok ? await eventsRes.json() : { events: [] };
      const events: MyEvent[] = eventsData.events ?? [];

      const regRes = await fetch(`/api/campus/events/me/registrations`, {
        headers: getAuthHeaders(),
      });
      const regData = regRes.ok ? await regRes.json() : { registrations: [] };
      const regMap = new Map<string, { rsvp: "going" | "interested" | "waitlist" | "cancelled" | null; checkedIn: boolean }>(
        (regData.registrations ?? []).map((r: { event_id: string; status: string; attended: boolean }) => [
          r.event_id,
          { rsvp: r.status === "cancelled" ? "cancelled" : r.status, checkedIn: r.attended },
        ]),
      );

      const now = Date.now();
      setRows(
        events.map((event) => {
          const reg = regMap.get(event.id);
          return {
            event,
            rsvp: reg?.rsvp ?? null,
            checkedIn: reg?.checkedIn ?? false,
          };
        }),
      );
    } catch {
      setRows([]);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchEvents();
  }, []);

  const filtered = useMemo(() => {
    const now = Date.now();
    return rows.filter((r) => {
      const isPast = new Date(r.event.starts_at).getTime() < now - 3600_000;
      return tab === "past" ? isPast : !isPast;
    });
  }, [rows, tab]);

  if (loading) {
    return (
      <div className="flex items-center justify-center py-12 text-xs text-text-muted">
        <Loader2 className="mr-2 h-4 w-4 animate-spin" />
        Loading your events…
      </div>
    );
  }

  return (
    <div className="space-y-4">
      {/* Tabs */}
      <div className="flex gap-1 rounded-lg bg-bg-elevated p-1">
        {(["upcoming", "past"] as const).map((t) => (
          <button
            key={t}
            type="button"
            onClick={() => setTab(t)}
            className={`flex-1 rounded-md px-3 py-1.5 text-xs font-medium capitalize transition-colors ${
              tab === t ? "bg-bg text-text" : "text-text-muted hover:text-text"
            }`}
          >
            {t}
          </button>
        ))}
      </div>

      {/* Event rows */}
      {filtered.length === 0 && (
        <p className="py-8 text-center text-xs text-text-muted">No {tab} events.</p>
      )}

      <div className="space-y-3">
        {filtered.map((row) => (
          <div key={row.event.id} className="surface-card p-4 space-y-3">
            <MyEventStatusCard
              event={row.event}
              rsvp={row.rsvp}
              checkedIn={row.checkedIn}
              isOver={tab === "past"}
            />
            <EventRsvpBar
              eventId={row.event.id}
              currentStatus={row.rsvp}
              onChanged={() => fetchEvents()}
            />
            {/* Dispute: only for past events the user attended but weren't marked */}
            {tab === "past" && row.rsvp === "going" && !row.checkedIn && (
              <div>
                {disputeFor === row.event.id ? (
                  <EventDisputeForm eventId={row.event.id} onSubmitted={() => setDisputeFor(null)} />
                ) : (
                  <button
                    type="button"
                    onClick={() => setDisputeFor(row.event.id)}
                    className="text-xs text-text-muted underline hover:text-text"
                  >
                    I was there but wasn't marked — dispute
                  </button>
                )}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  );
}

export default MyEventsPage;
</file>

<file path="src/components/shared/events/MyEventStatusCard.tsx">
/**
 * shared/events/MyEventStatusCard.tsx — "You're going · Gate 2 · 2h left"
 * The live status card for an event the user has RSVP'd to. Shows:
 *   - their RSVP status + check-in state
 *   - the event window (start/end + time remaining)
 *   - a check-in button (step 4 of the event loop)
 *   - a feedback link (step 6)
 */

"use client";

import { Clock, MapPin, Star, QrCode } from "lucide-react";
import { cn } from "@/lib/utils";
import { getAuthHeaders } from "@/lib/utils";
import { useState } from "react";
import { EventFeedbackSheet } from "@/components/shared/events/EventFeedbackSheet";

export interface MyEventStatusCardProps {
  event: {
    id: string;
    title: string;
    location?: string;
    starts_at: string;
    ends_at?: string;
  };
  /** The user's RSVP status. */
  rsvp: "going" | "interested" | "waitlist" | "cancelled" | null;
  /** Whether the user has checked in. */
  checkedIn?: boolean;
  /** Whether the event is over (for the feedback CTA). */
  isOver?: boolean;
  className?: string;
}

export function MyEventStatusCard({
  event,
  rsvp,
  checkedIn,
  isOver,
  className,
}: MyEventStatusCardProps) {
  const [checkingIn, setCheckingIn] = useState(false);
  const [showFeedback, setShowFeedback] = useState(false);

  const now = Date.now();
  const start = new Date(event.starts_at).getTime();
  const end = event.ends_at ? new Date(event.ends_at).getTime() : start + 3600_000;
  const minutesLeft = Math.max(0, Math.floor((end - now) / 60_000));
  const h = Math.floor(minutesLeft / 60);
  const m = minutesLeft % 60;

  const checkIn = async () => {
    if (checkingIn) return;
    setCheckingIn(true);
    try {
      await fetch(`/api/campus/events/${event.id}/attend`, {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ self: true }),
      });
    } finally {
      setCheckingIn(false);
    }
  };

  const statusLabel =
    rsvp === "going" ? "You're going" :
    rsvp === "interested" ? "Interested" :
    rsvp === "waitlist" ? "On waitlist" :
    rsvp === "cancelled" ? "Not going" : "No RSVP";

  return (
    <div className={cn("surface-card p-4 space-y-3", className)}>
      {/* Title + status */}
      <div className="flex items-start justify-between gap-2">
        <div>
          <p className="text-sm font-semibold text-text">{event.title}</p>
          <p className="text-xs text-text-muted">{statusLabel}</p>
        </div>
        <span
          className={cn(
            "rounded-full px-2 py-0.5 text-[10px] font-medium",
            rsvp === "going" && "bg-green-500/10 text-green-400",
            rsvp === "interested" && "bg-blue-500/10 text-blue-400",
            rsvp === "waitlist" && "bg-amber-500/10 text-amber-400",
            (rsvp === "cancelled" || !rsvp) && "bg-bg-elevated text-text-muted",
          )}
        >
          {rsvp ?? "—"}
        </span>
      </div>

      {/* Meta: location + time */}
      <div className="flex flex-wrap gap-x-4 gap-y-1 text-xs text-text-muted">
        {event.location && (
          <span className="flex items-center gap-1">
            <MapPin className="h-3.5 w-3.5" />
            {event.location}
          </span>
        )}
        {!isOver && rsvp === "going" && (
          <span className="flex items-center gap-1">
            <Clock className="h-3.5 w-3.5" />
            {h > 0 ? `${h}h ${m}m left` : `${m}m left`}
          </span>
        )}
      </div>

      {/* Actions */}
      {rsvp === "going" && !checkedIn && !isOver && (
        <button
          type="button"
          onClick={checkIn}
          disabled={checkingIn}
          className="flex items-center gap-2 rounded-lg bg-action-primary px-4 py-2 text-xs font-medium text-bg hover:bg-action-primary/90 disabled:opacity-50"
        >
          <QrCode className="h-4 w-4" />
          {checkingIn ? "Checking in…" : "Check in now"}
        </button>
      )}

      {checkedIn && !isOver && (
        <p className="text-xs text-green-400">✓ Checked in · event in progress</p>
      )}

      {isOver && (
        <button
          type="button"
          onClick={() => setShowFeedback(true)}
          className="flex items-center gap-1.5 text-xs text-text-secondary hover:text-text"
        >
          <Star className="h-3.5 w-3.5" />
          {showFeedback ? "Rating saved" : "Leave feedback"}
        </button>
      )}
      <EventFeedbackSheet
        event={
          isOver
            ? { id: event.id, title: event.title, attendedAt: event.ends_at }
            : null
        }
        onClose={() => setShowFeedback(false)}
      />
    </div>
  );
}

export default MyEventStatusCard;
</file>

