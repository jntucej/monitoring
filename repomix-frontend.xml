<file path="src/components/sysadmin/PromotionRequests.tsx">
"use client";
import { errMsg } from "@/lib/err-msg";

import { useState, useEffect, useCallback } from "react";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { UserCheck, CheckCircle, XCircle, Plus, RefreshCw, Send } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";

interface RoleRequest {
  id: string;
  requesterId: string;
  requesterName: string;
  requesterRole: string;
  targetUserId: string;
  targetUserName: string;
  targetCurrentRole: string;
  newRole: string;
  status: "PENDING" | "APPROVED" | "REJECTED";
  reason: string;
  approverName?: string;
  createdAt: string;
}

export function PromotionRequests() {
  const { user } = useAuthStore();
  const { addToast } = useUIStore();

  const [requests, setRequests] = useState<RoleRequest[]>([]);
  const [loading, setLoading] = useState(true);
  const [filterStatus, setFilterStatus] = useState<string>("ALL");

  // New Request Modal
  const [showModal, setShowModal] = useState(false);
  const [targetUserId, setTargetUserId] = useState("");
  const [targetUser, setTargetUser] = useState<{ id: string; name: string; role: string; uniqueId?: string } | null>(null);
  const [userQuery, setUserQuery] = useState("");
  const [userResults, setUserResults] = useState<Array<{ id: string; name: string; role: string; uniqueId?: string }>>([]);
  const [newRole, setNewRole] = useState("admin");
  const [reason, setReason] = useState("");
  const [submitting, setSubmitting] = useState(false);

  // Name/roll/email search — replaces the raw UUID entry box.
  const searchUsers = useCallback(async (q: string) => {
    setUserQuery(q);
    if (q.trim().length < 2) { setUserResults([]); return; }
    try {
      const res = await fetch(`/api/users?q=${encodeURIComponent(q.trim())}`, { headers: getAuthHeaders(), cache: "no-store" });
      const json = await res.json();
      setUserResults(Array.isArray(json?.data) ? json.data.slice(0, 8) : []);
    } catch { setUserResults([]); }
  }, []);

  const fetchRequests = useCallback(async () => {
    setLoading(true);
    try {
      const headers = getAuthHeaders();
      const url = filterStatus !== "ALL"
        ? `/api/admin/role-requests?status=${filterStatus}`
        : "/api/admin/role-requests";

      const res = await fetch(url, { headers });
      const data = await res.json();
      if (res.ok && data.success) {
        setRequests(data.data || []);
      }
    } catch {
      // Best effort fetch
    } finally {
      setLoading(false);
    }
  }, [filterStatus]);

  useEffect(() => {
    fetchRequests();
  }, [fetchRequests]);

  const handleAction = async (requestId: string, status: "APPROVED" | "REJECTED") => {
    try {
      const headers = {
        ...getAuthHeaders(),
        "Content-Type": "application/json",
      };
      const res = await fetch(`/api/admin/role-requests/${requestId}`, {
        method: "PATCH",
        headers,
        body: JSON.stringify({ status }),
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error?.message || `Failed to ${status.toLowerCase()} request`);
      }

      addToast({
        title: "Success",
        message: `Role request ${status.toLowerCase()} successfully`,
        variant: "success",
      });
      fetchRequests();
    } catch (err) {
      addToast({ title: "Error", message: errMsg(err), variant: "error" });
    }
  };

  const handleCreateRequest = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!targetUserId) return;
    setSubmitting(true);

    try {
      const headers = {
        ...getAuthHeaders(),
        "Content-Type": "application/json",
      };
      const res = await fetch("/api/admin/role-requests", {
        method: "POST",
        headers,
        body: JSON.stringify({ targetUserId, newRole, reason }),
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error?.message || "Failed to submit promotion request");
      }

      addToast({ title: "Submitted", message: "Promotion request submitted for approval", variant: "success" });
      setShowModal(false);
      setTargetUserId("");
      setTargetUser(null);
      setUserQuery("");
      setReason("");
      fetchRequests();
    } catch (err) {
      addToast({ title: "Submission Failed", message: errMsg(err), variant: "error" });
    } finally {
      setSubmitting(false);
    }
  };

  const getStatusBadge = (status: string) => {
    switch (status) {
      case "APPROVED":
        return <span className="surface-card px-2.5 py-0.5 text-xs font-bold bg-emerald-500/20 text-action-success">APPROVED</span>;
      case "REJECTED":
        return <span className="surface-card px-2.5 py-0.5 text-xs font-bold bg-rose-500/20 text-action-danger">REJECTED</span>;
      default:
        return <span className="surface-card px-2.5 py-0.5 text-xs font-bold bg-amber-500/20 text-action-warning">PENDING</span>;
    }
  };

  return (
    <div className="space-y-6">
      {/* Header Bar */}
      <div className="surface-card flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-bg-surface p-6">
        <div>
          <h2 className="text-xl font-bold text-white flex items-center gap-2">
            <UserCheck className="w-6 h-6 text-action-info" /> Role Promotion Workflow
          </h2>
          <p className="text-xs text-text-muted mt-1">
            Governed process for requesting and approving administrative role elevation
          </p>
        </div>
        <div className="flex items-center gap-3">
          <button
            onClick={() => setShowModal(true)}
            className="surface-card inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-action-info text-white text-xs font-bold transition-all"
          >
            <Plus className="w-4 h-4" /> Request Promotion
          </button>
          <button
            onClick={fetchRequests}
            disabled={loading}
            className="surface-card p-2 bg-bg-elevated text-white hover:bg-bg-elevated transition-all"
          >
            <RefreshCw className={`w-4 h-4 ${loading ? "animate-spin" : ""}`} />
          </button>
        </div>
      </div>

      {/* Filter Tabs */}
      <div className="surface-card flex items-center gap-2 pb-2 text-xs font-bold">
        {["ALL", "PENDING", "APPROVED", "REJECTED"].map((st) => (
          <button
            key={st}
            onClick={() => setFilterStatus(st)}
            className={`px-3 py-1.5 rounded-lg transition-all ${
              filterStatus === st
                ? "bg-sky-500/20 text-action-info border border-sky-500/30"
                : "text-text-muted hover:text-white"
            }`}
          >
            {st}
          </button>
        ))}
      </div>

      {/* Table List */}
      <div className="bg-bg-surface border border-border rounded-2xl overflow-hidden">
        {loading ? (
          <div className="py-12 text-center text-xs text-text-muted">Loading role elevation requests...</div>
        ) : requests.length === 0 ? (
          <div className="py-12 text-center text-xs text-text-muted">No role promotion requests found.</div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs min-w-[650px]">
              <thead>
                <tr className="border-b border-border text-text-muted bg-bg-elevated/40">
                  <th className="p-4">Target User</th>
                  <th className="p-4">Requested Role</th>
                  <th className="p-4">Requester</th>
                  <th className="p-4">Reason</th>
                  <th className="p-4">Status</th>
                  <th className="p-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {requests.map((req) => (
                  <tr key={req.id} className="hover:bg-bg-elevated/30 transition-colors">
                    <td className="p-4 font-bold text-white">
                      {req.targetUserName}
                      <span className="block text-xs font-mono text-text-muted">Current: {req.targetCurrentRole}</span>
                    </td>
                    <td className="p-4">
                      <span className="surface-card px-2 py-0.5 text-xs font-mono font-bold bg-purple-500/20 text-purple-300 uppercase">
                        {req.newRole}
                      </span>
                    </td>
                    <td className="p-4 text-white">
                      {req.requesterName}
                      <span className="block text-xs font-mono text-text-muted">{req.requesterRole}</span>
                    </td>
                    <td className="p-4 text-text-muted max-w-xs truncate">{req.reason}</td>
                    <td className="p-4">{getStatusBadge(req.status)}</td>
                    <td className="p-4 text-right">
                      {req.status === "PENDING" && (user?.role === "sysadmin" || user?.role === "admin") ? (
                        <div className="flex items-center justify-end gap-2">
                          <button
                            onClick={() => handleAction(req.id, "APPROVED")}
                            className="surface-card inline-flex items-center gap-1 px-3 py-1 bg-action-success hover:bg-action-success text-white font-bold text-xs"
                          >
                            <CheckCircle className="size-3.5" /> Approve
                          </button>
                          <button
                            onClick={() => handleAction(req.id, "REJECTED")}
                            className="surface-card inline-flex items-center gap-1 px-3 py-1 bg-action-danger hover:bg-action-danger text-white font-bold text-xs"
                          >
                            <XCircle className="size-3.5" /> Reject
                          </button>
                        </div>
                      ) : (
                        <span className="text-xs text-text-muted font-mono">
                          {req.approverName ? `By ${req.approverName}` : "—"}
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
      {/* New Promotion Modal */}
      {showModal && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <form onSubmit={handleCreateRequest} className="surface-card bg-bg-surface p-6 space-y-4 max-w-md w-full">
            <h3 className="text-sm font-bold text-white flex items-center gap-2">
              <UserCheck className="w-4 h-4 text-action-info" /> Request Role Promotion
            </h3>
            <div className="space-y-3 text-xs">
              <div className="space-y-1">
                <label className="text-text-muted font-medium" htmlFor="find-person-search-by-name-roll-or-email">Find person (search by name, roll or email)</label>
                <input id="find-person-search-by-name-roll-or-email"
                  type="text"
                  value={userQuery}
                  onChange={(e) => searchUsers(e.target.value)}
                  placeholder="Type a name, roll number or email…"
                  className="surface-card w-full bg-bg-elevated px-3 py-2 text-white focus:outline-none focus:"
                />
                {userQuery.trim().length >= 2 && userResults.length === 0 && (
                  <p className="text-xs text-text-muted">No matching people found.</p>
                )}
                {userResults.length > 0 && (
                  <div className="border border-border rounded-xl overflow-hidden divide-y divide-border max-h-40 overflow-y-auto">
                    {userResults.map((u) => (
                      <button
                        key={u.id}
                        type="button"
                        onClick={() => { setTargetUser(u as any); setTargetUserId(u.id); setUserQuery(""); setUserResults([]); }}
                        className="w-full text-left px-3 py-2 text-xs hover:bg-bg-elevated transition-colors"
                      >
                        <span className="font-semibold text-white">{u.name}</span>
                        <span className="text-text-muted ml-2">({u.role}{u.uniqueId ? ` · ${u.uniqueId}` : ""})</span>
                      </button>
                    ))}
                  </div>
                )}
                {targetUser && (
                  <div className="surface-card flex items-center justify-between px-3 py-2 bg-sky-500/10 text-xs">
                    <span className="text-action-info font-semibold">{targetUser.name} → {newRole}</span>
                    <button type="button" onClick={() => { setTargetUser(null); setTargetUserId(""); }} className="text-text-muted hover:text-white">✕</button>
                  </div>
                )}
              </div>
              <div className="space-y-1">
                <label className="text-text-muted font-medium" htmlFor="target-role">Target Role</label>
                <select id="target-role"
                  value={newRole}
                  onChange={(e) => setNewRole(e.target.value)}
                  className="surface-card w-full bg-bg-elevated px-3 py-2 text-white focus:outline-none focus:"
                >
                  <option value="admin">admin</option>
                  <option value="sysadmin">sysadmin</option>
                  <option value="principal">principal</option>
                  <option value="operator">operator</option>
                  <option value="faculty">faculty</option>
                </select>
              </div>
              <div className="space-y-1">
                <label className="text-text-muted font-medium" htmlFor="reason-for-promotion">Reason for Promotion</label>
                <textarea id="reason-for-promotion"
                  value={reason}
                  onChange={(e) => setReason(e.target.value)}
                  placeholder="Explain justification for role change..."
                  className="surface-card w-full bg-bg-elevated px-3 py-2 text-white focus:outline-none focus: h-20"
                  required
                />
              </div>
            </div>
            <div className="flex items-center justify-end gap-3 pt-2">
              <button
                type="button"
                onClick={() => setShowModal(false)}
                className="surface-card px-4 py-2 bg-bg-elevated text-white text-xs font-bold"
              >
                Cancel
              </button>
              <button
                type="submit"
                disabled={submitting}
