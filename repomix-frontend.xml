<file path="src/components/approver/OieStatusBar.tsx">
"use client";

/**
 * OieStatusBar — bottom status strip for the OIE exam-desk console.
 *
 * Renders the compact exam-queue summary:
 *   ● Exam queue · N pending · M exceptions · exam day: open/closed
 *
 * Counts are passed in from RoleConsole, which derives them from the
 * /api/oie/queue (pending) and /api/exam/access-exceptions (exceptions)
 * fetches, plus the exam-day gate state from /api/exam/access.
 */

import { Clock, Loader2, ShieldAlert, CalendarClock } from "lucide-react";

export interface OieCounts {
  /** Number of PENDING exam tickets in the OIE queue. */
  pending: number;
  /** Number of access exceptions (rejected / escalated / SLA-breached). */
  exceptions: number;
  /**
   * Exam-day gate access state. "open" | "closed" when /api/exam/access
   * exposes it; null when the state is not yet resolved.
   */
  examDay: "open" | "closed" | null;
}

export interface OieStatusBarProps {
  counts: OieCounts | null;
  /** Timestamp of the last data refresh (ISO). */
  lastScan?: string | null;
  /** Whether a refresh is in progress. */
  refreshing?: boolean;
}

export function OieStatusBar({ counts, lastScan, refreshing = false }: OieStatusBarProps) {
  const fmt = (iso: string | null | undefined) => {
    if (!iso) return "—";
    try {
      return new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
    } catch {
      return "—";
    }
  };

  const examDay = counts?.examDay;
  const examDayTone =
    examDay === "open"
      ? "text-action-success bg-emerald-400/10 border-emerald-400/20"
      : examDay === "closed"
        ? "text-action-danger bg-rose-400/10 border-rose-400/20"
        : "text-text-muted bg-bg-base border-border";

  return (
    <footer
      className="surface-card flex items-center justify-between gap-4 px-4 py-2 bg-bg-surface/95 backdrop-blur-md text-xs text-text-secondary select-none"
      aria-label="OIE exam status bar"
    >
      {/* Left: exam queue · pending · exceptions · exam day */}
      <div className="flex items-center gap-4 min-w-0">
        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span className="size-2 rounded-full bg-action-primary shrink-0" />
          <span className="text-text-muted">Exam queue</span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span className="text-text-muted">pending</span>
          <span className="font-mono tabular-nums font-bold text-action-warning">
            {counts?.pending ?? 0}
          </span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0">
          <ShieldAlert className="w-3.5 h-3.5 text-text-muted" />
          <span className="text-text-muted">exceptions</span>
          <span className="font-mono tabular-nums font-bold text-text-primary">
            {counts?.exceptions ?? 0}
          </span>
        </span>

        <span
          className={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 border font-semibold ${examDayTone}`}
        >
          <CalendarClock className="size-3.5" />
          exam day: {examDay ?? "—"}
        </span>
      </div>

      {/* Right: last updated + refresh indicator */}
      <div className="flex items-center gap-3 shrink-0">
        {refreshing ? (
          <Loader2 className="w-3.5 h-3.5 animate-spin text-text-muted" />
        ) : null}
        {lastScan ? (
          <span className="inline-flex items-center gap-1.5">
            <Clock className="w-3.5 h-3.5 text-text-muted" />
            <span className="text-text-muted">last updated</span>
            <span className="font-mono tabular-nums text-text-secondary">
              {fmt(lastScan)}
            </span>
          </span>
        ) : null}
      </div>
    </footer>
  );
}

export default OieStatusBar;
</file>

<file path="src/components/approver/ParentCommandBar.tsx">
"use client";

/**
 * ParentCommandBar — Cmd/Ctrl+K command palette for the parent/guardian
 * console. The parent is a read-only role, so all 5 commands are navigation
 * commands that route to the relevant parent portal page:
 *
 *   timeline      → /parent            (child-activity timeline feed)
 *   notifications → /parent/settings   (notification + account settings)
 *   fees          → /parent/passes     (passes / fee-style records)
 *   records       → /parent/child      (child movement records)
 *   contact       → /support           (help & support desk)
 *
 * Parent has no write actions (no approve / reject / forward), so execution
 * is a window.location transition + closing the palette. The href targets
 * mirror the 5 items produced by getDefaultNavigation("parent"), so the
 * command bar and the rail stay in sync.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  History,
  Bell,
  CreditCard,
  FileSpreadsheet,
  MessageSquare,
  Search,
  ChevronRight,
} from "lucide-react";
import { getConsoleConfig } from "@/config/consoles";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  href: string;
  icon: React.ComponentType<{ className?: string }>;
}

/**
 * The 5 parent commands. Mirrors the items returned by
 * getDefaultNavigation("parent") (nav + href), so the command palette and
 * the IconRail stay in sync. If a parent-specific sub-page lands later
 * (e.g. /parent/records) the mapping is a single-line update here.
 */
const COMMAND_DEFS: CommandDef[] = [
  {
    id: "timeline",
    label: "Child activity timeline",
    hint: "timeline — Open the child-activity timeline",
    href: "/guardian/movement-info",
    icon: History,
  },
  {
    id: "notifications",
    label: "Notifications & account settings",
    hint: "notifications — Open notification settings",
    href: "/guardian/contact-info",
    icon: Bell,
  },
  {
    id: "fees",
    label: "Fees & passes",
    hint: "fees — Open fees / pass records",
    href: "/guardian/request-status",
    icon: CreditCard,
  },
  {
    id: "records",
    label: "Child movement records",
    hint: "records — Open the child movement log",
    href: "/guardian/child-status",
    icon: FileSpreadsheet,
  },
  {
    id: "contact",
    label: "Help & support",
    hint: "contact — Open the support desk",
    href: "/support",
    icon: MessageSquare,
  },
];

export interface ParentCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function ParentCommandBar({ role, open, onClose }: ParentCommandBarProps) {
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const inputRef = useRef<HTMLInputElement>(null);

  // The console config declares `parent` commands; restrict to the ones the
  // role actually has so the palette stays in sync with CONSOLES.
  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id as "timeline"));
  }, [role]);

  const filtered = useMemo(() => {
    if (!query.trim()) return available;
    const q = query.toLowerCase();
    return available.filter(
      (c) => c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q) || c.id.toLowerCase().includes(q)
    );
  }, [query, available]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  const navigate = useCallback(
    (cmd: CommandDef) => {
      window.location.href = cmd.href;
      onClose();
    },
    [onClose]
  );

  const handleSelect = useCallback((cmd: CommandDef) => {
    setQuery(cmd.id);
    inputRef.current?.focus();
  }, []);

  const handleEnter = useCallback(() => {
    const first = query.trim().toLowerCase();
    const match =
      first.length === 0
        ? filtered[active]
        : filtered.find(
            (c) =>
              c.id.toLowerCase() === first ||
              c.label.toLowerCase().includes(first) ||
              c.hint.toLowerCase().includes(first)
          );
    if (match) navigate(match);
  }, [filtered, active, navigate, query]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!query.trim()) {
          if (filtered[active]) handleSelect(filtered[active]);
        } else {
          handleEnter();
        }
      }
    },
    [filtered, active, handleSelect, handleEnter, query]
  );

  if (!open) return null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="Parent command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={`Parent command (role: ${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="Parent command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Command list */}
        <ul role="listbox" aria-label="Parent commands" className="max-h-64 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>
      </div>
    </div>
  );
}

export default ParentCommandBar;
</file>

<file path="src/components/approver/ParentConsentStage.tsx">
/**
 * approver/ParentConsentStage — parent-consent node in the approval chain.
 *
 * When a pass requires parent consent, the approver sees this card in
 * StageQueuePanel to route it to the parent (or auto-approve if consent
 * was pre-granted in ParentConsentInbox).
 */

"use client";

import { useEffect, useState } from "react";
import { ShieldCheck, Clock, CheckCircle2, XCircle, Forward } from "lucide-react";
import { getAuthHeaders, cn } from "@/lib/utils";
import type { PermissionItem } from "@/components/approver/PermissionRow";
import { useUIStore } from "@/stores/uiStore";

export interface ParentConsentStageProps {
  request: PermissionItem;
  className?: string;
  /** Called when the parent-consent action completes. */
  onConsentResolved?: (consentId: string, action: "approved" | "declined" | "routed") => void;
}

export function ParentConsentStage({ request, className, onConsentResolved }: ParentConsentStageProps) {
  const { addToast } = useUIStore();
  const [consent, setConsent] = useState<{
    id: string;
    status: "pending" | "approved" | "declined";
    expiresAt: string;
  } | null>(null);

  // Fetch the consent record for this request.
  useEffect(() => {
    fetch(`/api/permissions/${request.id}/consent`, {
      headers: getAuthHeaders(),
      cache: "no-store",
    })
      .then((r) => (r.ok ? r.json() : null))
      .then((b) => {
        if (b?.data) setConsent(b.data);
      })
      .catch(() => {});
  }, [request.id]);

  const route = async () => {
    try {
      const res = await fetch(`/api/permissions/${request.id}/route-to-parent`, {
        method: "POST",
        headers: getAuthHeaders(),
      });
      const b = await res.json().catch(() => null);
      if (res.ok) {
        addToast({ variant: "success", title: "Routed to parent", message: "Parent notified for consent." });
        onConsentResolved?.(request.id, "routed");
      } else {
        addToast({ variant: "error", title: "Routing failed", message: b?.error?.message ?? "Could not route." });
      }
    } catch {
      addToast({ variant: "error", title: "Routing failed", message: "Network error." });
    }
  };

  if (!consent) return null;

  const decided = consent.status === "approved" || consent.status === "declined";

  return (
    <div
      className={cn(
        "rounded-xl border p-3 space-y-2",
        consent.status === "approved" && "border-emerald-500/30 bg-emerald-500/5",
        consent.status === "declined" && "border-rose-500/30 bg-rose-500/5",
        consent.status === "pending" && "border-amber-500/30 bg-amber-500/5",
        className
      )}
    >
      <div className="flex items-center gap-2">
        <ShieldCheck
          className={cn(
            "h-4 w-4",
            consent.status === "approved" ? "text-emerald-500"
              : consent.status === "declined" ? "text-rose-500"
              : "text-amber-500"
          )}
        />
        <div className="min-w-0">
          <p className="text-xs font-semibold text-text-primary">Parent consent</p>
          <p className="text-[10px] text-text-muted">
            {decided
              ? `Parent ${consent.status}`
              : "Awaiting parent approval"}
          </p>
        </div>
        <div className="ml-auto">
          {decided ? (
            <span
              className={cn(
                "text-[10px] font-semibold uppercase",
                consent.status === "approved" ? "text-emerald-500" : "text-rose-500"
              )}
            >
              {consent.status}
            </span>
          ) : (
            <button
              type="button"
              onClick={() => void route()}
              className="inline-flex items-center gap-1 rounded-md bg-amber-500/10 border border-amber-500/30 px-2 py-1 text-[10px] font-semibold text-amber-600 hover:bg-amber-500/20"
            >
              <Forward className="h-3 w-3" /> Route to parent
            </button>
          )}
        </div>
      </div>

      {!decided && (
        <p className="text-[10px] text-text-muted flex items-center gap-1">
          <Clock className="h-3 w-3" />
          Consent expires {new Date(consent.expiresAt).toLocaleString("en-IN", {
            hour: "2-digit",
            minute: "2-digit",
          })}
        </p>
      )}
    </div>
  );
}

export default ParentConsentStage;
</file>

