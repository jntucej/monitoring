                <AlertTriangle className="size-3.5" /> Overdue
              </span>
            )}
            {slaDeadline && urgency === "due" && (
              <span className="surface-card inline-flex items-center gap-1 bg-amber-500/10 px-2 py-0.5 text-xs font-medium text-action-warning">
