"use client";

import { useCallback, useEffect, useState } from "react";
import { getAuthHeaders } from "@/lib/utils";
import { useEntityInspector } from "@/components/shared/useEntityInspector";
import { EntityInspector, KVPairs, InspectorButton, type EntityInspection } from "@/components/shared/EntityInspector";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface ComplaintCategoryRow {
  code: string;
  label: string;
  ownerRole?: string;
  slaHours?: number;
}

/**
 * One escalation step of a category's complaint_escalation_chains row, as
 * read back from the /api/complaints category payload when it is present.
 */
interface EscalationStepRow {
  position: number;
  role: string;
  slaHours?: number;
  autoEscalateOnBreach?: boolean;
}

/**
 * ChainsPage — complaint escalation chains register.
 *
 * Rows are complaint CATEGORIES (the complaint_escalation_chains seed), not
 * individual complaints: each row carries code/label/owner/SLA. The task's
 * "complaint" kind resolver (/api/complaints/:id) is for individual
 * complaint records, so category rows get an inline EntityInspection with
 * KVPairs built from the row data already loaded by /api/admin/complaint-categories
 * (escalation-chain steps are included when the payload carries them).
 * Individual complaints remain inspectable via the "complaint" resolver on
 * the complaint detail pages.
 */
export default function ChainsPage() {
  const [rows, setRows] = useState<ComplaintCategoryRow[]>([]);
  /** Per-category escalation-chain steps, loaded alongside when available. */
  const [chains, setChains] = useState<Record<string, EscalationStepRow[]>>({});
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const load = useCallback(async () => {
    const r = await fetch("/api/admin/complaint-categories", { headers: getAuthHeaders() });
    const j = await r.json();
    setRows(j.data?.categories ?? []);
    if (j.data?.chains) setChains(j.data.chains as Record<string, EscalationStepRow[]>);
  }, []);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  // Inline entity inspection from the category row + its chain steps — no
  // extra fetch needed (the row data is already loaded).
  const buildChainInspection = (c: ComplaintCategoryRow): EntityInspection => {
    const steps = chains[c.code] ?? [];
    const overview: Array<{ label: string; value: React.ReactNode }> = [
      { label: "Code", value: <code className="font-mono">{c.code}</code> },
      { label: "Label", value: c.label },
      { label: "Primary owner", value: c.ownerRole ?? "—" },
      { label: "SLA (h)", value: String(c.slaHours ?? "—") },
    ];
    const sections: EntityInspection["sections"] = [
      { title: "Overview", content: <KVPairs items={overview} /> },
    ];
    if (steps.length > 0) {
      sections.push({
        title: "Escalation chain",
        collapsible: true,
        content: (
          <KVPairs
            items={steps.map((s) => ({
              label: `Step ${s.position} · ${s.role}`,
              value: [
                s.slaHours != null ? `SLA ${s.slaHours}h` : null,
                s.autoEscalateOnBreach ? "auto-escalates on breach" : null,
              ].filter(Boolean).join(" · ") || "—",
            }))}
          />
        ),
      });
    } else {
      sections.push({
        title: "Escalation chain",
        content: (
          <p className="text-xs text-text-muted">
            Escalation chains are system-managed. Contact your IT / Platform Team to request routing changes.
          </p>
        ),
      });
    }
    sections.push({
      title: "Actions",
      content: (
        <div className="flex flex-wrap gap-2">
          <InspectorButton href="/admin/cases" variant="ghost">All cases</InspectorButton>
          <InspectorButton href="/admin/complaints/categories" variant="ghost">Category settings</InspectorButton>
        </div>
      ),
    });
    return {
      kind: "complaint",
      title: c.label,
      subtitle: c.code,
      status: (
        <span className="px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase bg-bg-elevated text-text-muted border border-border">
          SEED
        </span>
      ),
      sections,
      detailHref: "/admin/cases",
      detailLabel: "Complaints console",
    };
  };

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Manage and monitor complaints chains for campus operations."
        why="The chain here defines the real-time status students see under their open complaint tickets."
        contextLabel="Complaints Chains"
        statusSummary="Review current complaints chains state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <h1 className="text-2xl font-semibold">Complaint escalation chains</h1>
      <p className="text-sm text-text-muted">
        Escalation chains are system-managed. Contact your IT / Platform Team to request routing changes.
      </p>
      <div className="border rounded bg-white overflow-x-auto">
        <table className="w-full text-sm">
          <thead className="text-left border-b bg-bg-elevated">
            <tr>
              <th className="p-3">Code</th>
              <th className="p-3">Label</th>
              <th className="p-3">Primary Owner</th>
              <th className="p-3">SLA (h)</th>
            </tr>
          </thead>
          <tbody className="divide-y">
            {rows.map((c) => (
              <tr key={c.code} className="cursor-pointer hover:bg-bg-elevated transition-colors" onClick={() => inspect(buildChainInspection(c))}>
                <td className="p-3 font-mono">{c.code}</td>
                <td className="p-3 font-medium">{c.label}</td>
                <td className="p-3 font-mono text-text-muted">{c.ownerRole}</td>
                <td className="p-3">{c.slaHours}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <EntityInspector inspection={inspection} onClose={closeInspection} />
    </div>
  );
}
</file>

<file path="src/app/(admin)/admin/passes/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import { usePersistentQuery } from "@/hooks/usePersistentQuery";
import {Search, CheckCircle2, XCircle, Clock, QrCode, ChevronRight}  from "lucide-react";
import { EntityInspector, KVPairs, InspectorButton } from "@/components/shared/EntityInspector";
import { HoverPreview, MetricPreview } from "@/components/shared/HoverPreview";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { InlineDiffBadge } from "@/components/shared/InlineDiffBadge";

interface PassRow {
  id: string;
  type: string;
  status: string;
  roll: string | null;
  name: string | null;
  reason: string | null;
  createdAt: string | null;
  expiresAt: string | null;
}

async function fetchPasses(): Promise<PassRow[]> {
  const res = await fetch("/api/passes?limit=200", { headers: getAuthHeaders() });
  const body = await res.json();
  const raw = (body?.data ?? body ?? []) as any[];
  return raw.map((p) => ({
    id: p.id,
    type: p.type ?? p.passType ?? "UNKNOWN",
    status: p.finalStatus ?? p.status ?? "UNKNOWN",
    roll: p.roll ?? p.studentRoll ?? null,
    name: p.studentName ?? p.name ?? null,
    reason: p.reason ?? null,
    createdAt: p.createdAt ?? p.created_at ?? null,
    expiresAt: p.expiresAt ?? p.expiry ?? null,
  }));
}

function statusBadge(s: string) {
  const c = s.toUpperCase();
  if (c === "APPROVED" || c === "ACTIVE" || c === "GRANTED")
    return "bg-emerald-500/10 text-action-success";
  if (c === "PENDING" || c === "REQUESTED") return "bg-amber-500/10 text-action-warning";
  if (c === "REJECTED" || c === "DENIED" || c === "EXPIRED")
    return "bg-rose-500/10 text-action-danger";
  return "bg-bg-elevated/10 text-text-muted";
}

/**
 * Admin Passes — gate pass list + bulk status.
 * Backend: /api/passes (admin|sysadmin|operator|... scope).
 */
function AdminPassesInner() {
  const [rows, setRows] = useState<PassRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [query, setQuery] = usePersistentQuery("gate-admin-passes-query");

  const load = useCallback(async () => {
    setLoading(true);
    try { setRows(await fetchPasses()); }
    catch (e) { console.error("passes", e); }
    finally { setLoading(false); }
  }, []);

  useEffect(() => { load(); }, [load]);

  const filtered = query.trim()
    ? rows.filter((r) =>
        `${r.roll} ${r.name} ${r.type} ${r.status}`.toLowerCase().includes(query.toLowerCase()))
    : rows;

  const pending = rows.filter((r) => r.status.toUpperCase() === "PENDING" || r.status.toUpperCase() === "REQUESTED").length;
  const active = rows.filter((r) => ["APPROVED", "ACTIVE", "GRANTED"].includes(r.status.toUpperCase())).length;

  const [activePass, setActivePass] = useState<PassRow | null>(null);
  const [revokeReason, setRevokeReason] = useState("");
  const [revoking, setRevoking] = useState(false);
  const [revokeMsg, setRevokeMsg] = useState<string | null>(null);

  const handleRevoke = async (ticketId: string) => {
    if (!revokeReason.trim() || revoking) return;
    setRevoking(true);
    setRevokeMsg(null);
    try {
      const res = await fetch(`/api/permissions/${encodeURIComponent(ticketId)}/revoke`, {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ reason: revokeReason.trim() }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok || body?.success === false) {
        setRevokeMsg(body?.error?.message ?? "Failed to revoke pass.");
        return;
      }
      setRows((prev) =>
        prev.map((r) => (r.id === ticketId ? { ...r, status: "CANCELLED" } : r)),
      );
      setActivePass((prev) => (prev && prev.id === ticketId ? { ...prev, status: "CANCELLED" } : prev));
      setRevokeReason("");
      setRevokeMsg("Pass revoked and student notified.");
    } finally {
      setRevoking(false);
    }
  };

  /** Standardized inspection model for a pass (overview → context → history → actions). */
  const passInspection = activePass
    ? {
        kind: "pass",
        title: activePass.name ?? activePass.roll ?? "Pass record",
        subtitle: activePass.roll ?? activePass.id,
        status: (
          <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${statusBadge(activePass.status)}`}>
            {activePass.status}
          </span>
        ),
        sections: [
          {
            title: "Overview",
            content: (
              <KVPairs
                items={[
                  { label: "Type", value: activePass.type.replace("_", " ") },
                  { label: "Status", value: activePass.status },
                  ...(activePass.reason ? [{ label: "Reason", value: activePass.reason }] : []),
                ]}
              />
            ),
          },
          {
            title: "Validity",
            content: (
              <KVPairs
                items={[
                  {
                    label: "Created",
                    value: activePass.createdAt
                      ? new Date(activePass.createdAt).toLocaleString("en-IN")
                      : "—",
                  },
                  {
                    label: "Expires",
                    value: activePass.expiresAt
                      ? new Date(activePass.expiresAt).toLocaleString("en-IN")
                      : "No expiry",
                  },
                ]}
              />
            ),
          },
          {
            title: "Actions",
            content: (
              <div className="space-y-3">
                <div className="flex flex-wrap gap-2">
                  <InspectorButton
                    href={`/admin/students/${activePass.roll ?? activePass.id}`}
                    variant="ghost"
                  >
                    <ChevronRight className="size-3.5" /> Student profile
                  </InspectorButton>
                  <InspectorButton
                    href="/admin/cases"
                    variant="ghost"
                  >
                    <ChevronRight className="size-3.5" /> Linked cases
                  </InspectorButton>
                </div>
                {["APPROVED", "ACTIVE", "GRANTED"].includes(activePass.status.toUpperCase()) && (
                  <div className="space-y-2 pt-2 border-t border-border">
                    <input
                      type="text"
                      value={revokeReason}
                      onChange={(e) => setRevokeReason(e.target.value)}
                      placeholder="Revocation reason (required)…"
                      aria-label="Revocation reason"
                      className="w-full min-h-11 rounded-lg bg-bg-elevated px-3 py-1.5 text-xs text-text-primary"
                    />
                    <button
                      type="button"
                      disabled={!revokeReason.trim() || revoking}
                      onClick={() => void handleRevoke(activePass.id)}
                      className="min-h-11 w-full rounded-lg bg-action-danger px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50"
                    >
                      {revoking ? "Revoking…" : "Revoke Active Pass"}
                    </button>
                  </div>
                )}
                {revokeMsg && (
                  <div className="space-y-1.5">
                    <p className="text-xs font-medium text-action-primary">{revokeMsg}</p>
                    {activePass.status === "CANCELLED" && (
                      <InlineDiffBadge
                        label="Pass Status"
                        before="ACTIVE"
                        after="CANCELLED"
                        tone="danger"
                      />
                    )}
                  </div>
                )}
              </div>
            ),
          },
        ],
        detailHref: `/admin/passes`,
        detailLabel: "All passes",
      }
    : null;

  if (loading) {
    return (
      <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-4 py-4 md:py-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Outing, day-pass, and home-out pass records"
        why="Revoke a pass here and it stops working at every gate scanner within seconds."
        contextLabel="Outing, day-pass, and home-out pass records"
        statusSummary="Review current outing, day-pass, and home-out pass records state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
        <Skeleton className="h-10 w-48" />
        <Skeleton className="h-72 rounded-2xl" />
      </div>
    );
  }

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-4 md:py-6">
      <PageHeader
        title="Gate Passes"
        subtitle="Outing, day-pass, and home-out pass records"
        onRefresh={load}
      />

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <HoverPreview
          preview={<MetricPreview label="Total" value={rows.length} hint="Latest 200 pass records" />}
        >
          <div className="surface-card p-4 h-full cursor-help">
            <p className="text-xs text-text-muted flex items-center gap-1.5"><QrCode className="w-3.5 h-3.5" /> Total</p>
            <p className="text-2xl font-bold text-text-primary tabular-nums">{rows.length}</p>
          </div>
        </HoverPreview>
        <HoverPreview
          preview={<MetricPreview label="Pending" value={pending} hint="Awaiting approval — inspect a row for context" />}
        >
          <div className="surface-card p-4 h-full cursor-help">
            <p className="text-xs text-text-muted flex items-center gap-1.5"><Clock className="w-3.5 h-3.5 text-action-warning" /> Pending</p>
            <p className="text-2xl font-bold text-action-warning tabular-nums">{pending}</p>
          </div>
        </HoverPreview>
        <HoverPreview
          preview={<MetricPreview label="Active" value={active} hint="Approved / granted / in effect" />}
        >
          <div className="surface-card p-4 h-full cursor-help">
            <p className="text-xs text-text-muted flex items-center gap-1.5"><CheckCircle2 className="w-3.5 h-3.5 text-action-success" /> Active</p>
            <p className="text-2xl font-bold text-action-success tabular-nums">{active}</p>
          </div>
        </HoverPreview>
        <HoverPreview
          preview={<MetricPreview label="Closed" value={rows.length - pending - active} hint="Rejected, completed, or expired" />}
        >
          <div className="surface-card p-4 h-full cursor-help">
            <p className="text-xs text-text-muted flex items-center gap-1.5"><XCircle className="w-3.5 h-3.5 text-action-danger" /> Closed</p>
            <p className="text-2xl font-bold text-action-danger tabular-nums">{rows.length - pending - active}</p>
          </div>
        </HoverPreview>
      </div>

      <WidgetBoundary title="Pass records">
        <div className="glass-card">
          <div className="surface-card p-4 flex items-center gap-2 min-h-11">
            <Search className="w-4 h-4 text-text-muted" />
            <input
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Filter by roll, name, type, or status…"
              className="flex-1 min-h-11 bg-transparent text-sm text-text-primary placeholder:text-text-muted focus:outline-none"
            />
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-xs text-text-muted border-b border-border">
                  <th className="p-3 text-left">Student</th>
                  <th className="p-3 text-left">Roll</th>
                  <th className="p-3 text-left">Type</th>
                  <th className="p-3 text-left">Reason</th>
                  <th className="p-3 text-left">Status</th>
                  <th className="p-3 text-left">Created</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {filtered.length === 0 && (
                  <tr><td colSpan={6} className="p-6 text-center text-text-muted">No passes found.</td></tr>
                )}
                {filtered.map((r) => (
                  <tr
                    key={r.id}
                    className="hover:bg-bg-elevated/40 cursor-pointer"
                    onClick={() => setActivePass(r)}
                  >
                    <td className="p-3 text-text-primary">{r.name ?? "—"}</td>
                    <td className="p-3 font-mono text-xs text-text-muted">{r.roll ?? "—"}</td>
                    <td className="p-3 text-xs capitalize">{r.type.replace("_", " ")}</td>
                    <td className="p-3 text-xs text-text-muted">{r.reason ?? "—"}</td>
                    <td className="p-3">
                      <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${statusBadge(r.status)}`}>{r.status}</span>
                    </td>
                    <td className="p-3 text-xs text-text-muted">
                      {r.createdAt ? new Date(r.createdAt).toLocaleDateString("en-IN") : "—"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </WidgetBoundary>

      <EntityInspector inspection={passInspection} onClose={() => setActivePass(null)} />
    </div>
  );
}

export default function AdminPassesPage() {
  return (
    
      <AdminPassesInner />
    
    

  );
}
