"use client";
// src/components/sysadmin/SchedulingPanel.tsx
// ─────────────────────────────────────────────────────────────────────────────
// AI Smart Scheduling Assistant — rich sysadmin panel.
//
// Hierarchy:
//   PageHeader
//     └ KPI strip (4 cards)
//     └ Main grid (2/3 list + 1/3 side rail)
//     └ DevContactStrip + ConfirmDialog
//
// Compliance: GuardedPage-wrapped · Suspense-safe · useApiResource +
// usePolling (visibility-aware) · WidgetBoundary per widget · toasts (no
// alert()) · typed interfaces (no any) · aria-* on every action ·
// no file-scope eslint-disable.
//
// Generated by scripts/scaffold-rich-panel.mjs — SCAFFOLD:RICH-PANEL
// ─────────────────────────────────────────────────────────────────────────────

import { useCallback, useMemo, useState } from "react";
import {Sparkles, DoorOpen, Users, Moon, Check, ChevronDown, ChevronRight, TrendingUp, Target, Brain, AlertTriangle, Info, CheckCircle2, History, ShieldCheck, Activity, ArrowRight, Loader2, Eye}  from "lucide-react";

import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageHeader } from "@/components/shared/PageHeader";

import { ConfirmDialog } from "@/components/shared/ConfirmDialog";
import { EmptyState } from "@/components/shared/EmptyState";

import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";

import { getAuthHeaders } from "@/lib/utils";
import { fmtInt, fmtRelative } from "@/lib/formatters";

import type { SchedulingItem } from "@/lib/scheduling";

/* ─────────────────────────── Meta ─────────────────────────── */

type CategoryKey = "gate_hours" | "operator_shifts" | "curfew_adjustment";

const CATEGORY_META: Record<
  CategoryKey,
  { label: string; description: string; icon: React.ComponentType<{ className?: string; "aria-hidden"?: boolean }>; accent: string; surface: string }
> = {
  gate_hours: {
    label: "Gate Hours",
    description: "Adjust gate hours based on observed patterns.",
    icon: DoorOpen,
    accent: "text-action-success",
    surface: "bg-emerald-500/10 border-emerald-500/30",
  },
  operator_shifts: {
    label: "Operator Shifts",
    description: "Adjust operator shifts based on observed patterns.",
    icon: Users,
    accent: "text-action-success",
    surface: "bg-emerald-500/10 border-emerald-500/30",
  },
  curfew_adjustment: {
    label: "Curfew Adjustment",
    description: "Adjust curfew adjustment based on observed patterns.",
    icon: Moon,
    accent: "text-action-success",
    surface: "bg-emerald-500/10 border-emerald-500/30",
  },
} as const;

interface ImpactTier {
  label: string;
  accent: string;
  bar: string;
}

function impactTier(score: number): ImpactTier {
  if (score >= 80) return { label: "Critical", accent: "text-action-danger",    bar: "bg-action-danger" };
  if (score >= 60) return { label: "High",     accent: "text-action-warning",   bar: "bg-action-warning" };
  if (score >= 40) return { label: "Medium",   accent: "text-action-info",     bar: "bg-action-info" };
  return               { label: "Low",      accent: "text-text-muted",   bar: "bg-bg-elevated" };
}

/* ─────────────────────────── Types ─────────────────────────── */

interface SuggestionsResponse {
  suggestions: SchedulingItem[];
  generatedAt: string;
  model: { name: string; version: string; samples: number };
}

interface AppliedEntry {
  id: string;
  title: string;
  category: CategoryKey;
  appliedAt: string;
  actor: string;
}

interface ApplyResponse {
  success: boolean;
  applied?: boolean;
  error?: string;
}

/* ─────────────────────────── Component ─────────────────────────── */

export function SchedulingPanel() {
  const user = useAuthStore((s) => s.user);
  const addToast = useUIStore((s) => s.error);
  const addSuccess = useUIStore((s) => s.success);

  const [categoryFilter] = useState<CategoryKey | "all">("all");
  const [minImpact] = useState(0);
  const [expanded, setExpanded] = useState<Set<string>>(new Set());
  const [pendingApply, setPendingApply] = useState<SchedulingItem | null>(null);
  const [applying, setApplying] = useState<string | null>(null);
  const [applied, setApplied] = useState<AppliedEntry[]>([]);

  const suggestions = useApiResource<SuggestionsResponse>(
    "/api/admin/scheduling/suggestions",
    { ttlMs: 30_000 },
  );

  // useApiResource already fires the initial fetch on mount and re-validates
  // on TTL expiry when visible. No separate usePolling timer on top of that —
  // two overlapping pollers on the same endpoint was the exact "requests
  // per minute" spike pattern this app has been fighting.
  const rows = useMemo(() => {
    const all = suggestions.data?.suggestions ?? [];
    return all
      .filter((s) => categoryFilter === "all" || s.category === categoryFilter)
      .filter((s) => s.impact_score >= minImpact)
      .sort((a, b) => b.impact_score - a.impact_score);
  }, [suggestions.data, categoryFilter, minImpact]);

  const stats = useMemo(() => {
    const all = suggestions.data?.suggestions ?? [];
    const avgImpact = all.length
      ? Math.round(all.reduce((s, x) => s + x.impact_score, 0) / all.length)
      : 0;
    const highPriority = all.filter((s) => s.impact_score >= 60).length;
    const byCategory: Record<CategoryKey, number> = { gate_hours: 0, operator_shifts: 0, curfew_adjustment: 0 };
    for (const s of all) byCategory[s.category]++;
    return { total: all.length, avgImpact, highPriority, byCategory };
  }, [suggestions.data]);

  const lastUpdated = suggestions.data?.generatedAt
    ? fmtRelative(suggestions.data.generatedAt)
    : "—";

  const toggleExpand = useCallback((id: string) => {
    setExpanded((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  }, []);

  const requestApply = useCallback((s: SchedulingItem) => setPendingApply(s), []);

  const confirmApply = useCallback(async () => {
    const target = pendingApply;
    if (!target) return;
    setPendingApply(null);
    setApplying(target.id);
    try {
      const res = await fetch("/api/admin/scheduling/apply", {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ suggestionId: target.id }),
      });
      const body = (await res.json().catch(() => ({}))) as ApplyResponse;
      if (!res.ok || body.success === false) {
        throw new Error(body.error ?? `Apply failed (${res.status})`);
      }
      setApplied((prev) => [
        {
          id: target.id,
          title: target.title,
          category: target.category,
          appliedAt: new Date().toISOString(),
          actor: user?.name ?? "System Admin",
        },
        ...prev,
      ]);
      addSuccess(`Applied: ${target.title}`);
      clearCache("/api/admin/scheduling/suggestions");
      await suggestions.refresh();
    } catch (e) {
      addToast(e instanceof Error ? e.message : "Could not apply suggestion");
    } finally {
      setApplying(null);
    }
  }, [pendingApply, suggestions, addSuccess, addToast, user]);

  return (
    <div className="space-y-6 p-4 sm:p-6">
      <PageHeader
        title="AI Smart Scheduling Assistant"
        subtitle={`Machine-learning recommendations for gate hours, operator shifts, and curfew tuning · Updated ${lastUpdated}`}
        onRefresh={() => suggestions.refresh()}
        refreshing={suggestions.loading}
      />

      {suggestions.error ? (
        <div role="alert" className="surface-card flex items-start gap-2 bg-rose-500/10 p-3 text-sm text-action-danger">
          <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" aria-hidden />
          <div>
            <p className="font-medium">Could not load ai smart scheduling assistant</p>
            <p className="text-rose-600/80">{suggestions.error}</p>
          </div>
        </div>
      ) : null}

      <WidgetBoundary title="scheduling-kpis">
        <section aria-label="Key metrics" className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          <KpiCard
            icon={Sparkles}
            label="Total items"
            value={stats.total}
            
            hint="Total items for the current model run"
            accent="text-action-success"
          />
          <KpiCard
            icon={TrendingUp}
            label="Avg. impact"
            value={stats.avgImpact}
                        suffix={"/ 100"}
            hint="Avg. impact for the current model run"
            accent="text-action-info"
          />
          <KpiCard
            icon={Target}
            label="High priority"
            value={stats.highPriority}
            
            hint="High priority for the current model run"
            accent="text-action-warning"
          />
          <KpiCard
            icon={History}
            label="Applied today"
            value={applied.length}
            
            hint="Applied today for the current model run"
            accent="text-unit-c"
          />
        </section>
      </WidgetBoundary>

      <div className="grid gap-4 lg:grid-cols-3">
        <div className="lg:col-span-2">
          <WidgetBoundary title="items-list">
            <section aria-label="Recommendations" className="rounded-xl border border-border bg-bg-surface">
              <header className="surface-card flex flex-wrap items-center justify-between gap-2 px-4 py-3">
                <div className="flex items-center gap-2">
                  <Sparkles className="h-4 w-4 text-action-primary" aria-hidden />
                  <h2 className="text-sm font-semibold text-text-primary">Recommendations</h2>
                  <span className="surface-card bg-bg-elevated px-2 py-0.5 text-xs tabular-nums text-text-muted">
                    {rows.length} of {stats.total}
                  </span>
                </div>
              </header>

              <div className="p-2">
                {suggestions.loading && !suggestions.data ? (
                  <div className="space-y-2 p-2" aria-busy="true">
                    {Array.from({ length: 3 }).map((_, i) => (
                      <div key={i} className="h-24 animate-pulse rounded-lg bg-bg-elevated" />
                    ))}
                  </div>
                ) : rows.length === 0 ? (
                  <EmptyState
                    title="No recommendations match your filters"
                    description="Adjust the category or impact threshold, or refresh to re-analyze."
                    icon={<Sparkles className="h-6 w-6" />}
                  />
                ) : (
                  <ul className="space-y-2" role="list">
                    {rows.map((s) => (
                      <li key={s.id}>
                        <ItemCard
                          item={s}
                          expanded={expanded.has(s.id)}
                          onToggle={() => toggleExpand(s.id)}
                          onApply={() => requestApply(s)}
                          applying={applying === s.id}
                        />
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </section>
          </WidgetBoundary>
        </div>

        <aside className="space-y-4 lg:col-span-1">
          <WidgetBoundary title="model-info">
            <section aria-label="Model information" className="surface-card bg-bg-surface p-4">
              <header className="mb-3 flex items-center gap-2">
                <Brain className="h-4 w-4 text-text-muted" aria-hidden />
                <h2 className="text-sm font-semibold text-text-primary">Model</h2>
              </header>
              <dl className="space-y-2 text-sm">
                <div className="flex items-center justify-between">
                  <dt className="text-text-muted">Version</dt>
                  <dd className="tabular-nums text-text-primary">{suggestions.data?.model.version ?? "—"}</dd>
                </div>
                <div className="flex items-center justify-between">
                  <dt className="text-text-muted">Samples</dt>
                  <dd className="tabular-nums text-text-primary">
                    {suggestions.data?.model.samples ? fmtInt(suggestions.data.model.samples) : "—"}
                  </dd>
                </div>
                <div className="flex items-center justify-between">
                  <dt className="text-text-muted">Last trained</dt>
                  <dd className="text-text-primary">{lastUpdated}</dd>
                </div>
              </dl>
              <p className="surface-card mt-3 flex items-start gap-1.5 bg-bg-elevated p-2 text-xs text-text-muted">
                <ShieldCheck className="mt-0.5 size-3.5 shrink-0 text-action-success" aria-hidden />
                Suggestions are advisory. Every applied change is audit-logged with the acting admin and a before/after snapshot.
              </p>
            </section>
          </WidgetBoundary>

          <WidgetBoundary title="recent-applications">
            <section aria-label="Recently applied changes" className="surface-card bg-bg-surface p-4">
              <header className="mb-3 flex items-center gap-2">
                <Activity className="h-4 w-4 text-text-muted" aria-hidden />
                <h2 className="text-sm font-semibold text-text-primary">Applied this session</h2>
              </header>
              {applied.length === 0 ? (
                <p className="text-xs text-text-muted">
                  No changes applied yet. Applied changes appear here with a timestamp and actor.
                </p>
              ) : (
                <ul className="space-y-2" role="list">
                  {applied.map((a) => (
                    <li key={`${a.id}-${a.appliedAt}`} className="surface-card flex items-start gap-2 bg-bg-elevated p-2">
                      <CheckCircle2 className="mt-0.5 h-3.5 w-3.5 shrink-0 text-action-success" aria-hidden />
                      <div className="min-w-0 flex-1">
                        <p className="truncate text-xs font-medium text-text-primary">{a.title}</p>
                        <p className="text-xs text-text-muted">
                          {CATEGORY_META[a.category].label} · {fmtRelative(a.appliedAt)} · {a.actor}
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </WidgetBoundary>
        </aside>
      </div>

      <ConfirmDialog
        open={pendingApply !== null}
        onClose={() => setPendingApply(null)}
        onConfirm={confirmApply}
        title="Apply this change?"
        body={pendingApply ? `${pendingApply.title}\n\n${pendingApply.recommendation}\n\nThis writes an audit-logged change.` : ""}
        confirmText="Apply change"
        cancelText="Cancel"
        variant="primary"
      />
    </div>
  );
}

/* ─────────────────────────── Sub-components ─────────────────────────── */

function KpiCard({
  icon: Icon,
  label,
  value,
  suffix,
  hint,
  accent,
}: {
  icon: React.ComponentType<{ className?: string; "aria-hidden"?: boolean }>;
  label: string;
  value: number;
  suffix?: string;
  hint: string;
  accent: string;
}) {
  return (
    <div className="surface-card bg-bg-surface p-4">
      <div className="flex items-center justify-between">
        <p className="text-xs uppercase tracking-wide text-text-muted">{label}</p>
        <Icon className={`h-4 w-4 ${accent}`} aria-hidden />
      </div>
      <p className="mt-2 text-2xl font-semibold tabular-nums text-text-primary">
        {fmtInt(value)}
        {suffix ? <span className="ml-1 text-sm font-normal text-text-muted">{suffix}</span> : null}
      </p>
      <p className="mt-1 text-xs leading-snug text-text-muted">{hint}</p>
    </div>
  );
}

function ItemCard({
  item,
  expanded,
  onToggle,
  onApply,
  applying,
}: {
  item: SchedulingItem;
  expanded: boolean;
  onToggle: () => void;
  onApply: () => void;
  applying: boolean;
}) {
  const meta = CATEGORY_META[item.category];
  const tier = impactTier(item.impact_score);
  const Icon = meta.icon;
  const Chevron = expanded ? ChevronDown : ChevronRight;

  return (
    <article className="rounded-lg border border-border bg-bg-elevated transition-colors hover:border-border">
      <header className="flex items-start gap-3 p-3">
        <button
          type="button"
          onClick={onToggle}
          aria-label={expanded ? "Collapse item" : "Expand item"}
          aria-expanded={expanded}
          className="surface-card mt-0.5 p-1 text-text-muted hover:bg-bg-surface hover:text-text-primary"
        >
          <Chevron className="h-4 w-4" aria-hidden />
        </button>

        <div className={`mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md border ${meta.surface}`}>
          <Icon className={`h-4 w-4 ${meta.accent}`} aria-hidden />
        </div>

        <div className="min-w-0 flex-1">
          <div className="flex flex-wrap items-center gap-2">
            <h3 className="truncate text-sm font-semibold text-text-primary">{item.title}</h3>
            <span className={`rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ${meta.surface} ${meta.accent}`}>
              {meta.label}
            </span>
          </div>
          <p className="mt-0.5 line-clamp-2 text-xs text-text-muted">{item.recommendation}</p>

          <div className="mt-2 flex items-center gap-2">
            <div
              className="h-1.5 flex-1 overflow-hidden rounded-full bg-bg-surface"
              role="progressbar"
              aria-valuenow={item.impact_score}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-label="Impact score"
            >
              <div className={`h-full rounded-full ${tier.bar}`} style={{ width: `${item.impact_score}%` }} />
            </div>
            <span className={`text-xs font-medium tabular-nums ${tier.accent}`}>{item.impact_score}</span>
            <span className={`text-xs uppercase tracking-wide ${tier.accent}`}>{tier.label}</span>
          </div>
        </div>

        <div className="flex shrink-0 items-center gap-1">
          <button
            type="button"
            onClick={onToggle}
            aria-label="Preview reasoning"
            className="surface-card p-1.5 text-text-muted hover:bg-bg-surface hover:text-text-primary"
          >
            <Eye className="h-4 w-4" aria-hidden />
          </button>
          <button
            type="button"
            onClick={onApply}
            disabled={applying}
            aria-label={`Apply ${item.title}`}
            className="surface-card inline-flex items-center gap-1 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-medium text-action-success hover:bg-emerald-500/20 disabled:opacity-50"
          >
            {applying ? <Loader2 className="size-3.5 animate-spin" aria-hidden /> : <Check className="size-3.5" aria-hidden />}
            {applying ? "Applying" : "Apply"}
          </button>
        </div>
      </header>

      {expanded ? (
        <div className="surface-card p-3 text-xs">
          <div className="space-y-3">
            <div>
              <p className="mb-1 text-xs font-medium uppercase tracking-wide text-text-muted">AI reasoning</p>
              <p className="surface-card bg-bg-surface p-2 leading-relaxed text-text-secondary">
                {item.reasoning}
              </p>
            </div>
            <div>
              <p className="mb-1 text-xs font-medium uppercase tracking-wide text-text-muted">Suggested change</p>
              <div className="surface-card flex flex-wrap items-center gap-2 bg-bg-surface p-2">
                <ChangeChip label="Target" value={item.suggested_action?.target ?? "—"} />
                {item.suggested_action?.before ? <ChangeChip label="Before" value={item.suggested_action.before} /> : null}
                {item.suggested_action?.before ? <ArrowRight className="size-3.5 text-text-muted" aria-hidden /> : null}
                {item.suggested_action?.after ? <ChangeChip label="After" value={item.suggested_action.after} /> : null}
              </div>
            </div>
            <div className="surface-card bg-bg-surface p-2 text-text-muted">
              <p className="flex items-start gap-1.5">
                <Info className="mt-0.5 size-3.5 shrink-0" aria-hidden />
                Category: {meta.label} — {meta.description}
              </p>
            </div>
          </div>
        </div>
      ) : null}
    </article>
  );
}

function ChangeChip({ label, value }: { label: string; value: string }) {
  return (
    <span className="surface-card inline-flex items-center gap-1 bg-bg-elevated px-2 py-0.5">
      <span className="text-xs uppercase tracking-wide text-text-muted">{label}</span>
      <span className="text-xs font-medium tabular-nums text-text-primary">{value}</span>
    </span>
  );
}
