<file path="src/components/student/home/TodayStatus.tsx">
"use client";

import { useMemo } from "react";
import { LogIn, LogOut, Clock } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { useAuthStore } from "@/stores/authStore";
import { getTimeAgo } from "@/lib/utils";
import { Skeleton } from "@/components/ui/skeleton";

interface DashboardPayload {
  lastScan: { direction: "IN" | "OUT"; gateName: string; timestamp: string } | null;
  curfew: { today: { score: number; late: number } };
  activePasses: Array<{ id: string }>;
}

function greeting(): string {
  const h = new Date().getHours();
  if (h < 12) return "Good morning";
  if (h < 17) return "Good afternoon";
  return "Good evening";
}

export function TodayStatus() {
  const user = useAuthStore((s) => s.user);
  const { data, loading } = useApiResource<DashboardPayload>("/api/student/dashboard", {
    ttlMs: 30_000,
  });

  const state = useMemo(() => {
    if (!data?.lastScan) return { label: "No scans today", tone: "neutral" as const, Icon: Clock };
    if (data.lastScan.direction === "IN")
      return { label: "Inside campus", tone: "in" as const, Icon: LogIn };
    return { label: "Outside campus", tone: "out" as const, Icon: LogOut };
  }, [data]);

  if (loading) return <Skeleton className="h-24 w-full rounded-2xl" />;

  const time = data?.lastScan ? getTimeAgo(data.lastScan.timestamp) : "—";

  return (
    <div className="surface-card bg-bg-surface p-4">
      <p className="text-sm text-text-secondary">{greeting()},</p>
      <h1 className="text-xl font-semibold text-text-primary">
        {user?.name ?? "Student"}
      </h1>
      <div className="mt-3 flex items-center gap-2">
        <state.Icon
          className={`h-5 w-5 ${
            state.tone === "in"
              ? "text-action-success"
              : state.tone === "out"
                ? "text-alert-warning"
                : "text-text-muted"
          }`}
          aria-hidden
        />
        <span className="text-base font-medium text-text-primary">
          {state.label}
        </span>
        {data?.lastScan && (
          <span className="text-sm text-text-muted">
            · last scan {time}
          </span>
        )}
      </div>
      {/* The panel's #1 pain was "no clear curfew/campus-allowed view." The
          dashboard already fetches curfew data — surface it here so a student
          can tell at a glance whether they're in good standing, instead of
          hunting the sub-routes. */}
      {data?.curfew?.today && (
        <div className="mt-3 flex items-center justify-between rounded-lg bg-bg-elevated/40 px-3 py-2 text-sm">
          <span className="text-text-secondary">Curfew status</span>
          <span
            className={
              data.curfew.today.late > 0
                ? "font-medium text-action-warning"
                : "font-medium text-action-success"
            }
          >
            {data.curfew.today.late > 0
              ? `${data.curfew.today.late} late return${data.curfew.today.late > 1 ? "s" : ""} this week`
              : "On time"}
          </span>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/student/widgets/attendance.tsx">
"use client";

import { useState } from "react";
import {
  CalendarDays,
  Clock,
  AlertCircle,
  ChevronRight,
  Percent,
  TrendingUp,
  TrendingDown,
  FileDown,
} from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { usePeriod } from "@/hooks/usePeriod";
import { useExport } from "@/hooks/useExport";
import { cn } from "@/lib/utils";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { RaiseIssueButton } from "@/components/shared/RaiseIssueButton";
import { ScheduleStrip, type ScheduleItem } from "@/components/shared/ScheduleStrip";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import type { StudentWidgetProps } from "./index";

// ── Types ──────────────────────────────────────────────────────────────────

interface AttendancePayload {
  data: {
    period: string;
    range: { from: string; to: string };
    summary: {
      total: number;
      present: number;
      absent: number;
      unmarked: number;
      pct: number;
      lastMonthPct: number | null;
      delta: number | null;
    };
    subjects: Array<{
      classId: string | null;
      present: number;
      absent: number;
      total: number;
      pct: number;
      avgTimeMinutes: number;
    }>;
    disputes: Array<{
      id: string;
      date: string;
      reason: string;
      status: string;
      createdAt: string;
      resolvedAt: string | null;
    }>;
    upcoming: Array<{
      date: string;
      subject: string;
      faculty: string;
      timeIn: string | null;
      timeOut: string | null;
    }>;
  };
}

// ── Main widget ────────────────────────────────────────────────────────────

export default function AttendanceCard({ payload }: StudentWidgetProps) {
  const { period, setPeriod } = usePeriod("this-month");
  const { exportCSV } = useExport();

  const { data, loading, refresh } = useApiResource<AttendancePayload>(
    `/api/student/attendance?period=${period.key === "all-time" ? "all-time" : period.key}`,
    { ttlMs: 30_000, deps: [period.key] }
  );

  const [disputeDate, setDisputeDate] = useState("");
  const [disputeOpen, setDisputeOpen] = useState(false);

  const d = data?.data;

  const handleDisputeSubmit = async (reason: string, category?: string) => {
    const res = await fetch("/api/student/attendance/dispute", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        date: disputeDate,
        reason: category ? `${category}: ${reason}` : reason,
      }),
    });
    if (!res.ok) throw new Error("Failed to raise dispute");
    setDisputeOpen(false);
    setDisputeDate("");
    void refresh();
  };

  const scheduleItems: ScheduleItem[] = (d?.upcoming ?? []).map((u) => ({
    id: u.date,
    title: u.subject,
    subtitle: u.faculty,
    start: `${u.date}T${u.timeIn ?? "09:00:00"}`,
    end: `${u.date}T${u.timeOut ?? "10:00:00"}`,
  }));

  const handleExport = () => {
    if (!d) return;
    exportCSV(
      [
        { date: d.range.from, status: `period=${d.period}`, present: d.summary.present, absent: d.summary.absent },
        ...d.subjects.map((s) => ({
          date: d.range.from,
          status: `subject=${s.classId ?? "—"}`,
          present: s.present,
          absent: s.absent,
        })),
      ],
      [
        { key: "date", header: "Date" },
        { key: "status", header: "Item" },
        { key: "present", header: "Present" },
        { key: "absent", header: "Absent" },
      ],
      `attendance_${d.period}.csv`
    );
  };

  return (
    <WidgetBoundary name="AttendanceCard" resetKey={period.key}>
      <div className="surface-card p-5 space-y-5">
        {/* Header row */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <div className="p-2 bg-action-primary/10 text-action-primary">
              <CalendarDays className="h-4 w-4" />
            </div>
            <div>
              <h3 className="text-sm font-semibold text-text-primary">Attendance</h3>
              <p className="text-xs text-text-muted">{d?.range.from ?? "Loading…"}</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
            <RaiseIssueButton
              label="Dispute"
              categories={["I was present", "Wrong mark", "Forgot to mark"]}
              onSubmit={handleDisputeSubmit}
              className="text-xs"
            />
          </div>
        </div>

        {/* Period picker */}
        <PeriodPicker value={period} onChange={setPeriod} allowCustom={false} />

        {loading && !d ? (
          <div className="space-y-3">
            <Skeleton className="h-16 rounded-xl" />
            <Skeleton className="h-24 rounded-xl" />
          </div>
        ) : !d ? (
          <EmptyState title="No attendance data" description="Nothing recorded for this period yet." />
        ) : (
          <>
            {/* Big percentage + delta */}
            <div className="flex items-center gap-4">
              <div className="flex items-baseline gap-1">
                <Percent className="h-5 w-5 text-action-primary" />
                <span className="text-3xl font-bold text-text-primary tabular-nums">{d.summary.pct}%</span>
              </div>
              <DeltaBadge
                value={d.summary.pct}
                reference={d.summary.lastMonthPct}
                label="vs last month"
              />
              <div className="ml-auto text-xs text-text-muted tabular-nums">
                {d.summary.present} present · {d.summary.absent} absent · {d.summary.unmarked} unmarked
              </div>
            </div>

            {/* Upcoming schedule */}
            {scheduleItems.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">Upcoming</p>
                <ScheduleStrip items={scheduleItems} />
              </div>
            )}

            {/* Subject breakdown */}
            {d.subjects.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">By class</p>
                <div className="space-y-2">
                  {d.subjects.map((s) => (
                    <div
                      key={s.classId ?? "misc"}
                      className="flex items-center justify-between text-sm rounded-lg bg-bg-elevated px-3 py-2"
                    >
                      <span className="text-text-secondary truncate max-w-[8rem]">
                        {s.classId ?? "General"}
                      </span>
                      <div className="flex items-center gap-3 text-xs tabular-nums">
                        <span className="text-emerald-500">{s.present}p</span>
                        <span className="text-rose-500">{s.absent}a</span>
                        <span className={cn("font-medium", s.pct >= 75 ? "text-emerald-500" : s.pct >= 60 ? "text-amber-500" : "text-rose-500")}>
                          {s.pct}%
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Open disputes */}
            {d.disputes.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">Open disputes</p>
                <div className="space-y-1.5">
                  {d.disputes.slice(0, 3).map((dsp) => (
                    <div key={dsp.id} className="flex items-center gap-2 text-xs bg-rose-500/5 px-3 py-2">
                      <AlertCircle className="h-3.5 w-3.5 text-rose-500 shrink-0" />
                      <span className="text-text-secondary truncate flex-1">{dsp.reason}</span>
                      <span className="text-text-muted shrink-0 tabular-nums">{dsp.date}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export type { AttendancePayload };
</file>

<file path="src/components/student/widgets/curfew.tsx">
"use client";
import { motion } from "framer-motion";
import { TrendingUp, TrendingDown, Minus } from "lucide-react";
import type { StudentWidgetProps } from "./index";

export interface CurfewPayload {
  today: { score: number; onTime: number; late: number; violations: number };
  thirtyDayAvg: number;
  thirtyDayLate: number;
  trend: "up" | "down" | "flat";
}

export default function CurfewCard({ payload }: StudentWidgetProps) {
  const data = payload.curfew as CurfewPayload;
  if (!data) return null;
  const { score } = data.today;
  const ring = score >= 90 ? "text-action-success" : score >= 70 ? "text-action-warning" : "text-action-danger";
  const TrendIcon = data.trend === "up" ? TrendingUp : data.trend === "down" ? TrendingDown : Minus;
  const trendColor = data.trend === "up" ? "text-action-success" : data.trend === "down" ? "text-action-danger" : "text-text-muted";
  const circ = 2 * Math.PI * 40;
  const off = circ * (1 - score / 100);

  return (
    <article className="surface-card bg-bg-surface p-5">
      <header className="mb-4 flex items-center justify-between">
        <h3 className="text-sm font-semibold">Curfew Score</h3>
        <span className={`flex items-center gap-1 text-xs ${trendColor}`}>
          <TrendIcon className="h-3.5 w-3.5" />
          {data.trend === "flat" ? "stable" : `${Math.abs(data.today.score - data.thirtyDayAvg)} pts`}
        </span>
      </header>
      <div className="flex items-center gap-5">
        <svg viewBox="0 0 100 100" className={`h-24 w-24 -rotate-90 ${ring}`}>
          <circle cx="50" cy="50" r="40" stroke="currentColor" strokeOpacity="0.15" strokeWidth="8" fill="none" />
          <motion.circle cx="50" cy="50" r="40" stroke="currentColor" strokeWidth="8" fill="none"
            strokeLinecap="round" strokeDasharray={circ}
            initial={{ strokeDashoffset: circ }} animate={{ strokeDashoffset: off }}
            transition={{ duration: 0.9, ease: "easeOut" }} />
        </svg>
        <div>
          <p className="text-3xl font-semibold tabular-nums">{score}</p>
          <p className="text-xs text-text-muted">30-day avg {data.thirtyDayAvg}</p>
        </div>
      </div>
      <dl className="mt-4 grid grid-cols-3 gap-2 text-center">
        <div className="surface-card py-2">
          <dt className="text-xs uppercase text-text-muted">On time</dt>
          <dd className="text-sm font-semibold text-action-success tabular-nums">{data.today.onTime}</dd>
        </div>
        <div className="surface-card py-2">
          <dt className="text-xs uppercase text-text-muted">Late</dt>
          <dd className="text-sm font-semibold text-action-warning tabular-nums">{data.today.late}</dd>
        </div>
        <div className="surface-card py-2">
          <dt className="text-xs uppercase text-text-muted">Violations</dt>
          <dd className="text-sm font-semibold text-action-danger tabular-nums">{data.today.violations}</dd>
        </div>
      </dl>
    </article>
  );
}
</file>

<file path="src/components/student/widgets/index.tsx">
"use client";
import { Suspense, lazy } from "react";
import { RefreshCw } from "lucide-react";
import { Skeleton } from "@/components/ui/skeleton";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { useApiResource } from "@/hooks/useApiResource";
import { STUDENT_WIDGETS } from "@/lib/student-widgets";
import { EmptyState } from "@/components/shared/EmptyState";

// Every card receives the full API payload and picks its slice.
export interface StudentWidgetProps {
  payload: Record<string, unknown>;
}

const CARDS: Record<string, React.LazyExoticComponent<React.ComponentType<StudentWidgetProps>>> = {
  "lastscan": lazy(() => import("./lastscan")),
  "passes": lazy(() => import("./passes")),
  "monthly": lazy(() => import("./monthly")),
  "curfew": lazy(() => import("./curfew")),
  "attendance": lazy(() => import("./attendance")),
  // SCAFFOLD:CARDS — cards are injected above this line
};

export function StudentDashboardWidgets() {
  const { data, loading, error, refresh } = useApiResource<Record<string, unknown>>(
    "/api/student/dashboard",
    { ttlMs: 20_000 }
  );

  if (loading && !data) {
    return (
      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {STUDENT_WIDGETS.map((w) => (
          <Skeleton key={w.id} className="h-56 rounded-2xl" />
        ))}
      </div>
    );
  }

  if (error) {
    return (
      <div className="surface-card bg-rose-500/5 p-4 text-sm text-rose-600 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p>Could not load dashboard: {error}</p>
        <button
          type="button"
          onClick={() => void refresh()}
          className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 bg-rose-500/10 text-rose-600 text-xs font-bold hover:bg-rose-500/20 transition self-start sm:self-auto"
        >
          <RefreshCw className="size-3.5" /> Retry
        </button>
      </div>
    );
  }

  if (!data) {
    return <EmptyState title="No dashboard data" description="Try refreshing in a moment." />;
  }

  return (
    <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {STUDENT_WIDGETS
        .slice()
        .sort((a, b) => a.order - b.order)
        .map((w) => {
          const Card = CARDS[w.id];
          if (!Card) return null;
          return (
            <WidgetBoundary key={w.id} title={w.title}>
              <Suspense fallback={<Skeleton className="h-56 rounded-2xl" />}>
                <Card payload={data} />
              </Suspense>
            </WidgetBoundary>
          );
        })}
    </div>
  );
}
</file>

