<file path="src/components/nav/RoleCommandPalette.tsx">
"use client";

import React, { useEffect, useMemo, useState } from "react";
import { usePathname, useRouter } from "next/navigation";
import { Search, Clock, ArrowUpRight, X } from "lucide-react";
import { useAuthStore } from "@/stores/authStore";

interface QuickRoute {
  label: string;
  href: string;
  roles: string[];
  keywords?: string;
}

const ROLE_ROUTES: QuickRoute[] = [
  { label: "Student Home", href: "/student", roles: ["student", "cr", "student_representative"] },
  { label: "Attendance & Next Period", href: "/student/attendance", roles: ["student", "cr", "student_representative"] },
  { label: "Attendance Calendar", href: "/student/attendance-calendar", roles: ["student", "cr", "student_representative"] },
  { label: "My Calendar", href: "/student/calendar", roles: ["student", "cr", "student_representative"] },
  { label: "Gate Scan History", href: "/student/history", roles: ["student", "cr", "student_representative"] },
  { label: "Pass Hub", href: "/student/passes", roles: ["student", "cr", "student_representative"] },
  { label: "Mess Hub", href: "/student/mess", roles: ["student", "cr", "student_representative"] },
  { label: "Assignments", href: "/student/assignments", roles: ["student", "cr", "student_representative"] },
  { label: "Profile & Security", href: "/student/profile-security", roles: ["student", "cr", "student_representative"] },
  { label: "Principal Command Center", href: "/principal", roles: ["principal"] },
  { label: "Principal Approvals", href: "/principal/approvals/pending", roles: ["principal"] },
  { label: "Principal Delegations", href: "/principal/governance/delegations", roles: ["principal"] },
  { label: "Principal Gates", href: "/principal/operations/gates", roles: ["principal"] },
  { label: "Principal Profile", href: "/principal/profile", roles: ["principal"] },
  { label: "HOD Approvals", href: "/hod/approvals", roles: ["hod"] },
  { label: "HOD Classes", href: "/hod/classes", roles: ["hod"] },
  { label: "VP Approvals", href: "/vice-principal/approvals", roles: ["vice_principal"] },
  { label: "Operator Lookup", href: "/operator/lookup", roles: ["operator"] },
  { label: "Operator Profile", href: "/operator/profile", roles: ["operator"] },
  { label: "Admin Attendance", href: "/admin/attendance", roles: ["admin", "sysadmin"] },
  { label: "Admin Profile", href: "/admin/profile", roles: ["admin"] },
  { label: "SysAdmin Sessions", href: "/sysadmin/sessions", roles: ["sysadmin"] },
  { label: "SysAdmin Gate Schedule", href: "/sysadmin/gate-schedule", roles: ["sysadmin", "admin"] },
  { label: "SysAdmin Profile", href: "/sysadmin/profile", roles: ["sysadmin"] },
  { label: "Guardian Visit Schedule", href: "/guardian/visit-schedule", roles: ["guardian", "parent"] },
];

const RECENT_KEY = "role_cmd_recent_routes_v1";

export function RoleCommandPalette() {
  const router = useRouter();
  const pathname = usePathname();
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "").toLowerCase();

  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState("");
  const [recent, setRecent] = useState<Array<{ label: string; href: string }>>([]);

  useEffect(() => {
    if (typeof window === "undefined") return;
    try {
      const raw = window.localStorage.getItem(RECENT_KEY);
      if (raw) setRecent(JSON.parse(raw));
    } catch {
      // ignore
    }
  }, []);

  useEffect(() => {
    if (!pathname || pathname.startsWith("/login")) return;
    const match = ROLE_ROUTES.find((r) => r.href === pathname);
    if (!match) return;
    setRecent((prev) => {
      const next = [
        { label: match.label, href: match.href },
        ...prev.filter((p) => p.href !== match.href),
      ].slice(0, 4);
      if (typeof window !== "undefined") {
        window.localStorage.setItem(RECENT_KEY, JSON.stringify(next));
      }
      return next;
    });
  }, [pathname]);

  useEffect(() => {
    const onKeyDown = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        setOpen((v) => !v);
      } else if (e.key === "Escape") {
        setOpen(false);
      }
    };
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, []);

  const permitted = useMemo(() => {
    if (!role) return [];
    return ROLE_ROUTES.filter((r) => r.roles.includes(role));
  }, [role]);

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return permitted;
    return permitted.filter(
      (r) =>
        r.label.toLowerCase().includes(q) ||
        r.href.toLowerCase().includes(q) ||
        (r.keywords ?? "").toLowerCase().includes(q),
    );
  }, [permitted, query]);

  if (!user || pathname?.startsWith("/login") || pathname?.startsWith("/gate/")) {
    return null;
  }

  const go = (href: string) => {
    setOpen(false);
    setQuery("");
    router.push(href);
  };

  return (
    <>
      <button
        type="button"
        data-testid="role-command-trigger"
        onClick={() => setOpen(true)}
        className="fixed bottom-4 left-4 z-40 hidden sm:inline-flex items-center gap-2 rounded-full border border-border bg-bg-surface/95 px-2.5 py-1.5 text-xs font-medium text-text-muted shadow-md backdrop-blur hover:border-action-primary hover:text-text-primary"
      >
        <Search className="h-3.5 w-3.5" />
        <span>Quick Jump</span>
        <kbd className="border border-border bg-bg-elevated px-1.5 py-0.5 font-mono text-[10px]">
          ⌘K
        </kbd>
      </button>

      {open && (
        <div
          data-testid="role-command-palette"
          className="fixed inset-0 z-50 flex items-start justify-center bg-black/50 p-4 pt-20 backdrop-blur-xs"
          onClick={() => setOpen(false)}
        >
          <div
            className="surface-card w-full max-w-lg overflow-hidden bg-bg-surface shadow-2xl"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="flex items-center gap-2 border-b border-border px-3 py-2.5">
              <Search className="h-4 w-4 text-text-muted shrink-0" />
              <input
                autoFocus
                type="text"
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder={`Jump to ${role} pages...`}
                className="w-full bg-transparent text-sm text-text-primary placeholder:text-text-muted focus:outline-none"
              />
              <button
                type="button"
                onClick={() => setOpen(false)}
                className="rounded p-1 text-text-muted hover:text-text-primary"
                aria-label="Close quick jump"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            <div className="max-h-80 overflow-y-auto p-2 space-y-3">
              {!query && recent.length > 0 && (
                <div className="space-y-1">
                  <p className="px-2 text-[10px] font-semibold uppercase tracking-wider text-text-muted">
                    Recent
                  </p>
                  {recent.map((item) => (
                    <button
                      key={item.href}
                      type="button"
                      onClick={() => go(item.href)}
                      className="flex w-full items-center justify-between rounded-lg px-2.5 py-2 text-left text-xs font-medium text-text-primary hover:bg-bg-elevated"
                    >
                      <span className="inline-flex items-center gap-2">
                        <Clock className="h-3.5 w-3.5 text-text-muted" />
                        <span>{item.label}</span>
                      </span>
                      <span className="font-mono text-[11px] text-text-muted">
                        {item.href}
                      </span>
                    </button>
                  ))}
                </div>
              )}

              <div className="space-y-1">
                <p className="px-2 text-[10px] font-semibold uppercase tracking-wider text-text-muted">
                  Permitted Routes ({filtered.length})
                </p>
                {filtered.map((item) => (
                  <button
                    key={item.href}
                    type="button"
                    onClick={() => go(item.href)}
                    className="flex w-full items-center justify-between rounded-lg px-2.5 py-2 text-left text-xs font-medium text-text-primary hover:bg-bg-elevated"
                  >
                    <span>{item.label}</span>
                    <span className="inline-flex items-center gap-1 font-mono text-[11px] text-text-muted">
                      <span>{item.href}</span>
                      <ArrowUpRight className="h-3 w-3" />
                    </span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      )}
    </>
  );
}
</file>

<file path="src/components/nav/RoleProfileSettingsPanel.tsx">
"use client";

import React, { useState } from "react";
import Link from "next/link";
import { SlidersHorizontal, ArrowUpRight, Clock } from "lucide-react";
import {
  getOccasionalProfileSettings,
  type OccasionalSettingItem,
} from "@/lib/role-profile-settings";
import { useIsSakuga } from "@/components/student/useIsSakuga";
import { useUIStore } from "@/stores/uiStore";
import { useUnsavedChangesGuard } from "@/hooks/useUnsavedChangesGuard";
import { UnsavedChangesBar } from "@/components/shared/UnsavedChangesBar";

export function RoleProfileSettingsPanel({
  role,
  storagePrefix = "role_profile_pref",
}: {
  role: string | undefined;
  storagePrefix?: string;
}) {
  const isSakuga = useIsSakuga();
  const addToast = useUIStore((s) => s.addToast);
  const items = getOccasionalProfileSettings(role);
  const loadSaved = () => {
    const initial: Record<string, string | boolean> = {};
    for (const item of items) {
      if (item.defaultValue !== undefined) {
        initial[item.id] = item.defaultValue;
      }
      if (typeof window !== "undefined") {
        const saved = window.localStorage.getItem(
          `${storagePrefix}:${role ?? "default"}:${item.id}`,
        );
        if (saved !== null) {
          initial[item.id] =
            saved === "true" ? true : saved === "false" ? false : saved;
        }
      }
    }
    return initial;
  };
  const [values, setValues] = useState<Record<string, string | boolean>>(loadSaved);
  const [dirty, setDirty] = useState(false);
  useUnsavedChangesGuard(dirty);

  const updateValue = (id: string, next: string | boolean) => {
    setValues((prev) => ({ ...prev, [id]: next }));
    setDirty(true);
  };

  const handleSave = () => {
    if (typeof window !== "undefined") {
      for (const [id, val] of Object.entries(values)) {
        window.localStorage.setItem(
          `${storagePrefix}:${role ?? "default"}:${id}`,
          String(val),
        );
      }
    }
    setDirty(false);
    addToast({
      variant: "success",
      title: "Settings Saved",
      message: "Role preferences updated.",
    });
  };

  const handleDiscard = () => {
    setValues(loadSaved());
    setDirty(false);
  };

  return (
    <section
      data-testid="role-occasional-settings"
      className="surface-card p-4 space-y-4"
    >
      <div className="flex items-center justify-between gap-2 border-b border-border pb-3">
        <div className="flex items-center gap-2">
          <SlidersHorizontal className="h-3 w-3 text-action-primary" />
          <div>
            <h3 className="text-sm font-semibold text-text-primary">
              Occasional Role Settings
            </h3>
            <p className="text-xs text-text-muted">
              Tailored preferences for{" "}
              <span className="font-mono font-medium">{role ?? "user"}</span>
              —set when workflows, shifts, or semesters change.
            </p>
          </div>
        </div>
      </div>

      <UnsavedChangesBar
        hasUnsavedChanges={dirty}
        onSave={handleSave}
        onDiscard={handleDiscard}
      />

      <div className="divide-y divide-border">
        {items.map((item: OccasionalSettingItem) => {
          const val = values[item.id];
          return (
            <div
              key={item.id}
              className="py-3 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:items-center justify-between gap-3"
            >
              <div className="space-y-1 max-w-xl">
                <p className="text-sm font-medium text-text-primary">
                  {item.title}
                </p>
                <p className="text-xs text-text-muted">{item.description}</p>
                <p className="inline-flex items-center gap-1 text-[11px] text-amber-600 dark:text-amber-400">
                  <Clock className="h-3 w-3 shrink-0" />
                  <span>{item.whenToSet}</span>
                </p>
              </div>

              <div className="shrink-0">
                {item.controlType === "toggle" &&
                  (isSakuga ? (
                    <sakuga-toggle
                      checked={Boolean(val)}
                      label={item.title}
                      onChange={() => updateValue(item.id, !Boolean(val))}
                    />
                  ) : (
                    <button
                      type="button"
                      role="switch"
                      aria-checked={Boolean(val)}
                      onClick={() => updateValue(item.id, !Boolean(val))}
                      className={`inline-flex h-6 w-11 items-center rounded-full transition-colors p-0.5 ${
                        Boolean(val) ? "bg-action-primary" : "bg-bg-elevated"
                      }`}
                    >
                      <span
                        className={`h-5 w-5 rounded-full bg-bg-surface transition-transform ${
                          Boolean(val) ? "translate-x-5" : "translate-x-0"
                        }`}
                      />
                    </button>
                  ))}

                {item.controlType === "select" && item.options && (
                  <select
                    value={String(val ?? item.defaultValue ?? "")}
                    onChange={(e) => updateValue(item.id, e.target.value)}
                    className="rounded-lg border border-border bg-bg-base px-2.5 py-1.5 text-xs font-medium text-text-primary"
                  >
                    {item.options.map((opt) => (
                      <option key={opt.value} value={opt.value}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                )}

                {item.controlType === "link" && item.href && (
                  <Link
                    href={item.href}
                    className="inline-flex items-center gap-1 rounded-lg border border-border bg-bg-base px-2.5 py-1.5 text-xs font-medium text-text-primary hover:bg-bg-elevated transition-colors"
                  >
                    <span>Configure</span>
                    <ArrowUpRight className="h-3.5 w-3.5" />
                  </Link>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  );
}
</file>

<file path="src/components/nav/SakuraDualThemeControl.tsx">
"use client";

import React, { useEffect, useState } from "react";
import { Sun, Moon, Flower2, Sparkles } from "lucide-react";

export type ThemeFamily = "default" | "sakuga";
export type ColorPolarity = "light" | "dark";

const THEME_KEY = "app_theme_family";
const MODE_KEY = "app_color_polarity";

export function applyThemeToDom(family: ThemeFamily, mode: ColorPolarity) {
  if (typeof document === "undefined") return;
  const root = document.documentElement;
  root.setAttribute("data-theme", family);
  root.setAttribute("data-mode", mode);
  if (mode === "dark") {
    root.classList.add("dark");
  } else {
    root.classList.remove("dark");
  }
  if (family === "sakuga" && !document.querySelector('script[src^="/sakuga-vfx/"]')) {
    for (const name of ["button", "checkbox", "radio", "toggle", "progress", "tabs", "toast", "slider", "input", "rating", "tooltip"]) {
      const s = document.createElement("script");
      s.src = `/sakuga-vfx/${name}.js`;
      s.async = false;
      document.head.appendChild(s);
    }
  }
}

export function SakuraDualThemeControl() {
  const [family, setFamily] = useState<ThemeFamily>("default");
  const [mode, setMode] = useState<ColorPolarity>("light");
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    setMounted(true);
    const savedFamily =
      (window.localStorage.getItem(THEME_KEY) as ThemeFamily | null) ?? "default";
    const prefersDark = window.matchMedia?.("(prefers-color-scheme: dark)").matches;
    const savedMode =
      (window.localStorage.getItem(MODE_KEY) as ColorPolarity | null) ??
      (prefersDark ? "dark" : "light");

    setFamily(savedFamily);
    setMode(savedMode);
    applyThemeToDom(savedFamily, savedMode);
  }, []);

  const selectFamily = (nextFamily: ThemeFamily) => {
    setFamily(nextFamily);
    window.localStorage.setItem(THEME_KEY, nextFamily);
    applyThemeToDom(nextFamily, mode);
  };

  const selectMode = (nextMode: ColorPolarity) => {
    setMode(nextMode);
    window.localStorage.setItem(MODE_KEY, nextMode);
    applyThemeToDom(family, nextMode);
  };

  if (!mounted) return null;

  return (
    <div
      data-testid="sakura-dual-theme-control"
      className="surface-card bg-bg-surface p-3.5 flex flex-wrap items-center justify-between gap-3"
    >
      <div className="space-y-0.5">
        <p className="text-sm font-semibold text-text-primary flex items-center gap-1.5">
          <Flower2 className="h-4 w-4 text-action-primary" />
          <span>Theme &amp; Polarity</span>
        </p>
        <p className="text-xs text-text-muted">
          Switch between Default and Sakura themes in Light or Dark mode.
        </p>
      </div>

      <div className="flex flex-wrap items-center gap-2">
        <div className="surface-card inline-flex bg-bg-elevated p-0.5 text-xs">
          <button
            type="button"
            onClick={() => selectFamily("default")}
            className={`inline-flex items-center gap-1 rounded-md px-2.5 py-1 font-medium transition-colors ${
              family === "default"
                ? "bg-action-primary text-white"
                : "text-text-muted hover:text-text-primary"
            }`}
          >
            <Sparkles className="h-3.5 w-3.5" />
            <span>Default</span>
          </button>
          <button
            type="button"
            onClick={() => selectFamily("sakuga")}
            className={`inline-flex items-center gap-1 rounded-md px-2.5 py-1 font-medium transition-colors ${
              family === "sakuga"
                ? "bg-action-primary text-white"
                : "text-text-muted hover:text-text-primary"
            }`}
          >
            <Flower2 className="h-3.5 w-3.5" />
            <span>Sakuga</span>
          </button>
        </div>

        <div className="surface-card inline-flex bg-bg-elevated p-0.5 text-xs">
          <button
            type="button"
            onClick={() => selectMode("light")}
            className={`inline-flex items-center gap-1 rounded-md px-2.5 py-1 font-medium transition-colors ${
              mode === "light"
                ? "bg-action-primary text-white"
                : "text-text-muted hover:text-text-primary"
            }`}
          >
            <Sun className="h-3.5 w-3.5" />
            <span>Light</span>
          </button>
          <button
            type="button"
            onClick={() => selectMode("dark")}
            className={`inline-flex items-center gap-1 rounded-md px-2.5 py-1 font-medium transition-colors ${
              mode === "dark"
                ? "bg-action-primary text-white"
                : "text-text-muted hover:text-text-primary"
            }`}
          >
            <Moon className="h-3.5 w-3.5" />
            <span>Dark</span>
          </button>
        </div>
      </div>
    </div>
  );
}
