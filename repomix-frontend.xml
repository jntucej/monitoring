<file path="src/app/(sysadmin)/sysadmin/devices/page.tsx">
"use client";


import React, { useState, useCallback, useEffect } from "react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";

import { Badge } from "@/components/ui/badge";
import { useUIStore } from "@/stores/uiStore";
import { cn, formatDate } from "@/lib/utils";
import { useApi } from "@/hooks/useApi";
import {
  Cpu,
  Fingerprint,
  ScanFace,
  ScanBarcode,
  QrCode,
  AlertTriangle,
  CheckCircle2,
  XCircle,
  Globe,
  ShieldCheck,
} from "lucide-react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface DeviceSetting {
  id?: string;
  device_type: "thumb" | "face" | "barcode" | "qr";
  enabled: boolean;
  scope: string;
  scope_id?: string | null;
  created_at?: string;
  updated_at?: string;
}

interface DeviceConfig {
  type: "thumb" | "face" | "barcode" | "qr";
  name: string;
  icon: typeof Fingerprint;
  description: string;
  accentColor: string;
}

const DEVICE_CONFIGS: DeviceConfig[] = [
  {
    type: "thumb",
    name: "Thumbprint Biometrics",
    icon: Fingerprint,
    description: "Biometric fingerprint scanner at entry/exit turnstiles for student and staff identity validation.",
    accentColor: "bg-action-success/20 text-action-success border-action-success/30",
  },
  {
    type: "face",
    name: "Facial Recognition Gate",
    icon: ScanFace,
    description: "AI optical facial scan camera for contactless gate passage and instant turnstile unlock.",
    accentColor: "bg-action-primary/20 text-action-primary border-action-primary/30",
  },
  {
    type: "barcode",
    name: "Barcode Scanner",
    icon: ScanBarcode,
    description: "Laser barcode reader for student physical ID card barcode verification and express pass checkout.",
    accentColor: "bg-unit-c/20 text-unit-c border-unit-c/30",
  },
  {
    type: "qr",
    name: "QR Code Scanner",
    icon: QrCode,
    description: "Dynamic high-density optical QR scanner for mobile digital passes and guest permits.",
    accentColor: "bg-action-warning/20 text-action-warning border-action-warning/30",
  },
];
export default function SysadminDevicesPage() {
const api = useApi();

  const { addToast } = useUIStore();
  const [settings, setSettings] = useState<Record<string, DeviceSetting>>({});
  const [loading, setLoading] = useState(true);
  const [updatingType, setUpdatingType] = useState<string | null>(null);

  const fetchSettings = useCallback(async () => {
    try {
      const res = await fetch("/api/admin/device-settings", {
        headers: api.getHeaders(),
      });
      if (!res.ok) throw new Error("Failed to load device settings");
      const json = await res.json();
      if (json.success && Array.isArray(json.data)) {
        const map: Record<string, DeviceSetting> = {};
        for (const item of json.data) {
          map[item.device_type] = item;
        }
        setSettings(map);
      }
    } catch {
      addToast({ variant: "error", message: "Failed to load device settings." });
    } finally {
      setLoading(false);
    }
  }, [addToast]);

  useEffect(() => { fetchSettings(); }, [fetchSettings]);

  const handleToggle = async (config: DeviceConfig) => {
    const current = settings[config.type] || {
      device_type: config.type,
      enabled: false,
      scope: "global",
    };
    const targetState = !current.enabled;
    const targetId = current.id || config.type;

    setUpdatingType(config.type);
    try {
      const res = await fetch(`/api/admin/device-settings/${targetId}`, {
        method: "PATCH",
        headers: api.getHeaders(),
        body: JSON.stringify({
          enabled: targetState,
          scope: current.scope || "global",
        }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) {
        throw new Error(json.error?.message || "Failed to update device setting");
      }

      setSettings((prev) => ({
        ...prev,
        [config.type]: {
          ...current,
          ...json.data,
          enabled: targetState,
        },
      }));

      addToast({
        variant: "success",
        message: `${config.name} verification ${targetState ? "enabled" : "disabled"}.`,
      });
    } catch (err: unknown) {
      addToast({
        variant: "error",
        message: (err as Error).message || "Failed to toggle setting.",
      });
    } finally {
      setUpdatingType(null);
    }
  };

  return (
    <AuthGuard allowedRoles={["sysadmin", "admin"]}>
      <div className="space-y-6 max-w-7xl mx-auto p-4 md:p-6">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Gate Hardware & Device Verification"
        purpose="Configure supported biometric authentication modes (fingerprint, facial recognition, QR, barcode) across gate turnstiles."
        statusSummary={`${Object.values(settings).filter((s: { enabled?: boolean }) => s.enabled).length} authentication modes active across ${Object.keys(settings).length} configured hardware verification modalities.`}
        why="Device authentication rules enforce institutional multi-factor verification standards at physical barrier turnstiles."
        primaryAction={{ label: "Gate Schedule", href: "/sysadmin/gate-schedule" }}
        secondaryAction={{ label: "Docker Services", href: "/sysadmin/docker-services" }}
      />
        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <p className="text-2xl font-bold text-text-primary flex items-center gap-2">
              <Cpu className="w-6 h-6 text-action-primary" />
              Device Verification Settings
            </p>
            <p className="text-sm text-text-secondary mt-1">
              Configure automated gate turnstile and device scan verification methods across campus.
             </p>
           </div>
         </div>

        <div className="surface-card bg-amber-500/10 p-4 flex items-start gap-3.5">
          <AlertTriangle className="w-5 h-5 text-action-warning shrink-0 mt-0.5" />
          <div>
            <h3 className="text-sm font-semibold text-action-warning">Hardware Readiness Notice</h3>
            <p className="text-xs text-amber-700/80 mt-0.5 leading-relaxed">
              Enable only when corresponding hardware is installed and tested.
            </p>
          </div>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
          {DEVICE_CONFIGS.map((config) => {
            const Icon = config.icon;
            const current = settings[config.type] || {
              device_type: config.type,
              enabled: false,
              scope: "global",
            };
            const isEnabled = !!current.enabled;
            const isBusy = updatingType === config.type;

            return (
              <Card
                key={config.type}
                className={cn(
                  "relative transition-all duration-200 border bg-bg-surface hover:border-[var(--primary)]/40",
                  isEnabled
                    ? "shadow-[0_0_20px_rgba(16,185,129,0.06)]"
                    : "border-border"
                )}
              >
                <CardHeader className="pb-3">
                  <div className="flex items-start justify-between gap-4">
                    <div className="flex items-center gap-3">
                      <div className={cn("p-2.5 rounded-card", config.accentColor)}>
                        <Icon className="w-6 h-6" />
                      </div>
                      <div>
                        <CardTitle className="text-base text-text-primary font-semibold">
                          {config.name}
                        </CardTitle>
                        <p className="text-xs text-text-muted font-mono mt-0.5">
                          type: {config.type}
                        </p>
                      </div>
                    </div>

                    <Badge
                      variant={isEnabled ? "success" : "offline"}
                      className="px-2.5 py-1 text-xs font-bold tracking-wide uppercase flex items-center gap-1.5"
                    >
                      {isEnabled ? (
                        <>
                          <CheckCircle2 className="w-3.5 h-3.5 text-action-success" />
                          ENABLED
                        </>
                      ) : (
                        <>
                          <XCircle className="w-3.5 h-3.5 text-text-muted" />
                          DISABLED
                        </>
                      )}
                    </Badge>
                  </div>
                </CardHeader>

                <CardContent className="space-y-4 pt-0">
                  <p className="text-xs text-text-secondary leading-relaxed min-h9">
                    {config.description}
                  </p>

                  <div className="surface-card flex items-center justify-between pt-3">
                    <div className="flex items-center gap-2">
                      <span className="surface-card inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-bg-elevated text-text-secondary">
                        <Globe className="size-3.5" />
                        Scope: {current.scope || "Global"}
                      </span>
                      {current.updated_at && (
                        <span className="text-xs text-text-muted">
                          Synced {formatDate(current.updated_at)}
                        </span>
                      )}
                    </div>

                    <button
                      type="button"
                      role="switch"
                      aria-checked={isEnabled}
                      disabled={isBusy || loading}
                      onClick={() => handleToggle(config)}
                      className={cn(
                        "relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ringfocus-ring disabled:cursor-not-allowed disabled:opacity-50",
                        isEnabled ? "bg-action-success" : "bg-bg-elevated border-border"
                      )}
                    >
                      <span className="sr-only">Toggle {config.name}</span>
                      <span
                        aria-hidden="true"
                        className={cn(
                          "pointer-events-none inline-block h-5 w-5 transform rounded-full shadow ring-0 transition duration-200 ease-in-out",
                          isEnabled ? "translate-x-5" : "translate-x-0"
                        )}
                      />
                    </button>
                  </div>
                </CardContent>
              </Card>
            );
          })}
        </div>

        <div className="surface-card p-4 bg-bg-elevated/50 flex items-center gap-3">
          <ShieldCheck className="w-5 h-5 text-action-primary shrink-0" />
          <p className="text-xs text-text-muted">
            Device toggle mutations are protected with system administrator zero-trust RBAC and immutable telemetry audit logging.
          </p>
        </div>
      </div>
    </AuthGuard>
  );
}
</file>

<file path="src/app/(sysadmin)/sysadmin/docker-services/page.tsx">
"use client";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { DockerFleetPanel } from "@/components/sysadmin/monitoring/DockerFleetPanel";
import { AlertTriangle, Container } from "lucide-react";
import { SysAdminGroupTrace } from "@/components/nav/level4/SysAdminGroupTrace";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface ServicesData {
  status?: string;
  services?: Record<string, unknown>;
  redis?: { status: string };
  database?: { status: string; latencyMs: number };
  gateways?: { status: string; online: number; offline: number; total: number };
  containers: Array<{
    name: string;
    running: boolean;
    cpuPercent: number;
    memoryBytes: number;
    restartsLastHour: number;
  }> | null;
  containersError?: string | null;
  servicesError?: string;
}

function formatBytes(n: number): string {
  if (n <= 0) return "0";
  if (n < 1024 * 1024) return `${Math.round(n / 1024)} KB`;
  if (n < 1024 * 1024 * 1024) return `${(n / (1024 * 1024)).toFixed(1)} MB`;
  return `${(n / (1024 * 1024 * 1024)).toFixed(1)} GB`;
}

function DockerServicesInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "sysadmin") as Role;

  const { data, loading, error, refresh } = useApiResource<
    { success: boolean; data: ServicesData }
  >("/api/sysadmin/services", { ttlMs: 30_000 });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const d = (data as { success: boolean; data: ServicesData } | null)?.data;

  return (
    <div className="space-y-6 max-w-7xl mx-auto p-4 sm:p-6 min-w-0">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Docker Fleet & Container Health"
        purpose="Monitor Docker container liveness, CPU and memory usage, crash restarts, and app-level service health."
        statusSummary={`${d?.containers?.filter((c) => c.running).length ?? 0} of ${d?.containers?.length ?? 0} Docker containers currently running with liveness checks passing.`}
        why="Container infrastructure supports campus API backends, Redis workers, and real-time socket gateways; restarts indicate unhandled crashes."
        primaryAction={{ label: "Application Health", href: "/sysadmin/application-health" }}
        secondaryAction={{ label: "Database Health", href: "/sysadmin/database-health" }}
      />
      <div>
        <p className="text-2xl font-bold text-text-primary flex items-center gap-2">
          <Container className="w-6 h-6 text-action-danger" />
          Docker &amp; Service Status
        </p>
        <p className="text-xs text-text-muted mt-1">
          Container liveness and app-level service checks. Host-level Prometheus charts are in
          the fleet panel below.
        </p>
      </div>

      <div className="flex items-center justify-between">
        <p className="text-sm text-text-muted">
          Signed in as <span className="font-mono text-text-secondary">{role}</span>
        </p>
      </div>

      {/* L4 system & audit traces strip */}
      <SysAdminGroupTrace
        groupLabel="System & Audit Traces"
        links={[
          { label: "Docker Containers", href: "/sysadmin/docker-services" },
          { label: "PostgreSQL Database", href: "/sysadmin/database-health" },
          { label: "Redis Worker", href: "/sysadmin/redis-worker" },
          { label: "Audit Logs", href: "/sysadmin/audit" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning">
          <AlertTriangle className="w-4 h-4 inline mr-2" />
          Service status unavailable: {error}
        </div>
      )}

      {/* App-level service + container summary */}
      <WidgetBoundary title="Services & Containers">
        <div className="bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex items-center justify-between">
            <span className="text-sm font-semibold text-white">Service &amp; Container Status</span>
            <span
              className={`text-xs font-bold px-2 py-0.5 "healthy" "text-action-success" "degraded" "text-action-warning" "text-text-muted" "healthy" "text-action-success" "degraded" "text-action-warning" "text-text-muted"`}
            >
              {d?.status ?? "loading"}
            </span>
          </div>

          {busy ? (
            <div className="p-4 space-y-2">
              {Array.from({ length: 4 }).map((_, i) => (
                <div key={i} className="h-10 animate-pulse bg-bg-elevated/40" />
              ))}
            </div>
          ) : (
            <div className="divide-y divide-slate-800/60 min-w-0">
              <div className="flex items-center justify-between px-4 py-3">
                <div>
                  <p className="text-sm font-medium text-text-secondary">PostgreSQL</p>
                  <p className="text-xs text-text-muted">
                    {d?.database ? `latency ${d.database.latencyMs} ms` : "latency n/a"}
                  </p>
                </div>
                <span
                  className={`text-xs font-bold px-2 py-0.5 "healthy" "text-action-success" "text-action-danger" "healthy" "text-action-success" "text-action-danger"`}
                >
                  {d?.database?.status ?? "unknown"}
                </span>
              </div>
              <div className="flex items-center justify-between px-4 py-3">
                <div>
                  <p className="text-sm font-medium text-text-secondary">Redis (cache)</p>
                  <p className="text-xs text-text-muted">shared cache layer</p>
                </div>
                <span
                  className={`text-xs font-bold px-2 py-0.5 "healthy" "text-action-success" "text-action-warning" "healthy" "text-action-success" "text-action-warning"`}
                >
                  {d?.redis?.status ?? "unknown"}
                </span>
              </div>
              <div className="flex items-center justify-between px-4 py-3">
                <div>
                  <p className="text-sm font-medium text-text-secondary">Gateways (edge nodes)</p>
                  <p className="text-xs text-text-muted">
                    {d?.gateways
                      ? `${d.gateways.online} online / ${d.gateways.offline} offline of ${d.gateways.total}`
                      : "no gateway data"}
                  </p>
                </div>
                <span
                  className={`text-xs font-bold px-2 py-0.5 "healthy" "text-action-success" "text-action-warning" "healthy" "text-action-success" "text-action-warning"`}
                >
                  {d?.gateways?.status ?? "unknown"}
                </span>
              </div>
            </div>
          )}
        </div>

        {/* Containers table */}
        <div className="bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex items-center justify-between">
            <span className="text-sm font-semibold text-white">Containers</span>
            <span className="text-xs text-text-muted">
              {d?.containers ? `${d.containers.length} tracked` : "not available"}
            </span>
          </div>
          {busy ? (
            <div className="p-4 space-y-2">
              {Array.from({ length: 4 }).map((_, i) => (
                <div key={i} className="h-10 animate-pulse bg-bg-elevated/40" />
              ))}
            </div>
          ) : !d?.containers ? (
            <div className="p-6 text-center min-w-0">
              <p className="text-sm text-text-muted">
                Container telemetry requires the host Prometheus/cAdvisor exporter.
              </p>
              <p className="text-xs text-text-muted max-w-md mx-auto mt-1">
                {d?.containersError
                  ? `Exporter unreachable: ${d.containersError}`
                  : "No container data in this environment."}
              </p>
            </div>
          ) : (
            <div className="overflow-x-auto min-w-0">
              <table className="w-full text-left text-sm min-w140">
                <thead>
                  <tr className="border-b border-border text-xs text-text-muted uppercase">
                    <th className="px-4 py-2 font-medium">Container</th>
                    <th className="px-3 py-2 font-medium">State</th>
                    <th className="px-3 py-2 font-medium">CPU</th>
                    <th className="px-3 py-2 font-medium">Memory</th>
                    <th className="px-3 py-2 font-medium">Restarts (1h)</th>
                  </tr>
                </thead>
                <tbody>
                  {d.containers.map((c) => (
                    <tr key={c.name} className="border-b border-border/50">
                      <td className="px-4 py-2 font-mono text-xs text-text-secondary">{c.name}</td>
                      <td className="px-3 py-2">
                        <span
                          className={`text-xs font-bold px-2 py-0.5 "text-action-success" "text-action-danger" "text-action-success" "text-action-danger"`}
                        >
                          {c.running ? "running" : "stopped"}
                        </span>
                      </td>
                      <td className="px-3 py-2 text-text-secondary">{c.cpuPercent}%</td>
                      <td className="px-3 py-2 text-text-secondary">{formatBytes(c.memoryBytes)}</td>
                      <td className="px-3 py-2 text-text-secondary">
                        {c.restartsLastHour > 0 ? (
                          <span className="text-action-warning">{c.restartsLastHour}</span>
                        ) : (
                          "0"
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </WidgetBoundary>

      {/* Host-level Prometheus fleet charts (existing panel) */}
      <DockerFleetPanel />

    </div>
  );
}

export default function DockerServicesPage() {
  return (
    <AuthGuard allowedRoles={["sysadmin", "admin"]}>
      <Suspense fallback={<PageLoading />}>
        <DockerServicesInner />
      </Suspense>
    </AuthGuard>
  );
}
