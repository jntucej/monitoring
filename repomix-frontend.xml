                >
                  <option value="ALL">All Roles</option>
                  {depRoles.map((r) => <option key={r} value={r}>{r}</option>)}
                </select>
              </div>
              {filteredDeprovisioned.length === 0 ? (
                <EmptyState icon={<Ban size={24} />} text="No deprovisioned users found." />
              ) : (
                <div className="overflow-x-auto rounded-xl border border-border">
                  <table className="w-full text-sm min-w140">
                    <thead>
                      <tr className="bg-bg-elevated/60 text-text-muted text-xs uppercase tracking-wider">
                        <th className="px-4 py-3 text-left">Roll / Unique ID</th>
                        <th className="px-4 py-3 text-left">Name</th>
                        <th className="px-4 py-3 text-left">Role</th>
                        <th className="px-4 py-3 text-left">Deprovisioned Reason</th>
                        <th className="px-4 py-3 text-right">Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      {filteredDeprovisioned.map((u) => (
                        <tr key={u.id} className="border-t border-border/60 hover:bg-bg-elevated/30">
                          <td className="px-4 py-3 font-mono text-action-danger">{u.uniqueId || "—"}</td>
                          <td className="px-4 py-3 text-white">{u.name}</td>
                          <td className="px-4 py-3 text-text-secondary">{u.role || "—"}</td>
                          <td className="px-4 py-3 text-xs text-text-muted max-w-55 truncate" title={u.reason || ""}>
                            {u.reason || "—"}
                          </td>
                          <td className="px-4 py-3 text-right">
                            <button
                              onClick={() => handleReactivateUser(u)}
                              disabled={reprovisionBusy === u.id}
                              className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-600/20 hover:bg-blue-500/30 text-blue-300 text-xs font-medium transition disabled:opacity-50"
                            >
                              {reprovisionBusy === u.id ? <Loader2 size={12} className="animate-spin" /> : <UserCheck size={12} />}
                              Re-activate
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}
        </>
      )}

    </div>
  );
}

function KpiCard({ label, value, icon, color, sub }: { label: string; value: number; icon: ReactNode; color: string; sub?: string }) {
  return (
    <div className="surface-card bg-bg-elevated/40 p-4">
      <div className={`flex items-center gap-2 text-xs text-text-muted mb-1`}>
        {icon}
        {label}
      </div>
      <div className={`text-2xl font-bold ${color}`}>{value}</div>
      {sub && <div className="text-xs text-text-muted mt-0.5">{sub}</div>}
    </div>
  );
}

function EmptyState({ icon, text }: { icon: ReactNode; text: string }) {
  return (
    <div className="flex flex-col items-center justify-center py-16 text-text-muted">
      {icon}
      <p className="mt-3 text-sm">{text}</p>
    </div>
  );
}
