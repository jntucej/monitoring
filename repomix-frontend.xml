              key={item.href}
              href={item.href}
              title={item.label}
              className={`relative flex flex-col items-center justify-center h-full w-full py-1 active-tap transition-all min-h-11 ${
                active
                  ? "text-action-primary font-bold"
                  : "text-text-muted hover:text-text-primary"
              }`}
            >
              <Icon className={`w-5 h-5 shrink-0 transition-transform ${active ? "scale-110" : ""}`} />
              <span
                className={` size-4 rounded-full mt-1 transition-all "opacity-100 scale-100 shadow-[0_0_6px_var(--action-primary)]" "opacity-0 scale-0" `}
              />
