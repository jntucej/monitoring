<file path="src/components/security/OpsCompliancePanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";

interface GateHeadcount {
  gate_id: string;
  gate_name: string;
  in_today: number;
  out_today: number;
  net_inside: number;
}

interface DeviceHealth {
  id: string;
  serial: string;
  station_type: string;
  gate_name: string | null;
  health_state: string;
}

interface ProtocolRow {
  id: string;
  code: string;
  title: string;
  severity: string;
  steps: string[];
}

interface AccessReqRow {
  id: string;
  requester_name?: string;
  requested_role: string;
  reason: string;
  status: string;
}

export function OpsCompliancePanel() {
  const [headcount, setHeadcount] = useState<GateHeadcount[]>([]);
  const [devices, setDevices] = useState<DeviceHealth[]>([]);
  const [protocols, setProtocols] = useState<ProtocolRow[]>([]);
  const [accessReqs, setAccessReqs] = useState<AccessReqRow[]>([]);
  const [framework, setFramework] = useState("JNTUH");
  const [report, setReport] = useState<Record<string, number> | null>(null);
  const [drillMsg, setDrillMsg] = useState<string | null>(null);

  const load = useCallback(() => {
    fetch("/api/supervisor/gates/headcount")
      .then((r) => r.json())
      .then((j) => setHeadcount(j?.data?.gates ?? []))
      .catch(() => {});
    fetch("/api/supervisor/gates/hardware-health")
      .then((r) => r.json())
      .then((j) => setDevices(j?.data?.devices ?? []))
      .catch(() => {});
    fetch("/api/security/protocols")
      .then((r) => r.json())
      .then((j) => setProtocols(j?.data?.protocols ?? []))
      .catch(() => {});
    fetch("/api/access-requests")
      .then((r) => r.json())
      .then((j) => setAccessReqs(j?.data?.requests ?? []))
      .catch(() => {});
  }, []);

  useEffect(() => {
    load();
  }, [load]);

  async function runDrill() {
    const r = await fetch("/api/admin/lockdown/drill", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ scenario: "campus_lockdown_drill" }),
    });
    const j = await r.json();
    if (j?.data?.drill_id) setDrillMsg(`Drill completed (${j.data.drill_id.slice(0, 8)})`);
  }

  async function loadReport(fw: string) {
    setFramework(fw);
    const r = await fetch(`/api/admin/compliance/report?framework=${fw}`);
    const j = await r.json();
    if (j?.data?.metrics) setReport(j.data.metrics);
  }

  async function decideAccess(id: string, decision: "approved" | "rejected") {
    await fetch(`/api/access-requests/${id}/decide`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ decision }),
    });
    load();
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-2">
        <h2 className="text-sm font-semibold text-foreground">Multi-Gate Live Headcount</h2>
        <div className="flex items-center gap-2">
          <button
            type="button"
            onClick={runDrill}
            className="bg-destructive px-3 py-1 text-xs font-semibold text-destructive-foreground"
          >
            Run Lockdown Drill
          </button>
          {drillMsg && <span className="text-xs text-primary">{drillMsg}</span>}
        </div>
      </div>

      <div className="divide-y divide-border">
        {headcount.map((g) => (
          <div key={g.gate_id} className="flex justify-between py-1.5 text-xs text-foreground">
            <span>{g.gate_name}</span>
            <span className="font-mono">
              IN: {g.in_today} • OUT: {g.out_today} • Net: {g.net_inside}
            </span>
          </div>
        ))}
      </div>

      <div className="space-y-2">
        <h2 className="text-sm font-semibold text-foreground">Gate Hardware Health ({devices.length})</h2>
        <div className="divide-y divide-border">
          {devices.map((d) => (
            <div key={d.id} className="flex justify-between py-1.5 text-xs text-foreground">
              <span>
                {d.serial} ({d.station_type}) — {d.gate_name ?? "Unassigned"}
              </span>
              <span className="uppercase text-primary">{d.health_state}</span>
            </div>
          ))}
        </div>
      </div>

      <div className="space-y-2">
        <h2 className="text-sm font-semibold text-foreground">Emergency Response Protocols</h2>
        <div className="divide-y divide-border">
          {protocols.map((p) => (
            <div key={p.id} className="py-2 text-xs text-foreground">
              <strong>
                [{p.code}] {p.title}
              </strong>{" "}
              ({p.severity}) — {Array.isArray(p.steps) ? p.steps.join(" → ") : ""}
            </div>
          ))}
        </div>
      </div>

      <div className="space-y-2">
        <div className="flex items-center gap-2">
          <h2 className="text-sm font-semibold text-foreground">Compliance Report</h2>
          {(["JNTUH", "AICTE", "NBA"] as const).map((fw) => (
            <button
              key={fw}
              type="button"
              onClick={() => loadReport(fw)}
              className={`px-2 py-1 text-xs ${
                framework === fw && report ? "bg-primary text-primary-foreground" : "bg-muted text-foreground"
              }`}
            >
              {fw}
            </button>
          ))}
        </div>
        {report && (
          <div className="text-xs text-foreground">
            Students: {report.active_students} • Faculty: {report.active_faculty} • 30d Movements:{" "}
            {report.gate_movements_30d} • Circulars: {report.circulars_published}/{report.circulars_total} • SOS
            Resolved: {report.sos_resolved}/{report.sos_total} • Drills: {report.lockdown_drills_completed}
          </div>
        )}
      </div>

      {accessReqs.length > 0 && (
        <div className="space-y-2">
          <h2 className="text-sm font-semibold text-foreground">Self-Service Access Requests</h2>
          <div className="divide-y divide-border">
            {accessReqs.map((r) => (
              <div key={r.id} className="flex items-center justify-between py-1.5 text-xs text-foreground">
                <span>
                  {r.requester_name ?? "User"} → <strong>{r.requested_role}</strong> ({r.status}) — {r.reason}
                </span>
                {r.status === "pending" && (
                  <div className="flex gap-2">
                    <button type="button" onClick={() => decideAccess(r.id, "approved")} className="text-primary underline">
                      Approve
                    </button>
                    <button type="button" onClick={() => decideAccess(r.id, "rejected")} className="text-destructive underline">
                      Reject
                    </button>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/security/SosButton.tsx">
"use client";

import { useEffect, useState } from "react";

interface LocationOption {
  id: string;
  code: string;
  name: string;
}

export function SosButton({ onCreated }: { onCreated: (sosId: string) => void }) {
  const [locations, setLocations] = useState<LocationOption[]>([]);
  const [category, setCategory] = useState("unsafe");
  const [priority, setPriority] = useState<"normal" | "urgent" | "critical">("urgent");
  const [chosenLocId, setChosenLocId] = useState("");
  const [description, setDescription] = useState("");
  const [coords, setCoords] = useState<{ lat: number; lng: number } | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    fetch("/api/security/locations")
      .then((r) => r.json())
      .then((j) => setLocations(j?.data?.locations ?? []))
      .catch(() => {});
    if (typeof navigator !== "undefined" && navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) => setCoords({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
        () => {},
        { enableHighAccuracy: true, timeout: 5000 },
      );
    }
  }, []);

  async function sendSos(e: React.FormEvent) {
    e.preventDefault();
    setBusy(true);
    setError(null);
    try {
      const r = await fetch("/api/sos", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          category,
          priority,
          lat: coords?.lat ?? null,
          lng: coords?.lng ?? null,
          chosen_loc_id: chosenLocId || null,
          description: description.trim() || null,
        }),
      });
      const j = await r.json();
      if (!r.ok) {
        setError(j?.error?.message ?? "Failed to send SOS");
      } else if (j?.data?.id) {
        onCreated(j.data.id);
      }
    } catch {
      setError("Network error sending SOS");
    } finally {
      setBusy(false);
    }
  }

  return (
    <form onSubmit={sendSos} className="space-y-4">
      {error && <div className="text-sm text-destructive">{error}</div>}

      <div className="space-y-1">
        <label className="text-xs font-semibold uppercase text-muted-foreground">Category</label>
        <div className="flex flex-wrap gap-2">
          {["harassment", "medical", "theft", "suspicious", "unsafe", "fire", "other"].map((c) => (
            <button
              key={c}
              type="button"
              onClick={() => setCategory(c)}
              className={`px-3 py-1.5 text-xs font-medium capitalize border ${
                category === c
                  ? "border-primary bg-primary text-primary-foreground"
                  : "border-border bg-card text-foreground"
              }`}
            >
              {c}
            </button>
          ))}
        </div>
      </div>

      <div className="space-y-1">
        <label className="text-xs font-semibold uppercase text-muted-foreground">Priority</label>
        <div className="flex gap-2">
          {(["normal", "urgent", "critical"] as const).map((p) => (
            <button
              key={p}
              type="button"
              onClick={() => setPriority(p)}
              className={`px-3 py-1.5 text-xs font-medium capitalize border ${
                priority === p
                  ? "border-destructive bg-destructive text-destructive-foreground"
                  : "border-border bg-card text-foreground"
              }`}
            >
              {p}
            </button>
          ))}
        </div>
      </div>

      <div className="space-y-1">
        <label className="text-xs font-semibold uppercase text-muted-foreground">
          Location {coords ? `(GPS attached: ${coords.lat.toFixed(4)}, ${coords.lng.toFixed(4)})` : "(select place)"}
        </label>
        <select
          value={chosenLocId}
          onChange={(e) => setChosenLocId(e.target.value)}
          className="w-full border border-border bg-background px-3 py-2 text-sm text-foreground"
        >
          <option value="">Auto-detect nearest campus location</option>
          {locations.map((l) => (
            <option key={l.id} value={l.id}>
              {l.name} ({l.code})
            </option>
          ))}
        </select>
      </div>

      <textarea
        value={description}
        onChange={(e) => setDescription(e.target.value)}
        placeholder="Optional details (landmark, room, what happened)"
        className="w-full border border-border bg-background px-3 py-2 text-sm text-foreground"
        rows={2}
      />

      <button
        type="submit"
        disabled={busy}
        className="w-full bg-destructive py-3 text-base font-bold text-destructive-foreground hover:opacity-90 disabled:opacity-50"
      >
        {busy ? "Sending SOS..." : "SEND SOS"}
      </button>
    </form>
  );
}
</file>

<file path="src/components/security/SosInbox.tsx">
"use client";

export interface OfferedDispatch {
  id: string;
  sos_id: string;
  category: string;
  priority: string;
  location_name: string | null;
  distance_m: number | null;
  student_roll: string | null;
}

export function SosInbox({
  offer,
  onUpdated,
}: {
  offer: OfferedDispatch;
  onUpdated: () => void;
}) {
  async function accept() {
    await fetch(`/api/sos/${offer.sos_id}/dispatch/${offer.id}/accept`, { method: "POST" });
    onUpdated();
  }

  async function decline() {
    await fetch(`/api/sos/${offer.sos_id}/dispatch/${offer.id}/decline`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ reason: "unavailable" }),
    });
    onUpdated();
  }

  return (
    <div className="space-y-4 border-2 border-destructive bg-card p-5">
      <div className="text-lg font-bold uppercase text-destructive">
        {offer.priority} SOS — {offer.category}
