interface ProfileData {
  id: string;
  name: string;
  email: string;
  phone?: string;
  role: string;
  status?: string;
  uniqueId?: string;
  photoUrl?: string;
  departmentId?: string;
  createdAt?: string;
}

function VicePrincipalProfileInner() {
  const [profile, setProfile] = useState<ProfileData | null>(null);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    try {
      const res = await fetch("/api/profile");
      const json = await res.json();
      if (json.success && json.data) setProfile(json.data as ProfileData);
      setError(null);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load profile");
    }
  }, []);

  usePolling(load, { intervalMs: 60_000 });

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-6 space-y-4 min-w-0">
      <ContextSituationBar
        roleLabel="Vice Principal"
        purpose="Manage executive approver profile, contact details, and institutional notifications"
        why="Keeping executive profile and delegation contacts updated ensures urgent escalations reach you without delay."
        contextLabel="Vice Principal Profile"
        statusSummary="View your administrative profile, role credentials, and institutional delegation settings."
        primaryAction={{ label: "Delegated Responsibilities", href: "/vice-principal/delegated-responsibilities" }}
        secondaryAction={{ label: "VP Dashboard", href: "/vice-principal/home" }}
      />
      <h1 className="text-xl font-bold text-text-primary">Vice Principal Profile</h1>

      <WidgetBoundary title="Vice Principal Profile">
        <div className="surface-card bg-bg-surface p-4 sm:p-5">
          {error && <p className="text-xs text-action-danger mb-2">{error}</p>}

          {!profile && !error ? (
            <div className="space-y-2">
              {[0, 1, 2].map((i) => (
                <Skeleton key={i} className="h-10 w-full" />
              ))}
            </div>
          ) : profile ? (
            <div className="space-y-4">
              {/* Header */}
              <div className="flex items-center gap-3">
                {profile.photoUrl ? (
                  <img
                    src={profile.photoUrl}
                    alt={profile.name}
                    className="size-6 rounded-full object-cover"
                  />
                ) : (
                  <div className="size-6 rounded-full bg-bg-elevated flex items-center justify-center">
                    <User className="w-6 h-6 text-text-muted" />
                  </div>
                )}
                <div>
                  <h2 className="text-lg font-bold text-text-primary">
                    {profile.name}
                  </h2>
                  <span className="surface-card inline-flex items-center px-2 py-0.5 text-xs font-semibold uppercase bg-indigo-500/10 text-action-primary">
                    {profile.role.replace(/_/g, " ")}
                  </span>
                </div>
              </div>

              {/* Details */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div className="surface-card flex items-center gap-2 p-2.5 bg-bg-elevated">
                  <Mail className="w-4 h-4 text-text-muted shrink-0" />
                  <div>
                    <div className="text-xs text-text-muted">Email</div>
                    <div className="text-text-primary font-medium">
                      {profile.email}
                    </div>
                  </div>
                </div>
                {profile.phone && (
                  <div className="surface-card flex items-center gap-2 p-2.5 bg-bg-elevated">
                    <Phone className="w-4 h-4 text-text-muted shrink-0" />
                    <div>
                      <div className="text-xs text-text-muted">Phone</div>
                      <div className="text-text-primary font-medium">
                        {profile.phone}
                      </div>
                    </div>
                  </div>
                )}
                {profile.uniqueId && (
                  <div className="surface-card flex items-center gap-2 p-2.5 bg-bg-elevated">
                    <Shield className="w-4 h-4 text-text-muted shrink-0" />
                    <div>
                      <div className="text-xs text-text-muted">
                        Unique ID
                      </div>
                      <div className="font-mono text-text-primary">
                        {profile.uniqueId}
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          ) : (
            <p className="text-xs text-text-muted py-4 text-center">
              Profile data unavailable.
            </p>
          )}
        </div>
      </WidgetBoundary>

      <RoleProfileSettingsPanel role={profile?.role ?? "vice_principal"} />
      <div className="flex justify-end">
        <RoleLogoutButton />
      </div>
    </div>
  );
}

export default function VicePrincipalProfilePage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <VicePrincipalProfileInner />
    </Suspense>
  );
}
