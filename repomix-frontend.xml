"use client";

import { useState } from "react";
import { HandoverStreak } from "../_retention/HandoverStreak";
import { useSupervisorRetention } from "@/stores/supervisorRetentionStore";
import { useUIStore } from "@/stores/uiStore";
import { Send, CheckCircle2 } from "lucide-react";

export function ShiftHandoverView() {
  const [notes, setNotes] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [done, setDone] = useState(false);
  const completeHandover = useSupervisorRetention((s) => s.completeHandover);
  const endShift = useSupervisorRetention((s) => s.endShift);
  const currentShiftId = useSupervisorRetention((s) => s.currentShiftId) ?? new Date().toISOString().slice(0, 13);
  const addToast = useUIStore((s) => s.success);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    try {
      await fetch("/api/supervisor/shift", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ notes }),
      }).catch(() => null);

      completeHandover(currentShiftId, true);
      endShift(currentShiftId, true);
      setDone(true);
      addToast("Shift handover submitted successfully");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="space-y-4">
      <header>
        <h1 className="text-xl font-bold text-text-primary">Shift Handover</h1>
        <p className="text-xs text-text-muted">
          Log shift notes, flag gate exceptions, and hand over duty to the incoming supervisor
        </p>
      </header>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <HandoverStreak />

        <div className="surface-card bg-bg-surface p-5">
          {done ? (
            <div className="flex flex-col items-center justify-center py-8 text-center">
              <CheckCircle2 className="size-10 text-action-primary mb-2" />
              <h2 className="text-base font-bold text-text-primary">Handover Submitted</h2>
              <p className="text-xs text-text-muted mt-1">
                Your notes were logged to the shift audit history. Next supervisor has been notified.
              </p>
            </div>
          ) : (
            <form onSubmit={handleSubmit} className="space-y-4">
              <div>
                <label className="text-xs font-semibold text-text-secondary">Handover Notes</label>
                <textarea
                  required
                  rows={4}
                  value={notes}
                  onChange={(e) => setNotes(e.target.value)}
                  placeholder="Detail any ongoing gate repairs, guard adjustments, or active alerts..."
                  className="surface-card mt-1 w-full bg-bg-base p-3 text-xs text-text-primary focus:outline-none focus:ring-1 focus:ring-action-primary"
                />
              </div>

              <button
                type="submit"
                disabled={submitting}
                className="surface-card flex min-h-11 w-full items-center justify-center gap-2 bg-action-primary py-2.5 text-xs font-semibold text-white transition hover:bg-action-primary/90 disabled:opacity-50"
              >
                <Send className="size-3.5" />
                {submitting ? "Submitting..." : "Submit Shift Handover"}
              </button>
            </form>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

