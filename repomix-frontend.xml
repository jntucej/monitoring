<file path="src/components/admin/AdminSidebarInfographic.tsx">
"use client";

/**
 * AdminSidebarInfographic — compact per-category "infographic" rendered next
 * to each category header in the admin AdminSidebar.
 *
 * Driven entirely by the admin IA manifest (`cat.infographic`): a `kind` picks
 * the mini-visualization, a dotted `source` points at a slice of the live
 * admin overview payload, and an optional `color` tints it. The overview
 * payload is polled at the layout level and threaded down, so every sidebar
 * mini stays live without its own fetch.
 *
 * Uses admin-owned `Mini*` kit primitives (in `@/components/admin/kit`),
 * so the admin shell has no dependency on the sysadmin kit. The minis are
 * presentational and mirror the sysadmin ones; the infographic reads the
 * *admin* overview payload shape (`/api/admin/overview`), which adds
 * `operations.*` and `analytics.*` slices the sysadmin payload lacks.
 */
import {
  MiniDotCluster,
  MiniGauge,
  MiniHeatStrip,
  MiniSeverityChips,
  MiniSparkline,
  MiniStackedBar,
  MiniDriftPill,
  MiniCountPills,
} from "@/components/admin/kit";
import type { AdminOverviewPayload } from "./AdminSidebar";

export interface AdminInfographicSpec {
  kind: string;
  source: string;
  color?: string;
}

export interface AdminSidebarInfographicProps {
  spec?: AdminInfographicSpec;
  overview: AdminOverviewPayload | null;
}

/**
 * Read a dotted path ("a.b.c") off the admin overview payload. Returns
 * undefined when any hop is missing or the shape doesn't match — callers
 * treat that as "no data yet" and render nothing.
 */
export function readAdminSource<T = unknown>(
  overview: AdminOverviewPayload | null,
  dottedPath: string
): T | undefined {
  if (!overview || !dottedPath) return undefined;
  const parts = dottedPath.split(".");
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  let cursor: any = overview;
  for (const part of parts) {
    if (cursor == null || typeof cursor !== "object") return undefined;
    cursor = cursor[part];
  }
  return cursor as T | undefined;
}

const STACKED_BAR_COLORS = [
  "var(--action-primary)",
  "var(--action-warning)",
  "var(--action-info)",
];

export function AdminSidebarInfographic({ spec, overview }: AdminSidebarInfographicProps) {
  if (!spec) return null;

  switch (spec.kind) {
    case "dots": {
      const statuses = readAdminSource<Record<string, unknown>[]>(overview, spec.source)
        ?.map((s) => {
          const v = String(s);
          if (v === "offline" || v === "error") return "error" as const;
          if (v === "online" || v === "ok") return "ok" as const;
          return "warn" as const;
        })
        ?? undefined;
      if (!statuses || statuses.length === 0) return null;
      return <MiniDotCluster label={`Live status: ${statuses.length} services`} statuses={statuses} />;
    }

    case "stacked-bar": {
      const seg = readAdminSource<{ active?: number; suspended?: number; deprovisioned?: number }>(
        overview,
        spec.source
      );
      if (!seg) return null;
      const segments = [
        { value: seg.active ?? 0, color: STACKED_BAR_COLORS[0] },
        { value: seg.suspended ?? 0, color: STACKED_BAR_COLORS[1] },
        { value: seg.deprovisioned ?? 0, color: STACKED_BAR_COLORS[2] },
      ];
      return <MiniStackedBar label="Identity mix" segments={segments} />;
    }

    case "gauge": {
      const raw = readAdminSource<number>(overview, spec.source);
      if (raw == null) return null;
      const value = raw > 1 ? raw / 100 : raw;
      return (
        <MiniGauge
          label={`Coverage ${Math.round(raw > 1 ? raw : raw * 100)}%`}
          value={value}
          color={spec.color}
        />
      );
    }

    case "sparkline": {
      const values = readAdminSource<number[]>(overview, spec.source);
      if (!values || values.length < 2) return null;
      return <MiniSparkline label="Trend" values={values} color={spec.color} />;
    }

    case "heat": {
      const cells = readAdminSource<number[]>(overview, spec.source);
      if (!cells || cells.length === 0) return null;
      return <MiniHeatStrip label="Activity heat" cells={cells} />;
    }

    case "severity": {
      const counts = readAdminSource<{ critical?: number; high?: number; medium?: number; low?: number }>(
        overview,
        spec.source
      );
      if (!counts) return null;
      return (
        <MiniSeverityChips
          label="Alert severity"
          counts={{
            critical: counts.critical ?? 0,
            high: counts.high ?? 0,
            medium: counts.medium ?? 0,
            low: counts.low ?? 0,
          }}
        />
      );
    }

    case "drift": {
      const plat = readAdminSource<{ envDrift?: number; schemaDrift?: number }>(
        overview,
        spec.source
      );
      if (!plat) return null;
      const driftCount = (plat.envDrift ?? 0) + (plat.schemaDrift ?? 0);
      return <MiniDriftPill label="Config drift" driftCount={driftCount} />;
    }

    case "counts": {
      const ref = readAdminSource<{
        departments?: number;
        courses?: number;
        sections?: number;
      }>(overview,
        spec.source
      );
      if (!ref) return null;
      const counts = [ref.departments ?? 0, ref.courses ?? 0, ref.sections ?? 0];
      return <MiniCountPills label="Reference counts" counts={counts} />;
    }

    default:
      return null;
  }
}
</file>

<file path="src/components/admin/AdvancedAnalytics.tsx">
"use client";

import { useEffect, useState } from "react";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer } from "recharts";
import { RefreshCw, Save } from "lucide-react";

export function AdvancedAnalytics() {
  const { user, token } = useAuthStore();
  const currentSessionToken = user?.currentSessionToken || token;
  const { addToast } = useUIStore();

  const [groupBy, setGroupBy] = useState("hourly");
  const [personType, setPersonType] = useState("all");
  const [data, setData] = useState<any>(null);
  const [savedReports, setSavedReports] = useState<any[]>([]);
  const [reportName, setReportName] = useState("");
  const [showSave, setShowSave] = useState(false);

  const getHeaders = () => {
    const h: Record<string, string> = { "Content-Type": "application/json" };
    if (token) h["Authorization"] = `Bearer ${token}`;
    if (currentSessionToken) h["X-Session-Token"] = currentSessionToken;
    return h;
  };

  const fetchAnalytics = async () => {
    try {
      const res = await fetch(`/api/analytics/advanced?groupBy=${groupBy}&personType=${personType}`, { headers: getHeaders() });
      const result = await res.json();
      if (result.success) setData(result.data);
    } catch {}
  };

  const fetchSavedReports = async () => {
    try {
      const res = await fetch("/api/analytics/reports", { headers: getHeaders() });
      const result = await res.json();
      if (result.success) setSavedReports(result.data || []);
    } catch {}
  };

  useEffect(() => { fetchAnalytics(); fetchSavedReports(); }, [groupBy, personType]);

  const handleSaveReport = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!reportName) return;
    try {
      const res = await fetch("/api/analytics/reports", { method: "POST", headers: getHeaders(), body: JSON.stringify({ name: reportName, queryJson: { groupBy, personType } }) });
      const result = await res.json();
      if (result.success) { addToast({ variant: "success", title: "Saved", message: `Report saved.` }); setReportName(""); setShowSave(false); fetchSavedReports(); }
    } catch {}
  };

  const handleRunReport = async (id: string) => {
    try {
      const res = await fetch(`/api/analytics/reports/${id}/run`, { method: "POST", headers: getHeaders() });
      const result = await res.json();
      if (result.success) addToast({ variant: "success", title: "Executed", message: result.data.message });
    } catch {}
  };

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center">
        <div>
          <p className="text-2xl font-bold tracking-tight">Advanced Analytics</p>
          <p className="text-sm text-text-muted">Build queries and custom reports.</p>
        </div>
        <Button onClick={() => setShowSave(!showSave)} variant="secondary" size="sm" className="gap-2">
          <Save className="w-4 h-4" /> {showSave ? "Cancel" : "Save Definition"}
        </Button>
      </div>

      {showSave && (
        <Card className="surface-card p-4">
          <form onSubmit={handleSaveReport} className="flex gap-3">
            <input value={reportName} onChange={(e) => setReportName(e.target.value)} required placeholder="Report Name" className="surface-card flex-1 p-2 text-sm" />
            <Button type="submit" size="sm">Save</Button>
          </form>
        </Card>
      )}

      <Card className="surface-card p-4 flex gap-4 items-center">
        <select value={groupBy} onChange={(e) => setGroupBy(e.target.value)} className="surface-card p-2 text-sm">
          <option value="hourly">Hourly</option>
          <option value="daily">Daily</option>
        </select>
        <select value={personType} onChange={(e) => setPersonType(e.target.value)} className="surface-card p-2 text-sm">
          <option value="all">All Types</option>
          <option value="student">Students</option>
          <option value="faculty">Faculty</option>
        </select>
        <Button onClick={fetchAnalytics} size="sm" className="gap-1"><RefreshCw className="w-3.5 h-3.5" /> Run</Button>
      </Card>

      {data && (
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {data.model === "unavailable" && (
            <div className="surface-card lg:col-span-3 bg-amber-500/10 p-3 text-sm text-action-warning">
              No prediction model available. Showing raw historical movement data only
              ({data.dataPoints} samples). {data.reason}
            </div>
          )}
          <Card className={data.model === "unavailable" ? "lg:col-span-3 border p-4" : "lg:col-span-2 border p-4"}>
            {data.model === "historical-ma" && (
              <p className="text-xs text-text-muted mb-2">Historical trend (moving average of recorded movement logs). Not a forecast.</p>
            )}
            <div className="h-64 w-full">
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={data.timeSeries}>
                  <CartesianGrid strokeDasharray="3 3" opacity={0.3} />
                  <XAxis dataKey="time" />
                  <YAxis />
                  <Tooltip />
                  <Bar dataKey="count" fill="var(--action-primary)" radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </div>
          </Card>
          {data.model === "historical-ma" && (
            <Card className="surface-card p-4 space-y-3">
              {Array.isArray(data.breakdown) && data.breakdown.length > 0
                ? data.breakdown.map((b: any) => (
                    <div key={b.category} className="surface-card flex justify-between text-sm pb-2">
                      <span>{b.category}</span>
                      <Badge variant="entry">{b.count}</Badge>
                    </div>
                  ))
                : <p className="text-xs text-text-muted">No breakdown available.</p>}
            </Card>
          )}
        </div>
      )}

      <Card className="surface-card p-4">
        <h3 className="font-semibold text-base mb-2">Saved Reports</h3>
        {savedReports.map((r) => (
          <div key={r.id} className="surface-card flex justify-between items-center py-2 text-sm">
            <span>{r.name}</span>
            <Button onClick={() => handleRunReport(r.id)} size="sm" variant="secondary" className="text-xs">Run Report</Button>
          </div>
        ))}
      </Card>
    </div>
  );
}
</file>

<file path="src/components/admin/AnnouncementsManager.tsx">
"use client";

import { useEffect, useState, useCallback } from "react";
import { useUIStore } from "@/stores/uiStore";
import { getAuthHeaders } from "@/lib/utils";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { ConfirmDialog } from "@/components/admin/shared/ConfirmDialog";
import { WidgetLoading } from "@/components/admin/shared/LoadingStates";
import { Megaphone, Plus, Trash2, Eye, EyeOff, Send, Calendar } from "lucide-react";
import type { BadgeVariant } from "@/components/ui/badge";

function statusBadgeVariant(isPub: boolean, hasSchedule: boolean): BadgeVariant {
  if (isPub) return "success";
  if (hasSchedule) return "dayout";
  return "offline";
}

function priorityBadgeVariant(p: string | null): BadgeVariant {
  if (p === "critical" || p === "high") return "exit";
  if (p === "medium") return "success";
  return "offline";
}

type Announcement = {
  id: string;
  title: string;
  message: string;
  priority: string | null;
  audience: string | null;
  scheduled_at: string | null;
  is_published: boolean;
  created_at: string;
};

const AUDIENCE_OPTIONS = [
  { value: "all", label: "All Users" },
  { value: "operator", label: "Operators" },
  { value: "faculty", label: "Faculty" },
  { value: "student", label: "Students" },
  { value: "staff", label: "Staff" },
];

const PRIORITY_OPTIONS = [
  { value: "low", label: "Low" },
  { value: "medium", label: "Medium" },
  { value: "high", label: "High" },
  { value: "critical", label: "Critical" },
];

export function AnnouncementsManager() {
  const { addToast } = useUIStore();
  const [announcements, setAnnouncements] = useState<Announcement[]>([]);
  const [loading, setLoading] = useState(true);

  const [showCreate, setShowCreate] = useState(false);
  const [title, setTitle] = useState("");
  const [message, setMessage] = useState("");
  const [audience, setAudience] = useState("all");
  const [priority, setPriority] = useState("medium");
  const [publishNow, setPublishNow] = useState(true);
  const [publishAt, setPublishAt] = useState("");

  const [confirm, setConfirm] = useState<{
    open: boolean;
    title: string;
    body: string;
    action: () => Promise<void>;
  }>({ open: false, title: "", body: "", action: async () => {} });

  const fetchAnnouncements = useCallback(async () => {
    setLoading(true);
    try {
      const res = await fetch("/api/admin/announcements", { headers: getAuthHeaders() });
      const result = await res.json();
      const rows: Announcement[] = result.data?.rows ?? [];
      setAnnouncements(rows);
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to load announcements." });
    } finally {
      setLoading(false);
    }
  }, [addToast]);

  useEffect(() => {
    fetchAnnouncements();
  }, [fetchAnnouncements]);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!title.trim() || !message.trim()) return;
    try {
      const res = await fetch("/api/admin/announcements", {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({
          title: title.trim(),
          message: message.trim(),
          audience,
          priority,
          publishAt: publishNow ? undefined : publishAt || undefined,
          publishNow,
        }),
      });
      const result = await res.json();
      if (res.ok) {
        addToast({ variant: "success", title: "Created", message: publishNow ? "Broadcast published." : "Broadcast scheduled." });
        setTitle("");
        setMessage("");
        setPublishNow(true);
        setPublishAt("");
        setShowCreate(false);
        fetchAnnouncements();
      } else {
        addToast({ variant: "error", title: "Error", message: result?.message ?? result?.error?.message ?? "Failed to create announcement." });
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Failed to create announcement." });
    }
  };

  const runPatch = async (id: string, patch: Record<string, unknown>) => {
    const res = await fetch(`/api/admin/announcements/${id}`, {
      method: "PATCH",
      headers: getAuthHeaders(),
      body: JSON.stringify(patch),
    });
    const result = await res.json();
    if (!res.ok) {
      addToast({ variant: "error", title: "Error", message: result?.message ?? "Failed to update announcement." });
      return;
    }
    addToast({ variant: "success", title: "Updated", message: "Announcement saved." });
    fetchAnnouncements();
  };

  const handleTogglePublish = (a: Announcement) => {
    const newPub = !a.is_published;
    if (newPub) {
      setConfirm({
        open: true,
        title: "Publish announcement?",
        body: `"${a.title}" will be immediately visible to ${a.audience ?? "all"} users.`,
        action: () => runPatch(a.id, { publishNow: true, is_published: true }),
      });
    } else {
      runPatch(a.id, { is_published: false });
    }
  };

  const handleSchedule = (a: Announcement, when: string) => {
    if (!when) {
      addToast({ variant: "warning", title: "No time set", message: "Enter a future publish time first." });
      return;
    }
    setConfirm({
      open: true,
      title: "Schedule announcement?",
      body: `"${a.title}" will be scheduled to publish at ${new Date(when).toLocaleString()}.`,
      action: () => runPatch(a.id, { publishAt: when, is_published: false }),
    });
  };

  const handleDelete = (a: Announcement) => {
    setConfirm({
      open: true,
      title: "Delete announcement?",
      body: `"${a.title}" will be permanently removed. This cannot be undone.`,
      action: async () => {
        const res = await fetch(`/api/admin/announcements/${a.id}`, {
          method: "DELETE",
          headers: getAuthHeaders(),
        });
        if (res.ok) {
          addToast({ variant: "success", title: "Deleted", message: "Announcement removed." });
          fetchAnnouncements();
        } else {
          addToast({ variant: "error", title: "Error", message: "Failed to delete announcement." });
        }
      },
    });
  };

  const scheduleTime = (a: Announcement) => {
    const el = prompt("Schedule publish time (YYYY-MM-DDTHH:MM):", a.scheduled_at ?? "");
    if (el) handleSchedule(a, el);
  };

  if (loading) return <WidgetLoading />;

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center">
        <div>
          <p className="text-2xl font-bold tracking-tight">Announcements</p>
          <p className="text-sm text-text-muted">Create, schedule, and publish broadcast notifications.</p>
        </div>
        <Button onClick={() => setShowCreate(!showCreate)} className="gap-2">
          <Plus className="w-4 h-4" /> {showCreate ? "Cancel" : "New Broadcast"}
        </Button>
      </div>

      {showCreate && (
        <Card className="surface-card p-4">
          <form onSubmit={handleCreate} className="space-y-4">
            <h3 className="font-semibold text-lg flex items-center gap-2">
              <Megaphone className="w-5 h-5 text-action-warning" /> Create Broadcast
            </h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <input
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                required
                placeholder="Title"
                maxLength={200}
                className="surface-card p-2 text-sm"
              />
              <select value={audience} onChange={(e) => setAudience(e.target.value)} className="surface-card p-2 text-sm">
                {AUDIENCE_OPTIONS.map((o) => (
                  <option key={o.value} value={o.value}>{o.label}</option>
                ))}
              </select>
              <select value={priority} onChange={(e) => setPriority(e.target.value)} className="surface-card p-2 text-sm">
                {PRIORITY_OPTIONS.map((o) => (
                  <option key={o.value} value={o.value}>{o.label}</option>
                ))}
              </select>
            </div>
            <textarea
              value={message}
              onChange={(e) => setMessage(e.target.value)}
              required
              rows={3}
              placeholder="Message body..."
              maxLength={10000}
              className="surface-card w-full p-2 text-sm"
            />
            <div className="flex items-center gap-4">
              <label className="flex items-center gap-2 text-sm">
                <input
                  type="radio"
                  checked={publishNow}
                  onChange={() => setPublishNow(true)}
                  className="accent-emerald-500"
                />
                <Send className="w-3.5 h-3.5" /> Publish now
              </label>
              <label className="flex items-center gap-2 text-sm">
                <input
                  type="radio"
                  checked={!publishNow}
                  onChange={() => setPublishNow(false)}
                  className="accent-amber-500"
                />
                <Calendar className="w-3.5 h-3.5" /> Schedule for later
              </label>
              {!publishNow && (
                <input
                  type="datetime-local"
                  value={publishAt}
                  onChange={(e) => setPublishAt(e.target.value)}
                  className="surface-card p-1.5 text-sm"
                />
              )}
            </div>
            <div className="flex justify-end gap-2">
              <Button type="button" variant="ghost" size="sm" onClick={() => setShowCreate(false)}>Cancel</Button>
              <Button type="submit" size="sm" className="gap-1">
                {publishNow ? <Send className="w-3.5 h-3.5" /> : <Calendar className="w-3.5 h-3.5" />}
                {publishNow ? "Publish" : "Schedule"}
              </Button>
            </div>
          </form>
        </Card>
      )}

      <div className="space-y-4">
        {announcements.length === 0 && (
          <Card className="surface-card p-6 text-center text-sm text-text-muted">No announcements yet.</Card>
        )}
        {announcements.map((a) => (
          <Card key={a.id} className="surface-card p-4">
            <div className="flex justify-between items-start gap-4">
              <div className="space-y-1 min-w-0 flex-1">
                <div className="flex flex-wrap items-center gap-2">
                  <h3 className="font-semibold text-base">{a.title}</h3>
                  <Badge variant={statusBadgeVariant(a.is_published, !!a.scheduled_at)}>
                    {a.is_published ? "Published" : a.scheduled_at ? `Scheduled ${new Date(a.scheduled_at).toLocaleString()}` : "Draft"}
                  </Badge>
                  <Badge variant="entry" className="capitalize text-xs">{a.audience ?? "all"}</Badge>
                  {a.priority && (
                    <Badge variant={priorityBadgeVariant(a.priority)} className="text-xs">
                      {a.priority}
                    </Badge>
                  )}
                </div>
                <p className="text-sm text-text-muted dark:text-text-secondary break-words">{a.message}</p>
                <p className="text-xs text-text-muted">
                  {a.is_published && !a.scheduled_at ? "Live now" : a.scheduled_at ? `Scheduled for ${new Date(a.scheduled_at).toLocaleString()}` : "Not yet published"}
                </p>
              </div>
              <div className="flex items-center gap-1 flex-shrink-0">
                {!a.is_published && (
                  <Button variant="ghost" size="sm" title="Schedule" onClick={() => scheduleTime(a)}>
                    <Calendar className="w-4 h-4 text-action-warning" />
                  </Button>
                )}
                <Button variant="ghost" size="sm" title={a.is_published ? "Unpublish" : "Publish"} onClick={() => handleTogglePublish(a)}>
                  {a.is_published ? <EyeOff className="w-4 h-4 text-text-muted" /> : <Eye className="w-4 h-4 text-action-success" />}
                </Button>
                <Button variant="ghost" size="sm" title="Delete" onClick={() => handleDelete(a)}>
                  <Trash2 className="w-4 h-4 text-red-500" />
                </Button>
              </div>
            </div>
          </Card>
        ))}
      </div>

      <ConfirmDialog
        open={confirm.open}
        onClose={() => setConfirm((c) => ({ ...c, open: false }))}
        title={confirm.title}
        body={confirm.body}
        onConfirm={confirm.action}
        confirmText="Confirm"
        variant="destructive"
      />
    </div>
  );
}
