<file path="src/hooks/useNotificationActions.ts">
/**
 * hooks/useNotificationActions.ts — resolve the inline actions for a
 * notification type. Returns the action defs from the registry + a
 * dispatcher that POSTs to the action's API endpoint.
 *
 * Tier 1 (hooks) — never forks.
 */

"use client";

import { useCallback } from "react";
import { getNotificationActions, type NotificationTypeDef } from "@/lib/notifications/actions";
import { getAuthHeaders } from "@/lib/utils";

export interface NotificationActionResult {
  /** The action definitions for this notification type. */
  actions: NotificationTypeDef["actions"] | [];
  /** The deep-link target. */
  deepLink: string | undefined;
  /** The human label for the type badge. */
  label: string;
  /** Dispatch an inline action (POST to the action's api, then navigate). */
  dispatch: (actionId: string, notificationId: string) => Promise<boolean>;
}

export function useNotificationActions(
  type: string,
  onSuccess?: () => void,
): NotificationActionResult {
  const def = getNotificationActions(type);
  const actions = def?.actions ?? [];
  const deepLink = def?.deepLink;
  const label = def?.label ?? type;

  const dispatch = useCallback(
    async (actionId: string, notificationId: string): Promise<boolean> => {
      const action = actions.find((a) => a.id === actionId);
      if (!action) return false;

      // Client-only navigation (no api endpoint).
      if (!action.api) {
        if (action.href) window.location.href = action.href;
        onSuccess?.();
        return true;
      }

      // Build the body (static or dynamic).
      const body =
        typeof action.body === "function" ? action.body(notificationId) : (action.body ?? {});

      try {
        const res = await fetch(action.api, {
          method: action.method ?? "POST",
          headers: getAuthHeaders(),
          body: JSON.stringify({ ...body, notification_id: notificationId }),
        });
        if (!res.ok) return false;
        onSuccess?.();
      } catch {
        return false;
      }

      // Navigate to the deep-link after the action succeeds.
      if (action.href) window.location.href = action.href;
      return true;
    },
    [actions, onSuccess],
  );

  return { actions, deepLink, label, dispatch };
}

export default useNotificationActions;
</file>

<file path="src/hooks/useOfflineRecovery.ts">
"use client";
// src/hooks/useOfflineRecovery.ts
//
// When the browser goes offline and comes back online, re-fire all
// pending API calls that failed due to the network drop. This is the
// "user on a bus arrives at destination" recovery: the app re-fetches
// everything it couldn't load while offline.
//
// Also re-runs usePolling's immediate tick on "online" so dashboards
// that use it refresh without waiting for the next interval.

import { useCallback, useEffect, useRef } from "react";

type PendingRefresh = () => Promise<void>;

const pendingRefreshes: Set<PendingRefresh> = new Set();
let onlineListenerAttached = false;

function ensureOnlineListener() {
  if (onlineListenerAttached || typeof window === "undefined") return;
  onlineListenerAttached = true;
  window.addEventListener("online", () => {
    pendingRefreshes.forEach((fn) => {
      fn().catch(() => undefined);
    });
    pendingRefreshes.clear();
  });
}

/**
 * Register a refresh function to be re-fired when the browser comes
 * back online. If the browser is already online, fires immediately.
 *
 * Call this from a useEffect cleanup to avoid leaks:
 *
 *   const refresh = useApiResource(...).refresh;
 *   useOfflineRecovery(refresh);
 */
export function useOfflineRecovery(refresh: PendingRefresh) {
  const ref = useRef(refresh);
  useEffect(() => {
    ref.current = refresh;
  });

  useEffect(() => {
    ensureOnlineListener();
    if (navigator.onLine) {
      // Already online — no need to register, but do an immediate
      // refresh in case the component just mounted after an offline
      // period and the data is stale.
      refresh().catch(() => undefined);
      return;
    }
    // Offline right now — register for the "online" event
    pendingRefreshes.add(() => ref.current());
    return () => {
      pendingRefreshes.delete(() => ref.current());
    };
  }, []);
}

/**
 * Simpler variant: just re-run `fn` on the next "online" event.
 * Use for one-shot fetches, not for polling loops.
 */
export function useOnlineRefetch(fn: PendingRefresh) {
  const fnRef = useRef(fn);
  useEffect(() => {
    fnRef.current = fn;
  });

  useEffect(() => {
    const handler = () => {
      fnRef.current().catch(() => undefined);
    };
    window.addEventListener("online", handler, { once: true });
    return () => window.removeEventListener("online", handler);
  }, []);
}
</file>

