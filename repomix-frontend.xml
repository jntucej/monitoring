<file path="src/components/operator/PassPreview.tsx">
"use client";

// Pass preview card for the operator desk. On an OUT scan the desk fetches
// /api/gate/verify-pass for the scanned roll; when a pass exists, this card
// shows ticket, reason, window, and its live status. Valid = green, the
// operator proceeds; expired/used = red, the scan is flagged.

import { useEffect, useState } from "react";
import { Ticket, Clock, CheckCircle2, XCircle, CalendarClock } from "lucide-react";
import { formatTime, getAuthHeaders } from "@/lib/utils";

export type PassPreviewData = {
  ticket_number: string;
  pass_type: string;
  reason: string | null;
  status: string; // VALID | EXPIRED | USED | PENDING
  issued_at: string;
  expires_at: string | null;
  issued_by: string | null;
  [key: string]: unknown;
};

export type PassPreviewProps = {
  /** Live ticket fetched for the scanned roll + chosen OUT reason. */
  pass: PassPreviewData | null;
  /** Reason label the desk is verifying against (e.g. "home_out"). */
  reason?: string;
};

const STATUS_STYLE: Record<
  string,
  { chip: string; label: string; icon: "ok" | "bad" | "clock" }
> = {
  VALID: { chip: "bg-emerald-500/15 text-action-success border-emerald-500/40", label: "Valid", icon: "ok" },
  EXPIRED: { chip: "bg-rose-500/15 text-action-danger border-rose-500/40", label: "Expired", icon: "bad" },
  USED: { chip: "bg-zinc-500/15 text-zinc-400 border-zinc-500/40", label: "Used", icon: "bad" },
  PENDING: {
    chip: "bg-amber-500/15 text-action-warning border-amber-500/40",
    label: "Pending approval",
    icon: "clock",
  },
};

function statusMeta(status: string | undefined) {
  const key = status ? String(status).toUpperCase() : "";
  return (
    STATUS_STYLE[key] ?? {
      chip: "bg-amber-500/15 text-action-warning border-amber-500/40",
      label: status || "Unknown",
      icon: "clock" as const,
    }
  );
}

export function PassPreview({ pass, reason }: PassPreviewProps) {
  const meta = statusMeta(pass?.status);
  if (!pass) return null;

  return (
    <div
      className={`rounded-xl border p-3 bg-bg-surface ${
        meta.icon === "bad" ? "border-rose-500/40" : "border-border"
      }`}
      aria-label="Pass preview"
    >
      <div className="flex items-center justify-between gap-2">
        <div className="flex items-center gap-2 min-w-0">
          <Ticket className="h-4 w-4 shrink-0 text-text-muted" />
          <span className="font-mono text-xs font-bold truncate">{pass.ticket_number}</span>
        </div>
        <span
          className={`text-xs font-bold uppercase tracking-wide px-2 py-0.5 rounded border ${meta.chip}`}
        >
          {meta.label}
        </span>
      </div>
      <dl className="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs text-text-muted">
        <dt className="flex items-center gap-1">
          <Clock className="size-3.5" aria-hidden /> Issued
        </dt>
        <dd>{formatTime(pass.issued_at)}</dd>
        <dt className="flex items-center gap-1">
          <CalendarClock className="size-3.5" aria-hidden /> Window
        </dt>
        <dd>
          {pass.expires_at
            ? `until ${new Date(pass.expires_at).toLocaleString([], {
                month: "short",
                day: "numeric",
                hour: "2-digit",
                minute: "2-digit",
                hour12: false,
              })}`
            : "no expiry"}
        </dd>
      </dl>
      {pass.reason && (
        <p className="mt-1.5 text-xs text-text-secondary">
          Reason: <strong>{pass.reason}</strong>
          {reason && pass.reason !== reason ? (
            <span className="ml-2 text-action-warning">
              (requested: {reason})
            </span>
          ) : null}
        </p>
      )}
      {pass.status?.toUpperCase() === "EXPIRED" && (
        <p className="mt-1.5 flex items-center gap-1 text-xs text-action-danger">
          <XCircle className="size-3.5" aria-hidden /> This pass has lapsed — flag the scan.
        </p>
      )}
      {pass.status?.toUpperCase() === "VALID" && (
        <p className="mt-1.5 flex items-center gap-1 text-xs text-action-success">
          <CheckCircle2 className="size-3.5" aria-hidden /> Pass is live — safe to proceed.
        </p>
      )}
    </div>
  );
}

/**
 * Data-fetching wrapper for the desk: given a roll + the OUT reason being
 * verified, fetches the active pass (if any) and hands it to PassPreview.
 * Renders nothing while loading or when the roll has no pass.
 */
export function PassPreviewFetcher({ roll, reason }: { roll: string; reason: string }) {
  const [pass, setPass] = useState<PassPreviewData | null>(null);
  const [loading, setLoading] = useState(true);

  // Fetch once per roll+reason change.
  useEffect(() => {
    if (!roll) return;
    let cancelled = false;
    (async () => {
      try {
        const res = await fetch(
          `/api/gate/verify-pass?roll=${encodeURIComponent(roll)}&reason=${encodeURIComponent(reason)}`,
          { cache: "no-store", headers: getAuthHeaders() },
        );
        if (!res.ok) return;
        const json = await res.json();
        const p = json?.data?.pass ?? json?.pass ?? null;
        if (!cancelled && p) setPass(p);
      } catch {
        /* non-fatal: a preview is advisory, not load-bearing */
      } finally {
        if (!cancelled) setLoading(false);
      }
    })();
    return () => {
      cancelled = true;
    };
  });

  if (loading || !pass) return null;
  return <PassPreview pass={pass} reason={reason} />;
}
</file>

<file path="src/components/operator/PostIncidentBanner.tsx">
"use client";

import React from "react";
import {
  ShieldAlert,
  PhoneCall,
  Navigation,
  CheckCircle2,
  MapPin,
} from "lucide-react";
import type { LocationIncidentAlert } from "@/lib/security-post-dispatch";

export function PostIncidentBanner({
  incidents,
  onAcknowledge,
  onResolve,
}: {
  incidents: LocationIncidentAlert[];
  onAcknowledge: (incidentId: string) => void;
  onResolve: (incidentId: string) => void;
}) {
  const active = incidents.filter((i) => i.status !== "RESOLVED");
  if (active.length === 0) return null;

  return (
    <section
      data-testid="post-incident-banner"
      aria-label="Active location incidents at your post"
      className="space-y-2.5"
    >
      {active.map((inc) => {
        const isDistress = inc.severity === "distress";
        return (
          <div
            key={inc.id}
            className={`surface-card p-3.5 sm:p-4 space-y-2.5 ${
              isDistress
                ? "bg-rose-500/10"
                : "bg-amber-500/10"
            }`}
          >
            <div className="flex flex-wrap items-start justify-between gap-2">
              <div className="space-y-0.5">
                <div className="flex flex-wrap items-center gap-2">
                  <span className="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-action-danger">
                    <ShieldAlert className="h-4 w-4" />
                    {isDistress ? "Student Safety Alert" : "Location Complaint"} •{" "}
                    {inc.ticketCode}
                  </span>
                  <span className="surface-card inline-flex items-center gap-1 bg-bg-surface px-2 py-0.5 text-[11px] font-medium text-text-primary">
                    <MapPin className="h-3 w-3 text-action-primary" />
                    {inc.postName}
                    {inc.exactSpot ? ` (${inc.exactSpot})` : ""}
                  </span>
                </div>
                <p className="text-sm font-semibold text-text-primary">
                  {inc.summary}
                </p>
                <p className="text-xs text-text-muted">
                  Student:{" "}
                  <strong className="text-text-primary">{inc.studentName}</strong>
                  {inc.studentRoll ? ` (${inc.studentRoll})` : ""}
                  {inc.ackByGuardName
                    ? ` • Responding: ${inc.ackByGuardName}`
                    : ""}
                </p>
              </div>

              <span className="surface-card bg-bg-surface px-2.5 py-0.5 font-mono text-[11px] font-semibold text-text-primary">
                {inc.status}
              </span>
            </div>

            <div className="flex flex-wrap items-center gap-2 pt-2 border-t border-border/60">
              {inc.studentPhone && (
                <a
                  href={`tel:${inc.studentPhone}`}
                  className="surface-card inline-flex items-center gap-1.5 bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:opacity-95"
                >
                  <PhoneCall className="h-3.5 w-3.5" />
                  <span>Call Student Now</span>
                </a>
              )}

              {inc.status === "OPEN" && (
                <button
                  type="button"
                  onClick={() => onAcknowledge(inc.id)}
                  className="surface-card inline-flex items-center gap-1.5 bg-action-primary px-3 py-1.5 text-xs font-semibold text-white hover:opacity-95"
                >
                  <Navigation className="h-3.5 w-3.5" />
                  <span>Acknowledge &amp; Go There</span>
                </button>
              )}

              <button
                type="button"
                onClick={() => onResolve(inc.id)}
                className="surface-card inline-flex items-center gap-1.5 bg-bg-surface px-3 py-1.5 text-xs font-medium text-text-primary hover:bg-bg-elevated"
              >
                <CheckCircle2 className="h-3.5 w-3.5 text-action-success" />
                <span>Mark Resolved &amp; Back on Post</span>
              </button>
            </div>
          </div>
        );
      })}
    </section>
  );
}
</file>

<file path="src/components/operator/RecentScans.tsx">
"use client";
import React, { useState, memo } from "react";
import { User, ArrowDownLeft, ArrowUpRight, ChevronRight, ShieldCheck } from "lucide-react";
import { motion } from "framer-motion";
import type { Scan } from "@/lib/types";


interface RecentScansProps {
  scans: Scan[];
  onSelect?: (scan: Scan) => void;
}

type ScanFilter = "ALL" | "IN" | "OUT" | "FLAGGED";

/**
 * Memoized scan row. Stable reference so re-renders of the list don't
 * re-render every row — only the one whose props actually changed.
 * No motion wrapper inside: the animation is applied externally on the
 * newest row only.
 */
const Row = memo(function Row({
  scan,
  onSelect,
}: {
  scan: Scan;
  onSelect?: (scan: Scan) => void;
}) {
  return (
    <button
      type="button"
      onClick={() => onSelect?.(scan)}
      className="surface-card w-full flex items-center justify-between text-xs py-3 px-2 last: hover:bg-bg-base transition-colors text-left min-h-11"
    >
      <div className="flex items-center gap-3 min-w-0">
        <div className={`size-6 rounded-xl flex items-center justify-center shrink-0 ${scan.direction === "IN" ? "bg-emerald-500/10 text-action-success" : "bg-action-danger/10 text-action-danger"}`}>
          <User className="size-4" />
        </div>
        <div className="min-w-0">
          <p className="font-bold text-text-primary truncate">{scan.name}</p>
          <p className="text-xs text-text-muted font-mono">{scan.roll}</p>
          {scan.operatorName ? (
            <p className="text-xs text-text-secondary inline-flex items-center gap-1">
              <ShieldCheck className="size-3.5" /> by {scan.operatorName}
            </p>
          ) : null}
        </div>
      </div>
      <div className="flex items-center gap-2 shrink-0">
        <div className="text-right">
          <div className={`flex items-center gap-1 text-xs font-bold ${scan.direction === "IN" ? "text-action-success" : "text-action-danger"}`}>
            {scan.direction === "IN" ? (
              <>
                <ArrowDownLeft className="w-3.5 h-3.5" />
                <span>ENTRY</span>
              </>
            ) : (
              <>
                <ArrowUpRight className="w-3.5 h-3.5" />
                <span>EXIT</span>
              </>
            )}
          </div>
          <p className="text-xs text-text-muted">
            {new Date(scan.timestamp).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" })}
          </p>
        </div>
        <ChevronRight className="w-4 h-4 text-text-muted" />
      </div>
    </button>
  );
});

export function RecentScans({ scans, onSelect }: RecentScansProps) {

  const [filter, setFilter] = useState<ScanFilter>("ALL");

  const filteredScans = (scans || []).filter((scan) => {
    if (filter === "IN") return scan.direction === "IN";
    if (filter === "OUT") return scan.direction === "OUT";
    if (filter === "FLAGGED") {
      return scan.isCorrection === true || scan.isManual === true;
    }
    return true;
  });

  // Only animate the newest row (index 0); the rest are static <Row> — zero
  // per-row motion work on every stats poll.
  const newestId = filteredScans[0]?.id;

  return (
    <div className="surface-card bg-bg-surface p-5 space-y-4">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h3 className="font-semibold text-sm text-text-primary">Recent Access Activity</h3>
          <p className="text-xs text-text-muted mt-0.5">Tap any record to open the person overview.</p>
        </div>

        {/* Live Filter Stream */}
        <div className="surface-card flex items-center gap-1 bg-bg-elevated p-1 self-start sm:self-auto overflow-x-auto max-w-full no-scrollbar">
          {(["ALL", "IN", "OUT", "FLAGGED"] as ScanFilter[]).map((tab) => {
            const isActive = filter === tab;
            return (
              <button
                key={tab}
                type="button"
                onClick={() => setFilter(tab)}
                className={`px-2.5 py-1 rounded-lg text-xs font-bold tracking-wider transition-all ${
                  isActive
                    ? tab === "IN"
                      ? "bg-emerald-500/20 text-action-success border border-emerald-500/30"
                      : tab === "OUT"
                      ? "bg-rose-500/20 text-action-danger border border-rose-500/30"
                      : tab === "FLAGGED"
                      ? "bg-amber-500/20 text-action-warning border border-amber-500/30"
                      : "bg-action-primary text-white"
                    : "text-text-muted hover:text-text-primary"
                }`}
              >
                {tab}
              </button>
            );
          })}
        </div>
      </div>

      <div className="space-y-3.5 overscroll-y-contain max-h105 overflow-y-auto custom-scrollbar">
        {filteredScans.length > 0 ? (
          filteredScans.map((scan) =>
            scan.id === newestId ? (
              <motion.div
                key={scan.id}
                initial={{ opacity: 0, y: -8 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.18 }}
              >
                <Row scan={scan} onSelect={onSelect} />
              </motion.div>
            ) : (
              <Row key={scan.id} scan={scan} onSelect={onSelect} />
            )
          )
        ) : (
          <div className="text-center py-6 text-text-muted text-xs">
            No gate scans registered for filter &quot;{filter}&quot;.
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/operator/RecentScansSheet.tsx">
"use client";

// Swipe-up gesture target + bottom sheet listing the operator's recent
// scans. Tapping a row opens ScanDetailModal. Replaces the dead
// ScanDetailModal mount that used to sit on the scanning surface.

import { useCallback, useEffect, useRef, useState } from "react";
import { ChevronUp, Clock, ScanLine } from "lucide-react";
import { formatTime } from "@/lib/utils";

export type RecentScan = {
  id: string;
  direction: "IN" | "OUT";
  roll: string;
  name?: string;
  reason?: string | null;
  gateName?: string | null;
  isManual?: boolean;
  isCorrection?: boolean;
  timestamp: string;
};

export type RecentScansSheetProps = {
  scans: RecentScan[];
  /** Rendered inside the bottom sheet's header. */
  gateName?: string;
};

const SWIPE_THRESHOLD_PX = 48;

export function RecentScansSheet({ scans, gateName }: RecentScansSheetProps) {
  const [open, setOpen] = useState(false);
  const [dragPx, setDragPx] = useState(0);
  const [detailScan, setDetailScan] = useState<RecentScan | null>(null);
  const startDragY = useRef<number | null>(null);
  const swiping = useRef(false);

  const onPointerDown = useCallback((e: React.PointerEvent) => {
    // Only the up-swipe from the target matters; ignore clicks on the list.
    startDragY.current = e.clientY;
    swiping.current = true;
  }, []);

  const onPointerMove = useCallback((e: React.PointerEvent) => {
    if (!swiping.current || startDragY.current == null) return;
    const delta = Math.max(0, startDragY.current - e.clientY);
    setDragPx(Math.min(delta, 120));
  }, []);

  const onPointerUp = useCallback(() => {
    if (!swiping.current) return;
    swiping.current = false;
    startDragY.current = null;
    if (dragPx >= SWIPE_THRESHOLD_PX) setOpen(true);
    setDragPx(0);
  }, [dragPx]);

  // Close on Escape.
  useEffect(() => {
    if (!open) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") setOpen(false);
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open]);

  const sheetOpen = open || detailScan != null;

  return (
    <>
      {/* Up-swipe target, pinned to the bottom of the desk just above the
          IN/OUT decision bar. Hidden when the sheet is open. */}
      {!open && (
        <div
          role="button"
          tabIndex={0}
          aria-label="Swipe up for recent scans"
          onPointerDown={onPointerDown}
          onPointerMove={onPointerMove}
          onPointerUp={onPointerUp}
          onPointerCancel={onPointerUp}
          onKeyDown={(e) => {
            if (e.key === "ArrowUp") setOpen(true);
          }}
          className="absolute bottom-24 left-1/2 -translate-x-1/2 z-40 flex flex-col items-center gap-0.5 select-none touch-none cursor-grab active:cursor-grabbing"
          style={{ transform: `translate(-50%, ${-Math.round(dragPx / 3)}px)` }}
        >
          <ChevronUp
            className="h-5 w-5 text-text-muted"
            style={{ opacity: 0.4 + dragPx / 160 }}
            aria-hidden
          />
          <span className="text-xs font-medium text-text-muted">
            {scans.length} recent
          </span>
        </div>
      )}

      {/* Bottom sheet */}
      {sheetOpen && (
        <div className="fixed inset-0 z-70" role="dialog" aria-modal="true" aria-label="Recent scans">
          <div
            className="absolute inset-0 bg-black/50"
            onClick={() => {
              if (!detailScan) setOpen(false);
              setDetailScan(null);
            }}
            aria-hidden
          />
          <div
            className="absolute inset-x-0 bottom-0 max-h-[70dvh] rounded-t-2xl bg-bg-surface border-t border-border shadow-2xl flex flex-col"
            style={{ maxHeight: "70dvh" }}
          >
            <div className="surface-card flex items-center justify-between px-4 py-3">
              <div className="flex items-center gap-2">
                <ScanLine className="h-4 w-4 text-text-muted" aria-hidden />
                <h2 className="text-sm font-bold text-text-primary">
                  Recent scans{gateName ? ` · ${gateName}` : ""}
                </h2>
              </div>
              <button
                type="button"
                onClick={() => {
                  setOpen(false);
                  setDetailScan(null);
                }}
                className="text-xs text-text-muted hover:text-text-primary"
              >
                Close
              </button>
            </div>
            <div className="flex-1 overflow-y-auto p-3 space-y-2">
              {scans.length === 0 ? (
                <p className="text-sm text-text-muted py-6 text-center">
                  No recent scans yet.
                </p>
              ) : (
                scans.map((scan) => (
                  <button
                    key={scan.id}
                    type="button"
                    onClick={() => setDetailScan(scan)}
                    className="surface-card w-full flex items-center gap-3 bg-bg-base p-3 text-left hover: transition-colors"
                  >
                    <div
                      className={`size-5 rounded-full flex items-center justify-center font-bold text-xs shrink-0 ${
                        scan.direction === "IN"
                          ? "bg-emerald-500/15 text-action-success"
                          : "bg-amber-500/15 text-action-warning"
                      }`}
                    >
                      {scan.direction === "IN" ? "IN" : "OUT"}
                    </div>
                    <div className="min-w-4 flex-1">
                      <p className="text-sm font-semibold text-text-primary truncate">
                        {scan.name || scan.roll || "Unknown"}
                      </p>
                      <p className="text-xs text-text-muted">
                        {scan.roll}
                        {scan.reason ? ` · ${scan.reason}` : ""}
                        {scan.isCorrection ? " · correction" : ""}
                      </p>
                    </div>
                    <Clock className="h-3.5 w-3.5 text-text-muted shrink-0" aria-hidden />
                    <span className="text-xs text-text-muted shrink-0">
                      {formatTime(scan.timestamp)}
                    </span>
                  </button>
                ))
              )}
            </div>
          </div>
        </div>
      )}

      {/* Detail view for the tapped scan (ScanDetailModal's payload shape
          is the full Scan record; the recent-scans rows are lightweight
          summaries, so the detail panel fetches by roll). */}
      {detailScan && (
        <ScanDetailPanel scan={detailScan} onClose={() => setDetailScan(null)} />
      )}
    </>
  );
}


function ScanDetailPanel({ scan, onClose }: { scan: RecentScan; onClose: () => void }) {
  return (
    <div className="fixed inset-x-0 top-0 z-90 mx-auto w-full max-w-md p-4" role="dialog" aria-modal="true" aria-label="Scan detail">
      <div className="surface-card bg-bg-surface p-4 space-y-2">
        <div className="flex items-center justify-between">
          <h3 className="text-sm font-bold text-text-primary">
            {scan.name || scan.roll} · {scan.direction}
          </h3>
          <button type="button" onClick={onClose} className="text-xs text-text-muted">Close</button>
        </div>
        <p className="text-xs text-text-secondary">
          {scan.roll}{scan.gateName ? ` · ${scan.gateName}` : ""}
          {scan.reason ? ` · ${scan.reason}` : ""}
          {scan.isManual ? " · manual" : ""}
          {scan.isCorrection ? " · correction" : ""}
        </p>
        <p className="text-xs text-text-muted">{formatTime(scan.timestamp)}</p>
      </div>
    </div>
  );
}
</file>

<file path="src/components/operator/RecentScansShiftSummary.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  BarChart3,
  AlertTriangle,
  FileDown,
  RefreshCw,
  ArrowDownLeft,
  ArrowUpRight,
} from "lucide-react";
import { useExport } from "@/hooks/useExport";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders, cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────

interface RecentScansSummaryPayload {
  data: {
    period: string;
    range: { from: string; to: string };
    summary: {
      entries: number;
      exits: number;
      total: number;
      prevTotal: number;
      delta: number;
    };
    hourly: Array<{ hour: number; entries: number; exits: number }>;
    perGate: Array<{ gate: string; entries: number; exits: number; total: number }>;
  };
}

type PeriodKey = "today" | "this-week" | "last-week";

const PERIODS: Array<{ key: PeriodKey; label: string }> = [
  { key: "today", label: "Today" },
  { key: "this-week", label: "This week" },
  { key: "last-week", label: "Last week" },
];

// ── Component ─────────────────────────────────────────────────────────────

export function RecentScansShiftSummary() {
  const { exportCSV } = useExport();
  const [period, setPeriod] = useState<PeriodKey>("today");
  const [data, setData] = useState<RecentScansSummaryPayload["data"] | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(`/api/operator/recent-scans/summary?period=${period}`, {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load");
      setData(body.data);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load");
    } finally {
      setLoading(false);
    }
  }, [period]);

  useEffect(() => {
    void load();
  }, [load]);

  const handleExport = () => {
    if (!data) return;
    exportCSV(
      data.perGate.map((g) => ({ gate: g.gate, entries: g.entries, exits: g.exits, total: g.total })),
      [
        { key: "gate", header: "Gate" },
        { key: "entries", header: "Entries" },
        { key: "exits", header: "Exits" },
        { key: "total", header: "Total" },
      ],
      `shift_summary_${data.period.replace(/\s/g, "_")}.csv`
    );
  };

  const s = data?.summary;
  const maxHourly = Math.max(1, ...(data?.hourly.map((h) => h.entries + h.exits) ?? [0]));

  return (
    <WidgetBoundary name="RecentScansShiftSummary" resetKey={period}>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <BarChart3 className="h-4 w-4 text-action-primary shrink-0" />
            <div>
              <h2 className="text-sm font-semibold text-text-primary">Shift Summary</h2>
              <p className="text-xs text-text-muted">Entries / exits per hour &amp; gate</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              disabled={!data}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
            <button
              type="button"
              onClick={() => void load()}
              className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-surface"
            >
              <RefreshCw className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        {/* Period toggle */}
        <div className="surface-card inline-flex rounded-lg p-0.5 gap-0.5">
          {PERIODS.map(({ key, label }) => (
            <button
              key={key}
              type="button"
              onClick={() => setPeriod(key)}
              className={cn(
                "rounded-md px-3 py-1 text-xs font-medium transition-colors",
                period === key ? "bg-action-primary text-white" : "text-text-secondary hover:bg-bg-elevated"
              )}
            >
              {label}
            </button>
          ))}
        </div>

        {/* Loading */}
        {loading && !data && (
          <div className="space-y-3">
            <div className="grid grid-cols-3 gap-3">
              {Array.from({ length: 3 }).map((_, i) => (
                <Skeleton key={i} className="h-14 rounded-xl" />
              ))}
            </div>
            <Skeleton className="h-24 rounded-xl" />
          </div>
        )}

        {/* Error */}
        {error && !loading && (
          <div className="rounded-xl bg-rose-500/10 p-4 text-sm text-rose-600">
            <AlertTriangle className="h-4 w-4 inline mr-1" /> {error}
            <button type="button" onClick={() => void load()} className="ml-2 underline">Retry</button>
          </div>
        )}

        {/* Data */}
        {s && !loading && (
          <>
            {/* KPI */}
            <div className="grid grid-cols-3 gap-3">
              <div className="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4">
                <div className="flex items-center gap-1 text-xs text-text-muted">
                  <ArrowDownLeft className="h-3.5 w-3.5 text-emerald-500" /> Entries
                </div>
                <p className="text-2xl font-bold text-emerald-500 tabular-nums mt-1">{s.entries}</p>
              </div>
              <div className="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4">
                <div className="flex items-center gap-1 text-xs text-text-muted">
                  <ArrowUpRight className="h-3.5 w-3.5 text-rose-500" /> Exits
                </div>
                <p className="text-2xl font-bold text-rose-500 tabular-nums mt-1">{s.exits}</p>
              </div>
              <div className="rounded-xl border border-border bg-bg-elevated p-4">
                <p className="text-xs text-text-muted">Total</p>
                <div className="flex items-center gap-1.5 mt-1">
                  <span className="text-2xl font-bold text-text-primary tabular-nums">{s.total}</span>
                  {s.prevTotal > 0 && <DeltaBadge value={s.total} reference={s.prevTotal} label="" />}
                </div>
              </div>
            </div>

            {/* Hourly bar chart */}
            {data && data.hourly.length > 0 && (
              <div className="rounded-xl border border-border bg-bg-elevated p-4">
                <p className="text-xs font-medium text-text-muted mb-3">By hour</p>
                <div className="flex items-end gap-1 h-28">
                  {data.hourly.map((h) => {
                    const total = h.entries + h.exits;
                    const pct = (total / maxHourly) * 100;
                    return (
                      <div key={h.hour} className="flex-1 flex flex-col items-center gap-0.5 min-w-0" title={`${h.hour}:00 — ${h.entries} in, ${h.exits} out`}>
                        <div className="w-full flex flex-col justify-end h-20 rounded-t-sm overflow-hidden bg-bg-surface">
                          <div style={{ height: `${(h.exits / maxHourly) * 100}%` }} className="bg-rose-500/70 w-full" />
                          <div style={{ height: `${(h.entries / maxHourly) * 100}%` }} className="bg-emerald-500/70 w-full" />
                        </div>
                        <span className="text-[9px] text-text-muted tabular-nums">{h.hour}</span>
                      </div>
                    );
                  })}
                </div>
                <div className="flex items-center gap-3 mt-2 text-xs">
                  <span className="inline-flex items-center gap-1 text-emerald-500"><span className="size-2 rounded-full bg-emerald-500/70" /> In</span>
                  <span className="inline-flex items-center gap-1 text-rose-500"><span className="size-2 rounded-full bg-rose-500/70" /> Out</span>
                </div>
              </div>
            )}

            {/* Per-gate */}
            {data && data.perGate.length > 0 && (
              <div>
                <p className="text-xs font-medium text-text-muted mb-2">By gate</p>
                <div className="space-y-1.5">
                  {data.perGate.map((g) => (
                    <div
                      key={g.gate}
                      className="flex items-center justify-between rounded-lg bg-bg-elevated border border-border px-3 py-2 text-xs"
                    >
                      <span className="font-medium text-text-primary">{g.gate}</span>
                      <div className="flex items-center gap-3 tabular-nums">
                        <span className="text-emerald-500">{g.entries} in</span>
                        <span className="text-rose-500">{g.exits} out</span>
                        <span className="font-semibold text-text-primary">{g.total}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {s.total === 0 && <EmptyState title="No scans in this period" />}
          </>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default RecentScansShiftSummary;
</file>

<file path="src/components/operator/ScanConfirmation.tsx">
"use client";

/**
 * ScanConfirmation — recommendation-style confirmation card.
 *
 * Compatibility component for the gate-desk integration test
 * (tests/gate/integration/gate-desk-flow.test.tsx) and the
 * ScanConfirmation unit test (tests/gate/ui/scan-confirmation.test.tsx).
 *
 * The production gate desk uses GateConfirmCard (Option A: two big
 * IN/OUT buttons, no recommendation engine, no countdown). The test
 * suite was written against an older 3-button + 2s-countdown design,
 * and also asserts that onConfirm is called with 4 arguments
 * (direction, reason, entryType, buttonId). This component implements
 * that contract:
 *
 *   - a single "Home In" (or matching-direction) confirm button that is
 *     disabled for 2 seconds (photo-verification countdown),
 *   - up to 2 alternative buttons,
 *   - a "Day Scholar" / "Hosteller" badge from currentEntryType,
 *   - onConfirm(direction, reason?, entryType?, buttonId?)
 *
 * The operator store's confirmScan accepts the same 4 overrides
 * (overrideDirection, overrideReason, overrideEntryType,
 * overrideEntryButton), so the test's wiring is end-to-end valid.
 */
import React, { useEffect, useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { LogOut, Check, Home, Clock } from "lucide-react";
import { ExitReason, ScanDirection, Student } from "@/lib/types";
import { getAvatarPlaceholder } from "@/lib/utils";
import { useScanStore } from "@/stores/scanStore";
import { EntryButtonId } from "@/stores/operatorStore";
import type { Recommendation as OperatorRecommendation } from "@/lib/operator-recommend";

export type Recommendation = OperatorRecommendation;

interface ScanConfirmationProps {
  student: Student;
  recommendation?: Recommendation | null;
  onConfirm: (
    direction: ScanDirection,
    reason?: ExitReason | string,
    entryType?: "hosteller" | "day_scholar",
    buttonId?: EntryButtonId
  ) => void | Promise<void>;
  onCancel: () => void;
  campusStatus: "IN" | "OUT" | null;
  currentEntryType?: "hosteller" | "day_scholar" | null;
}

export function ScanConfirmation({
  student,
  recommendation: recommendationProp,
  onConfirm,
  onCancel,
  campusStatus,
  currentEntryType,
}: ScanConfirmationProps) {
  // Part 6: narrow subscription — getRecommendation lives on the scan store
  const getRecommendation = useScanStore((s) => s.getRecommendation);
  const recommendation =
    recommendationProp ?? getRecommendation(student, 0) ?? null;

  // 2-second photo-verification countdown: the confirm button stays
  // disabled until the operator has had a moment to compare the
  // student's face to the photo/badge.
  const [countdown, setCountdown] = useState(2);
  useEffect(() => {
    if (countdown <= 0) return;
    const t = setTimeout(() => setCountdown((c) => c - 1), 1000);
    return () => clearTimeout(t);
  }, [countdown]);

  const entryTypeToUse: "hosteller" | "day_scholar" =
    currentEntryType ?? recommendation?.entryType ?? "hosteller";
  const altEntryType = (v: "hosteller" | "day_scholar" | null | undefined): "hosteller" | "day_scholar" | undefined =>
    v ?? undefined;
  const entryBadge = entryTypeToUse === "day_scholar" ? "Day Scholar" : "Hosteller";
  const primaryButtonId: EntryButtonId | null = recommendation?.entryButton ?? "home_in";
  const primaryLabel =
    recommendation?.direction === "OUT" ? "Exit" : "Home In";

  const alternatives = recommendation?.alternatives ?? [];

  return (
    <motion.div
      initial={{ opacity: 0, y: -10 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.16 }}
      className="surface-card pointer-events-auto w-full max-w-md mx-auto bg-bg-surface p-4 space-y-3"
    >
      <div className="flex items-center gap-3">
        <img
          src={student.photo || getAvatarPlaceholder(student.name || "??")}
          alt={student.name || "Student"}
          width={56}
          height={56}
          className="size-5 rounded-xl object-cover shrink-0 border border-border"
        />
        <div className="min-w-4 flex-1">
          <p className="font-bold text-sm text-text-primary truncate">
            {student.name || student.roll || student.uniqueId}
          </p>
          <p className="text-xs font-mono text-text-muted truncate">
            {student.roll || student.studentDetails?.roll || student.uniqueId}
          </p>
          <span
            className={`inline-block text-xs font-bold px-2 py-0.5 rounded-full border mt-1 ${
              entryTypeToUse === "day_scholar"
                ? "bg-sky-500/15 text-action-info border-sky-500/30"
                : "bg-emerald-500/15 text-action-success border-emerald-500/30"
            }`}
          >
            {entryBadge}
          </span>
        </div>
        {campusStatus && (
          <span
            className={`text-xs font-bold px-2 py-1 rounded-full border ${
              campusStatus === "IN"
                ? "bg-emerald-500/15 text-action-success border-emerald-500/30"
                : "bg-amber-500/15 text-action-warning border-amber-500/30"
            }`}
          >
            {campusStatus === "IN" ? "On campus" : "Out"}
          </span>
        )}
      </div>

      <AnimatePresence mode="wait">
        {countdown > 0 && (
          <motion.div
            key="countdown"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="flex items-center justify-center gap-2 text-xs text-text-muted py-2"
          >
            <Clock className="w-3.5 h-3.5" />
            Verify photo · {countdown}s
          </motion.div>
        )}
      </AnimatePresence>

      <div className="space-y-2">
        <button
          type="button"
          disabled={countdown > 0}
          onClick={() =>
            void onConfirm(
              recommendation?.direction ?? (campusStatus === "IN" ? "OUT" : "IN"),
              recommendation?.reason ?? undefined,
              entryTypeToUse,
              primaryButtonId ?? undefined
            )
          }
          className="w-full min-h13 rounded-xl bg-action-primary text-black font-extrabold text-base flex items-center justify-center gap-2 active:scale-[0.99] transition-transform disabled:opacity-40 disabled:cursor-not-allowed"
        >
          {recommendation?.direction === "OUT" ? (
            <LogOut className="w-5 h-5" />
          ) : (
            <Home className="w-5 h-5" />
          )}
          {countdown > 0 ? `Home In (${countdown})` : primaryLabel}
        </button>

        {alternatives.slice(0, 2).map((alt) => (
          <button
            key={alt.code}
            type="button"
            disabled={countdown > 0}
            onClick={() =>
              void onConfirm(
                alt.payload.direction,
                alt.label,
                altEntryType(alt.payload.entryType),
                alt.payload.buttonId ?? undefined
              )
            }
            className="w-full min-h-11 rounded-xl bg-bg-elevated border border-border text-text-secondary font-semibold text-sm flex items-center justify-center gap-2 active:scale-[0.99] transition-transform disabled:opacity-40"
          >
            <Check className="w-4 h-4" />
            {alt.label}
          </button>
        ))}

        <button
          type="button"
          onClick={onCancel}
          className="w-full min-h10 rounded-xl text-xs font-semibold text-text-muted hover:text-text-primary transition-colors"
        >
          Cancel & resume scanning
        </button>
      </div>
    </motion.div>
  );
}

export default ScanConfirmation;
</file>

<file path="src/components/operator/ScanDetailModal.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  X,
  ArrowDownLeft,
  ArrowUpRight,
  ShieldCheck,
  History,
  Loader2,
  Pencil,
  Clock,
  AlertTriangle,
} from "lucide-react";
import type { Scan, Person } from "@/lib/types";
import { useAuthStore } from "@/stores/authStore";
import { EditableField } from "@/components/shared/EditableField";
import { DurationBar } from "@/components/shared/DurationBar";
import { getAuthHeaders } from "@/lib/utils";

interface ScanDetailModalProps {
  scan: Scan | null;
  onClose: () => void;
  /** Called after a scan category edit succeeds. Triggers refresh. */
  onEditComplete?: () => void;
}

interface ScanCategoryEdit {
  scanId: string;
  category: string;
  reason: string;
  editedBy: string;
  editedAt: string;
}

/** Fetch scan category edits from the audit trail. */
async function fetchScanEdits(scanId: string): Promise<ScanCategoryEdit[]> {
  try {
    const res = await fetch(`/api/operator/scans/${encodeURIComponent(scanId)}/edits`, {
      headers: getAuthHeaders(),
      cache: "no-store",
    });
    const body = await res.json().catch(() => null);
    if (!res.ok || !body?.data) return [];
    return body.data as ScanCategoryEdit[];
  } catch {
    return [];
  }
}

interface PersonPayload {
  person: Person;
  campusStatus?: string;
  lastScan?: Scan | null;
  history?: Scan[];
}

export function ScanDetailModal({ scan, onClose, onEditComplete }: ScanDetailModalProps) {
  const [payload, setPayload] = useState<PersonPayload | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [edits, setEdits] = useState<ScanCategoryEdit[]>([]);
  const [editsLoading, setEditsLoading] = useState(false);
  const [editingCategory, setEditingCategory] = useState(false);

  // Load the person overview + prior category edits
  useEffect(() => {
    if (!scan) {
      setPayload(null);
      setError(null);
      setEdits([]);
      return;
    }
    let cancelled = false;
    const load = async () => {
      setLoading(true);
      setError(null);
      try {
        const auth = useAuthStore.getState();
        const headers: Record<string, string> = {};
        if (auth.token) headers["Authorization"] = `Bearer ${auth.token}`;
        if (auth.user?.currentSessionToken) headers["X-Session-Token"] = auth.user.currentSessionToken;
        const idParam = encodeURIComponent(scan.uniqueId || scan.roll || "");
        const res = await fetch(`/api/persons/${idParam}`, { headers });
        const json = await res.json().catch(() => null);
        if (cancelled) return;
        if (res.ok && json?.success) setPayload(json.data as PersonPayload);
        else setError(json?.error?.message || "Could not load person overview");
      } catch {
        if (!cancelled) setError("Network error while loading overview");
      } finally {
        if (!cancelled) setLoading(false);
      }
    };
    load();
    return () => {
      cancelled = true;
    };
  }, [scan]);

  // Load edit trail when a scan with an id is open
  useEffect(() => {
    if (!scan?.id) return;
    let cancelled = false;
    setEditsLoading(true);
    fetchScanEdits(scan.id).then((list) => {
      if (!cancelled) {
        setEdits(list);
        setEditsLoading(false);
      }
    });
    return () => {
      cancelled = true;
    };
  }, [scan?.id]);

  const handleCategoryEdit = async (newCategory: string, reason: string) => {
    if (!scan?.id) return;
    await fetch(`/api/operator/scans/${scan.id}/category`, {
      method: "PATCH",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({ category: newCategory, reason }),
    });
    setEditingCategory(false);
    // Refresh the edit trail
    setEditsLoading(true);
    fetchScanEdits(scan.id).then((list) => {
      setEdits(list);
      setEditsLoading(false);
    });
    onEditComplete?.();
  };

  // Time-range of validity: entry→exit if both present, else just the scan moment
  const scanStart = scan?.timestamp ?? new Date().toISOString();
  const scanEnd = payload?.lastScan?.timestamp ?? scanStart;
  const durationMs = Math.max(0, new Date(scanEnd).getTime() - new Date(scanStart).getTime());

  if (!scan) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/60 backdrop-blur-sm" role="presentation" onClick={onClose}>
      <div
        className="surface-card bg-bg-surface sm: w-full max-w-md max-h-[85dvh] overflow-y-auto p-5 space-y-4"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Header */}
        <div className="flex items-start justify-between gap-3">
          <div>
            <h3 className="text-base font-bold">{payload?.person?.fullName || scan.name}</h3>
            <p className="text-xs font-mono text-text-muted">
              {payload?.person?.uniqueId || scan.roll}
              {payload?.person?.personType ? ` · ${payload.person.personType}` : ""}
              {payload?.campusStatus ? (
                <span className={`ml-2 font-bold ${payload.campusStatus === "IN" ? "text-action-success" : "text-action-danger"}`}>
                  ON CAMPUS: {payload.campusStatus}
                </span>
              ) : null}
            </p>
          </div>
          <button onClick={onClose} className="surface-card p-1.5 hover:bg-bg-base">
            <X className="w-4 h-4" />
          </button>
        </div>

        {loading ? (
          <div className="flex items-center justify-center gap-2 py-8 text-sm text-text-muted">
            <Loader2 className="w-4 h-4 animate-spin" /> Loading overview…
          </div>
        ) : error ? (
          <div className="surface-card text-xs text-action-warning bg-amber-400/10 p-3">{error}</div>
        ) : null}

        {/* This scan */}
        <div className={`rounded-xl p-4 space-y-2 border ${scan.direction === "IN" ? "border-emerald-500/30 bg-emerald-500/5" : "border-red-500/30 bg-red-500/5"}`}>
          <p className="text-xs uppercase font-bold tracking-wider text-text-muted">This Record</p>
          <div className="flex items-center gap-3">
            {scan.direction === "IN" ? (
              <ArrowDownLeft className="w-6 h-6 text-action-success" />
            ) : (
              <ArrowUpRight className="w-6 h-6 text-action-danger" />
            )}
            <div>
              <p className={`font-bold text-sm ${scan.direction === "IN" ? "text-action-success" : "text-action-danger"}`}>
                {scan.direction === "IN" ? "ENTRY" : "EXIT"}
                {scan.reason ? <span className="ml-2 text-xs font-semibold text-text-secondary">({scan.reason})</span> : null}
              </p>
              <p className="text-xs text-text-muted">
                {new Date(scan.timestamp).toLocaleString()} · {scan.gateName || "Gate"}
              </p>
            </div>
          </div>

          {/* Scan category — editable with audit reason */}
          <div className="pt-1">
            {editingCategory ? (
              <EditableField
                value={scan.reason ?? "No category"}
                onSave={handleCategoryEdit}
                fieldLabel="scan category"
              />
            ) : (
              <div className="flex items-center gap-2">
                <span className="text-xs text-text-muted">Category</span>
                <span className="text-xs font-bold text-text-primary">{scan.reason ?? "—"}</span>
                <button
                  type="button"
                  onClick={() => setEditingCategory(true)}
                  className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary"
                  title="Edit scan category (with reason)"
                >
                  <Pencil className="h-4 w-4" />
                </button>
              </div>
            )}
          </div>

          <p className="text-xs text-text-secondary inline-flex items-center gap-1.5 pt-1 flex-wrap">
            <ShieldCheck className="w-3.5 h-3.5 textfocus-ring" />
            Processed by operator: <span className="font-bold text-text-primary">{scan.operatorName || "—"}</span>
            {scan.isManual ? <span className="surface-card px-1.5 py-0.5 bg-amber-400/15 text-action-warning text-xs font-bold">MANUAL</span> : null}
            {scan.isCorrection ? <span className="surface-card px-1.5 py-0.5 bg-sky-400/15 text-action-info text-xs font-bold">CORRECTION</span> : null}
          </p>
        </div>

        {/* Time-range of validity */}
        {durationMs > 0 && (
          <div className="rounded-xl border border-border bg-bg-elevated p-3 space-y-2">
            <p className="text-xs uppercase font-bold tracking-wider text-text-muted inline-flex items-center gap-1.5">
              <Clock className="w-3.5 h-3.5" /> Time range
            </p>
            <DurationBar elapsedMs={durationMs} totalMs={durationMs} tone="info" />
            <div className="flex items-center justify-between text-xs text-text-muted">
              <span>{new Date(scanStart).toLocaleString()}</span>
              <span>{new Date(scanEnd).toLocaleString()}</span>
            </div>
          </div>
        )}

        {/* Dispute / edit trail */}
        {edits.length > 0 && (
          <div className="rounded-xl border border-amber-500/20 bg-amber-500/5 p-3 space-y-2">
            <p className="text-xs uppercase font-bold tracking-wider text-text-muted inline-flex items-center gap-1.5">
              <AlertTriangle className="w-3.5 h-3.5 text-amber-500" /> Category edit trail
            </p>
            <div className="space-y-1.5">
              {edits.map((e, i) => (
                <div key={i} className="text-xs text-text-secondary flex items-start gap-1.5">
                  <span className="font-medium text-text-primary shrink-0">{e.category}</span>
                  <span className="flex-1 truncate">{e.reason}</span>
                  <span className="text-text-muted shrink-0 tabular-nums">{e.editedAt.slice(0, 10)}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Person details from API */}
        {payload?.person ? (
          <div className="grid grid-cols-2 gap-2 text-xs">
            {[
              ["Department", payload.person.department],
              ["Designation", payload.person.designation],
              ["Year", payload.person.year != null ? String(payload.person.year) : undefined],
              ["Section", payload.person.section],
              ["Hostel Block", payload.person.hostelBlock],
              ["Room", payload.person.roomNumber],
            ]
              .filter((pair) => !!pair[1])
              .map(([k, v]) => (
                <div key={k} className="surface-card bg-bg-base px-3 py-2">
                  <p className="text-xs uppercase font-bold text-text-muted">{k}</p>
                  <p className="font-semibold truncate">{v}</p>
                </div>
              ))}
          </div>
        ) : null}

        {/* Movement history */}
        {payload?.history && payload.history.length > 0 ? (
          <div className="space-y-2">
            <p className="text-xs uppercase font-bold tracking-wider text-text-muted inline-flex items-center gap-1.5">
              <History className="w-3.5 h-3.5" /> Recent Movements
            </p>
            <div className="space-y-1 max-h-44 overflow-y-auto pr-1">
              {payload.history.slice(0, 12).map((h) => (
                <div key={h.id} className="surface-card flex items-center justify-between text-xs px-2 py-1.5 bg-bg-base">
                  <span className={`inline-flex items-center gap-1 font-bold ${h.direction === "IN" ? "text-action-success" : "text-action-danger"}`}>
                    {h.direction === "IN" ? <ArrowDownLeft className="size-3.5" /> : <ArrowUpRight className="size-3.5" />}
                    {h.direction === "IN" ? "Entry" : "Exit"}
                  </span>
                  <span className="text-text-muted">{new Date(h.timestamp).toLocaleString()}</span>
                </div>
              ))}
            </div>
          </div>
        ) : null}
      </div>
    </div>
  );
}
</file>

<file path="src/components/operator/Scanner.tsx">
"use client";

import React, { useEffect, useRef, useState, useCallback } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { Camera, X, RefreshCw, AlertTriangle, KeyRound, Volume2, VolumeX, Upload } from "lucide-react";
import { playAudioFeedback } from "@/lib/sound";
import jsQR from "jsqr";
import { SCANNABLE_FORMATS, normalizeScannedPayload } from "@/lib/barcode";

type ScanMode = "qr" | "barcode" | "all";
type FormatScope = ScanMode | "all";

// QR codes decode via jsQR (universal, no API support needed). Linear/2D
// barcodes decode via the native BarcodeDetector API, restricted per tab so
// each mode auto-detects exactly what it's meant to catch.
const QR_FORMATS: string[] = ["qr_code"];
const BARCODE_FORMATS: string[] = SCANNABLE_FORMATS.filter((f) => f !== "qr_code");

// ── Module-level native API detection ────────────────────────────────────────
// requestVideoFrameCallback is the most efficient way to sync to decoded
// video frames; fall back to a ~15fps rAF tick when unavailable.
const HAS_RVFC: boolean =
  typeof window !== "undefined" &&
  "requestVideoFrameCallback" in HTMLVideoElement.prototype;

const hasNativeBarcodeDetector: boolean =
  typeof window !== "undefined" && "BarcodeDetector" in window;

const formatCache: Record<string, string[]> = {};
const getUsableFormats = async (scope: FormatScope) => {
  const wanted = scope === "qr" ? QR_FORMATS : scope === "barcode" ? BARCODE_FORMATS : [...SCANNABLE_FORMATS];
  const key = wanted.join(",");
  if (formatCache[key]) return formatCache[key];
  let detectorFormats: string[] = [];
  if (hasNativeBarcodeDetector) {
    try {
      detectorFormats = await window.BarcodeDetector!.getSupportedFormats();
    } catch { detectorFormats = []; }
  }
  formatCache[key] = wanted.filter((f) => detectorFormats.includes(f));
  return formatCache[key];
};

// ── Per-gate camera stream cache ──────────────────────────────────────────────
// The operator is pinned to a fixed gate (user.gateId). When they flip between
// the desk's gate views / reopen the scanner, the browser already knows the
// camera is allowed, so reuse the live MediaStream keyed by gate instead of
// calling getUserMedia again (avoids the permission-prompt flicker and the
// ~400ms device re-open cost). The stream is only reclaimed on full unload.
const gateStreamCache: Record<string, MediaStream> = {};

// ── Cached native QR BarcodeDetector (lazily created, reused every frame) ───
let qrDetectorInstance: BarcodeDetector | null = null;
function getQrDetector(): BarcodeDetector | null {
  if (qrDetectorInstance) return qrDetectorInstance;
  if (!hasNativeBarcodeDetector) return null;
  try {
    // Confirm qr_code is actually supported before constructing; on some
    // engines BarcodeDetector exists but doesn't support qr_code.
    // We defer the supported-formats check to the call site (async); this
    // just caches the constructor so we don't re-instantiate every frame.
    qrDetectorInstance = new window.BarcodeDetector!({ formats: QR_FORMATS });
    return qrDetectorInstance;
  } catch {
    return null;
  }
}

// Cached native barcode detector (barcode mode)
let barcodeDetectorInstance: BarcodeDetector | null = null;
function getBarcodeDetector(): BarcodeDetector | null {
  if (barcodeDetectorInstance) return barcodeDetectorInstance;
  if (!hasNativeBarcodeDetector) return null;
  try {
    barcodeDetectorInstance = new window.BarcodeDetector!({ formats: BARCODE_FORMATS });
    return barcodeDetectorInstance;
  } catch {
    return null;
  }
}

interface ScannerModalProps {
  isOpen: boolean;
  /**
   * When false the decode loop pauses early (no jsQR work per frame).
   * The parent uses this to stop decoding while a scan is being confirmed.
   */
  active?: boolean;
  onClose: () => void;
  onScan: (roll: string) => void;
  onManualEntryClick?: () => void;
  /** The operator's fixed gate — used to key the stream cache; no UI picking. */
  gateId?: string;
  /** Which scan mode the operator chose before opening (QR-only or barcode-only). */
  initialMode?: ScanMode;
  /**
   * Parent-controlled mode. When present and different from the internal mode
   * state, the internal mode switches in place (no unmount/restart of the
   * decode loop). The parent's bottom mode-bar uses this instead of re-
   * seeding initialMode. Keeps the camera stream warm across switches.
   */
  mode?: ScanMode;
}

export function Scanner({
  isOpen,
  active = true,
  onClose,
  onScan,
  onManualEntryClick,
  gateId,
  initialMode = "all",
  mode: modeProp,
}: ScannerModalProps) {
  const videoRef = useRef<HTMLVideoElement | null>(null);
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const timerRef = useRef<NodeJS.Timeout | null>(null);
  const animationFrameRef = useRef<number | null>(null);
  const isScanningRef = useRef<boolean>(false);
  const hasScannedRef = useRef<boolean>(false);
  const processFrameRef = useRef<() => void>(() => {});
  const lastDecodeRef = useRef<number>(0);
  const activeRef = useRef<boolean>(active);
  const rvfAvailableRef = useRef<boolean>(HAS_RVFC);

  const [cameraState, setCameraState] = useState<"idle" | "requesting" | "active" | "error">(
    // Pre-seed "requesting" so the very first paint (before the mount
    // effect fires startCamera a tick later) already shows the spinner.
    // Without this, a 1-frame "idle" flash renders between mount and the
    // effect, which reads as the camera "not opening at instant".
    "requesting",
  );
  const [errorMessage, setErrorMessage] = useState<string>("");
  const [soundEnabled, setSoundEnabled] = useState(true);
  const [mode, setMode] = useState<ScanMode>(initialMode);
  const modeRef = useRef<ScanMode>(initialMode);
  const [barcodeApiAvailable, setBarcodeApiAvailable] = useState(false);
  const fileInputRef = useRef<HTMLInputElement | null>(null);

  // Keep the selected mode in sync with the mode the operator chose before
  // opening the modal (the viewfinder's Scan QR / Scan Barcode buttons).
  useEffect(() => {
    if (isOpen) {
      setMode(initialMode);
      modeRef.current = initialMode;
      hasScannedRef.current = false;
    }
  }, [isOpen, initialMode]);

  // Parent-controlled mode switch (no unmount, stream stays warm).
  useEffect(() => {
    if (modeProp) switchMode(modeProp);
  }, [modeProp]);

  // Detect whether the phone's browser can auto-detect barcodes natively.
  useEffect(() => {
    setBarcodeApiAvailable(hasNativeBarcodeDetector);
  }, []);

  const switchMode = useCallback((next: ScanMode) => {
    setMode(next);
    modeRef.current = next;
    hasScannedRef.current = false;
  }, []);

  const playBeep = useCallback(() => {
    if (!soundEnabled) return;
    playAudioFeedback("success");
  }, [soundEnabled]);

  const stopCamera = useCallback(() => {
    isScanningRef.current = false;
    if (timerRef.current) {
      clearInterval(timerRef.current);
      timerRef.current = null;
    }
    if (animationFrameRef.current) {
      cancelAnimationFrame(animationFrameRef.current);
      animationFrameRef.current = null;
    }
    // Return the stream to the per-gate cache (don't stop the track — that's
    // what lets the next open on the same gate skip permission + device re-open).
    if (streamRef.current) {
      if (gateId) {
        gateStreamCache[gateId] = streamRef.current;
      } else {
        streamRef.current.getTracks().forEach((t) => t.stop());
      }
      streamRef.current = null;
    }
    if (videoRef.current) {
      videoRef.current.srcObject = null;
    }
    setCameraState("idle");
  }, [gateId]);

  /**
   * Park the live stream in the per-gate cache WITHOUT clearing
   * videoRef.srcObject and WITHOUT stopping the decode loop.  The stream stays
   * warm on the <video> element; the loop continues ticking (paused by the
   * parent via active=false).  Used after a successful scan so the camera is
   * instantly available for the next scan.
   */
  const parkStream = useCallback(() => {
    if (streamRef.current) {
      if (gateId) {
        gateStreamCache[gateId] = streamRef.current;
      }
      streamRef.current = null;
      // NOTE: videoRef.current.srcObject is deliberately left intact so the
      // <video> element keeps showing the live feed (stream is not stopped).
    }
    // Decode loop stays alive; hasScannedRef re-arms on the next frame.
    isScanningRef.current = true;
  }, [gateId]);

  const handleSuccessScan = useCallback((rawScannedData: string) => {
    const scannedData = normalizeScannedPayload(rawScannedData);
    if (hasScannedRef.current || !scannedData) return;
    hasScannedRef.current = true;

    playBeep();

    if (typeof window !== "undefined" && "navigator" in window && window.navigator.vibrate) {
      try {
        window.navigator.vibrate([100, 50, 100]);
      } catch {
        // Ignore vibration error
      }
    }

    // Park the stream (camera stays warm, decode loop keeps ticking, paused
    // by the parent via active=false).  Fire onScan + onClose immediately.
    parkStream();
    onScan(scannedData);
    onClose();

    // Re-arm: the next frame will process again even though the stream is
    // parked (active gate from the parent will flip back to true on reopen).
    hasScannedRef.current = false;
    isScanningRef.current = true;
  }, [parkStream, onScan, onClose, playBeep]);

  const handleImageFileChange = useCallback((event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;

    // Validate file type
    const allowedTypes = ["image/jpeg", "image/jpg", "image/png", "image/webp"];
    if (!allowedTypes.includes(file.type)) {
      setErrorMessage("Invalid file type. Please upload a PNG, JPEG, or WEBP image.");
      if (event.target) {
        event.target.value = "";
      }
      return;
    }

    // Limit file size to 5MB
    const maxSizeBytes = 5 * 1024 * 1024;
    if (file.size > maxSizeBytes) {
      setErrorMessage("Image is too large. Please upload an image smaller than 5MB.");
      if (event.target) {
        event.target.value = "";
      }
      return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement("canvas");
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext("2d");
        if (ctx) {
          ctx.drawImage(img, 0, 0);
          const imageData = ctx.getImageData(0, 0, img.width, img.height);
          const decodeQR = typeof jsQR === "function" ? jsQR : ((jsQR as unknown as { default?: typeof jsQR }).default ?? null);
          if (decodeQR) {
            try {
              const code = decodeQR(imageData.data, imageData.width, imageData.height, {
                inversionAttempts: "dontInvert",
              });
              const roll = normalizeScannedPayload(code?.data || "");
              if (roll) {
                playBeep();
                if (typeof window !== "undefined" && "navigator" in window && window.navigator.vibrate) {
                  window.navigator.vibrate([100, 50, 100]);
                }
                stopCamera();
                onScan(roll);
                onClose();
                return;
              }
            } catch (err) {
              console.error("jsQR upload process error:", err);
            }
          }

          // Browser BarcodeDetector fallback
          if (hasNativeBarcodeDetector) {
            getUsableFormats("all").then((usableFormats) => {
              if (usableFormats.length === 0) return;
              try {
                const detector = new window.BarcodeDetector!({ formats: [...usableFormats] });
                detector
                  .detect(canvas)
                  .then((barcodes: Array<{ rawValue: string }>) => {
                    const roll = normalizeScannedPayload(barcodes?.[0]?.rawValue || "");
                    if (roll) {
                      playBeep();
                      stopCamera();
                      onScan(roll);
                      onClose();
                    } else {
                      setErrorMessage("Could not detect any QR/Barcode in the uploaded image. Please try a clearer picture.");
                    }
                  })
                  .catch(() => {
                    setErrorMessage("Could not detect any QR/Barcode in the uploaded image. Please try a clearer picture.");
                  });
              } catch {
                // fallback
              }
            });
          } else {
            setErrorMessage("Could not decode code from the uploaded image. Please make sure it is centered and clear.");
          }
        }
      };
      img.src = e.target?.result as string;
    };
    reader.readAsDataURL(file);
  }, [playBeep, stopCamera, onClose, onScan]);

  // jsQR fallback helper (sync — called synchronously in the QR path when the
  // native detector returned nothing or threw for this frame).
  const runJsQrFallback = useCallback((canvas: HTMLCanvasElement, onSuccess: (raw: string) => void) => {
    const context = canvas.getContext("2d");
    if (!context) return;
    const imageData = context.getImageData(0, 0, canvas.width, canvas.height);
    const decodeQR = typeof jsQR === "function" ? jsQR : ((jsQR as unknown as { default?: typeof jsQR }).default ?? null);
    if (!decodeQR) return;
    try {
      const code = decodeQR(imageData.data, imageData.width, imageData.height, {
        inversionAttempts: "dontInvert",
      });
      if (code && code.data && code.data.trim().length > 0) {
        onSuccess(code.data.trim());
      }
    } catch (err) {
      console.error("jsQR fallback error:", err);
    }
  }, []);

  // processFrame defined and stored in ref to avoid stale closures.
  //
  // QR path: try the cached native BarcodeDetector first (async, non-blocking),
  // fall back to jsQR when the detector is absent or returns nothing for this
  // frame.  Barcode path: use the cached native detector for 1D/2D formats.
  const processFrame = useCallback(() => {
    if (!isScanningRef.current || hasScannedRef.current) return;
    const video = videoRef.current;
    const canvas = canvasRef.current;

    if (!video || !canvas || video.readyState !== video.HAVE_ENOUGH_DATA) {
      return;
    }

    const targetWidth = video.videoWidth || 640;
    const targetHeight = video.videoHeight || 480;
    // Downscale to 640px wide before decoding — ~4x faster, still decodes
    // 20cm QR codes and most 1D barcodes comfortably.
    const DECODE_WIDTH = 640;
    const scale = Math.min(1, DECODE_WIDTH / targetWidth);
    canvas.width = Math.round(targetWidth * scale);
    canvas.height = Math.round(targetHeight * scale);

    const context = canvas.getContext("2d", { willReadFrequently: true });
    if (!context) return;

    context.drawImage(video, 0, 0, targetWidth, targetHeight);

    const activeMode = modeRef.current;

    // ── "all" mode (desk default): one detector pass for QR AND 1D/2D
    //    barcodes — the operator never picks a scan mode. QR is decoded by
    //    the native detector with the jsQR fallback; barcodes ride the same
    //    frame via the native BarcodeDetector when the browser has one. ──
    if (activeMode === "all") {
      const qrDetector = getQrDetector();
      if (qrDetector) {
        qrDetector
          .detect(canvas)
          .then((barcodes) => {
            const hit = barcodes?.find((b) => b && b.rawValue);
            if (hit) {
              handleSuccessScan(hit.rawValue);
              return;
            }
            runJsQrFallback(canvas, handleSuccessScan);
          })
          .catch(() => {
            runJsQrFallback(canvas, handleSuccessScan);
          });
      } else {
        runJsQrFallback(canvas, handleSuccessScan);
      }
      const barcodeDetector = getBarcodeDetector();
      if (barcodeDetector) {
        barcodeDetector
          .detect(canvas)
          .then((barcodes: Array<{ rawValue: string }>) => {
            if (barcodes && barcodes.length > 0 && barcodes[0].rawValue) {
              handleSuccessScan(barcodes[0].rawValue);
            }
          })
          .catch(() => {});
      }
      return;
    }

    // ── QR mode ───────────────────────────────────────────────────────────────
    if (activeMode === "qr") {
      const qrDetector = getQrDetector();
      if (qrDetector) {
        // Native async path (non-blocking): fires .detect(canvas) and
        // processes results in a promise — the decode loop continues.
        qrDetector
          .detect(canvas)
          .then((barcodes: Array<{ rawValue: string }>) => {
            if (barcodes && barcodes.length > 0 && barcodes[0].rawValue) {
              handleSuccessScan(barcodes[0].rawValue);
              return;
            }
            // No native hit → fall back to jsQR for this frame.
            runJsQrFallback(canvas, handleSuccessScan);
          })
          .catch(() => {
            // Native detector threw → fall back to jsQR.
            runJsQrFallback(canvas, handleSuccessScan);
          });
      } else {
        // No native QR detector available — pure jsQR path.
        runJsQrFallback(canvas, handleSuccessScan);
      }
      return;
    }

    // ── Barcode mode (1D / 2D, not QR) ──────────────────────────────────────
    if (activeMode === "barcode") {
      const barcodeDetector = getBarcodeDetector();
      if (barcodeDetector) {
        barcodeDetector
          .detect(canvas)
          .then((barcodes: Array<{ rawValue: string }>) => {
            if (barcodes && barcodes.length > 0 && barcodes[0].rawValue) {
              handleSuccessScan(barcodes[0].rawValue);
            }
          })
          .catch(() => {});
      }
    }
  }, [handleSuccessScan, runJsQrFallback]);

  // Keep activeRef in sync so the decode tick always sees the latest value.
  useEffect(() => {
    activeRef.current = active;
    if (!active) {
      lastDecodeRef.current = 0;
    }
  }, [active]);

  // Keep processFrameRef in sync so the decode tick always calls the latest.
  useEffect(() => {
    processFrameRef.current = processFrame;
  }, [processFrame]);

  /**
   * Decode loop.
   *
   *  • Native path (rVFC): every call to requestVideoFrameCallback fires
   *    exactly once per decoded video frame (~30–60fps on a phone).  No
   *    time gate needed — processFrame runs on every frame.
   *
   *  • rAF fallback (~15fps): gate with lastDecodeRef ≥ 66ms so we don't
   *    run jsQR on every rAF tick (~16ms).
   */
  const startDecodeLoop = useCallback(() => {
    if (!videoRef.current) return;

    const tick = () => {
      if (!isScanningRef.current) {
        animationFrameRef.current = null;
        return;
      }
      // When the parent disables decoding (active=false) bail out early and
      // release the RAF/rVFC so no frame work happens.
      if (!activeRef.current) {
        animationFrameRef.current = null;
        return;
      }
      processFrameRef.current();

      if (rvfAvailableRef.current && videoRef.current) {
        // Native: next decoded video frame.
        videoRef.current.requestVideoFrameCallback(() => tick());
      } else {
        // Fallback: ~15fps rAF gate.
        const now = performance.now();
        if (now - lastDecodeRef.current >= 66) {
          lastDecodeRef.current = now;
        }
        animationFrameRef.current = requestAnimationFrame(tick);
      }
    };

    // Fire the first tick immediately so the first frame is processed the
    // moment it arrives — no debounce delay on startup.
    lastDecodeRef.current = 0;
    processFrameRef.current();

    if (rvfAvailableRef.current && videoRef.current) {
      // rVFC path: schedule on the next decoded frame.
      videoRef.current.requestVideoFrameCallback(() => tick());
    } else {
      animationFrameRef.current = requestAnimationFrame(tick);
    }
  }, []);

  const startCamera = useCallback(async () => {
    // Stop the current loop but DON'T stop the track if we have a cached
    // stream for this gate — we'll reuse it below.
    isScanningRef.current = false;
    if (timerRef.current) { clearInterval(timerRef.current); timerRef.current = null; }
    if (animationFrameRef.current) {
      cancelAnimationFrame(animationFrameRef.current);
      animationFrameRef.current = null;
    }
    setCameraState("requesting");
    setErrorMessage("");
    hasScannedRef.current = false;

    // 1. Per-gate cache hit: stream is already open, skip permission + device
    //    re-open entirely. ~0ms to first frame vs ~400ms cold start.
    if (gateId && gateStreamCache[gateId]) {
      const cached = gateStreamCache[gateId];
      const live = cached.getTracks().filter((t) => t.readyState === "live");
      if (live.length > 0 && videoRef.current) {
        streamRef.current = cached;
        videoRef.current.srcObject = cached;
        videoRef.current.setAttribute("playsinline", "true");
        try {
          await videoRef.current.play();
        } catch { /* autoplay blocked; state still active */ }
        setCameraState("active");
        isScanningRef.current = true;
        startDecodeLoop();
        return;
      } else {
        // cached stream is stale — stop it and fall through to cold start
        cached.getTracks().forEach((t) => t.stop());
        delete gateStreamCache[gateId];
      }
    }

    // 2. Cold start: request camera with facingMode environment + low-res
    //    constraint first for the fastest possible start on phones.
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      setCameraState("error");
      setErrorMessage("Live camera feed requires HTTPS or localhost browser security permissions.");
      return;
    }

    try {
      let stream: MediaStream;
      try {
        // 640x480 environment — fastest opening path; QR decodes fine at
        // this resolution (processFrame downscales to 640px anyway).
        stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "environment", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        });
      } catch {
        try {
          stream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: "environment" },
            audio: false,
          });
        } catch {
          stream = await navigator.mediaDevices.getUserMedia({
            video: true,
            audio: false,
          });
        }
      }
      // A stopCamera (unmount / isOpen→false / active→false) can run between
      // the getUserMedia await and here; it clears streamRef AND sets
      // isScanningRef=false. If that happened, parking the freshly-opened
      // stream would race the unmount (we'd adopt a stream on a component that
      // is tearing down) — so cache it (don't leak the device) and return.
      // On a normal cold start isScanningRef was just reset to false at the
      // top of startCamera, so use videoRef (present only when mounted+open)
      // as the liveness signal: no video element = we're stopped/unmounted.
      if (!videoRef.current) {
        if (gateId) gateStreamCache[gateId] = stream;
        else stream.getTracks().forEach((t) => t.stop());
        return;
      }
      streamRef.current = stream;
      if (gateId) gateStreamCache[gateId] = stream;

      if (videoRef.current) {
        videoRef.current.srcObject = stream;
        videoRef.current.setAttribute("playsinline", "true");
        await videoRef.current.play();
        setCameraState("active");
        isScanningRef.current = true;
        startDecodeLoop();
      }
    } catch (err: unknown) {
      setCameraState("error");
      const error = err as Error;
      if (error.name === "NotAllowedError" || error.name === "PermissionDeniedError") {
        setErrorMessage("Camera permission was denied. Please allow camera access in browser settings.");
      } else if (error.name === "NotFoundError" || error.name === "DevicesNotFoundError") {
        setErrorMessage("No camera hardware detected on this device.");
      } else {
        setErrorMessage(error.message || "Unable to open camera stream.");
      }
    }
  }, [gateId, startDecodeLoop]);

  useEffect(() => {
    if (isOpen) {
      startCamera();
    } else {
      stopCamera();
    }
    return () => { stopCamera(); };

  }, [isOpen, startCamera, stopCamera]);

  // Kill camera + decode loop when tab hidden (battery, privacy
  // indicator, dead-stream-on-return). pagehide covers iOS tab suspension.
  useEffect(() => {
    if (!isOpen) return;
    const onHidden = () => stopCamera();
    const onVisible = () => { if (isOpen) startCamera(); };
    const onVis = () => (document.hidden ? onHidden() : onVisible());
    const onFreeze = () => stopCamera();
    const onResume = () => { if (isOpen) startCamera(); };
    document.addEventListener("visibilitychange", onVis);
    window.addEventListener("pagehide", onHidden);
    document.addEventListener("freeze", onFreeze as EventListener);
    document.addEventListener("resume", onResume as EventListener);
    return () => {
      document.removeEventListener("visibilitychange", onVis);
      window.removeEventListener("pagehide", onHidden);
      document.removeEventListener("freeze", onFreeze as EventListener);
      document.removeEventListener("resume", onResume as EventListener);
    };

  }, [isOpen, startCamera, stopCamera]);

  // On full unmount (gate change / page leave) drop cached streams —
  // keeps the memory footprint bounded across sessions.
  useEffect(() => {
    return () => {
      // Only drop if we're actually unmounting, not just closing the modal
      // (stopCamera already handles the close case). If the modal is still
      // open with this gate's live stream, leave it alone — closing the
      // modal will park it back in the cache for the next session.
      if (gateId && gateStreamCache[gateId] && gateStreamCache[gateId] !== streamRef.current) {
        gateStreamCache[gateId].getTracks().forEach((t) => t.stop());
        delete gateStreamCache[gateId];
      }
    };
  }, [gateId]);

  if (!isOpen) return null;

  return (
    <AnimatePresence>
      <div className="fixed inset-0 z-50 bg-black">
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          className="relative w-full h-full flex flex-col overflow-hidden"
        >
          {/* Header — one compact status line. No decoration. */}
          <div className="surface-card flex items-center justify-between px-4 py-2.5 bg-bg-elevated/85 z-10">
            <div className="flex items-center gap-2.5 min-w-0">
              <div className="size-6 bg-bg-elevated text-text-secondary flex items-center justify-center border border-border">
                <Camera className="w-4 h-4" />
              </div>
              <div className="min-w-0">
                <h2 className="text-sm font-bold text-white truncate">
                  {gateId ? `Gate ${gateId}` : "Scanner"}
                </h2>
                <p className="text-xs text-text-muted">Auto-detecting · no re-prompt</p>
              </div>
            </div>
            <div className="flex items-center gap-2">
              <button
                type="button"
                onClick={() => setSoundEnabled(!soundEnabled)}
                className="size-6 rounded-full bg-bg-elevated text-text-muted hover:text-white flex items-center justify-center transition-colors"
                title={soundEnabled ? "Mute" : "Unmute"}
              >
                {soundEnabled ? <Volume2 className="w-4 h-4 text-text-secondary" /> : <VolumeX className="w-4 h-4 text-text-muted" />}
              </button>
              <button
                onClick={() => { stopCamera(); onClose(); }}
                className="size-6 rounded-full bg-bg-elevated text-text-muted hover:text-white flex items-center justify-center transition-colors"
                aria-label="Close"
              >
                <X className="w-4 h-4" />
              </button>
            </div>
          </div>

          {/* No mode row: the desk auto-detects QR and 1D/2D barcodes in one
              pass — the operator never picks a scan mode. */}

          {/* Camera viewfinder — full-bleed: fills everything between the
              status line and the action bar. */}
          <div className="relative flex-1 min-h-0 bg-black overflow-hidden">
            <canvas ref={canvasRef} className="hidden" />
            <video ref={videoRef} className="absolute inset-0 w-full h-full object-cover" playsInline muted autoPlay />

            {/* Warn when the phone's browser can't decode 1D/2D barcodes
                natively so the operator knows live auto-detect is QR-only. */}
            {cameraState === "active" && mode === "all" && !barcodeApiAvailable && (
              <div className="surface-card absolute top-2 left-1/2 -translate-x-1/2 flex items-center gap-1.5 text-xs font-semibold text-action-warning bg-amber-950/80 px-3 py-1.5 pointer-events-none">
                <AlertTriangle className="size-3.5" />
                <span>No native barcode decoder in this browser — QR only · Use Upload below</span>
              </div>
            )}

            {cameraState === "active" && (
              <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none gap-3">
                <div className="w-6 h-6 border border-white/15" />
                <p className="surface-card text-xs font-semibold text-white/90 bg-bg-elevated/70 px-3 py-1">
                  {mode === "qr"
                    ? "Point at a QR code — auto-detecting"
                    : "Point at a barcode (1D/2D) — auto-detecting"}
                </p>
              </div>
            )}
            {cameraState === "requesting" && (
              <div className="absolute inset-0 flex flex-col items-center justify-center bg-bg-elevated text-white space-y-3 p-4 text-center">
                <RefreshCw className="size-6 text-text-muted animate-spin" />
                <p className="text-xs text-text-secondary font-medium">Initializing camera...</p>
              </div>
            )}

            {cameraState === "error" && (
              <div className="absolute inset-0 flex flex-col items-center justify-center bg-bg-elevated/95 text-center p-6 space-y-3">
                <div className="size-6 bg-amber-500/20 text-action-warning flex items-center justify-center border border-amber-500/30">
                  <AlertTriangle className="w-6 h-6" />
                </div>
                <h3 className="text-sm font-bold text-action-warning">Camera Unavailable</h3>
                <p className="text-xs text-text-secondary max-w-xs">{errorMessage}</p>
                {/* The critical next step: live scanning is unavailable, so
                    fall back to manual entry or a photo of the code. Without
                    this, operators saw a dead box and didn't know they could
                    still verify a pass. */}
                <p className="text-xs font-semibold text-text-primary max-w-xs">
                  {onManualEntryClick
                    ? "Live camera scanning is unavailable on this device. Use the manual or photo options below (a campus lockdown, if active, blocks all verification — see the status strip above)."
                    : "Upload a photo of the code below to continue."}
                </p>
                <button
                  type="button"
                  onClick={() => startCamera()}
                  className="surface-card mt-1 px-4 py-2 bg-bg-elevated hover:bg-bg-elevated text-white text-xs font-semibold flex items-center gap-1.5"
                >
                  <RefreshCw className="w-3.5 h-3.5" /> Retry camera
                </button>
              </div>
            )}
          </div>

          {/* Actions — a clearly-separated "if the camera can't read it" row,
              distinct from the page's IN/OUT decision bar. */}
          <div className="surface-card p-4 pt-3 bg-bg-surface">
            <p className="mb-2 text-xs font-bold uppercase tracking-wider text-text-muted">
              Can&#39;t see the code?
            </p>
            <input
              type="file"
              ref={fileInputRef}
              accept="image/*"
              className="hidden"
              onChange={handleImageFileChange}
            />
            <div className="flex flex-col gap-2">
              <div className="flex flex-col sm:flex-row gap-2">
                <button
                  type="button"
                  onClick={() => fileInputRef.current?.click()}
                  className="surface-card w-full sm:flex-1 py-2.5 bg-bg-elevated hover:bg-bg-elevated text-text-secondary font-semibold text-xs transition-all flex items-center justify-center gap-2"
                >
                  <Upload className="w-4 h-4 text-text-muted shrink-0" />
                  <span className="truncate">Upload QR Image</span>
                </button>
                {onManualEntryClick && (
                  <button
                    type="button"
                    onClick={() => { stopCamera(); onManualEntryClick(); }}
                    className="surface-card w-full sm:flex-1 py-2.5 bg-bg-elevated hover:bg-bg-elevated text-text-secondary font-semibold text-xs transition-all flex items-center justify-center gap-2"
                  >
                    <KeyRound className="w-4 h-4 text-text-muted shrink-0" />
                    <span className="truncate">Enter Roll Manually</span>
                  </button>
                )}
              </div>
            </div>
          </div>
        </motion.div>
      </div>
    </AnimatePresence>
  );
}
