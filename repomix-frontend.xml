<file path="src/app/(mess)/mess/operational-requests/page.tsx">
"use client";

import { Suspense, useCallback, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import {Wrench, Send, Loader2, AlertTriangle, Inbox, Plus}  from "lucide-react";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { operationalRequestInspection } from "@/components/approver/wardenConsoleModels";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface OperationalRequest {
  id: string;
  createdAt: string;
  raisedBy: string | null;
  category: string;
  title: string;
  priority: string;
  description: string | null;
  status: string;
  resolvedAt: string | null;
  resolution: string | null;
}

interface OpRequestsResponse {
  success: boolean;
  data: {
    requests: OperationalRequest[];
    openCount: number;
    total: number;
  };
}

const CATEGORIES = ["supply", "equipment", "staffing", "hygiene", "other"] as const;
const PRIORITIES = ["low", "medium", "high"] as const;

function fmtTs(iso: string | null | undefined): string {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleString("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return iso;
  }
}

function WidgetError({ message, onRetry }: { message: string; onRetry: () => void }) {
  return (
    <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
      <span className="flex items-center gap-2 min-w-0">
        <AlertTriangle className="w-4 h-4 shrink-0" />
        <span className="truncate">{message}</span>
      </span>
      <button
        type="button"
        onClick={onRetry}
        className="surface-card min-h-11 inline-flex items-center justify-center px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
      >
        Retry
      </button>
    </div>
  );
}

function priorityBadge(p: string): string {
  if (p === "high") return "border-rose-400/30 bg-rose-400/10 text-action-danger";
  if (p === "medium") return "border-amber-400/30 bg-amber-400/10 text-action-warning";
  return "border-sky-400/30 bg-sky-400/10 text-action-info";
}

function MessOperationalRequestsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "mess_incharge") as Role;
  const tier = getRoleTier(role);
  const { addToast } = useUIStore();
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const inspectRequest = (r: OperationalRequest) => {
    inspect(
      operationalRequestInspection({
        id: r.id,
        title: r.title,
        description: r.description,
        category: r.category,
        priority: r.priority,
        status: r.status,
        createdAt: r.createdAt || null,
        resolvedAt: r.resolvedAt,
      }),
    );
  };

  const {
    data: queue,
    loading,
    error,
    refresh,
  } = useApiResource<OpRequestsResponse>(
    "/api/mess/operational-requests?limit=25",
    { ttlMs: 30_000 }
  );

  const [formOpen, setFormOpen] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [title, setTitle] = useState("");
  const [category, setCategory] = useState<string>("supply");
  const [priority, setPriority] = useState<string>("medium");
  const [description, setDescription] = useState("");

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !queue;
  const requests = queue?.data?.requests ?? [];
  const openCount = queue?.data?.openCount ?? 0;

  const submitRequest = async (e: React.FormEvent) => {
    e.preventDefault();
    if (submitting || !title.trim()) return;
    setSubmitting(true);
    try {
      const res = await fetch("/api/mess/operational-requests", {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({
          title: title.trim(),
          category,
          priority,
          description: description.trim() || undefined,
        }),
      });
      const json = await res.json().catch(() => null);
      if (!res.ok) {
        throw new Error(typeof json?.error === "string" ? json.error : "Failed to raise request");
      }
      setFormOpen(false);
      setTitle("");
      setDescription("");
      addToast({
        variant: "success",
        title: "Request raised",
        message: "Operational request sent to caretaker / facilities authority.",
      });
      await refreshAll();
    } catch (err) {
      addToast({
        variant: "error",
        title: "Could not raise request",
        message: err instanceof Error ? err.message : "Failed to raise operational request",
      });
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-5 py-6 min-w-0">
      <Link
        href="/mess"
        className="inline-flex min-h-11 items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        Back to Mess Overview
      </Link>

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
        <button
          type="button"
          onClick={() => setFormOpen((o) => !o)}
          className="surface-card inline-flex min-h-11 items-center gap-2 bg-emerald-500/10 px-4 py-2 text-sm text-action-success hover:bg-emerald-500/20 shrink-0"
        >
          <Plus className="w-4 h-4" />
          {formOpen ? "Close form" : "Raise Request"}
        </button>
      </div>

      <ContextSituationBar
        roleLabel="Mess In-Charge"
        purpose="Escalate kitchen supply deficits, equipment malfunctions, and staffing needs to facilities authority"
        contextLabel={`Operational Requests Queue · ${openCount} Open`}
        statusSummary={
          openCount > 0
            ? `${openCount} operational request${openCount === 1 ? "" : "s"} open and awaiting caretaker / facilities review.`
            : "No open kitchen operational requests. All supply and equipment tickets resolved."
        }
        why="Submitting operational requests alerts hostel caretakers and facility managers to expedite equipment repairs and provision refills."
        severity={openCount > 0 ? "warn" : "ok"}
        primaryAction={{ label: "Inventory Stock", href: "/mess/inventory-stock" }}
        secondaryActions={[
          { label: "Mess Issues", href: "/mess/mess-issues" },
          { label: "Token Scanner", href: "/mess/scan" },
          { label: "Mess Overview", href: "/mess" },
        ]}
      />

      {error && (
        <WidgetError
          message={`Operational requests unavailable: ${error}`}
          onRetry={() => void refreshAll()}
        />
      )}

      {/* Request form — mess in-charge raises requests to caretaker / facilities */}
      {formOpen && (
        <WidgetBoundary title="Raise Operational Request">
          <form
            onSubmit={submitRequest}
            className="surface-card bg-bg-base p-4 space-y-3 min-w-0"
          >
            <p className="text-xs text-text-muted">
              Requests are routed to the caretaker / facilities authority via the approvals
              desk. Keep the title specific (e.g. “Grinder replacement for mess kitchen”).
            </p>
            <label className="block min-w-0">
              <span className="text-xs font-semibold text-text-muted uppercase tracking-wide">
                Title
              </span>
              <input
                type="text"
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                placeholder="e.g. Water filter replacement for mess"
                className="surface-card mt-1 w-full min-h-11 bg-bg-surface px-3 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus: min-w-0"
              />
            </label>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 min-w-0">
              <label className="block min-w-0">
                <span className="text-xs font-semibold text-text-muted uppercase tracking-wide">
                  Category
                </span>
                <select
                  value={category}
                  onChange={(e) => setCategory(e.target.value)}
                  className="surface-card mt-1 w-full min-h-11 bg-bg-surface px-3 py-2 text-sm text-white focus:outline-none focus:"
                >
                  {CATEGORIES.map((c) => (
                    <option key={c} value={c}>
                      {c}
                    </option>
                  ))}
                </select>
              </label>
              <label className="block min-w-0">
                <span className="text-xs font-semibold text-text-muted uppercase tracking-wide">
                  Priority
                </span>
                <select
                  value={priority}
                  onChange={(e) => setPriority(e.target.value)}
                  className="surface-card mt-1 w-full min-h-11 bg-bg-surface px-3 py-2 text-sm text-white focus:outline-none focus:"
                >
                  {PRIORITIES.map((p) => (
                    <option key={p} value={p}>
                      {p}
                    </option>
                  ))}
                </select>
              </label>
            </div>
            <label className="block min-w-0">
              <span className="text-xs font-semibold text-text-muted uppercase tracking-wide">
                Details
              </span>
              <textarea
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                rows={3}
                placeholder="Context, affected area, urgency notes (optional)"
                className="surface-card mt-1 w-full bg-bg-surface px-3 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus: min-w-0"
              />
            </label>
            <div className="flex flex-wrap items-center gap-2">
              <button
                type="submit"
                disabled={submitting || !title.trim()}
                className="surface-card inline-flex min-h-11 items-center gap-2 bg-action-success hover:bg-action-success disabled:opacity-40 px-4 py-2 text-sm font-semibold text-white transition"
              >
                {submitting ? (
                  <Loader2 className="w-4 h-4 animate-spin" />
                ) : (
                  <Send className="w-4 h-4" />
                )}
                Send Request
              </button>
            </div>
          </form>
        </WidgetBoundary>
      )}

      {/* Queue */}
      <WidgetBoundary title="Operational Requests">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex items-center gap-2 min-w-0">
            <Wrench className="w-4 h-4 text-action-success shrink-0" />
            <span className="text-sm font-semibold text-white truncate">
              Mess Operational Requests
            </span>
            <span className="ml-auto text-xs text-text-muted shrink-0">
              {openCount} open
            </span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" />
              Loading operational requests…
            </div>
          ) : requests.length > 0 ? (
            <div className="overflow-x-auto min-w-0">
              <table className="w-full text-sm min-w160">
                <thead>
                  <tr className="border-b border-border text-text-muted text-xs uppercase tracking-wide">
                    <th className="text-left px-4 py-2.5">Request</th>
                    <th className="text-left px-4 py-2.5">Category</th>
                    <th className="text-left px-4 py-2.5">Priority</th>
                    <th className="text-left px-4 py-2.5">Status</th>
                    <th className="text-left px-4 py-2.5">Raised</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800/60">
                  {requests.map((r) => (
                    <tr key={r.id} className="hover:bg-bg-elevated/30 transition-colors cursor-pointer" onClick={() => inspectRequest(r)}>
                      <td className="px-4 py-2.5 min-w-0 max-w-md">
                        <p className="text-text-secondary font-medium truncate">{r.title}</p>
                        {r.description ? (
                          <p className="text-xs text-text-muted truncate">{r.description}</p>
                        ) : null}
                      </td>
                      <td className="px-4 py-2.5 text-text-muted capitalize whitespace-nowrap">
                        {r.category}
                      </td>
                      <td className="px-4 py-2.5 whitespace-nowrap">
                        <span
                          className={`inline-block px-2 py-0.5 rounded-full text-xs font-medium border ${priorityBadge(r.priority)}`}
                        >
                          {r.priority}
                        </span>
                      </td>
                      <td className="px-4 py-2.5">
                        <span
                          className={`inline-block px-2 py-0.5 rounded-full text-xs font-medium border whitespace-nowrap ${
                            r.status === "OPEN"
                              ? "border-amber-400/30 bg-amber-400/10 text-action-warning"
                              : "border-emerald-400/30 bg-emerald-400/10 text-action-success"
                          }`}
                        >
                          {r.status}
                        </span>
                      </td>
                      <td className="px-4 py-2.5 text-text-muted text-xs whitespace-nowrap">
                        {fmtTs(r.createdAt)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div className="p-8 text-center">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted max-w-md mx-auto">
                No operational requests yet. Raise one above to flag supply, equipment,
                staffing or hygiene items to the caretaker / facilities authority.
              </p>
            </div>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}

export default function MessOperationalRequestsPage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <MessOperationalRequestsInner />
    </Suspense>
  );
}
