<file path="src/app/(admin)/admin/roles/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import Link from "next/link";
import {ShieldCheck, Users, Search, ChevronDown, ChevronRight, ArrowUpRight, Network, RefreshCw}  from "lucide-react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { usePolling } from "@/hooks/usePolling";
import { usePersistentQuery } from "@/hooks/usePersistentQuery";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

/**
 * Admin Roles & Hierarchy — re-skin of the role tree + access matrix.
 *
 * Reads `/api/roles-graph` (nodes + edges + live user / on-campus counts) and
 * renders: KPI row (roles / users / on campus) + an expandable hierarchy tree
 * with active-pct bars + a membership-by-role panel that links into the full
 * sysadmin role panel. Glass chrome + Mini* kit.
 */

interface RolesGraphPayload {
  root: string;
  nodes: Array<{
    code: string;
    display_name: string;
    description?: string;
    user_count: number;
    on_campus: number;
  }>;
  edges: Array<{ parent: string; child: string }>;
  user_counts: Record<string, number>;
  on_campus_counts: Record<string, number>;
  totals: { roles: number; users: number; onCampus: number };
  generated_at?: string;
}

interface TreeNode {
  code: string;
  display_name: string;
  user_count: number;
  on_campus: number;
  children: TreeNode[];
}

async function fetchGraph(): Promise<RolesGraphPayload> {
  const res = await fetch("/api/roles-graph", { headers: getAuthHeaders() });
  if (!res.ok) throw new Error(`roles-graph → ${res.status}`);
  const body = await res.json();
  return (body?.data ?? body) as RolesGraphPayload;
}

function buildTree(p: RolesGraphPayload): TreeNode[] {
  const byCode = new Map<string, TreeNode>();
  for (const n of p.nodes) {
    byCode.set(n.code, {
      code: n.code,
      display_name: n.display_name,
      user_count: n.user_count,
      on_campus: n.on_campus,
      children: [],
    });
  }
  const childSet = new Set<string>();
  for (const e of p.edges) {
    const parent = byCode.get(e.parent);
    const child = byCode.get(e.child);
    if (parent && child) {
      parent.children.push(child);
      childSet.add(e.child);
    }
  }
  // Roots are the nodes that are never a child.
  return Array.from(byCode.values()).filter((n) => !childSet.has(n.code));
}

function Node({
  node,
  expanded,
  onToggle,
}: {
  node: TreeNode;
  expanded: Set<string>;
  onToggle: (code: string) => void;
}) {
  const hasChildren = node.children.length > 0;
  const isOpen = expanded.has(node.code);
  const activePct =
    node.user_count > 0 ? (node.on_campus / node.user_count) * 100 : 0;

  return (
    <div>
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Role graph, membership, and on-campus presence"
        why="Role changes here take effect on the next session refresh — test changes on a scratch account before applying broadly."
        contextLabel="Role graph, membership, and on-campus presence"
        statusSummary="Review current role graph, membership, and on-campus presence state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <button
        onClick={() => hasChildren && onToggle(node.code)}
        className="surface-card flex items-center gap-2 w-full min-h-11 text-left px-2 py-1.5 hover:bg-bg-surface/60 group"
      >
        {hasChildren ? (
          isOpen ? (
            <ChevronDown className="w-3.5 h-3.5 text-text-muted" />
          ) : (
            <ChevronRight className="w-3.5 h-3.5 text-text-muted" />
          )
        ) : (
          <span className="w-3.5" />
        )}
        <ShieldCheck className="w-4 h-4 text-action-primary" />
        <span className="text-sm font-medium text-text-primary">
          {node.display_name}
        </span>
        <span className="surface-card text-xs uppercase tracking-wide px-1.5 py-0.5 bg-bg-surface/80 text-text-muted">
          {node.code}
        </span>
        <span className="ml-auto flex items-center gap-2 text-xs">
          <span className="tabular-nums text-text-muted">
            {node.user_count} users
          </span>
          <span className="flex items-center gap-1 tabular-nums text-action-primary">
            <Users className="size-3.5" /> {node.on_campus}
          </span>
          <span
            className="w-12 h-1.5 rounded-full bg-bg-surface/60 overflow-hidden hidden sm:block"
            title={`${Math.round(activePct)}% on campus`}
          >
            <span
              className="block h-full bg-action-primary"
              style={{ width: `${Math.min(100, activePct)}%` }}
            />
          </span>
        </span>
      </button>

      {hasChildren && isOpen && (
        <div className="surface-card ml-4 pl-2">
          {node.children.map((c) => (
            <Node key={c.code} node={c} expanded={expanded} onToggle={onToggle} />
          ))}
        </div>
      )}
    </div>
  );
}

function AdminRolesInner() {
  const [data, setData] = useState<RolesGraphPayload | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [expanded, setExpanded] = useState<Set<string>>(new Set());
  const [query, setQuery] = usePersistentQuery("gate-admin-roles-query");

  const load = useCallback(async () => {
    try {
      const g = await fetchGraph();
      setData(g);
      // Expand all top-level roots by default.
      const roots = buildTree(g);
      setExpanded(new Set(roots.map((r) => r.code)));
      setError(null);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load roles");
    }
  }, []);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);
  usePolling(load, { intervalMs: 60_000 });

  const tree = useMemo(() => (data ? buildTree(data) : []), [data]);

  const filteredNodes = useMemo(() => {
    if (!data || !query.trim()) return null;
    const q = query.trim().toLowerCase();
    return data.nodes.filter(
      (n) =>
        n.code.toLowerCase().includes(q) ||
        n.display_name.toLowerCase().includes(q),
    );
  }, [data, query]);

  const toggle = (code: string) => {
    setExpanded((prev) => {
      const next = new Set(prev);
      if (next.has(code)) next.delete(code);
      else next.add(code);
      return next;
    });
  };

  const expandAll = () => {
    if (!data) return;
    setExpanded(new Set(data.nodes.map((n) => n.code)));
  };
  const collapseAll = () => setExpanded(new Set());

  if (!data && !error) {
    return (
      <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-4 py-4 md:py-6">
        <Skeleton className="h-10 w-64" />
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {Array.from({ length: 3 }).map((_, i) => (
            <Skeleton key={i} className="h-24 rounded-2xl" />
          ))}
        </div>
        <Skeleton className="h-72 rounded-2xl" />
      </div>
    );
  }

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-4 md:py-6">
      <PageHeader
        title="Roles & Hierarchy"
        subtitle="Role graph, membership, and on-campus presence"
        onRefresh={load}
      />

      {error && (
        <div className="surface-card p-3 text-sm text-action-danger">
          {error}
        </div>
      )}

      {/* KPI row */}
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div className="surface-card p-4">
          <div className="flex items-center gap-2 text-xs text-text-muted mb-1">
            <ShieldCheck className="w-3.5 h-3.5" /> Roles defined
          </div>
          <p className="text-2xl font-bold text-text-primary tabular-nums">
            {data?.totals.roles ?? 0}
          </p>
        </div>
        <div className="surface-card p-4">
          <div className="flex items-center gap-2 text-xs text-text-muted mb-1">
            <Users className="w-3.5 h-3.5" /> Total users
          </div>
          <p className="text-2xl font-bold text-text-primary tabular-nums">
            {data?.totals.users ?? 0}
          </p>
        </div>
        <div className="surface-card p-4">
          <div className="flex items-center gap-2 text-xs text-text-muted mb-1">
            <Network className="w-3.5 h-3.5" /> On campus
          </div>
          <p className="text-2xl font-bold text-action-primary tabular-nums">
            {data?.totals.onCampus ?? 0}
          </p>
        </div>
      </div>

      {/* Controls */}
      <div className="flex flex-wrap items-center gap-2">
        <div className="relative flex-1 min-w50">
          <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" />
          <input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Search roles…"
            className="surface-card w-full min-h-11 pl-9 pr-3 py-2 bg-bg-surface/40 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-action-primary/40"
          />
        </div>
        <button
          onClick={expandAll}
          className="surface-card text-xs px-3 py-1.5 min-h-11 hover:bg-bg-surface/60 flex items-center justify-center"
        >
          Expand all
        </button>
        <button
          onClick={collapseAll}
          className="surface-card text-xs px-3 py-1.5 min-h-11 hover:bg-bg-surface/60 flex items-center justify-center"
        >
          Collapse all
        </button>
        <button
          onClick={load}
          className="surface-card flex items-center gap-1.5 text-xs px-3 py-1.5 min-h-11 hover:bg-bg-surface/60 justify-center"
        >
          <RefreshCw className="w-3.5 h-3.5" /> Refresh
        </button>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {/* Hierarchy */}
        <div className="lg:col-span-2">
          <WidgetBoundary title="Hierarchy">
            <div className="surface-card p-4">
              <h2 className="text-xs font-semibold uppercase tracking-wide text-text-muted mb-3">
                Role hierarchy
              </h2>

              {filteredNodes ? (
                <ul className="space-y-1.5">
                  {filteredNodes.map((n) => (
                    <li
                      key={n.code}
                      className="surface-card flex items-center justify-between px-2 py-1.5 bg-bg-surface/40 min-h-11"
                    >
                      <div className="flex items-center gap-2 min-w-0">
                        <ShieldCheck className="w-4 h-4 text-action-primary shrink-0" />
                        <span className="text-sm text-text-primary truncate">
                          {n.display_name}
                        </span>
                        <span className="surface-card text-xs uppercase px-1.5 py-0.5 bg-bg-surface/80 text-text-muted">
                          {n.code}
                        </span>
                      </div>
                      <span className="text-xs text-text-muted tabular-nums shrink-0">
                        {n.user_count} users
                      </span>
                    </li>
                  ))}
                  {!filteredNodes.length && (
                    <li className="text-xs text-text-muted py-4 text-center">
                      No roles match
                    </li>
                  )}
                </ul>
              ) : (
                <div className="overflow-x-auto">
                  <div className="min-w160 space-y-1">
                    {tree.map((n) => (
                      <Node key={n.code} node={n} expanded={expanded} onToggle={toggle} />
                    ))}
                  </div>
                </div>
              )}
            </div>
          </WidgetBoundary>
        </div>

        {/* Membership */}
        <WidgetBoundary title="Membership">
          <div className="surface-card p-4">
            <h2 className="text-xs font-semibold uppercase tracking-wide text-text-muted mb-3">
              Membership by role
            </h2>
            <ul className="space-y-1.5 max-h125 overflow-y-auto">
              {(data?.nodes ?? [])
                .slice()
                .sort((a, b) => b.user_count - a.user_count)
                .map((n) => {
                  const pct = data?.totals.users
                    ? (n.user_count / data.totals.users) * 100
                    : 0;
                  return (
                    <li key={n.code} className="text-xs">
                      <div className="flex items-center justify-between">
                        <span className="text-text-primary truncate">
                          {n.display_name}
                        </span>
                        <span className="tabular-nums text-text-muted">
                          {n.user_count} · {n.on_campus}
                        </span>
                      </div>
                      <div className="h-1.5 mt-1 rounded-full bg-bg-surface/60 overflow-hidden">
                        <div
                          className="h-full bg-action-primary"
                          style={{ width: `${Math.min(100, pct)}%` }}
                        />
                      </div>
                    </li>
                  );
                })}
            </ul>
            <Link
              href="/sysadmin/roles"
              className="mt-3 flex items-center justify-center gap-1 text-xs text-action-primary hover:underline min-h-11"
            >
              Full sysadmin role panel <ArrowUpRight className="size-3.5" />
            </Link>
          </div>
        </WidgetBoundary>
      </div>
    </div>
  );
}

export default function AdminRolesPage() {
  return (
    
      <AdminRolesInner />
    
    

  );
}
