<file path="src/hooks/useViewerContext.ts">
"use client";

/**
 * hooks/useViewerContext.ts — build a record-abilities ViewerContext from
 * the auth store.
 *
 * Pairs with `src/lib/record-abilities.ts`: the resolvers are pure and take
 * a ViewerContext; this hook is the client-side source of that context
 * (role + userId + departmentId + assigned gateId + hostel scope).
 *
 * Hostel scope is derived from the user's own record when present (a
 * student's hostel block, a hostel staff member's assigned scope). When
 * there is nothing to read it stays null, which the resolvers treat as
 * "campus-wide / no scope constraint".
 */

import { useMemo } from "react";
import { useAuthStore } from "@/stores/authStore";
import { type Role } from "@/lib/types";
import { makeViewer, type ViewerContext } from "@/lib/record-abilities";

export function useViewerContext(): ViewerContext {
  const user = useAuthStore((s) => s.user);
  const role = useAuthStore((s) => s.role) as Role | undefined;

  return useMemo(() => {
    const userId = user?.id ?? "";
    // Hostel scope: a student is scoped to their own hostel block; hostel
    // staff are scoped to their assigned block. Keep it light — the resolvers
    // treat null as "no constraint".
    const hostelScope = user?.studentDetails?.hostelBlock ?? null;
    return makeViewer(role, {
      userId,
      departmentId: user?.departmentId ?? null,
      hostelScope,
      assignedGateId: user?.gateId ?? null,
    });
  }, [user, role]);
}

export default useViewerContext;
</file>

<file path="src/hooks/useVisualViewport.ts">
"use client";

import { useEffect, useState } from "react";

interface VVState {
  height: number;
  offsetTop: number;
  keyboardOffset: number;
  isKeyboardOpen: boolean;
  visualViewportWidth: number;
}

export function useVisualViewport(): VVState {
  const [state, setState] = useState<VVState>({
    height: typeof window !== "undefined" ? window.innerHeight : 0,
    offsetTop: 0,
    keyboardOffset: 0,
    isKeyboardOpen: false,
    visualViewportWidth: typeof window !== "undefined" ? window.innerWidth : 0,
  });

  useEffect(() => {
    if (typeof window === "undefined") return;
    const vv = window.visualViewport;
    if (!vv) return;

    const update = () => {
      const base = window.innerHeight;
      const vh = vv.height;
      const off = vv.offsetTop;
      const kb = Math.max(0, base - vh - off);
      setState({
        height: vh,
        offsetTop: off,
        keyboardOffset: kb,
        isKeyboardOpen: kb > 120,
        visualViewportWidth: vv.width,
      });
    };
    update();
    vv.addEventListener("resize", update);
    vv.addEventListener("scroll", update);
    window.addEventListener("orientationchange", update);
    return () => {
      vv.removeEventListener("resize", update);
      vv.removeEventListener("scroll", update);
      window.removeEventListener("orientationchange", update);
    };
  }, []);

  return state;
}
</file>

<file path="src/hooks/useVPStreak.ts">
"use client";

import { useEffect } from "react";
import { useVPRetention } from "@/stores/vpRetentionStore";

/**
 * Runs on mount and every 5 minutes. If the current day is a workday and the
 * VP has made a decision AND has zero overdue items, the streak is bumped.
 * Bad days (any overdue) reset the streak.
 */
export function useVPStreak(zeroOverdue: boolean, pendingCount: number) {
  const bump = useVPRetention((s) => s.bumpStreakIfEligible);
  const resetToday = useVPRetention((s) => s.resetTodayIfNeeded);

  useEffect(() => {
    resetToday();
    bump(zeroOverdue);
    const id = setInterval(() => {
      resetToday();
      bump(zeroOverdue);
    }, 5 * 60_000);
    return () => clearInterval(id);
  }, [zeroOverdue, pendingCount, bump, resetToday]);
}
</file>

