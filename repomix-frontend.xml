<file path="src/app/(approver)/hostel-manager/residents/page.tsx">
"use client";

import Link from "next/link";
import { PageHeader } from "@/components/shared/PageHeader";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import {
  hostelBlockInspection,
  type HostelBlockOccupancy,
} from "@/components/approver/wardenConsoleModels";
import { useApiResource } from "@/hooks/useApiResource";

interface BlocksResponse {
  success: boolean;
  data: {
    blocks: Array<{ block: string; total: number; occupied: number }>;
  };
}

export default function HostelManagerResidentsPage() {
  const { inspection, inspect, closeInspection } = useEntityInspector();
  const { data, loading, error } = useApiResource<BlocksResponse>(
    "/api/hostel/blocks",
    { ttlMs: 30_000 },
  );
  const blocks = data?.data?.blocks ?? [];

  return (
    <div className="p-4 space-y-4">
      <PageHeader title="Residents" subtitle="Students currently allocated to your blocks." />
      <ContextSituationBar
        roleLabel="Hostel Manager"
        purpose="Monitor resident counts across hostel blocks, verify room allocations, and audit occupancy distributions"
        why="Auditing resident rosters ensures accurate headcounts for emergency drills, mess planning, and room compliance."
        contextLabel={`Hostel Residents · ${blocks.reduce((s, b) => s + b.occupied, 0)} In-Room`}
        statusSummary={
          blocks.length > 0
            ? `${blocks.reduce((s, b) => s + b.occupied, 0)} resident${blocks.reduce((s, b) => s + b.occupied, 0) === 1 ? "" : "s"} currently in blocks (${blocks.reduce((s, b) => s + b.total, 0)} total allocated across ${blocks.length} block${blocks.length === 1 ? "" : "s"}).`
            : "No residents recorded in any hostel block yet."
        }
        severity="info"
        primaryAction={{ label: "Rooms & Occupancy", href: "/hostel-manager/rooms" }}
        secondaryActions={[
          { label: "Bed Allocation", href: "/hostel-manager/allocation" },
          { label: "Resident Tickets", href: "/hostel-manager" },
        ]}
      />
      {error ? (
        <p className="text-xs text-text-muted">
          Block data unavailable: {error}
        </p>
      ) : loading && blocks.length === 0 ? (
        <p className="text-xs text-text-muted">Loading resident blocks…</p>
      ) : blocks.length === 0 ? (
        <p className="text-xs text-text-muted">No residents recorded in any hostel block yet.</p>
      ) : (
        <div className="overflow-x-auto rounded-xl border border-border">
          <table className="w-full text-sm">
            <thead>
              <tr className="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
                <th className="px-4 py-2.5">Block</th>
                <th className="px-4 py-2.5">Residents</th>
                <th className="px-4 py-2.5">Currently in</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-border/50">
              {blocks.map((b) => (
                <tr
                  key={b.block}
                  className="cursor-pointer hover:bg-bg-elevated/30 transition-colors"
                  onClick={() =>
                    inspect(
                      hostelBlockInspection({
                        block: b.block,
                        total: b.total,
                        occupied: b.occupied,
                      } satisfies HostelBlockOccupancy),
                    )
                  }
                >
                  <td className="px-4 py-2.5 text-text-secondary font-medium">
                    Block {b.block}
                  </td>
                  <td className="px-4 py-2.5 text-text-muted">{b.total}</td>
                  <td className="px-4 py-2.5 text-text-muted">{b.occupied}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <p className="text-xs text-text-muted">
        The full resident roster (per student, room, and contact) is available in the{" "}
        <Link href="/admin/students" className="text-action-primary hover:underline">
          admin student roster
        </Link>
        .
      </p>
      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}
</file>

<file path="src/app/(approver)/hostel-manager/resource-management/page.tsx">
"use client";

import { Suspense, useCallback, useMemo, useState } from "react";
import Link from "next/link";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { AuthGuard } from "@/components/shared/AuthGuard";
import {
  Package,
  Building2,
  Loader2,
  AlertTriangle,
  ArrowRight,
  Users,
  Wrench,
} from "lucide-react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

/* response shapes */

interface PresenceMatrixData {
  gates: Array<{ id: string; name: string; code: string; audience: string; type: string }>;
  matrix: Record<string, Record<string, number>>;
  lastUpdated: string;
}

interface PresenceMatrixResponse {
  success: boolean;
  data: PresenceMatrixData;
}

interface AnalyticsResponse {
  success: boolean;
  data: {
    metrics: Array<{ key: string; label: string; value: number; unit?: string }>;
    seriesData: Array<Record<string, string | number>>;
    role: string;
  };
}

function StatCard({
  icon: Icon,
  label,
  value,
  sub,
  accent = "text-white",
  loading,
}: {
  icon: React.ComponentType<{ className?: string }>;
  label: string;
  value: React.ReactNode;
  sub?: string;
  accent?: string;
  loading?: boolean;
}) {
  return (
    <div className="surface-card bg-bg-base p-4 flex flex-col gap-2 min-w-0">
      <div className="flex items-center gap-2 text-text-muted min-w-0">
        <Icon className="w-4 h-4 shrink-0" />
        <span className="text-xs font-semibold uppercase tracking-wide truncate">{label}</span>
      </div>
      {loading ? (
        <Loader2 className="w-5 h-5 animate-spin motion-reduce:animate-none text-text-muted" />
      ) : (
        <p className={`text-2xl font-bold ${accent}`}>{value}</p>
      )}
      {sub && <p className="text-xs text-text-muted min-w-0">{sub}</p>}
    </div>
  );
}

/* main content */

function HostelManagerResourceManagementInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "hostel_manager") as Role;
  const tier = getRoleTier(role);

  const {
    data: presence,
    loading: presenceLoading,
    refresh: refreshPresence,
  } = useApiResource<PresenceMatrixResponse>("/api/occupancy/presence-matrix", {
    ttlMs: 30_000,
  });
  const {
    data: analytics,
    loading: analyticsLoading,
    refresh: refreshAnalytics,
  } = useApiResource<AnalyticsResponse>("/api/campus-extra/analytics?role=hostel_manager&date_range=7d", {
    ttlMs: 30_000,
  });

  const refreshAll = useCallback(async () => {
    clearCache();
    await Promise.all([refreshPresence(), refreshAnalytics()]);
  }, [refreshPresence, refreshAnalytics]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });



  const matrix = presence?.data?.matrix ?? {};
  const gates = presence?.data?.gates ?? [];
  const onCampusTotal = useMemo(
    () =>
      gates.reduce(
        (sum, g) => sum + Object.values(matrix[g.id] ?? {}).reduce((a, b) => a + b, 0),
        0
      ),
    [gates, matrix]
  );

  const studentOnCampus = useMemo(
    () => gates.reduce((sum, g) => sum + (matrix[g.id]?.["student"] ?? 0), 0),
    [gates, matrix]
  );

  const metrics = analytics?.data?.metrics ?? [];
  const metricValue = (key: string) =>
    metrics.find((m) => m.key === key)?.value ?? null;

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      {/* Back link */}
      <Link
        href="/hostel-manager"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Operations Overview
      </Link>

      {/* Page toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Hostel Manager"
        purpose="Manage hostel facilities, monitor room resources and utility stock, and audit block assets"
        why="Tracking block assets and supplies prevents shortages in bedding, utilities, and daily hostel hardware."
        contextLabel={`Hostel Resources · ${gates.length} Gates / ${onCampusTotal} Present`}
        statusSummary={`${studentOnCampus} students on campus across active gates. Resource inventories and utilities tracked for all blocks.`}
        severity="info"
        primaryAction={{ label: "Maintenance", href: "/hostel-manager/maintenance" }}
        secondaryActions={[
          { label: "Housekeeping", href: "/hostel-manager/housekeeping-tasks" },
          { label: "Rooms & Occupancy", href: "/hostel-manager/rooms" },
        ]}
      />

      {/* Authority note */}
      <div className="surface-card bg-bg-base p-4 min-w-0">
        <p className="text-sm text-text-secondary min-w-0">
          The hostel manager owns <span className="font-semibold text-action-info">resources and facilities</span> —
          rooms, beds, utilities, and stock. They do <span className="font-semibold text-action-danger">not</span> hold
          hostel-disciplinary authority or final outpass power; outpass decisions route through the hostel-manager/principal chain.
        </p>
      </div>

      {/* KPI row */}
      <WidgetBoundary title="Resource Management">
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 min-w-0">
          <StatCard
            icon={Users}
            label="Students On Campus"
            value={studentOnCampus}
            sub="Residents currently inside active gates"
            accent="text-action-info"
            loading={presenceLoading && !presence}
          />
          <StatCard
            icon={Building2}
            label="Total On Campus"
            value={onCampusTotal}
            sub="All roles across active gates"
            accent="text-action-success"
            loading={presenceLoading && !presence}
          />
          <StatCard
            icon={Package}
            label="Stock / Resources"
            value={metricValue("stock") ?? "live"}
            sub="Resource metrics from the manager analytics view"
            accent="text-action-warning"
            loading={analyticsLoading && !analytics}
          />
          <StatCard
            icon={Wrench}
            label="Facilities"
            value={gates.length}
            sub="Gates and access points in the management scope"
            accent="text-white"
            loading={presenceLoading && !presence}
          />
        </div>
      </WidgetBoundary>

      {/* Manager analytics metrics */}
      <WidgetBoundary title="Manager Metrics">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
