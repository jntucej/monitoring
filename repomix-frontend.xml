"use client";

import { useCallback, useEffect, useState } from "react";
import { InterestResultCard, type InterestResultData } from "@/components/mess/InterestResultCard";

interface PollRow {
  id: string;
  proposed_item: string;
  meal_type: string;
  status: string;
  closes_at: string;
}

export default function MessPollsPage() {
  const [polls, setPolls] = useState<PollRow[]>([]);
  const [results, setResults] = useState<Record<string, InterestResultData>>({});
  const [proposedItem, setProposedItem] = useState("");
  const [mealType, setMealType] = useState("lunch");

  const load = useCallback(async () => {
    const r = await fetch("/api/mess/interest-polls");
    const j = await r.json();
    const list: PollRow[] = j?.data?.polls ?? [];
    setPolls(list);
    for (const p of list.slice(0, 10)) {
      fetch(`/api/mess/interest-polls/${p.id}/result`)
        .then((res) => res.json())
        .then((rj) => {
          if (rj?.data) {
            setResults((prev) => ({ ...prev, [p.id]: rj.data }));
          }
        })
        .catch(() => {});
    }
  }, []);

  useEffect(() => {
    void load();
  }, [load]);

  async function createPoll(e: React.FormEvent) {
    e.preventDefault();
    if (!proposedItem.trim()) return;
    const closesAt = new Date(Date.now() + 48 * 3600 * 1000).toISOString();
    const r = await fetch("/api/mess/interest-polls", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        proposed_item: proposedItem.trim(),
        meal_type: mealType,
        closes_at: closesAt,
      }),
    });
    if (r.ok) {
      setProposedItem("");
      void load();
    }
  }

  return (
    <div className="mx-auto max-w-4xl space-y-6 p-6">
      <h1 className="text-xl font-bold text-foreground">Mess Interest Polls</h1>

      <form onSubmit={createPoll} className="flex gap-2 rounded-xl border border-border bg-card p-4">
        <input
          type="text"
          value={proposedItem}
          onChange={(e) => setProposedItem(e.target.value)}
          placeholder="Proposed dish (e.g. Paneer Tikka)"
          className="flex-1 rounded-lg border border-border bg-background px-3 py-1.5 text-sm text-foreground"
          required
        />
        <select
          value={mealType}
          onChange={(e) => setMealType(e.target.value)}
          className="rounded-lg border border-border bg-background px-3 py-1.5 text-sm text-foreground"
        >
          <option value="breakfast">Breakfast</option>
          <option value="lunch">Lunch</option>
          <option value="snacks">Snacks</option>
          <option value="dinner">Dinner</option>
        </select>
        <button
          type="submit"
          className="rounded-lg bg-primary px-4 py-1.5 text-sm font-semibold text-primary-foreground"
        >
          Open Poll
        </button>
      </form>

      <div className="space-y-4">
        {polls.map((p) =>
          results[p.id] ? (
            <InterestResultCard key={p.id} data={results[p.id]} onDecided={load} />
          ) : (
            <div key={p.id} className="rounded-xl border border-border bg-card p-4 text-sm text-foreground">
              {p.proposed_item} ({p.meal_type}) — {p.status}
            </div>
          ),
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/app/(mess)/mess/reviews/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import { RefreshCw } from "lucide-react";
import { PageHeader } from "@/components/shared/PageHeader";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { SectionCard } from "@/components/shared/SectionCard";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import {
  MEAL_TYPES, MEAL_LABEL, SATISFACTION_LEVELS,
  type MealType, type Satisfaction, satisfactionLabel,
} from "@/lib/mess-reviews";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface DailyRow {
  date: string; mealType: MealType;
  distribution: Record<Satisfaction, number>;
  total: number; averageScore: number;
}
interface CommentRow {
  id: string; review_date: string; meal_type: MealType; satisfaction: Satisfaction;
  comment: string; user_name: string; unique_id: string; updated_at: string;
}
interface Summary {
  from: string; to: string;
  daily: DailyRow[];
  totalsByMeal: Record<string, { total: number; averageScore: number }>;
  recentComments: CommentRow[];
  /** R9: true when the API has masked student identity (non-moderator viewer). */
  anonymous?: boolean;
}

export default function MessReviewsPage() {
  const [data, setData] = useState<Summary | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch("/api/mess/reviews/summary", {
        headers: getAuthHeaders(), cache: "no-store",
      });
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load summary");
      setData(body.data as Summary);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load summary");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void load(); }, [load]);

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
      <PageHeader
        title="Meal Reviews"
        subtitle="Satisfaction distribution and recent student comments."
        actions={
          <button type="button" onClick={() => void load()}
            className="surface-card inline-flex min-h-11 items-center gap-2 px-3 py-2 text-sm text-text-secondary">
            <RefreshCw className="h-4 w-4" /> Refresh
          </button>
        }
      />
      <div className="my-4">
        <ContextSituationBar
          roleLabel="Mess In-Charge"
          purpose="Evaluate student meal ratings, review anonymized dining feedback, and address food quality concerns"
          contextLabel="Student Meal Satisfaction"
          statusSummary={
            data
              ? `Reviewing meal satisfaction ratings and recent student comments for ${data.from} → ${data.to}.`
              : "Review student satisfaction distributions and feedback across breakfast, lunch, and dinner."
          }
          why="Student feedback ratings directly influence recipe adjustments and help resolve hygiene or taste complaints before they escalate."
          severity="info"
          primaryAction={{ label: "Menu Management", href: "/mess/menu-management" }}
          secondaryActions={[
            { label: "Mess Issues", href: "/mess/mess-issues" },
            { label: "Token Scanner", href: "/mess/scan" },
            { label: "Mess Overview", href: "/mess" },
          ]}
        />
      </div>
      <WidgetBoundary title="Meal Reviews">
        {loading && <div className="space-y-2">{Array.from({ length: 4 }).map((_, i) => <Skeleton key={i} className="h-16 w-full" />)}</div>}
        {error && <div className="surface-card bg-rose-500/10 p-3 text-sm text-action-danger">{error}</div>}
        {data && (
          <div className="space-y-4">
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
              {MEAL_TYPES.map((m) => (
                <div key={m} className="surface-card p-3">
                  <div className="text-xs uppercase tracking-wide text-text-muted">{MEAL_LABEL[m]}</div>
                  <div className="mt-1 text-2xl font-semibold text-text-primary">
                    {data.totalsByMeal[m]?.averageScore?.toFixed(2) ?? "—"}
                  </div>
                  <div className="text-xs text-text-muted">{data.totalsByMeal[m]?.total ?? 0} reviews</div>
                </div>
              ))}
            </div>

            <SectionCard title="Daily distribution" description={`${data.from} → ${data.to}`}>
              <div className="space-y-2">
                {data.daily.length === 0 && <p className="text-sm text-text-muted">No reviews in this period.</p>}
                {data.daily.map((d) => (
                  <div key={`${d.date}|${d.mealType}`} className="surface-card p-2">
                    <div className="mb-1 flex items-center justify-between text-xs">
                      <span className="font-medium text-text-secondary">{d.date} · {MEAL_LABEL[d.mealType]}</span>
                      <span className="text-text-muted">avg {d.averageScore} · {d.total} reviews</span>
                    </div>
                    <div className="flex h-3 overflow-hidden rounded-full">
                      {SATISFACTION_LEVELS.map((s) => {
                        const count = d.distribution[s.value] ?? 0;
                        const pct = d.total ? (count / d.total) * 100 : 0;
                        return (
                          <div
                            key={s.value}
                            title={`${s.label}: ${count}`}
                            style={{ width: `${pct}%` }}
                            className={
                              s.value === "VERY_GOOD" ? "bg-action-success"
                                : s.value === "GOOD" ? "bg-lime-500"
                                : s.value === "AVERAGE" ? "bg-action-warning"
                                : s.value === "BAD" ? "bg-orange-500"
                                : "bg-action-danger"
                            }
                          />
                        );
                      })}
                    </div>
                  </div>
                ))}
              </div>
            </SectionCard>

            <SectionCard title="Recent comments" description={data.anonymous ? "Latest short comments from students. Comments are anonymised so feedback stays honest; only moderators see names." : "Latest short comments from students."}>
              <div className="space-y-2">
                {data.recentComments.length === 0 && <p className="text-sm text-text-muted">No comments yet.</p>}
                {data.recentComments.map((c) => (
                  <div key={c.id} className="surface-card p-2 text-sm">
                    <div className="flex items-center justify-between text-xs text-text-muted">
                      <span>{c.user_name} ({c.unique_id}) · {c.review_date} · {MEAL_LABEL[c.meal_type]}</span>
                      <span>{satisfactionLabel(c.satisfaction)}</span>
                    </div>
                    <p className="mt-1 text-text-secondary">{c.comment}</p>
                  </div>
                ))}
              </div>
            </SectionCard>
          </div>
        )}
      </WidgetBoundary>
    </div>
  );
}
