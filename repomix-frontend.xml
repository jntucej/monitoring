<file path="src/components/mess/InterestCountsPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import { Loader2, FileDown } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { useExport } from "@/hooks/useExport";
import { SPECIAL_CATEGORIES, type SpecialItemCategory } from "@/lib/mess-reviews";

interface ItemCount {
  id: string; code: string; label: string; category: SpecialItemCategory;
  isPrimary: boolean; count: number;
}
interface StudentRow {
  userId: string; name: string; uniqueId: string; itemIds: string[];
}

const CAT_LABEL = Object.fromEntries(
  SPECIAL_CATEGORIES.map((c) => [c.value, c.label]),
) as Record<SpecialItemCategory, string>;

export function InterestCountsPanel({ eventId }: { eventId: string }) {
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [items, setItems] = useState<ItemCount[]>([]);
  const [students, setStudents] = useState<StudentRow[]>([]);
  const [filterCat, setFilterCat] = useState<SpecialItemCategory | "all">("all");
  const { exportCSV } = useExport();

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(`/api/mess/special-events/${eventId}/interests/counts`, {
        headers: getAuthHeaders(), cache: "no-store",
      });
      const body = await res.json().catch(() => null);
      if (!res.ok || body?.data == null) throw new Error(body?.message ?? "Failed to load counts");
      setItems(body.data.items ?? []);
      setStudents(body.data.students ?? []);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load counts");
    } finally {
      setLoading(false);
    }
  }, [eventId]);

  useEffect(() => { void load(); }, [load]);

  const handleExport = () => {
    exportCSV(
      students.map((s) => ({
        student: s.name,
        roll: s.uniqueId,
        selections: s.itemIds.map((id) => items.find((i) => i.id === id)?.label ?? id).join("; "),
      })),
      [
        { key: "student", header: "Student" },
        { key: "roll", header: "Roll" },
        { key: "selections", header: "Items" },
      ],
      `interest_event_${eventId}.csv`
    );
  };

  if (loading)
    return <div className="flex items-center gap-2 text-sm text-text-muted"><Loader2 className="h-4 w-4 animate-spin" /> Loading counts…</div>;
  if (error) return <div className="text-sm text-action-danger">{error}</div>;

  const itemById = new Map(items.map((i) => [i.id, i]));
  const filteredItems = filterCat === "all" ? items : items.filter((i) => i.category === filterCat);
  const filteredStudents = filterCat === "all"
    ? students
    : students.filter((s) => s.itemIds.some((id) => itemById.get(id)?.category === filterCat));

  return (
    <div className="space-y-3">
      {/* Category filter + export */}
      <div className="flex items-center justify-between gap-2">
        <div className="flex items-center gap-1.5">
          {(["all", ...SPECIAL_CATEGORIES.map((c) => c.value)] as Array<SpecialItemCategory | "all">).map((cat) => (
            <button
              key={cat}
              type="button"
              onClick={() => setFilterCat(cat)}
              className={`rounded-full px-2.5 py-0.5 text-xs font-medium transition-colors ${
                filterCat === cat
                  ? "bg-action-primary text-white"
                  : "bg-bg-elevated text-text-secondary hover:bg-bg-surface"
              }`}
            >
              {cat === "all" ? "All" : CAT_LABEL[cat]}
            </button>
          ))}
        </div>
        <button
          type="button"
          onClick={handleExport}
          disabled={students.length === 0}
          className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
        >
          <FileDown className="h-3.5 w-3.5" />
        </button>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full text-sm">
          <thead>
            <tr className="text-left text-xs uppercase tracking-wide text-text-muted">
              <th className="py-1 pr-3">Item</th>
              <th className="py-1 pr-3">Category</th>
              <th className="py-1 pr-3">Count</th>
            </tr>
          </thead>
          <tbody>
            {filteredItems.map((it) => (
              <tr key={it.id} className="border-t border-border">
                <td className="py-1.5 pr-3 text-text-primary">
                  {it.label} <span className="font-mono text-xs text-text-muted">({it.code})</span>
                </td>
                <td className="py-1.5 pr-3 text-text-secondary">{CAT_LABEL[it.category]}</td>
                <td className="py-1.5 pr-3 font-semibold text-text-primary">{it.count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div className="overflow-x-auto">
        <table className="w-full text-sm">
          <thead>
            <tr className="text-left text-xs uppercase tracking-wide text-text-muted">
              <th className="py-1 pr-3">Student</th>
              <th className="py-1 pr-3">Roll</th>
              <th className="py-1 pr-3">Selections</th>
            </tr>
          </thead>
          <tbody>
            {filteredStudents.length === 0 && (
              <tr><td colSpan={3} className="py-2 text-text-muted">No students have registered yet.</td></tr>
            )}
            {filteredStudents.map((s) => (
              <tr key={s.userId} className="border-t border-border">
                <td className="py-1.5 pr-3 text-text-primary">{s.name}</td>
                <td className="py-1.5 pr-3 font-mono text-xs text-text-secondary">{s.uniqueId}</td>
                <td className="py-1.5 pr-3">
                  <div className="flex flex-wrap gap-1">
                    {s.itemIds.map((id) => {
                      const it = itemById.get(id);
                      return (
                        <span key={id} className={`surface-card px-2 py-0.5 text-xs ${filterCat === "all" || it?.category === filterCat ? "text-text-secondary" : "opacity-40"}`}>
                          {it?.label ?? id}
                        </span>
                      );
                    })}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
</file>

<file path="src/components/mess/MealReviewPanel.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { Clock, Loader2, Lock, RefreshCw, UtensilsCrossed, Pencil, Check } from "lucide-react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { EmptyState } from "@/components/shared/EmptyState";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import {
  MEAL_TYPES,
  MEAL_LABEL,
  MEAL_WINDOW,
  SATISFACTION_LEVELS,
  type MealType,
  type Satisfaction,
} from "@/lib/mess-reviews";

/** Coerce a review_date that the API may return as a full timestamp
 *  ("2026-11-20T00:00:00.000Z") to a bare "YYYY-MM-DD" string. The panel's
 *  filters compare review_date === today (a bare date), so a timestamp form
 *  used to silently drop every review from the list — the root cause of
 *  "my review is not showing." */
function toBareDate(v: unknown): string {
  const s = typeof v === "string" ? v : String(v ?? "");
  return s.slice(0, 10);
}

interface ReviewRow {
  id: string;
  review_date: string;
  meal_type: MealType;
  satisfaction: Satisfaction;
  comment: string | null;
  edit_count?: number;
}

/** Today's date in Asia/Kolkata (the campus operating timezone). */
function istToday(): string {
  return new Date().toLocaleDateString("en-CA", { timeZone: "Asia/Kolkata" });
}

/** Current IST time as [hour, minute]. */
function istNow(): [number, number] {
  const s = new Date().toLocaleTimeString("en-US", {
    timeZone: "Asia/Kolkata",
    hour12: false,
  });
  const [h, m] = s.split(":").map(Number);
  return [h || 0, m || 0];
}

function fmtTime([h, m]: [number, number]): string {
  const suffix = h < 12 ? "AM" : "PM";
  const hour12 = h % 12 === 0 ? 12 : h % 12;
  return `${hour12}:${m.toString().padStart(2, "0")} ${suffix}`;
}

type WindowPhase = "open" | "closed" | "upcoming";

function mealPhase(meal: MealType, now: [number, number]): WindowPhase {
  const w = MEAL_WINDOW[meal];
  const [sh, sm] = w.start;
  const [eh, em] = w.end;
  const cur = now[0] * 60 + now[1];
  if (cur < sh * 60 + sm) return "upcoming";
  if (cur > eh * 60 + em) return "closed";
  return "open";
}

export function MealReviewPanel() {
  const addToast = useUIStore((s) => s.addToast);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [reviews, setReviews] = useState<ReviewRow[]>([]);
  const [savingKey, setSavingKey] = useState<string | null>(null);
  const [commentDraft, setCommentDraft] = useState<Record<string, string>>({});
  // Inline edit of an already-saved review (satisfaction + comment). Editing is
  // allowed even after the meal window closes — only the first rating is
  // window-gated. Submissions reuse the existing POST upsert (bumps edit_count).
  const [editingId, setEditingId] = useState<string | null>(null);
  const [editSat, setEditSat] = useState<Satisfaction | null>(null);
  const [editComment, setEditComment] = useState<string>("");
  // 30s tick keeps the countdown current.
  const [now, setNow] = useState<[number, number]>(istNow());

  const today = istToday();

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(`/api/mess/reviews?from=${today}&to=${today}`, {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const body = await res.json().catch(() => null);
      // ok   -> { success: true, data: { reviews } }
      // fail -> { success: false, error: "CODE", message: "..." }
      if (!res.ok || body?.data == null) {
        throw new Error(body?.message ?? "Failed to load reviews");
      }
      setReviews(
        (body.data.reviews ?? []).map((r: ReviewRow) => ({
          ...r,
          review_date: toBareDate(r.review_date),
        })),
      );
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to load reviews");
    } finally {
      setLoading(false);
    }
  }, [today]);

  useEffect(() => {
    void load();
    const t = setInterval(() => setNow(istNow()), 30_000);
    return () => clearInterval(t);
  }, [load]);

  const reviewMap = useMemo(() => {
    const m = new Map<string, ReviewRow>();
    for (const r of reviews) m.set(`${r.review_date}|${r.meal_type}`, r);
    return m;
  }, [reviews]);

  const openMeals = MEAL_TYPES.filter((m) => mealPhase(m, now) === "open");
  const anyOpen = openMeals.length > 0;
  const openWindowLabel = openMeals.length
    ? openMeals.map((m) => MEAL_LABEL[m]).join(" · ")
    : null;

  const submit = useCallback(
    async (date: string, meal: MealType, satisfaction: Satisfaction) => {
      const key = `${date}|${meal}`;
      setSavingKey(key);
      try {
        const res = await fetch("/api/mess/reviews", {
          method: "POST",
          headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
          body: JSON.stringify({
            reviewDate: date,
            mealType: meal,
            satisfaction,
            comment: commentDraft[key] ?? null,
          }),
        });
        const body = await res.json().catch(() => null);
        // ok   -> { success: true, data: { review } }
        // fail -> { success: false, error: "CODE", message: "..." }
        if (!res.ok || body?.data == null) {
          throw new Error(body?.message ?? "Save failed");
        }
        const saved = { ...(body.data.review as ReviewRow), review_date: toBareDate((body.data.review as ReviewRow).review_date) };
        setReviews((prev) => {
          const next = prev.filter((r) => !(r.review_date === date && r.meal_type === meal));
          next.push(saved);
          return next;
        });
        addToast({ message: "Review saved", variant: "success" });
      } catch (e) {
        addToast({ message: e instanceof Error ? e.message : "Save failed", variant: "error" });
      } finally {
        setSavingKey(null);
      }
    },
    [addToast, commentDraft],
  );

  // Open inline edit for a saved review. Prefill satisfaction + comment.
  const beginEdit = useCallback((r: ReviewRow) => {
    setEditingId(r.id);
    setEditSat(r.satisfaction as Satisfaction);
    setEditComment(r.comment ?? "");
    setCommentDraft((prev) => ({ ...prev, [`${r.review_date}|${r.meal_type}`]: r.comment ?? "" }));
  }, []);

  // Persist an edited review (satisfaction/comment) via the existing upsert.
  const saveEdit = useCallback(
    async (r: ReviewRow) => {
      const key = `${r.review_date}|${r.meal_type}`;
      setSavingKey(key);
      try {
        const res = await fetch("/api/mess/reviews", {
          method: "POST",
          headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
          body: JSON.stringify({
            reviewDate: r.review_date,
            mealType: r.meal_type,
            satisfaction: editSat ?? r.satisfaction,
            comment: editComment || null,
          }),
        });
        const body = await res.json().catch(() => null);
        if (!res.ok || body?.data == null) {
          throw new Error(body?.message ?? "Save failed");
        }
        const saved = { ...(body.data.review as ReviewRow), review_date: toBareDate((body.data.review as ReviewRow).review_date) };
        setReviews((prev) =>
          prev.map((x) => (x.id === r.id ? { ...saved, edit_count: (x.edit_count ?? 0) + 1 } : x)),
        );
        setEditingId(null);
        addToast({ message: "Review updated", variant: "success" });
      } catch (e) {
        addToast({ message: e instanceof Error ? e.message : "Save failed", variant: "error" });
      } finally {
        setSavingKey(null);
      }
    },
    [addToast, editSat, editComment],
  );

  if (loading) {
    return (
      <WidgetBoundary title="Meal Reviews">
        <div className="space-y-3">
          {Array.from({ length: 3 }).map((_, i) => <Skeleton key={i} className="h-5 w-full" />)}
        </div>
      </WidgetBoundary>
    );
  }

  return (
    <WidgetBoundary title="Meal Reviews">
      <div className="space-y-4">
        {/* Header + current-window status */}
        <div className="flex items-center justify-between gap-3">
          <div>
            <h2 className="text-lg font-semibold text-text-primary">Meal Reviews</h2>
            <p className="text-sm text-text-muted">
              Rate meals while their serving window is open.
            </p>
          </div>
          <button
            type="button"
            onClick={() => void load()}
            className="surface-card inline-flex items-center gap-2 px-3 py-2 text-sm text-text-secondary hover:bg-bg-surface"
          >
            <RefreshCw className="h-5 w-5" /> Refresh
          </button>
        </div>

        {/* Current meal-window status card */}
        <div
          className={`rounded-xl border p-4 ${
            anyOpen
              ? "border-emerald-500/30 bg-emerald-500/10"
              : "border-border bg-bg-surface/60"
          }`}
        >
          <div className="flex items-center gap-2.5">
            {anyOpen ? (
              <Clock className="h-5 w-5 shrink-0 text-action-success" />
            ) : (
              <Lock className="h-5 w-5 shrink-0 text-text-muted" />
            )}
            <div className="min-w-0">
              <p className={`text-sm font-semibold ${anyOpen ? "text-action-success" : "text-text-secondary"}`}>
                {anyOpen ? `Now serving: ${openWindowLabel}` : "No meal window open right now"}
              </p>
              <p className="text-xs text-text-muted">
                {anyOpen
                  ? "You can rate these meals below."
                  : "Reviews are available during today's breakfast, lunch and dinner windows."}
              </p>
            </div>
          </div>
          {error && (
            <div className="mt-3 rounded-lg bg-rose-500/10 p-3 text-sm text-action-danger">
              {error}{" "}
              <button type="button" onClick={() => void load()} className="underline">Retry</button>
            </div>
          )}
        </div>

        {/* Today's meals — each with its own window state */}
        <div className="grid gap-3 md:grid-cols-3">
          {MEAL_TYPES.map((meal) => {
            const phase = mealPhase(meal, now);
            const key = `${today}|${meal}`;
            const existing = reviewMap.get(key);
            const selected = existing?.satisfaction ?? null;
            const win = MEAL_WINDOW[meal].start;
            const winEnd = MEAL_WINDOW[meal].end;

            return (
              <div
                key={meal}
                className={`rounded-xl border p-4 transition ${
                  phase === "open"
                    ? "border-emerald-500/40 bg-emerald-500/5"
                    : "border-border bg-bg-surface/60"
                }`}
              >
                <div className="mb-2 flex items-center justify-between">
                  <span className="text-sm font-medium text-text-secondary">{MEAL_LABEL[meal]}</span>
                  <span
                    className={`rounded-full px-2 py-0.5 text-xs font-bold uppercase tracking-wide ${
                      phase === "open"
                        ? "bg-emerald-500/20 text-action-success"
                        : phase === "upcoming"
                        ? "bg-sky-500/20 text-action-info"
                        : "bg-bg-elevated text-text-muted"
                    }`}
                  >
                    {phase === "open" ? "Window open" : phase === "upcoming" ? `Opens ${fmtTime(win)}` : `Closed ${fmtTime(winEnd)}`}
                  </span>
                </div>

                {phase === "open" ? (
                  <>
                    <div className="flex flex-wrap gap-1.5">
                      {SATISFACTION_LEVELS.map((opt) => {
                        const active = selected === opt.value;
                        return (
                          <button
                            key={opt.value}
                            type="button"
                            disabled={savingKey === key}
                            onClick={() => void submit(today, meal, opt.value)}
                            className={`flex items-center gap-1 rounded-md border px-2 py-1 text-xs transition ${
                              active
                                ? opt.tone
                                : "border-border text-text-muted hover:bg-bg-elevated"
                            }`}
                            title={opt.label}
                          >
                            <span aria-hidden>{opt.emoji}</span>
                            <span className="hidden sm:inline">{opt.label}</span>
                          </button>
                        );
                      })}
                    </div>
                    <input
                      type="text"
                      maxLength={280}
                      placeholder="Optional short comment (280 chars)"
                      defaultValue={existing?.comment ?? ""}
                      onChange={(e) => setCommentDraft((prev) => ({ ...prev, [key]: e.target.value }))}
                      onBlur={(e) => {
                        const v = e.target.value;
                        setCommentDraft((prev) => ({ ...prev, [key]: v }));
                        if (selected && v !== (existing?.comment ?? "")) void submit(today, meal, selected);
                      }}
                      className="surface-card mt-2 w-full bg-[var(--bg)] px-2 py-1.5 text-xs text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-action-primary"
                    />
                    {savingKey === key && (
                      <div className="mt-2 flex items-center gap-1.5 text-xs text-text-muted">
                        <Loader2 className="h-3.5 w-3.5 animate-spin" /> Saving…
                      </div>
                    )}
                  </>
                ) : (
                  <p className="text-xs text-text-muted">
                    {phase === "upcoming"
                      ? `Window opens at ${fmtTime(win)} — you can rate this meal then.`
                      : `Window closed at ${fmtTime(winEnd)} — this meal can no longer be rated.`}
                  </p>
                )}
              </div>
            );
          })}
        </div>

        {/* Today's saved reviews */}
        {!error && reviews.length > 0 && (
          <div>
            <h3 className="mb-2 text-sm font-semibold text-text-secondary">Your reviews today</h3>
            <div className="divide-y divide-border/60 rounded-xl border border-border bg-bg-surface/40">
              {reviews
                .filter((r) => r.review_date === today)
                .map((r) => {
                  const isEditing = editingId === r.id;
                  return (
                    <div
                      key={r.id}
                      className="px-3 py-2"
                    >
                      <div className="flex items-center justify-between gap-2">
                        <div className="min-w-0">
                          <p className="text-xs font-semibold text-text-primary">
                            {MEAL_LABEL[r.meal_type]}
                            {r.comment ? <span className="ml-2 font-normal text-text-muted">“{r.comment}”</span> : null}
                          </p>
                          <p className="text-xs text-text-muted">
                            Rated {SATISFACTION_LEVELS.find((s) => s.value === r.satisfaction)?.label ?? r.satisfaction}
                            {r.edit_count ? ` · edited ${r.edit_count}×` : ""}
                          </p>
                        </div>
                        {!isEditing && (
                          <button
                            type="button"
                            onClick={() => beginEdit(r)}
                            className="shrink-0 inline-flex items-center gap-1 rounded-md border border-border px-2 py-1 text-xs text-text-secondary hover:bg-bg-elevated"
                          >
                            <Pencil className="h-3 w-3" /> Edit
                          </button>
                        )}
                      </div>

                      {isEditing && (
                        <div className="mt-3 space-y-2">
                          <div className="flex flex-wrap gap-1.5">
                            {SATISFACTION_LEVELS.map((opt) => {
                              const active = editSat === opt.value;
                              return (
                                <button
                                  key={opt.value}
                                  type="button"
                                  disabled={savingKey !== null}
                                  onClick={() => setEditSat(opt.value as Satisfaction)}
                                  className={`flex items-center gap-1 rounded-md border px-2 py-1 text-xs transition ${
                                    active ? opt.tone : "border-border text-text-muted hover:bg-bg-elevated"
                                  }`}
                                >
                                  <span aria-hidden>{opt.emoji}</span>
                                  <span className="hidden sm:inline">{opt.label}</span>
                                </button>
                              );
                            })}
                          </div>
                          <input
                            type="text"
                            maxLength={280}
                            value={editComment}
                            onChange={(e) => setEditComment(e.target.value)}
                            placeholder="Optional comment (280 chars)"
                            className="w-full border border-border rounded-md bg-bg-surface px-2 py-1.5 text-xs text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-action-primary"
                          />
                          <div className="flex items-center gap-2">
                            <button
                              type="button"
                              disabled={savingKey !== null}
                              onClick={() => void saveEdit(r)}
                              className="inline-flex items-center gap-1 rounded-md bg-action-primary px-2.5 py-1.5 text-xs font-semibold text-white hover:opacity-95 disabled:opacity-60"
                            >
                              {savingKey !== null ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Check className="h-3.5 w-3.5" />}
                              Save
                            </button>
                            <button
                              type="button"
                              onClick={() => setEditingId(null)}
                              className="rounded-md border border-border px-2.5 py-1.5 text-xs text-text-secondary hover:bg-bg-elevated"
                            >
                              Cancel
                            </button>
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
            </div>
          </div>
        )}

        {!loading && !error && reviews.filter((r) => r.review_date === today).length === 0 && (
          <EmptyState
            title="No reviews yet"
            description="Rate a meal above as soon as its serving window is open."
            icon={<UtensilsCrossed className="size-5" />}
          />
        )}
      </div>
    </WidgetBoundary>
  );
}
