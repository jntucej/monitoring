<file path="src/components/student/AcademicPersonalSection.tsx">
"use client";

import { useAuthStore } from "@/stores/authStore";
import { GraduationCap, User, Phone, MapPin, IdCard } from "lucide-react";

/**
 * "Academic & Personal" detail section for the student profile.
 *
 * Fields are read from the joined `student_details` row (available on
 * `user.studentDetails` after /api/profile or /api/students/:roll). All 32
 * extended fields are nullable — anything still unset renders "—".
 */
export function AcademicPersonalSection() {
  const { user } = useAuthStore();
  const sd: Record<string, any> | null | undefined = (user as any)?.studentDetails;

  if (!sd) return null;

  const value = (k: string): string => {
    const raw = sd?.[k];
    if (raw === null || raw === undefined || raw === "") return "—";
    return String(raw);
  };

  const academic: Array<{ key: string; label: string }> = [
    { key: "department", label: "Department" },
    { key: "branch", label: "Branch" },
    { key: "semester", label: "Semester" },
    { key: "regulation", label: "Regulation" },
    { key: "admissionDate", label: "Admission Date" },
    { key: "admissionCategory", label: "Admission Category" },
    { key: "eamcetHtNo", label: "EAMCET HT No." },
    { key: "eamcetEcetRank", label: "EAMCET/ECET Rank" },
    { key: "htNo", label: "HT No." },
  ];

  const personal: Array<{ key: string; label: string }> = [
    { key: "studentName", label: "Student Name" },
    { key: "identificationMarks1", label: "Identification Mark 1" },
    { key: "identificationMarks2", label: "Identification Mark 2" },
    { key: "mobile", label: "Mobile" },
    { key: "email", label: "Email" },
    { key: "bloodGroup", label: "Blood Group" },
    { key: "nationality", label: "Nationality" },
    { key: "religion", label: "Religion" },
    { key: "caste", label: "Caste" },
    { key: "subcaste", label: "Sub-caste" },
    { key: "phStatus", label: "PH Status" },
    { key: "dob", label: "Date of Birth" },
  ];

  const family: Array<{ key: string; label: string }> = [
    { key: "fatherGuardianName", label: "Father / Guardian" },
    { key: "motherName", label: "Mother" },
    { key: "parentMobile", label: "Parent Mobile" },
    { key: "parentEmail", label: "Parent Email" },
    { key: "fatherOccupation", label: "Father Occupation" },
    { key: "incomePerAnnum", label: "Income / Annum" },
  ];

  const address: Array<{ key: string; label: string }> = [
    { key: "address", label: "Address" },
    { key: "city", label: "City" },
    { key: "district", label: "District" },
    { key: "state", label: "State" },
    { key: "pincode", label: "Pincode" },
  ];

  const group = (
    title: string,
    icon: React.ReactNode,
    rows: Array<{ key: string; label: string }>,
    id: string
  ) => {
    const filled = rows.filter((r) => value(r.key) !== "—");
    if (filled.length === 0) return null;
    return (
      <div key={id} className="surface-card bg-bg-surface p-4 sm:p-5">
        <div className="flex items-center gap-2 mb-3">
          <span className="text-action-primary">{icon}</span>
          <h3 className="text-xs font-bold uppercase tracking-wider text-text-secondary">{title}</h3>
        </div>
        <dl className="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2">
          {filled.map((r) => (
            <div key={r.key} className="surface-card flex items-baseline justify-between gap-3 py-1 last:">
              <dt className="text-xs sm:text-xs font-medium text-text-muted">{r.label}</dt>
              <dd className="text-xs sm:text-xs font-semibold text-text-primary text-right break-words">
                {value(r.key)}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    );
  };

  return (
    <div className="space-y-4 w-full">
      <div className="flex items-center gap-2">
        <IdCard className="w-4 h-4 text-action-primary" />
        <p className="text-sm font-semibold text-text-primary">Academic &amp; Personal Details</p>
      </div>
      {group("Academic", <GraduationCap className="w-4 h-4" />, academic, "academic")}
      {group("Personal", <User className="w-4 h-4" />, personal, "personal")}
      {group("Family & Guardian", <Phone className="w-4 h-4" />, family, "family")}
      {group("Address", <MapPin className="w-4 h-4" />, address, "address")}
    </div>
  );
}
</file>

<file path="src/components/student/ActivePasses.tsx">
"use client";
import { useCallback, useEffect, useMemo, useState } from "react";
import { Loader2, Clock, CheckCircle2, XCircle, FileDown, History, TrendingUp, TrendingDown, RefreshCw } from "lucide-react";
import type { GatePass } from "@/lib/types";
import { getPassTypeName } from "@/hooks/usePassTypes";
import { getAuthHeaders } from "@/lib/utils";
import { usePolling } from "@/hooks/usePolling";
import { useAuthStore } from "@/stores/authStore";
import { useExport } from "@/hooks/useExport";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import type { Period } from "@/lib/period";
import { getPeriod } from "@/lib/period";
import { PassLiveTracker } from "@/components/shared/pass/PassLiveTracker";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { passInspection } from "@/components/shared/inspectionModels";
import { useIsSakuga } from "@/components/student/useIsSakuga";

function expiryLabel(to: string, status: string): string {
  if (status === "REJECTED") return "Rejected";
  if (status === "PENDING" || status === "APPROVED_PARENT" || status === "APPROVED_ADMIN") return "Awaiting approval";
  const ms = new Date(to).getTime() - Date.now();
  if (ms <= 0) return "Expired";
  const hours = Math.floor(ms / 3_600_000);
  if (hours < 1) return `Expires in ${Math.floor(ms / 60_000)} min`;
  if (hours < 24) return `Expires in ${hours} hour${hours === 1 ? "" : "s"}`;
  const days = Math.floor(hours / 24);
  return `Expires in ${days} day${days === 1 ? "" : "s"}`;
}

function statusStyle(s: string) {
  if (s === "APPROVED" || s === "COMPLETED") return { text: "text-action-success", bg: "bg-emerald-500/10", icon: <CheckCircle2 className="size-4 text-action-success" /> };
  if (s === "REJECTED") return { text: "text-action-danger", bg: "bg-rose-500/10", icon: <XCircle className="size-4 text-action-danger" /> };
  return { text: "text-action-warning", bg: "bg-amber-500/10", icon: <Clock className="size-4 text-action-warning" /> };
}

export interface ActivePassesProps {
  /** Fired when a pass row is selected, so the page can surface the
   * "focus a document" pivot (SelfActionLoop). */
  onSelectPass?: (ticketId: string) => void;
}

export function ActivePasses({ onSelectPass }: ActivePassesProps) {
  const [passes, setPasses] = useState<GatePass[]>([]);
  const [history, setHistory] = useState<GatePass[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [period, setPeriod] = useState<Period>(getPeriod("this-month"));
  const [showHistory, setShowHistory] = useState(false);
  const [trackId, setTrackId] = useState<string | null>(null);
  const [activePass, setActivePass] = useState<string | null>(null);
  const isSakuga = useIsSakuga();
  const user = useAuthStore((s) => s.user);
  const { exportCSV } = useExport();

  const load = useCallback(async () => {
    const roll = user?.uniqueId ?? user?.studentDetails?.roll ?? null;
    if (!roll) {
      setLoading(false);
      return;
    }
    try {
      const res = await fetch(`/api/passes?roll=${encodeURIComponent(roll)}`, {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      if (!res.ok) {
        setError(`HTTP ${res.status}`);
      }
      const json = await res.json().catch(() => ({}));
      const all: GatePass[] = Array.isArray(json.data) ? json.data : [];
      setPasses(all);
      setError(null);
      setLoading(false);
    } catch {
      setError("Request failed");
      setLoading(false);
    }
  }, [user?.uniqueId, user?.studentDetails?.roll]);

  // Period-filtered history
  const periodFrom = useMemo(() => period.from.slice(0, 10), [period]);
  const todayStr = useMemo(() => new Date().toISOString().slice(0, 10), []);

  const filtered = useMemo(
    () => passes.filter((p) => p.from >= periodFrom && p.to <= todayStr || p.finalStatus === "PENDING" || p.finalStatus === "COMPLETED"),
    [passes, periodFrom, todayStr]
  );

  // Usage delta: this period vs previous same-length window
  const usageDelta = useMemo(() => {
    const periodDays = Math.max(1, Math.round((new Date(period.to).getTime() - new Date(period.from).getTime()) / 86_400_000));
    const prevFrom = new Date(period.from);
    prevFrom.setDate(prevFrom.getDate() - periodDays);
    const prevFromStr = prevFrom.toISOString().slice(0, 10);
    const prevToStr = period.from.slice(0, 10);
    const prevCount = passes.filter((p) => p.from >= prevFromStr && p.to <= prevToStr).length;
    const curCount = filtered.length;
    return { cur: curCount, prev: prevCount, delta: curCount - prevCount, periodDays };
  }, [passes, filtered, period]);

  const handleExportHistory = () => {
    exportCSV(
      filtered.map((p) => ({
        type: getPassTypeName(p.reason),
        from: p.from,
        to: p.to,
        status: p.finalStatus,
        requestedAt: p.requestedAt,
      })),
      [
        { key: "type", header: "Pass Type" },
        { key: "from", header: "From" },
        { key: "to", header: "To" },
        { key: "status", header: "Status" },
        { key: "requestedAt", header: "Requested" },
      ],
      `pass_history_${period.key}.csv`
    );
  };

  // Initial load + visibility-aware polling (no raw setInterval)
  useEffect(() => {
    load().catch(() => {});
  }, [load]);
  usePolling(load, { intervalMs: 30_000 });

  return (
    <div className="surface-card bg-bg-surface p-6">
      <h3 className="font-semibold mb-4">Active Passes</h3>
      {loading ? (
        <div className="flex items-center gap-2 text-sm text-text-muted">
          <Loader2 className="w-4 h-4 animate-spin" /> Loading…
        </div>
      ) : error ? (
        <div className="surface-card flex flex-col sm:flex-row items-center justify-between gap-2 p-3 bg-rose-500/10">
          <p className="text-sm text-action-danger">Could not load passes: {error}</p>
          {isSakuga ? (
            <sakuga-button
              onClick={load}
              className="shrink-0"
            >
              Retry
            </sakuga-button>
          ) : (
          <button
            onClick={load}
            className="surface-card px-3 py-1 bg-rose-500/20 text-action-danger text-xs font-bold hover:bg-rose-500/30 transition shrink-0"
          >
            Retry
          </button>
          )}
        </div>
      ) : passes.length === 0 ? (
        <p className="text-sm text-text-muted text-center py-4">No passes yet.</p>
      ) : (
        <div className="space-y-4">
          {passes.map((pass) => {
            const s = statusStyle(pass.finalStatus);
            const active = pass.finalStatus !== "REJECTED" && pass.finalStatus !== "COMPLETED";
            return (
              <div
                key={pass.id}
                className={`p-3 rounded-lg ${s.bg} cursor-pointer hover:opacity-90 transition-opacity`}
                onClick={() => {
                  setActivePass(pass.id);
                  onSelectPass?.(pass.id);
                }}
              >
                <div className="flex items-center gap-4">
                  {s.icon}
                  <div className="flex-1">
                    <p className={`font-medium ${s.text}`}>{getPassTypeName(pass.reason)}</p>
                    <p className={`text-sm ${s.text} opacity-80`}>
                      {expiryLabel(pass.to, pass.finalStatus)}
                    </p>
                  </div>
                  <div className="flex flex-col items-end gap-1">
                    <span className="surface-card text-xs font-semibold uppercase tracking-wider bg-black/20 px-2 py-1">
                      {pass.finalStatus}
                    </span>
                    {pass.parentStatus !== 'APPROVED' && (
                      <span className="text-xs opacity-60">Parent: {pass.parentStatus}</span>
                    )}
                    {pass.adminStatus !== 'APPROVED' && (
                      <span className="text-xs opacity-60">Admin: {pass.adminStatus}</span>
                    )}
                    {active && (
                      isSakuga ? (
                        <sakuga-button
                          onClick={(e: React.MouseEvent) => { e.stopPropagation(); setTrackId(trackId === pass.id ? null : pass.id); }}
                          className="text-[11px] font-medium mt-0.5"
                        >
                          {trackId === pass.id ? "Hide tracker" : "Live tracker"}
                        </sakuga-button>
                      ) : (
                      <button
                        type="button"
                        onClick={(e) => { e.stopPropagation(); setTrackId(trackId === pass.id ? null : pass.id); }}
                        className="text-[11px] font-medium text-action-primary hover:underline mt-0.5"
                      >
                        {trackId === pass.id ? "Hide tracker" : "Live tracker"}
                      </button>
                      )
                    )}
                  </div>
                </div>
                {/* The pass loop (S4): live "where is it" tracker */}
                {active && trackId === pass.id && (
                  <div className="mt-3 pl-10">
                    <PassLiveTracker passId={pass.id} expectedReturnAt={pass.to} />
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      {/* Usage KPI */}
      <div className="mt-3 sm:mt-4 w-full max-w-sm rounded-xl border border-border bg-bg-elevated p-3">
        <div className="flex items-center justify-between">
          <span className="text-xs font-medium text-text-muted uppercase">Usage this period</span>
          <span className="text-xs text-text-muted tabular-nums">
            {usageDelta.cur} this · {usageDelta.prev} prev
          </span>
        </div>
        <div className="flex items-center gap-1.5 mt-1">
          <span className="text-lg font-bold text-text-primary tabular-nums">{usageDelta.cur}</span>
          {usageDelta.delta > 0 && (
            <span className="inline-flex items-center text-xs text-emerald-500">
              <TrendingUp className="h-3 w-3" /> +{usageDelta.delta}
            </span>
          )}
          {usageDelta.delta < 0 && (
            <span className="inline-flex items-center text-xs text-rose-500">
              <TrendingDown className="h-3 w-3" /> {usageDelta.delta}
            </span>
          )}
          {usageDelta.delta === 0 && <span className="text-xs text-text-muted">no change</span>}
        </div>
      </div>

      {/* History toggle + period + export */}
      <div className="mt-5 border-t border-border pt-4">
        <div className="flex items-center justify-between gap-2 flex-wrap">
          {isSakuga ? (
            <sakuga-toggle
              checked={showHistory}
              onChange={((v: unknown) => setShowHistory(Boolean(v))) as any}
            />
          ) : (
          <button
            type="button"
            onClick={() => setShowHistory((v) => !v)}
            className="inline-flex items-center gap-1.5 text-xs text-text-muted hover:text-action-primary"
          >
            <History className="h-3.5 w-3.5" />
            {showHistory ? "Hide history" : "View history"}
          </button>
          )}
          <div className="flex items-center gap-2">
            <PeriodPicker value={period} onChange={setPeriod} />
            <button
              type="button"
              onClick={handleExportHistory}
              disabled={filtered.length === 0}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        {showHistory && filtered.length > 0 && (
          <div className="mt-3 space-y-1.5">
            {filtered.slice(0, 15).map((p) => (
              <div key={p.id} className="rounded-lg bg-bg-elevated border border-border px-3 py-2 flex items-center justify-between text-xs">
                <div>
                  <span className="font-medium text-text-primary">{getPassTypeName(p.reason)}</span>
                  <span className="ml-2 text-text-muted tabular-nums">{p.from.slice(0, 10)} → {p.to.slice(0, 10)}</span>
                </div>
                <span className={`uppercase font-medium ${
                  p.finalStatus === "COMPLETED" ? "text-emerald-500" :
                  p.finalStatus === "PENDING" ? "text-amber-500" : "text-rose-500"
                }`}>
                  {p.finalStatus}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* Standardized inspection model for a pass (the registry). */}
      {(() => {
        const sel = passes.find((p) => p.id === activePass) ?? null;
        const model = sel ? passInspection(sel as any) : null;
        return (
          <EntityInspector inspection={model} onClose={() => setActivePass(null)} />
        );
      })()}
    </div>
  );
}
</file>

<file path="src/components/student/AntiRaggingProgress.tsx">
"use client";

/**
 * AntiRaggingProgress — student-facing view of their own anti-ragging cases.
 *
 * Answers the two questions the student must be able to see:
 *   1. TO WHOM it is assigned (assignedTo / assignedToName / the Principal's
 *      office), and
 *   2. THE PROGRESS — which stage of the review chain the case is at
 *      (submitted → under_review → investigating → action_taken / referred /
 *      closed) + any committee notes + last update.
 *
 * It reads /api/anti-ragging/cases, which now returns ONLY the student's own
 * cases (filtered server-side by reporter_hash) + the assigned-to user name.
 * No new enforcement; purely a projection of the case status the admin console
 * already manages.
 */

import { useEffect, useState } from "react";
import { getAuthHeaders } from "@/lib/utils";
import {
  ShieldAlert,
  Loader2,
  UserCog,
  FileCheck,
  Gavel,
  Clock,
  CheckCircle2,
  GitBranch,
} from "lucide-react";

interface AntiRaggingCase {
  id: string;
  caseNumber: string;
  isAnonymous: boolean;
  category: string;
  severity: string;
  status: string;
  assignedTo: string | null;
  assignedToName: string | null;
  committeeNotes: string | null;
  createdAt: string;
  updatedAt: string;
}

// The progress chain, in order. A case's status maps to how far along it is.
const STATUS_CHAIN: Array<{ key: string; label: string }> = [
  { key: "submitted", label: "Filed" },
  { key: "under_review", label: "Under review" },
  { key: "investigating", label: "Investigating" },
  { key: "action_taken", label: "Action taken" },
  { key: "closed", label: "Closed" },
];
// "referred" is a side-track (sent to a higher authority), not a stage in the
// linear chain — it shows as its own state.
function stepIndex(status: string): number {
  const i = STATUS_CHAIN.findIndex((s) => s.key === status);
  return i; // -1 when "referred" (handled separately)
}

function StatusTracker({ status }: { status: string }) {
  if (status === "referred") {
    return (
      <span className="inline-flex items-center gap-1.5 rounded-full bg-violet-500/10 text-violet-600 px-2.5 py-1 text-xs font-medium">
        <GitBranch className="h-3.5 w-3.5" /> Referred to higher authority
      </span>
    );
  }
  const idx = stepIndex(status);
  return (
    <ol className="flex flex-wrap items-center gap-1.5">
      {STATUS_CHAIN.map((s, i) => {
        const done = idx >= 0 && i < idx;
        const current = idx === i;
        const cls = done
          ? "bg-emerald-500/15 text-emerald-600 border-emerald-500/30"
          : current
            ? "bg-action-primary/15 text-action-primary border-action-primary/40"
            : "bg-bg-elevated text-text-muted border-border";
        return (
          <li key={s.key} className="flex items-center gap-1.5">
            <span
              className={`inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium ${cls}`}
            >
              {done && <CheckCircle2 className="h-3 w-3" />}
              {current && <Loader2 className="h-3 w-3 animate-spin" />}
              {s.label}
            </span>
            {i < STATUS_CHAIN.length - 1 && (
              <span className="h-px w-3 bg-border" aria-hidden />
            )}
          </li>
        );
      })}
    </ol>
  );
}

function CaseCard({ c }: { c: AntiRaggingCase }) {
  return (
    <div className="surface-card bg-bg-surface p-4 space-y-3">
      <div className="flex items-center justify-between gap-2">
        <div className="flex items-center gap-2 min-w-0">
          <ShieldAlert className="h-4 w-4 shrink-0 text-action-danger" />
          <span className="font-mono text-sm font-semibold text-text-primary">
            {c.caseNumber}
          </span>
          <span className="text-xs text-text-muted uppercase">
            {c.category}
          </span>
          {c.isAnonymous && (
            <span className="rounded-full bg-bg-elevated px-2 py-0.5 text-xs text-text-muted">
              anonymous
            </span>
          )}
        </div>
        <span className="text-xs text-text-muted">
          {new Date(c.createdAt).toLocaleDateString(undefined, {
            day: "numeric",
            month: "short",
            year: "numeric",
          })}
        </span>
      </div>

      <StatusTracker status={c.status} />

      <div className="grid gap-2 sm:grid-cols-2 text-xs">
        <div className="flex items-center gap-2 text-text-secondary">
          <UserCog className="h-3.5 w-3.5 text-text-muted" />
          <span className="text-text-muted">Assigned to</span>
          <span className="font-medium text-text-primary">
            {c.assignedToName || (c.assignedTo ? "A reviewer" : "Not yet assigned")}
          </span>
        </div>
        <div className="flex items-center gap-2 text-text-secondary">
          <Clock className="h-3.5 w-3.5 text-text-muted" />
          <span className="text-text-muted">Last updated</span>
          <span className="font-medium text-text-primary">
            {new Date(c.updatedAt).toLocaleString(undefined, {
              day: "numeric",
              month: "short",
              hour: "2-digit",
              minute: "2-digit",
            })}
          </span>
        </div>
      </div>

      {c.committeeNotes && (
        <div className="rounded-lg border border-border bg-background p-3 text-xs text-text-secondary">
          <div className="flex items-center gap-1.5 text-text-muted mb-1">
            <FileCheck className="h-3.5 w-3.5" /> Committee note
          </div>
          <p className="whitespace-pre-wrap">{c.committeeNotes}</p>
        </div>
      )}
    </div>
  );
}

export function AntiRaggingProgress() {
  const [cases, setCases] = useState<AntiRaggingCase[] | null>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let cancelled = false;
    fetch("/api/anti-ragging/cases", { headers: getAuthHeaders() })
      .then((r) => r.json())
      .then((j) => {
        if (cancelled) return;
        if (j.success && Array.isArray(j.data?.cases)) setCases(j.data.cases);
        else setError(j.error?.message ?? "Could not load your cases");
      })
      .catch(() => {
        if (!cancelled) setError("Could not load your cases");
      });
    return () => {
      cancelled = true;
    };
  }, []);

  if (error) {
    return (
      <div className="surface-card bg-bg-surface p-4 text-sm text-text-muted">
        Progress unavailable: {error}
      </div>
    );
  }
  if (cases === null) {
    return (
      <div className="surface-card bg-bg-surface p-4 flex items-center gap-2 text-sm text-text-muted">
        <Loader2 className="h-4 w-4 animate-spin" /> Loading your cases…
      </div>
    );
  }

  return (
    <section className="space-y-3" aria-label="Your anti-ragging case progress">
      <div className="flex items-center gap-2">
        <Gavel className="h-4 w-4 text-action-primary" />
        <h2 className="text-sm font-semibold text-primary">
          Your case progress{" "}
          <span className="text-text-muted font-normal">
            ({cases.length} {cases.length === 1 ? "case" : "cases"})
          </span>
        </h2>
      </div>

      {cases.length === 0 ? (
        <div className="surface-card bg-bg-surface p-4 text-sm text-text-muted">
          No cases on file yet. When you file a report, its status and who it
          was assigned to will appear here.
        </div>
      ) : (
        <div className="space-y-3">
          {cases.map((c) => (
            <CaseCard key={c.id} c={c} />
          ))}
        </div>
      )}
    </section>
  );
}
</file>

