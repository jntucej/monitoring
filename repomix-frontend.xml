<file path="src/app/exam-branch/docs/page.tsx">
"use client";

import { Suspense, useCallback, useMemo, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import {
  FileText,
  AlertTriangle,
  ArrowRight,
  Search,
  ExternalLink,
  BookOpen,
} from "lucide-react";

/* /api/campus-extra/knowledge response shape */
interface KnowledgeDoc {
  id: string;
  category: string;
  title: string;
  body: string;
  ownerRole: string;
  updatedAt: string;
  version: number;
}

interface KnowledgeResponse {
  success: boolean;
  data: {
    docs: KnowledgeDoc[];
    categories: string[];
  };
}

function ExamBranchDocsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "exam_branch") as Role;
  const tier = getRoleTier(role);

  const [search, setSearch] = useState("");

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<KnowledgeResponse>(
    `/api/campus-extra/knowledge?search=${encodeURIComponent(search || "exam")}`,
    { ttlMs: 30_000, deps: [search] }
  );

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const docs = data?.data?.docs ?? [];
  const categories = data?.data?.categories ?? [];

  const examDocs = useMemo(() => {
    const all = docs;
    if (!search) return all;
    return all.filter(
      (d) =>
        d.title.toLowerCase().includes(search.toLowerCase()) ||
        d.category.toLowerCase().includes("exam")
    );
  }, [docs, search]);

  return (
    <div className="mx-auto max-w-7xl space-y-6 px-4 py-6 md:px-6 min-w-0">
      <Link
        href="/exam-branch"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Overview
      </Link>

      {/* Toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Exam Branch"
        purpose="Access exam regulations, circular templates, and operational documentation."
        why="Standardized circulars, regulations, and seating rubrics ensure uniform examination procedure across all departments."
        contextLabel="Exam Documentation"
        statusTone="info"
        statusSummary="Browse institutional guidelines, seating rubrics, and examination SOPs."
        primaryAction={{ label: "Pass Queue", href: "/exam-branch" }}
        secondaryActions={[
          { label: "Today Overview", href: "/exam-branch/home" },
          { label: "Reports", href: "/exam-branch/reports" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">Docs unavailable: {error}</span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      {/* Search + category filter */}
      <WidgetBoundary title="Documentation Filter">
        <div className="surface-card bg-bg-base p-4 min-w-0 space-y-3">
          <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3 min-w-0">
            <div className="relative flex-1 min-w-0">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" />
              <input
                type="text"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search exam documentation…"
                className="surface-card w-full bg-bg-surface pl-9 pr-3 py-2 text-sm text-text-secondary placeholder:text-text-muted focus:outline-none"
                aria-label="Search exam documentation"
              />
            </div>
            <div className="flex flex-wrap items-center gap-1.5 min-w-0">
              <span className="text-xs text-text-muted shrink-0">Categories:</span>
              {categories.map((cat) => (
                <span
                  key={cat}
                  className="surface-card inline-flex items-center bg-bg-elevated text-text-muted px-2 py-0.5 text-xs"
                >
                  {cat}
                </span>
              ))}
              {categories.length === 0 && (
                <span className="text-xs text-text-muted">none</span>
              )}
            </div>
          </div>
        </div>
      </WidgetBoundary>

      {/* API docs link */}
      <WidgetBoundary title="API Documentation">
        <div className="surface-card bg-bg-base p-4 min-w-0">
          <div className="flex items-center gap-3 min-w-0">
            <ExternalLink className="w-4 h-4 text-action-info shrink-0" />
            <div className="min-w-0 flex-1">
              <p className="text-sm font-medium text-white">
                Gate Monitor API Reference
              </p>
              <p className="text-xs text-text-muted">
                OpenAPI 3.0 spec for all system endpoints
              </p>
            </div>
            <Link
              href="/exam-branch/docs"
              className="surface-card inline-flex items-center gap-1 bg-bg-elevated px-3 py-1.5 text-xs text-text-secondary hover:bg-bg-elevated shrink-0"
            >
              <ExternalLink className="size-3.5" /> Open
            </Link>
          </div>
        </div>
      </WidgetBoundary>

      {/* Exam documentation list */}
      <WidgetBoundary title="Examination Documentation">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <BookOpen className="w-4 h-4 text-action-success shrink-0" />
              <span className="text-sm font-semibold text-white truncate">
                Exam Branch Documentation
              </span>
            </div>
            <span className="text-xs text-text-muted shrink-0">
              {examDocs.length} document(s)
            </span>
          </div>

          {busy ? (
            <div className="p-4 space-y-3 min-w-0">
              {Array.from({ length: 3 }).map((_, i) => (
                <div
                  key={i}
                  className="h-4 rounded-lg border border-border bg-bg-surface/40 animate-pulse motion-reduce:animate-none"
                />
              ))}
            </div>
          ) : examDocs.length === 0 ? (
            <div className="p-6 text-center min-w-0">
              <FileText className="size-4 mx-auto text-text-muted mb-2" />
              <p className="text-sm text-text-muted">
                No exam documentation found.
              </p>
              <p className="text-xs text-text-muted mt-1">
                Exam policy documents are published by authorised roles and
                appear here automatically. Try clearing the search or check
                with the OIE.
              </p>
            </div>
          ) : (
            <ul className="divide-y divide-slate-800 min-w-0">
              {examDocs.map((doc) => (
                <li key={doc.id} className="px-4 py-3 min-w-0">
                  <div className="flex flex-col gap-1 min-w-0">
                    <div className="flex flex-wrap items-center gap-2 min-w-0">
                      <span className="text-sm font-medium text-white min-w-0 flex-1 truncate">
                        {doc.title}
                      </span>
                      <span className="surface-card inline-flex items-center bg-bg-elevated text-text-muted px-2 py-0.5 text-xs shrink-0">
                        {doc.category}
                      </span>
                      <span className="text-xs text-text-muted shrink-0">
                        v{doc.version}
                      </span>
                    </div>
                    <p className="text-xs text-text-muted min-w-0 line-clamp-2">
                      {doc.body}
                    </p>
                    <div className="flex flex-wrap items-center gap-3 text-xs text-text-muted min-w-0">
                      <span>Owner: {doc.ownerRole}</span>
                      <span>
                        Updated{" "}
                        {new Date(doc.updatedAt).toLocaleString([], {
                          month: "short",
                          day: "numeric",
                          year: "numeric",
                        })}
                      </span>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      </WidgetBoundary>

    </div>
  );
}

export default function ExamBranchDocsPage() {
  return (
    <Suspense fallback={<PageLoading />}>
      <ExamBranchDocsInner />
    </Suspense>
  );
}
</file>

<file path="src/app/exam-branch/oie-approval-requests/page.tsx">
"use client";

import { Suspense, useCallback, useMemo } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { ShieldCheck, AlertTriangle, Inbox, ArrowRight, FileWarning } from "lucide-react";
import Link from "next/link";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { ApproverDecisionQueue } from "@/components/approver/ApproverDecisionQueue";
import {
  useEntityInspector,
  EntityInspectorPanel,
} from "@/components/shared/useEntityInspector";
import {
  KVPairs,
  ActionRow,
  InspectorButton,
  type EntityInspection,
} from "@/components/shared/EntityInspector";

interface PermissionRequest {
  id: string;
  ticket_number: string;
  workflow_type: string;
  student_user_id: string;
  status: string;
  current_stage: string;
  created_at: string;
  updated_at: string;
  sla_deadline?: string;
  hostel_scope?: string | null;
  student?: { name?: string; student_details?: { roll?: string } | null } | null;
  [key: string]: unknown;
}

interface PermissionsResponse {
  success: boolean;
  data: PermissionRequest[] | null;
  total: number;
}

function stageLabel(stage: string): string {
  const map: Record<string, string> = {
    oie: "OIE Review",
    vice_principal: "Vice Principal Escalation",
    principal: "Principal Approval",
    faculty: "Faculty",
    hod: "HOD",
  };
  return map[stage] ?? stage;
}

function StatusBadge({ text, tone }: { text: string; tone?: "ok" | "warn" | "danger" | "neutral" }) {
  const cls: Record<string, string> = {
    ok: "bg-emerald-500/10 text-action-success border border-emerald-500/20",
    warn: "bg-amber-500/10 text-action-warning border border-amber-500/20",
    danger: "bg-rose-500/10 text-action-danger border border-rose-500/20",
    neutral: "bg-bg-elevated text-text-muted border border-border",
  };
  const t = tone ?? "neutral";
  return (
    <span className={`px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase ${cls[t]}`}>
      {text}
    </span>
  );
}

/** Build an EntityInspection for an OIE approval request (exam-branch view — read-only). */
function buildOieApprovalInspection(r: PermissionRequest): EntityInspection {
  const slaBreached = r.sla_deadline
    ? new Date(r.sla_deadline).getTime() < Date.now()
    : false;

  const sections: EntityInspection["sections"] = [
    {
      title: "Overview",
      content: (
        <KVPairs
          items={[
            { label: "Ticket", value: <code className="font-mono">{r.ticket_number}</code> },
            { label: "Student", value: r.student?.name ?? r.student_user_id ?? "—" },
            { label: "Roll", value: r.student?.student_details?.roll ?? "—" },
            { label: "Stage", value: stageLabel(r.current_stage) },
            { label: "Created", value: new Date(r.created_at).toLocaleString() },
            { label: "SLA", value: r.sla_deadline ? (slaBreached ? "BREACHED" : new Date(r.sla_deadline).toLocaleString()) : "—" },
          ]}
        />
      ),
    },
    {
      title: "Actions",
      content: (
        <ActionRow>
          <InspectorButton href="/oie/queue" variant="primary">
            OIE queue
          </InspectorButton>
          <InspectorButton href="/exam-branch/oie-approval-requests" variant="ghost">
            All requests
          </InspectorButton>
        </ActionRow>
      ),
    },
  ];

  return {
    kind: "exam_case",
    title: r.ticket_number,
    subtitle: `${r.student?.name ?? ""} · ${stageLabel(r.current_stage)}`.trim() || null,
    status: <StatusBadge text={slaBreached ? "SLA BREACHED" : "PENDING OIE"} tone={slaBreached ? "danger" : "warn"} />,
    sections,
    detailHref: "/exam-branch/oie-approval-requests",
    detailLabel: "All OIE requests",
  };
}

function OieApprovalRequestsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "exam_branch") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<PermissionsResponse>(
    "/api/permissions?workflow_type=exam&status=PENDING&stage=oie",
    { ttlMs: 30_000 }
  );

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const requests = useMemo<PermissionRequest[]>(
    () => (data?.data as unknown as PermissionRequest[]) ?? [],
    [data]
  );

  return (
    <div className="mx-auto max-w-7xl space-y-6 px-4 py-6 md:px-6 min-w-0">
      {/* Back link */}
      <Link
        href="/exam-branch"
