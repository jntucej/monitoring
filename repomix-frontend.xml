"use client";
// src/app/api/admin/complaints/categories/page.tsx
"use client";

import { useCallback, useEffect, useState } from "react";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface CategoryRow {
  code: string;
  label: string;
  ownerRole?: string;
  slaHours?: number;
  anonymousAllowed?: boolean;
  girlsCellEligible?: boolean;
  isActive?: boolean;
}

export default function CategoriesPage() {
  const [rows, setRows] = useState<CategoryRow[]>([]);
  const [saving, setSaving] = useState<string | null>(null);

  const load = useCallback(async () => {
    const r = await fetch("/api/admin/complaint-categories", { headers: getAuthHeaders() });
    const j = await r.json();
    setRows(j.data?.categories ?? []);
  }, []);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  const patch = async (code: string, field: string, value: unknown) => {
    setSaving(code);
    await fetch(`/api/admin/complaint-categories/${code}`, {
      method: "PATCH",
      headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({ [field]: value }),
    });
    setSaving(null);
    await load();
  };

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Manage and monitor complaints categories for campus operations."
        why="Category changes immediately alter where student complaints are dispatched and how fast they must resolve."
        contextLabel="Complaints Categories"
        statusSummary="Review current complaints categories state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <h1 className="text-2xl font-semibold">Complaint categories</h1>
      <div className="border rounded bg-white overflow-x-auto">
        <table className="w-full text-sm">
          <thead className="text-left border-b bg-bg-elevated">
            <tr>
              <th className="p-3">Code</th>
              <th className="p-3">Label</th>
              <th className="p-3">Owner</th>
              <th className="p-3">SLA (h)</th>
              <th className="p-3">Anon</th>
              <th className="p-3">Girls Cell</th>
              <th className="p-3">Active</th>
            </tr>
          </thead>
          <tbody className="divide-y">
            {rows.map((c) => (
              <tr key={c.code} className="hover:bg-bg-elevated">
                <td className="p-3 font-mono">{c.code}</td>
                <td className="p-3 font-medium">{c.label}</td>
                <td className="p-3 text-text-muted font-mono">{c.ownerRole}</td>
                <td className="p-3">
                  <input
                    type="number"
                    defaultValue={c.slaHours}
                    disabled={saving === c.code}
                    onBlur={(e) => patch(c.code, "slaHours", Number(e.target.value))}
                    className="surface-card w-20 p-1 text-sm min-h-11"
                  />
                </td>
                <td className="p-3">
                  <input
                    type="checkbox"
                    checked={c.anonymousAllowed}
                    disabled={saving === c.code}
                    onChange={(e) => patch(c.code, "anonymousAllowed", e.target.checked)}
                    className="h-5 w-5"
                  />
                </td>
                <td className="p-3">
                  <input
                    type="checkbox"
                    checked={c.girlsCellEligible}
                    disabled={saving === c.code}
                    onChange={(e) => patch(c.code, "girlsCellEligible", e.target.checked)}
                    className="h-5 w-5"
                  />
                </td>
                <td className="p-3">
                  <input
                    type="checkbox"
                    checked={c.isActive}
                    disabled={saving === c.code}
                    onChange={(e) => patch(c.code, "isActive", e.target.checked)}
                    className="h-5 w-5"
                  />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
</file>

