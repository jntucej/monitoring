<file path="src/components/shared/meals/MealDetailSheet.tsx">
/**
 * shared/meals/MealDetailSheet.tsx — tap a meal in MyMealHistory to see
 * the full detail: menu items, allergens, my rating, and the one-tap
 * "something was wrong" complaint link. The "DETAIL" step of the meal
 * loop. Takes a meal row (from /api/mess/history) + optional menu.
 */

"use client";

import { useEffect, useState } from "react";
import { X, Star, AlertTriangle, Utensils, Loader2 } from "lucide-react";
import { cn } from "@/lib/utils";
import { getAuthHeaders } from "@/lib/utils";

export interface MealDetailSheetProps {
  /** The meal row (from MyMealHistory). Null = closed. */
  meal: {
    id: string;
    meal_type: string;
    review_date: string;
    rating?: number | null;
    served?: boolean;
    menu?: string[];
    allergens?: string[];
  } | null;
  onClose: () => void;
  className?: string;
}

export function MealDetailSheet({ meal, onClose, className }: MealDetailSheetProps) {
  const [rating, setRating] = useState<number | null>(null);

  useEffect(() => {
    setRating(meal?.rating ?? null);
  }, [meal?.id]);

  if (!meal) return null;

  const submitRating = async (stars: number) => {
    setRating(stars);
    try {
      await fetch("/api/mess/reviews", {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ record_id: meal.id, rating: stars }),
      });
    } catch {
      // keep client-side state
    }
  };

  return (
    <div className={cn("fixed inset-0 z-50 flex items-end bg-black/40 sm:items-center", className)}>
      <div className="w-full rounded-t-xl bg-bg-elevated p-4 sm:max-w-md sm:rounded-xl">
        <div className="flex items-start justify-between gap-2">
          <div>
            <p className="text-xs text-text-muted capitalize">{meal.meal_type}</p>
            <h3 className="text-base font-semibold text-text-primary">
              {new Date(meal.review_date).toLocaleDateString("en-IN", {
                day: "2-digit",
                month: "short",
                year: "numeric",
              })}
            </h3>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="rounded p-1 text-text-muted hover:bg-bg"
            aria-label="Close"
          >
            <X className="h-4 w-4" />
          </button>
        </div>

        {/* Menu */}
        {meal.menu && meal.menu.length > 0 && (
          <div className="mt-3">
            <p className="text-[10px] uppercase tracking-wide text-text-muted">Served</p>
            <div className="mt-1 flex flex-wrap gap-1">
              {meal.menu.map((item) => (
                <span key={item} className="rounded bg-bg px-2 py-0.5 text-[11px] text-text-secondary">
                  {item}
                </span>
              ))}
            </div>
          </div>
        )}

        {/* Allergens */}
        {meal.allergens && meal.allergens.length > 0 && (
          <div className="mt-3">
            <p className="text-[10px] uppercase tracking-wide text-text-muted">Allergens</p>
            <div className="mt-1 flex flex-wrap gap-1">
              {meal.allergens.map((a) => (
                <span
                  key={a}
                  className="rounded bg-amber-500/10 px-2 py-0.5 text-[11px] text-amber-400"
                >
                  {a}
                </span>
              ))}
            </div>
          </div>
        )}

        {/* My rating */}
        <div className="mt-4">
          <p className="text-[10px] uppercase tracking-wide text-text-muted">My rating</p>
          <div className="mt-1 flex gap-0.5">
            {[1, 2, 3, 4, 5].map((s) => (
              <button
                key={s}
                type="button"
                onClick={() => submitRating(s)}
                aria-label={`${s} stars`}
              >
                <Star
                  className={cn(
                    "h-5 w-5",
                    (rating ?? 0) >= s ? "fill-amber-400 text-amber-400" : "text-text-muted/40",
                  )}
                />
              </button>
            ))}
            {rating && <span className="ml-2 text-xs text-green-400">{rating}/5</span>}
          </div>
        </div>

        {/* Escalate: one-tap complaint for this meal */}
        {meal.served && (
          <button
            type="button"
            onClick={() => {
              window.location.href = `/student/complaints/new?category=meal&record_id=${meal.id}`;
            }}
            className="mt-4 flex items-center gap-1.5 text-xs text-text-muted underline hover:text-text"
          >
            <AlertTriangle className="h-3.5 w-3.5" />
            Something was wrong with this meal — raise a complaint
          </button>
        )}
      </div>
    </div>
  );
}

export default MealDetailSheet;
</file>

<file path="src/components/shared/meals/MyMealHistory.tsx">
/**
 * shared/meals/MyMealHistory.tsx — the student's meal history loop:
 * what I ate, my ratings, skips, and the one-tap "something was wrong"
 * complaint. Steps 2 (STATUS) + 3 (ACT: rate) + 6 (ESCALATE: complaint)
 * of the meal loop.
 */

"use client";

import { useEffect, useState } from "react";
import { Star, AlertTriangle, Loader2 } from "lucide-react";
import { cn } from "@/lib/utils";
import { getAuthHeaders } from "@/lib/utils";
import { MealDetailSheet } from "@/components/shared/meals/MealDetailSheet";

interface MealRow {
  id: string;
  meal_type: string;
  review_date: string;
  rating?: number | null;
  served?: boolean;
}

export interface MyMealHistoryProps {
  /** Max rows (default 14). */
  limit?: number;
  /** Called after a rating is submitted. */
  onRated?: () => void;
  className?: string;
}

export function MyMealHistory({ limit = 14, onRated, className }: MyMealHistoryProps) {
  const [rows, setRows] = useState<MealRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [ratingFor, setRatingFor] = useState<string | null>(null);
  const [detail, setDetail] = useState<MealRow | null>(null);

  const load = async () => {
    try {
      const res = await fetch(`/api/mess/history?limit=${limit}`, { headers: getAuthHeaders() });
      const data = res.ok ? await res.json() : { meals: [] };
      setRows(data.meals ?? data.data?.meals ?? []);
    } catch {
      setRows([]);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    load();
  }, []);

  const rate = async (rowId: string, rating: number) => {
    setRatingFor(rowId);
    try {
      await fetch("/api/mess/reviews", {
        method: "POST",
        headers: getAuthHeaders(),
        body: JSON.stringify({ record_id: rowId, rating }),
      });
      setRows((prev) => prev.map((r) => (r.id === rowId ? { ...r, rating } : r)));
      onRated?.();
    } finally {
      setRatingFor(null);
    }
  };

  if (loading) {
    return (
      <div className={cn("flex items-center gap-2 py-4 text-xs text-text-muted", className)}>
        <Loader2 className="h-4 w-4 animate-spin" />
        Loading meal history…
      </div>
    );
  }

  return (
    <div className={cn("space-y-2", className)}>
      {rows.length === 0 && (
        <p className="py-4 text-center text-xs text-text-muted">No meals recorded yet.</p>
      )}
      {rows.map((row) => (
        <div
          key={row.id}
          role="button"
          tabIndex={0}
          onClick={() => setDetail(row)}
          onKeyDown={(e) => e.key === "Enter" && setDetail(row)}
          className="surface-card flex cursor-pointer items-center justify-between gap-2 p-3 hover:bg-bg-elevated"
        >
          <div>
            <p className="text-xs font-medium text-text capitalize">{row.meal_type}</p>
            <p className="text-[11px] text-text-muted">
              {new Date(row.review_date).toLocaleDateString("en-IN", { day: "2-digit", month: "short" })}
              {row.served ? "" : " · skipped"}
            </p>
          </div>
          {/* Rating: existing or inline stars */}
          {row.rating ? (
            <div className="flex items-center gap-0.5" aria-label={`${row.rating} stars`}>
              {[1, 2, 3, 4, 5].map((s) => (
                <Star
                  key={s}
                  className={cn("h-3.5 w-3.5", s <= (row.rating ?? 0) ? "fill-amber-400 text-amber-400" : "text-text-muted/40")}
                />
              ))}
            </div>
          ) : ratingFor === row.id ? (
            <div className="flex gap-0.5">
              {[1, 2, 3, 4, 5].map((s) => (
                <button
                  key={s}
                  type="button"
                  onClick={() => rate(row.id, s)}
                  className="text-amber-400"
                >
                  <Star className="h-4 w-4" />
                </button>
              ))}
            </div>
          ) : (
            <button
              type="button"
              onClick={() => setRatingFor(row.id)}
              className="flex items-center gap-1 rounded-lg bg-bg-elevated px-2 py-1 text-[11px] text-text-secondary hover:bg-bg"
            >
              <Star className="h-3 w-3" />
              Rate
            </button>
          )}
        </div>
      ))}

      {/* Escalate: one-tap complaint for a meal */}
      {rows.some((r) => r.served) && (
        <button
          type="button"
          className="flex items-center gap-1.5 text-[11px] text-text-muted underline hover:text-text"
        >
          <AlertTriangle className="h-3 w-3" />
          Something was wrong with a meal — raise a complaint
        </button>
      )}
      {/* Tap-to-detail sheet (menu, allergens, rating, complaint link) */}
      <MealDetailSheet
        meal={
          detail
            ? {
                id: detail.id,
                meal_type: detail.meal_type,
                review_date: detail.review_date,
                rating: detail.rating ?? null,
                served: detail.served,
              }
            : null
        }
        onClose={() => setDetail(null)}
      />
    </div>
  );
}

export default MyMealHistory;
</file>

<file path="src/components/shared/notifications/ActionableNotification.tsx">
/**
 * shared/notifications/ActionableNotification.tsx — a notification card
 * with inline action buttons. The "actionable notification" multiplier:
 * one component makes every notification type reachable to its owner
 * feature. Tapping an action POSTs to the action's API + deep-links.
 */

"use client";

import { useState } from "react";
import { Loader2, ChevronRight } from "lucide-react";
import { cn } from "@/lib/utils";
import { useNotificationActions } from "@/hooks/useNotificationActions";
import { getNotificationActions } from "@/lib/notifications/actions";

export interface ActionableNotificationProps {
  /** The notification id (used to build action bodies + mark as acted). */
  id: string;
  /** The notification type (from the registry). */
  type: string;
  /** The notification title. */
  title: string;
  /** Optional subtitle / detail line. */
  subtitle?: string;
  /** Timestamp display. */
  timeAgo?: string;
  /** Class name. */
  className?: string;
}

export function ActionableNotification({
  id,
  type,
  title,
  subtitle,
  timeAgo,
  className,
}: ActionableNotificationProps) {
  const { actions, deepLink, label, dispatch } = useNotificationActions(type);
  const [acting, setActing] = useState<string | null>(null);
  const [acted, setActed] = useState<string | null>(null);

  const def = getNotificationActions(type);

  const handleAction = async (actionId: string) => {
    if (acting) return;
    setActing(actionId);
    const ok = await dispatch(actionId, id);
    setActing(null);
    if (ok) setActed(actionId);
  };

  return (
    <div
      className={cn(
        "surface-card p-3 space-y-2",
        className,
      )}
    >
      {/* Header: type badge + title + time */}
      <div className="flex items-start gap-2">
        <span className="mt-0.5 shrink-0 rounded bg-bg-elevated px-1.5 py-0.5 text-[10px] font-medium text-text-muted">
          {label}
        </span>
        <div className="min-w-0 flex-1">
          <p className="truncate text-sm font-medium text-text">{title}</p>
          {subtitle && (
            <p className="truncate text-xs text-text-muted">{subtitle}</p>
          )}
        </div>
        {timeAgo && (
          <span className="shrink-0 text-[10px] text-text-muted/60">{timeAgo}</span>
        )}
      </div>

      {/* Actions: 1–2 inline buttons + optional deep-link */}
      {actions.length > 0 && (
        <div className="flex flex-wrap gap-1.5">
          {actions.map((a) => (
            <button
              key={a.id}
              type="button"
              onClick={() => handleAction(a.id)}
              disabled={acting !== null || acted === a.id}
              className={cn(
                "rounded-lg px-3 py-1.5 text-xs font-medium transition-colors disabled:opacity-50",
                a.variant === "primary" &&
                  "bg-action-primary text-bg hover:bg-action-primary/90",
                a.variant === "secondary" &&
                  "bg-bg-elevated text-text-secondary hover:bg-bg",
                a.variant === "destructive" &&
                  "bg-red-500/10 text-red-400 hover:bg-red-500/20",
              )}
            >
              {acting === a.id ? (
                <Loader2 className="h-3.5 w-3.5 animate-spin" />
              ) : acted === a.id ? (
                "Done ✓"
              ) : (
                a.label
              )}
            </button>
          ))}
        </div>
      )}

      {/* Deep-link: "open full record" */}
      {deepLink && (
        <button
          type="button"
          onClick={() => (window.location.href = deepLink)}
          className="flex items-center gap-1 text-[11px] text-text-muted hover:text-text"
        >
          Open full record
          <ChevronRight className="h-3 w-3" />
        </button>
      )}
    </div>
  );
}

export default ActionableNotification;
</file>

<file path="src/components/shared/notifications/NotificationActionButtons.tsx">
/**
 * shared/notifications/NotificationActionButtons.tsx — compact inline
 * action buttons for a notification. Renders 1–2 buttons from the action
 * registry; each POSTs to the action's API + deep-links.
 *
 * Used inside the notification card (not the full ActionableNotification).
 */

"use client";

import { useState } from "react";
import { Loader2 } from "lucide-react";
import { cn } from "@/lib/utils";
import { useNotificationActions } from "@/hooks/useNotificationActions";

export interface NotificationActionButtonsProps {
  /** The notification id (used to build action bodies). */
  notificationId: string;
  /** The notification type (from the registry). */
  type: string;
  /** Max buttons to show (default 2). */
  max?: number;
  className?: string;
}

export function NotificationActionButtons({
  notificationId,
  type,
  max = 2,
  className,
}: NotificationActionButtonsProps) {
  const { actions, dispatch } = useNotificationActions(type);
  const [acting, setActing] = useState<string | null>(null);
  const [acted, setActed] = useState<string | null>(null);

  const visible = actions.slice(0, max);
  if (visible.length === 0) return null;

  const handle = async (actionId: string) => {
    if (acting) return;
    setActing(actionId);
    const ok = await dispatch(actionId, notificationId);
    setActing(null);
    if (ok) setActed(actionId);
  };

  return (
    <div className={cn("flex flex-wrap gap-1.5", className)}>
      {visible.map((a) => (
        <button
          key={a.id}
          type="button"
          onClick={() => handle(a.id)}
          disabled={acting !== null}
          className={cn(
            "rounded-lg px-2.5 py-1 text-[11px] font-medium transition-colors disabled:opacity-50",
            a.variant === "primary" && "bg-action-primary text-bg hover:bg-action-primary/90",
            a.variant === "secondary" && "bg-bg-elevated text-text-secondary hover:bg-bg",
            a.variant === "destructive" && "bg-red-500/10 text-red-400 hover:bg-red-500/20",
          )}
        >
          {acting === a.id ? (
            <Loader2 className="h-3 w-3 animate-spin" />
          ) : acted === a.id ? (
            "Done ✓"
          ) : (
            a.label
          )}
        </button>
      ))}
    </div>
  );
}

export default NotificationActionButtons;
</file>

<file path="src/components/shared/pass/ApprovalChainPreview.tsx">
/**
 * shared/pass/ApprovalChainPreview — renders the ordered approval chain
 * with per-node ETA labels and parent-consent indicator.
 *
 * Driven entirely by PassTypeConfig — no hardcoded node names.
 */

"use client";

import { ShieldCheck, User, Clock, ArrowRight } from "lucide-react";
import type { PassTypeConfig } from "@/lib/pass-types";
import { approvalChainLabel, ROLE_LABELS, type ApprovalRole } from "@/lib/pass-types";
import { cn } from "@/lib/utils";

export interface ApprovalChainPreviewProps {
  config: PassTypeConfig;
  /** If the pass is currently pending, highlight the active node index. */
  activeNodeIndex?: number;
  /** Override per-node ETA labels (e.g. from live approver response times). */
  etas?: Partial<Record<ApprovalRole, string>>;
  className?: string;
}

export function ApprovalChainPreview({
  config,
  activeNodeIndex = -1,
  etas,
  className,
}: ApprovalChainPreviewProps) {
  const chain = config.approvalChain;

  if (chain.length === 0) return null;

  // If requiresApproval is false, show a single "Self" node
  const nodes: ApprovalRole[] = config.requiresApproval ? chain : ["self"];

  return (
    <div className={cn("rounded-xl border border-border bg-bg-elevated p-3", className)}>
      <p className="text-[10px] font-semibold uppercase tracking-wide text-text-muted mb-2.5 flex items-center gap-1.5">
        <ShieldCheck className="h-3.5 w-3.5" /> Approval chain
      </p>

      {/* Chain nodes */}
      <div className="flex flex-wrap items-center gap-1.5">
        {nodes.map((role, i) => {
          const isActive = i === activeNodeIndex;
          const isSelf = role === "self";
          const eta = etas?.[role];

          return (
            <div key={role} className="flex items-center gap-1.5">
              <div
                className={cn(
                  "rounded-lg px-2.5 py-1.5 text-xs font-medium border space-y-0.5",
                  isActive
                    ? "bg-action-primary/15 border-action-primary/40 text-action-primary"
                    : isSelf
                      ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-600"
                      : "bg-bg-base border-border text-text-secondary"
                )}
              >
                <div className="flex items-center gap-1">
                  {isSelf ? (
                    <User className="h-3 w-3" />
                  ) : (
                    <ShieldCheck className="h-3 w-3" />
                  )}
                  <span>{ROLE_LABELS[role] ?? role}</span>
                  {isActive && <Clock className="h-3 w-3 animate-pulse" />}
                </div>
                {eta && (
                  <p className={cn("text-[10px]", isActive ? "text-action-primary/80" : "text-text-muted")}>
                    {eta}
                  </p>
                )}
              </div>

              {i < nodes.length - 1 && (
                <ArrowRight className="h-3.5 w-3.5 text-text-muted shrink-0" />
              )}
            </div>
          );
        })}
      </div>

      {/* Parent consent indicator */}
      {config.requiresParentConsent && (
        <div className="mt-2.5 rounded-lg bg-amber-500/10 border border-amber-500/20 px-2.5 py-1.5 text-[10px] text-amber-700">
          <span className="font-semibold">Parent consent required</span>
          {config.parentConsentExpiryHours > 0 && (
            <span className="ml-1">
              (expires in {config.parentConsentExpiryHours}h)
            </span>
          )}
        </div>
      )}

      {/* Quota indicator */}
      {config.quotaLimit != null && config.quotaKey && (
        <p className="mt-2 text-[10px] text-text-muted">
          Quota: {config.quotaLimit} {config.quotaWindow ?? "period"}
          {config.quotaOverrideTier === 1 && " (warden can override)"}
        </p>
      )}

      {/* Chain label (compact text version for small screens) */}
      <p className="mt-2 text-[10px] text-text-muted">
        {approvalChainLabel(nodes)}
      </p>
    </div>
  );
}

export default ApprovalChainPreview;
