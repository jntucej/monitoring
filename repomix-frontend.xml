"use client";
// src/components/approver/AcademicsDepartmentPanel.tsx
// SCAFFOLD:ACADEMICS — self-fetching academics & department analytics panel.
// Regenerate with: node scripts/scaffold-academics-panel.mjs new vice-principal --force
//
// Compliance: GuardedPage-wrapped (in page wrapper) · Suspense-safe ·
// useApiResource + usePolling (visibility-aware; no setInterval) ·
// WidgetBoundary per section · toasts via useToast() (never alert()) ·
// typed interfaces (no any, no file-scope eslint-disable) ·
// aria-* on every interactive element.
//
// Anti-shutter guarantees baked in:
//   • single-flight fetch (inflightRef guard) — no parallel storm on remount
//   • polling lives in usePolling (cleared on unmount), never in render
//   • every derived array/object is wrapped in useMemo
//   • WidgetBoundary per section — one failure never blanks the panel
//   • skeleton-on-first-paint gate — no layout flash
//   • stable row keys (department.code)

import { useCallback, useMemo, useState } from "react";
import {
  Building2, Users, GraduationCap, Scale, RefreshCw, Loader2,
  Pencil, Check, X, AlertTriangle, Inbox, Search,
} from "lucide-react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Skeleton } from "@/components/ui/skeleton";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { EmptyState } from "@/components/shared/EmptyState";
import { useToast } from "@/components/ui/toast";

import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { useAuthStore } from "@/stores/authStore";

import { POLL_INTERVALS } from "@/config/app-constants";
import { getAuthHeaders } from "@/lib/utils";
import { fmtInt } from "@/lib/formatters";
import { getRoleTier } from "@/lib/alert-hierarchy";
import {type AcademicDepartmentRow, type AcademicsDepartmentPayload, SEED_DEPARTMENTS, computeRatio, ratioLabel, summarize}  from "@/lib/academics-department-data";

interface AcademicsDepartmentPanelProps {
  /** Optional title override (defaults to the panel heading). */
  title?: string;
  /** Tier floor for the inline HOD-assign control (default 85). */
  editMinTier?: number;
}

/* ── Small building blocks ──────────────────────────────────────── */

function Kpi({
  label, value, sub, icon: Icon, tint,
}: {
  label: string;
  value: string | number;
  sub?: string;
  icon: React.ComponentType<{ className?: string }>;
  tint: string;
}) {
  return (
    <div className="surface-card bg-bg-surface p-4">
      <div className="flex items-center justify-between">
        <span className="text-xs uppercase tracking-wide text-text-muted">
          {label}
        </span>
        <span className={`size-6 rounded-lg grid place-items-center ${tint}`} aria-hidden="true">
          <Icon className="h-3.5 w-3.5" />
        </span>
      </div>
      <div className="mt-2 text-2xl font-semibold tabular-nums text-text-primary">
        {value}
      </div>
      {sub && (
        <div className="mt-1 text-xs text-text-muted">{sub}</div>
      )}
    </div>
  );
}

function LoadingRows() {
  return (
    <div className="space-y-2 p-4" aria-label="Loading department analytics">
      {Array.from({ length: 5 }).map((_, i) => (
        <div key={i} className="grid grid-cols-6 gap-3">
          <Skeleton className="h-6 col-span-2" />
          <Skeleton className="h-6" />
          <Skeleton className="h-6" />
          <Skeleton className="h-6" />
          <Skeleton className="h-6" />
        </div>
      ))}
    </div>
  );
}

/* ── Main panel ─────────────────────────────────────────────────────────── */

export function AcademicsDepartmentPanel({
  title = "Academics & Department Analytics",
  editMinTier = 85,
}: AcademicsDepartmentPanelProps) {
  const { user } = useAuthStore();
  const { addToast } = useToast();

  // useApiResource: cached, single-flight fetch with its own loading/error state.
  const {
    data: payload,
    loading,
    error,
    refresh,
  } = useApiResource<AcademicsDepartmentPayload | null>("/api/approver/academics-department", {
    deps: [],
    ttlMs: POLL_INTERVALS.normal,
  });

  // Live-toggle driven refresh — visibility-aware, cleared on unmount. No setInterval here.
  usePolling(() => { void refresh(); }, { intervalMs: POLL_INTERVALS.normal });

  // Single-flight guard: one in-flight mutation at a time, no parallel storm.


  // Inline HOD edit state
  const [editing, setEditing] = useState<string | null>(null);
  const [hodDraft, setHodDraft] = useState("");
  const [savingCode, setSavingCode] = useState<string | null>(null);

  // Search filter
  const [query, setQuery] = useState("");

  const tier = useMemo(() => getRoleTier(user?.role ?? ""), [user?.role]);
  const canEditHod = tier >= editMinTier;

  /* ── HOD inline save ─────────────────────────────────────────────── */

  const beginEdit = useCallback((row: AcademicDepartmentRow) => {
    setEditing(row.code);
    setHodDraft(row.hod?.name ?? "");
  }, []);

  const cancelEdit = useCallback(() => {
    setEditing(null);
    setHodDraft("");
  }, []);

  const saveHod = useCallback(
    async (code: string) => {
      if (!canEditHod) return;
      const name = hodDraft.trim();
      setSavingCode(code);
      try {
        const res = await fetch("/api/approver/academics-department", {
          method: "PATCH",
          headers: { "Content-Type": "application/json", ...getAuthHeaders() },
          credentials: "include",
          body: JSON.stringify({ department: code, hodName: name }),
        });
        if (!res.ok) {
          const body = (await res.json().catch(() => null)) as { message?: string } | null;
          throw new Error(body?.message ?? `HTTP ${res.status}`);
        }
        addToast({
          variant: "success",
          title: "HOD reassigned",
          message: name ? `${code} → ${name}` : `${code} HOD cleared`,
        });
        // Bust the read cache so the next refresh reflects the new HOD.
        await clearCache("/api/approver/academics-department");
        await refresh();
        setEditing(null);
        setHodDraft("");
      } catch (e) {
        addToast({
          variant: "error",
          title: "Reassign failed",
          message: e instanceof Error ? e.message : "Save failed",
        });
      } finally {
        setSavingCode(null);
      }
    },
    [canEditHod, hodDraft, addToast, refresh],
  );

  /* ── Derived (memoized so React bails out of re-renders) ───────── */

  const departments = useMemo<AcademicDepartmentRow[]>(() => {
    if (!payload) return [];
    if (payload.departments.length > 0) return payload.departments;
    // Empty DB → seed fallback so the panel is never blank
    return SEED_DEPARTMENTS;
  }, [payload]);

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return departments;
    return departments.filter(
      (d) =>
        d.code.toLowerCase().includes(q) ||
        d.name.toLowerCase().includes(q) ||
        (d.hod?.name ?? "").toLowerCase().includes(q),
    );
  }, [departments, query]);

  const totals = useMemo(() => {
    const t = summarize(departments);
    return { ...t, live: Boolean(payload?.totals.live) };
  }, [departments, payload?.totals.live]);

  /* ── Render ──────────────────────────────────────────────────────── */

  return (
    <section className="space-y-4" aria-labelledby="academics-dept-heading">
      <header className="flex flex-wrap items-center justify-between gap-3">
        <div className="flex items-center gap-2">
          <Building2 className="h-6 w-6 text-action-info" aria-hidden="true" />
          <h2
            id="academics-dept-heading"
            className="text-lg font-semibold text-text-primary"
          >
            {title}
          </h2>
          {!totals.live && (
            <Badge variant="dayout" className="text-xs">
              seed fallback
            </Badge>
          )}
        </div>
        <div className="flex items-center gap-2">
          <div className="relative">
            <Search className="h-3.5 w-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-text-muted" aria-hidden="true" />
            <input
              type="text"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search department or HOD…"
              aria-label="Search department or HOD"
              className="surface-card h-6 w-6 bg-bg-elevated pl-8 pr-2 text-xs text-text-primary focus:outline-none focus:ring-2 focus:ringaction-info/40"
            />
          </div>
          <Button
            type="button"
            variant="secondary"
            size="sm"
            onClick={() => void refresh()}
            disabled={loading}
            aria-label="Refresh academics analytics"
          >
            {loading ? (
              <Loader2 className="h-3.5 w-3.5 animate-spin" aria-hidden="true" />
            ) : (
              <RefreshCw className="h-3.5 w-3.5" aria-hidden="true" />
            )}
          </Button>
        </div>
      </header>

      {error && (
        <div
          role="alert"
          className="surface-card flex items-center gap-2 bg-rose-500/5 px-3 py-2 text-xs text-action-danger"
        >
          <AlertTriangle className="h-3.5 w-3.5" aria-hidden="true" />
          <span>{error}</span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="ml-auto underline hover:no-underline"
            aria-label="Retry loading academics analytics"
          >
            retry
          </button>
        </div>
      )}

      {/* ── KPI strip ── */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
        <Kpi label="Departments" value={fmtInt(totals.departments)} icon={Building2}
             tint="bg-sky-500/10 text-action-info" />
        <Kpi label="Students" value={fmtInt(totals.students)} icon={GraduationCap}
             tint="bg-emerald-500/10 text-action-success" />
        <Kpi label="Faculty" value={fmtInt(totals.faculty)} icon={Users}
             tint="bg-violet-500/10 text-unit-c" />
        <Kpi label="Ratio (1:N)" value={ratioLabel(totals.ratio)} icon={Scale}
             tint="bg-amber-500/10 text-action-warning"
             sub="students per faculty" />
      </div>

      {/* ── Department table ── */}
      <WidgetBoundary title="Academics Department Breakdown">
        <Card>
          <CardHeader>
            <CardTitle className="text-sm">Per-department breakdown</CardTitle>
          </CardHeader>
          <CardContent className="p-0">
            {loading && departments.length === 0 ? (
              <LoadingRows />
            ) : filtered.length === 0 ? (
              <EmptyState
                icon={<Inbox className="w-4 h-4" />}
                title="No departments found"
                description={query ? "Try a different search term." : "No departments configured yet."}
              />
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="text-left text-xs uppercase tracking-wide text-text-muted border-b border-border">
                      <th className="px-4 py-2.5" scope="col">Code</th>
                      <th className="px-4 py-2.5" scope="col">Department</th>
                      <th className="px-4 py-2.5" scope="col">HOD</th>
                      <th className="px-4 py-2.5 text-right" scope="col">Faculty</th>
                      <th className="px-4 py-2.5 text-right" scope="col">Students</th>
                      <th className="px-4 py-2.5 text-right" scope="col">Ratio</th>
                      <th className="px-4 py-2.5 text-right" scope="col">On campus</th>
                    </tr>
                  </thead>
                  <tbody>
                    {filtered.map((d) => {
                      const isEditing = editing === d.code;
                      const isSaving  = savingCode === d.code;
                      return (
                        <tr
                          key={d.code}
                          className="border-b border-border/60 hover:bg-bg-elevated/40"
                        >
                          <td className="px-4 py-2.5 font-mono text-xs text-text-muted">
                            {d.code}
                          </td>
                          <td className="px-4 py-2.5 text-text-primary">
                            {d.name}
                          </td>
                          <td className="px-4 py-2.5">
                            {isEditing ? (
                              <div className="flex items-center gap-1.5">
                                <input
                                  autoFocus
                                  type="text"
                                  value={hodDraft}
                                  onChange={(e) => setHodDraft(e.target.value)}
                                  aria-label={`New HOD name for ${d.name}`}
                                  className="surface-card h-6 w-6 bg-bg-elevated px-2 text-xs text-text-primary"
                                  placeholder="HOD name"
                                />
                                <button
                                  type="button"
                                  onClick={() => void saveHod(d.code)}
                                  disabled={isSaving}
                                  className="size-6 grid place-items-center rounded-md bg-emerald-500/15 text-action-success disabled:opacity-50"
                                  aria-label={`Save HOD for ${d.name}`}
                                >
                                  {isSaving ? (
                                    <Loader2 className="h-3.5 w-3.5 animate-spin" aria-hidden="true" />
                                  ) : (
                                    <Check className="h-3.5 w-3.5" aria-hidden="true" />
                                  )}
                                </button>
                                <button
                                  type="button"
                                  onClick={cancelEdit}
                                  className="size-6 grid place-items-center rounded-md bg-rose-500/15 text-action-danger"
                                  aria-label={`Cancel editing HOD for ${d.name}`}
                                >
                                  <X className="h-3.5 w-3.5" aria-hidden="true" />
                                </button>
                              </div>
                            ) : (
                              <div className="flex items-center gap-2">
                                <span className={d.hod ? "text-text-primary" : "text-text-muted italic"}>
                                  {d.hod?.name ?? "Vacant"}
                                </span>
                                {canEditHod && (
                                  <button
                                    type="button"
                                    onClick={() => beginEdit(d)}
                                    className="opacity-0 hover:opacity-100 focus:opacity-100 group-hover:opacity-100 transition-opacity"
                                    aria-label={`Edit HOD for ${d.name}`}
                                  >
                                    <Pencil className="size-3.5 text-text-muted" aria-hidden="true" />
                                  </button>
                                )}
                              </div>
                            )}
                          </td>
                          <td className="px-4 py-2.5 text-right tabular-nums text-text-primary">
                            {fmtInt(d.facultyCount)}
                          </td>
                          <td className="px-4 py-2.5 text-right tabular-nums text-text-primary">
                            {fmtInt(d.studentCount)}
                          </td>
                          <td className="px-4 py-2.5 text-right tabular-nums text-text-muted">
                            {ratioLabel(computeRatio(d.studentCount, d.facultyCount))}
                          </td>
                          <td className="px-4 py-2.5 text-right tabular-nums">
                            <span className="text-action-success">{fmtInt(d.onCampus)}</span>
                            <span className="text-text-muted text-xs ml-1">
                              ({fmtInt(d.inToday)} in / {fmtInt(d.outToday)} out)
                            </span>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </CardContent>
        </Card>
      </WidgetBoundary>

      <p className="text-xs text-text-muted text-right">
        {totals.live ? "Live data" : "Seed fallback"} · updated{" "}
        {payload ? new Date(payload.generatedAt).toLocaleTimeString() : "—"}
      </p>
    </section>
  );
}
</file>

<file path="src/components/approver/AdminAlertsPanel.tsx">
"use client";

/**
 * AdminAlertsPanel — the admin's open-alerts side panel.
 *
 * Desktop: a side panel (rendered by RoleConsole alongside the board feed).
 * Mobile: a full-width section below the board. No horizontal scroll.
 *
 * Reads open alerts from GET /api/admin/alerts (the same board source the
 * shell configures, but the panel reads `data.items` directly because the
 * board feed's itemKey is decorative for this role). Each row shows title,
 * severity, and timestamp. An EmptyState is shown when there are no open
 * alerts.
 */

import { useMemo } from "react";
import { Bell, Loader2 } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { EmptyState } from "@/components/shared/EmptyState";
import type { Alert } from "@/lib/types";

/** Response shape for /api/admin/alerts (GET, open + optionally recently
 *  resolved). */
interface AdminAlertsResponse {
  success: boolean;
  data: {
    items: Alert[];
    unresolvedCount: number;
  };
}

const SEVERITY_TONE: Record<Alert["severity"], string> = {
  critical: "text-action-danger bg-rose-400/10 border-rose-400/20",
  high: "text-action-warning bg-amber-400/10 border-amber-400/20",
  medium: "text-action-primary bg-blue-400/10 border-blue-400/20",
  low: "text-text-muted bg-bg-elevated/10 border-border/20",
};

function fmtTime(iso: string | null | undefined): string {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleTimeString("en-IN", {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
    });
  } catch {
    return "—";
  }
}

export function AdminAlertsPanel() {
  const { data, loading } = useApiResource<AdminAlertsResponse>(
    "/api/admin/alerts",
    { ttlMs: 15_000 }
  );

  const openAlerts = useMemo<Alert[]>(() => {
    const items = data?.data?.items ?? [];
    return items.filter((a) => !a.resolved);
  }, [data]);

  return (
    <section className="surface-card bg-bg-surface/60 p-4 min-w-0">
      {/* Header */}
      <div className="flex items-center gap-2 mb-3">
        <Bell className="w-4 h-4 text-action-primary shrink-0" />
        <span className="text-sm font-bold text-text-primary truncate">
          Open Alerts
        </span>
        {openAlerts.length > 0 ? (
          <span className="ml-auto font-mono text-xs text-text-muted shrink-0">
            {openAlerts.length} active
          </span>
        ) : null}
      </div>

      {loading ? (
        <div className="flex items-center gap-2 px-3 py-3 text-text-muted">
          <Loader2 className="w-4 h-4 animate-spin" />
          <span className="text-xs">Loading alerts…</span>
        </div>
      ) : openAlerts.length === 0 ? (
        <EmptyState
          title="No open alerts"
          description="All campus alerts are resolved."
          icon={<Bell className="w-5 h-5" />}
        />
      ) : (
        <ul className="space-y-1.5 max-h60 overflow-y-auto custom-scrollbar pr-1">
          {openAlerts.map((alert) => {
            const tone = SEVERITY_TONE[alert.severity] ?? SEVERITY_TONE.low;
            return (
              <li
                key={alert.id}
                className="surface-card flex items-center justify-between gap-2 bg-bg-elevated px-2.5 py-1.5 min-w-0"
              >
                <div className="min-w-0">
                  <p className="text-xs font-semibold text-text-primary truncate">
                    {alert.title}
                  </p>
                  {alert.message ? (
                    <p className="text-xs text-text-muted truncate">
                      {alert.message}
                    </p>
                  ) : null}
                </div>
                <div className="flex items-center gap-2 shrink-0">
                  <span
                    className={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-semibold border ${tone}`}
                  >
                    {alert.severity}
                  </span>
                  <span className="font-mono text-xs text-text-muted tabular-nums">
                    {fmtTime(alert.timestamp)}
                  </span>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  );
}

export default AdminAlertsPanel;
</file>

<file path="src/components/approver/AdminCommandBar.tsx">
"use client";

/**
 * AdminCommandBar — Cmd/Ctrl+K command palette for the admin console.
 *
 * Mirrors the DeputyWardenCommandBar / MessInchargeCommandBar /
 * SysadminCommandBar free-text parser pattern with 5 navigation commands —
 * all five are page navigations (the admin console is a read/monitor surface),
 * each routing to the real admin sub-page under /admin/:
 *   alerts        → /admin/alerts
 *   announcements → /admin/announcements
 *   audit         → /admin/audit-logs
 *   backup        → /admin/health (closest existing admin sub-page; no
 *                   dedicated /admin/backup page exists yet)
 *   reports       → /admin/reports
 *
 * Keyboard: up/down to navigate, Enter to execute, Escape to close.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Bell,
  Megaphone,
  ScrollText,
  Activity,
  FileSpreadsheet,
  Search,
  ChevronRight,
} from "lucide-react";
import { useUIStore } from "@/stores/uiStore";
import { getConsoleConfig } from "@/config/consoles";
import adminManifest from "../../../packages/admin-console-kit/manifest/ia.json";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
  href: string;
}

/** All admin navigation commands (targeting the real sub-page routes). */
const COMMAND_DEFS: CommandDef[] = [
  {
    id: "alerts",
    label: "Open security alerts",
    hint: "alerts — Go to the alerts & radar page",
    icon: Bell,
    href: "/admin/alerts",
  },
  {
    id: "announcements",
    label: "Open broadcast announcements",
    hint: "announcements — Go to the announcements page",
    icon: Megaphone,
    href: "/admin/announcements",
  },
  {
    id: "audit",
    label: "Open audit logs",
    hint: "audit — Go to the audit-logs page",
    icon: ScrollText,
    href: "/admin/audit-logs",
  },
  {
    id: "backup",
    label: "Open system health & ops",
    hint: "backup — Go to the system-health & ops page",
    icon: Activity,
    href: "/admin/health",
  },
  {
    id: "reports",
    label: "Open gate reports",
    hint: "reports — Go to the gate-reports page",
    icon: FileSpreadsheet,
    href: "/admin/reports",
  },
];

type Action = "NAVIGATE" | "UNKNOWN";

interface ParsedCommand {
  action: Action;
  commandId: string;
}

/**
 * Parse an admin free-text command. Each of the five keywords routes to its
 * sub-page; anything else is UNKNOWN.
 */
function parseCommand(input: string): ParsedCommand {
  const tokens = input.trim().split(/\s+/);
  const first = (tokens[0] || "").toLowerCase();
  const match = COMMAND_DEFS.find((c) => c.id === first);
  if (match) {
    return { action: "NAVIGATE", commandId: match.id };
  }
  return { action: "UNKNOWN", commandId: "" };
}

export interface AdminCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function AdminCommandBar({ role, open, onClose }: AdminCommandBarProps) {
  const addToast = useUIStore((s) => s.addToast);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const [busy, setBusy] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id));
  }, [role]);

  // 1.10 — default mode fuzzy-searches every admin manifest page; typing ">"
  // switches to the navigation commands.
  const ALL_PAGES = useMemo(() => {
    const root = "/admin";
    return (adminManifest.categories ?? []).flatMap((c: { label?: string; pages?: Array<Record<string, unknown>> }) =>
      (c.pages ?? []).map((p) => {
        const raw = String(p.href ?? p.route ?? p.label ?? "");
        const href = raw.startsWith("/") ? raw : `${root}/${raw}`;
        return {
          label: String(p.label ?? p.title ?? raw),
          href,
          category: String(c.label ?? ""),
        };
      }),
    );
  }, []);

  const isCommandMode = query.startsWith(">");
  const pageQuery = isCommandMode ? "" : query;

  const filtered = useMemo(() => {
    if (isCommandMode) {
      const q = query.slice(1).trim().toLowerCase();
      return q === ""
        ? available
        : available.filter(
            (c) =>
              c.id.startsWith(q) ||
              c.label.toLowerCase().includes(q) ||
              c.hint.toLowerCase().includes(q),
          );
    }
    const q = pageQuery.trim().toLowerCase();
    if (q === "") return available.slice(0, 12);
    const matched = ALL_PAGES.filter(
      (p) =>
        p.label.toLowerCase().includes(q) ||
        p.href.toLowerCase().includes(q) ||
        p.category.toLowerCase().includes(q),
    ).slice(0, 12);
    return [
      ...matched.map((p) => ({
        id: `page:${p.href}`,
        label: p.label,
        hint: `${p.category} — ${p.href}`,
        icon: Search,
        href: p.href,
      })),
      ...available.filter((c) =>
        c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q),
      ),
    ];
  }, [query, isCommandMode, available, ALL_PAGES, pageQuery]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  const executeTarget = useCallback(
    (target: { href: string }) => {
      setBusy(true);
      window.location.href = target.href;
      onClose();
    },
    [onClose],
  );

  const handleSelect = useCallback((cmd: CommandDef) => {
    setQuery(cmd.id);
    inputRef.current?.focus();
  }, []);

  const handleEnter = useCallback(() => {
    if (isCommandMode) {
      const parsed = parseCommand(query);
      if (parsed.action === "UNKNOWN") {
        addToast({ variant: "error", message: "Unknown command. Type a command from the list below." });
        return;
      }
      const target = filtered.find((c) => c.id === parsed.commandId);
      if (!target) {
        addToast({ variant: "error", message: "Command not available for this console." });
        return;
      }
      executeTarget(target);
      return;
    }
    const target = filtered[active];
    if (!target) return;
    executeTarget(target);
  }, [isCommandMode, query, filtered, active, addToast, executeTarget]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!query.trim()) {
          if (filtered[active]) handleSelect(filtered[active]);
        } else {
          handleEnter();
        }
      }
    },
    [filtered, active, handleSelect, handleEnter, query]
  );

  if (!open) return null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="Admin command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={isCommandMode ? "Command…" : `Search pages or type ">" for commands (${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="Admin command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Command list */}
        <ul role="listbox" aria-label="Admin commands" className="max-h-64 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors disabled:opacity-50 ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>
      </div>
    </div>
  );
}

export default AdminCommandBar;
</file>

<file path="src/components/approver/AdminStatusBar.tsx">
"use client";

/**
 * AdminStatusBar — bottom status strip for the admin console.
 *
 * Renders the compact alerts summary:
 *   ● Admin: N active alerts · M pending · K records
 *
 * Counts are passed in from RoleConsole, which derives them from the
 * /api/admin/alerts fetch (open + recently-resolved alerts). "active" = all
 * currently open alerts; "pending" = open alerts at high/critical severity;
 * "records" = total items returned in the feed (open + recently resolved).
 * The last-scan timestamp + refresh indicator are surfaced on the right.
 */

import { Bell, Clock, Loader2 } from "lucide-react";

export interface AdminCounts {
  /** All currently open (unresolved) alerts in the feed. */
  active: number;
  /** Open alerts at high or critical severity (most likely to need action). */
  pending: number;
  /** Total items in the feed (open + recently resolved). */
  records: number;
}

export interface AdminStatusBarProps {
  counts: AdminCounts | null;
  /** Timestamp of the last data refresh (ISO). */
  lastScan?: string | null;
  /** Whether a refresh is in progress. */
  refreshing?: boolean;
}

export function AdminStatusBar({
  counts,
  lastScan,
  refreshing = false,
}: AdminStatusBarProps) {
  const fmt = (iso: string | null | undefined) => {
    if (!iso) return "—";
    try {
      return new Date(iso).toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      });
    } catch {
      return "—";
    }
  };

  const active = counts?.active ?? 0;
  const pending = counts?.pending ?? 0;
  const records = counts?.records ?? 0;
  const hasAttention = pending > 0;

  return (
    <footer
      className="surface-card flex items-center justify-between gap-4 px-4 py-2 bg-bg-surface/95 backdrop-blur-md text-xs text-text-secondary select-none"
      aria-label="Admin status bar"
    >
      {/* Left: alerts summary */}
      <div className="flex items-center gap-4 min-w-0 overflow-x-auto custom-scrollbar">
        <span className="inline-flex items-center gap-1.5 min-w-0">
          <span
            className={`size-2 rounded-full shrink-0 ${
              hasAttention ? "bg-action-warning" : "bg-action-success"
            }`}
          />
          <span className="text-text-muted">Admin</span>
        </span>

        <span className="inline-flex items-center gap-1.5 min-w-0 shrink">
          <Bell className="w-3.5 h-3.5 text-text-muted" />
          <span className="text-text-muted">
            {active} active alerts · {pending} pending · {records} records
          </span>
        </span>
      </div>

      {/* Right: last updated + refresh indicator */}
      <div className="flex items-center gap-3 shrink-0">
        {refreshing ? (
          <Loader2 className="w-3.5 h-3.5 animate-spin text-text-muted" />
        ) : null}
        {lastScan ? (
          <span className="inline-flex items-center gap-1.5">
            <Clock className="w-3.5 h-3.5 text-text-muted" />
            <span className="text-text-muted">last updated</span>
            <span className="font-mono tabular-nums text-text-secondary">
              {fmt(lastScan)}
            </span>
          </span>
        ) : null}
      </div>
    </footer>
  );
}

export default AdminStatusBar;
</file>

<file path="src/components/approver/AllocationPanel.tsx">
"use client";

/**
 * AllocationPanel — room-bed allocation surface for the hostel manager console.
 *
 * Desktop: a side panel (rendered by RoleConsole alongside the board). Mobile:
 * a full-width section below the board. No horizontal scroll.
 *
 * Layout:
 *   - Left: an "unallocated students" list (drag source, draggable).
 *   - Right: a rooms × beds grid. Occupied beds show the resident's name +
 *     roll; unoccupied beds are drop targets.
 *
 * Dragging a student onto a bed calls PATCH /api/students/[roll] with
 * `{ hostelBlock, hostelRoom }` — the endpoint's student_details fields are
 * `hostel_block` (from `hostelBlock`) and `room_number` (from `hostelRoom`).
 * There is no dedicated rooms/beds endpoint that the hostel_manager role can
 * read, so when no room data is available the panel renders an EmptyState
 * ("No room data available — assign beds in the admin panel") instead of the
 * grid.
 */

import { useMemo, useState } from "react";
import { BedDouble, Users, Lock, Circle } from "lucide-react";
import { EmptyState } from "@/components/shared/EmptyState";
import { useAuthStore } from "@/stores/authStore";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";

/** A single occupant bound to a room + bed. */
interface Occupant {
  roll: string;
  name: string;
  hostelBlock: string;
  roomNumber: string;
  bedNumber: string;
}

/** A bed cell: occupied (has an occupant) or free (drop target). */
interface BedCell {
  bedNumber: string;
  occupant: Occupant | null;
}

/** A room: its block, room number, and beds. */
interface RoomRow {
  hostelBlock: string;
  roomNumber: string;
  beds: BedCell[];
}

/** An unallocated student — a drag source. */
interface UnallocatedStudent {
  roll: string;
  name: string;
}

type RoomData =
  | { status: "loading" }
  | { status: "ready"; rooms: RoomRow[]; unallocated: UnallocatedStudent[] }
  | { status: "empty" };

/**
 * Best-effort room/bed data source. There is no `/api/hostel-manager/rooms`
 * endpoint the hostel_manager role can read, and `/api/occupancy/presence-matrix`
 * is a gate-presence matrix (no room/bed structure). We therefore treat the
 * absence of a rooms endpoint as the empty case and surface the EmptyState.
 * This keeps the drag-drop grid wired and functional for when a rooms source
 * lands.
 */
async function loadRoomData(hostel: string | null): Promise<RoomData> {
  void hostel;
  // No dedicated rooms/beds endpoint exists yet — fall back to empty so the
  // panel renders its affordance instead of a broken grid.
  return { status: "empty" };
}

export function AllocationPanel() {
  const assignedHostel = useAuthStore((s) => s.user?.assignedHostel ?? null);
  const addToast = useUIStore((s) => s.addToast);

  const [data, setData] = useState<RoomData>({ status: "loading" });
  const [dragOverBed, setDragOverBed] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);

  // Load once on mount (best-effort; no rooms endpoint today).
  useMemo(() => {
    void loadRoomData(assignedHostel).then(setData);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleDrop = async (e: React.DragEvent, bed: BedCell, room: RoomRow) => {
    e.preventDefault();
    setDragOverBed(null);
    const roll = e.dataTransfer?.getData("text/plain");
    if (!roll || bed.occupant) return;

    setBusy(true);
    try {
      const res = await fetch(`/api/students/${encodeURIComponent(roll)}`, {
        method: "PATCH",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({
          hostelBlock: room.hostelBlock,
          hostelRoom: `${room.roomNumber}·${bed.bedNumber}`,
        }),
      });
      const json = await res.json().catch(() => null);
      if (res.ok && json?.success) {
        addToast({
          variant: "success",
          message: `Allocated ${roll} → ${room.hostelBlock} ${room.roomNumber} bed ${bed.bedNumber}`,
        });
        // Optimistically move the student into the bed.
        setData((prev) => {
          if (prev.status !== "ready") return prev;
          const next = { ...prev };
          next.rooms = prev.rooms.map((r) =>
            r.hostelBlock === room.hostelBlock && r.roomNumber === room.roomNumber
              ? {
                  ...r,
                  beds: r.beds.map((b) =>
                    b.bedNumber === bed.bedNumber
                      ? {
                          ...b,
                          occupant: {
                            roll,
                            name:
                              prev.unallocated.find((u) => u.roll === roll)?.name ?? roll,
                            hostelBlock: room.hostelBlock,
                            roomNumber: room.roomNumber,
                            bedNumber: bed.bedNumber,
                          },
                        }
                      : b,
                  ),
                }
              : r,
          );
          next.unallocated = prev.unallocated.filter((u) => u.roll !== roll);
          return next;
        });
      } else {
        addToast({
          variant: "error",
          message: json?.error?.message || `Failed to allocate ${roll}`,
        });
      }
    } catch {
      addToast({ variant: "error", message: "Network error while allocating bed" });
    } finally {
      setBusy(false);
    }
  };

  // ── Loading state ──
  if (data.status === "loading") {
    return (
      <section className="surface-card bg-bg-surface/60 p-4 min-w-0">
        <PanelHeader hostel={assignedHostel} />
        <p className="text-xs text-text-muted italic px-1 py-4 text-center">
          Loading room &amp; bed data…
        </p>
      </section>
    );
  }

  // ── No room data: EmptyState fallback ──
  if (data.status === "empty") {
    return (
      <section className="surface-card bg-bg-surface/60 p-4 min-w-0">
        <PanelHeader hostel={assignedHostel} />
        <EmptyState
          icon={<BedDouble className="w-2 h-2" />}
          title="No room data available"
          description="Assign beds in the admin panel. The room &amp; bed grid will appear here once room data is published for your hostel."
        />
      </section>
    );
  }

  const { rooms, unallocated } = data;

  return (
    <section className="surface-card bg-bg-surface/60 p-4 min-w-0">
      <PanelHeader hostel={assignedHostel} />

      {/* Two columns on desktop: unallocated list | room-bed grid. Stacked on mobile. */}
      <div className="grid grid-cols-1 md:grid-cols-[minmax(0,240px)_minmax(0,1fr)] gap-4">
        {/* Unallocated students (drag sources) */}
        <div className="min-w-0">
          <h4 className="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-text-muted mb-2">
            <Users className="w-3.5 h-3.5" />
            Unallocated ({unallocated.length})
          </h4>
          {unallocated.length === 0 ? (
            <p className="text-xs text-text-muted italic px-1 py-2">
              All residents allocated.
            </p>
          ) : (
            <ul className="space-y-1.5 max-h80 overflow-y-auto custom-scrollbar pr-1">
              {unallocated.map((u) => (
                <li key={u.roll}>
                  <div
                    draggable
                    onDragStart={(e) => {
                      e.dataTransfer.setData("text/plain", u.roll);
                      e.dataTransfer.effectAllowed = "move";
                    }}
                    className="surface-card flex items-center gap-2 bg-bg-elevated px-2.5 py-2 cursor-grab active:cursor-grabbing hover: transition-colors select-none"
                    aria-label={`Drag ${u.name} to a bed`}
                  >
                    <Circle className="w-2 h-2 text-text-muted shrink-0" />
                    <div className="min-w-0">
                      <p className="text-xs font-semibold text-text-primary truncate">{u.name}</p>
                      <p className="text-xs font-mono text-text-muted truncate">{u.roll}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>

        {/* Rooms × beds grid */}
        <div className="min-w-0">
          <h4 className="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-text-muted mb-2">
            <BedDouble className="w-3.5 h-3.5" />
            Rooms &amp; Beds
          </h4>
          <div className="space-y-3 max-h90 overflow-y-auto custom-scrollbar pr-1">
            {rooms.map((room) => (
              <div key={`${room.hostelBlock}-${room.roomNumber}`}>
                <p className="text-xs font-mono text-text-secondary mb-1.5">
                  {room.hostelBlock} · Rm {room.roomNumber}
                </p>
                <div className="flex flex-wrap gap-1.5">
                  {room.beds.map((bed) => (
                    <div
                      key={bed.bedNumber}
                      onDragOver={(e) => {
                        if (!bed.occupant) {
                          e.preventDefault();
                          e.dataTransfer.dropEffect = "move";
                          setDragOverBed(`${room.hostelBlock}-${room.roomNumber}-${bed.bedNumber}`);
                        }
                      }}
                      onDragLeave={() =>
                        setDragOverBed((k) =>
                          k === `${room.hostelBlock}-${room.roomNumber}-${bed.bedNumber}` ? null : k,
                        )
                      }
                      onDrop={(e) => void handleDrop(e, bed, room)}
                      className={`flex flex-col items-center justify-center min-w18 rounded-lg border px-2 py-1.5 transition-colors ${
                        bed.occupant
                          ? "border-emerald-500/30 bg-emerald-500/5"
                          : "border-dashed border-border bg-bg-base hover:border-action-primary/40"
                      } ${
                        dragOverBed === `${room.hostelBlock}-${room.roomNumber}-${bed.bedNumber}`
                          ? "ring-2 ring-action-primary/50 border-action-primary"
                          : ""
                      }`}
                      aria-label={
                        bed.occupant
                          ? `Bed ${bed.bedNumber} occupied by ${bed.occupant.name}`
                          : `Free bed ${bed.bedNumber}`
                      }
                    >
                      <span className="text-xs font-mono font-bold text-text-muted">
                        B{bed.bedNumber}
                      </span>
                      {bed.occupant ? (
                        <>
                          <span className="text-xs font-semibold text-action-success truncate w-full text-center">
                            {bed.occupant.name}
                          </span>
                          <span className="text-xs font-mono text-text-muted">{bed.occupant.roll}</span>
                        </>
                      ) : (
                        <span className="text-xs text-text-muted flex items-center gap-1">
                          {busy ? "…" : "—"} free
                        </span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <p className="mt-3 text-xs text-text-muted flex items-center gap-1">
            <Lock className="size-3.5" />
            Drag a student onto a free bed to allocate.
          </p>
        </div>
      </div>
    </section>
  );
}

function PanelHeader({ hostel }: { hostel: string | null }) {
  return (
    <div className="flex items-center justify-between gap-2 mb-3">
      <div className="flex items-center gap-2 min-w-0">
        <BedDouble className="w-2 h-2 text-action-primary shrink-0" />
        <span className="text-sm font-bold text-text-primary truncate">
          Room &amp; Bed Allocation
        </span>
      </div>
      {hostel ? (
        <span className="text-xs font-mono text-text-muted shrink-0">
          {hostel}
        </span>
      ) : null}
    </div>
  );
}

export default AllocationPanel;
</file>

<file path="src/components/approver/ApproverDecisionQueue.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import Link from "next/link";
import { AlertTriangle, ArrowUpRight } from "lucide-react";
import {
  ContextualActionRow,
  type ActorEventContext,
} from "@/components/shared/ContextualActionRow";
import { LifefulZeroState } from "@/components/shared/LifefulZeroState";
import { SlaCountdownPill } from "@/components/shared/SlaCountdownPill";
import { WhatHappenedReceipt } from "@/components/shared/WhatHappenedReceipt";
import { LiveFreshnessBar } from "@/components/shared/LiveFreshnessBar";
import { SmartCrossLinkChip } from "@/components/shared/SmartCrossLinkChip";
import { mapPermissionToActionableVM } from "@/lib/view-models/actionableItem";
import { clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { getAuthHeaders } from "@/lib/utils";

interface PermissionRow {
  id: string;
  ticket_number?: string;
  ticketNumber?: string;
  student_name?: string;
  studentName?: string;
  roll_number?: string;
  rollNumber?: string;
  workflow_type?: string;
  workflowType?: string;
  current_stage?: string;
  currentStage?: string;
  status?: string;
  reason?: string;
  sla_deadline?: string;
  slaDeadline?: string;
  campus_status?: string;
  campusStatus?: string;
  departure_at?: string;
  departureAt?: string;
  stage_history?: Array<{
    actor_name?: string;
    actorName?: string;
    actor_role?: string;
    actorRole?: string;
    action?: string;
    comment?: string | null;
    reason?: string | null;
    at?: string;
    timestamp?: string;
  }>;
  stageHistory?: Array<{
    actor_name?: string;
    actorName?: string;
    actor_role?: string;
    actorRole?: string;
    action?: string;
    comment?: string | null;
    reason?: string | null;
    at?: string;
    timestamp?: string;
  }>;
}

interface ActiveAlert {
  id: string;
  title?: string;
  severity?: string;
  category?: string;
}

export interface ApproverDecisionQueueProps {
  roleLabel: string;
  forwardLabel?: string;
  relatedHref?: string;
  relatedLabel?: string;
  detailBaseHref?: string;
}

function formatSlaRemaining(deadline?: string): string {
  if (!deadline) return "SLA: Standard";
  const ms = new Date(deadline).getTime() - Date.now();
  if (Number.isNaN(ms)) return "SLA: Standard";
  if (ms <= 0) return "SLA Overdue";
  const mins = Math.floor(ms / 60_000);
  if (mins < 60) return `SLA: ${mins}m left`;
  const hrs = Math.floor(mins / 60);
  const rem = mins % 60;
  return `SLA: ${hrs}h ${rem}m left`;
}

export function ApproverDecisionQueue({
  roleLabel,
  forwardLabel = "Forward to Next Stage",
  relatedHref,
  relatedLabel = "Related Oversight",
  detailBaseHref = "/permissions",
}: ApproverDecisionQueueProps) {
  const [items, setItems] = useState<PermissionRow[]>([]);
  const [alerts, setAlerts] = useState<ActiveAlert[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [busyTicket, setBusyTicket] = useState<string | null>(null);
  const [busyAction, setBusyAction] = useState<"APPROVE" | "FORWARD" | "REJECT" | null>(null);
  const [selectedTickets, setSelectedTickets] = useState<string[]>([]);
  const [bulkBusy, setBulkBusy] = useState(false);
  const [feedback, setFeedback] = useState<string | null>(null);
  const [lastDiff, setLastDiff] = useState<{ label: string; before: string; after: string } | null>(null);
  const [lastUpdatedAt, setLastUpdatedAt] = useState<number | null>(null);

  const loadQueue = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const [permRes, alertRes] = await Promise.all([
        fetch("/api/permissions?status=PENDING&limit=12", {
          headers: getAuthHeaders(),
          credentials: "include",
          cache: "no-store",
        }),
        fetch("/api/alerts?status=ACTIVE&limit=5", {
          headers: getAuthHeaders(),
          credentials: "include",
          cache: "no-store",
        }).catch(() => null),
      ]);

      if (permRes.status === 401 || permRes.status === 403) {
        setError(`Your ${roleLabel} session does not have permission to view this queue.`);
        setItems([]);
        return;
      }
      if (permRes.status === 429) {
        setError("Too many requests right now. Please wait a moment and refresh.");
        return;
      }
      if (!permRes.ok) {
        setError("Unable to load pending approvals right now.");
        return;
      }

      const permJson = await permRes.json().catch(() => ({}));
      const rows: PermissionRow[] = Array.isArray(permJson?.data)
        ? permJson.data
        : Array.isArray(permJson?.permissions)
          ? permJson.permissions
          : [];
      const sorted = [...rows].sort(
        (a, b) =>
          mapPermissionToActionableVM(a, forwardLabel).urgencyRank -
          mapPermissionToActionableVM(b, forwardLabel).urgencyRank,
      );
      setItems(sorted);
      setLastUpdatedAt(Date.now());

      if (alertRes && alertRes.ok) {
        const alertJson = await alertRes.json().catch(() => ({}));
        const alertRows: ActiveAlert[] = Array.isArray(alertJson?.data)
          ? alertJson.data
          : Array.isArray(alertJson?.alerts)
            ? alertJson.alerts
            : [];
        setAlerts(alertRows);
      }
    } catch {
      setError("Network error while loading pending approvals.");
    } finally {
      setLoading(false);
    }
  }, [roleLabel]);

  useEffect(() => {
    void loadQueue();
  }, [loadQueue]);

  usePolling(loadQueue, { intervalMs: 30_000, enabled: true });

  const handleDecide = async (
    ticket: string,
    action: "APPROVE" | "FORWARD" | "REJECT",
    reason?: string,
  ) => {
    setBusyTicket(ticket);
    setBusyAction(action);
    setFeedback(null);
    try {
      const res = await fetch(`/api/permissions/${encodeURIComponent(ticket)}`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          ...getAuthHeaders(),
        },
        credentials: "include",
        body: JSON.stringify({ action, comment: reason }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || json?.success === false) {
        setFeedback(json?.error?.message || `Could not ${action.toLowerCase()} ${ticket}.`);
        return;
      }

      setItems((prev) =>
        prev.filter((r) => (r.ticket_number ?? r.ticketNumber ?? r.id) !== ticket),
      );
      setSelectedTickets((prev) => prev.filter((t) => t !== ticket));
      clearCache();
      if (action === "APPROVE") {
        setFeedback(`Ticket ${ticket} approved — pass/stage updated.`);
        setLastDiff({ label: ticket, before: "PENDING", after: "APPROVED" });
      } else if (action === "FORWARD") {
        setFeedback(`Ticket ${ticket} forwarded to the next approval stage.`);
        setLastDiff({ label: ticket, before: "PENDING", after: "FORWARDED" });
      } else {
        setFeedback(`Ticket ${ticket} rejected with reason.`);
        setLastDiff({ label: ticket, before: "PENDING", after: "REJECTED" });
      }
    } catch {
      setFeedback(`Network error while updating ${ticket}.`);
    } finally {
      setBusyTicket(null);
      setBusyAction(null);
    }
  };

  return (
    <section className="space-y-4" aria-label="Inline Approval Decision Queue">
      <div className="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 className="text-sm font-semibold text-text-primary">
            Pending Decisions ({items.length})
          </h2>
          <p className="text-xs text-text-muted">
            Approve, forward, or reject with reason directly from this queue.
          </p>
        </div>
        <div className="flex flex-wrap items-center gap-3">
          {relatedHref && (
            <SmartCrossLinkChip
              href={relatedHref}
              label={relatedLabel}
              count={items.length}
              tone={items.length > 0 ? "warn" : "info"}
            />
          )}
          <LiveFreshnessBar
            lastUpdatedAt={lastUpdatedAt}
            loading={loading}
            pollingActive
            onRefresh={() => void loadQueue()}
          />
        </div>
      </div>

      {alerts.length > 0 && (
        <div className="surface-card flex items-center gap-2.5 bg-bg-surface px-4 py-2.5 text-xs text-action-warning">
          <AlertTriangle className="size-4 shrink-0" />
          <span>
            {alerts.length} active campus alert{alerts.length > 1 ? "s" : ""}:{" "}
            {alerts[0]?.title ?? "Curfew / gate alert active"}
          </span>
        </div>
      )}

      {feedback && (
        <WhatHappenedReceipt
          summary={feedback}
          affectedNote={`${Math.max(0, items.length)} item(s) remaining in ${roleLabel} queue · Student & guardian notified`}
          diff={
            lastDiff
              ? {
                  label: lastDiff.label,
                  before: lastDiff.before,
                  after: lastDiff.after,
                  tone: lastDiff.after === "REJECTED" ? "danger" : "ok",
                }
              : null
          }
          nextHref={relatedHref}
          nextLabel={relatedHref ? `Open ${relatedLabel}` : undefined}
          onDismiss={() => {
            setFeedback(null);
            setLastDiff(null);
          }}
        />
      )}

      {selectedTickets.length > 0 && (
        <div className="surface-card flex flex-wrap items-center justify-between gap-2 bg-bg-surface px-4 py-2.5 text-xs">
          <span className="font-semibold text-text-primary">
            {selectedTickets.length} ticket{selectedTickets.length === 1 ? "" : "s"} selected
          </span>
          <div className="flex items-center gap-2">
            <button
              type="button"
              disabled={bulkBusy}
              onClick={async () => {
                setBulkBusy(true);
                setFeedback(null);
                try {
                  const res = await fetch("/api/permissions/bulk", {
                    method: "POST",
                    headers: { "Content-Type": "application/json", ...getAuthHeaders() },
                    credentials: "include",
                    body: JSON.stringify({ tickets: selectedTickets, action: "APPROVE" }),
                  });
                  const json = await res.json().catch(() => ({}));
                  if (res.ok && json?.success !== false) {
                    setItems((prev) =>
                      prev.filter((r) => !selectedTickets.includes(r.ticket_number ?? r.ticketNumber ?? r.id)),
                    );
                    setFeedback(`Bulk approved ${selectedTickets.length} ticket(s).`);
                    setSelectedTickets([]);
                    clearCache();
                  } else {
                    setFeedback(json?.error?.message || "Bulk approve failed.");
                  }
                } finally {
                  setBulkBusy(false);
                }
              }}
              className="min-h-11 rounded-lg bg-action-primary px-3 py-1.5 font-semibold text-white disabled:opacity-50"
            >
              {bulkBusy ? "Applying…" : "Bulk Approve"}
            </button>
            <button
              type="button"
              disabled={bulkBusy}
              onClick={() => setSelectedTickets([])}
              className="min-h-11 rounded-lg bg-bg-elevated px-3 py-1.5 font-medium text-text-secondary"
            >
              Clear
            </button>
          </div>
        </div>
      )}

      {error ? (
        <div className="surface-card bg-bg-surface p-4 text-xs text-action-danger">
          {error}
        </div>
      ) : loading && items.length === 0 ? (
        <div className="surface-card bg-bg-surface p-6 text-xs text-text-muted">
          Loading pending decisions…
        </div>
      ) : items.length === 0 ? (
        <LifefulZeroState
          title={`All ${roleLabel} requests cleared`}
          whyEmpty={`No pending requests are waiting in your ${roleLabel} queue right now.`}
          examplePreview="Incoming student or staff requests appear here with SLA countdown, prior actor rationale, and one-tap Approve / Forward / Reject controls."
          actions={
            relatedHref
              ? [{ label: relatedLabel, href: relatedHref, tone: "primary" }]
              : []
          }
        />
      ) : (
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          {items.map((row) => {
            const ticket = row.ticket_number ?? row.ticketNumber ?? row.id;
            const student = row.student_name ?? row.studentName ?? "Student";
            const roll = row.roll_number ?? row.rollNumber ?? "—";
            const wf = row.workflow_type ?? row.workflowType ?? "Permission";
            const stage = row.current_stage ?? row.currentStage ?? "Pending";
            const campus = row.campus_status ?? row.campusStatus ?? "Campus status unknown";
            const sla = formatSlaRemaining(row.sla_deadline ?? row.slaDeadline);
            const reason = row.reason?.trim() || "No reason text provided.";
            const rawHistory = row.stage_history ?? row.stageHistory;
            const history: NonNullable<PermissionRow["stage_history"]> = Array.isArray(rawHistory)
              ? rawHistory
              : typeof rawHistory === "string"
                ? (() => {
                    try {
                      const parsed = JSON.parse(rawHistory);
                      return Array.isArray(parsed) ? parsed : [];
                    } catch {
                      return [];
                    }
                  })()
                : [];
            const last = history.length > 0 ? history[history.length - 1] : null;
            const latestActorEvent: ActorEventContext | undefined = last
              ? {
                  actorName: last.actor_name ?? last.actorName ?? "Prior Actor",
                  actorRole: last.actor_role ?? last.actorRole ?? stage,
                  actionTaken: last.action ?? "UPDATED",
                  reason: last.comment ?? last.reason ?? null,
                  atLabel: (last.at ?? last.timestamp)
                    ? new Date(last.at ?? last.timestamp ?? "").toLocaleString("en-IN", {
                        day: "2-digit",
                        month: "short",
                        hour: "2-digit",
                        minute: "2-digit",
                      })
                    : "Recent",
                }
              : undefined;

            return (
              <div key={ticket} className="space-y-1.5">
                <ContextualActionRow
                  row={{
                    id: ticket,
                    primaryTitle: `${student} (${roll}) · ${ticket}`,
                    secondaryMeta: `${wf} · Stage: ${stage} · ${campus}`,
                    liveStateBadge: (
                      <SlaCountdownPill
                        deadline={row.sla_deadline ?? row.slaDeadline}
                        fallbackLabel={sla}
                      />
                    ),
                    situationSummary: reason,
                    latestActorEvent,
                    historyCount: history.length,
                    workflowStage: stage,
                    workflowStatus: row.status ?? "PENDING",
                    workflowEvents: history.map((h) => ({
                      actorName: h.actor_name ?? h.actorName ?? null,
                      actorRole: h.actor_role ?? h.actorRole ?? null,
                      actionTaken: h.action ?? null,
                      reason: h.comment ?? h.reason ?? null,
                      atLabel: (h.at ?? h.timestamp)
                        ? new Date(h.at ?? h.timestamp ?? "").toLocaleString("en-IN", {
                            day: "2-digit",
                            month: "short",
                            hour: "2-digit",
                            minute: "2-digit",
                          })
                        : null,
                    })),
                    actions: [
                      {
                        action: "APPROVE",
                        label: "Approve",
                        tone: "primary",
                        consequence: "Approves stage & activates gate QR if final",
                      },
                      {
                        action: "FORWARD",
                        label: forwardLabel,
                        tone: "secondary",
                        consequence: `Routes ticket to ${forwardLabel.replace(/^Forward to /i, "")}`,
                      },
                      {
                        action: "REJECT",
                        label: "Reject",
                        tone: "danger",
                        requiresReason: true,
                        consequence: "Closes request & notifies student/guardian",
                      },
                    ],
                  }}
                  busyAction={busyTicket === ticket ? busyAction : null}
                  onAction={(act, comment) => handleDecide(ticket, act, comment)}
                />
                <div className="flex items-center justify-between gap-3 px-1 text-[11px] text-text-muted">
                  <label className="inline-flex items-center gap-1.5 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={selectedTickets.includes(ticket)}
                      onChange={(e) =>
                        setSelectedTickets((prev) =>
                          e.target.checked ? [...prev, ticket] : prev.filter((t) => t !== ticket),
                        )
                      }
                      aria-label={`Select ${ticket} for bulk action`}
                    />
                    <span>Select</span>
                  </label>
                  <div className="flex items-center gap-3">
                  <Link
                    href={`${detailBaseHref}/${encodeURIComponent(ticket)}`}
                    className="hover:text-action-primary inline-flex items-center gap-1"
                  >
                    Open full timeline <ArrowUpRight className="size-3" />
                  </Link>
                  {relatedHref && (
                    <Link
                      href={`${relatedHref}?ticket=${encodeURIComponent(ticket)}`}
                      className="hover:text-action-primary inline-flex items-center gap-1"
                    >
                      {relatedLabel} <ArrowUpRight className="size-3" />
                    </Link>
                  )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>
  );
}

export default ApproverDecisionQueue;
</file>

<file path="src/components/approver/BulkActionsBar.tsx">
"use client";

import React, { useState } from "react";
import { CheckCheck, XCircle, Forward } from "lucide-react";
import { Button } from "@/components/ui/button";

export interface BulkActionsBarProps {
  selectedCount: number;
  onApprove: (reason?: string) => Promise<void> | void;
  onReject: (comment?: string) => Promise<void> | void;
  onForward?: (comment?: string) => Promise<void> | void;
  onClear: () => void;
  isLoading?: boolean;
  /** Optional label for the batch action (e.g. "3 approvals"). */
  label?: string;
}

export function BulkActionsBar({
  selectedCount,
  onApprove,
  onReject,
  onForward,
  onClear,
  isLoading = false,
  label,
}: BulkActionsBarProps) {
  const [promptAction, setPromptAction] = useState<"approve" | "reject" | "forward" | null>(null);
  const [comment, setComment] = useState("");

  if (selectedCount === 0) return null;

  const handleConfirmPrompt = async () => {
    if (promptAction === "approve") {
      await onApprove(comment.trim() || undefined);
    } else if (promptAction === "reject") {
      await onReject(comment.trim() || undefined);
    } else if (promptAction === "forward" && onForward) {
      await onForward(comment.trim() || undefined);
    }
    setPromptAction(null);
    setComment("");
  };

  const handleCancelPrompt = () => {
    setPromptAction(null);
    setComment("");
  };

  return (
    <div className="surface-card bg-bg-elevated p-3 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 animate-in fade-in slide-in-from-top-2 duration-200">
      <div className="flex items-center gap-2">
        <span className="surface-card inline-flex items-center justify-center bg-action-primary text-white text-xs font-bold h-6 min-w-6 px-1.5">
          {selectedCount}
        </span>
        <span className="text-sm font-medium text-text-primary">
          {label ?? (selectedCount === 1 ? "item selected" : "items selected")}
        </span>
      </div>

      {promptAction ? (
        <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full md:w-auto">
          <input
            type="text"
            placeholder={`Reason for bulk ${promptAction}...`}
            value={comment}
            onChange={(e) => setComment(e.target.value)}
            className="surface-card px-3 py-1.5 text-xs bg-bg-surface text-text-primary focus:outline-none focus:ring-1 focus:ring-action-primary w-full sm:w-64"
          />
          <div className="flex items-center gap-2">
            <Button
              size="sm"
              variant={promptAction === "reject" ? "danger" : "primary"}
              onClick={handleConfirmPrompt}
              loading={isLoading}
              disabled={isLoading}
            >
              Confirm
            </Button>
            <Button
              size="sm"
              variant="secondary"
              onClick={handleCancelPrompt}
              disabled={isLoading}
            >
              Cancel
            </Button>
          </div>
        </div>
      ) : (
        <div className="flex flex-wrap items-center gap-2 w-full md:w-auto">
          <Button
            size="sm"
            variant="primary"
            onClick={() => setPromptAction("approve")}
            disabled={isLoading}
            className="bg-emerald-600 hover:bg-emerald-700 text-white"
          >
            <CheckCheck className="w-3.5 h-3.5 mr-1" />
            Approve All
          </Button>

          <Button
            size="sm"
            variant="danger"
            onClick={() => setPromptAction("reject")}
            disabled={isLoading}
          >
            <XCircle className="w-3.5 h-3.5 mr-1" />
            Reject All
          </Button>

          {onForward && (
            <Button
              size="sm"
              variant="secondary"
              onClick={() => setPromptAction("forward")}
              disabled={isLoading}
            >
              <Forward className="w-3.5 h-3.5 mr-1" />
              Forward All
            </Button>
          )}

          <Button
            size="sm"
            variant="ghost"
            onClick={onClear}
            disabled={isLoading}
            className="text-text-muted hover:text-text-primary"
          >
            Clear
          </Button>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/approver/CaretakerCommandBar.tsx">
"use client";

/**
 * CaretakerCommandBar — Cmd/Ctrl+K command palette for the caretaker console.
 *
 * Parses free-text commands:
 *   assign <ticket> to <staff>   PATCH /api/permissions/<ticket> { action: "FORWARD", comment: "to <staff>" }
 *   resolve <ticket> [note]      PATCH /api/permissions/<ticket> { action: "APPROVE", comment: note }
 *   escalate <ticket>            PATCH /api/permissions/<ticket> { action: "ESCALATE" }
 *   view-assets                  router.push("/caretaker/maintenance")
 *
 * All ticket actions flow through the same /api/permissions/[ticket] PATCH
 * that the permission command bar uses — there is no /api/hostel-tickets/[id]
 * PATCH route. When the input is empty the available commands are listed as
 * hints. Keyboard: up/down to navigate, Enter to execute, Escape to close.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  UserCheck,
  CheckCircle,
  AlertTriangle,
  Package,
  Search,
  ChevronRight,
} from "lucide-react";
import { useRouter } from "next/navigation";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { getConsoleConfig } from "@/config/consoles";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
}

/** All available caretaker command definitions. */
const COMMAND_DEFS: CommandDef[] = [
  {
    id: "assign",
    label: "Assign a ticket to staff",
    hint: "assign <ticket> to <staff> — Forward a ticket to a staff member",
    icon: UserCheck,
  },
  {
    id: "resolve",
    label: "Resolve a ticket",
    hint: "resolve <ticket> [note] — Approve/resolve a pending ticket",
    icon: CheckCircle,
  },
  {
    id: "escalate",
    label: "Escalate to next stage",
    hint: "escalate <ticket> — Escalate a ticket to a higher stage",
    icon: AlertTriangle,
  },
  {
    id: "view-assets",
    label: "View asset register",
    hint: "view-assets — Open the asset register",
    icon: Package,
  },
];

interface ParsedCommand {
  action: "FORWARD" | "APPROVE" | "ESCALATE" | "VIEW_ASSETS" | "UNKNOWN";
  ticket: string;
  comment: string;
}

/**
 * Parse free-text caretaker commands.
 *
 *   assign <ticket> to <staff>  → FORWARD with comment "to <staff>"
 *   resolve <ticket> [note]     → APPROVE with comment <note>
 *   escalate <ticket>           → ESCALATE
 *   view-assets                 → navigate to the asset register
 */
function parseCommand(input: string): ParsedCommand {
  const tokens = input.trim().split(/\s+/);
  const first = (tokens[0] || "").toLowerCase();

  if (first === "view-assets" || first === "assets") {
    return { action: "VIEW_ASSETS", ticket: "", comment: "" };
  }
  if (first === "assign" || first === "forward") {
    const ticket = tokens[1] ?? "";
    const rest = tokens.slice(2).join(" ").trim();
    const target = rest.replace(/^to\s+/i, "").trim();
    return {
      action: "FORWARD",
      ticket,
      comment: target ? `to ${target}` : rest,
    };
  }
  if (first === "resolve") {
    const ticket = tokens[1] ?? "";
    const note = tokens.slice(2).join(" ").trim();
    return { action: "APPROVE", ticket, comment: note };
  }
  if (first === "escalate") {
    return { action: "ESCALATE", ticket: tokens[1] ?? "", comment: "" };
  }
  return { action: "UNKNOWN", ticket: input.trim(), comment: "" };
}

export interface CaretakerCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function CaretakerCommandBar({ role, open, onClose }: CaretakerCommandBarProps) {
  const router = useRouter();
  const addToast = useUIStore((s) => s.addToast);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const [busy, setBusy] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id));
  }, [role]);

  const filtered = useMemo(() => {
    if (!query.trim()) return available;
    const q = query.toLowerCase();
    return available.filter(
      (c) => c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q),
    );
  }, [query, available]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  const executeCommand = useCallback(
    async (parsed: ParsedCommand) => {
      if (parsed.action === "VIEW_ASSETS") {
        // 1.11 — no asset register exists yet; route to the complaints queue,
        // the closest real maintenance surface.
        router.push("/caretaker");
        addToast({ variant: "info", message: "Opening complaint queue" });
        onClose();
        return;
      }

      if (parsed.action === "UNKNOWN" || !parsed.ticket) {
        addToast({
          variant: "error",
          message: "Usage: <action> <ticket> [note]",
        });
        return;
      }

      const body: Record<string, string> = { action: parsed.action };
      if (parsed.comment) body.comment = parsed.comment;

      setBusy(true);
      try {
        const res = await fetch(`/api/permissions/${encodeURIComponent(parsed.ticket)}`, {
          method: "PATCH",
          headers: getAuthHeaders(),
          body: JSON.stringify(body),
        });
        const json = await res.json().catch(() => null);
        if (res.ok && json?.success) {
          addToast({
            variant: "success",
            message: `${parsed.action} processed for ${parsed.ticket}`,
          });
          onClose();
        } else {
          addToast({
            variant: "error",
            message: json?.error?.message || `Failed to ${parsed.action} ${parsed.ticket}`,
          });
        }
      } catch {
        addToast({ variant: "error", message: "Network error while processing command" });
      } finally {
        setBusy(false);
      }
    },
    [addToast, onClose, router],
  );

  const handleSelect = useCallback(
    (cmd: CommandDef) => {
      if (cmd.id === "view-assets") {
        executeCommand({ action: "VIEW_ASSETS", ticket: "", comment: "" });
      } else {
        setQuery(`${cmd.id} `);
        inputRef.current?.focus();
      }
    },
    [executeCommand],
  );

  const handleEnter = useCallback(() => {
    const parsed = parseCommand(query);
    const first = query.trim().toLowerCase();
    // Bare keyword: keep focus so the user can type the ticket number.
    if (["assign", "forward", "resolve", "escalate"].includes(first)) {
      inputRef.current?.focus();
      return;
    }
    executeCommand(parsed);
  }, [executeCommand, query]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!query.trim()) {
          if (filtered[active]) handleSelect(filtered[active]);
        } else {
          handleEnter();
        }
      }
    },
    [filtered, active, handleSelect, handleEnter, query],
  );

  if (!open) return null;

  const parsedPreview = query.trim() ? parseCommand(query) : null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="Caretaker command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={`Caretaker command (role: ${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="Caretaker command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Always-visible quick command chips */}
        <div className="flex flex-wrap items-center gap-1.5 px-4 py-2 border-b border-border bg-bg-elevated/50">
          <span className="text-[11px] font-medium text-text-muted mr-1">Commands:</span>
          {COMMAND_DEFS.map((cmd) => (
            <button
              key={cmd.id}
              type="button"
              onClick={() => {
                setQuery(cmd.id === "view-assets" ? "view-assets" : `${cmd.id} `);
                inputRef.current?.focus();
              }}
              className="px-2 py-0.5 rounded-full text-[11px] font-mono bg-bg-surface border border-border text-text-secondary hover:text-text-primary hover:border-action-primary/50 transition-colors"
            >
              {cmd.id}
            </button>
          ))}
        </div>

        {/* Parsed-command preview */}
        {parsedPreview && parsedPreview.action !== "UNKNOWN" && parsedPreview.action !== "VIEW_ASSETS" ? (
          <div className="surface-card px-4 py-2 bg-bg-elevated text-xs text-text-secondary">
            <span className="font-mono font-bold text-action-primary">
              {parsedPreview.action}
            </span>
            {parsedPreview.ticket ? (
              <span className="ml-1.5 font-mono">{parsedPreview.ticket}</span>
            ) : (
              <span className="ml-1.5 text-text-muted italic">[ticket required]</span>
            )}
            {parsedPreview.comment ? (
              <span className="ml-1.5 text-text-muted italic">note: {parsedPreview.comment}</span>
            ) : null}
            {busy ? <span className="ml-2 text-text-muted">processing…</span> : null}
          </div>
        ) : null}

        {/* Command list */}
        <ul role="listbox" aria-label="Caretaker commands" className="max-h-56 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors disabled:opacity-50 ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>
      </div>
    </div>
  );
}

export default CaretakerCommandBar;
</file>

<file path="src/components/approver/CaretakerStatusBar.tsx">
"use client";

/**
 * CaretakerStatusBar — bottom status strip for the caretaker console.
 *
 * Mirrors the PermissionStatusBar visual style (footer, border-t,
 * bg-surface/95 backdrop-blur, text-xs, select-none). The parent
 * (RoleConsole) computes the counts from the fetched caretaker summary
 * response and passes them in; the hostel is derived from the caller's
 * assigned_hostel (via useAuthStore) and passed in as `counts.hostel`.
 */

import { Clock, Loader2, Building2 } from "lucide-react";

export interface CaretakerCounts {
  hostel: string | null;
  open: number;
  urgent: number;
  lastUpdate?: string | null;
}

export interface CaretakerStatusBarProps {
  counts: CaretakerCounts | null;
  /** Whether a refresh is in progress. */
  refreshing?: boolean;
}

function fmtRelative(iso: string | null | undefined): string {
  if (!iso) return "—";
  try {
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return "—";
    const secs = Math.round((Date.now() - then) / 1000);
    if (secs < 60) return "just now";
    const mins = Math.round(secs / 60);
    if (mins < 60) return `${mins}m ago`;
    const hrs = Math.round(mins / 60);
    if (hrs < 24) return `${hrs}h ago`;
    return `${Math.round(hrs / 24)}d ago`;
  } catch {
    return "—";
  }
}

export function CaretakerStatusBar({ counts, refreshing = false }: CaretakerStatusBarProps) {
  const hostel = counts?.hostel;

  return (
    <footer
      className="surface-card flex items-center justify-between gap-4 px-4 py-2 bg-bg-surface/95 backdrop-blur-md text-xs text-text-secondary select-none"
      aria-label="Caretaker status bar"
    >
      {/* Left: hostel · open · urgent · last update */}
      <div className="flex items-center gap-4 min-w-0">
        <span className="inline-flex items-center gap-1.5 min-w-0">
          <Building2 className="w-3.5 h-3.5 shrink-0 text-text-muted" />
          <span className="text-text-muted">Hostel</span>
          <span className="font-mono tabular-nums font-bold text-text-primary">
            {hostel ?? "—"}
          </span>
        </span>

        <span className="inline-flex items-center gap-1.5 text-text-muted">
          <span className="size-2 rounded-full bg-action-warning shrink-0" />
          open
          <span className="font-mono tabular-nums font-bold text-action-warning">
            {counts?.open ?? 0}
          </span>
        </span>

        <span className="inline-flex items-center gap-1.5 text-text-muted">
          <span className="size-2 rounded-full bg-action-danger shrink-0" />
          urgent
          <span className="font-mono tabular-nums font-bold text-action-danger">
            {counts?.urgent ?? 0}
          </span>
        </span>

        <span className="hidden sm:inline-flex items-center gap-1.5 text-text-muted">
          last update
          <span className="font-mono tabular-nums text-text-secondary">
            {fmtRelative(counts?.lastUpdate)}
          </span>
        </span>
      </div>

      {/* Right: refresh indicator */}
      <div className="flex items-center gap-3 shrink-0">
        {refreshing ? (
          <Loader2 className="w-3.5 h-3.5 animate-spin text-text-muted" />
        ) : null}
        {counts?.lastUpdate ? (
          <span className="inline-flex items-center gap-1.5">
            <Clock className="w-3.5 h-3.5 text-text-muted" />
            <span className="text-text-muted">updated</span>
          </span>
        ) : null}
      </div>
    </footer>
  );
}

export default CaretakerStatusBar;
</file>

<file path="src/components/approver/ChildActivityPanel.tsx">
"use client";

/**
 * ChildActivityPanel — the caller's linked children + their latest activities.
 *
 * Desktop: a right-side panel (rendered by RoleConsole alongside the board).
 * Mobile: a full-width section below the board. No horizontal scroll.
 *
 * Reads GET /api/parents/me (the caller's own linked children, each with open
 * permission requests, most recent gate movement, and next upcoming campus
 * event). Per child it renders the latest activities: timestamp · type ·
 * summary. A child-activity "timeline" is simply this chronologically
 * ordered feed; the panel surfaces the newest-first movement log.
 */

import { useCallback, useMemo, useState } from "react";
import {
  Loader2,
  Users,
  ArrowDownLeft,
  ArrowUpRight,
  Clock,
  Ticket,
  CalendarClock,
  RefreshCw,
} from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";

/** A single child row from GET /api/parents/me. */
interface ChildActivityRow {
  childId: string;
  name: string | null;
  roll: string | null;
  openRequests: number;
  lastMovement: { direction: string; gate: string; at: string } | null;
  nextEvent: { title: string; startsAt: string } | null;
}

/** GET /api/parents/me response shape (self-scoped to the caller's children). */
interface ParentsMeResponse {
  success?: boolean;
  data: {
    children: ChildActivityRow[];
    totalOpenRequests: number;
  };
}

function fmtTime(iso: string | null | undefined) {
  if (!iso) return "";
  try {
    return new Date(iso).toLocaleString([], {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return "";
  }
}

export function ChildActivityPanel() {
  const { data, loading, error, refresh } = useApiResource<ParentsMeResponse>(
    "/api/parents/me",
    { ttlMs: 30_000 }
  );

  const [busy, setBusy] = useState(false);

  const children = data?.data?.children ?? [];

  const handleRefresh = useCallback(() => {
    setBusy(true);
    void refresh().finally(() => setBusy(false));
  }, [refresh]);

  // Newest-movement-first ordering across all children (chronological feed).
  const ordered = useMemo(
    () =>
      [...children].sort((a, b) => {
        const ta = a.lastMovement?.at ? new Date(a.lastMovement.at).getTime() : 0;
        const tb = b.lastMovement?.at ? new Date(b.lastMovement.at).getTime() : 0;
        return tb - ta;
      }),
    [children]
  );

  const totalOpen = data?.data?.totalOpenRequests ?? 0;

  return (
    <section className="surface-card bg-bg-surface/60 p-4 min-w-0">
      {/* Header */}
      <div className="flex items-center justify-between gap-2 mb-3">
        <div className="flex items-center gap-2 min-w-0">
          <Users className="w-4 h-4 text-action-success shrink-0" />
          <span className="text-sm font-bold text-text-primary truncate">
            Child Activity
          </span>
          <span className="text-xs text-text-muted shrink-0">
            {children.length} {children.length === 1 ? "child" : "children"}
            {totalOpen > 0 ? ` · ${totalOpen} open request${totalOpen === 1 ? "" : "s"}` : ""}
          </span>
        </div>
        <button
          type="button"
          onClick={handleRefresh}
          disabled={busy || loading}
          className="surface-card inline-flex items-center gap-1.5 bg-bg-elevated px-2.5 py-1.5 text-xs font-semibold text-text-secondary hover:text-text-primary hover:disabled:opacity-40 transition-colors"
          aria-label="Refresh child activity"
        >
          <RefreshCw className={`w-3.5 h-3.5 ${busy || loading ? "animate-spin" : ""}`} />
          <span className="hidden sm:inline">Refresh</span>
        </button>
      </div>

      {/* Body */}
      {loading && children.length === 0 ? (
        <div className="flex items-center justify-center gap-2 py-8 text-sm text-text-muted">
          <Loader2 className="w-4 h-4 animate-spin" />
          Loading child activity&hellip;
        </div>
      ) : error ? (
        <div className="surface-card bg-amber-500/10 px-3 py-3 text-xs text-action-warning">
          <div className="flex items-center justify-between gap-3">
            <span>
              Could not load child activity: {error}
            </span>
            <button
              type="button"
              onClick={handleRefresh}
              className="surface-card inline-flex items-center gap-1.5 bg-amber-500/20 px-3 py-1.5 text-xs font-semibold text-amber-100 hover:bg-amber-500/30 shrink-0"
            >
              <RefreshCw className="w-3.5 h-3.5" />
              Retry
            </button>
          </div>
        </div>
      ) : children.length === 0 ? (
        <div className="surface-card bg-bg-base/50 px-3 py-4 text-xs text-text-muted">
          No linked children yet. Link a child to start tracking their campus activity.
        </div>
      ) : (
        <ul className="space-y-3 max-h80 overflow-y-auto custom-scrollbar pr-1">
          {ordered.map((child) => {
            const move = child.lastMovement;
            const isIn = move?.direction?.toUpperCase() === "IN";
            const movementSummary = move
              ? `${isIn ? "Checked in" : "Checked out"} at ${move.gate || "gate"} · ${fmtTime(move.at)}`
              : "No gate movement recorded yet";
            const activities: Array<{
              icon: React.ComponentType<{ className?: string }>;
              tone: string;
              label: string;
              detail: string;
            }> = [];
            if (move) {
              activities.push({
                icon: isIn ? ArrowDownLeft : ArrowUpRight,
                tone: isIn ? "bg-emerald-500/15 text-action-success" : "bg-rose-500/15 text-action-danger",
                label: `${isIn ? "Entry" : "Exit"} · ${move.gate || "gate"}`,
                detail: fmtTime(move.at),
              });
            }
            if (child.openRequests > 0) {
              activities.push({
                icon: Ticket,
                tone: "bg-amber-500/15 text-action-warning",
                label: `${child.openRequests} open request${child.openRequests === 1 ? "" : "s"}`,
                detail: "pending approval",
              });
            }
            if (child.nextEvent) {
              activities.push({
                icon: CalendarClock,
                tone: "bg-sky-500/15 text-action-info",
                label: `Upcoming · ${child.nextEvent.title || "campus event"}`,
                detail: fmtTime(child.nextEvent.startsAt),
              });
            }
            return (
              <li
                key={child.childId}
                className="surface-card bg-bg-elevated p-3 min-w-0"
              >
                <div className="flex items-center justify-between gap-2 mb-2">
                  <p className="text-sm font-bold text-text-primary truncate">
                    {child.name || "Unnamed child"}
                  </p>
                  <span className="text-xs font-mono text-text-muted shrink-0">
                    {child.roll || "—"}
                  </span>
                </div>

                <p className="text-xs text-text-muted mb-2">{movementSummary}</p>

                {activities.length > 0 ? (
                  <ol className="space-y-1">
                    {activities.map((a, i) => {
                      const Icon = a.icon;
                      return (
                        <li key={i} className="flex items-center gap-2 min-w-0">
                          <span
                            className={`w-6 h-6 rounded-md flex items-center justify-center shrink-0 ${a.tone}`}
                          >
                            <Icon className="w-3.5 h-3.5" />
                          </span>
                          <span className="flex-1 min-w-0 text-xs font-semibold text-text-primary truncate">
                            {a.label}
                          </span>
                          <time className="text-xs font-mono text-text-muted tabular-nums shrink-0">
                            {a.detail}
                          </time>
                        </li>
                      );
                    })}
                  </ol>
                ) : (
                  <div className="flex items-center gap-1.5 text-xs text-text-muted">
                    <Clock className="w-3.5 h-3.5" />
                    No recent activity
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )}
    </section>
  );
}

export default ChildActivityPanel;
