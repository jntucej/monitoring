/* academic_person_exception — attendance exception from /api/vp/academics */
interface AcademicPersonExceptionRow {
  id: string;
  name: string;
  role?: string | null;
  designation?: string | null;
  department?: string | null;
  exceptionKind: string;
  detail?: number | string;
}

async function fetchAcademicPersonException(personId: string): Promise<AcademicPersonExceptionRow> {
  // The attendance exceptions live in /api/vp/academics under data.exceptions.
  // We fetch the full payload and find the matching person id in any of the
  // three lists (absent / late / flagged).
  const res = await cachedFetch<{
    success: boolean;
    data?: {
      exceptions: {
        absent?: Array<AcademicPersonExceptionRow>;
        late?: Array<AcademicPersonExceptionRow>;
        flagged?: Array<AcademicPersonExceptionRow>;
      };
    };
  }>("/api/vp/academics", { ttlMs: 30_000 });

  const ex = res.data?.exceptions;
  if (!ex) throw new Error(`Person exception ${personId} not found`);
  for (const kind of ["absent", "late", "flagged"] as const) {
    const list = ex[kind];
    if (list?.length) {
      const hit = list.find((p) => p.id === personId);
      if (hit) {
        return {
          ...hit,
          exceptionKind: kind,
          detail: kind === "late" ? hit.detail : kind === "flagged" ? (hit as any).reason : undefined,
        };
      }
    }
  }
  throw new Error(`Person exception ${personId} not found`);
}

register({
  kind: "academic_person_exception",
  async resolve(id) {
    const p = await fetchAcademicPersonException(id);
    const kind = p.exceptionKind;
    const tone: "ok" | "warn" | "danger" | "neutral" =
      kind === "absent" ? "danger" : kind === "late" ? "warn" : "neutral";
    const subtitle = [p.department, p.designation ?? p.role].filter(Boolean).join(" · ") || id;

    return {
      kind: "academic_person_exception",
      title: p.name,
      subtitle,
      status: <StatusBadge text={kind.toUpperCase()} tone={tone} />,
      sections: [
        overviewSection([
          { label: "Role", value: p.role ?? "—" },
          { label: "Department", value: p.department ?? "—" },
          { label: "Person ID", value: <code className="font-mono">{id}</code> },
          ...(p.detail != null
            ? [{ label: kind === "late" ? "Minutes late" : "Flag reason", value: kind === "late" ? `${p.detail}m` : String(p.detail) }]
            : []),
        ]),
        actionsSection([
          { label: "All exceptions", href: "/principal/people/attendance", variant: "ghost" },
          { label: "Attention queue", href: "/principal/attention", variant: "ghost" },
        ]),
      ],
      detailHref: "/principal/people/attendance",
      detailLabel: "Attendance exceptions",
    };
  },
});

/* sla_cell — SLA heatmap cell from /api/principal/sla-heatmap */
interface SlaHeatmapCellRow {
  stage: string;
  total: number;
  withinSla: number;
  breached: number;
  rate: number;
}

async function fetchSlaCell(stage: string): Promise<{ cell: SlaHeatmapCellRow; details: unknown[] }> {
  const res = await cachedFetch<{
    success: boolean;
    data?: { cells?: SlaHeatmapCellRow[]; details?: unknown[] };
  }>("/api/principal/sla-heatmap", { ttlMs: 30_000 });
  const cell = res.data?.cells?.find((c) => c.stage === stage);
  if (!cell) throw new Error(`SLA cell for stage "${stage}" not found`);
  return { cell, details: res.data?.details ?? [] };
}

register({
  kind: "sla_cell",
  async resolve(id) {
    const { cell } = await fetchSlaCell(id);
    const isBreached = cell.breached > 0;
    const stageLabel = cell.stage.replace(/_/g, " ");
    return {
      kind: "sla_cell",
      title: `${stageLabel} stage — SLA compliance`,
      subtitle: `${cell.total} tickets in flight · ${cell.rate}% on-time`,
      status: <StatusBadge text={isBreached ? `${cell.breached} BREACHED` : "COMPLIANT"} tone={isBreached ? "danger" : "ok"} />,
      sections: [
        overviewSection([
          { label: "Stage", value: <code className="font-mono">{cell.stage}</code> },
          { label: "Compliance", value: `${cell.rate}%` },
          { label: "Total in flight", value: String(cell.total) },
          { label: "Within SLA / Breached", value: `${cell.withinSla} / ${cell.breached}` },
        ]),
        actionsSection([
          { label: "View overdue", href: "/principal/approvals/overdue", variant: "primary" },
          { label: "Pending approvals", href: "/principal/approvals", variant: "ghost" },
          { label: "Full analytics", href: "/principal/governance/analytics", variant: "ghost" },
        ]),
      ],
      detailHref: "/principal/governance/analytics",
      detailLabel: "View SLA analytics",
    };
  },
});

/**
 * Resolve an entity to its `EntityInspection` model by kind and id.
 *
 * Throws if no resolver is registered for the kind (programmer error)
 * or if the API call fails (network / not-found / auth).
 *
 *   try {
 *     const model = await resolveEntity("gate", "g-1");
 *     inspect(model);
 *   } catch (err) {
 *     // show error state or toast
 *   }
 */
export async function resolveEntity(
  kind: string,
  id: string,
  context?: Record<string, unknown>,
): Promise<EntityInspection> {
  const resolver = REGISTRY.get(kind);
  if (!resolver) {
    throw new Error(
      `No entity resolver registered for kind "${kind}". ` +
        `Available kinds: ${[...REGISTRY.keys()].join(", ")}. ` +
        `Register it in src/components/shared/entityResolvers.tsx.`,
    );
  }
  return resolver.resolve(id, context);
}

/**
 * Check whether a resolver exists for a given kind.
 * Useful for conditionally rendering an `EntityReference` only when the
 * kind is resolvable.
 */
export function hasResolver(kind: string): boolean {
  return REGISTRY.has(kind);
}

/**
 * List all registered entity kinds.
 * Useful for debugging or a "which entities are inspectable?" UI.
 */
export function registeredKinds(): string[] {
  return [...REGISTRY.keys()];
}

/**
 * `useEntityResolver` — a React hook wrapper around `resolveEntity` that
 * adds loading / error state, so a component can do:
 *
 *   const { inspection, loading, error, retry } = useEntityResolver("gate", "g-1");
 *
 * and pass `inspection` to `<EntityInspector inspection={inspection} …>`.
 * This is the bridge that `EntityReference` uses internally.
 */
export function useEntityResolver(
  kind: string | null,
  id: string | null,
  context?: Record<string, unknown>,
) {
  const [inspection, setInspection] = useState<EntityInspection | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [attempt, setAttempt] = useState(0);

  const retry = useCallback(() => {
    setInspection(null);
    setError(null);
    setAttempt((a) => a + 1);
  }, []);

  useEffect(() => {
    if (!kind || !id) return;
    let ignore = false;
    setLoading(true);
    setError(null);
    resolveEntity(kind, id, context)
      .then((model) => {
        if (!ignore) setInspection(model);
      })
      .catch((err: unknown) => {
        if (!ignore) setError(err instanceof Error ? err.message : "Failed to load entity");
      })
      .finally(() => {
        if (!ignore) setLoading(false);
      });
    return () => { ignore = true; };
    // attempt is in deps so retry() re-triggers the fetch
  }, [kind, id, attempt]);

  return { inspection, loading, error, retry };
}

/* ── re-export types so consumers don't need to import from two files ──── */
export type { EntityInspection, InspectionSection };
</file>

<file path="src/components/shared/LoginForm.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import Link from "next/link";
import {
  Lock,
  UserCheck,
  ArrowRight,
  AlertCircle,
  ChevronLeft,
  Eye,
  EyeOff,
} from "lucide-react";
import { HelpTip } from "@/components/ui/help-tip";
import { useAuthStore } from "@/stores/authStore";
import type { Role } from "@/lib/types";
import { getDefaultRouteForRole } from "@/lib/route-helpers";

interface LoginFormProps {
  title: string;
  subtitle: string;
}

function formatLoginError(code?: string, defaultMsg?: string): string {
  switch (code) {
    case "INVALID_CREDENTIALS":
      return "Invalid username or password. Please try again.";
    case "ACCOUNT_LOCKED":
      return "Account locked after too many failed attempts. Try again in 15 minutes.";
    case "ACCOUNT_SUSPENDED":
      return "This account is suspended. Contact your administrator.";
    case "RATE_LIMITED":
      return "Too many login attempts. Please wait a minute and retry.";
    case "NETWORK_ERROR":
      return "Could not reach the server. Check your connection.";
    default:
      return defaultMsg || "Login failed. Please try again.";
  }
}

export function LoginForm({ title, subtitle }: LoginFormProps) {
  const router = useRouter();
  const searchParams = useSearchParams();
  const code = searchParams?.get("code");

  // ── Local form state (NOT tied to store.loading — that's the bug) ───────
  const [loginIdentifier, setLoginIdentifier] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [rememberLogin, setRememberLogin] = useState(false); // unchecked by default
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [showResetFlow, setShowResetFlow] = useState(false);
  const [resetEmail, setResetEmail] = useState("");
  const [resetSent, setResetSent] = useState(false);
  // Guard: prevents a second POST while the first is in-flight.
  // The `submitting` state disables the button visually, but a rapid
  // double-click can still fire before React re-renders. This ref
  // is synchronous and blocks the second call immediately.
  const inFlightRef = useRef(false);

  // Store selectors — read `authenticated` and `role`, NOT `loading`.
  const login = useAuthStore((s) => s.login);

  const role = useAuthStore((s) => s.role);


  // Track whether this mount should be allowed to redirect away from /login.
  // Two conditions, both required:
  //   1. `sessionValid` — the persisted session was re-verified server-side via
  //      /api/auth/session. Without this check, a user who landed on /login
  //      holding a STALE client-side `authenticated` flag (from localStorage,
  //      or a token that's about to expire on the server) gets instantly
  //      router.replace()'d to their default route on mount. That route's
  //      AuthGuard then calls checkSession(), the server 401s, the guard
  //      bounces back to /login, and this effect fires again — Chrome's
  //      "additional client-side redirect" loop.
  //   2. `role` is present (a real login or a verified session, not a stale
  //      flag that failed re-verification).
  const [sessionValid, setSessionValid] = useState(false);

  // ── Verify a rehydrated session exactly once on mount ────────────────────
  // Runs before the redirect effect below can act, so by the time
  // `sessionValid` flips, we KNOW the server actually accepts this session.
  useEffect(() => {
    const t = useAuthStore.getState();
    if (!t.authenticated || !t.role) return; // nothing to verify
    t.checkSession().then((ok) => setSessionValid(ok));
  }, []);

  // ── Post-auth redirect: only after the session was verified server-side ──
  // Users flagged password_must_change are routed to /settings/password
  // instead of their normal dashboard, so a temporary/admin-set credential
  // is rotated before they can reach any role UI.
  const mustChangePassword = useAuthStore((s) => s.mustChangePassword);
  useEffect(() => {
    if (!sessionValid || !role) return;
    if (mustChangePassword) {
      router.replace("/settings/password?mandatory=1");
      return;
    }
    const redirect = searchParams?.get("redirect");
    const target =
      redirect && redirect.startsWith("/")
        ? redirect
        : getDefaultRouteForRole(role as Role);
    router.replace(target);
  }, [sessionValid, role, router, searchParams, mustChangePassword]);

  // ── Submit ────────────────────────────────────────────────────────────────
  const handleFormSubmit = useCallback(
    async (e: React.FormEvent) => {
      e.preventDefault();
      // Synchronous guard: block double-clicks before React re-renders.
      if (inFlightRef.current) return;
      setError(null);

      // Client-side validation
      const id = loginIdentifier.trim();
      if (!id) {
        setError("Please enter your username or roll number.");
        return;
      }
      if (!password) {
        setError("Please enter your password.");
        return;
      }

      inFlightRef.current = true;
      setSubmitting(true);
      try {
        const result = await login(id, password);
        if (result.success) {
          // A successful login IS a verified session — allow the redirect.
          setSessionValid(true);
        } else {
          setError(formatLoginError(result.code, result.error));
        }
      } catch {
        setError(formatLoginError("NETWORK_ERROR"));
      } finally {
        inFlightRef.current = false;
        setSubmitting(false);
      }
    },
    [loginIdentifier, password, login]
  );

  // ── Forgot-password flow ──────────────────────────────────────────────────
  const handlePasswordReset = useCallback(async () => {
    if (!resetEmail.trim()) {
      setError("Enter the email address on your account.");
      return;
    }
    setSubmitting(true);
    try {
      const res = await fetch("/api/auth/reset-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: resetEmail.trim() }),
        credentials: "include",
      });
      if (res.ok) {
        setResetSent(true);
        setError(null);
      } else {
        setError("Could not send reset link. Try again.");
      }
    } catch {
      setError("Could not send reset link. Check your connection.");
    } finally {
      setSubmitting(false);
    }
  }, [resetEmail]);

  const disabled = submitting || !loginIdentifier.trim() || !password;

  // ── Reset-flow subview ────────────────────────────────────────────────────
  if (showResetFlow) {
    return (
      <div className="w-full max-w-sm space-y-5">
        <button
          type="button"
          onClick={() => {
            setShowResetFlow(false);
            setResetSent(false);
            setError(null);
          }}
          className="flex items-center gap-1 text-sm text-text-muted hover:text-text-primary"
        >
          <ChevronLeft className="h-4 w-4" /> Back to sign in
        </button>
        <div>
          <h1 className="text-2xl font-semibold text-text-primary">Reset password</h1>
          <p className="mt-1 text-sm text-text-muted">
            Enter the email address registered on your account. We&apos;ll send a one-time link to set a new password.
          </p>
        </div>
        {resetSent ? (
          <div className="surface-card bg-emerald-500/10 p-3 text-sm text-action-success space-y-1">
            <p>If that email exists, a reset link has been sent. Check your inbox and spam folder.</p>
            <p className="text-xs text-text-muted">
              No email on file? Contact your department or system administrator for a temporary password.
            </p>
          </div>
        ) : (
          <div className="space-y-4">
            <div className="space-y-1">
              <label htmlFor="reset-email" className="text-xs font-medium text-text-muted">
                Registered email address
              </label>
              <input
                id="reset-email"
                type="email"
                value={resetEmail}
                onChange={(e) => setResetEmail(e.target.value)}
                placeholder="you@college.edu"
                autoComplete="email"
                className="surface-card w-full bg-bg-surface px-3 py-2 text-sm text-text-primary"
              />
              <p className="text-[11px] text-text-muted">
                If you haven&apos;t linked an email yet, ask your administrator to reset your password.
              </p>
            </div>
            {error && (
              <div className="surface-card bg-rose-500/10 p-3 text-sm text-action-danger">
                {error}
              </div>
            )}
            <button
              type="button"
              onClick={handlePasswordReset}
              disabled={submitting || !resetEmail.trim()}
              className="w-full rounded-xl bg-action-primary px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:brightness-110 disabled:opacity-40"
            >
              {submitting ? "Sending…" : "Send reset link"}
            </button>
          </div>
        )}
      </div>
    );
  }

  // ── Login view ────────────────────────────────────────────────────────────
  return (
    <div className="w-full max-w-sm space-y-5">
      <div>
        <h1 className="text-2xl font-semibold text-text-primary">{title}</h1>
        <p className="mt-1 text-sm text-text-muted">{subtitle}</p>
      </div>

      {error && (
        <div
          role="alert"
          className="surface-card flex items-start gap-2 bg-rose-500/10 p-3 text-sm text-action-danger"
        >
          <AlertCircle className="mt-0.5 h-4 w-4 shrink-0" />
          <span>{error}</span>
        </div>
      )}

      <form
        onSubmit={handleFormSubmit}
        action="/api/auth/login"
        method="POST"
        autoComplete="off"
        noValidate
        className="space-y-4"
      >
        <div className="space-y-1">
          <div className="flex items-center gap-1.5">
            <label htmlFor="identifier" className="text-xs font-medium text-text-muted">
              Username / Roll number
            </label>
            <HelpTip
              label="Username or roll number help"
              align="left"
              text="Students: enter your college roll number (e.g. 23JJ1A0599). Faculty, wardens, operators, and staff: enter your assigned username."
            />
          </div>
          <div className="relative">
            <input
              id="identifier"
              name="login"
              type="text"
              value={loginIdentifier}
              onChange={(e) => setLoginIdentifier(e.target.value)}
              autoComplete="username"
              autoCapitalize="characters"
              aria-describedby="identifier-hint"
              required
              className="surface-card w-full bg-bg-surface px-3 py-2 pl-10 text-sm text-text-primary"
            />
            <UserCheck className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted" />
          </div>
          <p id="identifier-hint" className="text-[11px] text-text-muted">
            Students use roll number (e.g. 23JJ1A0599); staff use assigned username.
          </p>
        </div>

        <div className="space-y-1">
          <div className="flex items-center gap-1.5">
            <label htmlFor="password" className="text-xs font-medium text-text-muted">
              Password
            </label>
            <HelpTip
              label="Password help"
              align="left"
              text="First-time or admin-reset accounts will be prompted to set a new password right after signing in. Repeated failed attempts lock the account for 15 minutes."
            />
          </div>
          <div className="relative">
            <input
              id="password"
              name="password"
              type={showPassword ? "text" : "password"}
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              autoComplete="current-password"
              required
              className="surface-card w-full bg-bg-surface px-3 py-2 pl-10 pr-10 text-sm text-text-primary"
            />
            <Lock className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted" />
            <button
              type="button"
              onClick={() => setShowPassword((v) => !v)}
              aria-label={showPassword ? "Hide password" : "Show password"}
              className="absolute right-2 top-1/2 -translate-y-1/2 p-1 text-text-muted"
            >
              {showPassword ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}
            </button>
          </div>
        </div>

        <div className="flex items-center justify-between">
          <label className="flex items-center gap-2 text-xs text-text-muted">
            <input
              type="checkbox"
              checked={rememberLogin}
              onChange={(e) => setRememberLogin(e.target.checked)}
              className="h-3.5 w-3.5 rounded border-border"
            />
            Remember me
            <HelpTip
              label="Remember me help"
              align="left"
              text="Keeps your session active on this browser. Leave unchecked on shared or gate kiosk devices."
            />
          </label>
          <button
            type="button"
            onClick={() => setShowResetFlow(true)}
            className="text-xs text-action-primary hover:underline"
          >
            Forgot password?
          </button>
        </div>

        <div className="space-y-1.5">
          <button
            type="submit"
            disabled={disabled}
            className="flex w-full items-center justify-center gap-2 rounded-xl bg-action-primary px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-40"
          >
            {submitting ? "Signing in…" : "Sign In"}
            {!submitting && <ArrowRight className="h-4 w-4" />}
          </button>
          <p className="text-center text-[11px] text-text-muted">
            Signs you in and opens your role-specific dashboard automatically.
          </p>
        </div>
      </form>

      {/* New account? */}
      {code ? (
        <p className="mt-4 text-center text-sm text-text-secondary">
          It looks like you have an activation code.{" "}
          <Link
            href={`/bootstrap?code=${encodeURIComponent(code)}`}
            className="font-medium text-action-primary hover:underline"
          >
            Activate your account
          </Link>
        </p>
      ) : (
        <p className="mt-4 text-center text-sm text-text-secondary">
          New account?{" "}
          <Link
            href="/bootstrap"
            className="font-medium text-action-primary hover:underline"
          >
            Activate with your enrollment code
          </Link>
        </p>
      )}

      <p className="text-center text-xs text-text-muted">
        Need help?{" "}
        <Link href="/help" prefetch={false} className="text-action-primary hover:underline">
          Contact your administrator
        </Link>
      </p>
    </div>
  );
}
</file>

<file path="src/components/shared/NotificationBell.tsx">
'use client';

import React, { useState, useEffect, useRef } from 'react';
import { Bell, Check, CheckCheck, Info, AlertTriangle, AlertCircle, ExternalLink } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import { useAuthStore } from '@/stores/authStore';

import { Notification } from '@/lib/notification-types';
import { useGlossyMotion } from '@/lib/animations';
import {
  EntityInspector,
} from '@/components/shared/EntityInspector';
import {
  buildNotificationInspection,
} from '@/components/shared/notificationInspection';

const PRIORITY_ICONS = {
  low: Info,
  medium: Bell,
  high: AlertTriangle,
  critical: AlertCircle,
};

const PRIORITY_COLORS = {
  low: 'text-action-primary',
  medium: 'text-yellow-500',
  high: 'text-orange-500',
  critical: 'text-action-danger',
};

// Roles the /api/notifications route actually serves. Polling for any
// other role returns 403 and spams the console with errors on every
// mount, so the bell renders inert (no data, no bell action count) for
// roles outside this allowlist instead of firing a doomed request.
const BELL_SUPPORTED_ROLES = new Set([
  'admin', 'sysadmin', 'operator', 'supervisor',
  'vice_principal', 'principal', 'hod', 'staff', 'faculty', 'student',
]);

export function NotificationBell() {
  const { user } = useAuthStore();
  const bellSupported = BELL_SUPPORTED_ROLES.has(user?.role ?? '');
  const [notifications, setNotifications] = useState<Notification[]>([]);
  const [unreadCount, setUnreadCount] = useState(0);
  const [isOpen, setIsOpen] = useState(false);
  const [loading, setLoading] = useState(false);
  const [filter, setFilter] = useState<'all' | 'unread'>('all');
  const dropdownRef = useRef<HTMLDivElement>(null);
  const isGlossyMotion = useGlossyMotion();

  // ── Entity inspector state ────────────────────────────────────────────
  // Clicking a notification row opens the inspector for the referenced
  // entity AND marks it read. The row is no longer a dead end.
  const [activeNotif, setActiveNotif] = useState<Notification | null>(null);
  const inspection = activeNotif
    ? buildNotificationInspection({
        id: activeNotif.id,
        title: activeNotif.title,
        message: activeNotif.message,
        ticketNumber: activeNotif.data?.ticket_number
          ? String(activeNotif.data.ticket_number)
          : activeNotif.data?.id
            ? String(activeNotif.data.id)
            : undefined,
        urgency:
          activeNotif.priority === 'critical'
            ? 'urgent'
            : activeNotif.priority === 'high'
              ? 'overdue'
              : 'info',
        type: activeNotif.type,
        createdAt: activeNotif.createdAt,
        canActOnTickets: true,
      })
    : null;

  const loadNotifications = async () => {
    if (!bellSupported) return; // role not served by /api/notifications — stay inert
    if (!user?.id) return;
    setLoading(true);
    try {
      const res = await fetch(`/api/notifications?type=${encodeURIComponent(user.role || 'all')}&id=${encodeURIComponent(user.id)}`);
      const json = await res.json();
      if (json.success && Array.isArray(json.data)) {
        setNotifications(json.data);
        setUnreadCount(json.data.filter((n: any) => !n.readAt && !n.resolved).length);
      }
    } catch (err) {
      console.error('Failed to load notifications:', err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (bellSupported && user?.id) {
      loadNotifications();

      // Realtime Server-Sent Events (SSE) stream for instant alerts.
      // Auth rides the httpOnly access_token cookie (bearer() in
      // src/middleware/authorization.ts) — the browser sends it
      // automatically for same-origin requests, so EventSource needs no
      // Authorization header.
      let eventSource: EventSource | null = null;
      let pollTimer: ReturnType<typeof setInterval> | null = null;
      // A hard 401/403 (expired session, role not allowed, cookie missing in
      // this context) makes EventSource close permanently (readyState CLOSED)
      // and the browser auto-reconnects on a tight backoff — every attempt 401s
      // and re-fires onerror, flooding the console. We stop after a few attempts
      // and fall back to quiet polling instead of reconnecting forever.
      let attempts = 0;
      const MAX_SSE_ATTEMPTS = 3;

      const startPolling = () => {
        // Polling fallback keeps the bell live when the SSE stream is
        // unavailable (401, 403, or a dropped connection). loadNotifications
        // already exists and is idempotent.
        if (pollTimer) return;
        pollTimer = setInterval(loadNotifications, 30000);
      };

      const stopPolling = () => {
        if (pollTimer) {
          clearInterval(pollTimer);
          pollTimer = null;
        }
      };

      try {
        const streamUrl = `/api/notifications/stream?userId=${encodeURIComponent(user.id)}&role=${encodeURIComponent(user.role || 'user')}`;
        eventSource = new EventSource(streamUrl);

        eventSource.onopen = () => {
          // SSE connected — stop polling, clear the attempt counter.
          attempts = 0;
          stopPolling();
        };

        eventSource.onmessage = (event) => {
          try {
            const parsed = JSON.parse(event.data);
            if (parsed.type === 'notifications' && Array.isArray(parsed.data)) {
              setNotifications(parsed.data);
              setUnreadCount(parsed.data.filter((n: Notification) => !n.readAt).length);
            }
          } catch (parseErr) {
            console.error('Failed to parse SSE notification message:', parseErr);
          }
        };

        eventSource.onerror = () => {
          attempts++;
          // Don't let the browser auto-reconnect in a tight loop. Close it and
          // fall back to polling. After a few consecutive failures (e.g. a hard
          // 401/403), stop retrying entirely to avoid console spam.
          eventSource?.close();
          eventSource = null;
          startPolling();
          if (attempts >= MAX_SSE_ATTEMPTS) {
            console.warn(
              `Notification SSE unavailable after ${attempts} attempts — using poll fallback. ` +
                'If this persists, your session may have expired; re-login to restore realtime alerts.'
            );
          }
        };
      } catch (err) {
        console.error('SSE stream setup error:', err);
        startPolling();
      }

      return () => {
        if (eventSource) eventSource.close();
        stopPolling();
      };
    }
  }, [bellSupported, user?.id, user?.role]);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target as Node)) {
        setIsOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const handleMarkRead = async (id: string) => {
    // Optimistic update
    setNotifications((prev) =>
      prev.map((n) => (n.id === id ? { ...n, readAt: new Date().toISOString() } : n))
    );
    setUnreadCount((prev) => Math.max(0, prev - 1));
    // Persist server-side so SSE re-fetch doesn't resurrect the notification
    try {
      await fetch(`/api/notifications/${encodeURIComponent(id)}`, { method: "PATCH" });
    } catch {
      // best-effort — local state already updated
    }
  };

  /**
   * Click on a notification row: mark it read AND open the entity inspector
   * for the referenced entity (ticket / alert).
   */
  const handleRowClick = (n: Notification) => {
    if (!n.readAt) handleMarkRead(n.id);
    setActiveNotif(n);
  };

  const handleMarkAllRead = async () => {
    setNotifications((prev) => prev.map((n) => ({ ...n, readAt: new Date().toISOString() })));
    setUnreadCount(0);
    try {
      await fetch("/api/notifications/read-all", { method: "POST" });
    } catch {
      // best-effort
    }
  };

  const getTimeAgo = (date: string) => {
    const seconds = Math.floor((new Date().getTime() - new Date(date).getTime()) / 1000);
    if (seconds < 60) return 'just now';
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    return `${days}d ago`;
  };

  const filteredNotifications = filter === 'unread' 
    ? notifications.filter((n) => !n.readAt) 
    : notifications;

  return (
    <div className="relative" ref={dropdownRef}>
      <motion.button
        animate={isGlossyMotion && unreadCount > 0 ? { rotate: [0, -15, 15, -10, 10, 0] } : {}}
        transition={{ duration: 0.5, repeat: Infinity, repeatDelay: 5 }}
        onClick={() => setIsOpen(!isOpen)}
        className="surface-card relative p-2 text-text-muted hover:text-text-primary hover:bg-[var(--bg-card)] transition-all active:scale-95 focus:outline-none"
        aria-label={`Open notification feed ${unreadCount > 0 ? `(${unreadCount} unread)` : ''}`}
      >
        <Bell className="w-5 h-5" />
        {unreadCount > 0 && (
          <span className="absolute top-1 right-1 w-4 h-4 bg-action-danger text-white text-xs font-bold flex items-center justify-center animate-pulse">
            {unreadCount > 99 ? '99+' : unreadCount}
          </span>
        )}
      </motion.button>

      <AnimatePresence>
        {isOpen && (
          <motion.div
            initial={{ opacity: 0, y: 10, scale: 0.95 }}
            animate={{ opacity: 1, y: 0, scale: 1 }}
            exit={{ opacity: 0, y: 10, scale: 0.95 }}
            transition={{ duration: 0.15 }}
            className="absolute right-0 top-full mt-2 w-[min(92vw,420px)] max-w-[calc(100vw-1rem)] bg-bg-surface shadow-2xl z-50 overflow-hidden flex flex-col max-h-[min(70dvh,640px)]"
          >
            {/* Header */}
            <div className="surface-card p-4 flex items-center justify-between bg-[var(--bg-card)]/50 shrink-0">
              <div className="flex items-center gap-2 min-w-0">
                <h3 className="font-semibold text-text-primary text-sm truncate">Notifications</h3>
                {unreadCount > 0 && (
                  <span className="surface-card px-2 py-0.5 text-xs bg-rose-500/10 text-action-danger font-medium shrink-0">
                    {unreadCount} new
                  </span>
                )}
              </div>
              <div className="flex items-center gap-2 shrink-0">
                {unreadCount > 0 && (
                  <button
                    onClick={handleMarkAllRead}
                    className="text-xs text-text-muted hover:text-text-primary flex items-center gap-1 transition-colors whitespace-nowrap"
                    title="Mark all as read"
                  >
                    <CheckCheck className="w-3.5 h-3.5" />
                    Mark all read
                  </button>
                )}
              </div>
            </div>

            {/* Filter Tabs */}
            <div className="surface-card flex bg-bg-base/50 px-4 py-2 gap-2 text-xs shrink-0">
              <button
                onClick={() => setFilter('all')}
                className="px-2.5 py-1 transition-colors font-medium"
              >
                All ({notifications.length})
              </button>
              <button
                onClick={() => setFilter('unread')}
                className="px-2.5 py-1 transition-colors font-medium"
              >
                Unread ({unreadCount})
              </button>
            </div>

            {/* Notification List */}
            <div className="overflow-y-auto flex-1 min-h-0 divide-y divide-border overscroll-contain">
              {loading && notifications.length === 0 ? (
                <div className="p-8 text-center text-xs text-text-muted">
                  Loading notifications...
                </div>
              ) : filteredNotifications.length === 0 ? (
                <div className="p-8 text-center text-text-muted flex flex-col items-center gap-2">
                  <Bell className="size-5 opacity-20" />
                  <p className="text-xs">No notifications yet</p>
                </div>
              ) : (
                filteredNotifications.map((n) => {
                  const Icon = PRIORITY_ICONS[n.priority] || Bell;
                  const color = PRIORITY_COLORS[n.priority] || 'text-text-muted';

                  return (
                    <div
                      key={n.id}
                      className={`p-4 transition-colors flex items-start gap-3 cursor-pointer ${
                        !n.readAt ? 'bg-[var(--bg-card)]/30 hover:bg-[var(--bg-card)]/60' : 'hover:bg-[var(--bg-card)]/60'
                      }`}
                      onClick={() => handleRowClick(n)}
                      role="button"
                      tabIndex={0}
                      onKeyDown={(e) => {
                        if (e.key === 'Enter' || e.key === ' ') handleRowClick(n);
                      }}
                    >
                      <div className={`p-2 bg-bg-base mt-0.5 shrink-0 ${color}`}>
                        <Icon className="w-4 h-4" />
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="flex items-start justify-between gap-2">
                          <h4 className={`text-xs font-semibold truncate min-w-0 ${!n.readAt ? 'text-text-primary' : 'text-text-muted'}`}>
                            {n.title}
                          </h4>
                          <span className="text-xs text-text-muted shrink-0">
                            {getTimeAgo(n.createdAt || (n as any).created_at)}
                          </span>
                        </div>
                        <p className="text-xs text-text-muted mt-1 line-clamp-2 leading-relaxed break-words">
                          {n.message}
                        </p>
                        {(n as any).action_url && (
                          <a
                            href={(n as any).action_url}
                            className="inline-flex items-center gap-1 text-xs text-action-info hover:text-action-info mt-2 font-medium"
                            onClick={(e) => e.stopPropagation()}
                          >
                            View details
                            <ExternalLink className="size-3.5" />
                          </a>
                        )}
                      </div>
                      {!n.readAt && (
                        <button
                          onClick={(e) => {
                            e.stopPropagation();
                            handleMarkRead(n.id);
                          }}
                          className="surface-card text-text-muted hover:text-action-success p-1 hover:bg-bg-base transition-colors mt-0.5 shrink-0"
                          title="Mark as read"
                        >
                          <Check className="w-3.5 h-3.5" />
                        </button>
                      )}
                    </div>
                  );
                })
              )}
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* Entity inspector — opens when a notification row is clicked */}
      <EntityInspector inspection={inspection} onClose={() => setActiveNotif(null)} />
    </div>
  );
}
</file>

<file path="src/components/shared/RoleChrome.tsx">
"use client";

/**
 * RoleChrome — the shared shell chrome: a bottom status strip (role-specific
 * live counts), a command-palette trigger, and a "K" hint.
 *
 * Mounted by RoleDesktopShell (desktop footer) and RoleMobileShell (a compact
 * bottom bar). All data + the palette resolve through useRoleConsoleChrome —
 * the same live endpoints the pages' boards use (shared cache, no extra
 * traffic).
 */

import { Command } from "lucide-react";
import { useRoleConsoleChrome } from "@/hooks/useRoleConsoleChrome";
import { useKeyboardShortcuts } from "@/hooks/useKeyboardShortcuts";
import { CommandBar as GenericCommandBar } from "@/components/shared/CommandBar";
import { cn } from "@/lib/utils";
import { useMemo } from "react";

import { OieStatusBar, type OieCounts } from "@/components/approver/OieStatusBar";
import { ExamSuperintendentStatusBar, type ExamSuperintendentCounts } from "@/components/approver/ExamSuperintendentStatusBar";
import { ExamBranchStatusBar, type ExamBranchCounts } from "@/components/approver/ExamBranchStatusBar";
import { CaretakerStatusBar, type CaretakerCounts } from "@/components/approver/CaretakerStatusBar";
import { HostelManagerStatusBar, type HostelManagerCounts } from "@/components/approver/HostelManagerStatusBar";
import { StaffStatusBar, type StaffCounts } from "@/components/approver/StaffStatusBar";
import { ParentStatusBar, type ParentCounts } from "@/components/approver/ParentStatusBar";
import { WorkerStatusBar, type WorkerCounts } from "@/components/approver/WorkerStatusBar";
import { SupervisorStatusBar, type SupervisorCounts } from "@/components/approver/SupervisorStatusBar";
import { MessInchargeStatusBar, type MessInchargeCounts } from "@/components/approver/MessInchargeStatusBar";
import { AdminStatusBar, type AdminCounts } from "@/components/approver/AdminStatusBar";
import { PrincipalStatusBar, type PrincipalCounts } from "@/components/approver/PrincipalStatusBar";
import { VpStatusBar, type VpCounts } from "@/components/approver/VpStatusBar";
import { SysadminStatusBar, type SysadminCounts } from "@/components/approver/SysadminStatusBar";


interface RoleChromeProps {
  /** The manifest role (e.g. "oie", "staff", "guardian"). */
  role: string;
  /** Desktop: renders a full-width sticky footer. */
  variant?: "footer" | "mobile";
  /** Extra classes (the desktop shell pins it). */
  className?: string;
}


function renderBar(chrome: ReturnType<typeof useRoleConsoleChrome>): React.ReactNode {
  const { kind, counts, lastScan, refreshing } = chrome;
  const c = counts as Record<string, unknown> | null;
  switch (kind) {
    case "oie":
      return <OieStatusBar counts={(c as OieCounts | null)} lastScan={lastScan} refreshing={refreshing} />;
    case "exam_superintendent":
      return <ExamSuperintendentStatusBar counts={(c as ExamSuperintendentCounts | null)} lastScan={lastScan} refreshing={refreshing} />;
    case "exam_branch":
      return <ExamBranchStatusBar counts={(c as ExamBranchCounts | null)} lastScan={lastScan} refreshing={refreshing} />;
    case "caretaker":
      return <CaretakerStatusBar counts={(c as CaretakerCounts | null)} refreshing={refreshing} />;
    case "hostel_manager":
      return <HostelManagerStatusBar counts={(c as HostelManagerCounts | null)} refreshing={refreshing} />;
    case "staff":
      return <StaffStatusBar counts={(c as StaffCounts | null)} refreshing={refreshing} />;
    case "parent":
      return <ParentStatusBar counts={(c as ParentCounts | null)} lastScan={lastScan} refreshing={refreshing} />;
    case "worker":
      return <WorkerStatusBar counts={(c as WorkerCounts | null)} lastScan={lastScan} refreshing={refreshing} />;
    case "supervisor":
      return <SupervisorStatusBar counts={(c as SupervisorCounts | null)} lastScan={lastScan} refreshing={refreshing} />;
    case "mess_incharge":
      return <MessInchargeStatusBar counts={(c as MessInchargeCounts | null)} refreshing={refreshing} />;
    case "admin":
      return <AdminStatusBar counts={(c as AdminCounts | null)} lastScan={lastScan} refreshing={refreshing} />;
    case "principal":
      return <PrincipalStatusBar counts={(c as PrincipalCounts | null)} lastScan={lastScan} refreshing={refreshing} />;
    case "vice_principal":
      return <VpStatusBar counts={(c as VpCounts | null)} lastScan={lastScan ?? null} refreshing={refreshing} />;
    case "sysadmin":
      return <SysadminStatusBar counts={(c as SysadminCounts | null)} lastScan={lastScan} refreshing={refreshing} />;
    default:
      return null;
  }
}

export function RoleChrome({ role, variant = "footer", className }: RoleChromeProps) {
  const chrome = useRoleConsoleChrome(role);
  const CommandBar = chrome.CommandBar ?? GenericCommandBar;

  // Global shortcuts: Cmd/Ctrl+K toggles the palette, Escape closes it.
  // Mirrors RoleConsole's useKeyboardShortcuts wiring so the shell has the
  // same keyboard experience.
  const shortcuts = useMemo(
    () => [
      {
        key: "k",
        mod: true,
        handler: () => chrome.setCommandBarOpen((o: boolean) => !o),
      },
      {
        key: "Escape",
        handler: () => {
          if (chrome.commandBarOpen) chrome.setCommandBarOpen(false);
        },
      },
    ],
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [chrome.commandBarOpen],
  );
  useKeyboardShortcuts(shortcuts);

  if (variant === "mobile") {
    // Mobile: a thin trigger row. The status counts are not all of them fit a
    // 12px bar, so the mobile variant shows a compact command trigger + the
    // role's bar (its own layout handles the wrapping).
    return (
      <div className={cn("shrink-0 border-t bg-bg-surface/95 backdrop-blur-md", className)}>
        {chrome.kind !== "generic" ? (
          <div className="px-2 py-1.5">{renderBar(chrome)}</div>
        ) : null}
        <button
          type="button"
          onClick={() => chrome.setCommandBarOpen(true)}
          aria-label="Open command menu"
          className="flex w-full items-center justify-center gap-2 py-1.5 text-xs text-text-muted hover:bg-bg-elevated hover:text-text-primary transition-colors"
        >
          <Command className="size-3.5" />
          <span className="font-medium">Command menu</span>
          <kbd className="rounded border border-border px-1 font-mono text-[10px] text-text-muted">
            {typeof navigator !== "undefined" && /Mac/.test(navigator.platform) ? "⌘" : "Ctrl+"}K
          </kbd>
        </button>
        <CommandBar
          role={role}
          open={chrome.commandBarOpen}
          onClose={() => chrome.setCommandBarOpen(false)}
        />
      </div>
    );
  }

  // Desktop footer.
  return (
    <div className={cn("sticky bottom-0 z-30 border-t bg-bg-surface/95 backdrop-blur-md", className)}>
      {chrome.kind !== "generic" ? (
        <div className="px-4">{renderBar(chrome)}</div>
      ) : null}
      <button
        type="button"
        onClick={() => chrome.setCommandBarOpen(true)}
        aria-label="Open command menu (Ctrl+K)"
        className="hidden lg:flex items-center gap-1.5 px-3 py-1.5 text-[11px] text-text-muted hover:bg-bg-elevated hover:text-text-primary transition-colors"
      >
        <Command className="size-3.5" />
        <span>Commands</span>
        <kbd className="rounded border border-border px-1 font-mono text-[10px]">⌘K</kbd>
      </button>
      {chrome.refreshing && chrome.kind !== "generic" ? (
        <span className="sr-only" role="status">Refreshing live counts</span>
      ) : null}
      <CommandBar
        role={role}
        open={chrome.commandBarOpen}
        onClose={() => chrome.setCommandBarOpen(false)}
      />
    </div>
  );
}

export default RoleChrome;
</file>

<file path="src/components/shared/Sidebar.tsx">
"use client";

import React, { useState, useEffect, Suspense } from "react";
import Link from "next/link";
import { usePathname, useSearchParams } from "next/navigation";
import { motion, AnimatePresence } from "framer-motion";
import {
  Menu,
  X,
  ChevronLeft,
  ChevronRight,
  LogOut,
  ShieldCheck,
} from "lucide-react";
import { getNavIcon } from "@/lib/lucide-icon-resolver";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import { useNavigation, NavGroup, NavItem } from "@/hooks/useNavigation";
import type { Role, User } from "@/lib/types";

// Helper to determine active link
// ponytail: takes searchParams as an arg (subscribed via useSearchParams in
// Sidebar) — usePathname strips ?tab=, and window.location.search doesn't
// re-render the layout on query-only nav, so the highlight went stale.
function isItemActive(pathname: string | null, href: string, searchParams: URLSearchParams | null): boolean {
  if (!pathname) return false;
  if (href === pathname) return true;
  if (href.includes("?")) {
    const [basePath, query] = href.split("?");
    if (pathname !== basePath) return false;
    const hrefParam = new URLSearchParams(query).get("tab");
    const currentParam = searchParams?.get("tab");
    return hrefParam === currentParam;
  }
  if (href !== "/" && href.length > 2 && pathname.startsWith(href) && !href.includes("?")) {
    if (searchParams?.has("tab")) {
      return false;
    }
    return true;
  }
  return false;
}
interface DesktopSidebarProps {
  processedNav: NavGroup[];
  pathname: string | null;
  searchParams: URLSearchParams | null;
  currentRole: Role;
  user: User | null;
  logout: () => void;
  isSidebarCollapsed: boolean;
  toggleSidebarCollapse: () => void;
}

const getPriorityItems = (role: Role, items: NavItem[]): NavItem[] => {
  const priorityMap: Record<string, string[]> = {
    admin: ['/admin', '/admin/students', '/admin/alerts', '/admin/reports'],
    sysadmin: ['/sysadmin', '/sysadmin/analytics', '/sysadmin/security', '/sysadmin/audit'],
    operator: ['/gate', '/admin/alerts', '/worker/shifts'],
    supervisor: ['/supervisor', '/supervisor?tab=approvals', '/supervisor?tab=alerts', '/supervisor?tab=curfew'],
    principal: ['/principal', '/principal/approvals'],
    student: ['/student', '/student/history', '/student/passes', '/student/profile'],
    parent: ['/guardian', '/guardian/child-requests', '/guardian/child-attendance', '/guardian/child-status'],
    guardian: ['/guardian', '/guardian/child-requests', '/guardian/child-attendance', '/guardian/child-status'],
    faculty: ['/faculty', '/faculty/my-classes', '/admin/alerts', '/faculty/permissions'],
    staff: ['/staff', '/staff/my-day', '/admin/alerts', '/staff/my-profile'],
    worker: ['/worker', '/worker/shifts', '/worker/work-orders', '/worker/history', '/worker/profile'],
    visitor: ['/visitor', '/visitor/approval-status', '/visitor/history', '/visitor/request'],
    mess_incharge: ['/mess', '/mess/scan'],
  };
  const priority = priorityMap[role] || [];
  const prioritized = items.filter(item => priority.some(p => item.href.startsWith(p)));
  const remaining = items.filter(item => !priority.some(p => item.href.startsWith(p)));
  return [...prioritized, ...remaining].slice(0, 4);
};

function DesktopSidebar({
