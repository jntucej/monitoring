<file path="src/components/sysadmin/AuditLogViewer.tsx">
"use client";
import { errMsg } from "@/lib/err-msg";

import { useEffect, useState } from "react";
import { ChevronLeft, ChevronRight } from "lucide-react";
import { generateCSV } from "@/lib/export";
import { useApi } from "@/hooks/useApi";
import { AuditFilters } from "./AuditFilters";
import { AuditLogRow } from "./AuditLogRow";

export function AuditLogViewer() {
const api = useApi();

  const [logs, setLogs] = useState<any[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const [actionFilter, setActionFilter] = useState("");
  const [userIdFilter, setUserIdFilter] = useState("");
  const [fromFilter, setFromFilter] = useState("");
  const [toFilter, setToFilter] = useState("");
  const [page, setPage] = useState(1);
  const limit = 25;

  const fetchLogs = async () => {
    setLoading(true);
    setError(null);
    try {
      const params = new URLSearchParams();
      if (actionFilter) params.set("action", actionFilter);
      if (userIdFilter) params.set("userId", userIdFilter);
      if (fromFilter) params.set("from", new Date(fromFilter).toISOString());
      if (toFilter) params.set("to", new Date(toFilter).toISOString());
      params.set("limit", limit.toString());
      params.set("offset", ((page - 1) * limit).toString());

      const res = await fetch(`/api/admin/audit?${params.toString()}`, {
        headers: api.getHeaders(),
        cache: "no-store",
      });
      const json = await res.json();

      if (res.ok && json.success) {
        setLogs(json.data || []);
        setTotal(json.total || 0);
      } else {
        setError(json.error?.message || "Failed to load audit logs");
      }
    } catch (err) {
      setError(errMsg(err) || "Network error loading audit logs");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchLogs();
  }, [page]);

  const handleExport = async () => {
    if (logs.length === 0) return;
    const exportData = logs.map((l) => ({
      Timestamp: l.timestamp ? new Date(l.timestamp).toLocaleString("en-IN") : "",
      Action: l.action,
      "User Name": l.user_name || "N/A",
      Role: l.user_role || "N/A",
      "User ID": l.user_id,
      Details: typeof l.details === "object" ? JSON.stringify(l.details) : l.details || "",
    }));

    const result = await generateCSV(exportData, `audit_logs_${new Date().toISOString().slice(0, 10)}`);
    if (result.success && result.data) {
      const blob = new Blob([result.data], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", result.filename);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  };

  const totalPages = Math.ceil(total / limit) || 1;

  return (
    <div className="space-y-4">
      <AuditFilters
        actionFilter={actionFilter} setActionFilter={setActionFilter}
        userIdFilter={userIdFilter} setUserIdFilter={setUserIdFilter}
        fromFilter={fromFilter} setFromFilter={setFromFilter}
        toFilter={toFilter} setToFilter={setToFilter}
        onApply={() => { setPage(1); fetchLogs(); }}
        onReset={() => { setActionFilter(""); setUserIdFilter(""); setFromFilter(""); setToFilter(""); setPage(1); }}
        onRefresh={fetchLogs} onExport={handleExport}
        loading={loading} exportDisabled={logs.length === 0}
      />

      <div className="bg-bg-surface rounded-xl border border-border overflow-hidden">
        {error ? (
          <div className="p-6 text-action-danger text-sm">{error}</div>
        ) : loading ? (
          <div className="p-8 text-center text-sm text-text-muted">Loading audit telemetry...</div>
        ) : logs.length === 0 ? (
          <div className="p-8 text-center text-sm text-text-muted">No audit records found.</div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-sm min-w-[750px]">
              <thead className="bg-bg-elevated text-xs text-text-muted uppercase font-semibold border-b border-border">
                <tr>
                  <th className="py-2.5 px-4">Timestamp</th>
                  <th className="py-2.5 px-4">Action</th>
                  <th className="py-2.5 px-4">Actor</th>
                  <th className="py-2.5 px-4">Role</th>
                  <th className="py-2.5 px-4">Details</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {logs.map((l) => <AuditLogRow key={l.id || l.timestamp} log={l} />)}
              </tbody>
            </table>
          </div>
        )}

        <div className="surface-card p-3 flex items-center justify-between text-xs text-text-muted">
          <span>Total: {total} items</span>
          <div className="flex items-center gap-2">
            <button
              onClick={() => setPage((p) => Math.max(p - 1, 1))}
              disabled={page <= 1}
              className="surface-card p-1 disabled:opacity-40"
            >
              <ChevronLeft className="w-3.5 h-3.5" />
            </button>
            <span>{page} / {totalPages}</span>
            <button
              onClick={() => setPage((p) => Math.min(p + 1, totalPages))}
              disabled={page >= totalPages}
              className="surface-card p-1 disabled:opacity-40"
            >
              <ChevronRight className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/BackupManagement.tsx">
"use client";
import { errMsg } from "@/lib/err-msg";

import { useState, useEffect } from "react";
import { Database, Download, Upload, Loader2, RefreshCw, ShieldCheck } from "lucide-react";
import { useApi } from "@/hooks/useApi";

export function BackupManagement() {
const api = useApi();

  const [backups, setBackups] = useState<any[]>([]);
  const [verifications, setVerifications] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [verifying, setVerifying] = useState(false);
  const [msg, setMsg] = useState<{ type: "success" | "error"; text: string } | null>(null);

  const fetchBackups = async () => {
    setLoading(true);
    try {
      const headers = api.getHeaders();
      const [resB, resV] = await Promise.all([
        fetch("/api/admin/backup", { headers }),
        fetch("/api/admin/backup/verify", { headers }),
      ]);
      const jsonB = await resB.json();
      const jsonV = await resV.json();
      if (resB.ok && jsonB.success) setBackups(jsonB.data || []);
      if (resV.ok && jsonV.success) setVerifications(jsonV.data || []);
    } catch {} finally { setLoading(false); }
  };

  const handleVerifyBackup = async () => {
    setVerifying(true); setMsg(null);
    try {
      const headers = api.getHeaders();
      const res = await fetch("/api/admin/backup/verify", { method: "POST", headers });
      const json = await res.json();
      if (res.ok && json.success) {
        if (json.data?.status === "failed") {
          setMsg({ type: "error", text: `Verification FAILED: ${json.data?.details || "core table checks did not pass"}` });
        } else {
          setMsg({ type: "success", text: `Verification Passed! Tables verified: ${json.data?.tablesVerified ?? 0}. Records checked: ${json.data?.recordsVerified ?? 0}.` });
        }
        fetchBackups();
      } else { setMsg({ type: "error", text: json.error?.message || "Backup verification failed" }); }
    } catch (err) { setMsg({ type: "error", text: errMsg(err) }); } finally { setVerifying(false); }
  };

  useEffect(() => { fetchBackups(); }, []);

  const handleCreateBackup = async () => {
    setBusy(true); setMsg(null);
    try {
      const headers = { ...api.getHeaders(), "Content-Type": "application/json" };
      const res = await fetch("/api/admin/backup", { method: "POST", headers, body: JSON.stringify({ action: "create" }) });
      const json = await res.json();
      if (res.ok && json.success) {
        setMsg({ type: "success", text: `Backup created (${json.data?.recordCount} records)` });
        if (json.dump) {
          const blob = new Blob([JSON.stringify(json.dump, null, 2)], { type: "application/json" });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a"); a.href = url; a.download = json.data?.filename || "backup.json"; a.click();
        }
        fetchBackups();
      } else { setMsg({ type: "error", text: json.error?.message || "Failed" }); }
    } catch (err) { setMsg({ type: "error", text: errMsg(err) }); } finally { setBusy(false); }
  };

  const handleFileRestore = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file || !confirm("Restore database from snapshot? Matching records will be updated.")) return;
    setBusy(true); setMsg(null);
    try {
      const reader = new FileReader();
      reader.onload = async (event) => {
        try {
          const backupData = JSON.parse(event.target?.result as string);
          const headers = api.getHeaders();
          const res = await fetch("/api/admin/backup", { method: "POST", headers, body: JSON.stringify({ action: "restore", backupData }) });
          const json = await res.json();
          if (res.ok && json.success) {
            setMsg({ type: "success", text: `Restored! Tables: ${json.data?.restoredTables?.join(", ")}` });
            fetchBackups();
          } else { setMsg({ type: "error", text: json.error?.message || "Restore failed" }); }
        } catch { setMsg({ type: "error", text: "Invalid JSON backup" }); } finally { setBusy(false); }
      };
      reader.readAsText(file);
    } catch { setMsg({ type: "error", text: "Read error" }); setBusy(false); }
  };

  return (
    <div className="surface-card bg-bg-surface p-5 space-y-4">
      <div className="surface-card flex items-center justify-between flex-wrap gap-3 pb-3">
        <div>
          <h3 className="font-semibold text-white flex items-center gap-2">
            <Database className="w-5 h-5 text-action-info" /> Database Backup & Restore
          </h3>
          <p className="text-xs text-text-muted">Create snapshots or restore database state.</p>
        </div>
        <div className="flex items-center gap-2">
          <button onClick={handleVerifyBackup} disabled={verifying || busy} className="surface-card px-3 py-1.5 text-xs font-semibold bg-emerald-700 hover:bg-action-success text-white flex items-center gap-1.5 disabled:opacity-50">
            {verifying ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <ShieldCheck className="w-3.5 h-3.5" />} Verify Integrity
          </button>
          <label className="surface-card cursor-pointer px-3 py-1.5 text-xs font-semibold bg-bg-elevated hover:bg-bg-base flex items-center gap-1.5">
            <Upload className="w-3.5 h-3.5 text-action-warning" /> Restore Snapshot
            <input type="file" accept=".json" onChange={handleFileRestore} className="hidden" disabled={busy} />
          </label>
          <button onClick={handleCreateBackup} disabled={busy} className="surface-card px-3 py-1.5 text-xs font-semibold bg-sky-600 hover:bg-action-info text-white flex items-center gap-1.5 disabled:opacity-50">
            {busy ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Download className="w-3.5 h-3.5" />} Backup Now
          </button>
        </div>
      </div>

      {msg && <div className={`p-3 rounded-lg text-xs font-medium ${msg.type === "success" ? "bg-emerald-500/10 text-action-success" : "bg-rose-500/10 text-action-danger"}`}>{msg.text}</div>}

      {loading ? (
        <div className="text-xs text-center py-4 text-text-muted flex justify-center items-center gap-2">
          <RefreshCw className="w-4 h-4 animate-spin text-action-info" /> Loading backups...
        </div>
      ) : backups.length === 0 ? (
        <div className="text-xs text-center py-4 text-text-muted">No backup snapshots recorded.</div>
      ) : (
        <div className="space-y-3">
          <div className="divide-y divide-border border border-border rounded-lg overflow-hidden">
            {backups.slice(0, 10).map((b) => (
              <div key={b.id} className="p-3 flex items-center justify-between bg-bg-elevated/40 text-xs gap-3">
                <div className="space-y-0.5 min-w-0">
                  <p className="font-semibold text-action-info font-mono truncate">{b.filename}</p>
                  <p className="text-xs text-text-muted">
                    {new Date(b.createdAt).toLocaleString("en-IN")} &bull; {b.recordCount} records &bull; {b.size > 1048576 ? `${(b.size / 1048576).toFixed(1)} MB` : `${Math.round(b.size / 1024)} KB`}
                  </p>
                  {b.checksum && (
                    <p className="text-xs font-mono text-text-muted truncate max-w-sm">
                      SHA-256: <span className="text-emerald-400/90">{b.checksum.slice(0, 16)}…</span>
                    </p>
                  )}
                </div>
                <div className="flex items-center gap-2 shrink-0">
                  <span className="surface-card px-2 py-0.5 text-xs uppercase bg-emerald-500/10 text-action-success font-bold">{b.status}</span>
                </div>
              </div>
            ))}
          </div>

          {verifications.length > 0 && (
            <div className="surface-card pt-2">
              <h4 className="text-xs font-semibold text-text-muted uppercase mb-2">Recent Verification History</h4>
              <div className="divide-y divide-border border border-border rounded-lg overflow-hidden text-xs">
                {verifications.slice(0, 3).map((v) => (
                  <div key={v.id} className="p-2 flex items-center justify-between bg-bg-surface">
                    <div>
                      <span className="font-semibold text-action-success font-mono">Verified: {v.recordsVerified || v.records_verified || 0} records</span>
                      <p className="text-xs text-text-muted">{new Date(v.verifiedAt || v.created_at || Date.now()).toLocaleString("en-IN")}</p>
                    </div>
                    <span className="surface-card px-2 py-0.5 text-xs uppercase bg-emerald-500/20 text-action-success font-bold">{v.status || "PASSED"}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/sysadmin/BulkUserImportModal.tsx">
"use client";
import { errMsg } from "@/lib/err-msg";

import { useState } from "react";
import {Upload, X, FileText, Loader2, ScrollText, Download}  from "lucide-react";
import { useApi } from "@/hooks/useApi";

interface BulkUserImportModalProps {
  onClose: () => void;
  onSuccess: () => void;
}

interface PreviewError {
  row: number;
  field?: string;
  message: string;
}

interface RowReport {
  row: number;
  roll?: string;
  name?: string;
  email?: string;
  status: "imported" | "skipped" | "invalid";
  reason: string;
}

interface BulkImportReport {
  totalRows: number;
  imported: number;
  skipped: number;
  invalid: number;
  rows: RowReport[];
}

interface PreviewState {
  summary: { total: number; valid: number; invalid: number; skipped: number };
  errors: PreviewError[];
  skippedRows: Array<{ row: number; roll: string; name?: string }>;
  importedBefore: number;
}

// 8-column minimal sheet — the exact headers the college sheet uses.
// FATHER/GUARDIAN_NAME (with the slash) normalizes to the same key the
// importer's pick() alias system resolves, so it maps to fatherGuardianName.
const MINIMAL_CSV =
  "HTNO,STUDENT_NAME,FATHER/GUARDIAN_NAME,GENDER,MOBILE,DOB,EMAIL,PARENT_MOBILE\n" +
  "25JJ1A0501,AADITH KUMAR,Prakash Rao,male,9876543210,12-05-2005,aadith.k@jntuhcej.ac.in,9440123456\n";

const MINIMAL_HINTS: Array<[string, string]> = [
  ["HTNO", "Required — the 10-char hall-ticket/roll number (yyJJVVBBNN). Drives year, batch and branch automatically."],
  ["STUDENT_NAME", "Required — full name."],
  ["FATHER/GUARDIAN_NAME", "Optional — father / guardian name (the slash in the header is fine)."],
  ["GENDER", "male / female (M, F accepted)."],
  ["MOBILE", "Student 10-digit mobile."],
  ["DOB", "DD-MM-YYYY or YYYY-MM-DD."],
  ["EMAIL", "Required — valid email. Used for login + de-dup."],
  ["PARENT_MOBILE", "Optional — parent contact number."],
];

function downloadCsv(text: string, filename: string) {
  const blob = new Blob([text], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.setAttribute("href", url);
  link.setAttribute("download", filename);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}

export function BulkUserImportModal({ onClose, onSuccess }: BulkUserImportModalProps) {
  const api = useApi();

  const [csvText, setCsvText] = useState("");
  const [busy, setBusy] = useState<"idle" | "commit">("idle");
  const [preview, setPreview] = useState<PreviewState | null>(null);
  /** The final per-row report, kept so the modal stays open and shows the outcome. */
  const [report, setReport] = useState<BulkImportReport | null>(null);
  /** B7: per-row enrollment codes for freshly imported students (from the commit response). */
  const [reportBootstrapCodes, setReportBootstrapCodes] = useState<Array<{ row: number; roll: string | null; code: string }> | null>(null);























  const handleImport = async () => {
    setBusy("commit");
    try {
      const res = await fetch("/api/users/bulk/commit", {
        method: "POST",
        headers: { "Content-Type": "application/json", ...api.getHeaders() },
        body: JSON.stringify({ csv: csvText, skipErrors: true }),
      });
      const json = await res.json();
      if (res.ok && json.success) {
        const d = json.data ?? json;
        const rpt: BulkImportReport = d.report ?? { totalRows: 0, imported: 0, skipped: 0, invalid: 0, rows: [] };
        setReport(rpt);
        setReportBootstrapCodes(d.bootstrapCodes ?? []);
        setPreview(null);
        onSuccess();
      } else {
        setReport({
          totalRows: 0,
          imported: 0,
          skipped: 0,
          invalid: 0,
          rows: [{ row: 0, status: "invalid", reason: json.error?.message || "Import failed" }],
        });
        setReportBootstrapCodes(null);
      }
    } catch (err) {
      setReport({
        totalRows: 0,
        imported: 0,
        skipped: 0,
        invalid: 0,
        rows: [{ row: 0, status: "invalid", reason: errMsg(err) || "Network error during bulk import" }],
      });
      setReportBootstrapCodes(null);
    } finally {
      setBusy("idle");
    }
  };

  const buildReportCsv = (r: BulkImportReport, codes?: Array<{ row: number; roll: string | null; code: string }> | null): string => {
    const codeByRow = new Map((codes ?? []).map((c) => [c.row, c.code]));
    // `bootstrap_code` is intentionally NOT a column in this file — bundling
    // live enrollment codes into a downloadable CSV turns the report into a
    // credential leak (any copy on disk/email/ticket = usable login code).
    // The codes are only shown on-screen (read-only) in this dialog; admins
    // copy them out-of-band. Status + reason stay in the CSV.
    const header = ["row", "roll", "name", "email", "status", "reason", "has_setup_code"];
    const lines = [header.join(",")];
    for (const row of r.rows) {
      const cells = [
        String(row.row),
        row.roll ?? "",
        row.name ?? "",
        row.email ?? "",
        row.status,
        row.reason,
        codeByRow.has(row.row) ? "yes" : "no",
      ];
      lines.push(cells.map((c) => `"${String(c).replace(/"/g, '""')}"`).join(","));
    }
    return lines.join("\n");
  };

  const downloadReport = () => {
    if (!report) return;
    downloadCsv(
      buildReportCsv(report, reportBootstrapCodes),
      `bulk_import_report_${new Date().toISOString().slice(0, 19).replace(/[:T]/g, "-")}.csv`
    );
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
      <div className="surface-card bg-bg-surface p-4 sm:p-6 w-full space-y-4 max-h-[90vh] overflow-y-auto" style={{ maxWidth: report ? "38rem" : "56rem" }}>
        <div className="surface-card flex justify-between items-center pb-3">
          <h3 className="font-bold text-lg text-white flex items-center gap-2">
            <Upload className="w-5 h-5 text-action-info" /> Bulk Student Import
          </h3>
          <button onClick={onClose} className="p-1 text-text-muted hover:text-white">
            <X className="w-5 h-5" />
          </button>
        </div>

        {!report && (
          <>
            <div className="text-xs text-text-muted space-y-1">
              <p>
                Upload the college sheet (<code>8 columns</code> minimal, or up to 35).
                HTNO drives year, batch and branch — <b>everything else is captured as-is.</b>
              </p>
              <p>
                <b>New / re-upload:</b> rows whose roll already exists are <span className="text-action-warning">skipped</span> (never updated).
                Only empty-field / required-field problems mark a row as <span className="text-action-danger">invalid</span>.
              </p>
            </div>

            <div className="flex flex-wrap items-center gap-2">
              <label className="surface-card cursor-pointer px-3 py-1.5 bg-bg-elevated text-xs font-semibold hover:bg-bg-base flex items-center gap-2">
                <FileText className="w-4 h-4 text-action-info" /> Choose CSV File
                <input type="file" accept=".csv" onChange={(e) => {
                  const file = e.target.files?.[0];
                  if (!file) return;
                  const reader = new FileReader();
                  reader.onload = (ev) => { setCsvText(ev.target?.result as string); setPreview(null); };
                  reader.readAsText(file);
                }} className="hidden" />
              </label>

              <button
                type="button"
                onClick={() => downloadCsv(MINIMAL_CSV, "student_import_template.csv")}
                className="surface-card px-3 py-1.5 bg-bg-elevated text-xs font-semibold hover:bg-bg-base text-action-info flex items-center gap-1.5"
              >
                <Download className="w-3.5 h-3.5" /> Download Template
              </button>

              <button
                type="button"
                onClick={() => { setCsvText(MINIMAL_CSV); setPreview(null); }}
                className="surface-card px-3 py-1.5 bg-bg-elevated text-xs font-semibold hover:bg-bg-base text-unit-c flex items-center gap-1.5"
              >
                <ScrollText className="w-3.5 h-3.5" /> Load Sample
              </button>
            </div>

            <textarea
              rows={7}
              placeholder={"HTNO,STUDENT_NAME,FATHER/GUARDIAN_NAME,GENDER,MOBILE,DOB,EMAIL,PARENT_MOBILE\n25JJ1A0501,AADITH KUMAR,Prakash Rao,male,9876543210,12-05-2005,aadith.k@jntuhcej.ac.in,9440123456"}
              value={csvText}
              onChange={(e) => { setCsvText(e.target.value); setPreview(null); }}
              className="surface-card w-full font-mono text-xs p-3 bg-bg-base text-white focus:outline-none"
            />

            {preview && preview.summary.total > 0 && (
              <div className="surface-card p-3 text-xs space-y-2 bg-bg-base">
                <div className="flex gap-4 font-semibold">
                  <span>{preview.summary.total} rows</span>
                  <span className="text-action-success">{preview.summary.valid} importable</span>
                  <span className="text-action-warning">{preview.summary.skipped} already in DB</span>
                  <span className={preview.summary.invalid ? "text-action-danger" : ""}>{preview.summary.invalid} invalid</span>
                </div>
                {preview.skippedRows.length > 0 && (
                  <div className="surface-card bg-amber-500/10 p-2 text-action-warning">
                    <b>{preview.skippedRows.length}</b> row(s) match existing students — they will be skipped (no update).
                    {preview.skippedRows.slice(0, 5).map((s) => (
                      <div key={s.roll} className="pl-2 text-amber-700/80">row {s.row} · {s.roll}{s.name ? ` (${s.name})` : ""}</div>
                    ))}
                    {preview.skippedRows.length > 5 && <div className="pl-2 text-amber-700/60">… and {preview.skippedRows.length - 5} more</div>}
                  </div>
                )}
                {preview.errors.length > 0 && (
                  <div className="max-h-28 overflow-y-auto space-y-1">
                    {preview.errors.slice(0, 10).map((er, i) => (
                      <div key={i} className="text-action-danger">
                        Row {er.row}{er.field ? ` (${er.field})` : ""}: {er.message}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}

            <div className="surface-card flex justify-end gap-2 pt-2">
              <button onClick={onClose} className="px-3 py-1.5 text-xs text-text-muted hover:text-white font-medium">Cancel</button>
              <button
                type="button"
                onClick={handleImport}
                disabled={busy !== "idle" || !csvText.trim()}
                className="surface-card px-4 py-1.5 bg-sky-600 hover:bg-action-info text-white text-xs font-bold disabled:opacity-50 flex items-center gap-2"
              >
                {busy === "commit" ? <><Loader2 className="w-3.5 h-3.5 animate-spin" /> Importing…</> : "Run Import"}
              </button>
            </div>
          </>
        )}

        {report && (
          <div className="space-y-3">
            <div className="text-xs text-text-muted">
              Import finished. The modal stays open so you can review and download the report.
            </div>

            <div className="grid grid-cols-3 gap-2 text-center text-xs font-semibold">
              <div className="surface-card p-2 bg-emerald-500/10 text-action-success">{report.imported} imported</div>
              <div className="surface-card p-2 bg-amber-500/10 text-action-warning">{report.skipped} skipped (already in DB)</div>
              <div className="surface-card p-2 bg-rose-500/10 text-action-danger">{report.invalid} invalid</div>
            </div>

            <button
              type="button"
              onClick={downloadReport}
              className="surface-card w-full px-3 py-2 bg-bg-elevated text-xs font-semibold hover:bg-bg-base text-action-info flex items-center justify-center gap-2"
            >
              <Download className="w-4 h-4" /> Download Report CSV (imported + not-imported)
            </button>

            {reportBootstrapCodes && reportBootstrapCodes.length > 0 && (
              <div className="surface-card bg-emerald-500/5 p-3 text-xs space-y-1">
                <div className="font-semibold text-action-success">
                  {reportBootstrapCodes.length} one-time setup code(s) issued — hand each to the student so they
                  can activate at <code className="font-mono">/bootstrap?code=…</code>
                </div>
                <div className="text-text-muted">
                  Each code is shown once and stored hashed (in <code>enrollment_codes</code>). It is not
                  recoverable later, so copy it into the CSV before closing this dialog.
                </div>
                <pre className="surface-card text-xs leading-5 bg-bg-base p-2 overflow-x-auto">
{reportBootstrapCodes.map((c) => `row ${c.row}  ${c.roll ?? ""}  ${c.code}`).join("\n")}
                </pre>
              </div>
            )}

            <div className="max-h-64 overflow-y-auto rounded-lg border border-border">
              <table className="w-full text-xs">
                <thead className="sticky top-0 bg-bg-base text-text-muted">
                  <tr>
                    <th className="p-2 text-left">Row</th>
                    <th className="p-2 text-left">Roll</th>
                    <th className="p-2 text-left">Name</th>
                    <th className="p-2 text-left">Status</th>
                    <th className="p-2 text-left">Reason</th>
                    <th className="p-2 text-left">Setup code</th>
                  </tr>
                </thead>
                <tbody>
                  {report.rows.map((r) => {
                    const codeEntry = reportBootstrapCodes?.find((c) => c.row === r.row);
                    return (
                      <tr key={r.row} className="border-t border-border">
                        <td className="p-2 text-text-muted">{r.row}</td>
                        <td className="p-2 font-mono">{r.roll || "—"}</td>
                        <td className="p-2">{r.name || "—"}</td>
                        <td className="p-2">
                          {r.status === "imported" && <span className="text-action-success font-semibold">Imported</span>}
                          {r.status === "skipped" && <span className="text-action-warning font-semibold">Already in DB</span>}
                          {r.status === "invalid" && <span className="text-action-danger font-semibold">Invalid</span>}
                        </td>
                        <td className="p-2 text-text-muted">{r.reason}</td>
                        <td className="p-2 font-mono">{codeEntry?.code ?? ""}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            <div className="flex justify-end gap-2">
              <button onClick={onClose} className="px-3 py-1.5 text-xs text-text-muted hover:text-white font-medium">Close</button>
              <button
                type="button"
                onClick={() => { setReport(null); setPreview(null); setCsvText(""); setReportBootstrapCodes(null); }}
                className="surface-card px-4 py-1.5 bg-sky-600 hover:bg-action-info text-white text-xs font-bold"
              >
                Import Another File
              </button>
            </div>
          </div>
        )}

        {!report && (
          <details className="text-xs text-text-muted">
            <summary className="cursor-pointer font-semibold">Column reference</summary>
            <div className="mt-2 space-y-2">
              <p className="font-semibold text-[var(--text)]">Minimal 8-column sheet</p>
              <ul className="space-y-1 pl-4 list-disc">
                {MINIMAL_HINTS.map(([k, v]) => (
                  <li key={k}><b>{k}</b> — {v}</li>
                ))}
              </ul>
            </div>
          </details>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/ComplianceSettings.tsx">
"use client";

import { useEffect, useState } from "react";
import { useUIStore } from "@/stores/uiStore";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Edit2, ShieldCheck, Download, UserX, Play, Database } from "lucide-react";
import { Modal } from "@/components/ui/modal";
import { Input } from "@/components/ui/input";
import { useApi } from "@/hooks/useApi";

export function ComplianceSettings() {
const api = useApi();

  const { addToast } = useUIStore();

  const [policies, setPolicies] = useState<any[]>([]);
  const [targetUserId, setTargetUserId] = useState("");
  const [exportData, setExportData] = useState<string | null>(null);
  const [editingPolicy, setEditingPolicy] = useState<any | null>(null);
  const [savingPolicy, setSavingPolicy] = useState(false);

  const getHeaders = () => ({
    ...api.getHeaders(),
    "Content-Type": "application/json",
  });

  const handleUpdatePolicy = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!editingPolicy) return;
    setSavingPolicy(true);
    try {
      const res = await fetch("/api/admin/retention-policies", {
        method: "PATCH",
        headers: getHeaders(),
        body: JSON.stringify({
          id: editingPolicy.id,
          retention_days: Number(editingPolicy.retention_days),
          auto_delete: Boolean(editingPolicy.auto_delete),
        }),
      });
      const data = await res.json();
      if (data.success) {
        addToast({ variant: "success", title: "Policy Updated", message: "Retention lifecycle policy updated." });
        setEditingPolicy(null);
        fetchPolicies();
      } else {
        addToast({ variant: "error", title: "Error", message: data.error?.message || "Failed to update policy" });
      }
    } catch {
      addToast({ variant: "error", title: "Error", message: "Network request error" });
    } finally {
      setSavingPolicy(false);
    }
  };

  const fetchPolicies = async () => {
    try {
      const res = await fetch("/api/admin/retention-policies", { headers: getHeaders() });
      const data = await res.json();
      if (data.success) setPolicies(data.data || []);
    } catch {}
  };

  useEffect(() => { fetchPolicies(); }, []);

  const handleRunRetention = async () => {
    try {
      const res = await fetch("/api/admin/retention/run", { method: "POST", headers: getHeaders() });
      const result = await res.json();
      if (result.success) addToast({ variant: "success", title: "Retention Swept", message: result.data.message });
    } catch {}
  };

  const handleAnonymize = async () => {
    if (!targetUserId) return;
    try {
      const res = await fetch("/api/admin/compliance/anonymize", {
        method: "POST",
        headers: getHeaders(),
        body: JSON.stringify({ userId: targetUserId }),
      });
      const result = await res.json();
      if (result.success) addToast({ variant: "success", title: "Anonymized", message: `User ${targetUserId} PII anonymized.` });
    } catch {}
  };

  const handleExport = async () => {
    if (!targetUserId) return;
    try {
      const res = await fetch("/api/admin/compliance/export", {
        method: "POST",
        headers: getHeaders(),
        body: JSON.stringify({ userId: targetUserId }),
      });
      const result = await res.json();
      if (result.success) setExportData(result.data.json);
    } catch {}
  };

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center">
        <div>
          <p className="text-2xl font-bold tracking-tight">Compliance & Data Retention</p>
          <p className="text-sm text-text-muted">Automate GDPR right-to-be-forgotten and data lifecycle policies.</p>
        </div>
        <Button onClick={handleRunRetention} variant="secondary" className="gap-2">
          <Play className="w-4 h-4" /> Run Retention Sweep Now
        </Button>
      </div>

      <Card className="border">
        <CardHeader>
          <CardTitle className="text-lg font-semibold flex items-center gap-2"><Database className="w-5 h-5 text-action-primary" /> Table Retention Lifecycles</CardTitle>
        </CardHeader>
        <CardContent>
          <div className="overflow-x-auto">
            <table className="w-full text-sm text-left min-w-[650px]">
              <thead className="bg-bg-elevated dark:bg-bg-elevated/50 text-text-muted">
                <tr><th className="p-3">Data Category</th><th className="p-3">Retention Window</th><th className="p-3">Auto Sweep</th><th className="p-3 text-right">Actions</th></tr>
              </thead>
              <tbody className="divide-y">
                {policies.map((p) => (
                  <tr key={p.id}>
                    <td className="p-3 font-medium capitalize">{p.data_category.replace("_", " ")}</td>
                    <td className="p-3 font-mono">{p.retention_days} days</td>
                    <td className="p-3"><Badge variant={p.auto_delete ? "success" : "offline"}>{p.auto_delete ? "Enabled" : "Disabled"}</Badge></td>
                    <td className="p-3 text-right">
                      <Button variant="secondary" size="sm" className="h-7 text-xs gap-1" onClick={() => setEditingPolicy({ ...p })}>
                        <Edit2 className="size-3.5" /> Edit
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>

      <Card className="surface-card p-4 space-y-4">
        <h3 className="font-semibold text-lg flex items-center gap-2"><ShieldCheck className="w-5 h-5 text-unit-c" /> GDPR User Data Tools</h3>
        <div className="flex gap-3">
          <input value={targetUserId} onChange={(e) => setTargetUserId(e.target.value)} placeholder="Enter User Unique ID / Roll No." className="surface-card flex-1 p-2 text-sm bg-white dark:bg-bg-elevated" />
          <Button onClick={handleExport} variant="secondary" size="sm" className="gap-1"><Download className="w-3.5 h-3.5" /> Export Data</Button>
          <Button onClick={handleAnonymize} variant="danger" size="sm" className="gap-1"><UserX className="w-3.5 h-3.5" /> Anonymize PII</Button>
        </div>

        {exportData && (
          <div className="mt-4">
            <div className="text-xs font-semibold mb-1">JSON Data Export:</div>
            <pre className="surface-card p-3 bg-bg-elevated text-green-400 text-xs max-h-48 overflow-y-auto font-mono">{exportData}</pre>
          </div>
        )}
      </Card>

      <Modal isOpen={!!editingPolicy} onClose={() => setEditingPolicy(null)} title="Edit Retention Policy">
        {editingPolicy && (
          <form onSubmit={handleUpdatePolicy} className="space-y-4">
            <div>
              <label className="block text-xs font-medium text-text-muted mb-1 uppercase">Data Category</label>
              <div className="surface-card p-2.5 bg-bg-elevated text-sm font-semibold capitalize">
                {editingPolicy.data_category.replace("_", " ")}
              </div>
            </div>
            <Input
              label="Retention Window (Days)"
              type="number"
              value={editingPolicy.retention_days}
              onChange={(e) => setEditingPolicy({ ...editingPolicy, retention_days: e.target.value })}
              required
            />
            <div className="flex items-center gap-2 pt-2">
              <input
                type="checkbox"
                id="auto_delete"
                checked={editingPolicy.auto_delete}
                onChange={(e) => setEditingPolicy({ ...editingPolicy, auto_delete: e.target.checked })}
                className="w-4 h-4 rounded border-border text-blue-600 focus:ring-action-primary"
              />
              <label htmlFor="auto_delete" className="text-sm font-medium text-text-primary cursor-pointer">
                Enable Auto Sweep (Purge records older than retention limit)
              </label>
            </div>
            <div className="surface-card flex justify-end gap-2 pt-4">
              <Button type="button" variant="secondary" onClick={() => setEditingPolicy(null)}>Cancel</Button>
              <Button type="submit" variant="primary" loading={savingPolicy}>Save Policy</Button>
            </div>
          </form>
        )}
      </Modal>
    </div>
  );
}
