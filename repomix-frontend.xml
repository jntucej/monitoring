<file path="src/app/(approver)/vice-principal/analytics/page.tsx">
"use client";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { BarChart3, ScrollText, CheckCircle2, XCircle, Clock } from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";

interface AnalyticsRow {
  id: string;
  ticket_number: string;
  workflow_type: string;
  current_stage: string;
  status: string;
  updated_at?: string | null;
  student?: { name: string } | null;
}

interface PermissionsResponse {
  success: boolean;
  data: AnalyticsRow[];
  total?: number;
}

const STAGE_LABELS: Record<string, string> = {
  oie: "OIE",
  exam_branch: "Exam Branch",
  vice_principal: "Vice Principal",
  principal: "Principal",
  hod: "HOD",
};

function VpAnalyticsInner() {
  const {
    data: approved,
    loading,
    error,
    refresh: refreshApproved,
  } = useApiResource<PermissionsResponse>(
    "/api/permissions?status=APPROVED&workflow_type=exam",
    { ttlMs: 60_000 }
  );

  const refresh = useCallback(async () => {
    clearCache();
    await refreshApproved();
  }, [refreshApproved]);

  usePolling(refresh, { intervalMs: 60_000, enabled: true });

  const rows: AnalyticsRow[] = (approved?.data ?? []) as AnalyticsRow[];
  const total = approved?.total ?? rows.length;

  // Aggregate: by-stage counts and by-status counts across the exam-approval set.
  const byStage = rows.reduce<Record<string, number>>((acc, r) => {
    const k = r.current_stage || "unknown";
    acc[k] = (acc[k] || 0) + 1;
    return acc;
  }, {});
  const byStatus = rows.reduce<Record<string, number>>((acc, r) => {
    const k = r.status || "unknown";
    acc[k] = (acc[k] || 0) + 1;
    return acc;
  }, {});

  return (
    <div className="mx-auto max-w-7xl space-y-5 px-4 py-6 md:px-6 min-w-0">
      <ContextSituationBar
        roleLabel="Vice Principal"
        purpose="Executive analytics dashboard tracking approval velocities, SLA adherence, and transit volumes"
        why="Approval velocity and SLA telemetry reveal departmental bottlenecks before they impact student schedules or campus operations."
        contextLabel="Vice Principal Analytics"
        statusSummary="High-level operational metrics across academic departments, gate operations, and approval chains."
        primaryAction={{ label: "Decision History", href: "/vice-principal/decision-history" }}
        secondaryAction={{ label: "Department Performance", href: "/vice-principal/department-performance" }}
      />
      <WidgetBoundary title="VP Analytics">
        <div className="surface-card bg-bg-base p-4 min-w-0">
          <div className="flex flex-wrap items-center gap-2 text-text-muted mb-4 min-w-0">
            <BarChart3 className="w-4 h-4 shrink-0" />
            <span className="text-xs font-semibold uppercase tracking-wide">
              Exam Approvals — Analytics
            </span>
            <span className="ml-auto text-xs text-text-muted">{total} approved</span>
          </div>

          {error && (
            <div className="surface-card mb-3 bg-amber-500/10 p-3 text-xs text-action-warning">
              Analytics unavailable: {error}
            </div>
          )}

          {loading && !approved ? (
            <div className="space-y-2 min-w-0">
              {[0, 1, 2].map((i) => (
                <div key={i} className="h-12 rounded-lg bg-bg-elevated/60 animate-pulse" />
              ))}
            </div>
          ) : (
            <div className="grid gap-4 md:grid-cols-3 min-w-0">
              {/* By stage */}
              <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                <div className="flex items-center gap-2 mb-2 text-xs text-text-muted">
                  <ScrollText className="w-3.5 h-3.5" /> By stage
                </div>
                {Object.keys(byStage).length === 0 ? (
                  <p className="text-xs text-text-muted">No stage data.</p>
                ) : (
                  <ul className="space-y-1.5">
                    {Object.entries(byStage)
                      .sort((a, b) => b[1] - a[1])
                      .map(([stage, n]) => (
                        <li key={stage} className="flex items-center justify-between text-xs">
                          <span className="text-text-secondary">{STAGE_LABELS[stage] || stage}</span>
                          <span className="font-mono text-action-info">{n}</span>
                        </li>
                      ))}
                  </ul>
                )}
              </div>

              {/* By status */}
              <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                <div className="flex items-center gap-2 mb-2 text-xs text-text-muted">
                  <CheckCircle2 className="w-3.5 h-3.5" /> By status
                </div>
                {Object.keys(byStatus).length === 0 ? (
                  <p className="text-xs text-text-muted">No status data.</p>
                ) : (
                  <ul className="space-y-1.5">
                    {Object.entries(byStatus)
                      .sort((a, b) => b[1] - a[1])
                      .map(([status, n]) => (
                        <li key={status} className="flex items-center justify-between text-xs">
                          <span className="text-text-secondary capitalize">{status}</span>
                          <span className="font-mono text-action-info">{n}</span>
                        </li>
                      ))}
                  </ul>
                )}
              </div>

              {/* Recent approved tickets */}
              <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
                <div className="flex items-center gap-2 mb-2 text-xs text-text-muted">
                  <Clock className="w-3.5 h-3.5" /> Recent tickets
                </div>
                {rows.length === 0 ? (
                  <div className="flex items-center gap-2 text-xs text-text-muted">
                    <XCircle className="w-3.5 h-3.5" /> No approved exam tickets yet.
                  </div>
                ) : (
                  <ul className="space-y-1.5">
                    {rows
                      .slice()
                      .sort((a, b) => {
                        const ta = a.updated_at ? new Date(a.updated_at).getTime() : 0;
                        const tb = b.updated_at ? new Date(b.updated_at).getTime() : 0;
                        return tb - ta;
                      })
                      .slice(0, 5)
                      .map((r) => (
                        <li key={r.id} className="flex items-center justify-between text-xs gap-2">
                          <span className="font-mono text-action-info truncate">{r.ticket_number}</span>
                          <span className="text-text-muted truncate">{r.student?.name || "—"}</span>
                        </li>
                      ))}
                  </ul>
                )}
              </div>
            </div>
          )}
        </div>
      </WidgetBoundary>
    </div>
  );
}

export default function VpAnalyticsPage() {
  return (
    <AuthGuard allowedRoles={["vice_principal", "exam_branch", "oie", "principal", "admin", "sysadmin"]}>
      <Suspense fallback={<PageLoading />}>
        <VpAnalyticsInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

