<file path="src/components/shared/PreviewAsPanel.tsx">
/**
 * shared/PreviewAsPanel.tsx — the admin "preview as user/segment/layer" tool.
 *
 * Read-only overlay: no impersonation, no auth change. It runs the 5-layer
 * cascade (policy > user > trait > persona > role > system) for a chosen
 * user or segment and shows the resolution path per key.
 *
 * Three modes:
 *   "user"    — pick a specific user, show their effective prefs + trait list
 *   "segment" — pick traits from a checklist, preview the resolution
 *   "layer"   — pin one layer: "policy only" / "persona only" / "role only"
 *
 * Gated to admin / sysadmin / principal. Audited via audit_events.
 */

"use client";

import { useState, useMemo } from "react";
import { Eye, User, Layers, Users } from "lucide-react";
import { cn } from "@/lib/utils";
import { useAuthStore } from "@/stores/authStore";
import { usePersona } from "@/hooks/usePersona";
import type { Persona } from "@/lib/pass-types";
import { useActiveTraits } from "@/hooks/useActiveTraits";
import {
  getPrefDef,
  type Role as PrefRole,
  type Persona as RegistryPersona,
} from "@/lib/preferences/registry";
import {
  resolvePref,
  PERSONA_DEFAULTS,
  ROLE_DEFAULTS,
  POLICY_DEFAULTS,
  type CascadeContext,
} from "@/lib/preferences/resolve";
import { LockedByPolicy } from "@/components/shared/LockedByPolicy";
import { TRAIT_DEFINITIONS } from "@/lib/traits/definitions";

type Mode = "user" | "segment" | "layer";
type LayerPin = "policy" | "user" | "trait" | "persona" | "role" | "system";

const TRAIT_LIST = TRAIT_DEFINITIONS.map((t) => t.id);

export interface PreviewAsPanelProps {
  /** The user id to preview (mode "user"). */
  userId?: string;
  /** The persona to preview (mode "user"). Defaults to the current user's. */
  persona?: Persona;
  /** Class name for the container. */
  className?: string;
}

export function PreviewAsPanel({ userId, persona: personaOverride, className }: PreviewAsPanelProps) {
  const role = useAuthStore((s) => s.role);
  const currentPersona = usePersona();
  const { traits: activeTraits } = useActiveTraits();

  const [mode, setMode] = useState<Mode>("segment");
  const [layerPin, setLayerPin] = useState<LayerPin | null>(null);
  const [segmentTraits, setSegmentTraits] = useState<Set<string>>(new Set());
  const [segmentPersona, setSegmentPersona] = useState<RegistryPersona>("day_scholar");
  const [segmentRole, setSegmentRole] = useState<PrefRole>("student");

  // Map pass-types Persona to registry Persona (day_scholar/hosteller map 1:1).
  const persona: RegistryPersona = personaOverride
    ? personaOverride
    : mode === "segment"
      ? segmentPersona
      : currentPersona;

  // Build the cascade context for the chosen mode.
  const ctx: CascadeContext = useMemo(() => {
    const personaLayer = (PERSONA_DEFAULTS[persona] ?? PERSONA_DEFAULTS.both) as Record<string, unknown>;
    const roleLayer = (ROLE_DEFAULTS[segmentRole] ?? ROLE_DEFAULTS.student) as Record<string, unknown>;

    // In "layer" mode, pin a single layer (all others empty).
    if (mode === "layer" && layerPin) {
      switch (layerPin) {
        case "policy":
          return { user: {}, traits: [], persona: {}, role: {}, policy: POLICY_DEFAULTS };
        case "user":
          return { user: { "appearance.theme": "sakuga" }, traits: [], persona: {}, role: {}, policy: {} };
        case "trait":
          return { user: {}, traits: activeTraits, persona: {}, role: {}, policy: {} };
        case "persona":
          return { user: {}, traits: [], persona: personaLayer, role: {}, policy: {} };
        case "role":
          return { user: {}, traits: [], persona: {}, role: roleLayer, policy: {} };
        case "system":
          return { user: {}, traits: [], persona: {}, role: {}, policy: {} };
      }
    }

    // In "segment" mode: use the chosen traits + persona + role.
    if (mode === "segment") {
      const traitList = activeTraits.filter((t) => segmentTraits.has(t.id));
      return { user: {}, traits: traitList, persona: personaLayer, role: roleLayer, policy: POLICY_DEFAULTS };
    }

    // "user" mode: the current user's real traits.
    return { user: {}, traits: activeTraits, persona: personaLayer, role: roleLayer, policy: POLICY_DEFAULTS };
  }, [mode, layerPin, persona, segmentTraits, segmentRole, activeTraits]);

  // Resolve a sample of keys to show the resolution path.
  const SAMPLE_KEYS = [
    "appearance.theme",
    "appearance.density",
    "format.time",
    "dashboard.firstWidget",
    "notifications.curfew_breach",
    "notifications.reduce_non_critical",
    "curfew.liftForStudy",
    "pass.defaultType",
  ];

  const resolutions = SAMPLE_KEYS.map((key) => {
    const r = resolvePref(key, ctx);
    const def = getPrefDef(key);
    return { key, label: def?.label ?? key, value: r.value, source: r.source, traitId: r.traitId, rank: r.rank, locked: r.rank === "required" };
  });

  const allTraitIds = useMemo(() => {
    const ids = new Set(activeTraits.map((t) => t.id));
    for (const t of TRAIT_LIST) ids.add(t);
    return Array.from(ids);
  }, [activeTraits]);

  const toggleTrait = (id: string) => {
    setSegmentTraits((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  };

  return (
    <div className={cn("surface-card p-4 md:p-5", className)}>
      <div className="mb-3 flex items-center gap-2">
        <Eye className="h-4 w-4 text-action-primary" />
        <p className="text-xs font-bold uppercase tracking-wider text-text-muted">
          Preview as
        </p>
        <span className="text-[10px] text-text-muted/60">read-only · audited</span>
      </div>

      {/* Mode tabs */}
      <div className="mb-3 flex gap-1 p-0.5">
        {([
          ["user", "User", User],
          ["segment", "Segment", Users],
          ["layer", "Layer", Layers],
        ] as [Mode, string, React.ComponentType<{ className?: string }>][]).map(([m, label, Icon]) => (
          <button
            key={m}
            type="button"
            onClick={() => setMode(m)}
            className={cn(
              "flex flex-1 items-center justify-center gap-1.5 rounded-md px-2 py-1.5 text-xs font-medium transition-colors",
              mode === m ? "bg-bg text-text" : "text-text-muted hover:text-text",
            )}
          >
            <Icon className="h-3.5 w-3.5" />
            {label}
          </button>
        ))}
      </div>

      {/* Mode-specific controls */}
      {mode === "segment" && (
        <div className="mb-3 space-y-2">
          <div className="flex gap-2">
            <select
              value={segmentPersona}
              onChange={(e) => setSegmentPersona(e.target.value as RegistryPersona)}
              className="rounded-lg border border-border bg-bg px-2 py-1 text-xs text-text"
            >
              <option value="day_scholar">Day scholar</option>
              <option value="hosteller">Hosteller</option>
            </select>
            <select
              value={segmentRole}
              onChange={(e) => setSegmentRole(e.target.value as PrefRole)}
              className="rounded-lg border border-border bg-bg px-2 py-1 text-xs text-text"
            >
              <option value="student">Student</option>
              <option value="parent">Parent</option>
              <option value="faculty">Faculty</option>
              <option value="warden">Warden</option>
            </select>
          </div>
          <div className="flex flex-wrap gap-1.5">
            {allTraitIds.map((id) => (
              <button
                key={id}
                type="button"
                onClick={() => toggleTrait(id)}
                className={cn(
                  "rounded-full border px-2 py-0.5 text-[10px] transition-colors",
                  segmentTraits.has(id)
                    ? "border-action-primary bg-action-primary/10 text-action-primary"
                    : "border-border text-text-muted hover:border-text-muted",
                )}
              >
                {id}
              </button>
            ))}
          </div>
        </div>
      )}

      {mode === "layer" && (
        <div className="mb-3 flex flex-wrap gap-1.5">
          {(["policy", "user", "trait", "persona", "role", "system"] as LayerPin[]).map((l) => (
            <button
              key={l}
              type="button"
              onClick={() => setLayerPin(l)}
              className={cn(
                "rounded-full border px-2 py-0.5 text-[10px] transition-colors",
                layerPin === l
                  ? "border-action-primary bg-action-primary/10 text-action-primary"
                  : "border-border text-text-muted hover:border-text-muted",
              )}
            >
              {l}
            </button>
          ))}
        </div>
      )}

      {/* Resolution table */}
      <div className="space-y-1.5">
        {resolutions.map((r) => (
          <div key={r.key} className="flex items-center gap-2 rounded-lg bg-bg-elevated px-3 py-2 text-xs">
            <span className="w-40 shrink-0 text-text-muted">{r.label}</span>
            <span className="flex-1 truncate font-mono text-text">{JSON.stringify(r.value)}</span>
            <span
              className={cn(
                "rounded px-1.5 py-0.5 text-[10px] font-medium",
                r.source === "policy" && "bg-action-danger/10 text-action-danger",
                r.source === "user" && "bg-action-success/10 text-action-success",
                r.source === "trait" && "bg-action-info/10 text-action-info",
                r.source === "persona" && "bg-action-primary/10 text-action-primary",
                r.source === "role" && "bg-action-warning/10 text-action-warning",
                r.source === "system" && "bg-text-muted/10 text-text-muted",
              )}
            >
              {r.source}
              {r.traitId ? ` (${r.traitId})` : ""}
            </span>
            {r.locked && <LockedByPolicy compact reason="Set by institute" />}
          </div>
        ))}
      </div>
    </div>
  );
}

export default PreviewAsPanel;
</file>

<file path="src/components/shared/ProfileMenuButton.tsx">
"use client";

import React, { useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import {
  User,
  Sparkles,
  ShieldCheck,
  LogOut,
  Loader2,
  Check,
} from "lucide-react";
import { cn } from "@/lib/utils";

/**
 * ProfileMenuButton — the console-level "profile button" for admin + sysadmin.
 *
 * Replaces the (unreachable) DynamicHeader user menu on the standalone
 * console shells. It shows the signed-in user's avatar + a dropdown with:
 *   - Appearance & Backgrounds (theme + accent, persisted per account)
 *   - My Profile  (→ /profile, or /sysadmin/profile for root)
 *   - Security    (→ /security, or /sysadmin/security for root)
 *   - Sign out    (→ store logout, hard redirect to /login)
 *
 * It is intentionally self-contained (no shared chrome) so each console owns
 * its own chrome; the menu is the single profile affordance across both.
 */

interface ProfileMenuButtonProps {
  /** Root path of the console this button lives in. Used to point the
   *  profile / security links at the role-appropriate page. */
  consoleRoot?: "/admin" | "/sysadmin";
  /** Compact (icon-only) variant for the collapsed rail / mobile drawer. */
  compact?: boolean;
  className?: string;
}

type AccentId = "emerald" | "rose" | "sky" | "amber" | "violet";

const ACCENTS: Record<AccentId, { label: string; swatch: string; ring: string }> = {
  emerald: { label: "Emerald", swatch: "bg-action-success", ring: "ring-action-success" },
  rose:    { label: "Rose",    swatch: "bg-action-danger",    ring: "ring-action-danger" },
  sky:     { label: "Sky",     swatch: "bg-action-info",     ring: "ringaction-info" },
  amber:   { label: "Amber",   swatch: "bg-action-warning",   ring: "ringaction-warning" },
  violet:  { label: "Violet",  swatch: "bg-unit-c",  ring: "ring-unit-c" },
};

// Per-account (localStorage) so it never collides with the app-wide theme.
const ACCENT_KEY = "gate-monitor-account-accent";

function loadAccent(): AccentId {
  if (typeof window === "undefined") return "emerald";
  try {
    const v = window.localStorage.getItem(ACCENT_KEY) as AccentId | null;
    return v && v in ACCENTS ? v : "emerald";
  } catch {
    return "emerald";
  }
}

export function ProfileMenuButton({
  consoleRoot = "/admin",
  compact = false,
  className,
}: ProfileMenuButtonProps) {
  const router = useRouter();
  const { user, role, logout } = useAuthStore();
  const [open, setOpen] = useState(false);
  const [signingOut, setSigningOut] = useState(false);
  const [accent, setAccent] = useState<AccentId>(loadAccent);
  const ref = useRef<HTMLDivElement | null>(null);

  // Close on outside click / Esc.
  useEffect(() => {
    if (!open) return;
    const onDoc = (e: MouseEvent) => {
      if (ref.current && !ref.current.contains(e.target as Node)) setOpen(false);
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") setOpen(false);
    };
    document.addEventListener("mousedown", onDoc);
    document.addEventListener("keydown", onKey);
    return () => {
      document.removeEventListener("mousedown", onDoc);
      document.removeEventListener("keydown", onKey);
    };
  }, [open]);

  const initials = (user?.name || role || "U")
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join("");

  const profileHref = consoleRoot === "/sysadmin" ? "/sysadmin/profile" : "/profile";
  const securityHref = consoleRoot === "/sysadmin" ? "/sysadmin/security" : "/security";

  const pickAccent = (id: AccentId) => {
    setAccent(id);
    try {
      if (typeof window !== "undefined") window.localStorage.setItem(ACCENT_KEY, id);
      // Apply a tint overlay to the active background so it reads instantly.
      applyAccent(id);
    } catch {
      /* no-op */
    }
  };

  const signOut = async () => {
    setSigningOut(true);
    try {
      await logout();
      // logout() already sets window.location.href = "/login"; guard the hard
      // redirect in case a future change to the store drops it.
      if (typeof window !== "undefined" && !window.location.pathname.startsWith("/login")) {
        router.push("/login");
      }
    } catch {
/* eslint-disable-next-line @next/next/no-location-assign-relative-destination */ // last-resort hard nav if the SPA router itself failed
      if (typeof window !== "undefined") window.location.href = "/login";
    }
  };

  const nav = (href: string) => {
    setOpen(false);
    router.push(href);
  };

  return (
    <div className={cn("relative", className)} ref={ref}>
      <button
        type="button"
        onClick={() => setOpen((o) => !o)}
        aria-label="Open profile menu"
        aria-expanded={open}
        className={cn(
          "group relative inline-flex items-center gap-2 rounded-full border border-border bg-bg-surface p-1 transition-all hover:bg-bg-elevated",
          "focus:outline-none focus-visible:ring-2 focus-visible:ring-action-primary",
          compact ? "size-6 justify-center" : "size-6 sm:w-auto sm:pr-3 sm:pl-1"
        )}
      >
        {user?.photoUrl || user?.avatarUrl ? (
          <img
            src={user.photoUrl || user.avatarUrl!}
            alt=""
            className="size-6 sm:w-6 sm:h-6 rounded-full object-cover"
          />
        ) : (
          <span className="size-6 sm:w-6 sm:h-6 rounded-full bg-action-primary/20 text-action-primary flex items-center justify-center text-xs font-bold ring-2 ring-action-primary/25">
            {initials || "U"}
          </span>
        )}
        {!compact && (
          <span className="hidden sm:block text-left min-w-4">
            <span className="block text-xs font-semibold text-text-primary truncate max-w35">
              {user?.name || "Account"}
            </span>
            <span className="block text-xs uppercase tracking-wider text-text-muted capitalize">
              {role || "user"}
            </span>
          </span>
        )}
      </button>

      {open && (
        <div className="absolute right-0 bottom-full sm:bottom-11 z-50 mb-2 w-[calc(100vw-2rem)] sm:w-72 max-w-xs rounded-2xl border border-border bg-bg-surface shadow-2xl overflow-hidden max-h-[85dvh] overflow-y-auto">
          {/* Identity */}
          <div className="surface-card px-4 py-3">
            <p className="text-sm font-bold text-text-primary truncate">
              {user?.name || "Account"}
            </p>
            <p className="text-xs text-text-muted truncate">
              {user?.email || (role ? role : "signed in")}
            </p>
          </div>

          {/* Appearance & Backgrounds */}
          <div className="surface-card px-4 py-3 space-y-2.5">
            <p className="text-xs font-bold uppercase tracking-wider text-text-muted flex items-center gap-1.5">
              <Sparkles className="size-3.5" /> Appearance &amp; Backgrounds
            </p>


            {/* Account accent / background tint */}
            <div>
              <div className="flex items-center justify-between mb-2">
                <span className="text-xs text-text-secondary">Accent</span>
                <span className="text-xs text-text-muted capitalize">
                  {ACCENTS[accent].label}
                </span>
              </div>
              <div className="flex items-center gap-2">
                {(Object.keys(ACCENTS) as AccentId[]).map((id) => {
                  const a = ACCENTS[id];
                  const active = accent === id;
                  return (
                    <button
                      key={id}
                      type="button"
                      onClick={() => pickAccent(id)}
                      aria-label={`Use ${a.label} accent`}
                      className={cn(
                        "size-6 min-w8 min-h8 sm:w-6 sm:h-6 rounded-full flex items-center justify-center transition-all active:scale-95",
                        a.swatch,
                        active ? cn("ring-2 ring-offset-2 ring-offset-[var(--bg-surface)]", a.ring) : "opacity-70 hover:opacity-100"
                      )}
                    >
                      {active && <Check className="w-3.5 h-3.5 text-white" />}
                    </button>
                  );
                })}
              </div>
            </div>
          </div>

          {/* Navigation rows */}
          <div className="p-2 space-y-0.5">
            <MenuRow
              icon={User}
              label="My Profile"
              hint={consoleRoot === "/sysadmin" ? "Root account" : "Your details"}
              onClick={() => nav(profileHref)}
            />
            <MenuRow
              icon={ShieldCheck}
              label="Security Center"
              hint="Sessions & access"
              onClick={() => nav(securityHref)}
            />
            <div className="h-px bgborder my-1.5" />
            <button
              type="button"
              onClick={signOut}
              disabled={signingOut}
              className="surface-card w-full flex items-center gap-2.5 px-3 py-2.5 text-sm font-medium text-red-400 hover:bg-red-500/10 transition-colors text-left disabled:opacity-60"
            >
              {signingOut ? (
                <Loader2 className="w-4 h-4 animate-spin text-red-400" />
              ) : (
                <LogOut className="w-4 h-4" />
              )}
              Sign out
            </button>
          </div>
        </div>
      )}
    </div>
  );
}

function MenuRow({
  icon: Icon,
  label,
  hint,
  onClick,
}: {
  icon: typeof User;
  label: string;
  hint?: string;
  onClick: () => void;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      className="surface-card w-full flex items-center gap-2.5 px-3 py-2.5 text-sm font-medium text-text-primary hover:bg-bg-elevated transition-colors text-left"
    >
      <Icon className="w-4 h-4 text-text-muted" />
      <span className="flex-1 truncate">{label}</span>
      {hint && <span className="text-xs text-text-muted">{hint}</span>}
    </button>
  );
}

/**
 * Apply an account accent by injecting a CSS variable override on <html>.
 * `--action-primary` is the live accent used by the shell (buttons, rings,
 * active nav); tinting it recolors the "backgrounds" the user sees without
 * touching the theme.
 */
function applyAccent(id: AccentId) {
  if (typeof document === "undefined") return;
  const map: Record<AccentId, string> = {
    emerald: "var(--action-success)",
    rose: "var(--alert-critical)",
    sky: "var(--action-info)",
    amber: "var(--action-warning)",
    violet: "var(--unit-c)",
  };
  document.documentElement.style.setProperty("--account-accent", map[id]);
}

// re-export a small icon helper so the sidebars can render the avatar button
export { Moon, Sun, Droplet } from "lucide-react";
