      )}

      {tab === "workers" && (
        <div className="p-4">
          Worker job heartbeats: see{" "}
          <a href="/sysadmin/jobs" className="text-primary underline">
            /sysadmin/jobs
          </a>{" "}
          for the full dead-man&apos;s-switch view.
        </div>
      )}
    </div>
  );
}
