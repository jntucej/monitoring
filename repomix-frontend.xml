<file path="src/app/(approver)/oie/access-exceptions/page.tsx">
"use client";

import { Suspense, useCallback, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

import { PageLoading, TableSkeleton } from "@/components/shared/LoadingStates";
import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { buildOieAccessExceptionInspection } from "@/lib/role-registers/oieInspections";
import {
  ArrowRight,
  ShieldOff,
  AlertTriangle,
  Inbox,
  FileWarning,
} from "lucide-react";
import {
  KVPairs,
  ActionRow,
  InspectorButton,
  type EntityInspection,
} from "@/components/shared/EntityInspector";
import {
  ApproverStageDrawer,
  type StagePivotItem,
} from "@/components/nav/level2/ApproverStageDrawer";

function StatusBadge({ status }: { status: string }) {
  const styles: Record<string, string> = {
    PENDING: "border-amber-400/30 bg-amber-400/10 text-action-warning",
    REJECTED: "border-rose-400/30 bg-rose-400/10 text-action-danger",
    ESCALATED: "border-purple-400/30 bg-purple-400/10 text-unit-c",
    APPROVED: "border-emerald-400/30 bg-emerald-400/10 text-action-success",
  };
  const cls = styles[status] ?? "border-border/30 bg-bg-elevated/10 text-text-muted";
  return (
    <span
      className={`inline-block px-2 py-0.5 rounded-full text-xs font-medium border whitespace-nowrap ${cls}`}
    >
      {status}
    </span>
  );
}

function StatusBadgeTone({ text, tone }: { text: string; tone?: "ok" | "warn" | "danger" | "neutral" }) {
  const cls: Record<string, string> = {
    ok: "bg-emerald-500/10 text-action-success border border-emerald-500/20",
    warn: "bg-amber-500/10 text-action-warning border border-amber-500/20",
    danger: "bg-rose-500/10 text-action-danger border border-rose-500/20",
    neutral: "bg-bg-elevated text-text-muted border border-border",
  };
  const t = tone ?? "neutral";
  return (
    <span className={`px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase ${cls[t]}`}>
      {text}
    </span>
  );
}

/** Build an EntityInspection for an exam access-exception record. */
function buildAccessExceptionInspection(r: AccessExceptionRow): EntityInspection {
  const slaBreached = r.sla_deadline
    ? new Date(r.sla_deadline).getTime() < Date.now()
    : false;
  const statusTone: "ok" | "warn" | "danger" | "neutral" =
    r.status === "APPROVED" ? "ok"
    : r.status === "REJECTED" ? "danger"
    : slaBreached ? "danger"
    : r.status === "ESCALATED" ? "warn"
    : "neutral";

  const sections: EntityInspection["sections"] = [
    {
      title: "Overview",
      content: (
        <KVPairs
          items={[
            { label: "Candidate", value: r.candidate_name ?? "—" },
            { label: "Roll", value: r.roll ?? r.candidate_unique_id ?? "—" },
            { label: "Ticket", value: <code className="font-mono">{r.ticket_number}</code> },
            { label: "Stage", value: r.current_stage?.replace(/_/g, " ") ?? "—" },
            { label: "Created", value: r.created_at ? new Date(r.created_at).toLocaleString() : "—" },
            { label: "SLA", value: r.sla_deadline ? (slaBreached ? "BREACHED" : new Date(r.sla_deadline).toLocaleString()) : "—" },
          ]}
        />
      ),
    },
    {
      title: "Actions",
      content: (
        <ActionRow>
          <InspectorButton href="/oie/access-exceptions" variant="ghost">
            All exceptions
          </InspectorButton>
          <InspectorButton href={`/permissions/${r.ticket_number}`} variant="primary">
            View ticket
          </InspectorButton>
        </ActionRow>
      ),
    },
  ];

  return {
    kind: "exam_case",
    title: r.candidate_name ?? r.ticket_number,
    subtitle: r.ticket_number,
    status: <StatusBadgeTone text={r.status} tone={statusTone} />,
    sections,
    detailHref: `/permissions/${r.ticket_number}`,
    detailLabel: "Full ticket",
  };
}

interface AccessExceptionRow {
  id: string;
  ticket_number: string;
  workflow_type: string;
  current_stage: string;
  status: string;
  sla_deadline?: string | null;
  created_at?: string;
  updated_at?: string;
  candidate_name?: string | null;
  candidate_unique_id?: string | null;
  roll?: string | null;
}

interface AccessExceptionsResponse {
  success: boolean;
  data: AccessExceptionRow[];
  total?: number;
}

function EmptyState({ message }: { message: string }) {
  return (
    <div className="surface-card bg-bg-base p-8 text-center min-w-0">
      <div className="flex flex-col items-center gap-2">
        <Inbox className="w-5 h-5 text-text-muted" />
        <p className="max-w-md text-sm text-text-muted">{message}</p>
      </div>
    </div>
  );
}

function ErrorBanner({ message, onRetry }: { message: string; onRetry: () => void }) {
  return (
    <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
      <span className="flex items-center gap-2 min-w-0">
        <AlertTriangle className="w-4 h-4 shrink-0" />
        <span className="truncate">{message}</span>
      </span>
      <button
        type="button"
        onClick={onRetry}
        className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
      >
        Retry
      </button>
    </div>
  );
}

function ExceptionTable({
  rows,
  onInspect,
}: {
  rows: AccessExceptionRow[];
  onInspect: (r: AccessExceptionRow) => void;
}) {
  if (rows.length === 0) {
    return (
      <EmptyState message="No access exceptions found. All exam-day access requests are in good standing." />
    );
  }
  return (
    <div className="overflow-x-auto min-w-0">
      <table className="w-full text-sm min-w160">
        <thead>
          <tr className="border-b border-border text-text-muted text-xs uppercase tracking-wide">
            <th className="text-left px-4 py-3">Ticket</th>
            <th className="text-left px-4 py-3">Candidate</th>
            <th className="text-left px-4 py-3">Stage</th>
            <th className="text-left px-4 py-3">Status</th>
            <th className="text-left px-4 py-3">SLA</th>
          </tr>
        </thead>
        <tbody className="divide-y divide-slate-800/60">
          {rows.slice(0, 20).map((r) => (
            <tr
              key={r.id}
              onClick={() => onInspect(r)}
              onKeyDown={(e) => {
                if (e.key === "Enter" || e.key === " ") {
                  e.preventDefault();
                  onInspect(r);
                }
              }}
              tabIndex={0}
              role="button"
              aria-label={`Inspect access exception ticket ${r.ticket_number}`}
              className="hover:bg-bg-elevated/30 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary"
            >
              <td className="px-4 py-3">
                <a
                  href={`/permissions/${r.ticket_number}`}
                  onClick={(e) => e.stopPropagation()}
                  className="text-white font-mono text-xs whitespace-nowrap hover:text-action-success"
                >
                  {r.ticket_number}
                </a>
              </td>
              <td className="px-4 py-3 text-text-secondary min-w-0">
                {r.candidate_name || "—"}
                {r.roll ? <span className="ml-2 text-xs text-text-muted">{r.roll}</span> : null}
              </td>
              <td className="px-4 py-3 text-text-muted capitalize whitespace-nowrap">
                {r.current_stage?.replace(/_/g, " ")}
              </td>
              <td className="px-4 py-3">
                <StatusBadge status={r.status} />
              </td>
              <td className="px-4 py-3 text-text-muted text-xs whitespace-nowrap">
                {r.sla_deadline ? (
                  new Date(r.sla_deadline).getTime() < Date.now() ? (
                    <span className="text-action-danger">
                      Breached · {new Date(r.sla_deadline).toLocaleString()}
                    </span>
                  ) : (
                    new Date(r.sla_deadline).toLocaleString()
                  )
                ) : (
                  "—"
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

function AccessExceptionsInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "oie") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();
  const [stageItem, setStageItem] = useState<StagePivotItem | null>(null);

  const {
    data,
    loading,
    error,
    refresh: refreshExceptions,
  } = useApiResource<AccessExceptionsResponse>("/api/exam/access-exceptions", {
    ttlMs: 30_000,
  });

  const refresh = useCallback(async () => {
    clearCache();
    await refreshExceptions();
  }, [refreshExceptions]);

  usePolling(refresh, { intervalMs: 30_000, enabled: !!user });

  const rows = data?.data ?? [];
  const breachedCount = rows.filter((r) => {
    if (!r.sla_deadline) return false;
    const ts = new Date(r.sla_deadline).getTime();
    return !Number.isNaN(ts) && ts < Date.now();
  }).length;

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      <Link
        href="/oie"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Overview
      </Link>

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Officer In-Charge of Examinations"
        purpose="Adjudicate exam-day access exceptions, candidate disqualifications, and hall discrepancies."
        why="Resolving exam access exceptions ensures legitimate candidates are not improperly blocked at exam hall gates."
        contextLabel="Access Exceptions"
        statusTone={rows.length > 0 ? "warn" : "ok"}
        statusPill={rows.length > 0 ? `${rows.length} exceptions` : "No exceptions"}
        statusSummary={
          rows.length > 0
            ? `${rows.length} candidate access exception${rows.length === 1 ? "" : "s"} logged requiring urgent resolution.`
            : "No open candidate access exceptions."
        }
        primaryAction={{ label: "Day Access", href: "/oie/examination-day-access" }}
        secondaryActions={[
          { label: "OIE Overview", href: "/oie" },
          { label: "Pending Queue", href: "/oie/queue/pending" },
        ]}
      />

      {error && (
        <ErrorBanner
          message={`Access exceptions failed to load: ${error}`}
          onRetry={() => void refreshExceptions()}
        />
      )}

      {/* KPI strip */}
      <WidgetBoundary title="Access Exception KPIs">
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 min-w-0">
          <div className="surface-card bg-bg-base p-4 min-w-0">
            <div className="flex items-center gap-2 text-text-muted text-xs font-semibold uppercase tracking-wide">
              <FileWarning className="w-4 h-4 shrink-0" />
              <span>Exceptions</span>
            </div>
            <p className="text-2xl font-bold text-action-warning mt-2">{rows.length}</p>
          </div>
          <div className="surface-card bg-bg-base p-4 min-w-0">
            <div className="flex items-center gap-2 text-text-muted text-xs font-semibold uppercase tracking-wide">
              <AlertTriangle className="w-4 h-4 shrink-0" />
              <span>SLA Breached</span>
            </div>
            <p className="text-2xl font-bold text-action-danger mt-2">{breachedCount}</p>
          </div>
          <div className="surface-card bg-bg-base p-4 min-w-0">
            <div className="flex items-center gap-2 text-text-muted text-xs font-semibold uppercase tracking-wide">
              <ShieldOff className="w-4 h-4 shrink-0" />
              <span>Rejected</span>
            </div>
            <p className="text-2xl font-bold text-white mt-2">
              {rows.filter((r) => r.status === "REJECTED").length}
            </p>
          </div>
          <div className="surface-card bg-bg-base p-4 min-w-0">
            <div className="flex items-center gap-2 text-text-muted text-xs font-semibold uppercase tracking-wide">
              <Inbox className="w-4 h-4 shrink-0" />
              <span>Escala</span>
            </div>
            <p className="text-2xl font-bold text-action-info mt-2">
              {rows.filter((r) => r.status === "ESCALATED").length}
            </p>
          </div>
        </div>
      </WidgetBoundary>

      <WidgetBoundary title="Exam Access Exceptions">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex items-center gap-2 min-w-0">
            <ShieldOff className="w-4 h-4 text-action-warning shrink-0" />
            <span className="text-sm font-semibold text-white truncate">
              Rejected &amp; Escalated Exam Access Requests
            </span>
          </div>
          {loading ? (
            <div className="p-4">
              <TableSkeleton rows={4} />
            </div>
          ) : (
            <ExceptionTable
              rows={rows}
              onInspect={(r) => {
                inspect(buildOieAccessExceptionInspection(r));
                setStageItem({
                  ticketId: r.id,
                  ticketNumber: r.ticket_number,
                  workflowType: r.workflow_type,
                  currentStage: r.current_stage,
                  status: r.status,
                  studentName: r.candidate_name ?? undefined,
                  studentRoll: r.roll ?? undefined,
                  stages: ["student", "oie", "exam_branch", "vice_principal"],
                });
              }}
            />
          )}
          <div className="surface-card px-4 py-3 text-xs text-text-muted min-w-0">
            Exceptions are surfaced for OIE review only. Resolution is handled by the
            relevant exam-branch or hod office.
          </div>
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel
        inspection={inspection}
        onClose={() => {
          closeInspection();
          setStageItem(null);
        }}
      />
      <ApproverStageDrawer item={stageItem} onClose={() => setStageItem(null)} />
    </div>
  );
}
export default function AccessExceptionsPage() {
  return (
    <AuthGuard allowedRoles={['oie', 'exam_branch', 'exam_superintendent', 'vice_principal', 'principal', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <AccessExceptionsInner />
      </Suspense>
    </AuthGuard>
  );
}
