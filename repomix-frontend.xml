"use client";

import { Suspense, useCallback, lazy } from "react";
import Link from "next/link";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { PageHeader } from "@/components/admin/shared/PageHeader";
import { useAuthStore } from "@/stores/authStore";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { SecurityManagement } from "@/components/sysadmin/SecurityManagement";

const SysadminMonthlyReviewPanel = lazy(
  () => import("@/components/sysadmin/SysadminMonthlyReviewPanel")
);
import {
  ShieldCheck,
  KeyRound,
  Lock,
  ArrowUpRight,
  AlertTriangle,
} from "lucide-react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface SecHealth {
  status?: string;
  redis?: { status: string };
  database?: { status: string; latencyMs?: number };
  gateways?: { status: string; online?: number; offline?: number; total?: number };
}

const QUICK_LINKS: Array<{
  href: string;
  Icon: typeof ShieldCheck;
  title: string;
  sub: string;
}> = [
  {
    href: "/sysadmin/roles",
    Icon: ShieldCheck,
    title: "Roles & Permissions",
    sub: "Role registry, hierarchy graph, and page-access matrix",
  },
  {
    href: "/sysadmin/access-keys",
    Icon: KeyRound,
    title: "Access Keys",
    sub: "One-time enrollment codes for students, parents and staff",
  },
  {
    href: "/sysadmin/sessions",
    Icon: Lock,
    title: "Active Sessions",
    sub: "Live bearer tokens, revoke-by-device, global sign-out",
  },
];

function SecurityReinforcedInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "sysadmin") as Role;

  const { data, loading, error, refresh } = useApiResource<
    { success: boolean; data: SecHealth }
  >("/api/sysadmin/services", { ttlMs: 30_000 });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;
  const posture = (data as { success: boolean; data: SecHealth } | null)?.data;

  const statusClass = (s?: string) =>
    s === "healthy"
      ? "bg-emerald-500/20 text-action-success"
      : s === "degraded"
        ? "bg-amber-500/20 text-action-warning"
        : s === "unhealthy"
          ? "bg-rose-500/20 text-action-danger"
          : "bg-bg-elevated/40 text-text-muted";

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-4 md:py-6 min-w-0">
      <ContextSituationBar
        roleLabel="System Admin"
        purpose="Zero-trust posture: identity, keys, sessions and service health"
        why="This page is the first place to check when a security incident is suspected on the portal."
        contextLabel="Zero-trust posture: identity, keys, sessions and service health"
        statusSummary="Review current zero-trust posture: identity, keys, sessions and service health state and take action below."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "System Health", href: "/sysadmin/health" }}
      />
      <PageHeader
        title="Infrastructure Security"
        subtitle="Zero-trust posture: identity, keys, sessions and service health"
        onRefresh={refreshAll}
        refreshing={loading && data != null}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-amber-700 flex items-center gap-2">
          <AlertTriangle className="w-4 h-4 shrink-0" />
          Posture data unavailable: {error}
        </div>
      )}

      <WidgetBoundary title="Security Posture">
        <div className="surface-card bg-bg-surface p-4 min-w-0">
          <div className="flex items-center justify-between mb-3">
            <div className="flex items-center gap-2">
              <ShieldCheck className="w-4 h-4 text-action-success" />
              <span className="text-xs font-semibold uppercase tracking-wide text-text-muted">
                Live posture
              </span>
            </div>
            <span className="text-xs text-text-muted">
              signed in as <span className="font-mono text-text-secondary">{role}</span>
            </span>
          </div>

          {busy ? (
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
              {Array.from({ length: 4 }).map((_, i) => (
                <div
                  key={i}
                  className="h-16 bg-bg-elevated animate-pulse"
                />
              ))}
            </div>
          ) : (
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 min-w-0">
              <div className="surface-card bg-bg-elevated p-3 min-w-0">
                <p className="text-xs uppercase text-text-muted">Overall</p>
                <p className="mt-1">
                  <span className={`text-xs font-bold px-2 py-0.5`}>
                    {posture?.status ?? "unknown"}
                  </span>
                </p>
              </div>
              <div className="surface-card bg-bg-elevated p-3 min-w-0">
                <p className="text-xs uppercase text-text-muted">Redis</p>
                <p className="mt-1">
                  <span className={`text-xs font-bold px-2 py-0.5`}>
                    {posture?.redis?.status ?? "unknown"}
                  </span>
                </p>
              </div>
              <div className="surface-card bg-bg-elevated p-3 min-w-0">
                <p className="text-xs uppercase text-text-muted">Database</p>
                <p className="mt-1">
                  <span className={`text-xs font-bold px-2 py-0.5`}>
                    {posture?.database?.status ?? "unknown"}
                  </span>
                </p>
                {typeof posture?.database?.latencyMs === "number" && (
                  <p className="text-xs text-text-muted mt-1 tabular-nums">
                    {posture.database.latencyMs} ms
                  </p>
                )}
              </div>
              <div className="surface-card bg-bg-elevated p-3 min-w-0">
                <p className="text-xs uppercase text-text-muted">Gateways</p>
                <p className="mt-1">
                  <span className={`text-xs font-bold px-2 py-0.5`}>
                    {posture?.gateways?.status ?? "unknown"}
                  </span>
                </p>
                {typeof posture?.gateways?.online === "number" && (
                  <p className="text-xs text-text-muted mt-1 tabular-nums">
                    {posture.gateways.online} online · {posture.gateways.offline ?? 0} offline
                  </p>
                )}
              </div>
            </div>
          )}
        </div>
      </WidgetBoundary>

      <WidgetBoundary title="Security tools">
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 min-w-0">
          {QUICK_LINKS.map(({ href, Icon, title, sub }) => (
            <Link
              key={href}
              href={href}
              className="surface-card bg-bg-surface p-4 min-w-0 hover:bg-bg-elevated transition-colors group"
            >
              <div className="flex items-center gap-2 text-text-secondary min-w-0">
                <Icon className="w-4 h-4 shrink-0" />
                <span className="text-xs font-semibold uppercase tracking-wide truncate">
                  {title}
                </span>
                <ArrowUpRight className="w-3.5 h-3.5 ml-auto text-text-muted group-hover:text-action-primary transition-colors" />
              </div>
              <p className="mt-2 text-xs text-text-muted">{sub}</p>
            </Link>
          ))}
        </div>
      </WidgetBoundary>

      <WidgetBoundary title="Security operations">
        <SecurityManagement />
      </WidgetBoundary>

      <Suspense fallback={null}>
        <SysadminMonthlyReviewPanel />
      </Suspense>

    </div>
  );
}

export default function SysadminSecurityPage() {
  return (
    <AuthGuard allowedRoles={["sysadmin"]}>
      <Suspense fallback={<PageLoading />}>
        <SecurityReinforcedInner />
      </Suspense>
    </AuthGuard>
  );
}
