<file path="src/components/operator/drawer/OperatorDrawer.tsx">
"use client";

import { useState, useCallback, useEffect } from "react";
import { usePathname, useRouter } from "next/navigation";
import { X, Home, FileText, Wrench, User, LogOut } from "lucide-react";
import { motion, AnimatePresence } from "framer-motion";
import { cn } from "@/lib/utils";
import { DrawerCategory } from "./DrawerCategory";
import { useOperatorGate } from "@/hooks/useOperatorGate";
import type { LucideIcon } from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { useBreakpoint } from "@/hooks/useBreakpoint";

export interface DrawerCategoryItem {
  href: string;
  label: string;
  icon: LucideIcon;
  active?: boolean;
}

export interface DrawerCategoryDef {
  id: string;
  label: string;
  icon?: LucideIcon;
  items: DrawerCategoryItem[];
}

const CATEGORIES: DrawerCategoryDef[] = [
  {
    id: "scan",
    label: "SCAN",
    icon: Home,
    items: [
      { href: "/operator", label: "Gate Desk", icon: Home },
      { href: "/operator/manual-entry", label: "Manual Entry", icon: Home },
      { href: "/operator/pass-verification", label: "Pass Verification", icon: Home },
    ],
  },
  {
    id: "review",
    label: "REVIEW",
    icon: FileText,
    items: [
      { href: "/operator/transactions", label: "Transactions", icon: FileText },
      { href: "/operator/exceptions", label: "Exceptions", icon: FileText },
    ],
  },
  {
    id: "tools",
    label: "TOOLS",
    icon: Wrench,
    items: [
      { href: "/operator/mode", label: "Mode", icon: Wrench },
      { href: "/operator/announcements", label: "Announcements", icon: Wrench },
      { href: "/operator/lookup", label: "Lookup", icon: Wrench },
    ],
  },
  {
    id: "profile",
    label: "PROFILE",
    icon: User,
    items: [
      { href: "/profile", label: "Profile", icon: User },
      { href: "/settings/password", label: "Password", icon: User },
      { href: "/settings/notifications", label: "Notifications", icon: User },
    ],
  },
];

interface OperatorDrawerProps {
  open: boolean;
  onClose: () => void;
  /** True when showing a side rail (tablet/desktop), false for mobile bottom drawer. */
  isRail?: boolean;
}

export function OperatorDrawer({ open, onClose, isRail = false }: OperatorDrawerProps) {
  const pathname = usePathname();
  const router = useRouter();
  const { role, assigned } = useOperatorGate();
  const { md: isDesktop } = useBreakpoint({ md: "(min-width: 768px)" });
  const user = useAuthStore((s) => s.user);
  const logout = useAuthStore((s) => s.logout);

  // Track which category is expanded (only one at a time)
  const [expandedCategory, setExpandedCategory] = useState<string | null>("scan");

  // Close drawer on navigation
  useEffect(() => {
    if (!isRail) {
      onClose();
    }
  }, [pathname, isRail, onClose]);

  const handleToggle = useCallback((categoryId: string) => {
    setExpandedCategory((prev) => (prev === categoryId ? null : categoryId));
  }, []);

  const handleLogout = useCallback(() => {
    logout();
    router.push("/login/operator");
  }, [logout, router]);

  // Check if any item in a category is active
  const getCategoryActive = useCallback(
    (category: DrawerCategoryDef) => {
      return category.items.some((item) => {
        return pathname === item.href || pathname?.startsWith(item.href + "/");
      });
    },
    [pathname]
  );

  // Desktop/tablet rail: always open when assigned
  if (!assigned && role !== "worker") {
    return null;
  }

  // Mobile: bottom sheet drawer
  if (!isRail && !isDesktop) {
    return (
      <AnimatePresence>
        {open && (
          <>
            {/* Backdrop */}
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              className="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm"
              onClick={onClose}
              aria-hidden="true"
            />
            
            {/* Bottom drawer */}
            <motion.div
              initial={{ y: "100%" }}
              animate={{ y: 0 }}
              exit={{ y: "100%" }}
              transition={{ type: "spring", damping: 25, stiffness: 200 }}
              className="fixed inset-x-0 bottom-0 z-50 bg-bg-surface border-t border-border rounded-t-2xl shadow-2xl max-h-[80dvh] flex flex-col"
              role="dialog"
              aria-modal="true"
              aria-label="Navigation drawer"
            >
              {/* Handle bar */}
              <div className="flex justify-center pt-3 pb-2">
                <div className="w-6 h-1.5 rounded-full bg-bg-elevated" />
              </div>

              {/* Header */}
              <div className="surface-card flex items-center justify-between px-4 py-3">
                <div className="flex items-center gap-2">
                  <Home className="w-5 h-5 text-action-primary" />
                  <span className="text-sm font-bold text-text-primary">
                    {user?.name || "Operator"}
                  </span>
                </div>
                <button
                  type="button"
                  onClick={onClose}
                  className="size-6 rounded-lg flex items-center justify-center text-text-muted hover:text-text-primary hover:bg-bg-elevated"
                  aria-label="Close menu"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>

              {/* Categories */}
              <div className="flex-1 overflow-y-auto overscroll-contain">
                {CATEGORIES.map((category) => (
                  <DrawerCategory
                    key={category.id}
                    category={category}
                    isOpen={expandedCategory === category.id}
                    onToggle={() => handleToggle(category.id)}
                  />
                ))}
              </div>

              {/* Logout */}
              <div className="surface-card p-4">
                <button
                  type="button"
                  onClick={handleLogout}
                  className="surface-card w-full flex items-center justify-center gap-2 py-3 bg-rose-500/10 text-action-danger hover:bg-rose-500/20 font-semibold text-sm transition-colors"
                >
                  <LogOut className="w-5 h-5" />
                  Sign Out
                </button>
              </div>
            </motion.div>
          </>
        )}
      </AnimatePresence>
    );
  }

  // Tablet/Desktop: left rail
  return (
    <aside
      className={cn(
        "hidden md:flex flex-col w-56 lg:w-64 h-full bg-bg-surface border-r border-border",
        "fixed left-0 top-0 z-40"
      )}
      role="navigation"
      aria-label="Operator navigation"
    >
      {/* Rail header */}
      <div className="surface-card flex items-center gap-2 px-4 py-4">
        <Home className="w-5 h-5 text-action-primary" />
        <span className="text-sm font-bold text-text-primary">
          Gate Monitor
        </span>
      </div>

      {/* User info */}
      <div className="surface-card px-4 py-3">
        <div className="flex items-center gap-2">
          <div className="size-6 rounded-full bg-action-primary/20 text-action-primary flex items-center justify-center text-xs font-bold">
            {user?.name?.charAt(0)?.toUpperCase() || "O"}
          </div>
          <div className="min-w-5">
            <p className="text-xs font-semibold text-text-primary truncate">
              {user?.name || "Operator"}
            </p>
            <p className="text-xs text-text-muted truncate">
              {user?.gateId
                ? /^[0-9a-f]{8}-[0-9a-f]{4}-/i.test(user.gateId)
                  ? "Gate assigned"
                  : `Gate ${user.gateId}`
                : "No gate assigned"}
            </p>
          </div>
        </div>
      </div>

      {/* Categories */}
      <div className="flex-1 overflow-y-auto overscroll-contain">
        {CATEGORIES.map((category) => (
          <DrawerCategory
            key={category.id}
            category={{
              ...category,
              items: category.items.map((item) => ({
                ...item,
                active: pathname === item.href || pathname?.startsWith(item.href + "/"),
              })),
            }}
            isOpen={getCategoryActive(category) || expandedCategory === category.id}
            onToggle={() => handleToggle(category.id)}
          />
        ))}
      </div>

      {/* Logout */}
      <div className="surface-card p-3">
        <button
          type="button"
          onClick={handleLogout}
          className="surface-card w-full flex items-center gap-2 px-3 py-2 text-xs font-medium text-text-muted hover:text-action-danger hover:bg-rose-500/10 transition-colors"
        >
          <LogOut className="w-5 h-5" />
          Sign Out
        </button>
      </div>
    </aside>
  );
}
</file>

<file path="src/components/operator/profile/OperatorChangePassword.tsx">
"use client";

// src/components/operator/profile/OperatorChangePassword.tsx
// Operator-specific copy of @/components/shared/ChangePasswordCard

import { useState } from "react";
import { useRouter } from "next/navigation";
import { Lock, KeyRound, Eye, EyeOff, Loader2, CheckCircle2, AlertCircle } from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { useApi } from "@/hooks/useApi";

export function OperatorChangePasswordCard() {
  const api = useApi();
  const mustChangePassword = useAuthStore((s) => s.mustChangePassword);
  const setMustChangePassword = useAuthStore((s) => s.setMustChangePassword);
  const router = useRouter();
  const logout = useAuthStore((s) => s.logout);

  const [current, setCurrent] = useState("");
  const [next, setNext] = useState("");
  const [confirm, setConfirm] = useState("");
  const [showCurrent, setShowCurrent] = useState(false);
  const [showNext, setShowNext] = useState(false);
  const [showConfirm, setShowConfirm] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState(false);

  const validate = (): string | null => {
    if (!current || !next || !confirm) return "All fields are required.";
    if (next.length < 8) return "New password must be at least 8 characters.";
    if (next.length > 128) return "New password must be at most 128 characters.";
    if (next !== confirm) return "New passwords do not match.";
    if (next === current) return "New password must be different from current password.";
    return null;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);

    const localError = validate();
    if (localError) {
      setError(localError);
      return;
    }

    setSubmitting(true);
    try {
      const res = await fetch("/api/auth/change-password", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          ...api.getHeaders(),
        },
        body: JSON.stringify({
          currentPassword: current,
          newPassword: next,
        }),
      });

      // Session invalidation may land as 401 — treat success only for 2xx.
      const payload = await res.json().catch(() => ({}));

      if (!res.ok) {
        if (res.status === 401 && !payload?.error) {
          setError("Session expired. Please sign in again.");
        } else {
          setError(payload?.error || "Could not change password.");
        }
        return;
      }

      setSuccess(true);
      setCurrent("");
      setNext("");
      setConfirm("");
      // The rotation just cleared the server-side password_must_change flag;
      // clear the client-side copy so the redirect target is the normal
      // dashboard (or login page) instead of the forced-change flow again.
      setMustChangePassword(false);

      // Server bumped session_version → every token is now stale.
      // Give the user a moment to read the confirmation, then sign out.
      setTimeout(async () => {
        await logout();
        router.replace("/login?changed=1");
      }, 1800);
    } catch {
      setError("Network error. Please try again.");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="surface-card bg-bg-surface p-6">
      {mustChangePassword && !success && (
        <div className="surface-card mb-4 flex items-start gap-2 bg-amber-500/10 p-3 text-xs text-action-warning">
          <AlertCircle className="mt-0.5 h-4 w-4 shrink-0" />
          <div>
            <p className="font-semibold">A temporary password was set for your account.</p>
            <p className="mt-0.5 text-amber-700/80">
              You must choose a new password now — the one an administrator or the
              enrollment process set for you is valid until you replace it.
            </p>
          </div>
        </div>
      )}
      <div className="flex items-center gap-3 mb-5">
        <div className="surface-card p-2 bg-action-primary/10">
          <KeyRound className="w-5 h-5 text-action-primary" />
        </div>
        <div>
          <h3 className="text-lg font-semibold text-text-primary">Change password</h3>
          <p className="text-sm text-text-muted">
            You will be signed out of all devices after this change.
          </p>
        </div>
      </div>

      {success ? (
        <div className="surface-card flex items-start gap-3 bg-emerald-500/10 p-4">
          <CheckCircle2 className="w-5 h-5 text-action-success mt-0.5" />
          <div>
            <p className="text-sm font-medium text-action-success dark:text-action-success">
              Password changed successfully.
            </p>
            <p className="text-xs text-emerald-700/80 dark:text-emerald-700/80 mt-1">
              Signing you out…
            </p>
          </div>
        </div>
      ) : (
        <form onSubmit={handleSubmit} className="space-y-4">
          <OperatorPasswordField
            label="Current password"
            value={current}
            onChange={setCurrent}
            show={showCurrent}
            onToggle={() => setShowCurrent((v) => !v)}
            autoComplete="current-password"
          />
          <OperatorPasswordField
            label="New password"
            value={next}
            onChange={setNext}
            show={showNext}
            onToggle={() => setShowNext((v) => !v)}
            autoComplete="new-password"
            hint="At least 8 characters."
          />
          <OperatorPasswordField
            label="Confirm new password"
            value={confirm}
            onChange={setConfirm}
            show={showConfirm}
            onToggle={() => setShowConfirm((v) => !v)}
            autoComplete="new-password"
          />

          {error && (
            <div className="surface-card flex items-start gap-2 bg-rose-500/10 p-3">
              <AlertCircle className="w-4 h-4 text-action-danger mt-0.5 flex-shrink-0" />
              <p className="text-sm text-action-danger dark:text-action-danger">{error}</p>
            </div>
          )}

          <button
            type="submit"
            disabled={submitting}
            className="surface-card w-full inline-flex items-center justify-center gap-2 bg-action-primary px-4 py-2.5 text-sm font-medium text-white hover:opacity-90 disabled:opacity-60 transition"
          >
            {submitting ? (
              <>
                <Loader2 className="w-4 h-4 animate-spin" />
                Updating…
              </>
            ) : (
              <>
                <Lock className="w-4 h-4" />
                Update password
              </>
            )}
          </button>
        </form>
      )}
    </div>
  );
}

interface OperatorPasswordFieldProps {
  label: string;
  value: string;
  onChange: (v: string) => void;
  show: boolean;
  onToggle: () => void;
  autoComplete: string;
  hint?: string;
}

function OperatorPasswordField({
  label, value, onChange, show, onToggle, autoComplete, hint,
}: OperatorPasswordFieldProps) {
  return (
    <label className="block">
      <span className="block text-sm font-medium text-text-secondary mb-1.5">
        {label}
      </span>
      <div className="relative">
        <input
          type={show ? "text" : "password"}
          value={value}
          onChange={(e) => onChange(e.target.value)}
          autoComplete={autoComplete}
          className="surface-card w-full bg-bg-base px-3 py-2.5 pr-10 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-action-primary/40"
        />
        <button
          type="button"
          onClick={onToggle}
          aria-label={show ? "Hide password" : "Show password"}
          className="absolute inset-y-0 right-2 flex items-center px-2 text-text-muted hover:text-text-primary"
        >
          {show ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
        </button>
      </div>
      {hint && <p className="text-xs text-text-muted mt-1">{hint}</p>}
    </label>
  );
}
