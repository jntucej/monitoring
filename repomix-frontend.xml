<file path="src/app/(admin)/admin/sessions/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {LogOut, Loader2, MonitorSmartphone}  from "lucide-react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { ConfirmDialog } from "@/components/admin/shared/ConfirmDialog";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { useAuthStore } from "@/stores/authStore";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface SessionRow {
  sessionId: string;
  userId: string;
  name: string;
  email: string | null;
  role: string;
  status: string;
  lastActive: string;
  ipAddress: string | null;
  userAgent: string | null;
}

async function fetchSessions(): Promise<SessionRow[]> {
  const res = await fetch("/api/admin/sessions", { headers: getAuthHeaders() });
  const body = await res.json();
  return (body?.data ?? []) as SessionRow[];
}

/**
 * Admin Sessions — live active-session monitor + force-revoke.
 * Backend: /api/admin/sessions (admin|sysadmin scope).
 */
function AdminSessionsInner() {
  const [rows, setRows] = useState<SessionRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState<string | null>(null);
  const [revokeTarget, setRevokeTarget] = useState<SessionRow | null>(null);
  const addToast = useUIStore((s) => s.addToast);
  const user = useAuthStore((s) => s.user);

  const load = useCallback(async () => {
    setLoading(true);
    try { setRows(await fetchSessions()); }
    catch (e) { console.error("sessions", e); }
    finally { setLoading(false); }
  }, []);

  useEffect(() => { load(); }, [load]);

  const revoke = async (sessionId: string) => {
    setRevokeTarget(null);
    setBusy(sessionId);
    try {
      const res = await fetch(`/api/admin/sessions/${sessionId}`, {
        method: "DELETE",
        headers: getAuthHeaders(),
      });
      if (!res.ok) {
        const msg =
          res.status === 403
            ? "Session revoke requires sysadmin access — this action was not performed."
            : `Revoke failed (HTTP ${res.status}).`;
        addToast({ variant: "error", title: "Revoke failed", message: msg });
        return;
      }
      addToast({ variant: "success", title: "Session revoked", message: `Revoked for ${user?.name ?? "user"}.` });
      load();
    } catch (e) {
      console.error("revoke", e);
      addToast({ variant: "error", title: "Revoke failed", message: "Network error." });
    } finally {
      setBusy(null);
    }
  };

  if (loading) {
    return (
      <div className="space-y-4 p-4 md:p-6">
        <Skeleton className="h-10 w-48" />
        <Skeleton className="h-72 rounded-2xl" />
      </div>
    );
  }

  const staleCount = rows.filter((r) => {
    const ts = new Date(r.lastActive).getTime();
    return !Number.isNaN(ts) && Date.now() - ts > 24 * 60 * 60 * 1000;
  }).length;

  return (
    <div className="space-y-6 p-4 md:p-6">
      <PageHeader
        title="Active Sessions"
        subtitle="Live JWT / refresh-token sessions — revoke any that look off"
        onRefresh={load}
      />
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Monitor live JWT and refresh-token sessions and revoke stale or suspicious access."
        why="Revoking a session here signs that device out immediately and logs the action to the audit trail."
        contextLabel="Active Sessions"
        statusTone={staleCount > 0 ? "warn" : "ok"}
        statusPill={staleCount > 0 ? `${staleCount} stale (>24h)` : `${rows.length} active`}
        statusSummary={
          staleCount > 0
            ? `${rows.length} active sessions (${staleCount} inactive for over 24 hours). Review and revoke any unexpected devices.`
            : `${rows.length} active session${rows.length === 1 ? "" : "s"} currently live.`
        }
        primaryAction={{ label: "Refresh Sessions", onClick: () => void load() }}
        secondaryAction={{ label: "Audit Logs", href: "/admin/audit-logs" }}
      />

      <WidgetBoundary title="Session list">
        <div className="glass-card">
          <div className="surface-card p-4">
            <p className="text-sm font-semibold flex items-center gap-2">
              <MonitorSmartphone className="w-4 h-4 text-action-primary" />
              {rows.length} active session{rows.length === 1 ? "" : "s"}
            </p>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-xs text-text-muted border-b border-border">
                  <th className="p-3 text-left">User</th>
                  <th className="p-3 text-left">Role</th>
                  <th className="p-3 text-left">Last active</th>
                  <th className="p-3 text-left">IP</th>
                  <th className="p-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {rows.length === 0 && (
                  <tr><td colSpan={5} className="p-6 text-center text-text-muted">No active sessions.</td></tr>
                )}
                {rows.map((r) => (
                  <tr key={r.sessionId} className="hover:bg-bg-elevated/40">
                    <td className="p-3">
                      <p className="text-text-primary font-medium">{r.name}</p>
                      <p className="text-xs text-text-muted font-mono">{r.email}</p>
                    </td>
                    <td className="p-3">
                      <span className="surface-card px-2 py-0.5 text-xs bg-bg-elevated text-text-muted capitalize">{r.role}</span>
                    </td>
                    <td className="p-3 text-xs text-text-muted">
                      {r.lastActive ? new Date(r.lastActive).toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" }) : "—"}
                    </td>
                    <td className="p-3 font-mono text-xs text-text-muted">{r.ipAddress ?? "—"}</td>
                    <td className="p-3 text-right">
                      <button
                        onClick={() => setRevokeTarget(r)}
                        disabled={busy === r.sessionId}
                        className="surface-card inline-flex items-center gap-1.5 text-xs font-semibold text-action-danger px-2.5 py-1.5 hover:bg-action-danger/10 disabled:opacity-50"
                      >
                        {busy === r.sessionId ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <LogOut className="w-3.5 h-3.5" />}
                        Revoke
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </WidgetBoundary>

      <ConfirmDialog
        open={revokeTarget !== null}
        onClose={() => setRevokeTarget(null)}
        title="Revoke session?"
        body={revokeTarget ? `Force-revoke ${revokeTarget.name} (${revokeTarget.email ?? "unknown"})? The user will be signed out on their next API call.` : ""}
        confirmText="Revoke"
        variant="destructive"
        onConfirm={() => { void revoke(revokeTarget?.sessionId ?? ""); }}
      />
    </div>
  );
}

export default function AdminSessionsPage() {
  return (
    
      <AdminSessionsInner />
    
    

  );
}
</file>

