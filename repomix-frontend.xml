type Point = { name: string; entries: number; exits: number };

function fmtDay(d: Date): string {
  return d.toLocaleDateString("en-IN", { weekday: "short" });
}

// Lazy-load recharts bundle via next/dynamic with ssr: false
const DynamicRechartsBar = dynamic(
  () =>
    import("recharts").then((mod) => {
      const { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, Legend } = mod;
      return function RechartsContent({ data }: { data: Point[] }) {
        return (
          <ResponsiveContainer width="100%" height="85%">
            <BarChart data={data} margin={{ top: 5, right: 20, left: -10, bottom: 5 }}>
              <XAxis dataKey="name" stroke="var(--text-muted)" fontSize={12} tickLine={false} axisLine={false} />
              <YAxis stroke="var(--text-muted)" fontSize={12} tickLine={false} axisLine={false} />
              <Tooltip
                contentStyle={{
                  backgroundColor: "var(--bg-elevated)",
                  borderColor: "var(--border)",
                  color: "var(--text-primary)",
                }}
              />
              <Legend iconSize={10} />
              <Bar dataKey="entries" fill="var(--action-primary)" radius={[4, 4, 0, 0]} />
              <Bar dataKey="exits" fill="var(--action-danger)" radius={[4, 4, 0, 0]} />
            </BarChart>
          </ResponsiveContainer>
        );
      };
    }),
  {
    ssr: false,
    loading: () => (
      <div className="h-[80%] flex items-center justify-center text-text-muted text-sm">
        Loading chart…
      </div>
    ),
  }
);

/**
 * Renders the last 7 days of entry/exit activity pulled from /api/gate/logs.
 * Lazy-loaded via next/dynamic (ssr: false) and IntersectionObserver when visible.
 */
export function EntryExitChart() {
  const [data, setData] = useState<Point[]>([]);
  const [loading, setLoading] = useState(true);
  const [isVisible, setIsVisible] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);

  // IntersectionObserver to defer mounting until visible in viewport
  useEffect(() => {
    if (!containerRef.current) return;
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setIsVisible(true);
          observer.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(containerRef.current);
    return () => observer.disconnect();
  }, []);

  const load = useCallback(async () => {
      try {
        const today = new Date();
        const start = new Date(today);
        start.setDate(today.getDate() - 6);
        const startStr = start.toISOString().slice(0, 10);
        const endStr = today.toISOString().slice(0, 10);

        const res = await fetch(
          `/api/gate/logs?from=${startStr}&to=${endStr}&limit=1000`,
          { headers: getAuthHeaders(), cache: "no-store" }
        );
        const json = await res.json();

        const buckets: Record<string, { entries: number; exits: number }> = {};
        for (let i = 0; i < 7; i++) {
          const d = new Date(start);
          d.setDate(start.getDate() + i);
          buckets[d.toISOString().slice(0, 10)] = { entries: 0, exits: 0 };
        }

        const items: any[] = json?.data?.logs ?? json?.data?.items ?? json?.items ?? [];
        for (const it of items) {
          const day = (it.timestamp ?? "").slice(0, 10);
          if (!buckets[day]) continue;
          if (it.direction === "IN") buckets[day].entries++;
          else if (it.direction === "OUT") buckets[day].exits++;
        }

        const points: Point[] = Object.entries(buckets).map(([day, v]) => ({
          name: fmtDay(new Date(day)),
          entries: v.entries,
          exits: v.exits,
        }));

        setData(points);
        setLoading(false);
      } catch {
        setLoading(false);
      }
    },
    []);

  // Initial load when visible + visibility-aware polling (no raw setInterval)
  useEffect(() => {
    if (!isVisible) return;
    load();
  }, [isVisible, load]);
  usePolling(load, { intervalMs: 60_000, enabled: isVisible });

  return (
    <div ref={containerRef} className="surface-card bg-bg-surface p-6 h-96">
      <h3 className="font-semibold mb-4">Weekly Entry/Exit</h3>
      {!isVisible || loading ? (
        <div className="h-[80%] flex items-center justify-center text-text-muted text-sm">
          Loading…
        </div>
      ) : (
        <DynamicRechartsBar data={data} />
      )}
    </div>
  );
}
</file>

<file path="src/components/admin/ExitReasonsManager.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  ScrollText,
  Plus,
  Trash2,
  Pencil,
  Loader2,
  CheckCircle2,
  AlertCircle,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { ConfirmDialog } from "@/components/admin/shared/ConfirmDialog";

interface ExitReason {
  code: string;
  name: string;
  description: string;
  applicableTo: string[];
  requiresApproval: boolean;
  approvalBy: string;
  parentNotification: string;
  maxDurationHours: number | null;
  is_active: boolean;
}

interface Props {
  initialReasons: ExitReason[];
  onChanged: () => void;
}

const APPROVAL_TARGETS = ["none", "principal", "admin", "sysadmin"];
const NOTIFICATION_OPTIONS = ["silent", "sms", "email", "both"];
const APPLICABLE_OPTIONS = ["student", "faculty", "staff", "worker", "visitor"];

export function ExitReasonsManager({ initialReasons, onChanged }: Props) {
  const [reasons, setReasons] = useState<ExitReason[]>(initialReasons);
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState<{ type: "success" | "error"; text: string } | null>(null);

  // form state for create / edit
  const [formOpen, setFormOpen] = useState(false);
  const [editingIndex, setEditingIndex] = useState<number | null>(null);
  const [form, setForm] = useState<ExitReason | null>(null);

  // delete confirmation
  const [deleteTarget, setDeleteTarget] = useState<ExitReason | null>(null);

  useEffect(() => {
    setReasons(initialReasons);
  }, [initialReasons]);

  const openCreate = () => {
    setEditingIndex(null);
    setForm({
      code: "",
      name: "",
      description: "",
      applicableTo: ["student"],
      requiresApproval: false,
      approvalBy: "none",
      parentNotification: "silent",
      maxDurationHours: null,
      is_active: true,
    });
    setFormOpen(true);
  };

  const openEdit = (index: number) => {
    setEditingIndex(index);
    setForm({ ...reasons[index] });
    setFormOpen(true);
  };

  const updateField = (key: keyof ExitReason, value: any) =>
    setForm((prev) => (prev ? { ...prev, [key]: value } : prev));

  const toggleApplicable = (opt: string) => {
    setForm((prev) => {
      if (!prev) return prev;
      const current = prev.applicableTo || [];
      return {
        ...prev,
        applicableTo: current.includes(opt)
          ? current.filter((x) => x !== opt)
          : [...current, opt],
      };
    });
  };

  const saveForm = async () => {
    if (!form) return;
    if (!form.code.trim() || !form.name.trim()) {
      setMessage({ type: "error", text: "Code and Name are required." });
      return;
    }
    setLoading(true);
    setMessage(null);

    const payload = {
      code: form.code,
      name: form.name,
      description: form.description,
      applicableTo: form.applicableTo,
      requiresApproval: form.requiresApproval,
      approvalBy: form.approvalBy,
      parentNotification: form.parentNotification,
      maxDurationHours: form.maxDurationHours,
    };

    try {
      const method = editingIndex === null ? "POST" : "PATCH";
      const res = await fetch("/api/config/exit-reasons", {
        method,
        headers: getAuthHeaders(),
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (json.success) {
        setMessage({ type: "success", text: editingIndex === null ? "Exit reason created." : "Exit reason updated." });
        setFormOpen(false);
        setForm(null);
        onChanged();
      } else {
        setMessage({ type: "error", text: json.error?.message || "Failed to save exit reason." });
      }
    } catch {
      setMessage({ type: "error", text: "An error occurred while saving." });
    } finally {
      setLoading(false);
    }
  };

  const confirmDelete = async () => {
    if (!deleteTarget) return;
    setLoading(true);
    setMessage(null);
    try {
      const res = await fetch(
        `/api/config/exit-reasons?code=${encodeURIComponent(deleteTarget.code)}`,
        { method: "DELETE", headers: getAuthHeaders() }
      );
      const json = await res.json();
      if (json.success) {
        setMessage({ type: "success", text: `Deleted ${deleteTarget.name}.` });
        onChanged();
      } else {
        setMessage({ type: "error", text: json.error?.message || "Failed to delete." });
      }
    } catch {
      setMessage({ type: "error", text: "An error occurred while deleting." });
    } finally {
      setLoading(false);
      setDeleteTarget(null);
    }
  };

  const inputCls =
    "w-full px-3 py-2 bg-bg-base border border-border rounded-lg text-sm text-text-primary";

  return (
    <div className="surface-card bg-bg-surface p-6">
      <div className="flex justify-between items-center mb-4">
        <h3 className="font-semibold flex items-center gap-2 text-text-primary">
          <ScrollText className="w-5 h-5 text-action-warning" />
          Exit Reasons
        </h3>
        <button
          type="button"
          onClick={openCreate}
          className="surface-card text-xs flex items-center gap-1 bg-bg-base px-2 py-1 hover:bg-[var(--bg-surface-hover)] text-text-primary"
        >
          <Plus className="size-3.5" /> Add Reason
        </button>
      </div>

      {reasons.length === 0 ? (
        <p className="text-xs text-text-muted text-center py-4">No exit reasons configured.</p>
      ) : (
        <div className="space-y-2">
          {reasons.map((r, i) => (
            <div
              key={r.code}
              className={`flex items-center justify-between gap-3 p-3 rounded-lg border ${
                r.is_active
                  ? "border-border bg-bg-base"
                  : "border-border bg-bg-base opacity-50"
              }`}
            >
              <div className="min-w-0 flex-1">
                <p className="text-sm font-medium text-text-primary truncate">{r.name}</p>
                <p className="text-xs text-text-muted truncate">
                  {r.description || "No description"}
                </p>
                <p className="text-xs text-text-muted mt-0.5">
                  approval: {r.approvalBy} · notify: {r.parentNotification}
                  {r.maxDurationHours != null && ` · max ${r.maxDurationHours}h`}
                </p>
              </div>
              <div className="flex items-center gap-2 shrink-0">
                <button
                  type="button"
                  onClick={() => openEdit(i)}
                  className="p-1.5 text-text-muted hover:text-action-primary"
                  aria-label="Edit exit reason"
                >
                  <Pencil className="w-4 h-4" />
                </button>
                <button
                  type="button"
                  onClick={() => setDeleteTarget(r)}
                  className="p-1.5 text-action-danger hover:text-action-danger"
                  aria-label="Delete exit reason"
                >
                  <Trash2 className="w-4 h-4" />
                </button>
              </div>
            </div>
          ))}
        </div>
      )}

      {message && (
        <div
          className={`flex items-center gap-2 text-sm font-medium mt-3 ${
            message.type === "success" ? "text-action-success" : "text-action-danger"
          }`}
        >
          {message.type === "success" ? (
            <CheckCircle2 className="w-4 h-4" />
          ) : (
            <AlertCircle className="w-4 h-4" />
          )}
          {message.text}
        </div>
      )}

      {/* Create / Edit modal */}
      {formOpen && form && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
          <div className="surface-card relative w-full max-w-lg bg-bg-surface p-6">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-text-primary">
                {editingIndex === null ? "New Exit Reason" : "Edit Exit Reason"}
              </h3>
              <button
                type="button"
                onClick={() => setFormOpen(false)}
                className="text-text-muted hover:text-text-primary"
              >
                ✕
              </button>
            </div>

            <div className="space-y-4">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs text-text-muted mb-1" htmlFor="code">Code *</label>
                  <input id="code"
                    type="text"
                    value={form.code}
                    onChange={(e) => updateField("code", e.target.value)}
                    className={inputCls}
                    disabled={editingIndex !== null}
                  />
                </div>
                <div>
                  <label className="block text-xs text-text-muted mb-1" htmlFor="name">Name *</label>
                  <input id="name"
                    type="text"
                    value={form.name}
                    onChange={(e) => updateField("name", e.target.value)}
                    className={inputCls}
                  />
                </div>
              </div>

              <div>
                <label className="block text-xs text-text-muted mb-1" htmlFor="description">Description</label>
                <textarea id="description"
                  value={form.description}
                  onChange={(e) => updateField("description", e.target.value)}
                  className={`${inputCls} min-h15`}
                />
              </div>

              <div>
                <label className="block text-xs text-text-muted mb-2">Applicable To</label>
                <div className="flex flex-wrap gap-3">
                  {APPLICABLE_OPTIONS.map((opt) => (
                    <label key={opt} className="text-xs flex items-center gap-1 text-text-primary">
                      <input
                        type="checkbox"
                        checked={(form.applicableTo || []).includes(opt)}
                        onChange={() => toggleApplicable(opt)}
                        className="accent-[var(--action-primary)]"
                      />
                      {opt}
                    </label>
                  ))}
                </div>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs text-text-muted mb-1" htmlFor="requires-approval">Requires Approval</label>
                  <select id="requires-approval"
                    value={form.requiresApproval ? "true" : "false"}
                    onChange={(e) => updateField("requiresApproval", e.target.value === "true")}
                    className={inputCls}
                  >
                    <option value="false">No</option>
                    <option value="true">Yes</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs text-text-muted mb-1" htmlFor="approval-by">Approval By</label>
                  <select id="approval-by"
                    value={form.approvalBy}
                    onChange={(e) => updateField("approvalBy", e.target.value)}
                    className={inputCls}
                  >
                    {APPROVAL_TARGETS.map((t) => (
                      <option key={t} value={t}>
                        {t}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="block text-xs text-text-muted mb-1" htmlFor="parent-notification">Parent Notification</label>
                  <select id="parent-notification"
                    value={form.parentNotification}
                    onChange={(e) => updateField("parentNotification", e.target.value)}
                    className={inputCls}
                  >
                    {NOTIFICATION_OPTIONS.map((o) => (
                      <option key={o} value={o}>
                        {o}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="block text-xs text-text-muted mb-1" htmlFor="max-duration-hours">Max Duration (hours)</label>
                  <input id="max-duration-hours"
                    type="number"
                    value={form.maxDurationHours ?? ""}
                    onChange={(e) =>
                      updateField("maxDurationHours", e.target.value === "" ? null : Number(e.target.value))
                    }
                    className={inputCls}
                  />
                </div>
              </div>
            </div>

            <div className="surface-card flex justify-end gap-3 mt-6 pt-4">
              <button
                type="button"
                onClick={() => setFormOpen(false)}
                className="surface-card px-4 py-2 text-sm font-medium text-text-primary hover:bg-bg-elevated transition-colors"
              >
                Cancel
              </button>
              <button
                type="button"
                onClick={() => void saveForm()}
                disabled={loading}
                className="surface-card px-4 py-2 text-sm font-semibold bg-action-primary text-white hover:brightness-110 disabled:opacity-50"
              >
                {loading ? <Loader2 className="w-4 h-4 animate-spin inline" /> : "Save"}
              </button>
            </div>
          </div>
        </div>
      )}

      <ConfirmDialog
        open={!!deleteTarget}
        onClose={() => setDeleteTarget(null)}
        title="Delete Exit Reason"
        body={`Are you sure you want to delete "${deleteTarget?.name}"? This action cannot be undone.`}
        onConfirm={() => void confirmDelete()}
        confirmText="Delete"
      />
    </div>
  );
}
