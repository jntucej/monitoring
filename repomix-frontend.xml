"use client";

import { createContext, useContext, useMemo, useState, ReactNode, useCallback } from "react";

export type ActiveView = "gates" | "analytics" | "logs" | "settings";

interface NavigationState {
  activeView: ActiveView;
  setActiveView: (view: ActiveView) => void;
}

const NavigationContext = createContext<NavigationState | undefined>(undefined);

export function NavigationProvider({ children }: { children: ReactNode }) {
  const [activeView, setActiveViewState] = useState<ActiveView>("gates");

  const setActiveView = useCallback((view: ActiveView) => {
    setActiveViewState(view);
  }, []);

  const value = useMemo(
    () => ({ activeView, setActiveView }),
    [activeView, setActiveView]
  );

  return (
    <NavigationContext.Provider value={value}>
      {children}
    </NavigationContext.Provider>
  );
}

export function useViewNavigation() {
  const context = useContext(NavigationContext);
  if (context === undefined) {
    throw new Error("useViewNavigation must be used within a NavigationProvider");
  }
  return context;
}

/** @deprecated Use useViewNavigation — this name collides with the nav-items hook. */
export const useNavigation = useViewNavigation;

export default NavigationProvider;
</file>

<file path="src/hooks/useActiveTraits.ts">
/**
 * hooks/useActiveTraits.ts — the active traits for the current user.
 *
 * On mount, fetches the user's profile + context and runs the pure
 * `deriveTraits()` kernel. Returns the ActiveTrait[] (sorted by priority)
 * that the resolver (useEffectivePref) consults between the user and
 * persona layers.
 *
 * The derivation is server-trusted: the profile fields come from the auth
 * store (admin-verified), the calendar/roster/weather context is fetched
 * from the API. A trait never self-activates from client state.
 *
 * Tier 1 (hooks) — never forks.
 */

"use client";

import { useEffect, useMemo, useState } from "react";
import { useAuthStore } from "@/stores/authStore";
import { deriveTraits, type DeriveInput, type DeriveContext } from "@/lib/traits/derive";
import type { ActiveTrait } from "@/lib/traits/types";
import { getAuthHeaders } from "@/lib/utils";

export interface ActiveTraitsResult {
  traits: ActiveTrait[];
  /** True while the traits are being derived (first fetch). */
  loading: boolean;
}

/**
 * Derive the active traits for the current user.
 *
 * The profile signals come from the auth store's `user` (the trusted,
 * admin-verified record). The temporal context (calendar, weather, roster,
 * on-call) is fetched from `/api/traits/context` and merged in.
 */
export function useActiveTraits(): ActiveTraitsResult {
  const user = useAuthStore((s) => s.user);
  const role = useAuthStore((s) => s.role) ?? "student";
  const [ctx, setCtx] = useState<DeriveContext | null>(null);
  const [loading, setLoading] = useState(true);

  // Fetch the temporal context (calendar / weather / roster / on-call).
  useEffect(() => {
    let cancelled = false;
    fetch("/api/traits/context", { headers: getAuthHeaders() })
      .then((r) => (r.ok ? r.json() : null))
      .then((d: DeriveContext | null) => {
        if (cancelled || !d) return;
        setCtx(d);
        setLoading(false);
      })
      .catch(() => {
        if (!cancelled) setLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, []);

  // Build the DeriveInput from the auth store's user + the fetched context.
  const input: DeriveInput = useMemo(() => {
    const u = (user ?? {}) as Record<string, unknown>;
    return {
      userId: (u.id as string) ?? "",
      role,
      profile: {
        year: (u.year as number | null) ?? null,
        distanceKm: (u.distanceKm as number | null) ?? null,
        language: (u.language as string | null) ?? null,
        medicalChronic: Boolean(u.medicalChronic),
        medicalCondition: (u.medicalCondition as string | null) ?? null,
        hasSickLeave: Boolean(u.hasSickLeave),
        sportsTeam: (u.sportsTeam as string | null) ?? null,
        placementActive: Boolean(u.placementActive),
        scholarship: Boolean(u.scholarship),
        hireDate: (u.hireDate as string | null) ?? null,
        isHod: Boolean(u.isHod),
        hostelBlock: (u.hostelBlock as string | null) ?? null,
        childCount: (u.childCount as number | null) ?? null,
        working: Boolean(u.working),
        oversightFocus: (u.oversightFocus as "compliance" | "analytics" | null) ?? null,
        techComfort: (u.techComfort as "novice" | "ok" | "expert") ?? null,
        childInExamWeek: Boolean(u.childInExamWeek),
      },
      ctx: ctx ?? { now: new Date() },
    };
  }, [user, role, ctx]);

  // Run the pure derivation. Until the context fetch lands, use the
  // profile-derived traits only (temporal ones activate once ctx arrives).
  const traits = useMemo(() => deriveTraits(input), [input]);

  return { traits, loading };
}

export default useActiveTraits;
</file>

<file path="src/hooks/useAdaptiveContext.ts">
// src/hooks/useAdaptiveContext.ts
//
// useAdaptiveContext() — returns the adaptive context object that
// L4 widgets and RoleHomeComposer consult.
//
//   timeOfDay:   morning | afternoon | evening | night
//   shiftPhase:  pre-shift | on-shift | handover | off
//   examDay:     boolean
//   campusStatus: normal | alert | lockdown

import { useMemo } from "react";

export interface AdaptiveContext {
  timeOfDay: "morning" | "afternoon" | "evening" | "night";
  shiftPhase: "pre-shift" | "on-shift" | "handover" | "off";
  examDay: boolean;
  campusStatus: "normal" | "alert" | "lockdown";
  greeting: string;
}

function getTimeOfDay(): AdaptiveContext["timeOfDay"] {
  const h = new Date().getHours();
  if (h < 12) return "morning";
  if (h < 17) return "afternoon";
  if (h < 21) return "evening";
  return "night";
}

function getGreeting(timeOfDay: AdaptiveContext["timeOfDay"]): string {
  switch (timeOfDay) {
    case "morning": return "morning";
    case "afternoon": return "afternoon";
    case "evening": return "evening";
    case "night": return "night";
  }
}

export function useAdaptiveContext(): AdaptiveContext {
  return useMemo<AdaptiveContext>(() => {
    const timeOfDay = getTimeOfDay();
    return {
      timeOfDay,
      shiftPhase: "on-shift",
      examDay: false,
      campusStatus: "normal",
      greeting: getGreeting(timeOfDay),
    };
  }, []);
}
</file>

<file path="src/hooks/useApi.ts">
"use client";
/**
 * useApi hook — typed wrapper around fetch() that auto-attaches the JWT
 * token from the auth store, handles JSON, and returns typed responses.
 */

import {  useCallback,  useRef , useEffect } from "react";
import { useAuthStore } from "@/stores/authStore";
import { singleFlightRefresh } from "@/lib/auth-refresh";
import type { ApiResponse } from "@/lib/types";

function parseFilename(disposition: string | null): string {
  if (!disposition) return 'download';
  const match = disposition.match(/filename="?([^"]+)"?/);
  return match?.[1] ?? 'download';
}

export function useApi() {
  const { token, logout } = useAuthStore();

  /** Build the auth header map from the current store state (no React hook needed). */
  function getHeaders(): Record<string, string> {
    const headers: Record<string, string> = { "Content-Type": "application/json" };
    const state = useAuthStore.getState();
    if (state.token) headers["Authorization"] = `Bearer ${state.token}`;
    if (state.user?.currentSessionToken) headers["X-Session-Token"] = state.user.currentSessionToken;
    return headers;
  }

  // Stable ref so the `request` callback below (and anything memoized on it,
  // e.g. a page's `refresh`) keeps a constant identity across renders. An
  // unstable `request` made the actions page's useEffect([refresh]) re-fire on
  // every render — an infinite fetch loop that drove /api/sysadmin/* into 429
  // rate-limit storms (120 req/min observed in api_metrics) and left the page
  // stuck on its loading skeleton.
  const tokenRef = useRef(token);
  const logoutRef = useRef(logout);
  useEffect(() => {
    tokenRef.current = token;
    logoutRef.current = logout;
  }, [token, logout]);

  const request = useCallback(
    async <T = unknown>(
      input: string | URL,
      init?: RequestInit
    ): Promise<ApiResponse<T>> => {
    const headers: Record<string, string> = {
      "Content-Type": "application/json",
      ...(init?.headers as Record<string, string>),
    };
    if (tokenRef.current) {
      headers["Authorization"] = `Bearer ${tokenRef.current}`;
    }
    const sessionToken = useAuthStore.getState().user?.currentSessionToken;
    if (sessionToken) {
      headers["X-Session-Token"] = sessionToken;
    }

    let res: Response | null = null;
    let attempts = 0;
    const maxAttempts = 3;

    while (attempts < maxAttempts) {
      attempts++;
      try {
        res = await fetch(input, { ...init, headers });
        if (res.status >= 500 && attempts < maxAttempts) {
          const backoff = 500 * Math.pow(2, attempts - 1) + Math.random() * 200;
          await new Promise((r) => setTimeout(r, backoff));
          continue;
        }
        break;
      } catch (err) {
        if (attempts >= maxAttempts) throw err;
        const backoff = 500 * Math.pow(2, attempts - 1) + Math.random() * 200;
        await new Promise((r) => setTimeout(r, backoff));
      }
    }

    if (!res) {
      return { success: false, error: "Network error" };
    }

    // Handle 401: attempt one single-flight refresh, then retry the request.
    // Only log out if the retry still returns 401 (genuinely expired session).
    if (res.status === 401) {
      try {
        await singleFlightRefresh();
      } catch {
        // refresh itself failed — fall through to logout
      }

      const refreshedToken = useAuthStore.getState().token;
      if (refreshedToken) {
        const retryHeaders: Record<string, string> = {
          "Content-Type": "application/json",
          ...(init?.headers as Record<string, string>),
        };
        retryHeaders["Authorization"] = `Bearer ${refreshedToken}`;
        const st = useAuthStore.getState().user?.currentSessionToken;
        if (st) retryHeaders["X-Session-Token"] = st;

        const retryRes = await fetch(input, { ...init, headers: retryHeaders });
        if (retryRes.status === 401) {
          logoutRef.current();
          if (typeof window !== "undefined") {
            /* eslint-disable-next-line @next/next/no-location-assign-relative-destination */
            window.location.href = "/login";
          }
          throw new Error("UNAUTHORIZED");
        }
        // Retry succeeded — proceed with the new response.
        res = retryRes;
      } else {
        // No refreshed token available — hard logout.
        logoutRef.current();
        if (typeof window !== "undefined") {
          /* eslint-disable-next-line @next/next/no-location-assign-relative-destination */
          window.location.href = "/login";
        }
        throw new Error("UNAUTHORIZED");
      }
    }

    // Handle 304 Not Modified explicitly (Issue issue-558)
    if (res.status === 304) {
      return { success: true, data: undefined };
    }

    const contentType = res.headers.get("content-type") ?? "";

    if (contentType.includes("application/json")) {
      const data = await res.json().catch(() => null);
      if (!res.ok) {
        return {
          success: false,
          error: data?.error?.message ?? `HTTP ${res.status}`,
          code: data?.error?.code,
        };
      }
      return { success: true, data: data as T };
    }

    if (contentType.includes("text/csv")) {
      const blob = await res.blob();
      return {
        success: res.ok,
        data: { blob, filename: parseFilename(res.headers.get("content-disposition")) } as any,
      };
    }

    if (!res.ok) {
        return { success: false, error: `HTTP ${res.status}` };
    }

    // Fallback: return raw text
    const text = await res.text();
    return { success: true, data: text as any };
     
  }, []);

  const get = <T = unknown>(url: string) => request<T>(url, { method: "GET" });
  const post = <T = unknown>(url: string, body: unknown) =>
    request<T>(url, { method: "POST", body: JSON.stringify(body) });
  const put = <T = unknown>(url: string, body: unknown) =>
    request<T>(url, { method: "PUT", body: JSON.stringify(body) });
  const del = <T = unknown>(url: string) => request<T>(url, { method: "DELETE" });

  return { request, get, post, put, del, getHeaders };
  }
</file>

<file path="src/hooks/useApiResource.ts">
"use client";
import { useCallback, useEffect, useRef, useState } from "react";
import { getAuthHeaders } from "@/lib/utils";

import { singleFlightRefresh } from "@/lib/auth-refresh";

interface CachedEntry<T> {
  data: T;
  expiresAt: number;
}

const cache = new Map<string, CachedEntry<unknown>>();

/**
 * Structural equality for JSON-shaped API payloads (plain objects, arrays,
 * strings, numbers, booleans, null). Used to gate setData so a poll that
 * returns *identical* data does not mint a new object reference and force a
 * re-render of every consuming panel. Fast path: same reference => equal.
 */
function deepEqual(a: unknown, b: unknown): boolean {
  if (Object.is(a, b)) return true;
  if (a === null || b === null) return false;
  if (typeof a !== "object" || typeof b !== "object") return false;
  const ka = Object.keys(a as object);
  const kb = Object.keys(b as object);
  if (ka.length !== kb.length) return false;
  for (const k of ka) {
    if (!Object.prototype.hasOwnProperty.call(b, k)) return false;
    if (!deepEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k])) return false;
  }
  return true;
}

export async function cachedFetch<T>(
  url: string,
  options: { ttlMs?: number; headers?: Record<string, string>; auth?: boolean } = {}
): Promise<T> {
  const { ttlMs = 15_000, headers, auth = true } = options;
  const now = Date.now();
  const userId = typeof window !== "undefined" ? (window as any).__currentUserId ?? "anon" : "anon";
  const key = `${userId}|${url}`;
  const hit = cache.get(key) as CachedEntry<T> | undefined;
  if (hit && hit.expiresAt > now) return hit.data;

  let res = await fetch(url, {
    headers: {
      "Content-Type": "application/json",
      ...(auth ? getAuthHeaders() : {}),
      ...headers,
    },
    credentials: "include",
  });

  // A 401 means the stored token went stale (e.g. session rotated/revoked
  // after a deploy, or a refreshed access token). Attempt one single-flight
  // refresh and retry once so dashboards self-heal instead of surfacing a
  // hard "HTTP 401" that only a full reload would clear.
  if (res.status === 401 && auth) {
    try { await singleFlightRefresh(); } catch { /* fall through */ }
    const fresh = getAuthHeaders();
    if (fresh["Authorization"] && fresh["Authorization"] !== (headers as Record<string,string>)["Authorization"]) {
      res = await fetch(url, {
        headers: {
          "Content-Type": "application/json",
          ...fresh,
          ...headers,
        },
        credentials: "include",
      });
    }
  }

  if (!res.ok) {
    const e = new Error(`HTTP ${res.status}`) as Error & { status?: number };
    e.status = res.status;
    throw e;
  }
  const data = (await res.json()) as T;
  cache.set(url, { data, expiresAt: now + ttlMs });
  return data;
}

export function clearCache(url?: string) {
  if (url) cache.delete(url);
  else cache.clear();
}

/** Scope cache keys to a specific user ID. Call on logout to evict a user's
 *  cached entries so the next operator on a shared kiosk never reads them. */
export function clearCacheForUser(userId: string | null) {
  if (!userId) return;
  const prefix = `${userId}|`;
  for (const k of cache.keys()) if (k.startsWith(prefix)) cache.delete(k);
}

export interface ApiResource<T> {
  data: T | null;
  loading: boolean;
  error: string | null;
  refresh: () => Promise<void>;
}

export function useApiResource<T>(
  url: string | null,
  options: { deps?: unknown[]; enabled?: boolean; ttlMs?: number } = {},
): ApiResource<T> {
  const [data, setData] = useState<T | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const {enabled, ttlMs} = options;
  const hasLoadedRef = useRef(false);

  const refresh = useCallback(async () => {
    if (!url || enabled === false) {
      // Guard: without this, an early-return in the hook would change
      // the hook-call count on the next render when url/enabled flip,
      // throwing React issue-310 in every consuming component.
      setLoading(false);
      return;
    }
    // Only the FIRST fetch shows a skeleton. Subsequent polls keep the
    // previous payload visible — no flicker, no layout shift.
    if (!hasLoadedRef.current) setLoading(true);
    setError(null);
    try {
      const next = await cachedFetch<T>(url, { ttlMs });
      // Only re-render when the payload actually changed. A poll that returns
      // identical data keeps the previous object reference, so downstream
      // memoized panels (useMemo / React.memo) do not re-run.
      setData((prev) => (prev !== null && deepEqual(prev, next) ? prev : next));
    } catch (e) {
      setError(e instanceof Error ? e.message : "Request failed");
    } finally {
      setLoading(false);
    }
     
  }, [url, enabled, ttlMs]);

  useEffect(() => {
    void refresh();
  }, [refresh]);

  return { data, loading, error, refresh };
}
</file>

