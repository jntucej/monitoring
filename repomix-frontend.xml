"use client";

/* ── PresenceMatrixPanel (Live Gate Presence) ── */

import { memo } from "react";
import { AlertTriangle, MapPin } from "lucide-react";
import { PrincipalWidgetBoundary } from "@/components/principal/shared/PrincipalWidgetBoundary";
import type { PresenceMatrixData } from "./types";
import { fmtTime } from "./types";

/* ── cell class lookup (module-level to avoid per-render string allocation) ── */
const CELL_BG = ["", "bg-emerald-500/10", "bg-emerald-500/20", "bg-emerald-500/40"] as const;
function cellClass(n: number): string {
  return `px-2 py-1 text-xs ${CELL_BG[Math.min(n, 3)]}`;
}

export const PresenceMatrixPanel = memo(function PresenceMatrixPanel({
  matrixData,
  loading,
  error,
}: {
  matrixData: PresenceMatrixData | null;
  loading: boolean;
  error: string | null;
}) {
  const gates = matrixData?.gates ?? [];
  const roles = matrixData?.roles ?? [];
  const matrix = matrixData?.matrix ?? {};

  return (
    <PrincipalWidgetBoundary title="Live Gate Presence">
      <div className="surface-card bg-bg-surface p-4 sm:p-5 min-w-0">
        <div className="flex items-center gap-2 text-text-muted mb-4">
          <MapPin className="w-4 h-4" />
          <span className="text-xs font-semibold uppercase tracking-wide">Live Gate Presence</span>
        </div>
        {loading && <p className="text-sm text-text-muted">Loading…</p>}
        {error && !loading && (
          <div className="surface-card bg-rose-500/10 p-3 text-sm text-action-danger flex items-center gap-2">
            <AlertTriangle className="w-4 h-4 shrink-0" /> Could not load presence matrix: {error}
          </div>
        )}
        {matrixData && !loading && !error && gates.length === 0 && (
          <p className="text-sm text-text-muted py-4 text-center">No active gates configured.</p>
        )}
        {matrixData && !loading && !error && gates.length > 0 && (
          <div className="overflow-x-auto min-w-0">
            <table className="w-full text-xs min-w140">
              <thead>
                <tr>
                  <th className="text-left text-text-muted font-semibold pr-3 pb-2">Gate</th>
                  {roles.map((r) => (
                    <th key={r} className="text-center text-text-muted font-semibold px-1.5 pb-2">
                      {r.length > 6 ? `${r.slice(0, 5)}…` : r}
                    </th>
                  ))}
                  <th className="text-right text-text-muted font-semibold pl-2">Total</th>
                </tr>
              </thead>
              <tbody>
                {gates.map((g) => {
                  const row = matrix[g.id] ?? {};
                  const total = roles.reduce((acc, r) => acc + (Number(row[r]) || 0), 0);
                  return (
                    <tr key={g.id} className="border-t border-border">
                      <td className="py-2.5 pr-3 font-medium text-text-primary">
                        {g.name || g.code || g.id}
                      </td>
                      {roles.map((r) => {
                        const v = Number(row[r]) || 0;
                        return (
                          <td key={r} className="text-center px-1.5 py-2.5">
                            <span
                              className={`inline-block min-w6 rounded px-1 py-0.5 text-center font-mono ${
                                v > 0
                                  ? v >= 20
                                    ? "bg-emerald-500/30 text-action-success"
                                    : "bg-indigo-500/25 text-indigo-300"
                                  : "text-text-muted"
                              } ${cellClass(v)}`}
                            >
                              {v}
                            </span>
                          </td>
                        );
                      })}
                      <td className="text-right pl-2 font-mono text-text-primary">{total}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            {matrixData.lastUpdated && (
              <p className="text-xs text-text-muted mt-2">Updated {fmtTime(matrixData.lastUpdated)}</p>
            )}
          </div>
        )}
      </div>
    </PrincipalWidgetBoundary>
  );
});
</file>

<file path="src/components/principal/_components/RetentionWidgets.tsx">
"use client";

/* ── Retention widget components for the principal console ──
   These widgets use explicit TONE_CLASS maps to avoid the
   bg-[var(--action-${tone})] Tailwind-var interpolation issue. */

import { useEffect, useState, memo } from "react";
import {Clock, UserCheck, Inbox, AlertTriangle, ShieldCheck, Calendar, Activity, Zap}  from "lucide-react";
import { cn, getTimeAgo } from "@/lib/utils";
import { fetchJson, type Resp } from "@/components/principal/_components/fetchJson";

/* ── TONE_CLASS maps — no dynamic Tailwind var interpolation ── */

const TONE_CLASS: Record<string, { bg: string; text: string; border: string }> = {
  neutral:  { bg: "bg-bg-elevated/10",  text: "text-text-muted",   border: "border-border/30"  },
  positive: { bg: "bg-emerald-500/10", text: "text-action-success", border: "border-emerald-500/30" },
  warning:  { bg: "bg-amber-500/10",  text: "text-action-warning",   border: "border-amber-500/30"  },
  critical: { bg: "bg-rose-500/10",   text: "text-action-danger",    border: "border-rose-500/30"   },
};

function toneClass(tone: string) {
  return TONE_CLASS[tone] ?? TONE_CLASS.neutral;
}

/* ── PrincipalStageTag ── */

export const PrincipalStageTag = memo(function PrincipalStageTag({
  stage,
}: {
  stage: string;
}) {
  const tone = stage.includes("overdue") ? "critical" : "warning";
  const tc = toneClass(tone);
  return (
    <span
      className={cn(
        "inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-bold uppercase tracking-wide border",
        tc.bg,
        tc.text,
        tc.border
      )}
    >
      <Clock className="size-3.5" />
      {stage.replace(/_/g, " ")}
    </span>
  );
});

/* ── PrincipalCatchUpCard ── */

export const PrincipalCatchUpCard = memo(function PrincipalCatchUpCard() {
  const [data, setData] = useState<Resp | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    fetchJson("/api/principal/catch-up")
      .then((r) => {
        setData(r);
        setError(r.success ? null : r.error?.message ?? "Load failed");
      })
      .catch((e) => setError(e instanceof Error ? e.message : "Network error"))
      .finally(() => setLoading(false));
  }, []);

  const d = (data?.data as Record<string, unknown>) ?? null;

  return (
    <div className="surface-card bg-bg-surface p-4 sm:p-5 min-w-0">
      <div className="flex items-center gap-2 mb-4">
        <Inbox className="h-4 w-4 text-action-primary" />
        <span className="text-xs font-semibold uppercase tracking-wide text-text-muted">
          Since Last Visit
        </span>
      </div>
      {loading && <p className="text-sm text-text-muted">Loading…</p>}
      {error && !loading && (
        <p className="text-xs text-action-danger">{error}</p>
      )}
      {d && !loading && (
        <div className="space-y-3">
          <div className="grid grid-cols-3 gap-3">
            <div className="text-center">
              <p className="text-xl font-bold text-action-success">{Number(d.approvalsCleared ?? 0)}</p>
              <p className="text-xs text-text-muted">Cleared</p>
            </div>
            <div className="text-center">
              <p className="text-xl font-bold text-action-warning">{Number(d.pendingSince ?? 0)}</p>
              <p className="text-xs text-text-muted">New Pending</p>
            </div>
            <div className="text-center">
              <p className="text-xl font-bold text-action-danger">{Number(d.newEscalations ?? 0)}</p>
              <p className="text-xs text-text-muted">Escalated</p>
            </div>
          </div>
          {(d.openAlerts as unknown[] | undefined)?.length ? (
            <div>
              <p className="text-xs font-medium text-text-muted mb-2">Open Alerts</p>
              <ul className="space-y-1.5">
                {(d.openAlerts as Array<Record<string, unknown>>).slice(0, 3).map((a, i) => {
                  const tone = a.severity === "critical" ? "critical" : a.severity === "high" ? "warning" : "neutral";
                  const tc = toneClass(tone);
                  return (
                    <li key={i} className={cn("rounded-lg p-2 flex items-center gap-2", tc.bg)}>
                      <AlertTriangle className={cn("h-3.5 w-3.5 shrink-0", tc.text)} />
                      <span className={cn("text-xs font-medium truncate", tc.text)}>
                        {String(a.title ?? a.id ?? "Alert")}
                      </span>
                    </li>
                  );
                })}
              </ul>
