<file path="src/components/sysadmin/kit/viz/Sankey.tsx">
"use client";

import { useMemo } from "react";
import { cn } from "@/lib/utils";
import type { SankeyNode, SankeyLink } from "./types";
import { statusColor, VIZ_THEME } from "./theme";

/**
 * Sankey — a two-column role/flow diagram: source nodes on the left, target
 * nodes on the right, with curved links whose thickness is proportional to
 * value. Pure SVG + CSS vars; no third-party sankey dep.
 */
export function Sankey({
  source,
  target,
  links,
  height = 260,
  onLinkClick,
  className,
}: {
  source: SankeyNode[];
  target: SankeyNode[];
  links: SankeyLink[];
  height?: number;
  onLinkClick?: (source: string, target: string, value: number) => void;
  className?: string;
}) {
  const W = 640;
  const H = height;
  const pad = 80; // side padding for labels
  const gap = 14; // gap between nodes in a column

  const layout = useMemo(() => {
    const totalSource = source.reduce((a, n) => a + n.count, 0) || 1;
    const totalTarget = target.reduce((a, n) => a + n.count, 0) || 1;

    const nodeHeight = (n: SankeyNode, total: number, available: number) =>
      Math.max(8, (n.count / total) * available);

    const availableH = H - pad - gap * Math.max(0, source.length - 1);
    const sourceYs: Record<string, { y: number; h: number }> = {};
    let yCursor = 0;
    for (const n of source) {
      const h = nodeHeight(n, totalSource, availableH);
      sourceYs[n.id] = { y: yCursor, h };
      yCursor += h + gap;
    }

    const availableH2 = H - pad - gap * Math.max(0, target.length - 1);
    const targetYs: Record<string, { y: number; h: number }> = {};
    yCursor = 0;
    for (const n of target) {
      const h = nodeHeight(n, totalTarget, availableH2);
      targetYs[n.id] = { y: yCursor, h };
      yCursor += h + gap;
    }

    // Assign link offsets within each node so multiple links stack.
    const srcOffsets: Record<string, number> = {};
    const tgtOffsets: Record<string, number> = {};
    const linkGeos = links.map((l) => {
      const s = sourceYs[l.source];
      const t = targetYs[l.target];
      if (!s || !t) return null;
      const totalSourceCount = source.reduce((a, n) => (n.id === l.source ? a + n.count : a), 0) || 1;
      const totalTargetCount = target.reduce((a, n) => (n.id === l.target ? a + n.count : a), 0) || 1;
      const thickness = Math.min(
        s.h * (l.value / totalSourceCount),
        t.h * (l.value / totalTargetCount),
        40,
      );
      const so = srcOffsets[l.source] ?? 0;
      const to = tgtOffsets[l.target] ?? 0;
      srcOffsets[l.source] = so + thickness;
      tgtOffsets[l.target] = to + thickness;

      const x0 = pad;
      const x1 = W - pad;
      const y0 = Number.isFinite(s.y + so + thickness / 2) ? s.y + so + thickness / 2 : H / 2;
      const y1 = Number.isFinite(t.y + to + thickness / 2) ? t.y + to + thickness / 2 : H / 2;
      const midX = (x0 + x1) / 2;
      const d = `M ${x0} ${y0} C ${midX} ${y0}, ${midX} ${y1}, ${x1} ${y1}`;
      return { link: l, d, thickness };
    });

    return { sourceYs, targetYs, linkGeos };
  }, [source, target, links, H, pad]);

  return (
    <svg
      role="img"
      aria-label={`Role transition Sankey, ${source.length} sources, ${target.length} targets, ${links.length} flows`}
      viewBox={`0 0 ${W} ${H}`}
      width="100%"
      height={H}
      className={cn("overflow-visible", className)}
    >
      {/* links */}
      {layout.linkGeos.map((g, i) => {
        if (!g) return null;
        const l = g.link;
        const stroke = statusColor(l.status ?? "neutral");
        const width = Math.max(2, g.thickness);
        return (
          <g key={`link-${i}`}>
            <path
              d={g.d || "M 0 0 L 0 0"}
              fill="none"
              stroke={stroke}
              strokeOpacity={0.18}
              strokeWidth={width}
            />
            <path
              d={g.d || "M 0 0 L 0 0"}
              fill="none"
              stroke={stroke}
              strokeOpacity={0.55}
              strokeWidth={Math.min(width, 3)}
              strokeDasharray="4 6"
              style={onLinkClick ? { cursor: "pointer" } : undefined}
              onClick={() => onLinkClick?.(l.source, l.target, l.value)}
            />
            <text
              x={W / 2}
              y={(g.d.match(/C (\d+)/)?.[1] ? 0 : 0)}
              dy={-4}
              textAnchor="middle"
              fontSize={10}
              fill={VIZ_THEME.muted}
            >
              {l.value}
            </text>
          </g>
        );
      })}

      {/* source nodes */}
      {source.map((n) => {
        const p = layout.sourceYs[n.id];
        if (!p) return null;
        return (
          <g key={`src-${n.id}`}>
            <rect
              x={pad - 4}
              y={p.y}
              width={8}
              height={p.h}
              rx={2}
              fill={VIZ_THEME.info}
              fillOpacity={0.85}
            />
            <text
              x={pad - 12}
              y={p.y + p.h / 2}
              textAnchor="end"
              dominantBaseline="middle"
              fontSize={12}
              fill={VIZ_THEME.text}
            >
              {n.label}
            </text>
            <text
              x={pad - 12}
              y={p.y + p.h / 2 + 14}
              textAnchor="end"
              dominantBaseline="middle"
              fontSize={10}
              fill={VIZ_THEME.muted}
            >
              {n.count}
            </text>
          </g>
        );
      })}

      {/* target nodes */}
      {target.map((n) => {
        const p = layout.targetYs[n.id];
        if (!p) return null;
        return (
          <g key={`tgt-${n.id}`}>
            <rect
              x={W - pad - 4}
              y={p.y}
              width={8}
              height={p.h}
              rx={2}
              fill={VIZ_THEME.ok}
              fillOpacity={0.85}
            />
            <text
              x={W - pad + 12}
              y={p.y + p.h / 2}
              textAnchor="start"
              dominantBaseline="middle"
              fontSize={12}
              fill={VIZ_THEME.text}
            >
              {n.label}
            </text>
            <text
              x={W - pad + 12}
              y={p.y + p.h / 2 + 14}
              textAnchor="start"
              dominantBaseline="middle"
              fontSize={10}
              fill={VIZ_THEME.muted}
            >
              {n.count}
            </text>
          </g>
        );
      })}
    </svg>
  );
}
</file>

<file path="src/components/sysadmin/monitoring/DockerFleetPanel.tsx">
"use client";

import { useEffect, useState, useCallback } from "react";
import { Server, RefreshCw, ExternalLink } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";

interface PromSample {
  metric: Record<string, string>;
  value: [number, string];
}

interface FleetRow {
  name: string;
  cpu: number;
  memoryBytes: number;
  restarts: number;
  up: boolean;
}

const GRAFANA_BASE = process.env.NEXT_PUBLIC_MONITORING_GRAFANA_URL || "";

export function DockerFleetPanel() {
  const [rows, setRows] = useState<FleetRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [lastUpdated, setLastUpdated] = useState<Date | null>(null);

  const load = useCallback(async () => {
    try {
      const headers = getAuthHeaders();
      const fetchQ = (id: string) =>
        fetch(`/api/admin/monitoring?queryId=${id}`, { headers, cache: "no-store" }).then((r) => r.json());

      const [cpu, mem, restarts, up] = await Promise.all([
        fetchQ("fleet.cpu"),
        fetchQ("fleet.memory"),
        fetchQ("fleet.restarts"),
        fetchQ("fleet.up"),
      ]);

      if (!cpu.success) throw new Error(cpu.error?.message || "cpu query failed");

      const collect = (res: any) => {
        const m = new Map<string, number>();
        (res?.data?.result || []).forEach((s: PromSample) => {
          if (s.metric?.name) m.set(s.metric.name, parseFloat(s.value[1]));
        });
        return m;
      };
      const cpuMap = collect(cpu);
      const memMap = collect(mem);
      const restartMap = collect(restarts);
      const upMap = collect(up);

      const names = Array.from(new Set([...cpuMap.keys(), ...memMap.keys(), ...upMap.keys()]));
      const assembled: FleetRow[] = names.map((name) => ({
        name,
        cpu: cpuMap.get(name) ?? 0,
        memoryBytes: memMap.get(name) ?? 0,
        restarts: restartMap.get(name) ?? 0,
        up: (upMap.get(name) ?? 0) > 0,
      }));
      assembled.sort((a, b) => a.name.localeCompare(b.name));

      setRows(assembled);
      setError(null);
      setLastUpdated(new Date());
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : "Unknown error");
    } finally {
      setLoading(false);
    }
  }, []);

  // Initial load only — the fleet status changes on admin action (deploy/
  // restart), not continuously, so no auto-poll. The 30-second timer was
  // hammering the docker-status endpoint every minute this panel was open.
  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  const fmtMem = (bytes: number) => {
    const mib = bytes / 1024 / 1024;
    if (mib < 1) return `${(bytes / 1024).toFixed(0)} KiB`;
    if (mib < 1024) return `${mib.toFixed(0)} MiB`;
    return `${(mib / 1024).toFixed(2)} GiB`;
  };

  return (
    <div className="rounded-xl border border-border bg-bg-surface">
      <div className="surface-card flex items-center justify-between p-4">
        <div>
          <p className="text-sm font-bold flex items-center gap-2">
            <Server className="w-4 h-4 text-action-success" />
            Docker Fleet
          </p>
          <p className="text-xs text-text-muted mt-0.5">
            {lastUpdated ? `Updated ${lastUpdated.toLocaleTimeString()}` : "Loading…"}
          </p>
        </div>
        <button
          onClick={load}
          disabled={loading}
          className="surface-card inline-flex items-center gap-1.5 text-xs px-3 py-1.5 bg-bg-elevated hover:bg-bg-base disabled:opacity-50"
        >
          <RefreshCw className={`w-3.5 h-3.5 ${loading ? "animate-spin" : ""}`} />
          Refresh
        </button>
      </div>

      {error ? (
        <div className="surface-card p-4 m-4 bg-rose-500/10 text-action-danger text-xs">
          Monitoring stack unreachable: {error}
        </div>
      ) : rows.length === 0 ? (
        <div className="p-6 text-center text-xs text-text-muted">
          {loading ? "Loading fleet…" : "No gate_* or mon_* containers found"}
        </div>
      ) : (
        <div className="overflow-x-auto">
          <table className="w-full text-xs">
            <thead>
              <tr className="border-b border-border text-text-muted text-left">
                <th className="py-2.5 px-4 font-medium">Container</th>
                <th className="py-2.5 px-4 font-medium">State</th>
                <th className="py-2.5 px-4 font-medium text-right">CPU %</th>
                <th className="py-2.5 px-4 font-medium text-right">Memory</th>
                <th className="py-2.5 px-4 font-medium text-right">Restarts (1h)</th>
                <th className="py-2.5 px-4 font-medium text-right">Logs</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-border">
              {rows.map((row) => (
                <tr key={row.name} className="hover:bg-bg-elevated/40">
                  <td className="py-2.5 px-4 font-mono text-text-primary">{row.name}</td>
                  <td className="py-2.5 px-4">
                    <span className="inline-flex items-center gap-1.5">
                      <span className={`w-2 h-2 rounded-full ${row.up ? "bg-action-success" : "bg-action-danger"}`} />
                      <span className={row.up ? "text-action-success" : "text-action-danger"}>
                        {row.up ? "Up" : "Down"}
                      </span>
                    </span>
                  </td>
                  <td className="py-2.5 px-4 text-right font-mono">{row.cpu.toFixed(2)}</td>
                  <td className="py-2.5 px-4 text-right font-mono">{fmtMem(row.memoryBytes)}</td>
                  <td className="py-2.5 px-4 text-right font-mono">
                    {row.restarts > 0 ? (
                      <span className="text-action-warning">{row.restarts}</span>
                    ) : (
                      <span className="text-text-muted">0</span>
                    )}
                  </td>
                  <td className="py-2.5 px-4 text-right">
                    {GRAFANA_BASE ? (
                      <a
                        href={`${GRAFANA_BASE}/explore?orgId=1&left=${encodeURIComponent(
                          JSON.stringify({
                            datasource: "Loki",
                            queries: [{ expr: `{container="${row.name}"}`, refId: "A" }],
                            range: { from: "now-1h", to: "now" },
                          })
                        )}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="inline-flex items-center gap-1 text-text-muted hover:text-action-success"
                      >
                        <ExternalLink className="size-3.5" />
                      </a>
                    ) : (
                      <span className="text-text-muted">—</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/sysadmin/ActiveSessions.tsx">
"use client";
import { errMsg } from "@/lib/err-msg";

import { useState, useEffect, useCallback } from "react";
import { useUIStore } from "@/stores/uiStore";
import { Users, LogOut, RefreshCw } from "lucide-react";
import { useApi } from "@/hooks/useApi";

interface ActiveSession {
  userId: string;
  name: string;
  email: string;
  role: string;
  status: string;
  sessionTokenTruncated: string;
  lastActive: string;
}

export function ActiveSessions() {
  const api = useApi();

  const { addToast } = useUIStore();

  const [sessions, setSessions] = useState<ActiveSession[]>([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [revokingId, setRevokingId] = useState<string | null>(null);

  // silent=true → background poll: never blank the table, just show a subtle
  // "refreshing" indicator. Only the very first load shows the fetcher.
  const fetchSessions = useCallback(async (silent: boolean = false) => {
    if (silent) setRefreshing(true);
    else setLoading(true);
    try {
      const headers = api.getHeaders();
      const res = await fetch("/api/admin/sessions", { headers });
      const data = await res.json();
      if (res.ok && data.success) {
        setSessions(data.data || []);
      }
    } catch {
      // Best effort — keep the last known list so a transient 5xx never
      // makes the table vanish (which is what looked "glitchy").
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [api.getHeaders]);

  // Initial load only — no background poll. Sessions change when users log
  // in/out, not continuously; the 30-second timer was just adding request
  // load to /api/admin/sessions. Manual refresh remains via the panel's
  // Refresh button.
  useEffect(() => {
    fetchSessions(false);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleRevokeSession = async (targetUserId: string, userName: string) => {
    if (!confirm(`Are you sure you want to force logout ${userName}?`)) return;

    setRevokingId(targetUserId);
    try {
      const headers = api.getHeaders();
      const res = await fetch(`/api/admin/sessions/${targetUserId}`, {
        method: "DELETE",
        headers,
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error?.message || "Failed to revoke session");
      }

      addToast({
        title: "Session Revoked",
        message: `User ${userName} has been logged out`,
        variant: "success",
      });
      fetchSessions();
    } catch (err) {
      addToast({ title: "Revocation Failed", message: errMsg(err), variant: "error" });
    } finally {
      setRevokingId(null);
    }
  };

  return (
    <div className="space-y-6">
      {/* Top Header */}
      <div className="surface-card flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-bg-surface p-6">
        <div>
          <h2 className="text-xl font-bold text-white flex items-center gap-2">
            <Users className="w-6 h-6 text-action-info" /> Active User Sessions
          </h2>
          <p className="text-xs text-text-muted mt-1">
            Real-time view of currently authenticated users across web & mobile hardware
          </p>
        </div>
        <button
          onClick={() => fetchSessions(false)}
          disabled={loading || refreshing}
          className="surface-card inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-action-info text-white text-xs font-bold transition-all disabled:opacity-50 self-start sm:self-auto"
        >
          <RefreshCw className={`w-4 h-4 ${loading || refreshing ? "animate-spin" : ""}`} />
          {refreshing && !loading ? "Refreshing…" : "Refresh List"}
        </button>
      </div>

      {/* Sessions Table */}
      <div className="bg-bg-surface border border-border rounded-2xl overflow-hidden">
        {loading ? (
          <div className="py-12 text-center text-xs text-text-muted">Fetching active session tokens...</div>
        ) : sessions.length === 0 ? (
          <div className="py-12 text-center text-xs text-text-muted">No active sessions detected.</div>
        ) : (
          <div className="overflow-x-auto">
            {refreshing && (
              <div className="px-4 py-1.5 text-xs text-text-muted bg-bg-elevated/40 flex items-center gap-1.5">
                <RefreshCw className="size-3.5 animate-spin" /> Refreshing in background…
              </div>
            )}
            <table className="w-full text-left text-xs min-w-[650px]">
              <thead>
                <tr className="border-b border-border text-text-muted bg-bg-elevated/40">
                  <th className="p-4">User</th>
                  <th className="p-4">Role</th>
                  <th className="p-4">Session Token</th>
                  <th className="p-4">Last Activity</th>
                  <th className="p-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {sessions.map((sess) => (
                  <tr key={sess.userId} className="hover:bg-bg-elevated/30 transition-colors">
                    <td className="p-4 font-bold text-white">
                      {sess.name}
                      <span className="block text-xs text-text-muted font-normal">{sess.email}</span>
                    </td>
                    <td className="p-4">
                      <span className="surface-card px-2 py-0.5 text-xs font-mono font-bold bg-sky-500/20 text-action-info uppercase">
                        {sess.role}
                      </span>
                    </td>
                    <td className="p-4 font-mono text-xs text-purple-300">{sess.sessionTokenTruncated}</td>
                    <td className="p-4 font-mono text-xs text-text-muted">
                      {new Date(sess.lastActive).toLocaleString()}
                    </td>
                    <td className="p-4 text-right">
                      <button
                        onClick={() => handleRevokeSession(sess.userId, sess.name)}
                        disabled={revokingId === sess.userId}
                        className="surface-card inline-flex items-center gap-1 px-3 py-1.5 bg-rose-600/20 text-action-danger hover:bg-action-danger hover:text-white font-bold text-xs transition-all disabled:opacity-50"
                      >
                        <LogOut className="size-3.5" /> Force Logout
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/AlumniPanel.tsx">
"use client";

import {
  useState,
  useMemo,
  useCallback,
  useEffect,
  type ReactNode,
} from "react";
import {
  GraduationCap,
  Search,
  RefreshCw,
  Users,
  Archive,
  AlertTriangle,
  CheckCircle2,
  Loader2,
  ShieldAlert,
  Ban,
  UserCheck,
  Database,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { parseRollNumber, getGraduationYearFromRoll } from "@/lib/rollNumber";

export type AlumniTab = "auto" | "graduated" | "deprovisioned";

interface StudentRow {
  id: string;
  uniqueId?: string;
  name: string;
  roll?: string;
  status: string;
  course?: string;
  year?: number;
  batch?: string;
  email?: string;
  completed?: boolean;
  completedAt?: string;
}

interface DeprovisionRow {
  id: string;
  uniqueId?: string;
  name: string;
  role?: string;
  status?: string;
  reason?: string | null;
}

const fmtDate = (iso?: string | null) =>
  iso
    ? new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
    : "—";

export function AlumniPanel({ tab }: { tab: AlumniTab }) {
  const addToast = useUIStore((s) => s.addToast);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [students, setStudents] = useState<StudentRow[]>([]);
  const [deprovisioned, setDeprovisioned] = useState<DeprovisionRow[]>([]);
  const [search, setSearch] = useState("");
  const [bulkLoading, setBulkLoading] = useState(false);
  const [confirmBulk, setConfirmBulk] = useState(false);
  const [singleBusy, setSingleBusy] = useState<string | null>(null);
  const [reprovisionBusy, setReprovisionBusy] = useState<string | null>(null);

  // Roster / deprovision filters
  const [rosterCourse, setRosterCourse] = useState("ALL");
  const [rosterYear, setRosterYear] = useState("ALL");
  const [depRole, setDepRole] = useState("ALL");

  const fetchStudents = useCallback(async () => {
    try {
      const headers = getAuthHeaders();
      const res = await fetch("/api/students?status=ALL", { headers, cache: "no-store" });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      const data: any[] = Array.isArray(json.data) ? json.data : json.data?.items ?? [];
      setStudents(data as unknown as StudentRow[]);
      setError(null);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to load students");
    } finally {
      setLoading(false);
    }
  }, []);

  const fetchDeprovisioned = useCallback(async () => {
    try {
      const headers = getAuthHeaders();
      const res = await fetch("/api/users", { headers, cache: "no-store" });
      const json = await res.json();
      const all: any[] = Array.isArray(json.data) ? json.data : [];
      setDeprovisioned(
        all
          .filter((u) => u.status === "DEPROVISIONED")
          .map((u) => ({
            id: u.id,
            uniqueId: u.uniqueId ?? u.unique_id ?? u.roll ?? undefined,
            name: u.name ?? "",
            role: u.role ?? "unknown",
            status: u.status,
            reason: (u as any).reason ?? null,
          })),
      );
    } catch {
      // Non-fatal
    }
  }, []);

  useEffect(() => { fetchStudents(); fetchDeprovisioned(); }, [fetchStudents, fetchDeprovisioned]);

  const enriched = useMemo(() => {
    return students.map((s) => {
      const roll = s.roll || s.uniqueId || "";

      const currentYear = new Date().getFullYear();
      const gradYear = getGraduationYearFromRoll(roll);
      const shouldBeGraduated = gradYear !== null && gradYear <= currentYear;
      const isGraduated = s.status === "DEPROVISIONED" || s.completed === true;
      const isSuspended = s.status === "SUSPENDED" || s.status === "LOCKED";
      return { ...s, roll, gradYear, shouldBeGraduated, isGraduated, isSuspended, courseLabel: s.course || undefined };
    });
  }, [students]);

  const autoDetected = useMemo(() =>
    enriched.filter((s) => s.shouldBeGraduated && !s.isGraduated && !s.isSuspended && s.status === "ACTIVE"),
    [enriched]);

  const graduated = useMemo(() =>
    enriched.filter((s) => s.completed === true),
    [enriched]);

  const filteredAuto = useMemo(() => {
    const q = search.toLowerCase();
    if (!q) return autoDetected;
    return autoDetected.filter((s) =>
      (s.name || "").toLowerCase().includes(q) ||
      (s.roll || "").toLowerCase().includes(q) ||
      (s.courseLabel || "").toLowerCase().includes(q));
  }, [autoDetected, search]);

  const rosterCourses = useMemo(
    () => Array.from(new Set(graduated.map((s) => s.courseLabel || "Unassigned"))).sort((a, b) => a.localeCompare(b)),
    [graduated]);
  const rosterYears = useMemo(
    () =>
      Array.from(
        new Set(graduated.map((s) => s.gradYear).filter((y): y is number => y !== null)),
      ).sort((a, b) => a - b),
    [graduated]);

  const filteredGraduated = useMemo(() => {
    let rows = graduated;
    if (rosterCourse !== "ALL") rows = rows.filter((s) => (s.courseLabel || "Unassigned") === rosterCourse);
    if (rosterYear !== "ALL") rows = rows.filter((s) => String(s.gradYear ?? "") === rosterYear);
    const q = search.toLowerCase();
    if (q) rows = rows.filter((s) => (s.name || "").toLowerCase().includes(q) || (s.roll || "").toLowerCase().includes(q));
    return rows;
  }, [graduated, rosterCourse, rosterYear, search]);

  const depRoles = useMemo(
    () => Array.from(new Set(deprovisioned.map((u) => u.role || "unknown"))).sort((a, b) => a.localeCompare(b)),
    [deprovisioned]);

  const filteredDeprovisioned = useMemo(() => {
    let rows = deprovisioned;
    if (depRole !== "ALL") rows = rows.filter((u) => (u.role || "unknown") === depRole);
    const q = search.toLowerCase();
    if (q) rows = rows.filter((u) => (u.name || "").toLowerCase().includes(q) || (u.uniqueId || "").toLowerCase().includes(q));
    return rows;
  }, [deprovisioned, depRole, search]);

  const handleSingleGraduate = useCallback(async (student: StudentRow) => {
    setSingleBusy(student.id);
    try {
      const headers = getAuthHeaders();


      const res = await fetch(`/api/users/${student.id}`, {
        method: "PATCH",
        headers: { ...headers, "Content-Type": "application/json" },
        body: JSON.stringify({
          status: "DEPROVISIONED",
          completed: true,
          completedAt: new Date().toISOString(),
        }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error?.message || "Failed");
      addToast({ variant: "success", message: `${student.name} marked as graduated (DEPROVISIONED).` });
      fetchStudents(); fetchDeprovisioned();
    } catch (err) {
      addToast({ variant: "error", message: err instanceof Error ? err.message : "Failed" });
    } finally {
      setSingleBusy(null);
    }
  }, [addToast, fetchStudents, fetchDeprovisioned]);

  const handleBulkGraduate = useCallback(async () => {
    setBulkLoading(true);
    setConfirmBulk(false);
    try {
      const headers = getAuthHeaders();
      const rolls = filteredAuto.map((s) => s.roll).filter(Boolean);
      const res = await fetch("/api/users/bulk-graduate", {
        method: "POST",
        headers: { ...headers, "Content-Type": "application/json" },
        body: JSON.stringify({ rolls }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error?.message || "Bulk graduate failed");
      addToast({
        variant: "success",
        message: `${json.processed} student(s) graduated. ${json.skipped} skipped.`,
      });
      fetchStudents(); fetchDeprovisioned();
    } catch (err) {
      addToast({ variant: "error", message: err instanceof Error ? err.message : "Failed" });
    } finally {
      setBulkLoading(false);
    }
  }, [addToast, fetchStudents, fetchDeprovisioned, filteredAuto]);

  const handleReactivateUser = useCallback(async (u: DeprovisionRow) => {
    setReprovisionBusy(u.id);
    try {
      const headers = getAuthHeaders();
      const res = await fetch(`/api/users/${u.id}`, {
        method: "PATCH",
        headers: { ...headers, "Content-Type": "application/json" },
        body: JSON.stringify({ status: "ACTIVE", unlock: true }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error?.message || "Failed");
      addToast({ variant: "success", message: `${u.name} (${u.role}) re-activated.` });
      fetchDeprovisioned();
    } catch (err) {
      addToast({ variant: "error", message: err instanceof Error ? err.message : "Failed" });
    } finally {
      setReprovisionBusy(null);
    }
  }, [addToast, fetchDeprovisioned]);

  const activeStudents = enriched.filter((s) => s.status === "ACTIVE").length;

  const tabs: Array<{ id: AlumniTab; label: string; count: number; icon: ReactNode }> = [
    { id: "auto", label: "Auto-Detected Graduates", count: autoDetected.length, icon: <GraduationCap size={14} /> },
    { id: "graduated", label: "Graduated Roster", count: graduated.length, icon: <Archive size={14} /> },
    { id: "deprovisioned", label: "Deprovisioned Users", count: filteredDeprovisioned.length, icon: <Ban size={14} /> },
  ];

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <p className="text-xl sm:text-2xl font-bold text-white flex items-center gap-3">
            <GraduationCap className="size-6 text-action-success" />
            Alumni &amp; Deprovision
          </p>
          <p className="text-sm text-text-muted mt-1 max-w-2xl">
            Graduated students are <span className="text-action-success font-medium">flagged, not deleted</span> —
            completed + deprovisioned, with all historical scan, attendance &amp; gate data preserved and queryable.
          </p>
        </div>
        <button
          onClick={() => { setLoading(true); fetchStudents(); fetchDeprovisioned(); }}
          className="surface-card flex items-center gap-2 px-3 py-2 bg-bg-elevated hover:bg-bg-elevated text-sm text-text-secondary transition"
        >
          <RefreshCw size={14} className={loading ? "animate-spin" : ""} />
          Refresh
        </button>
      </div>

      {/* Backup notice */}
      <div className="surface-card flex items-start gap-3 p-4 bg-amber-950/40">
        <ShieldAlert className="text-action-warning shrink-0 mt-0.5" size={20} />
        <div>
          <p className="text-action-warning text-sm font-medium">Before deprovisioning, a pg_dump backup is recommended.</p>
          <p className="text-amber-700/70 text-xs mt-1">
            The master-backup cron runs every 5 min. Historical scan/attendance data is preserved —
            only the active flag changes.
          </p>
        </div>
      </div>

      {/* KPI row */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <KpiCard label="Total Students" value={students.length} icon={<Users size={18} />} color="text-action-primary" sub={`${activeStudents} currently active`} />
        <KpiCard label="Active" value={activeStudents} icon={<UserCheck size={18} />} color="text-action-success" sub="Currently enrolled" />
        <KpiCard label="Graduated" value={graduated.length} icon={<Archive size={18} />} color="text-unit-c" sub="completed = TRUE" />
        <KpiCard label="Deprovisioned" value={deprovisioned.length} icon={<Database size={18} />} color="text-action-danger" sub="status = DEPROVISIONED (all roles)" />
      </div>

      {/* Search */}
      <div className="flex flex-col sm:flex-row gap-3">
        <div className="relative flex-1 max-w-md">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" size={14} />
          <input
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Search by name, roll, or course…"
            className="surface-card w-full pl-9 pr-3 py-2 bg-bg-elevated text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
          />
        </div>
      </div>

      {/* Tab buttons (visual only – navigation handled by sub-routes) */}
      <div className="flex gap-1 overflow-x-auto">
        {tabs.map((t) => (
          <button
            key={t.id}
            onClick={() => { /* tab is driven by URL via sub-route; no-op here */ }}
            className={`flex items-center gap-2 px-3 py-2 rounded-lg text-xs sm:text-sm font-medium whitespace-nowrap transition pointer-events-none ${
              tab === t.id
                ? "bg-emerald-500/15 text-action-success border border-emerald-500/30"
                : "bg-bg-elevated/60 text-text-muted border border-transparent"
            }`}
          >
            {t.icon}
            {t.label}
            <span className={`ml-1 px-1.5 py-0.5 rounded text-xs ${
              tab === t.id ? "bg-emerald-500/20 text-action-success" : "bg-bg-elevated text-text-muted"
            }`}>{t.count}</span>
          </button>
        ))}
      </div>

      {/* Loading / error */}
      {loading && (
        <div className="flex items-center justify-center py-20 text-text-muted">
          <Loader2 className="animate-spin mr-2" size={20} /> Loading students…
        </div>
      )}
      {error && (
        <div className="surface-card p-4 bg-rose-950/40 text-action-danger text-sm">
          <AlertTriangle className="inline mr-2" size={16} /> {error}
        </div>
      )}

      {!loading && !error && (
        <>
          {/* AUTO-DETECTED */}
          {tab === "auto" && (
            <div>
              {filteredAuto.length === 0 ? (
                <EmptyState icon={<CheckCircle2 size={24} />} text="No auto-detected graduates. All active students are within their academic years." />
              ) : (
                <>
                  <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                    <p className="text-sm text-text-muted">
                      {filteredAuto.length} active student(s) whose computed graduation year has passed.
                    </p>
                    <button
                      onClick={() => setConfirmBulk(true)}
                      disabled={bulkLoading || filteredAuto.length === 0}
                      className="surface-card flex items-center gap-2 px-4 py-2 bg-action-success hover:bg-action-success disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-medium transition"
                    >
                      {bulkLoading ? <Loader2 size={14} className="animate-spin" /> : <GraduationCap size={14} />}
                      Mark All Detected as Graduated
                    </button>
                  </div>

                  {confirmBulk && (
                    <div className="fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
                      <div className="surface-card bg-bg-surface p-6 max-w-md w-full">
                        <div className="flex items-center gap-3 mb-4">
                          <div className="surface-card p-2 bg-emerald-500/15">
                            <GraduationCap className="text-action-success" size={20} />
                          </div>
                          <div>
                            <h3 className="text-white font-semibold">Confirm Bulk Graduation</h3>
                            <p className="text-text-muted text-xs">{filteredAuto.length} student(s) will be marked DEPROVISIONED</p>
                          </div>
                        </div>
                        <p className="text-text-secondary text-sm mb-4">
                          These students will be removed from all active rosters, gate logs, and mess eligibility.
                          Their historical data is preserved. This action can be reversed via the &quot;Re-activate&quot; button.
                        </p>
                        <div className="flex gap-3">
                          <button onClick={() => setConfirmBulk(false)} className="surface-card flex-1 px-4 py-2 bg-bg-elevated hover:bg-bg-elevated text-text-secondary text-sm transition">Cancel</button>
                          <button onClick={handleBulkGraduate} disabled={bulkLoading} className="surface-card flex-1 px-4 py-2 bg-action-success hover:bg-action-success disabled:opacity-50 text-white text-sm font-medium transition flex items-center justify-center gap-2">
                            {bulkLoading && <Loader2 size={14} className="animate-spin" />}
                            Confirm
                          </button>
                        </div>
                      </div>
                    </div>
                  )}

                  <div className="overflow-x-auto rounded-xl border border-border">
                    <table className="w-full text-sm min-w170">
                      <thead>
                        <tr className="bg-bg-elevated/60 text-text-muted text-xs uppercase tracking-wider">
                          <th className="px-4 py-3 text-left">Roll</th>
                          <th className="px-4 py-3 text-left">Name</th>
                          <th className="px-4 py-3 text-left">Course</th>
                          <th className="px-4 py-3 text-left">Adm. Year</th>
                          <th className="px-4 py-3 text-left">Grad. Year</th>
                          <th className="px-4 py-3 text-left">Status</th>
                          <th className="px-4 py-3 text-right">Action</th>
                        </tr>
                      </thead>
                      <tbody>
                        {filteredAuto.map((s) => {
                          const decoded = parseRollNumber(s.roll);
                          return (
                            <tr key={s.id} className="border-t border-border/60 hover:bg-bg-elevated/30">
                              <td className="px-4 py-3 font-mono text-action-success">{s.roll || "—"}</td>
                              <td className="px-4 py-3 text-white">{s.name}</td>
                              <td className="px-4 py-3 text-text-secondary">{s.courseLabel || "—"}</td>
                              <td className="px-4 py-3 text-text-muted">{decoded?.admissionYear ?? "—"}</td>
                              <td className="px-4 py-3 text-action-warning font-medium">{s.gradYear ?? "—"}</td>
                              <td className="px-4 py-3">
                                <span className="surface-card px-2 py-0.5 bg-green-500/15 text-green-400 text-xs font-medium">ACTIVE</span>
                              </td>
                              <td className="px-4 py-3 text-right">
                                <button
                                  onClick={() => handleSingleGraduate(s)}
                                  disabled={singleBusy === s.id}
                                  className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600/20 hover:bg-emerald-500/30 text-action-success text-xs font-medium transition disabled:opacity-50"
                                >
