<file path="src/app/(approver)/principal/_shared/ExceptionsView.tsx">
"use client";

import { useState } from "react";
import { useApiResource } from "@/hooks/useApiResource";
import { useRoleContext } from "@/hooks/useRoleContext";
import { PrincipalEmptyState as EmptyState } from "@/components/principal/shared/PrincipalEmptyState";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { KpiCard } from "./KpiCard";
import { ListSkeleton } from "./ListSkeleton";
import { WeekBar } from "./WeekBar";
import { SmartTextRef } from "@/components/nav/SmartTextRef";
import {
  buildPersonExceptionInspection,
  type PersonExceptionRecord,
  type RoleGate,
} from "./entityInspectionModels";

interface AcademicsResponse {
  success?: boolean;
  data: {
    exceptions: {
      absent: Array<{
        id: string;
        name: string;
        role: string;
        designation: string | null;
        department: string | null;
      }>;
      late: Array<{
        id: string;
        name: string;
        role: string;
        designation: string | null;
        department: string | null;
        minutesLate: number;
      }>;
      flagged: Array<{
        id: string;
        name: string;
        department: string | null;
        reason: string;
      }>;
    };
  };
}

function toPersonException(
  id: string, name: string, role: string, designation: string | null,
  department: string | null, kind: "absent" | "late" | "flagged", detail?: number | string,
): PersonExceptionRecord {
  return { id, name, role, designation, department, exceptionKind: kind, detail };
}

export function ExceptionsView() {
  // KPI drilldown: "Absent" / "Late" / "Flagged" cards filter the register
  // in place (null = show all three sections).
  const [section, setSection] = useState<"absent" | "late" | "flagged" | null>(null);
  const { data, loading } = useApiResource<AcademicsResponse>("/api/vp/academics", {
    ttlMs: 60_000,
  });

  const role = useRoleContext();
  const gate: RoleGate = {
    isPrincipal: role.isPrincipal,
    isFaculty: role.isFaculty,
    role: role.role ?? null,
  };
  const [inspection, setInspection] = useState<
    ReturnType<typeof buildPersonExceptionInspection> | null
  >(null);
  const inspect = (rec: PersonExceptionRecord) =>
    setInspection(buildPersonExceptionInspection(rec, gate));

  const d = data?.data;
  const absent = d?.exceptions?.absent ?? [];
  const late = d?.exceptions?.late ?? [];
  const flagged = d?.exceptions?.flagged ?? [];
  const total = absent.length + late.length + flagged.length;

  const showAbsent = !section || section === "absent";
  const showLate = !section || section === "late";
  const showFlagged = !section || section === "flagged";

  return (
    <div className="space-y-4">
      <WeekBar />
      <header>
        <h1 className="text-lg font-semibold text-text-primary">Attendance exceptions</h1>
        <p className="text-xs text-text-muted">
          {total} exception{total === 1 ? "" : "s"} today · click any person to inspect
        </p>
      </header>

      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <KpiCard
          label="Absent"
          value={absent.length}
          tone="danger"
          drilldown={
            section === "absent"
              ? { label: "Showing absent", onClick: () => setSection(null) }
              : { label: "Show absent", onClick: () => setSection("absent") }
          }
          onClick={() => {
            if (absent.length) inspect(toPersonException(absent[0].id, absent[0].name, absent[0].role, absent[0].designation ?? null, absent[0].department ?? null, "absent"));
          }}
        />
        <KpiCard
          label="Late"
          value={late.length}
          tone="warn"
          drilldown={
            section === "late"
              ? { label: "Showing late", onClick: () => setSection(null) }
              : { label: "Show late", onClick: () => setSection("late") }
          }
          onClick={() => {
            if (late.length) inspect(toPersonException(late[0].id, late[0].name, late[0].role, late[0].designation ?? null, late[0].department ?? null, "late", late[0].minutesLate));
          }}
        />
        <KpiCard
          label="Flagged"
          value={flagged.length}
          tone="info"
          drilldown={
            section === "flagged"
              ? { label: "Showing flagged", onClick: () => setSection(null) }
              : { label: "Show flagged", onClick: () => setSection("flagged") }
          }
          onClick={() => {
            if (flagged.length) inspect(toPersonException(flagged[0].id, flagged[0].name, "", null, flagged[0].department ?? null, "flagged", flagged[0].reason));
          }}
        />
      </div>
      {section && (
        <div className="flex items-center gap-2 text-xs">
          <span className="text-text-muted">Filtering: {section}</span>
          <button
            onClick={() => setSection(null)}
            className="surface-card bg-action-primary/10 px-2 py-0.5 font-medium text-action-primary"
          >
            Show all
          </button>
        </div>
      )}

      {loading && !d ? (
        <ListSkeleton rows={5} />
      ) : total === 0 ? (
        <EmptyState title="No exceptions" description="Everyone checked in on time." />
      ) : (
        <div className="space-y-3">
          {showAbsent && absent.length > 0 && (
            <section className="rounded-2xl border border-border bg-bg-surface">
              <header className="surface-card px-4 py-3">
                <h2 className="text-sm font-semibold">Absent today ({absent.length})</h2>
              </header>
              <ul className="divide-y divide-border">
                {absent.map((p) => (
                  <li
                    key={p.id}
                    className="flex items-center gap-3 px-4 py-2 text-xs cursor-pointer hover:bg-bg-elevated transition-colors"
                    role="button"
                    tabIndex={0}
                    onClick={() =>
                      inspect(
                        toPersonException(p.id, p.name, p.role, p.designation, p.department, "absent")
                      )
                    }
                    onKeyDown={(e) => {
                      if (e.key === "Enter" || e.key === " ")
                        inspect(toPersonException(p.id, p.name, p.role, p.designation, p.department, "absent"));
                    }}
                  >
                    <span className="flex-1 truncate">{p.name}</span>
                    <span className="text-text-muted">
                      {p.designation ?? p.role}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {showLate && late.length > 0 && (
            <section className="rounded-2xl border border-border bg-bg-surface">
              <header className="surface-card px-4 py-3">
                <h2 className="text-sm font-semibold">Late arrivals ({late.length})</h2>
              </header>
              <ul className="divide-y divide-border">
                {late.map((p) => (
                  <li
                    key={p.id}
                    className="flex items-center gap-3 px-4 py-2 text-xs cursor-pointer hover:bg-bg-elevated transition-colors"
                    role="button"
                    tabIndex={0}
                    onClick={() =>
                      inspect(
                        toPersonException(p.id, p.name, p.role, p.designation, p.department, "late", p.minutesLate)
                      )
                    }
                    onKeyDown={(e) => {
                      if (e.key === "Enter" || e.key === " ")
                        inspect(toPersonException(p.id, p.name, p.role, p.designation, p.department, "late", p.minutesLate));
                    }}
                  >
                    <span className="flex-1 truncate">{p.name}</span>
                    <span className="text-action-warning">{p.minutesLate}m late</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {showFlagged && flagged.length > 0 && (
            <section className="rounded-2xl border border-border bg-bg-surface">
              <header className="surface-card px-4 py-3">
                <h2 className="text-sm font-semibold">Flagged ({flagged.length})</h2>
              </header>
              <ul className="divide-y divide-border">
                {flagged.map((p) => (
                  <li
                    key={p.id}
                    className="flex items-center gap-3 px-4 py-2 text-xs cursor-pointer hover:bg-bg-elevated transition-colors"
                    role="button"
                    tabIndex={0}
                    onClick={() =>
                      inspect(toPersonException(p.id, p.name, "", null, p.department, "flagged", p.reason))
                    }
                    onKeyDown={(e) => {
                      if (e.key === "Enter" || e.key === " ")
                        inspect(toPersonException(p.id, p.name, "", null, p.department, "flagged", p.reason));
                    }}
                  >
                    <span className="flex-1 truncate">{p.name}</span>
                    <span className="text-action-danger">
                      <SmartTextRef text={p.reason} currentPath="/principal/people/attendance" />
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      )}

      <EntityInspector inspection={inspection} onClose={() => setInspection(null)} />
    </div>
  );
}
</file>

<file path="src/app/(approver)/principal/_shared/GatesView.tsx">
"use client";

import { useState } from "react";
import Link from "next/link";
import { useApiResource } from "@/hooks/useApiResource";
import { useRoleContext } from "@/hooks/useRoleContext";
import { PrincipalEmptyState as EmptyState } from "@/components/principal/shared/PrincipalEmptyState";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { buildGateInspection } from "@/lib/principal/registerInspections";
import {
  buildGateInspection as buildMainGateInspection,
  type GateRecord as MainGateRecord,
  type RoleGate,
} from "./entityInspectionModels";
import { CommandPivotDrawer, type CommandPivotTarget } from "@/components/nav/level3/CommandPivotDrawer";
import { DataTable } from "@/components/ui/DataTable";
import { KpiCard } from "./KpiCard";
import { ListSkeleton } from "./ListSkeleton";
import { WeekBar } from "./WeekBar";
import { getGateEventRulesForRole } from "@/lib/gate-event-rules";

interface GateRecord {
  id: string;
  name: string;
  code?: string;
  gate_code?: string;
  type?: string;
  audience?: string;
  allowed_radius_meters?: number;
  status?: string;
  is_active?: boolean;
  location?: string;
}

function getVerificationType(g: GateRecord): string {
  const t = (g.type ?? "main").toLowerCase();
  if (t === "hostel") return "QR + Hostel Curfew";
  if (t === "backup") return "Manual PIN + QR";
  if (t === "system") return "System Fallback";
  return "QR + Geo-fence";
}

interface GatesResponse {
  success?: boolean;
  data: GateRecord[];
}

export function GatesView() {
  const { data, loading } = useApiResource<GatesResponse>("/api/gates", {
    ttlMs: 30_000,
  });
  const {
    inspection: ourInspection,
    inspect: ourInspect,
    closeInspection,
  } = useEntityInspector();

  const role = useRoleContext();
  const gateRules = getGateEventRulesForRole(
    { role: role.role ?? "principal" },
    { id: "overview", status: "OPEN" },
  );
  const gate: RoleGate = {
    isPrincipal: role.isPrincipal,
    isFaculty: role.isFaculty,
    role: role.role ?? null,
  };
  const [mainInspection, setMainInspection] = useState<
    ReturnType<typeof buildMainGateInspection> | null
  >(null);
  const [pivot, setPivot] = useState<CommandPivotTarget | null>(null);

  const inspectMain = (g: GateRecord) => {
    setMainInspection(buildMainGateInspection(g as unknown as MainGateRecord, gate));
    setPivot({
      kind: "gate",
      id: g.id,
      title: g.name,
      subtitle: `${g.location ?? g.code ?? "Main Campus"} · ${g.status ?? "ACTIVE"}`,
      fullRoute: `/principal/operations/gates/${g.id}`,
      relatedLinks: [
        { label: "Gate Activity", href: "/principal/operations/gates" },
        { label: "Incidents", href: "/principal/operations/incidents" },
        { label: "Hostel", href: "/principal/operations/hostel" },
        { label: "People", href: "/principal/people" },
        { label: "Approvals", href: "/principal/approvals" },
        { label: "Cases", href: "/principal/cases" },
      ],
    });
  };

  const [filter, setFilter] = useState<"all" | "active" | "review">("all");
  const gates = Array.isArray(data?.data) ? data.data : [];
  const isGateActive = (g: GateRecord) =>
    g.is_active !== false && (g.status === "ACTIVE" || !g.status);
  const activeCount = gates.filter(isGateActive).length;
  const reviewCount = gates.length - activeCount;
  const visibleGates =
    filter === "active"
      ? gates.filter(isGateActive)
      : filter === "review"
        ? gates.filter((g) => !isGateActive(g))
        : gates;
  const openInspector = (g: GateRecord) => inspectMain(g);

  return (
    <div className="space-y-4">
      <WeekBar />
      <header className="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h1 className="text-lg font-semibold text-text-primary">Gate Activity</h1>
          <p className="text-xs text-text-muted">
            Monitored campus entry and exit gates · click any KPI or gate to inspect
          </p>
        </div>
        <Link
          href="/sysadmin/gates"
          className="inline-flex items-center gap-1 rounded-lg border border-border bg-bg-surface px-3 py-1.5 text-xs font-medium text-action-primary hover:bg-bg-elevated"
        >
          Establish Gates (SysAdmin) &rarr;
        </Link>
      </header>

      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <KpiCard
          label="Total Gates"
          value={gates.length}
          onClick={() => setFilter("all")}
        />
        <KpiCard
          label="Operational"
          value={activeCount}
          tone="ok"
          onClick={() => setFilter("active")}
        />
        <KpiCard
          label="Status"
          value={reviewCount === 0 ? "Normal" : `${reviewCount} Review`}
          tone={reviewCount === 0 ? "ok" : "warn"}
          onClick={() => {
            if (reviewCount > 0) setFilter("review");
            else if (gates.length > 0) openInspector(gates[0]);
          }}
        />
      </div>

      {loading && gates.length === 0 ? (
        <ListSkeleton rows={5} />
      ) : visibleGates.length === 0 ? (
        <EmptyState title="No gates match this filter" description="Click Total Gates above to view all configured gates." />
      ) : (
        <>
          <ul className="space-y-2 md:hidden">
            {visibleGates.map((g) => (
              <li key={g.id}>
                <button
                  type="button"
                  onClick={() => openInspector(g)}
                  onKeyDown={(e) => {
                    if (e.key === "Enter" || e.key === " ") openInspector(g);
                  }}
                  aria-label={`Inspect gate: ${g.name}`}
                  className="surface-card block w-full bg-bg-surface p-3 text-left cursor-pointer hover:bg-bg-surface/60 transition-colors"
                >
                  <div className="flex items-center justify-between">
                    <p className="text-sm font-medium">{g.name}</p>
                    <span className="surface-card bg-action-primary/10 px-2 py-0.5 text-xs text-action-primary">
                      {isGateActive(g) ? "ACTIVE" : "INACTIVE"}
                    </span>
                  </div>
                  <p className="mt-1 text-xs text-text-muted">
                    {g.location ?? g.gate_code ?? g.code ?? "Main Campus"} · {getVerificationType(g)}
                  </p>
                  <Link
                    href={`/principal/operations/gates/${g.id}`}
                    onClick={(e) => e.stopPropagation()}
                    className="mt-1.5 inline-block text-xs font-semibold text-action-primary hover:underline"
                  >
                    Open Gate Page &rarr;
                  </Link>
                </button>
              </li>
            ))}
          </ul>

          <div className="hidden md:block">
            <DataTable<GateRecord>
              onRowClick={openInspector}
              columns={[
                { header: "Name", accessor: (r) => r.name },
                { header: "Code", accessor: (r) => r.gate_code ?? r.code ?? "—" },
                { header: "Verification", accessor: (r) => getVerificationType(r) },
                { header: "Audience", accessor: (r) => r.audience ?? "all" },
                { header: "Location", accessor: (r) => r.location ?? "Campus" },
                {
                  header: "Status",
                  accessor: (r) => (
                    <span className="surface-card bg-action-primary/10 px-2 py-0.5 text-xs text-action-primary">
                      {isGateActive(r) ? "ACTIVE" : "INACTIVE"}
                    </span>
                  ),
                },
                {
                  header: "Page",
                  accessor: (r) => (
                    <Link
                      href={`/principal/operations/gates/${r.id}`}
                      onClick={(e) => e.stopPropagation()}
                      className="text-xs font-semibold text-action-primary hover:underline"
                    >
                      Open &rarr;
                    </Link>
                  ),
                },
              ]}
              data={visibleGates}
              keyExtractor={(r) => r.id}
            />
          </div>
        </>
      )}

      <EntityInspectorPanel inspection={ourInspection} onClose={closeInspection} />
      <EntityInspector inspection={mainInspection} onClose={() => { setMainInspection(null); setPivot(null); }} />
      <CommandPivotDrawer target={pivot} onClose={() => setPivot(null)} />
    </div>
  );
}
</file>

<file path="src/app/(approver)/principal/_shared/IncidentsView.tsx">
"use client";

import { useCallback, useState } from "react";
import Link from "next/link";
import { useApiResource } from "@/hooks/useApiResource";
import { useRoleContext } from "@/hooks/useRoleContext";
import { PrincipalEmptyState as EmptyState } from "@/components/principal/shared/PrincipalEmptyState";
import { EntityInspector } from "@/components/shared/EntityInspector";
import { DataTable } from "@/components/ui/DataTable";
import { KpiCard } from "./KpiCard";
import { ListSkeleton } from "./ListSkeleton";
import { WeekBar } from "./WeekBar";
import {
  useEntityInspector,
  EntityInspectorPanel,
} from "@/components/shared/useEntityInspector";
import {
  buildIncidentInspection,
  type AlertRecord as OurAlertRecord,
  type RelatedRecord,
  type IncidentActions,
} from "@/lib/principal/incidentInspection";
import {
  buildIncidentInspection as buildMainIncidentInspection,
  type IncidentRecord,
  type RoleGate,
} from "./entityInspectionModels";
import { CommandPivotDrawer, type CommandPivotTarget } from "@/components/nav/level3/CommandPivotDrawer";
import { SmartTextRef } from "@/components/nav/SmartTextRef";

export interface AlertItem {
  id: string;
  title?: string;
  message?: string;
  severity?: string;
  created_at?: string;
  timestamp?: string;
  status?: string;
  resolved?: boolean;
  gate_id?: string | null;
  gate_name?: string | null;
  gateId?: string | null;
  studentRoll?: string;
}

interface AlertsResponse {
  success?: boolean;
  data: AlertItem[];
}

export function IncidentsView() {
  const { data, loading, refresh } = useApiResource<AlertsResponse>("/api/alerts", {
    ttlMs: 15_000,
  });

  const {
    inspection: ourInspection,
    inspect: ourInspect,
    closeInspection,
  } = useEntityInspector();
  const [, setActing] = useState(false);

  const role = useRoleContext();
  const gate: RoleGate = {
    isPrincipal: role.isPrincipal,
    isFaculty: role.isFaculty,
    role: role.role ?? null,
  };
  const [mainInspection, setMainInspection] = useState<
    ReturnType<typeof buildMainIncidentInspection> | null
  >(null);
  const [pivot, setPivot] = useState<CommandPivotTarget | null>(null);

  const inspectMain = (a: AlertItem) => {
    setMainInspection(
      buildMainIncidentInspection(
        {
          id: a.id,
          title: a.title,
          message: a.message,
          severity: a.severity,
          created_at: a.created_at ?? a.timestamp,
          status: a.status ?? (a.resolved ? "RESOLVED" : "OPEN"),
        } as IncidentRecord,
        gate
      )
    );
    setPivot({
      kind: "gate",
      id: a.gate_id ?? a.gateId ?? a.id,
      title: a.title ?? a.message ?? "Alert",
      subtitle: `${a.severity ?? "alert"} · ${a.status ?? "OPEN"}${a.gate_name ? " · " + a.gate_name : ""}`,
      fullRoute: (a.gate_id ?? a.gateId) ? `/admin/gates/${a.gate_id ?? a.gateId}` : `/admin/alerts`,
      relatedLinks: [
        { label: "Gate Activity", href: "/principal/operations/gates" },
        { label: "Incidents", href: "/principal/operations/incidents" },
        { label: "Hostel", href: "/principal/operations/hostel" },
        { label: "People", href: "/principal/people" },
        { label: "Escalations", href: "/principal/escalations" },
        { label: "Cases", href: "/principal/cases" },
      ],
    });
  };

  const [filter, setFilter] = useState<"all" | "high" | "open" | "resolved">("all");
  const alerts = Array.isArray(data?.data) ? data.data : [];
  const isHigh = (a: AlertItem) =>
    a.severity === "high" || a.severity === "critical";
  const isResolved = (a: AlertItem) =>
    Boolean(a.resolved) || (a.status ?? "").toUpperCase() === "RESOLVED";
  const highSeverity = alerts.filter(isHigh).length;
  const openCount = alerts.filter((a) => !isResolved(a)).length;
  const visibleAlerts = alerts.filter((a) => {
    if (filter === "high") return isHigh(a);
    if (filter === "open") return !isResolved(a);
    if (filter === "resolved") return isResolved(a);
    return true;
  });

  /**
   * Resolve the related records for an alert, honestly. The alert row carries
   * gateId + studentRoll; we look them up by id/roll. A failed/absent lookup
   * is marked unavailable (never a fabricated link).
   */
  const openInspector = useCallback(
    async (alert: AlertItem) => {
      const gId = alert.gateId ?? alert.gate_id;
      const related: RelatedRecord[] = [];
      if (gId) {
        related.push({
          kind: "gate",
          id: gId,
          label: "Gate",
          subtitle: gId,
        });
      }
      if (alert.studentRoll) {
        related.push({
          kind: "student",
          id: alert.studentRoll,
          label: "Student",
          subtitle: alert.studentRoll,
        });
      }
      // Honest actions: acknowledge/resolve exist for unresolved alerts.
      const actions: IncidentActions = {
        acknowledge: {
          available: !alert.resolved,
          reason: alert.resolved ? "already resolved" : undefined,
        },
        resolve: {
          available: !alert.resolved,
          reason: alert.resolved ? "already resolved" : undefined,
        },
      };
      ourInspect(
        buildIncidentInspection({
          alert: {
            ...alert,
            gateId: gId,
          } as OurAlertRecord,
          related,
          actions,
          detailHref: gId ? `/principal/operations/gates/${gId}` : undefined,
          detailLabel: gId ? "Open gate page" : undefined,
        })
      );
    },
    [ourInspect]
  );

  // Re-sync after an action so the register reflects the new state.
  const onActionComplete = useCallback(() => {
    setActing(false);
    closeInspection();
    refresh();
  }, [closeInspection, refresh]);

  return (
    <div className="space-y-4">
      <WeekBar />
      <header className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 className="text-lg font-semibold text-text-primary">Incidents &amp; Alerts</h1>
          <p className="text-xs text-text-muted">
            Real-time institutional and security alerts · filter or select any alert to inspect
          </p>
        </div>
        <nav className="flex flex-wrap items-center gap-1.5" aria-label="Incident filters">
          {[
            { key: "all" as const, label: "All", count: alerts.length },
            { key: "high" as const, label: "Critical / High", count: highSeverity },
            { key: "open" as const, label: "Open", count: openCount },
            { key: "resolved" as const, label: "Resolved", count: alerts.length - openCount },
          ].map((tab) => (
            <button
              key={tab.key}
              type="button"
              onClick={() => setFilter(tab.key)}
              className={`inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1 text-xs font-medium transition-colors ${
                filter === tab.key
                  ? "border-action-primary bg-action-primary/10 text-action-primary"
                  : "border-border bg-bg-surface text-text-secondary hover:bg-bg-elevated"
              }`}
            >
              <span>{tab.label}</span>
              <span className="font-mono text-[11px] opacity-80">{tab.count}</span>
            </button>
          ))}
        </nav>
      </header>

      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <KpiCard label="Active Alerts" value={alerts.length} onClick={() => setFilter("all")} />
        <KpiCard
          label="Critical / High"
          value={highSeverity}
          tone={highSeverity > 0 ? "danger" : "ok"}
          onClick={() => setFilter("high")}
        />
        <KpiCard
          label="Status"
          value={highSeverity > 0 ? "Requires Attention" : "All Clear"}
          tone={highSeverity > 0 ? "warn" : "ok"}
          onClick={() => setFilter("open")}
        />
      </div>

      {loading && alerts.length === 0 ? (
        <ListSkeleton rows={5} />
      ) : visibleAlerts.length === 0 ? (
        <EmptyState title="No matching alerts" description="No campus alerts match the selected filter." />
      ) : (
        <>
          <ul className="space-y-2 md:hidden">
            {visibleAlerts.map((a) => (
              <li key={a.id}>
                <button
                  type="button"
                  onClick={() => openInspector(a)}
                  onKeyDown={(e) => {
                    if (e.key === "Enter" || e.key === " ") openInspector(a);
                  }}
                  aria-label={`Inspect alert: ${a.title ?? a.message ?? "alert"}`}
                  className="surface-card w-full min-h-11 bg-bg-surface p-3 text-left cursor-pointer hover:bg-bg-surface/60 transition-colors"
                >
                  <div className="flex items-start justify-between">
                    <p className="text-sm font-medium">
                      <SmartTextRef text={a.title ?? a.message ?? "Alert"} currentPath="/principal/operations/incidents" />
                    </p>
                    <span className="surface-card bg-action-danger/10 px-2 py-0.5 text-xs text-action-danger">
                      {a.severity ?? "alert"}
                    </span>
                  </div>
                  {a.message && a.title ? (
                    <p className="mt-1 line-clamp-2 text-xs text-text-secondary">
                      <SmartTextRef text={a.message} currentPath="/principal/operations/incidents" />
                    </p>
                  ) : null}
                  {a.gate_name || a.gate_id || a.gateId ? (
                    <p className="mt-1 text-xs font-mono text-text-muted">
                      {a.gate_name ?? a.gate_id ?? a.gateId}
                    </p>
                  ) : null}
                </button>
              </li>
            ))}
          </ul>

          <div className="hidden md:block">
            <DataTable<AlertItem>
              onRowClick={(a) => openInspector(a)}
              columns={[
                {
                  header: "Title",
                  accessor: (r) => <SmartTextRef text={r.title ?? r.message ?? "Alert"} currentPath="/principal/operations/incidents" />,
                },
                {
                  header: "Severity",
                  accessor: (r) => (
                    <span className="surface-card bg-action-danger/10 px-2 py-0.5 text-xs text-action-danger">
                      {r.severity ?? "normal"}
                    </span>
                  ),
                },
                {
                  header: "Gate",
                  accessor: (r) => {
                    const gId = r.gate_id ?? r.gateId;
                    const label = r.gate_name ?? gId;
                    return gId ? (
                      <Link
                        href={`/principal/operations/gates/${gId}`}
                        onClick={(e) => e.stopPropagation()}
                        className="font-mono text-xs text-action-primary hover:underline"
                      >
                        {label}
                      </Link>
                    ) : (
                      "—"
                    );
                  },
                },
                {
                  header: "Status",
                  accessor: (r) => r.status ?? (isResolved(r) ? "RESOLVED" : "OPEN"),
                },
                {
                  header: "Overview",
                  accessor: (r) => (
                    <button
                      type="button"
                      onClick={(e) => {
                        e.stopPropagation();
                        openInspector(r);
                      }}
                      className="text-xs font-semibold text-action-primary hover:underline"
                    >
                      Open &rarr;
                    </button>
                  ),
                },
              ]}
              data={visibleAlerts}
              keyExtractor={(r) => r.id}
            />
          </div>
        </>
      )}

      {/* The incident inspector drawer (overview → context → actions). */}
      <EntityInspectorPanel inspection={ourInspection} onClose={onActionComplete} />
      <EntityInspector inspection={mainInspection} onClose={() => { setMainInspection(null); setPivot(null); }} />
      <CommandPivotDrawer target={pivot} onClose={() => setPivot(null)} />
    </div>
  );
}
</file>

