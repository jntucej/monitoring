<file path="src/components/shared/EditableField.tsx">
/**
 * EditableField — inline display-or-edit field with mandatory reason.
 * Shows value + PencilButton; on edit, reveals input + reason + Save/Cancel.
 * Use for any single-field edit-with-audit in a dashboard.
 */
"use client";

import React, { useState } from "react";
import { Pencil, Check, X, Loader2 } from "lucide-react";
import { cn } from "@/lib/utils";

export interface EditableFieldProps {
  /** Displayed value (pre-edit). */
  value: string;
  /** Called with new value + reason on save. */
  onSave: (newValue: string, reason: string) => Promise<void> | void;
  /** Human label shown in reason prompt. */
  fieldLabel?: string;
  className?: string;
  /** Prefix icon or badge rendered before the value. */
  prefix?: React.ReactNode;
}

export function EditableField({
  value,
  onSave,
  fieldLabel = "field",
  className,
  prefix,
}: EditableFieldProps) {
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState(value);
  const [reason, setReason] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const start = () => {
    setDraft(value);
    setReason("");
    setError(null);
    setEditing(true);
  };

  const save = async () => {
    if (!reason.trim()) return setError("Reason required");
    setBusy(true);
    setError(null);
    try {
      await onSave(draft, reason.trim());
      setEditing(false);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Failed to save");
    } finally {
      setBusy(false);
    }
  };

  if (editing) {
    return (
      <div className={cn("space-y-2", className)}>
        <div className="flex items-center gap-2">
          {prefix}
          <input
            value={draft}
            onChange={(e) => setDraft(e.target.value)}
            autoFocus
            className="w-full rounded-lg border border-border bg-bg-elevated px-3 py-1.5 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-action-primary"
          />
          <button
            type="button"
            onClick={save}
            disabled={busy || !draft.trim() || !reason.trim()}
            className="inline-flex items-center gap-1 rounded-lg bg-action-primary px-2.5 py-1.5 text-xs font-medium text-white disabled:opacity-50"
          >
            {busy ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Check className="h-3.5 w-3.5" />}
            Save
          </button>
          <button
            type="button"
            onClick={() => setEditing(false)}
            className="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs text-text-muted hover:text-text-primary"
          >
            <X className="h-3.5 w-3.5" />
          </button>
        </div>
        <input
          value={reason}
          onChange={(e) => setReason(e.target.value)}
          placeholder={`Reason for editing ${fieldLabel} (required)`}
          className="w-full rounded-lg border border-border bg-bg-elevated px-3 py-1.5 text-xs text-text-primary placeholder:text-text-muted/60 focus:outline-none focus:ring-1 focus:ring-amber-500"
        />
        {error && <p className="text-xs text-rose-500">{error}</p>}
      </div>
    );
  }

  return (
    <div className={cn("group flex items-center gap-1.5", className)}>
      {prefix}
      <span className="text-sm text-text-primary">{value}</span>
      <button
        type="button"
        onClick={start}
        aria-label={`Edit ${fieldLabel}`}
        className="opacity-0 group-hover:opacity-100 transition-opacity text-text-muted hover:text-action-primary"
      >
        <Pencil className="h-3.5 w-3.5" />
      </button>
    </div>
  );
}

export default EditableField;
</file>

<file path="src/components/shared/ElasticPill.tsx">
"use client";

import { motion } from "framer-motion";
import { cn } from "@/lib/utils";

export interface ElasticPillProps {
  label: string;
  color?: "emerald" | "rose" | "amber" | "slate" | "indigo";
  onClick?: () => void;
  className?: string;
  icon?: React.ReactNode;
}

/**
 * Spring-driven interactive status pill.
 * Stretches on tap/click with spring physics for quick operational actions.
 */
export function ElasticPill({
  label,
  color = "emerald",
  onClick,
  className = "",
  icon,
}: ElasticPillProps) {
  const colorStyles = {
    emerald: "bg-emerald-500/10 border-emerald-500/30 text-action-success hover:bg-emerald-500/20",
    rose: "bg-rose-500/10 border-rose-500/30 text-action-danger hover:bg-rose-500/20",
    amber: "bg-amber-500/10 border-amber-500/30 text-action-warning hover:bg-amber-500/20",
    slate: "bg-bg-elevated/10 border-border/30 text-text-secondary hover:bg-bg-elevated/20",
    indigo: "bg-indigo-500/10 border-indigo-500/30 text-indigo-400 hover:bg-indigo-500/20",
  };

  return (
    <motion.button
      type="button"
      onClick={onClick}
      whileHover={{ scale: 1.05, y: -2 }}
      whileTap={{ scale: 0.92 }}
      transition={{ type: "spring", stiffness: 500, damping: 18 }}
      className={cn(
        "inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full backdrop-blur-md border text-xs font-mono tracking-wider uppercase font-semibold transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 select-none",
        colorStyles[color],
        className
      )}
    >
      {icon}
      <span>{label}</span>
    </motion.button>
  );
}

export default ElasticPill;
