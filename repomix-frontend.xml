<file path="src/app/(approver)/deputy-warden/shift-handover/page.tsx">
"use client";

import { Suspense, useCallback } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";

import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import Link from "next/link";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { useEntityInspector, EntityInspectorPanel } from "@/components/shared/useEntityInspector";
import { buildDeputyWardenHandoverInspection } from "@/lib/role-registers/deputyWardenInspections";
import {
  ShieldCheck,
  Inbox,
  Loader2,
  ArrowRight,
  AlertTriangle
} from "lucide-react";
import { shiftHandoverInspection } from "@/components/approver/wardenConsoleModels";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

/* response shapes (mirror /api/campus-extra/handover) */

interface HandoverItem {
  type: string;
  title: string;
  details?: string;
  severity?: string;
}

interface HandoverRecord {
  id: string;
  toRole: string;
  items: HandoverItem[];
  notes?: string | null;
  byName?: string | null;
  createdAt: string;
}

interface HandoverResponse {
  success: boolean;
  data: { handovers: HandoverRecord[] };
}

function DeputyWardenHandoverInner() {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "deputy_warden") as Role;
  const tier = getRoleTier(role);
  const { inspection, inspect, closeInspection } = useEntityInspector();

  const {
    data,
    loading,
    error,
    refresh,
  } = useApiResource<HandoverResponse>("/api/campus-extra/handover?to_role=deputy_warden", {
    ttlMs: 30_000
  });

  const refreshAll = useCallback(async () => {
    clearCache();
    await refresh();
  }, [refresh]);

  usePolling(refreshAll, { intervalMs: 30_000, enabled: !!user });

  const busy = loading && !data;

  return (
    <div className="mx-auto max-w-7xl w-full min-w-0 overflow-x-hidden space-y-6 px-4 py-6 md:px-6">
      {/* Back link */}
      <Link
        href="/deputy-warden/daily-overview"
        className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary transition-colors"
      >
        <ArrowRight className="size-3.5 rotate-180" /> Back to Daily Overview
      </Link>

      {/* Page toolbar */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between min-w-0">
        <div className="min-w-0">
          <p className="mt-1 text-sm text-text-muted min-w-0">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      <ContextSituationBar
        roleLabel="Deputy Warden"
        purpose="Review shift logs, maintain continuity across warden shifts, and record operational handover briefings"
        why="Structured shift logs ensure critical events, pending curfews, and gate flags carry over seamlessly between wardens."
        contextLabel={`Shift Continuity · ${(data?.data?.handovers ?? []).length} Recorded (7d)`}
        statusSummary="Inspect operator and supervisor shift handovers, log critical hostel observations, and ensure operational readiness."
        severity="info"
        primaryAction={{ label: "Daily Overview", href: "/deputy-warden/daily-overview" }}
        secondaryActions={[
          { label: "Incident Reporting", href: "/deputy-warden/incident-reporting" },
          { label: "Curfew Oversight", href: "/deputy-warden/curfew-oversight" },
        ]}
      />

      {error && (
        <div className="surface-card bg-amber-500/10 p-3 text-sm text-action-warning flex flex-wrap items-center justify-between gap-2 min-w-0">
          <span className="flex items-center gap-2 min-w-0">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span className="truncate">
              {/403|forbidden/i.test(error)
                ? "Shift handover records are restricted to supervisors and hostel managers."
                : `Handover data unavailable: ${error}`}
            </span>
          </span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card px-3 py-1 text-xs font-semibold hover:bg-amber-500/20 shrink-0"
          >
            Retry
          </button>
        </div>
      )}

      <WidgetBoundary title="Handover">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex flex-wrap items-center justify-between gap-2 min-w-0">
            <div className="flex items-center gap-2 min-w-0">
              <ShieldCheck className="w-4 h-4 text-action-success shrink-0" />
              <span className="text-sm font-semibold text-white truncate">Shift Handover</span>
            </div>
            <span className="text-xs text-text-muted shrink-0">
              {(data?.data?.handovers ?? []).length} handover(s) · 7-day window
            </span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" /> Loading Shift Handover…
            </div>
          ) : (data?.data?.handovers ?? []).length === 0 ? (
            <div className="p-6 text-center min-w-0">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">
                No shift handovers recorded in the last 7 days. End-of-shift notes from operators
                and supervisors will appear here.
              </p>
            </div>
          ) : (
            <div className="p-4 space-y-3 min-w-0">
              {(data?.data?.handovers ?? []).map((h) => (
                <div
                  key={h.id}
                  onClick={() => inspect(buildDeputyWardenHandoverInspection(h))}
                  onKeyDown={(e) => {
                    if (e.key === "Enter" || e.key === " ") {
                      e.preventDefault();
                      inspect(buildDeputyWardenHandoverInspection(h));
                    }
                  }}
                  tabIndex={0}
                  role="button"
                  aria-label={`Inspect shift handover from ${h.byName ?? "previous shift"}`}
                  className="surface-card bg-bg-surface/40 p-3 min-w-0 cursor-pointer hover:bg-bg-elevated/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary"
                >
                  <div className="flex flex-wrap items-center justify-between gap-2 min-w-0">
                    <p className="text-sm font-semibold text-white min-w-0">
                      {h.byName ? `From ${h.byName}` : "From previous shift"}
                      <span className="ml-2 text-xs font-normal text-text-muted">{new Date(h.createdAt).toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })}</span>
                    </p>
                    <span className="text-xs text-text-muted">{(h.items ?? []).length} item(s)</span>
                  </div>
                  {h.notes ? <p className="mt-1 text-xs text-text-muted">{h.notes}</p> : null}
                  {(h.items ?? []).length > 0 ? (
                    <ul className="mt-2 space-y-1 min-w-0">
                      {(h.items ?? []).map((it, i) => (
                        <li key={i} className="text-xs text-text-muted min-w-0">
                          <span className="text-text-muted font-mono">{it.type}</span> · {it.title}
                          {it.details ? <span className="text-text-muted"> — {it.details}</span> : null}
                        </li>
                      ))}
                    </ul>
                  ) : null}
                </div>
              ))}
            </div>
          )}
        </div>
      </WidgetBoundary>

      <EntityInspectorPanel inspection={inspection} onClose={closeInspection} />
    </div>
  );
}
export default function DeputyWardenHandoverPage() {
  return (
    <AuthGuard allowedRoles={['deputy_warden', 'admin', 'sysadmin']}>
      <Suspense fallback={<PageLoading />}>
        <DeputyWardenHandoverInner />
      </Suspense>
    </AuthGuard>
  );
}
</file>

