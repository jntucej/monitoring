              </div>

              <div className="overflow-x-auto min-w-0">
                <table className="w-full text-sm min-w130">
                  <thead>
                    <tr className="border-b border-border text-text-muted text-xs uppercase tracking-wide">
                      <th className="text-left px-4 py-2.5">Item</th>
                      <th className="text-left px-4 py-2.5">Code</th>
                      <th className="text-left px-4 py-2.5">Type</th>
                      <th className="text-left px-4 py-2.5">Scheduled Days</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60">
                    {items.map((item) => (
                      <tr key={item.id} className="hover:bg-bg-elevated/30 transition-colors cursor-pointer" onClick={() => inspectItem(item)}>
                        <td className="px-4 py-3 text-text-secondary font-medium min-w-0 truncate">{item.label}</td>
                        <td className="px-4 py-3 text-text-muted font-mono text-xs whitespace-nowrap">{item.code}</td>
                        <td className="px-4 py-3 whitespace-nowrap">
                          {item.isPrimary ? (
                            <span className="surface-card inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-amber-400/10 text-action-warning">
                              <CheckCircle2 className="size-3.5" /> Primary
                            </span>
                          ) : (
                            <span className="surface-card inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-bg-elevated/20 text-text-muted">
                              Add-on
                            </span>
                          )}
                        </td>
                        <td className="px-4 py-3 text-text-muted">
                          {item.scheduledDays > 0 ? (
                            <span className="text-action-success">{item.scheduledDays} day(s)</span>
                          ) : (
                            <span className="text-text-muted">Not scheduled</span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div className="surface-card px-4 py-3 text-xs text-text-muted min-w-0">
                Stock state mirrors the active menu-item catalog. Use{" "}
                <Link href="/mess/operational-requests" className="text-action-success hover:underline">
                  Operational Requests
                </Link>{" "}
                to flag stock shortfalls to the caretaker / facilities authority.
              </div>
            </div>
          ) : (
            <div className="p-8 text-center">
              <Inbox className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted max-w-md mx-auto">
