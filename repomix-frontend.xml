<file path="src/app/(student)/student/qr/page.tsx">
"use client";

import { useEffect, useState } from "react";

export default function StudentQrPage() {
  const [tab, setTab] = useState<"identity" | "mess">("identity");
  const [identityQr, setIdentityQr] = useState<{ qr: string; roll: string; salt_day: string } | null>(null);
  const [messQr, setMessQr] = useState<{ qr: string; expires_in_s: number } | null>(null);
  const [messErr, setMessErr] = useState<string | null>(null);

  useEffect(() => {
    fetch("/api/qr/me/identity")
      .then((r) => r.json())
      .then((j) => {
        if (j?.data?.qr) setIdentityQr(j.data);
      })
      .catch(() => {});
  }, []);

  useEffect(() => {
    if (tab !== "mess") return;
    const load = () => {
      fetch("/api/mess/my-qr")
        .then((r) => r.json())
        .then((j) => {
          if (j?.data?.qr) {
            setMessQr(j.data);
            setMessErr(null);
          } else {
            setMessQr(null);
            setMessErr(j?.error?.message ?? "Mess token unavailable");
          }
        })
        .catch(() => setMessErr("Failed to load mess QR"));
    };
    load();
    const id = setInterval(load, 15_000);
    return () => clearInterval(id);
  }, [tab]);

  return (
    <div className="mx-auto max-w-lg space-y-6 p-6">
      <div className="flex items-center justify-between">
        <h1 className="text-xl font-bold text-foreground">My QR Codes</h1>
        <div className="flex gap-2">
          {(["identity", "mess"] as const).map((t) => (
            <button
              key={t}
              type="button"
              onClick={() => setTab(t)}
              className={`px-3 py-1 text-xs font-semibold uppercase border ${
                tab === t
                  ? "border-primary bg-primary text-primary-foreground"
                  : "border-border bg-card text-foreground"
              }`}
            >
              {t}
            </button>
          ))}
        </div>
      </div>

      {tab === "identity" && identityQr && (
        <div className="space-y-2 border border-border bg-card p-5 text-center">
          <div className="text-sm font-semibold text-foreground">Roll: {identityQr.roll}</div>
          <div className="break-all bg-muted p-3 font-mono text-xs text-foreground">{identityQr.qr}</div>
          <div className="text-xs text-muted-foreground">Daily salted identity QR ({identityQr.salt_day})</div>
        </div>
      )}

      {tab === "mess" && (
        <div className="space-y-2 border border-border bg-card p-5 text-center">
          {messErr ? (
            <div className="text-sm text-destructive">{messErr}</div>
          ) : messQr ? (
            <>
              <div className="break-all bg-muted p-3 font-mono text-xs text-foreground">{messQr.qr}</div>
              <div className="text-xs text-muted-foreground">Rotates every 30s (~{messQr.expires_in_s}s left)</div>
            </>
          ) : (
            <div className="text-sm text-foreground">Loading mess QR...</div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/app/(student)/student/recap/page.tsx">
"use client";

import { useState } from "react";
import { useApiResource } from "@/hooks/useApiResource";
import { PageLoading } from "@/components/shared/LoadingStates";
import { useIsSakuga } from "@/components/student/useIsSakuga";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
import { Share2 } from "lucide-react";

interface RecapPayload {
  data: {
    userName: string;
    role: string;
    periodLabel: string;
    completedEvents: string[];
    earnedAchievements: Array<{ code: string; title: string; icon: string | null }>;
    completedGoals: number;
    totalGoals: number;
    eventsRegistered: number;
  };
}

// Shareable, non-surveillance recap.
export default function RecapPage() {
  const isSakuga = useIsSakuga();
  const [mood, setMood] = useState(3);

  const { data, loading } = useApiResource<RecapPayload>("/api/campus/recap", {
    ttlMs: 60_000,
  });
  if (loading || !data?.data) return <PageLoading />;
  const r = data.data;
  const share = async () => {
    const text = `${r.userName} · ${r.periodLabel}
${r.eventsRegistered} events attended
${r.earnedAchievements.length} achievements
${r.completedGoals}/${r.totalGoals} goals completed`;
    if (navigator.share) await navigator.share({ title: "Semester Recap", text });
    else await navigator.clipboard.writeText(text);
  };
  return (
    <div className="mx-auto max-w-md space-y-4 p-4">
      <ContextSituationBar
        roleLabel="Student"
        purpose="Review semester milestones, events attended, goals achieved, and share your recap summary"
        contextLabel="Semester Reflection & Recap"
        severity="ok"
        statusPill={r.periodLabel}
        statusSummary={`${r.eventsRegistered} events attended, ${r.earnedAchievements.length} achievements earned, and ${r.completedGoals}/${r.totalGoals} goals finished.`}
        why="Your recap synthesizes co-curricular involvement, community milestones, and participation stats for your personal student portfolio."
        primaryAction={{ label: "Achievements", href: "/student/achievements" }}
        secondaryAction={{ label: "Student Home", href: "/student" }}
      />
      <div className="surface-card bg-surface-muted p-6">
        <p className="text-xs uppercase tracking-wide text-text-muted">
          {r.periodLabel}
        </p>
        <h1 className="mt-1 text-2xl font-bold text-text-primary">
          {r.userName}
        </h1>
        <p className="text-sm text-text-secondary">{r.role}</p>
        <dl className="mt-6 grid grid-cols-3 gap-2 text-center">
          <div>
            <dt className="text-xs text-text-muted">Events</dt>
            <dd className="text-xl font-bold">{r.eventsRegistered}</dd>
          </div>
          <div>
            <dt className="text-xs text-text-muted">Achievements</dt>
            <dd className="text-xl font-bold">{r.earnedAchievements.length}</dd>
          </div>
          <div>
            <dt className="text-xs text-text-muted">Goals</dt>
            <dd className="text-xl font-bold">
              {r.completedGoals}/{r.totalGoals}
            </dd>
          </div>
        </dl>
        {isSakuga && (
          <div className="mt-5 flex items-center justify-between border-t border-border/60 pt-4">
            <div>
              <p className="text-xs font-semibold text-text-muted">How&apos;s your semester?</p>
              <p className="text-xs text-text-muted">{mood}/5</p>
            </div>
            <sakuga-rating
              value={mood}
              label="semester mood"
              onChange={((e: unknown) => setMood((e as any).target?.value ? +(e as any).target.value : 0)) as any}
            >
              ★
            </sakuga-rating>
          </div>
        )}
      </div>
      <button
        onClick={share}
        className="surface-card inline-flex w-full items-center justify-center gap-2 px-4 py-3 text-sm"
      >
        <Share2 className="h-4 w-4" aria-hidden /> Share
      </button>
    </div>
  );
}
