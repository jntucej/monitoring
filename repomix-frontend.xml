<file path="src/components/sysadmin/ScheduledJobs.tsx">
"use client";
import { errMsg } from "@/lib/err-msg";

import { useState, useEffect, useCallback } from "react";
import { useUIStore } from "@/stores/uiStore";
import { Clock, Play, RefreshCw, CheckCircle2, XCircle } from "lucide-react";
import { useApi } from "@/hooks/useApi";

interface Job {
  id: string;
  name: string;
  description: string;
  cron_expression: string;
  enabled: boolean;
  last_run: string | null;
  next_run: string | null;
}

interface JobRun {
  id: string;
  job_id: string;
  status: "SUCCESS" | "FAILED" | "RUNNING";
  start_time: string;
  end_time: string | null;
  error_message: string | null;
}

export function ScheduledJobs() {
const api = useApi();

  const { addToast } = useUIStore();

  const [jobs, setJobs] = useState<Job[]>([]);
  const [runs, setRuns] = useState<JobRun[]>([]);
  const [loading, setLoading] = useState(true);
  const [runningJobId, setRunningJobId] = useState<string | null>(null);

  const fetchJobs = useCallback(async () => {
    setLoading(true);
    try {
      const headers = api.getHeaders();
      const res = await fetch("/api/admin/jobs", { headers });
      const data = await res.json();
      if (res.ok && data.success && data.data) {
        setJobs(data.data.jobs || []);
        setRuns(data.data.recentRuns || []);
      }
    } catch {
      // Best effort
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchJobs();
  }, [fetchJobs]);

  const handleToggleJob = async (jobId: string, currentEnabled: boolean) => {
    try {
      const headers = {
        ...api.getHeaders(),
        "Content-Type": "application/json",
      };
      const res = await fetch(`/api/admin/jobs/${jobId}`, {
        method: "PATCH",
        headers,
        body: JSON.stringify({ enabled: !currentEnabled }),
      });

      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error?.message || "Failed to toggle job state");

      addToast({ title: "Success", message: `Job ${!currentEnabled ? "enabled" : "disabled"}`, variant: "success" });
      fetchJobs();
    } catch (err) {
      addToast({ title: "Error", message: errMsg(err), variant: "error" });
    }
  };

  const handleRunNow = async (jobId: string) => {
    setRunningJobId(jobId);
    try {
      const headers = api.getHeaders();
      const res = await fetch(`/api/admin/jobs/${jobId}/run`, { method: "POST", headers });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error?.message || "Failed to execute job");

      addToast({ title: "Execution Triggered", message: `Job '${jobId}' ran successfully`, variant: "success" });
      fetchJobs();
    } catch (err) {
      addToast({ title: "Run Failed", message: errMsg(err), variant: "error" });
    } finally {
      setRunningJobId(null);
    }
  };

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="surface-card flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-bg-surface p-6">
        <div>
          <h2 className="text-xl font-bold text-white flex items-center gap-2">
            <Clock className="w-6 h-6 text-action-info" /> Scheduled Background Jobs
          </h2>
          <p className="text-xs text-text-muted mt-1">
            Automated maintenance tasks, daily stats generation, and system cleanups
          </p>
        </div>
        <button
          onClick={fetchJobs}
          disabled={loading}
          className="surface-card inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-action-info text-white text-xs font-bold transition-all disabled:opacity-50 self-start sm:self-auto"
        >
          <RefreshCw className={`w-4 h-4 ${loading ? "animate-spin" : ""}`} /> Refresh Jobs
        </button>
      </div>

      {/* Jobs Table */}
      <div className="bg-bg-surface border border-border rounded-2xl overflow-hidden">
        <div className="surface-card p-4 bg-bg-elevated/40 font-bold text-xs text-white">
          Active Background Tasks
        </div>
        {loading ? (
          <div className="py-12 text-center text-xs text-text-muted">Loading background jobs...</div>
        ) : jobs.length === 0 ? (
          <div className="py-12 text-center text-xs text-text-muted">No scheduled jobs registered.</div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs min-w-[650px]">
              <thead>
                <tr className="border-b border-border text-text-muted">
                  <th className="p-4">Job Name</th>
                  <th className="p-4">Cron Schedule</th>
                  <th className="p-4">Last Run</th>
                  <th className="p-4">State</th>
                  <th className="p-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {jobs.map((job) => (
                  <tr key={job.id} className="hover:bg-bg-elevated/30 transition-colors">
                    <td className="p-4 font-bold text-white">
                      {job.name}
                      <span className="block text-xs text-text-muted font-normal">{job.description}</span>
                    </td>
                    <td className="p-4 font-mono text-xs text-action-info">{job.cron_expression}</td>
                    <td className="p-4 font-mono text-xs text-text-muted">
                      {job.last_run ? new Date(job.last_run).toLocaleString() : "Never"}
                    </td>
                    <td className="p-4">
                      <button
                        onClick={() => handleToggleJob(job.id, job.enabled)}
                        className={`px-3 py-1 rounded-full text-xs font-bold uppercase border transition-all ${
                          job.enabled
                            ? "bg-emerald-500/20 text-action-success border-emerald-500/30"
                            : "bg-bg-elevated0/20 text-text-muted border-border/30"
                        }`}
                      >
                        {job.enabled ? "ENABLED" : "DISABLED"}
                      </button>
                    </td>
                    <td className="p-4 text-right">
                      <button
                        onClick={() => handleRunNow(job.id)}
                        disabled={runningJobId === job.id}
                        className="surface-card inline-flex items-center gap-1.5 px-3 py-1.5 bg-sky-600 hover:bg-action-info text-white font-bold text-xs disabled:opacity-50"
                      >
                        <Play className={`size-3.5 ${runningJobId === job.id ? "animate-spin" : ""}`} /> Run Now
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
      {/* Runs Table */}
      <div className="surface-card bg-bg-surface p-6 space-y-4">
        <h3 className="font-bold text-sm text-white flex items-center gap-2">
          <Clock className="w-4 h-4 text-unit-c" /> Execution History (Last 10 Runs)
        </h3>
        {runs.length === 0 ? (
          <div className="surface-card py-6 text-center text-xs text-text-muted">
            No recent job executions recorded.
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead>
                <tr className="border-b border-border text-text-muted">
                  <th className="pb-2">Job ID</th>
                  <th className="pb-2">Status</th>
                  <th className="pb-2">Time</th>
                  <th className="pb-2 text-right">Details</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {runs.map((r) => (
                  <tr key={r.id} className="hover:bg-bg-elevated/50 transition-colors">
                    <td className="py-2.5 font-mono text-white font-bold">{r.job_id}</td>
                    <td className="py-2.5">
                      {r.status === "SUCCESS" ? (
                        <span className="inline-flex items-center gap-1 text-action-success font-bold text-xs">
                          <CheckCircle2 className="size-3.5" /> SUCCESS
                        </span>
                      ) : (
                        <span className="inline-flex items-center gap-1 text-action-danger font-bold text-xs">
                          <XCircle className="size-3.5" /> FAILED
                        </span>
                      )}
                    </td>
                    <td className="py-2.5 font-mono text-xs text-text-muted">
                      {new Date(r.start_time).toLocaleString()}
                    </td>
                    <td className="py-2.5 text-right text-xs text-text-muted">
                      {r.error_message || "Completed in < 5s"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/sysadmin/ScheduledJobsPanel.tsx">
"use client";

/**
 * Scheduled JobsPanel — advanced interactive resource panel.
 * -----------------------------------------------------------------------------
 * Generated by scripts/scaffold-panel.mjs
 *
 * Composes:
 *   • 3–6 animated KPI cards
 *   • Search + status/category/sort toolbar
 *   • Per-row actions: pause/resume, run-now, edit schedule
 *   • Expandable inline run history
 *   • Global recent-activity feed
 *   • Modal editor with cron presets + human preview
 *   • "Showing seed data" banner when the API returns no rows
 *
 * Wire-up:
 *   <ScheduledJobsPanel />  ← drop into any (sysadmin) page
 * SCAFFOLD:PANEL — safe to edit; regenerating with --force will overwrite.
 */

import { useEffect, useState, useCallback, useMemo } from "react";
import { motion, AnimatePresence } from "framer-motion";
import {
  Clock, Play, Pause, RefreshCw, CheckCircle2, XCircle, Loader2,
  Search, Filter, ChevronDown, ChevronRight, Zap, Shield, Bell,
  BarChart3, Trash2, Settings2, Activity, AlertTriangle, History,
  CalendarClock, Timer, TrendingUp, CircleDot, Info,
} from "lucide-react";
import { useUIStore } from "@/stores/uiStore";
import { useAuthStore } from "@/stores/authStore";

import {
  describeCron,
  CRON_PRESETS,
  type ScheduledJobSeed,
  type ScheduledJobRunSeed,
  type ScheduledJobStatus,
  type ScheduledJobCategory,
} from "@/lib/scheduled-jobs-data";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Modal } from "@/components/ui/modal";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";

/* ── Types ────────────────────────────────────────────────────────────── */
type Row = ScheduledJobSeed;
type Run = ScheduledJobRunSeed;

interface ApiRow {
  id: string;
  name: string;
  description: string;
  cron_expression: string;
  enabled: boolean;
  last_run: string | null;
  next_run: string | null;
}

/* ── Utilities ────────────────────────────────────────────────────────── */
function getHeaders(): Record<string, string> {
  const state = useAuthStore.getState();
  const headers: Record<string, string> = { "Content-Type": "application/json" };
  if (state.token) headers["Authorization"] = `Bearer ${state.token}`;
  if (state.user?.currentSessionToken) headers["X-Session-Token"] = state.user.currentSessionToken;
  return headers;
}

function timeAgo(iso: string | null): string {
  if (!iso) return "—";
  const s = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
  if (s < 60) return `${s}s ago`;
  if (s < 3600) return `${Math.floor(s / 60)}m ago`;
  if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
  return `${Math.floor(s / 86400)}d ago`;
}

function timeUntil(iso: string | null): string {
  if (!iso) return "—";
  const s = Math.floor((new Date(iso).getTime() - Date.now()) / 1000);
  if (s <= 0) return "due";
  if (s < 60) return `in ${s}s`;
  if (s < 3600) return `in ${Math.floor(s / 60)}m`;
  if (s < 86400) return `in ${Math.floor(s / 3600)}h`;
  return `in ${Math.floor(s / 86400)}d`;
}

function fmtDuration(ms: number | null): string {
  if (ms == null) return "—";
  if (ms < 1000) return `${ms}ms`;
  if (ms < 60_000) return `${(ms / 1000).toFixed(1)}s`;
  return `${(ms / 60_000).toFixed(1)}m`;
}

function fmtNumber(n: number | null): string {
  if (n == null) return "—";
  return n.toLocaleString();
}

/* ── Status + category styling ───────────────────────────────────────── */
const STATUS_META: Record<
  ScheduledJobStatus,
  { label: string; color: string; dot: string; icon: React.ComponentType<{ className?: string }> }
> = {
  SUCCESS: { label: "Success", color: "text-action-success", dot: "bg-action-success", icon: CheckCircle2 },
  FAILED:  { label: "Failed",  color: "text-action-danger",    dot: "bg-action-danger",    icon: XCircle },
  RUNNING: { label: "Running", color: "text-action-info",     dot: "bg-action-info",     icon: Loader2 },
  QUEUED:  { label: "Queued",  color: "text-action-warning",   dot: "bg-action-warning",   icon: Clock },
};

const CATEGORY_META: Record<
  ScheduledJobCategory,
  { label: string; icon: React.ComponentType<{ className?: string }>; tint: string }
> = {
  maintenance:   { label: "Maintenance",   icon: Settings2, tint: "text-text-secondary" },
  notifications: { label: "Notifications", icon: Bell,      tint: "text-indigo-300" },
  analytics:     { label: "Analytics",     icon: BarChart3, tint: "text-cyan-700"   },
  security:      { label: "Security",      icon: Shield,    tint: "text-action-warning"  },
  cleanup:       { label: "Cleanup",       icon: Trash2,    tint: "text-action-danger"   },
};

const PRIORITY_TINT: Record<Row["priority"], string> = {
  low:      "bg-bg-elevated/15 text-text-secondary border-border/30",
  medium:   "bg-sky-500/15 text-action-info border-sky-500/30",
  high:     "bg-amber-500/15 text-action-warning border-amber-500/30",
  critical: "bg-rose-500/15 text-action-danger border-rose-500/30",
};

/* ── Small presentational pieces ──────────────────────────────────────── */
function KpiCard({
  label, value, sub, icon: Icon, accent = "emerald", loading,
}: {
  label: string;
  value: string | number;
  sub?: string;
  icon: React.ComponentType<{ className?: string }>;
  accent?: "emerald" | "sky" | "amber" | "rose" | "violet";
  loading?: boolean;
}) {
  const tints: Record<string, string> = {
    emerald: "bg-action-success/10 text-action-success",
    sky:     "bg-action-info/10 text-action-info",
    amber:   "bg-action-warning/10 text-action-warning",
    rose:    "bg-action-danger/10 text-action-danger",
    violet:  "bg-unit-c/10 text-unit-c",
  };
  return (
    <Card className="relative overflow-hidden">
      <div className={`pointer-events-none absolute inset-0 ${tints[accent]} opacity-40`} />
      <CardContent className="relative flex items-start justify-between gap-3 p-4">
        <div className="min-w-0">
          <p className="text-xs uppercase tracking-wider text-text-muted">{label}</p>
          {loading ? (
            <div className="mt-2 h-7 w-20 animate-pulse rounded bg-white/10" />
          ) : (
            <p className="mt-1 text-2xl font-semibold tabular-nums text-text-primary">{value}</p>
          )}
          {sub && <p className="mt-0.5 truncate text-xs text-text-muted">{sub}</p>}
        </div>
        <div className={`rounded-xl border border-white/10 bg-white/5 p-2 ${tints[accent].split(" ").pop()}`}>
          <Icon className="h-4 w-4" />
        </div>
      </CardContent>
    </Card>
  );
}

function StatusPill({ status }: { status: ScheduledJobStatus }) {
  const meta = STATUS_META[status];
  const Icon = meta.icon;
  return (
    <span className={`inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-xs font-medium ${meta.color}`}>
      <Icon className={`size-3.5 ${status === "RUNNING" ? "animate-spin" : ""}`} />
      {meta.label}
    </span>
  );
}

function CategoryPill({ category }: { category: ScheduledJobCategory }) {
  const meta = CATEGORY_META[category];
  const Icon = meta.icon;
  return (
    <span className={`inline-flex items-center gap-1 rounded-md border border-white/10 bg-white/5 px-1.5 py-0.5 text-xs ${meta.tint}`}>
      <Icon className="size-3.5" />
      {meta.label}
    </span>
  );
}

/* ── Schedule editor modal ───────────────────────────────────────────── */
function ScheduleEditor({
  row, isOpen, onClose, onSave,
}: {
  row: Row | null;
  isOpen: boolean;
  onClose: () => void;
  onSave: (cron: string) => void;
}) {
  const [expr, setExpr] = useState(row?.cron_expression ?? "*/5 * * * *");
  useEffect(() => { if (row) setExpr(row.cron_expression); }, [row]);

  if (!isOpen) return null;

  return (
    <Modal isOpen={isOpen} onClose={onClose} title={`Edit schedule · ${row?.name ?? ""}`} size="lg">
      <div className="space-y-4">
        <div>
          <label className="mb-1 block text-xs uppercase tracking-wider text-text-muted">
            Cron expression
          </label>
          <Input value={expr} onChange={(e) => setExpr(e.target.value)} placeholder="*/5 * * * *" />
          <p className="mt-1 text-xs text-text-muted">
            Format: <code>minute hour day-of-month month day-of-week</code>
          </p>
        </div>

        <div className="surface-card bg-white/5 p-3">
          <p className="text-xs text-text-muted">Preview</p>
          <p className="mt-0.5 text-sm font-medium text-text-primary">{describeCron(expr)}</p>
        </div>

        <div>
          <p className="mb-2 text-xs uppercase tracking-wider text-text-muted">Presets</p>
          <div className="flex flex-wrap gap-2">
            {CRON_PRESETS.map((p) => (
              <button
                key={p.value}
                onClick={() => setExpr(p.value)}
                className="surface-card bg-white/5 px-3 py-1 text-xs text-text-secondary transition hover:text-action-success"
              >
                {p.label}
              </button>
            ))}
          </div>
        </div>

        <div className="flex justify-end gap-2 pt-2">
          <Button variant="ghost" onClick={onClose}>Cancel</Button>
          <Button onClick={() => { onSave(expr); onClose(); }}>Save schedule</Button>
        </div>
      </div>
    </Modal>
  );
}

/* ── Run history timeline ─────────────────────────────────────────────── */
function RunsTimeline({ runs, loading }: { runs: Run[]; loading: boolean }) {
  if (loading) {
    return (
      <div className="flex items-center gap-2 p-4 text-sm text-text-muted">
        <Loader2 className="h-4 w-4 animate-spin" /> Loading run history…
      </div>
    );
  }
  if (runs.length === 0) {
    return (
      <div className="p-4 text-sm text-text-muted">
        No runs recorded yet.
      </div>
    );
  }
  return (
    <div className="divide-y divide-white/5">
      {runs.map((r) => {
        const meta = STATUS_META[r.status];
        const Icon = meta.icon;
        return (
          <div key={r.id} className="flex items-start gap-3 p-3">
            <div className={`mt-0.5 rounded-md border border-white/10 bg-white/5 p-1.5 ${meta.color}`}>
              <Icon className={`h-3.5 w-3.5 ${r.status === "RUNNING" ? "animate-spin" : ""}`} />
            </div>
            <div className="min-w-0 flex-1">
              <div className="flex flex-wrap items-center gap-2 text-xs">
                <span className={`font-medium ${meta.color}`}>{meta.label}</span>
                <span className="text-text-muted">·</span>
                <span className="text-text-muted">{timeAgo(r.start_time)}</span>
                <span className="text-text-muted">·</span>
                <span className="capitalize text-text-muted">{r.triggered_by}</span>
              </div>
              <div className="mt-1 flex flex-wrap items-center gap-3 text-xs text-text-secondary">
                <span className="inline-flex items-center gap-1"><Timer className="size-3.5" />{fmtDuration(r.duration_ms)}</span>
                <span className="inline-flex items-center gap-1"><Activity className="size-3.5" />{fmtNumber(r.records_affected)} records</span>
              </div>
              {r.error_message && (
                <p className="surface-card mt-1.5 bg-rose-500/5 px-2 py-1 text-xs text-action-danger">
                  {r.error_message}
                </p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  );
}

/* ══════════════════════════════════════════════════════════════════════════
   Main component
   ══════════════════════════════════════════════════════════════════════════ */
export function ScheduledJobsPanel() {


  const addToast = useUIStore((s) => s.addToast);

  const [rows, setRows] = useState<Row[]>([]);
  const [runs, setRuns] = useState<Run[]>([]);
  const [loading, setLoading] = useState(true);

  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState<"ALL" | "ENABLED" | "DISABLED">("ALL");
  const [categoryFilter, setCategoryFilter] = useState<"ALL" | ScheduledJobCategory>("ALL");
  const [sortBy, setSortBy] = useState<"name" | "next_run" | "last_run" | "success_rate">("next_run");

  const [expanded, setExpanded] = useState<Record<string, boolean>>({});
  const [busy, setBusy] = useState<Record<string, boolean>>({});
  const [editorRow, setEditorRow] = useState<Row | null>(null);

  /* ── Data loading ─────────────────────────────────────────────────── */
  const load = useCallback(async () => {
    try {
      const res = await fetch("/api/admin/scheduled-jobs", { headers: getHeaders(), cache: "no-store" });
      const body = res.ok ? await res.json() : null;
      const apiRows: ApiRow[] = body?.rows ?? body?.jobs ?? body?.data ?? [];

      if (apiRows.length === 0) {
        // No scheduled jobs in the database. Show a proper empty state instead
        // of seeding fake jobs that would 404 on "Run Now".
        setRows([]);
        setRuns([]);
      } else {
        const mapped: Row[] = apiRows.map((j) => ({
          id: j.id,
          name: j.name,
          description: j.description,
          cron_expression: j.cron_expression,
          enabled: j.enabled,
          last_run: j.last_run,
          next_run: j.next_run,
          // Fields the API does not yet return; fill with safe defaults so the
          // UI renders without seeding rows that don't exist in the DB.
          category: "maintenance" as ScheduledJobCategory,
          priority: "medium" as Row["priority"],
          owner: "—",
          tags: [],
          avg_duration_ms: 0,
          success_rate: 100,
          runs_total: 0,
          runs_failed: 0,
          last_status: "SUCCESS" as ScheduledJobStatus,
        }));
        setRows(mapped);
        const apiRuns: Run[] = body?.runs ?? [];
        setRuns(apiRuns);
      }
    } catch {
      setRows([]);
      setRuns([]);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void load(); }, [load]);

  /* ── Derived ──────────────────────────────────────────────────────── */
  const kpis = useMemo(() => {
    const total = rows.length;
    const enabled = rows.filter((r) => r.enabled).length;
    const disabled = total - enabled;
    const failing = rows.filter((r) => r.last_status === "FAILED").length;
    const avg = total === 0 ? 0 : rows.reduce((a, r) => a + r.success_rate, 0) / total;
    const next = rows.filter((r) => r.enabled && r.next_run).map((r) => r.next_run!).sort((a, b) => a.localeCompare(b))[0] ?? null;
    return { total, enabled, disabled, failing, avg, next };
  }, [rows]);

  const visible = useMemo(() => {
    const q = search.trim().toLowerCase();
    let list = rows.filter((r) => {
      if (statusFilter === "ENABLED" && !r.enabled) return false;
      if (statusFilter === "DISABLED" && r.enabled) return false;
      if (categoryFilter !== "ALL" && r.category !== categoryFilter) return false;
      if (!q) return true;
      return (
        r.name.toLowerCase().includes(q) ||
        r.description.toLowerCase().includes(q) ||
        r.id.toLowerCase().includes(q) ||
        r.tags.some((t) => t.toLowerCase().includes(q))
      );
    });
    list = [...list].sort((a, b) => {
      switch (sortBy) {
        case "name":         return a.name.localeCompare(b.name);
        case "success_rate": return b.success_rate - a.success_rate;
        case "last_run":     return (b.last_run ?? "").localeCompare(a.last_run ?? "");
        case "next_run":
        default:             return (a.next_run ?? "9999").localeCompare(b.next_run ?? "9999");
      }
    });
    return list;
  }, [rows, search, statusFilter, categoryFilter, sortBy]);

  const recentRuns = useMemo(() => runs.slice(0, 8), [runs]);

  /* ── Actions ──────────────────────────────────────────────────────── */
  const toggleRow = async (row: Row) => {
    setBusy((b) => ({ ...b, [row.id]: true }));
    setRows((prev) => prev.map((r) => (r.id === row.id ? { ...r, enabled: !r.enabled } : r)));
    try {
      const res = await fetch(`/api/admin/jobs/${row.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json", ...getHeaders() },
        body: JSON.stringify({ enabled: !row.enabled }),
      });
      if (!res.ok) throw new Error("toggle failed");
      addToast({ variant: "success", message: `${row.name} ${row.enabled ? "paused" : "resumed"}.` });
    } catch {
      setRows((prev) => prev.map((r) => (r.id === row.id ? { ...r, enabled: row.enabled } : r)));
      addToast({ variant: "error", message: `Failed to update ${row.name}.` });
    } finally {
      setBusy((b) => ({ ...b, [row.id]: false }));
    }
  };

  const runNow = async (row: Row) => {
    setBusy((b) => ({ ...b, [row.id]: true }));
    setRows((prev) => prev.map((r) => (r.id === row.id ? { ...r, last_status: "RUNNING" } : r)));
    const optimistic: Run = {
      id: `${row.id}-now-${Date.now()}`,
      scheduledJobs_id: row.id,
      status: "RUNNING",
      start_time: new Date().toISOString(),
      end_time: null,
      duration_ms: null,
      records_affected: null,
      triggered_by: "manual",
      error_message: null,
    };
    setRuns((prev) => [optimistic, ...prev]);

    try {
      const res = await fetch(`/api/admin/jobs/${row.id}/run`, { method: "POST", headers: getHeaders() });
      const body = await res.json().catch(() => ({}));
      const success = res.ok && body?.success !== false;
      const durationMs = body?.durationMs ?? 1_800;
      const records = body?.recordsAffected ?? 0;

      setRows((prev) => prev.map((r) =>
        r.id === row.id
          ? {
              ...r,
              last_status: success ? "SUCCESS" : "FAILED",
              last_run: new Date().toISOString(),
              runs_total: r.runs_total + 1,
              runs_failed: success ? r.runs_failed : r.runs_failed + 1,
            }
          : r,
      ));
      setRuns((prev) => prev.map((r) =>
        r.id === optimistic.id
          ? {
              ...r,
              status: success ? "SUCCESS" : "FAILED",
              end_time: new Date().toISOString(),
              duration_ms: durationMs,
              records_affected: records,
              error_message: success ? null : (body?.error ?? "Run failed"),
            }
          : r,
      ));
      addToast({
        variant: success ? "success" : "error",
        message: success
          ? `${row.name} completed · ${records} records in ${fmtDuration(durationMs)}.`
          : `${row.name} failed. See run history.`,
      });
    } catch {
      setRows((prev) => prev.map((r) => (r.id === row.id ? { ...r, last_status: "FAILED" } : r)));
      setRuns((prev) => prev.map((r) =>
        r.id === optimistic.id
          ? { ...r, status: "FAILED", end_time: new Date().toISOString(), error_message: "Network error" }
          : r,
      ));
      addToast({ variant: "error", message: `Could not run ${row.name}.` });
    } finally {
      setBusy((b) => ({ ...b, [row.id]: false }));
    }
  };

  const saveCron = async (row: Row, cron: string) => {
    setRows((prev) => prev.map((r) => (r.id === row.id ? { ...r, cron_expression: cron } : r)));
    try {
      const res = await fetch(`/api/admin/jobs/${row.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json", ...getHeaders() },
        body: JSON.stringify({ cron_expression: cron }),
      });
      if (!res.ok) throw new Error("schedule update failed");
      addToast({ variant: "success", message: `Updated schedule for ${row.name}.` });
    } catch {
      setRows((prev) => prev.map((r) => (r.id === row.id ? { ...r, cron_expression: row.cron_expression } : r)));
      addToast({ variant: "error", message: `Failed to update schedule for ${row.name}.` });
    }
  };

  const toggleExpanded = (id: string) => setExpanded((e) => ({ ...e, [id]: !e[id] }));

  /* ── Render ───────────────────────────────────────────────────────── */
  return (
    <div className="space-y-6">
      {!loading && rows.length === 0 && (
        <div className="surface-card flex items-start gap-3 bg-bg-elevated/5 p-4 text-sm">
          <Info className="mt-0.5 h-4 w-4 flex-shrink-0 text-text-muted" />
          <div className="text-text-muted/90">
            <p className="font-medium">No scheduled jobs configured</p>
            <p className="text-xs opacity-80">
              The <code>scheduled_jobs</code> table is empty. Add a job via the admin console
              to enable automated maintenance, backups, and sync tasks.
            </p>
          </div>
        </div>
      )}

      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p className="flex items-center gap-2 text-xl font-semibold text-text-primary">
            <CalendarClock className="h-5 w-5 text-action-success" />
            Scheduled Jobs
          </p>
          <p className="mt-0.5 text-sm text-text-muted">
            {kpis.enabled} active · {kpis.disabled} paused
          </p>
        </div>
        <Button variant="ghost" size="sm" onClick={() => void load()}>
          <RefreshCw className={`h-4 w-4 ${loading ? "animate-spin" : ""}`} />
          <span className="ml-1.5">Refresh</span>
        </Button>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-5">
        <KpiCard label="Total"        value={kpis.total}        sub={`${kpis.enabled} enabled`}  icon={CircleDot}      accent="sky"     loading={loading} />
        <KpiCard label="Active"       value={kpis.enabled}      sub="Scheduled & running"        icon={Play}           accent="emerald" loading={loading} />
        <KpiCard label="Paused"       value={kpis.disabled}     sub="Disabled by operator"       icon={Pause}          accent="amber"   loading={loading} />
        <KpiCard label="Failing"      value={kpis.failing}      sub="Last run failed"            icon={AlertTriangle}  accent="rose"    loading={loading} />
        <KpiCard
          label="Avg success"
          value={`${kpis.avg.toFixed(1)}%`}
          sub={kpis.next ? `Next ${timeUntil(kpis.next)}` : "No upcoming run"}
          icon={TrendingUp}
          accent="violet"
          loading={loading}
        />
      </div>

      <Card>
        <CardContent className="flex flex-wrap items-center gap-2 p-3">
          <div className="relative min-w55 flex-1">
            <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted" />
            <Input
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search by name, tag, description…"
              className="pl-9"
            />
          </div>
          <div className="flex items-center gap-2">
            <Filter className="h-4 w-4 text-text-muted" />
            <Select
              value={statusFilter}
              onChange={(v) => setStatusFilter(v as typeof statusFilter)}
              options={[
                { value: "ALL", label: "All statuses" },
                { value: "ENABLED", label: "Enabled" },
                { value: "DISABLED", label: "Paused" },
              ]}
            />
            <Select
              value={categoryFilter}
              onChange={(v) => setCategoryFilter(v as typeof categoryFilter)}
              options={[
                { value: "ALL", label: "All categories" },
                { value: "maintenance", label: "Maintenance" },
                { value: "notifications", label: "Notifications" },
                { value: "analytics", label: "Analytics" },
                { value: "security", label: "Security" },
                { value: "cleanup", label: "Cleanup" },
              ]}
            />
            <Select
              value={sortBy}
              onChange={(v) => setSortBy(v as typeof sortBy)}
              options={[
                { value: "next_run", label: "Sort · Next run" },
                { value: "last_run", label: "Sort · Last run" },
                { value: "success_rate", label: "Sort · Success" },
                { value: "name", label: "Sort · Name" },
              ]}
            />
          </div>
        </CardContent>
      </Card>

      <div className="space-y-2">
        {loading && rows.length === 0 ? (
          Array.from({ length: 4 }).map((_, i) => (
            <Card key={i}>
              <CardContent className="p-4">
                <div className="h-5 w-48 animate-pulse rounded bg-white/10" />
                <div className="mt-2 h-3 w-72 animate-pulse rounded bg-white/5" />
              </CardContent>
            </Card>
          ))
        ) : visible.length === 0 ? (
          <Card>
            <CardContent className="p-10 text-center text-sm text-text-muted">
              Nothing matches the current filters.
            </CardContent>
          </Card>
        ) : (
          <AnimatePresence initial={false}>
            {visible.map((row) => {
              const isOpen = !!expanded[row.id];
              const rowRuns = runs.filter((r) => r.scheduledJobs_id === row.id).slice(0, 6);
              const rowBusy = !!busy[row.id];

              return (
                <motion.div
                  key={row.id}
                  initial={{ opacity: 0, y: 4 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0 }}
                  transition={{ duration: 0.15 }}
                >
                  <Card className={`overflow-hidden transition ${row.last_status === "FAILED" ? "border-rose-500/30" : ""}`}>
                    <div className="flex flex-wrap items-start gap-3 p-4">
                      <button
                        onClick={() => toggleExpanded(row.id)}
                        className="surface-card mt-1 bg-white/5 p-1 text-text-muted transition hover:text-text-primary"
                      >
                        {isOpen ? <ChevronDown className="h-3.5 w-3.5" /> : <ChevronRight className="h-3.5 w-3.5" />}
                      </button>

                      <div className="min-w60 flex-1">
                        <div className="flex flex-wrap items-center gap-2">
                          <h3 className="font-medium text-text-primary">{row.name}</h3>
                          <StatusPill status={row.last_status} />
                          <CategoryPill category={row.category} />
                          <span className={`rounded-md border px-1.5 py-0.5 text-xs uppercase tracking-wider ${PRIORITY_TINT[row.priority]}`}>
                            {row.priority}
                          </span>
                        </div>
                        <p className="mt-1 line-clamp-2 text-xs text-text-muted">{row.description}</p>
                        <div className="mt-1.5 flex flex-wrap items-center gap-1">
                          {row.tags.map((t) => (
                            <span key={t} className="surface-card bg-white/5 px-1.5 py-0.5 text-xs text-text-muted">
                              #{t}
                            </span>
                          ))}
                        </div>
                      </div>

                      <div className="w-[210px]">
                        <p className="flex items-center gap-1 text-xs uppercase tracking-wider text-text-muted">
                          <Clock className="size-3.5" /> Schedule
                        </p>
                        <p className="mt-0.5 text-sm font-medium text-text-primary">
                          {describeCron(row.cron_expression)}
                        </p>
                        <code className="text-xs text-text-muted">{row.cron_expression}</code>
                      </div>

                      <div className="w-[170px]">
                        <div className="flex items-center justify-between text-xs">
                          <span className="text-text-muted">Last</span>
                          <span className="text-text-secondary">{timeAgo(row.last_run)}</span>
                        </div>
                        <div className="mt-1 flex items-center justify-between text-xs">
                          <span className="text-text-muted">Next</span>
                          <span className="text-text-secondary">{timeUntil(row.next_run)}</span>
                        </div>
                        <div className="mt-1 flex items-center justify-between text-xs">
                          <span className="text-text-muted">Avg</span>
                          <span className="text-text-secondary">{fmtDuration(row.avg_duration_ms)}</span>
                        </div>
                      </div>

                      <div className="w35">
                        <div className="flex items-center justify-between text-xs text-text-muted">
                          <span>Success</span>
                          <span className="tabular-nums">{row.success_rate.toFixed(1)}%</span>
                        </div>
                        <div className="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
                          <div
                            className={`h-full ${
                              row.success_rate >= 99 ? "bg-action-success"
                                : row.success_rate >= 95 ? "bg-action-info"
                                : "bg-action-warning"
                            }`}
                            style={{ width: `${Math.min(100, row.success_rate)}%` }}
                          />
                        </div>
                        <p className="mt-1 text-xs text-text-muted">
                          {fmtNumber(row.runs_total)} runs · {fmtNumber(row.runs_failed)} failed
                        </p>
                      </div>

                      <div className="flex items-center gap-1.5">
                        <Button
                          size="sm"
                          variant={row.enabled ? "ghost" : "primary"}
                          onClick={() => void toggleRow(row)}
                          disabled={rowBusy}
                          title={row.enabled ? "Pause" : "Resume"}
                        >
                          {rowBusy ? (
                            <Loader2 className="h-3.5 w-3.5 animate-spin" />
                          ) : row.enabled ? (
                            <Pause className="h-3.5 w-3.5" />
                          ) : (
                            <Play className="h-3.5 w-3.5" />
                          )}
                        </Button>
                        <Button size="sm" onClick={() => void runNow(row)} disabled={rowBusy} title="Run now">
                          {rowBusy ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Zap className="h-3.5 w-3.5" />}
                          <span className="ml-1.5">Run</span>
                        </Button>
                        <Button size="sm" variant="ghost" onClick={() => setEditorRow(row)} title="Edit schedule">
                          <Settings2 className="h-3.5 w-3.5" />
                        </Button>
                      </div>
                    </div>

                    <AnimatePresence initial={false}>
                      {isOpen && (
                        <motion.div
                          initial={{ height: 0, opacity: 0 }}
                          animate={{ height: "auto", opacity: 1 }}
                          exit={{ height: 0, opacity: 0 }}
                          transition={{ duration: 0.2 }}
                          className="border-t border-white/5 bg-black/10"
                        >
                          <div className="flex items-center gap-2 px-4 pt-3 text-xs uppercase tracking-wider text-text-muted">
                            <History className="h-3.5 w-3.5" />
                            Recent runs
                          </div>
                          <RunsTimeline runs={rowRuns} loading={false} />
                        </motion.div>
                      )}
                    </AnimatePresence>
                  </Card>
                </motion.div>
              );
            })}
          </AnimatePresence>
        )}
      </div>

      <Card>
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-sm">
            <Activity className="h-4 w-4 text-action-info" />
            Recent activity (all)
          </CardTitle>
        </CardHeader>
        <CardContent className="p-0">
          <RunsTimeline runs={recentRuns} loading={loading} />
        </CardContent>
      </Card>

      <ScheduleEditor
        row={editorRow}
        isOpen={!!editorRow}
        onClose={() => setEditorRow(null)}
        onSave={(cron) => { if (editorRow) void saveCron(editorRow, cron); }}
      />
    </div>
  );
}
