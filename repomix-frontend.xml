<file path="src/components/principal/VpInboundCard.tsx">
// src/components/principal/VpInboundCard.tsx
// Principal's side of the bridge: items VP has flagged upward, with the
// Principal's ability to acknowledge / respond. Backed by /api/principal/inbound
// + /api/principal/inbound/[id]/respond.

"use client";

import { useEffect, useState } from "react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { usePolling } from "@/hooks/usePolling";
import { Loader2, Inbox, ArrowUpRight } from "lucide-react";

interface InboundItem {
  id: string;
  note: string;
  status: string;
  created_by_name: string | null;
  created_at: string;
  ticket_number: string | null;
  response_note: string | null;
}

async function load(): Promise<{ items: InboundItem[]; open: number } | null> {
  try {
    const res = await fetch("/api/principal/inbound", { credentials: "include" });
    const json = await res.json();
    if (json.success && json.data) return json.data;
    return null;
  } catch {
    return null;
  }
}

async function respond(flagId: string, action: "ACKNOWLEDGED" | "RESOLVED", note: string) {
  const res = await fetch(`/api/principal/inbound/${flagId}/respond`, {
    method: "POST",
    credentials: "include",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ action, note }),
  });
  return res;
}

export function VpInboundCard() {
  const [data, setData] = useState<{ items: InboundItem[]; open: number } | null>(null);
  const [busy, setBusy] = useState(false);

  const refresh = async () => {
    const d = await load();
    if (d) setData(d);
  };

  useEffect(() => {
    refresh();
  }, []);
  usePolling(refresh, { intervalMs: 60_000, enabled: true });

  const open = (data?.items ?? []).filter((i) => i.status === "OPEN");

  const doRespond = async (flagId: string, action: "ACKNOWLEDGED" | "RESOLVED") => {
    setBusy(true);
    await respond(flagId, action, action === "ACKNOWLEDGED" ? "Acknowledged" : "Resolved");
    setBusy(false);
    refresh();
  };

  return (
    <WidgetBoundary name="VpInbound" title="From the Vice Principal">
      <div className="space-y-2">
        {!data ? (
          <div className="flex items-center gap-2 text-sm text-text-muted">
            <Loader2 className="w-4 h-4 animate-spin" /> Loading bridge…
          </div>
        ) : open.length === 0 ? (
          <div className="py-4 text-center text-sm text-text-muted">
            <Inbox className="w-5 h-5 mx-auto mb-1 text-text-muted" />
            No open items flagged by the Vice Principal.
          </div>
        ) : (
          open.slice(0, 5).map((i) => (
            <div
              key={i.id}
              className="surface-card bg-bg-elevated/30 p-3 space-y-2 min-w-0"
            >
              <div className="flex items-start gap-2 min-w-0">
                <ArrowUpRight className="w-4 h-4 text-action-info shrink-0 mt-0.5" />
                <div className="min-w-0">
                  <p className="text-sm text-text-secondary break-words">{i.note}</p>
                  <p className="text-xs text-text-muted mt-1">
                    {i.created_by_name ?? "VP"}
                    {i.ticket_number ? ` · ${i.ticket_number}` : ""} ·{" "}
                    {new Date(i.created_at).toLocaleString(undefined, {
                      month: "short",
                      day: "numeric",
                      hour: "2-digit",
                      minute: "2-digit",
                    })}
                  </p>
                </div>
              </div>
              <div className="flex gap-2 flex-wrap">
                <button
                  onClick={() => doRespond(i.id, "ACKNOWLEDGED")}
                  disabled={busy}
                  className="surface-card px-2 py-1 text-xs font-semibold hover:bg-action-info/10 disabled:opacity-50"
                >
                  Acknowledge
                </button>
                <button
                  onClick={() => doRespond(i.id, "RESOLVED")}
                  disabled={busy}
                  className="surface-card px-2 py-1 text-xs font-semibold hover:bg-action-success/10 disabled:opacity-50"
                >
                  Resolve
                </button>
                {i.ticket_number ? (
                  <a
                    href={`/principal/approvals?ticket=${encodeURIComponent(i.ticket_number)}`}
                    className="surface-card px-2 py-1 text-xs font-semibold text-action-primary hover:bg-action-primary/10"
                  >
                    View original ticket
                  </a>
                ) : null}
              </div>
            </div>
          ))
        )}
      </div>
    </WidgetBoundary>
  );
}
</file>

<file path="src/components/remotion/GlossyGateScanComposition.tsx">
"use client";

import { useCurrentFrame, useVideoConfig, interpolate } from 'remotion';


export interface GlossyGateScanCompositionProps {
  status?: "entry" | "exit" | "idle" | "warning";
  primaryColor?: string;
}

export const GlossyGateScanComposition: React.FC<GlossyGateScanCompositionProps> = ({
  status = "entry",
  primaryColor: _primaryColor = "var(--action-success)",
}) => {
  const frame = useCurrentFrame();
  const { fps, durationInFrames } = useVideoConfig();

  // Bail out early if duration is absurd
  if (durationInFrames < 30 || durationInFrames > 600) {
    console.error(`GlossyGateScanComposition requires durationInFrames in [30, 600], got ${durationInFrames}`);
  }










  const pulseScale = interpolate(Math.sin((frame / fps) * Math.PI * 2), [-1, 1], [0.8, 1.2], {
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp"
  });
  const pulseOpacity = interpolate(frame % 90, [0, 45, 90], [0.6, 0.1, 0.6]);

  // Rotating specular holographic scanner arc
  const rotation = (frame * 2) % 360;

  // Grid line scan wave
  const scanLineY = interpolate(frame % 120, [0, 120], [0, 100]);

  const glowColor =
    status === "entry"
      ? "var(--action-success)"
      : status === "exit"
      ? "var(--alert-critical)"
      : status === "warning"
      ? "var(--action-warning)"
      : "var(--action-primary)";

  return (
    <div className="surface-card relative w-full h-full min-h40 flex items-center justify-center overflow-hidden bg-bg-elevated/40 backdrop-blur-md p-4">
      {/* Laser Scanning Line Wave */}
      <div
        className="absolute left-0 right-0 h-[2px] pointer-events-none shadow-[0_0_15px_var(--action-success)]"
        style={{
          top: `${scanLineY}%`,
          background: `linear-gradient(90deg, transparent 0%, ${glowColor} 50%, transparent 100%)`,
        }}
      />

      {/* Holographic Specular Arc Ring */}
      <div
        className="absolute w-6 h-6 rounded-full border border-white/20 pointer-events-none"
        style={{
          transform: `rotate(${rotation}deg)`,
          borderTopColor: glowColor,
          boxShadow: `0 0 25px ${glowColor}40`,
        }}
      />

      {/* Pulsing Status Core Halo */}
      <div
        className="w-6 h-6 rounded-full flex items-center justify-center transition-transform"
        style={{
          transform: `scale(${pulseScale})`,
          opacity: pulseOpacity,
          background: `radial-gradient(circle, ${glowColor}40 0%, transparent 70%)`,
        }}
      />

      {/* Central Holographic Gate Scanner Icon / Telemetry Graphic */}
      <div className="absolute flex flex-col items-center justify-center text-center z-10">
        <div
          className="size-6 rounded-xl flex items-center justify-center border border-white/30 bg-white/10 shadow-lg backdrop-blur-md"
          style={{ borderColor: glowColor }}
        >
          <div
            className="w-4 h-4 rounded-full"
            style={{ backgroundColor: glowColor, boxShadow: `0 0 12px ${glowColor}` }}
          />
        </div>
        <span className="text-xs font-mono tracking-widest uppercase font-bold text-white/90 mt-2">
          GATE SECURITY SCANNER
        </span>
      </div>
    </div>
  );
};

export default GlossyGateScanComposition;
</file>

