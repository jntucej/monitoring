<file path="src/components/admin/CollegeInfoForm.tsx">
"use client";

import { useEffect, useState } from "react";
import { Settings, Save, Loader2, CheckCircle2, AlertCircle } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";

interface CollegeInfoData {
  name: string;
  shortName: string;
  address: string;
  phone: string;
  email: string;
  logo: string;
  accreditation: string;
  website: string;
  principal: string;
}

const EMPTY: CollegeInfoData = {
  name: "",
  shortName: "",
  address: "",
  phone: "",
  email: "",
  logo: "",
  accreditation: "",
  website: "",
  principal: "",
};

export function CollegeInfoForm() {
  const [data, setData] = useState<CollegeInfoData>(EMPTY);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState<{ type: "success" | "error"; text: string } | null>(null);

  const fetchCollegeInfo = async () => {
    try {
      const res = await fetch("/api/config/college-info", { headers: getAuthHeaders() });
      const json = await res.json();
      if (json.success && json.data) {
        setData({ ...EMPTY, ...json.data });
      }
    } catch {
      // keep empty state on fetch error
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    void fetchCollegeInfo();
  }, []);

  const update = (field: keyof CollegeInfoData, value: string) =>
    setData((prev) => ({ ...prev, [field]: value }));

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    setSaving(true);
    setMessage(null);
    try {
      const res = await fetch("/api/config/college-info", {
        method: "PATCH",
        headers: getAuthHeaders(),
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (json.success) {
        setMessage({ type: "success", text: "College info saved." });
      } else {
        setMessage({ type: "error", text: json.error?.message || "Failed to save." });
      }
    } catch {
      setMessage({ type: "error", text: "An error occurred while saving." });
    } finally {
      setSaving(false);
    }
  };

  const inputCls =
    "w-full px-3 py-2 bg-bg-base border border-border rounded-lg text-sm text-text-primary";

  if (loading) {
    return (
      <div className="surface-card bg-bg-surface p-6">
        <h3 className="font-semibold flex items-center gap-2 mb-4">
          <Settings className="w-5 h-5 text-action-warning" />
          College Info
        </h3>
        <div className="flex justify-center p-6">
          <Loader2 className="w-5 h-5 animate-spin text-text-muted" />
        </div>
      </div>
    );
  }

  return (
    <form
      onSubmit={handleSave}
      className="surface-card bg-bg-surface p-6 flex flex-col h-full"
    >
      <h3 className="font-semibold flex items-center gap-2 mb-4">
        <Settings className="w-5 h-5 text-action-warning" />
        College Info
      </h3>

      <div className="space-y-4 flex-1">
        <div>
          <label className="block text-sm mb-1 text-text-primary">Name</label>
          <input type="text" value={data.name} onChange={(e) => update("name", e.target.value)} className={inputCls} />
        </div>
        <div>
          <label className="block text-sm mb-1 text-text-primary" htmlFor="short-name">Short Name</label>
          <input id="short-name"
            type="text"
            value={data.shortName}
            onChange={(e) => update("shortName", e.target.value)}
            className={inputCls}
          />
        </div>
        <div>
          <label className="block text-sm mb-1 text-text-primary" htmlFor="address">Address</label>
          <textarea id="address"
            value={data.address}
            onChange={(e) => update("address", e.target.value)}
            className={`${inputCls} min-h18`}
          />
        </div>
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label className="block text-sm mb-1 text-text-primary">Phone</label>
            <input type="tel" value={data.phone} onChange={(e) => update("phone", e.target.value)} className={inputCls} />
          </div>
          <div>
            <label className="block text-sm mb-1 text-text-primary" htmlFor="email">Email</label>
            <input id="email"
              type="email"
              value={data.email}
              onChange={(e) => update("email", e.target.value)}
              className={inputCls}
            />
          </div>
        </div>
        <div>
          <label className="block text-sm mb-1 text-text-primary">Logo URL</label>
          <input type="url" value={data.logo} onChange={(e) => update("logo", e.target.value)} className={inputCls} />
        </div>
        <div>
          <label className="block text-sm mb-1 text-text-primary" htmlFor="accreditation">Accreditation</label>
          <input id="accreditation"
            type="text"
            value={data.accreditation}
            onChange={(e) => update("accreditation", e.target.value)}
            className={inputCls}
          />
        </div>
        <div>
          <label className="block text-sm mb-1 text-text-primary">Website</label>
          <input type="url" value={data.website} onChange={(e) => update("website", e.target.value)} className={inputCls} />
        </div>
        <div>
          <label className="block text-sm mb-1 text-text-primary" htmlFor="principal">Principal</label>
          <input id="principal"
            type="text"
            value={data.principal}
            onChange={(e) => update("principal", e.target.value)}
            className={inputCls}
          />
        </div>

        {message && (
          <div
            className={`flex items-center gap-2 text-sm font-medium ${
              message.type === "success" ? "text-action-success" : "text-action-danger"
            }`}
          >
            {message.type === "success" ? (
              <CheckCircle2 className="w-4 h-4" />
            ) : (
              <AlertCircle className="w-4 h-4" />
            )}
            {message.text}
          </div>
        )}
      </div>

      <div className="surface-card flex justify-end mt-6 pt-4">
        <button
          type="submit"
          disabled={saving}
          className="surface-card inline-flex items-center gap-2 px-4 py-2 bg-action-primary text-white font-medium hover:brightness-110 disabled:opacity-50"
        >
          {saving ? <Loader2 className="w-4 h-4 animate-spin" /> : <Save className="w-4 h-4" />}
          Save Changes
        </button>
      </div>
    </form>
  );
}
</file>

<file path="src/components/admin/CsvValidationPreview.tsx">
"use client";
import { CheckCircle2, AlertTriangle, XCircle, ArrowRight, Loader2 } from "lucide-react";


interface CsvRow {
  row: number;
  name?: string | null;
  email?: string | null;
  role?: string | null;
  uniqueId?: string | null;
  employeeId?: string | null;
  department?: string | null;
}
interface CsvRowIssue {
  row: number;
  field?: string | null;
  message: string;
}
interface CsvValidationResult {
  validRows: number;
  invalidRows: number;
  rows: CsvRow[];
  errors: CsvRowIssue[];
  warnings: CsvRowIssue[];
}
interface CsvCommitResult {
  success: boolean;
  importedCount: number;
  failedCount: number;
  errors: Array<{ row: number; error: string }>;
  total?: number;
  created?: number;
  updated?: number;
  failed?: number;
}
export interface CsvValidationPreviewProps {
  validationResult: CsvValidationResult | null;
  commitResult: CsvCommitResult | null;
  committing: boolean;
  skipErrors: boolean;
  setSkipErrors: (v: boolean) => void;
  onCommit: () => void;
}

export function CsvValidationPreview({ validationResult, commitResult, committing, skipErrors, setSkipErrors, onCommit }: CsvValidationPreviewProps) {
  if (!validationResult && !commitResult) return null;
  return (
    <div className="space-y-4">
      {validationResult && (
        <div className="surface-card bg-bg-base p-5 space-y-4">
          <div className="surface-card flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3">
            <div className="flex items-center gap-3">
              <span className="text-sm font-semibold text-text-primary">Dry-Run Preview</span>
              <span className="surface-card px-2 py-0.5 text-xs font-medium bg-emerald-500/10 text-action-success">{validationResult.validRows} Valid</span>
              {validationResult.invalidRows > 0 && <span className="surface-card px-2 py-0.5 text-xs font-medium bg-red-500/10 text-red-500">{validationResult.invalidRows} Errors</span>}
            </div>
            <div className="flex items-center gap-3">
              {validationResult.invalidRows > 0 && (
                <label className="flex items-center gap-1.5 text-xs text-text-secondary cursor-pointer">
                  <input type="checkbox" checked={skipErrors} onChange={(e) => setSkipErrors(e.target.checked)} className="rounded border-border text-[var(--primary)]" />
                  <span>Skip errors</span>
                </label>
              )}
              <button onClick={onCommit} disabled={committing || (validationResult.validRows === 0 && !skipErrors)} className="surface-card flex items-center gap-2 px-4 py-2 text-xs font-semibold bg-action-success text-white hover:bg-action-success disabled:opacity-50 transition">
          <div className="overflow-x-auto max-h-80 border border-border rounded-lg">
            <table className="w-full text-left text-xs">
              <thead className="bg-[var(--surface-sunken)] text-text-secondary sticky top-0 font-medium">
                <tr><th className="p-2.5">Row</th><th className="p-2.5">Name</th><th className="p-2.5">Email</th><th className="p-2.5">Role</th><th className="p-2.5">ID / Dept</th><th className="p-2.5">Status</th></tr>
              </thead>
              <tbody className="divide-y divideborder-subtle font-mono">
                {validationResult.rows.map((r) => {
                  const rowErrors = validationResult.errors.filter((e) => e.row === r.row);
                  const rowWarns = validationResult.warnings.filter((w) => w.row === r.row);
                  const isOk = rowErrors.length === 0;
                  return (
                    <tr key={r.row} className={isOk ? "hover:bg-[var(--surface-sunken)]/50" : "bg-red-500/5"}>
                      <td className="p-2.5 text-text-muted">#{r.row}</td>
                      <td className="p-2.5 font-sans font-medium text-text-primary">{r.name || "—"}</td>
                      <td className="p-2.5 text-text-secondary">{r.email}</td>
                      <td className="p-2.5 uppercase font-bold text-xs">{r.role}</td>
                      <td className="p-2.5 text-text-secondary">{r.uniqueId || r.employeeId || r.department || "—"}</td>
                      <td className="p-2.5 font-sans">
                        {isOk ? <div className="flex items-center gap-1 text-action-success font-medium"><CheckCircle2 className="w-3.5 h-3.5" /><span>Valid</span></div> :
                          <div className="space-y-0.5">{rowErrors.map((err, idx) => <div key={idx} className="flex items-center gap-1 text-red-500 text-xs"><XCircle className="w-3.5 h-3.5 shrink-0" /><span>{err.message}</span></div>)}</div>}
                        {rowWarns.map((w, idx) => <div key={idx} className="flex items-center gap-1 text-action-warning text-xs"><AlertTriangle className="w-3.5 h-3.5 shrink-0" /><span>{w.message}</span></div>)}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
      {commitResult && (
        <div className="surface-card bg-emerald-500/5 p-5 space-y-3">
          <div className="flex items-center gap-2 text-action-success"><CheckCircle2 className="w-5 h-5" /><h4 className="font-semibold text-sm">Bulk Import Succeeded</h4></div>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
            <div className="surface-card p-3 bg-bg-base"><span className="text-xs text-text-muted uppercase font-semibold">Total</span><p className="text-lg font-bold text-text-primary">{commitResult.total}</p></div>
            <div className="surface-card p-3 bg-bg-base"><span className="text-xs text-action-success uppercase font-semibold">Created</span><p className="text-lg font-bold text-action-success">{commitResult.created}</p></div>
            <div className="surface-card p-3 bg-bg-base"><span className="text-xs text-sky-500 uppercase font-semibold">Updated</span><p className="text-lg font-bold text-sky-500">{commitResult.updated}</p></div>
            <div className="surface-card p-3 bg-bg-base"><span className="text-xs text-red-500 uppercase font-semibold">Failed</span><p className="text-lg font-bold text-red-500">{commitResult.failed}</p></div>
          </div>
        </div>
      )}

            </table>
          </div>

                {committing ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <ArrowRight className="w-3.5 h-3.5" />}
                Commit ({validationResult.validRows} Rows)
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/admin/DevMessagesPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import { MessageSquare, Send } from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { usePolling } from "@/hooks/usePolling";

interface DevMessage {
  id: string;
  user_name: string;
  user_role: string;
  user_email: string;
  message: string;
  channel: string;
  read_at: string | null;
  created_at: string;
}

/**
 * Dashboard panel: incoming direct-to-developer messages from any user role.
 * Self-contained — mount on any admin dashboard; polls every 60s.
 */
export function DevMessagesPanel() {
  const [messages, setMessages] = useState<DevMessage[]>([]);
  const [loading, setLoading] = useState(true);

  const load = useCallback(async () => {
    try {
      const res = await fetch("/api/dev/contact?limit=10", {
        headers: getAuthHeaders(),
        cache: "no-store",
      });
      const data = await res.json();
      if (data.success) setMessages(data.data || []);
    } catch {
      /* panel is non-critical */
    } finally {
      setLoading(false);
    }
  }, []);

  // Initial load + visibility-aware polling (no raw setInterval)
  useEffect(() => {
    load().catch(() => {});
  }, [load]);
  usePolling(load, { intervalMs: 60_000 });

  return (
    <div className="surface-card bg-bg-surface p-4">
      <div className="flex items-center gap-2 mb-3">
        <MessageSquare className="w-4 h-4 text-action-success" />
        <h3 className="text-sm font-semibold text-text-primary">
          Developer Messages
        </h3>
        <span className="text-xs text-text-muted">
          {messages.filter((m) => !m.read_at).length} unread
        </span>
      </div>

      {loading ? (
        <p className="text-xs text-text-muted">Loading…</p>
      ) : messages.length === 0 ? (
        <p className="text-xs text-text-muted">
          No direct messages yet. Users can send one from any dashboard&#39;s
          “Developer” card or the Support page.
        </p>
      ) : (
        <ul className="space-y-2 max-h-64 overflow-y-auto">
          {messages.map((m) => (
            <li
              key={m.id}
              className={`rounded-lg border p-3 ${
                m.read_at
                  ? "border-border opacity-70"
                  : "border-emerald-500/40 bg-emerald-500/5"
              }`}
            >
              <div className="flex items-center justify-between text-xs">
                <span className="flex items-center gap-1.5 font-semibold text-text-primary">
                  <Send className="size-3.5" />
                  {m.user_name || "Unknown user"}
                  <span className="surface-card uppercase tracking-wide text-xs px-1.5 py-0.5 bg-bg-base">
                    {m.user_role}
                  </span>
                </span>
                <span className="text-text-muted">
                  {new Date(m.created_at).toLocaleString()}
                </span>
              </div>
              {m.user_email && (
                <p className="text-xs text-text-muted mt-0.5">{m.user_email}</p>
              )}
              <p className="text-sm text-text-primary mt-1.5 whitespace-pre-wrap">
                {m.message}
              </p>
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}
</file>

