<file path="src/hooks/useOperatorShiftClock.ts">
"use client";

// Operator shift clock: an operator's 8-hour shift is derived from their
// first recorded scan today (the desk is always on; the clock is not a
// separate login ritual). start = first scan, end = start + 8h. When no
// scan exists yet today, start/end are null and the caller shows the live
// time instead.

import { useEffect, useState } from "react";
import { getAuthHeaders } from "@/lib/utils";

export type OperatorShift = {
  start: Date | null;
  end: Date | null;
  /** Hours remaining on the shift; null when no active shift. */
  remainingHours: number | null;
};

export function useOperatorShiftClock(): OperatorShift {
  const [shift, setShift] = useState<OperatorShift>({
    start: null,
    end: null,
    remainingHours: null,
  });

  useEffect(() => {
    let cancelled = false;

    const derive = (firstScanIso: string | null) => {
      if (!firstScanIso) {
        setShift({ start: null, end: null, remainingHours: null });
        return;
      }
      const start = new Date(firstScanIso);
      const end = new Date(start.getTime() + 8 * 3_600_000);
      setShift({ start, end, remainingHours: null });
    };

    const load = () => {
      fetch("/api/operator/last-scan", {
        cache: "no-store",
        headers: getAuthHeaders(),
      })
        .then((res) => (res.ok ? res.json() : null))
        .then((json) => {
          if (cancelled) return;
          // Shift derives from the FIRST scan today: last-scan of the new day
          // (no earlier scan returned) is that first scan; a mid-day first scan
          // is the start of the window we derive the 8h from.
          const row = json?.data ?? null;
          derive(typeof row?.at === "string" ? row.at : null);
        })
        .catch(() => {
          if (!cancelled) derive(null);
        });
    };

    load();
    const poll = setInterval(load, 60_000);

    // Keep "remaining hours" fresh while the shift is live.
    const tick = setInterval(() => {
      setShift((s) => {
        if (!s.start || !s.end) return s;
        const ms = s.end.getTime() - Date.now();
        return { ...s, remainingHours: ms > 0 ? Math.max(0, ms / 3_600_000) : 0 };
      });
    }, 60_000);

    return () => {
      cancelled = true;
      clearInterval(poll);
      clearInterval(tick);
    };
  }, []);

  return shift;
}
</file>

<file path="src/hooks/useOptimistic.ts">
/**
 * useOptimistic — optimistic update hook with rollback on API failure.
 *
 * Usage:
 *   const [list, optimisticUpdate, rollback] = useOptimistic(initialList, fetcher);
 *
 *   // When the user approves a ticket:
 *   optimisticUpdate(items => items.filter(i => i.id !== ticketId));
 *
 *   // The hook calls the API in the background. On 4xx/5xx it
 *   // automatically rolls back to the pre-update state and fires
 *   // `onFailure` so the caller can show a toast.
 */

import { useCallback, useRef, useState, useEffect } from "react";

export interface UseOptimisticOptions<T> {
  /** Called after the API call succeeds. */
  onSuccess?: (updated: T[]) => void;
  /** Called when the API call fails (rollback already applied). */
  onFailure?: (err: Error) => void;
  /**
   * Returns a new list after the local mutation.
   * The hook stores the previous list before calling this, and
   * restores it on API failure.
   */
  mutate: (prev: T[]) => T[];
  /** API call. Must resolve when the server confirms the change. */
  apiCall: (item: T) => Promise<unknown>;
  /** Which item was acted on (for logging / rollback identification). */
  item: T;
}

export function useOptimistic<T extends { id: string }>(
  list: T[],
  { mutate, apiCall, item, onSuccess, onFailure }: UseOptimisticOptions<T> & {
    item: T;
  },
) {
  const [pending, setPending] = useState(false);
  const prevRef = useRef<T[]>(list);

  // Update the pre-mutation snapshot each time `list` changes
  useEffect(() => {
    prevRef.current = list;
  }, [list]);

  const apply = useCallback(async () => {
    setPending(true);
    try {
      const next = mutate(prevRef.current);
      // Apply locally immediately (optimistic)
      onSuccess?.(next);
      await apiCall(item);
      // Server confirmed — next render will pick up the refetched state
    } catch (err) {
      // Rollback: restore pre-mutation state
      prevRef.current = list;
      onFailure?.(err instanceof Error ? err : new Error("Optimistic action failed"));
    } finally {
      setPending(false);
    }
  }, [mutate, apiCall, item, list, onSuccess, onFailure]);

  return { pending, apply };
}

/**
 * Convenience: wrap a single item's status field in an optimistic
 * local state, auto-rollback on fetch failure.
 */
export function useOptimisticItemStatus<T extends { id: string; status?: string }>(
  item: T,
  newStatus: string,
  { onDone, onFail }: { onDone?: () => void; onFail?: (e: Error) => void } = {},
) {
  const [optimistic, setOptimistic] = useState(false);
  const prevRef = useRef<string | undefined>(item.status);

  useEffect(() => {
    prevRef.current = item.status;
  }, [item.status]);

  const run = useCallback(
    async (apiFn: () => Promise<unknown>) => {
      setOptimistic(true);
      try {
        onDone?.();
        await apiFn();
      } catch (e) {
        // Restore previous status
        onFail?.(e instanceof Error ? e : new Error("Status update failed"));
      } finally {
        setOptimistic(false);
      }
    },
    [onDone, onFail],
  );

  return {
    optimistic,
    /** The value the UI should render while the update is in-flight. */
    displayStatus: optimistic ? newStatus : item.status,
    run,
  };
}
</file>

<file path="src/hooks/usePassTypes.ts">
"use client";

import { useEffect, useState } from 'react';
import { getAuthHeaders } from '@/lib/utils';
import {
  PASS_TYPE_SEED,
  passTypesForPersona,
  type PassTypeConfig,
  type Persona,
} from '@/lib/pass-types';
import { usePersona } from '@/hooks/usePersona';

// ── Legacy PassType (kept for backward compat — existing callers still use
//    `usePassTypes().passTypes` which returns the legacy shape). The new
//    config-driven API below is the preferred path for all new code. ─────

export interface PassType {
  code: string;
  name: string;
  description: string;
  defaultDurationHours: number;
  requiresApproval: boolean;
  approvalFlow: string;
}

export const DEFAULT_PASS_TYPES: PassType[] = [
  {
    code: "day_pass",
    name: "Day Pass",
    description: "Full day out (returns by evening curfew)",
    defaultDurationHours: 12,
    requiresApproval: true,
    approvalFlow: "principal"
  },
  {
    code: "home_out",
    name: "Home Out",
    description: "Weekend or overnight home leave",
    defaultDurationHours: 48,
    requiresApproval: true,
    approvalFlow: "principal"
  }
];

export function getPassTypeName(codeOrReason?: string): string {
  if (!codeOrReason) return "Gate Pass";
  // Check legacy defaults first
  const legacy = DEFAULT_PASS_TYPES.find(
    (t) => t.code.toLowerCase() === codeOrReason.toLowerCase()
  );
  if (legacy) return legacy.name;
  // Then check config seed
  const config = PASS_TYPE_SEED.find(
    (t) => t.code.toLowerCase() === codeOrReason.toLowerCase()
  );
  if (config) return config.label;
  return codeOrReason;
}

// ── Legacy hook (unchanged behaviour) ─────────────────────────────────────

export function usePassTypes() {
  const [passTypes, setPassTypes] = useState<PassType[]>(DEFAULT_PASS_TYPES);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    let active = true;
    const fetchPassTypes = async () => {
      try {
        const headers = getAuthHeaders();
        const res = await fetch('/api/config/pass-types', { headers, cache: 'no-store' });
        if (res.ok) {
          const json = await res.json();
          if (active && json.success && Array.isArray(json.data) && json.data.length > 0) {
            const filtered = json.data.filter((pt: PassType) => pt.code !== 'daily_outing');
            setPassTypes(filtered.length > 0 ? filtered : DEFAULT_PASS_TYPES);
          }
        }
      } catch (err) {
        console.error('Error fetching pass types:', err);
      } finally {
        if (active) setLoading(false);
      }
    };
    fetchPassTypes();
    return () => { active = false; };
  }, []);

  return { passTypes, loading };
}

// ── New config-driven hook (persona-scoped, reads PassTypeConfig) ─────────

export interface UsePassTypesConfig {
  /** Restrict to a specific persona. Defaults to the current user's persona. */
  persona?: Persona;
  /** Only active types. Default true. */
  onlyActive?: boolean;
  /**
   * When true, filters out types that require parent consent
   * (used by the direct-generate / staff-on-behalf flow).
   */
  staffOnBehalf?: boolean;
}

/**
 * usePassTypesV2 — persona-scoped PassTypeConfig list.
 *
 * Reads from the in-memory seed by default. When `/api/pass-types`
 * becomes available (Phase 2) the seed is replaced by a live fetch.
 *
 * @example
 * const { configs, loading } = usePassTypesV2();
 * // or staff-on-behalf (no parent-consent types):
 * const { configs } = usePassTypesV2({ staffOnBehalf: true });
 */
export function usePassTypesV2(opts: UsePassTypesConfig = {}) {
  const detectedPersona = usePersona();
  const persona = opts.persona ?? detectedPersona;
  const [configs, setConfigs] = useState<PassTypeConfig[]>([]);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    setLoading(true);
    let list = passTypesForPersona(persona, opts.onlyActive ?? true);
    if (opts.staffOnBehalf) {
      list = list.filter((c) => !c.requiresParentConsent);
    }
    setConfigs(list);
    setLoading(false);
  }, [persona, opts.onlyActive, opts.staffOnBehalf]);

  return { configs, loading };
}
</file>

