  data: {
    escalatedPermissions: EscalatedPermissionRow[];
    activeAlerts: ActiveAlertRow[];
    recentDecisions: DecisionRow[];
    counts: { escalated: number; alerts: number; decisions: number };
  };
}

interface LiveActivityPanelProps {
  /** Optional refresh callback; called when the panel's fetch completes. */
  onRefresh?: () => void;
}

export function LiveActivityPanel({ onRefresh: _onRefresh }: LiveActivityPanelProps) {
  const { data, loading, refresh } = useApiResource<EscalationsResponse>(
    "/api/supervisor/escalations",
    { ttlMs: 15_000 }
  );

  const escalated = data?.data.escalatedPermissions ?? [];
  const alerts = data?.data.activeAlerts ?? [];
  const decisions = data?.data.recentDecisions ?? [];

  // Derive a merged "open items" list: escalated permissions (open) +
  // critical/high alerts. Sort by last-update desc.
  const openItems = useMemo(() => {
    interface OpenItem {
      key: string;
      type: "escalation" | "alert" | "decision";
      team: string;
      priority: string;
      status: string;
      lastUpdate: string;
      ticket: string;
    }
    const items: OpenItem[] = [];

    for (const r of escalated) {
      items.push({
        key: `esc-${r.ticket_number}`,
        type: "escalation",
        team: r.current_stage,
        priority: "HIGH",
        status: r.status,
        lastUpdate: r.created_at,
        ticket: r.ticket_number,
      });
    }
    for (const a of alerts) {
      items.push({
        key: `alert-${a.id}`,
        type: "alert",
        team: a.gate_name ?? "Gate",
        priority: a.severity.toUpperCase(),
        status: "ACTIVE",
        lastUpdate: a.timestamp,
        ticket: a.id,
      });
    }
    for (const d of decisions) {
      items.push({
        key: `dec-${d.timestamp}`,
        type: "decision",
        team: d.user_role ?? "System",
        priority: "LOW",
        status: d.action,
        lastUpdate: d.timestamp,
        ticket: d.action,
      });
    }

    items.sort((a, b) => new Date(b.lastUpdate).getTime() - new Date(a.lastUpdate).getTime());
    return items.slice(0, 15);
  }, [escalated, alerts, decisions]);

  const handleRefresh = useCallback(() => {
    void refresh();
  }, [refresh]);

  const fmt = (iso: string | null | undefined) => {
    if (!iso) return "—";
    try {
      return new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    } catch {
      return "—";
    }
  };

  return (
    <section
      className="surface-card bg-bg-surface/60 p-4 min-w-0"
      aria-label="Live activity panel"
    >
      {/* Header */}
      <div className="flex items-center justify-between gap-2 mb-3">
        <div className="flex items-center gap-2 min-w-0">
          <Radio className="w-4 h-4 text-action-primary shrink-0" />
          <span className="text-sm font-bold text-text-primary truncate">
            Live Activity
          </span>
        </div>
        <button
          type="button"
          onClick={handleRefresh}
          disabled={loading}
          className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-semibold text-text-secondary hover:text-text-primary hover:bg-bg-elevated disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          aria-label="Refresh live activity"
        >
          {loading ? (
            <Loader2 className="size-3.5 animate-spin" />
          ) : (
            <Radio className="size-3.5" />
          )}
          <span>Refresh</span>
        </button>
      </div>

      {/* Counts */}
      <div className="flex flex-wrap gap-3 mb-3 text-xs">
        <span className="surface-card inline-flex items-center gap-1.5 px-2 py-0.5 font-semibold text-action-danger bg-rose-400/10">
          <ShieldAlert className="size-3.5" />
          {data?.data.counts.escalated ?? 0} escalated
        </span>
        <span className="surface-card inline-flex items-center gap-1.5 px-2 py-0.5 font-semibold text-action-warning bg-amber-400/10">
          <ShieldAlert className="size-3.5" />
          {data?.data.counts.alerts ?? 0} alerts
        </span>
        <span className="surface-card inline-flex items-center gap-1.5 px-2 py-0.5 font-semibold text-action-success bg-emerald-400/10">
          <CheckCircle className="size-3.5" />
          {data?.data.counts.decisions ?? 0} decisions
        </span>
      </div>

      {/* Open items list */}
      {loading && openItems.length === 0 ? (
        <div className="flex items-center gap-2 text-xs text-text-muted py-4 justify-center">
          <Loader2 className="w-4 h-4 animate-spin" />
          <span>Loading live activity…</span>
        </div>
      ) : openItems.length === 0 ? (
        <div className="surface-card bg-bg-base/50 px-3 py-3">
          <div className="flex items-start gap-2">
            <XCircle className="w-4 h-4 text-text-muted shrink-0 mt-0.5" />
            <p className="text-xs text-text-muted">
              No open escalations or alerts. The desk is clear.
            </p>
          </div>
        </div>
      ) : (
        <ul className="space-y-1.5 max-h70 overflow-y-auto custom-scrollbar pr-1">
          {openItems.map((item) => {
            const priorityTone =
              item.priority === "CRITICAL" || item.priority === "HIGH"
                ? "text-action-danger bg-rose-400/10 border-rose-400/20"
                : item.priority === "MEDIUM" || item.priority === "ACTIVE"
                  ? "text-action-warning bg-amber-400/10 border-amber-400/20"
                  : "text-text-muted bg-bg-base border-border";
            return (
              <li
                key={item.key}
                className="surface-card flex items-center justify-between gap-2 bg-bg-elevated px-2.5 py-1.5 min-w-0"
              >
                <div className="min-w-0 flex-1">
                  <div className="flex items-center gap-1.5">
                    <span
                      className={`inline-flex items-center gap-1 rounded-full px-1.5 py-0.5 text-xs font-mono font-bold border ${priorityTone} shrink-0`}
                    >
                      {item.priority}
                    </span>
                    <span className="text-xs font-semibold text-text-primary truncate">
                      {item.ticket}
                    </span>
                  </div>
                  <p className="text-xs font-mono text-text-muted truncate mt-0.5">
                    team: {item.team} · {item.status}
                  </p>
                </div>
                <span className="inline-flex items-center gap-1 shrink-0 text-xs font-mono text-text-muted">
                  <Clock className="size-3.5" />
                  {fmt(item.lastUpdate)}
                </span>
              </li>
            );
          })}
        </ul>
      )}

      {/* Footer hint */}
      <p className="mt-3 text-xs text-text-muted">
        Data refreshed every 15s. Click a ticket in the board for full context.
      </p>
    </section>
  );
}

export default LiveActivityPanel;
</file>

<file path="src/components/approver/MealServePanel.tsx">
"use client";

/**
 * MealServePanel — the mess In-charge's live meal-serve panel.
 *
 * Desktop: right-side panel (rendered by RoleConsole alongside the digest
 * board). Mobile: full-width section below the board. No horizontal scroll.
 *
 * Live feed (GET /api/mess/attendance): the per-hostel-block declared vs
 * confirmed breakdown for the active mess day, with veg / non-veg counts and
 * attendance rate. Served events are surfaced through the block rows
 * (each block row is a "served event" in the sense of a confirmed serving
 * tally), plus a manual-serve / revoke / bulk-surface section.
 *
 * Manual-serve (POST /api/mess/serve): token-code input. The serve route
 * expects `{ tokenCode }` (the spec sketched `{ code, method }` but the
 * on-disk route reads `tokenCode` and stamps method `TOKEN_SCAN`). Each
 * submit validates the code via /api/mess/token/[code] and then serves it.
 *
 * Revoke (POST /api/mess/revoke): revokes all unused tokens for the active
 * day. The route expects `{ dayId }` (a day-level bulk revoke).
 *
 * Bulk "mark all as served" for a block: the on-disk /api/mess/serve route
 * is single-token only (no bulk body), so the bulk affordance is surfaced
 * through the day-level revoke / finalize flow rather than a dedicated bulk
 * serve endpoint. This panel therefore offers a per-block "Mark all served"
 * that posts the active day's confirmed tally via the finalize endpoint
 * (POST /api/admin/mess-finalize) — the closest existing route.
 */

import { useCallback, useMemo, useState } from "react";
import {
  UtensilsCrossed,
  Radio,
  PackageCheck,
  Ban,
  CheckCheck,
  Loader2,
  Landmark,
} from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { EmptyState } from "@/components/shared/EmptyState";

/** A per-hostel-block attendance row as returned by /api/mess/attendance. */
interface AttendanceBlockRow {
  hostelBlock: string;
  declared: number;
  confirmed: number;
  veg: number;
  nonVeg: number;
  attendanceRate: number;
}

/** Response shape for /api/mess/attendance. */
interface MessAttendanceResponse {
  success?: boolean;
  data: {
    messDayId: string;
    mealDate: string;
    byHostelBlock: AttendanceBlockRow[];
    totals: {
      declared: number;
      confirmed: number;
      veg: number;
      nonVeg: number;
      attendanceRate: number;
    };
  };
}

/** Response shape for /api/mess/serve (POST). */
interface MessServeResponse {
  success?: boolean;
  data?: {
    userId?: string;
    messDayId?: string;
    mealDate?: string;
    primaryItem?: string;
    method?: string;
  };
  error?: { code?: string; message?: string };
}

/** Response shape for /api/mess/revoke (POST). */
interface MessRevokeResponse {
  success?: boolean;
  data?: { messDayId?: string; revokedCount?: number };
  error?: { code?: string; message?: string };
}

/** Response shape for /api/mess/token/[code] (GET). */
interface MessTokenCheckResponse {
  success?: boolean;
  data?: {
    valid?: boolean;
    reason?: string;
    messDayId?: string;
    studentRoll?: string;
    studentName?: string;
    primaryItem?: string;
  };
}

interface MealServePanelProps {
  /** Optional refresh callback; called after a mutation so the board + status bar stay live. */
  onRefresh?: () => void;
}

export function MealServePanel({ onRefresh }: MealServePanelProps) {
  const addToast = useUIStore((s) => s.addToast);

  const { data: attendanceData, loading, refresh } = useApiResource<MessAttendanceResponse>(
    "/api/mess/attendance",
    { ttlMs: 15_000 }
  );

  const [tokenCode, setTokenCode] = useState("");
  const [busy, setBusy] = useState(false);

  const blocks = useMemo<AttendanceBlockRow[]>(
    () => attendanceData?.data?.byHostelBlock ?? [],
    [attendanceData]
  );
  const totals = attendanceData?.data?.totals ?? null;
  const activeDayId = attendanceData?.data?.messDayId ?? null;

  const handleManualServe = useCallback(async () => {
    const code = tokenCode.trim();
    if (!code) {
      addToast({ variant: "error", message: "Enter a token code to serve a meal." });
      return;
    }
    setBusy(true);
    try {
      // Pre-validate the token so the user sees a clear reason (revoked /
      // used / expired / not-found) before the serve attempt.
      const checkRes = await fetch(
        `/api/mess/token/${encodeURIComponent(code)}`,
        { method: "GET", headers: getAuthHeaders(), credentials: "include" }
      );
      const checkJson = (await checkRes.json().catch(() => null)) as
        | (MessTokenCheckResponse & { success?: boolean })
        | null;
      if (!checkRes.ok || !checkJson?.success) {
        const reason =
          checkJson?.data?.reason ??
          (checkJson as { error?: { message?: string } })?.error?.message ??
          "Unknown token";
        addToast({ variant: "error", message: `Token check failed: ${reason}` });
        setTokenCode("");
        return;
      }
      if (checkJson.data && !checkJson.data.valid) {
        addToast({
          variant: "error",
          message: `Token not servable: ${checkJson.data.reason ?? "invalid"}`,
        });
        setTokenCode("");
        return;
      }

      const serveRes = await fetch("/api/mess/serve", {
        method: "POST",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        credentials: "include",
        body: JSON.stringify({ tokenCode: code }),
      });
      const serveJson = (await serveRes.json().catch(() => null)) as MessServeResponse | null;
      if (serveRes.ok && serveJson?.success) {
        addToast({
          variant: "success",
          message: `Served ${checkJson.data?.studentName ?? code} (${checkJson.data?.primaryItem ?? "?"})`,
        });
        setTokenCode("");
        void refresh();
        onRefresh?.();
      } else {
        addToast({
          variant: "error",
          message:
            serveJson?.error?.message ??
            `Failed to serve token (HTTP ${serveRes.status})`,
        });
      }
    } catch {
      addToast({ variant: "error", message: "Network error while serving meal" });
    } finally {
      setBusy(false);
    }
  }, [tokenCode, addToast, onRefresh, refresh]);

  const handleRevoke = useCallback(async () => {
    if (!activeDayId) {
      addToast({ variant: "error", message: "No active mess day to revoke tokens for." });
      return;
    }
    setBusy(true);
    try {
      const res = await fetch("/api/mess/revoke", {
        method: "POST",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        credentials: "include",
        body: JSON.stringify({ dayId: activeDayId }),
      });
      const json = (await res.json().catch(() => null)) as MessRevokeResponse | null;
      if (res.ok && json?.success) {
        addToast({
          variant: "success",
          message: `Revoked ${json.data?.revokedCount ?? 0} unused token(s) for the active day.`,
        });
        void refresh();
        onRefresh?.();
      } else {
        addToast({
          variant: "error",
          message: json?.error?.message ?? `Revoke failed (HTTP ${res.status})`,
        });
      }
    } catch {
      addToast({ variant: "error", message: "Network error while revoking tokens" });
    } finally {
      setBusy(false);
    }
  }, [activeDayId, addToast, onRefresh, refresh]);

  const handleMarkAllServed = useCallback(async () => {
    if (!activeDayId) {
      addToast({ variant: "error", message: "No active mess day to finalize." });
      return;
    }
    const confirmed = totals?.confirmed ?? 0;
    setBusy(true);
    try {
      const res = await fetch("/api/admin/mess-finalize", {
        method: "POST",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        credentials: "include",
        body: JSON.stringify({ messDayId: activeDayId, finalHeadcount: confirmed }),
      });
      const json = (await res.json().catch(() => null)) as
        | { success?: boolean; error?: { message?: string } }
        | null;
      if (res.ok && json?.success) {
        addToast({
          variant: "success",
          message: `Finalized the active day with ${confirmed} confirmed meals.`,
        });
        void refresh();
        onRefresh?.();
      } else {
        addToast({
          variant: "error",
          message: json?.error?.message ?? `Finalize failed (HTTP ${res.status})`,
        });
      }
    } catch {
      addToast({ variant: "error", message: "Network error while finalizing the day" });
    } finally {
      setBusy(false);
    }
  }, [activeDayId, totals?.confirmed, addToast, onRefresh, refresh]);

  const handleRefresh = useCallback(() => {
    void refresh();
  }, [refresh]);

  const empty = !loading && blocks.length === 0;

  return (
    <section
      className="surface-card bg-bg-surface/60 p-4 min-w-0"
      aria-label="Meal serve panel"
    >
      {/* Header */}
      <div className="flex items-center justify-between gap-2 mb-3">
        <div className="flex items-center gap-2 min-w-0">
          <UtensilsCrossed className="w-4 h-4 text-action-primary shrink-0" />
          <span className="text-sm font-bold text-text-primary truncate">
            Meal Serve
          </span>
          {totals ? (
            <span className="text-xs font-mono text-text-muted truncate">
              {totals.confirmed}/{totals.declared} confirmed
            </span>
          ) : null}
        </div>
        <button
          type="button"
          onClick={handleRefresh}
          disabled={loading}
          className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-semibold text-text-secondary hover:text-text-primary hover:bg-bg-elevated disabled:opacity-40 disabled:cursor-not-allowed transition-colors shrink-0"
          aria-label="Refresh meal serve data"
        >
          {loading ? (
            <Loader2 className="size-3.5 animate-spin" />
          ) : (
            <Radio className="size-3.5" />
          )}
          <span>Refresh</span>
        </button>
      </div>

      {loading && blocks.length === 0 ? (
        <div className="flex items-center gap-2 text-xs text-text-muted py-4 justify-center">
          <Loader2 className="w-4 h-4 animate-spin" />
          <span>Loading meal serve feed…</span>
        </div>
      ) : empty ? (
        <EmptyState
          title="No meal service data"
          description="There is no active mess day with declared attendance to serve yet."
          icon={<Landmark className="w-5 h-5" />}
        />
      ) : (
        <>
          {/* Per-hostel-block live feed (declared vs confirmed, veg/non-veg). */}
          <ul className="space-y-1.5 max-h50 overflow-y-auto custom-scrollbar pr-1 mb-3">
            {blocks.map((b) => (
              <li
                key={b.hostelBlock}
                className="surface-card flex items-center justify-between gap-2 bg-bg-elevated px-2.5 py-1.5 min-w-0"
              >
                <div className="min-w-0 flex-1">
                  <div className="flex items-center gap-1.5">
                    <span className="text-xs font-semibold text-text-primary truncate">
                      {b.hostelBlock}
                    </span>
                    <span className="surface-card inline-flex items-center gap-1 px-1.5 py-0.5 text-xs font-mono font-bold text-action-success bg-emerald-400/10 shrink-0">
                      {b.confirmed} served
                    </span>
                  </div>
                  <p className="text-xs font-mono text-text-muted truncate mt-0.5">
                    declared {b.declared} · veg {b.veg} / non-veg {b.nonVeg} ·{" "}
                    {b.attendanceRate}%
                  </p>
                </div>
                <span className="inline-flex items-center gap-1 shrink-0 text-xs font-mono text-text-muted">
                  <PackageCheck className="size-3.5" />
                  {b.attendanceRate}%
                </span>
              </li>
            ))}
          </ul>

          {/* Manual-serve input */}
          <div className="flex items-center gap-2 mb-3">
            <input
              value={tokenCode}
              onChange={(e) => setTokenCode(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === "Enter") {
                  e.preventDefault();
                  void handleManualServe();
                }
              }}
              placeholder="Token code (e.g. 7F3A-9C2D)"
              className="surface-card flex-1 min-w-0 bg-bg-base px-2.5 py-1.5 text-xs font-mono text-text-primary placeholder:text-text-muted outline-none focus:"
              aria-label="Manual serve token code"
              disabled={busy}
            />
            <button
              type="button"
              onClick={() => void handleManualServe()}
              disabled={busy}
              className="surface-card inline-flex items-center gap-1.5 bg-action-primary text-white text-xs font-semibold px-3 py-1.5 hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed transition-opacity shrink-0"
            >
              {busy ? (
                <Loader2 className="size-3.5 animate-spin" />
              ) : (
                <UtensilsCrossed className="size-3.5" />
              )}
              Serve
            </button>
          </div>

          {/* Revoke + bulk affordances */}
          <div className="grid grid-cols-2 gap-2">
            <button
              type="button"
              onClick={() => void handleRevoke()}
              disabled={busy}
              className="surface-card inline-flex items-center justify-center gap-1.5 text-action-danger hover:bg-rose-400/10 disabled:opacity-40 disabled:cursor-not-allowed px-3 py-1.5 text-xs font-semibold transition-colors"
            >
              <Ban className="size-3.5" />
              Revoke day
            </button>
            <button
              type="button"
              onClick={() => void handleMarkAllServed()}
              disabled={busy}
              className="surface-card inline-flex items-center justify-center gap-1.5 text-action-success hover:bg-emerald-400/10 disabled:opacity-40 disabled:cursor-not-allowed px-3 py-1.5 text-xs font-semibold transition-colors"
            >
              <CheckCheck className="size-3.5" />
              Finalize day
            </button>
          </div>

          {/* Footer hint */}
          <p className="mt-3 text-xs text-text-muted">
            Live data refreshed every 15s. Serve with a token code, revoke
            unused tokens for the active day, or finalize the day&apos;s headcount.
          </p>
        </>
      )}
    </section>
  );
}

export default MealServePanel;
</file>

<file path="src/components/approver/MessInchargeCommandBar.tsx">
"use client";
import { useRouter } from "next/navigation";

/**
 * MessInchargeCommandBar — Cmd/Ctrl+K command palette for the mess In-charge
 * console.
 *
 * Mirrors the DeputyWardenCommandBar free-text parser pattern with 5 commands
 * (the new digest-board + MealServePanel spec):
 *   finalize   → POST /api/admin/mess-finalize { messDayId, finalHeadcount }
 *   revoke <day> → POST /api/mess/revoke { dayId }
 *   count      → navigate /mess/daily-meal-counts
 *   menu       → navigate /mess/menu-management
 *   issue <severity> <text> → POST /api/mess/issues { eventType, description }
 *
 * The `finalize` / `revoke` / `issue` commands take optional arguments parsed
 * from the free-text input (the mess day id and severity come from the
 * /api/mess/analytics fetch when omitted). `count` and `menu` are pure
 * navigations to the real mess sub-pages under /mess/.
 *
 * Keyboard: up/down to navigate, Enter to execute, Escape to close.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  CheckCheck,
  Ban,
  BarChart3,
  UtensilsCrossed,
  ShieldAlert,
  Search,
  ChevronRight,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { getConsoleConfig } from "@/config/consoles";
import { useApiResource } from "@/hooks/useApiResource";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
}

/** All mess In-charge command definitions (the new 5-command spec). */
const COMMAND_DEFS: CommandDef[] = [
  {
    id: "finalize",
    label: "Finalize the active mess day",
    hint: "finalize [headcount] — Finalize the day's headcount",
    icon: CheckCheck,
  },
  {
    id: "revoke",
    label: "Revoke unused tokens for a mess day",
    hint: "revoke <dayId> — Revoke all unused tokens for a day",
    icon: Ban,
  },
  {
    id: "count",
    label: "Open daily meal counts",
    hint: "count — Go to the daily meal counts page",
    icon: BarChart3,
  },
  {
    id: "menu",
    label: "Open mess menu management",
    hint: "menu — Go to the mess menu-management page",
    icon: UtensilsCrossed,
  },
  {
    id: "issue",
    label: "Raise a mess issue / exception",
    hint: "issue <severity> <text> — Raise a mess issue (audit-sourced)",
    icon: ShieldAlert,
  },
];

type Action = "FINALIZE" | "REVOKE" | "COUNT" | "MENU" | "ISSUE" | "UNKNOWN";

interface ParsedCommand {
  action: Action;
  /** Day id (revoke) or headcount (finalize), as free-text arg. */
  arg: string;
  /** Remaining tokens (issue description / reason). */
  rest: string;
}

/**
 * Parse a mess In-charge free-text command.
 *
 *   finalize [headcount]
 *   revoke <dayId>
 *   count
 *   menu
 *   issue <severity> <text…>
 */
function parseCommand(input: string): ParsedCommand {
  const tokens = input.trim().split(/\s+/);
  const first = (tokens[0] || "").toLowerCase();
  const empty: ParsedCommand = { action: "UNKNOWN", arg: "", rest: "" };

  if (first === "finalize") {
    return { ...empty, action: "FINALIZE", arg: tokens[1] ?? "" };
  }
  if (first === "revoke") {
    return { ...empty, action: "REVOKE", arg: tokens[1] ?? "" };
  }
  if (first === "count") {
    return { ...empty, action: "COUNT" };
  }
  if (first === "menu") {
    return { ...empty, action: "MENU" };
  }
  if (first === "issue") {
    // issue <severity> <text…>
    const severity = tokens[1] ?? "";
    const rest = tokens.slice(2).join(" ");
    return { ...empty, action: "ISSUE", arg: severity, rest };
  }
  return { ...empty, action: "UNKNOWN" };
}

export interface MessInchargeCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function MessInchargeCommandBar({ role, open, onClose }: MessInchargeCommandBarProps) {
  const addToast = useUIStore((s) => s.addToast);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const [busy, setBusy] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  // The active mess day id, for finalize / revoke when the user omits the arg.
  const { data: analyticsData } = useApiResource<{
    success?: boolean;
    data: { messDayId?: string };
  }>(open ? "/api/mess/analytics" : null, { ttlMs: 15_000, enabled: open });
  const activeDayId = analyticsData?.data?.messDayId ?? "";

  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id));
  }, [role]);

  const filtered = useMemo(() => {
    if (!query.trim()) return available;
    const q = query.toLowerCase();
    return available.filter(
      (c) => c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q)
    );
  }, [query, available]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  const router = useRouter();
  const executeCommand = useCallback(
    async (parsed: ParsedCommand) => {
      if (parsed.action === "UNKNOWN") {
        addToast({ variant: "error", message: "Unknown command. Type a command from the list below." });
        return;
      }
      if (parsed.action === "COUNT") {
        setBusy(true);
        router.push("/mess/daily-meal-counts");
        onClose();
        return;
      }
      if (parsed.action === "MENU") {
        setBusy(true);
        router.push("/mess/menu-management");
        onClose();
        return;
      }
      if (parsed.action === "FINALIZE") {
        // finalize [headcount] — the active day id comes from the analytics
        // fetch when the user doesn't pass one. The finalize endpoint is
        // admin-scoped (withAdminMutation); the mess In-charge calls it with
        // their own auth.
        const dayId = activeDayId;
        if (!dayId) {
          addToast({ variant: "error", message: "No active mess day to finalize." });
          return;
        }
        const headcount = parsed.arg
          ? Number(parsed.arg)
          : null;
        setBusy(true);
        try {
          const res = await fetch("/api/admin/mess-finalize", {
            method: "POST",
            headers: { "Content-Type": "application/json", ...getAuthHeaders() },
            credentials: "include",
            body: JSON.stringify({
              messDayId: dayId,
              // The route requires a non-negative integer finalHeadcount.
              // When the user omits it, fall back to 0 is not meaningful;
              // use the confirmed tally from the latest analytics if available
              // (not fetched here) — so require the user to pass a number.
              finalHeadcount:
                headcount !== null && Number.isInteger(headcount) && headcount >= 0
                  ? headcount
                  : undefined,
            }),
          });
          const json = (await res.json().catch(() => null)) as
            | { success?: boolean; error?: { message?: string } }
            | null;
          if (res.ok && json?.success) {
            addToast({ variant: "success", message: `Finalized mess day ${dayId}.` });
            onClose();
          } else {
            addToast({
              variant: "error",
              message:
                json?.error?.message ??
                (headcount === null
                  ? "Usage: finalize <headcount> — a non-negative integer is required."
                  : `Finalize failed (HTTP ${res.status})`),
            });
          }
        } catch {
          addToast({ variant: "error", message: "Network error while finalizing the mess day" });
        } finally {
          setBusy(false);
        }
        return;
      }
      if (parsed.action === "REVOKE") {
        const dayId = parsed.arg || activeDayId;
        if (!dayId) {
          addToast({ variant: "error", message: "Usage: revoke <dayId> (or pass the active day)" });
          return;
        }
        setBusy(true);
        try {
          const res = await fetch("/api/mess/revoke", {
            method: "POST",
            headers: { "Content-Type": "application/json", ...getAuthHeaders() },
            credentials: "include",
            body: JSON.stringify({ dayId }),
          });
          const json = (await res.json().catch(() => null)) as
            | { success?: boolean; data?: { revokedCount?: number }; error?: { message?: string } }
            | null;
          if (res.ok && json?.success) {
            addToast({
              variant: "success",
              message: `Revoked ${json.data?.revokedCount ?? 0} unused token(s) for ${dayId}.`,
            });
            onClose();
          } else {
            addToast({
              variant: "error",
              message: json?.error?.message ?? `Revoke failed (HTTP ${res.status})`,
            });
          }
        } catch {
          addToast({ variant: "error", message: "Network error while revoking tokens" });
        } finally {
          setBusy(false);
        }
        return;
      }
      if (parsed.action === "ISSUE") {
        // issue <severity> <text…> — the route reads { eventType, description }.
        // Map the free-text severity token onto eventType; the rest is the
        // description.
        const severity = parsed.arg || "MESS_ISSUE";
        const description = parsed.rest || severity;
        if (!description.trim()) {
          addToast({ variant: "error", message: "Usage: issue <severity> <text>" });
          return;
        }
        setBusy(true);
        try {
          const res = await fetch("/api/mess/issues", {
            method: "POST",
            headers: { "Content-Type": "application/json", ...getAuthHeaders() },
            credentials: "include",
            body: JSON.stringify({ eventType: severity.toUpperCase(), description }),
          });
          const json = (await res.json().catch(() => null)) as
            | { success?: boolean; error?: { message?: string } }
            | null;
          if (res.ok && json?.success) {
            addToast({ variant: "success", message: `Raised mess issue (${severity}).` });
            onClose();
          } else {
            addToast({
              variant: "error",
              message: json?.error?.message ?? `Issue raise failed (HTTP ${res.status})`,
            });
          }
        } catch {
          addToast({ variant: "error", message: "Network error while raising the issue" });
        } finally {
          setBusy(false);
        }
        return;
      }
    },
    [activeDayId, addToast, onClose],
  );

  const handleSelect = useCallback((cmd: CommandDef) => {
    // Pre-fill the input with the keyword so the user can add the inline args.
    setQuery(cmd.id + " ");
    inputRef.current?.focus();
  }, []);

  const handleEnter = useCallback(() => {
    const parsed = parseCommand(query);
    const first = (query.trim().split(/\s+/)[0] || "").toLowerCase();
    // Bare keywords that need inline args: keep focus so the user can finish.
    if (parsed.action === "UNKNOWN" || (first === "finalize" && !query.trim().split(/\s+/)[1]) || (first === "revoke" && !query.trim().split(/\s+/)[1]) || (first === "issue" && !query.trim().split(/\s+/).slice(1).join(" ").trim())) {
      inputRef.current?.focus();
      return;
    }
    void executeCommand(parsed);
  }, [executeCommand, query]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!query.trim()) {
          if (filtered[active]) handleSelect(filtered[active]);
        } else {
          handleEnter();
        }
      }
    },
    [filtered, active, handleSelect, handleEnter, query]
  );

  if (!open) return null;

  const parsedPreview = query.trim() ? parseCommand(query) : null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="Mess In-charge command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={`Mess command (role: ${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="Mess In-charge command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Parsed-command preview */}
        {parsedPreview && parsedPreview.action !== "UNKNOWN" ? (
          <div className="surface-card px-4 py-2 bg-bg-elevated text-xs text-text-secondary">
            <span className="font-mono font-bold text-action-primary">
              {parsedPreview.action}
            </span>
            {parsedPreview.action === "ISSUE" ? (
              <>
                {parsedPreview.arg ? (
                  <span className="ml-1.5 font-mono">{parsedPreview.arg}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[severity]</span>
                )}
                {parsedPreview.rest ? (
                  <span className="ml-1.5 text-text-muted italic">
                    {parsedPreview.rest.length > 24 ? parsedPreview.rest.slice(0, 24) + "…" : parsedPreview.rest}
                  </span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[text]</span>
                )}
              </>
            ) : parsedPreview.arg ? (
              <span className="ml-1.5 font-mono">{parsedPreview.arg}</span>
            ) : null}
            {busy ? <span className="ml-2 text-text-muted">processing…</span> : null}
          </div>
        ) : null}

        {/* Command list */}
        <ul role="listbox" aria-label="Mess In-charge commands" className="max-h-64 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors disabled:opacity-50 ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>
      </div>
    </div>
  );
}

export default MessInchargeCommandBar;
</file>

<file path="src/components/approver/MyWorkPanel.tsx">
"use client";

/**
 * MyWorkPanel — the worker console's main-column panel.
 *
 * Desktop: right-side panel rendered by RoleConsole alongside the digest
 * board. Mobile: full-width, no horizontal scroll.
 *
 * Reads GET /api/workers/my-work, which returns
 *   { success, data: { tasks, completedLastWeek, todayShift } }
 * where `tasks` is a flat array of the caller's open work orders
 * (permission_requests scoped to the caller's user id, status=PENDING,
 * last 30 days) and `todayShift` is a single-row shift snapshot.
 *
 * The panel lists the caller's work items: ticket, status, created-at
 * ("due"), and the last-update proxy (todayShift.checkIn / the newest
 * task createdAt). EmptyState when there are no open tasks.
 */

import { useMemo } from "react";
import { ClipboardList, Loader2, Inbox } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

/** A single open work-order row from /api/workers/my-work data.tasks. */
interface WorkTaskRow {
  id: string;
  ticket?: string;
  type?: string;
  stage?: string;
  status?: string;
  createdAt?: string;
}

interface MyWorkResponse {
  success: boolean;
  data: {
    tasks?: WorkTaskRow[];
    completedLastWeek?: number;
    todayShift?: { checkIn?: string | null; checkOut?: string | null; scans?: number } | null;
  };
}

const fmt = (iso: string | null | undefined) => {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return "—";
  }
};

export function MyWorkPanel() {
  const { data, loading } = useApiResource<MyWorkResponse>("/api/workers/my-work", {
    ttlMs: 30_000,
  });

  const tasks = useMemo<WorkTaskRow[]>(
    () => (Array.isArray(data?.data?.tasks) ? data!.data!.tasks! : []),
    [data],
  );

  // "Last update" proxy: the newest of today's shift check-in and the
  // most recently created open task. The endpoint exposes no explicit
  // updated_at per task, so the newest createdAt is the best available.
  const lastUpdate = useMemo(() => {
    const candidates: string[] = [];
    if (data?.data?.todayShift?.checkIn) candidates.push(data.data.todayShift.checkIn);
    for (const t of tasks) if (t.createdAt) candidates.push(t.createdAt);
    if (candidates.length === 0) return null;
    let newest = candidates[0];
    for (const c of candidates) {
      if (new Date(c).getTime() > new Date(newest).getTime()) newest = c;
    }
    return newest;
  }, [tasks, data]);

  return (
    <WidgetBoundary title="My Work">
      <section className="surface-card bg-bg-surface/60 p-4 min-w-0">
        {/* Header */}
        <div className="flex items-center justify-between gap-2 mb-3">
          <div className="flex items-center gap-2 min-w-0">
            <ClipboardList className="w-4 h-4 text-action-primary shrink-0" />
            <span className="text-sm font-bold text-text-primary truncate">
              My Work Items
            </span>
          </div>
          <span className="surface-card inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold text-text-secondary bg-bg-base shrink-0">
            <span className="size-0 rounded-full bg-action-primary" />
            {tasks.length} open
          </span>
        </div>

        {/* Body */}
        {loading && !data ? (
          <div className="flex items-center gap-2 text-xs text-text-muted py-4">
            <Loader2 className="w-4 h-4 animate-spin" />
            Loading work items…
          </div>
        ) : tasks.length > 0 ? (
          <ul className="space-y-1.5 max-h70 overflow-y-auto custom-scrollbar pr-1 min-w-0">
            {tasks.map((t) => (
              <li
                key={t.id}
                className="surface-card bg-bg-elevated px-3 py-2 min-w-0"
              >
                <div className="flex items-center justify-between gap-2 min-w-0">
                  <p className="text-xs font-mono font-semibold text-text-primary truncate">
                    {t.ticket || t.id}
                  </p>
                  <span className="text-xs font-mono text-text-muted shrink-0 uppercase">
                    {t.status ?? "PENDING"}
                  </span>
                </div>
                <div className="flex items-center justify-between gap-2 min-w-0 mt-1">
                  <p className="text-xs text-text-secondary truncate">
                    {t.type ? `${t.type} · ` : ""}
                    stage: {t.stage ?? "—"}
                  </p>
                  <p className="text-xs font-mono text-text-muted shrink-0">
                    due {fmt(t.createdAt)}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState
            title="No open work items"
            description="Your open maintenance work orders will appear here when assigned."
            icon={<Inbox className="w-4 h-4 text-text-muted" />}
          />
        )}

        {/* Footer: last update */}
        <div className="surface-card mt-3 pt-3 flex items-center justify-between gap-2 min-w-0">
          <span className="text-xs text-text-muted truncate">
            {data?.data?.completedLastWeek
              ? `${data.data.completedLastWeek} completed last week`
              : "No recent completions"}
          </span>
          <span className="text-xs font-mono text-text-muted shrink-0">
            last update {fmt(lastUpdate)}
          </span>
        </div>
      </section>
    </WidgetBoundary>
  );
}

export default MyWorkPanel;
</file>

<file path="src/components/approver/OieCommandBar.tsx">
"use client";
import { useRouter } from "next/navigation";

/**
 * OieCommandBar — Cmd/Ctrl+K command palette for the OIE exam-desk console.
 *
 * Mirrors the DeputyWardenCommandBar free-text parser pattern with 5 commands:
 *   approve <ticket>            PATCH /api/permissions/<ticket> { action: APPROVE }
 *   reject <ticket> [reason]   PATCH /api/permissions/<ticket> { action: REJECT, comment }
 *   forward <ticket> to <role> POST /api/permissions/<ticket>/forward { targetRole, comment }
 *   day-access open|close      POST /api/exam/access { open: boolean }
 *   exceptions                 navigate to /oie/access-exceptions
 *
 * day-access is a best-effort call: /api/exam/access currently exposes GET
 * only (no POST handler), so a non-2xx response surfaces an "endpoint not
 * available" toast instead of 404ing the user.
 *
 * Keyboard: up/down to navigate, Enter to execute, Escape to close.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  CheckCircle,
  XCircle,
  ArrowRight,
  DoorOpen,
  ShieldAlert,
  Search,
  ChevronRight,
} from "lucide-react";
import { getAuthHeaders } from "@/lib/utils";
import { useUIStore } from "@/stores/uiStore";
import { getConsoleConfig } from "@/config/consoles";

interface CommandDef {
  id: string;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
}

const COMMAND_DEFS: CommandDef[] = [
  {
    id: "approve",
    label: "Approve an exam ticket",
    hint: "approve <ticket> — Approve a pending exam ticket",
    icon: CheckCircle,
  },
  {
    id: "reject",
    label: "Reject an exam ticket",
    hint: "reject <ticket> [reason] — Reject with optional reason",
    icon: XCircle,
  },
  {
    id: "forward",
    label: "Forward a ticket to a higher role",
    hint: "forward <ticket> to <role> — Forward to a strictly-higher role",
    icon: ArrowRight,
  },
  {
    id: "day-access",
    label: "Open / close exam-day access",
    hint: "day-access open|close — Toggle the exam-day gate state",
    icon: DoorOpen,
  },
  {
    id: "exceptions",
    label: "Open access exceptions",
    hint: "exceptions — Go to the access-exceptions list",
    icon: ShieldAlert,
  },
];

type Action =
  | "APPROVE"
  | "REJECT"
  | "FORWARD"
  | "DAY_ACCESS"
  | "EXCEPTIONS"
  | "UNKNOWN";

interface ParsedCommand {
  action: Action;
  ticket: string;
  reason: string;
  targetRole: string;
  dayState: "open" | "close" | "";
}

/**
 * Parse an OIE free-text command.
 *
 *   approve <ticket>
 *   reject <ticket> [reason...]
 *   forward <ticket> to <role>
 *   day-access open|close
 *   exceptions
 */
function parseCommand(input: string): ParsedCommand {
  const tokens = input.trim().split(/\s+/);
  const first = (tokens[0] || "").toLowerCase();
  const empty: ParsedCommand = {
    action: "UNKNOWN",
    ticket: "",
    reason: "",
    targetRole: "",
    dayState: "",
  };

  if (first === "approve") {
    return { ...empty, action: "APPROVE", ticket: tokens[1] ?? "" };
  }
  if (first === "reject") {
    const rest = tokens.slice(2).join(" ");
    return { ...empty, action: "REJECT", ticket: tokens[1] ?? "", reason: rest };
  }
  if (first === "forward") {
    const ticket = tokens[1] ?? "";
    const toIdx = tokens.findIndex((t) => t.toLowerCase() === "to");
    const targetRole = toIdx > 0 ? tokens[toIdx + 1] ?? "" : "";
    return { ...empty, action: "FORWARD", ticket, targetRole };
  }
  if (first === "day-access") {
    const raw = (tokens[1] ?? "").toLowerCase();
    const dayState: ParsedCommand["dayState"] =
      raw === "open" ? "open" : raw === "close" ? "close" : "";
    return { ...empty, action: "DAY_ACCESS", dayState };
  }
  if (first === "exceptions") {
    return { ...empty, action: "EXCEPTIONS" };
  }
  return { ...empty, action: "UNKNOWN" };
}

export interface OieCommandBarProps {
  role: string;
  open: boolean;
  onClose: () => void;
}

export function OieCommandBar({ role, open, onClose }: OieCommandBarProps) {
  const addToast = useUIStore((s) => s.addToast);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const [busy, setBusy] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const available = useMemo(() => {
    const cfg = getConsoleConfig(role);
    const ids: string[] = cfg?.commands ?? [];
    if (ids.length === 0) return COMMAND_DEFS;
    return COMMAND_DEFS.filter((c) => ids.includes(c.id));
  }, [role]);

  const filtered = useMemo(() => {
    if (!query.trim()) return available;
    const q = query.toLowerCase();
    return available.filter(
      (c) => c.label.toLowerCase().includes(q) || c.hint.toLowerCase().includes(q)
    );
  }, [query, available]);

  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  const router = useRouter();
  const executeCommand = useCallback(
    async (parsed: ParsedCommand) => {
      // ── exceptions: navigate to the access-exceptions page ──
      if (parsed.action === "EXCEPTIONS") {
        router.push("/oie/access-exceptions");
        onClose();
        return;
      }

      // ── day-access: POST /api/exam/access { open } ──
      if (parsed.action === "DAY_ACCESS") {
        if (parsed.dayState !== "open" && parsed.dayState !== "close") {
          addToast({ variant: "error", message: "Usage: day-access open|close" });
          return;
        }
        setBusy(true);
        try {
          const res = await fetch("/api/exam/access", {
            method: "POST",
            headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
            body: JSON.stringify({ open: parsed.dayState === "open" }),
          });
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            addToast({
              variant: "success",
              message: `Exam day access ${parsed.dayState === "open" ? "opened" : "closed"}`,
            });
            onClose();
          } else {
            addToast({
              variant: "info",
              message:
                json?.error?.message ||
                `Day-access ${parsed.dayState}: endpoint not available yet`,
            });
          }
        } catch {
          addToast({ variant: "info", message: "Day-access: endpoint not available yet" });
        } finally {
          setBusy(false);
        }
        return;
      }

      if (parsed.action === "UNKNOWN") {
        addToast({ variant: "error", message: "Unknown command. Type a command from the list below." });
        return;
      }

      // ── forward: POST /api/permissions/<ticket>/forward ──
      if (parsed.action === "FORWARD") {
        if (!parsed.ticket || !parsed.targetRole) {
          addToast({ variant: "error", message: "Usage: forward <ticket> to <role>" });
          return;
        }
        setBusy(true);
        try {
          const res = await fetch(
            `/api/permissions/${encodeURIComponent(parsed.ticket)}/forward`,
            {
              method: "POST",
              headers: getAuthHeaders(),
              body: JSON.stringify({
                targetRole: parsed.targetRole,
                comment: `to ${parsed.targetRole}`,
              }),
            }
          );
          const json = await res.json().catch(() => null);
          if (res.ok && json?.success) {
            addToast({
              variant: "success",
              message: `Forwarded ${parsed.ticket} to ${parsed.targetRole}`,
            });
            onClose();
          } else {
            addToast({
              variant: "error",
              message:
                json?.error?.message ||
                `Failed to forward ${parsed.ticket} to ${parsed.targetRole}`,
            });
          }
        } catch {
          addToast({ variant: "error", message: "Network error while forwarding ticket" });
        } finally {
          setBusy(false);
        }
        return;
      }

      // ── approve / reject: PATCH /api/permissions/<ticket> ──
      if (!parsed.ticket) {
        addToast({ variant: "error", message: "Usage: <action> <ticket>" });
        return;
      }

      const body: Record<string, string> = { action: parsed.action };
      if (parsed.reason) body.comment = parsed.reason;

      setBusy(true);
      try {
        const res = await fetch(
          `/api/permissions/${encodeURIComponent(parsed.ticket)}`,
          {
            method: "PATCH",
            headers: getAuthHeaders(),
            body: JSON.stringify(body),
          }
        );
        const json = await res.json().catch(() => null);
        if (res.ok && json?.success) {
          addToast({
            variant: parsed.action === "REJECT" ? "info" : "success",
            message: `${parsed.action} processed for ${parsed.ticket}`,
          });
          onClose();
        } else {
          addToast({
            variant: "error",
            message: json?.error?.message || `Failed to ${parsed.action} ${parsed.ticket}`,
          });
        }
      } catch {
        addToast({ variant: "error", message: "Network error while processing command" });
      } finally {
        setBusy(false);
      }
    },
    [addToast, onClose]
  );

  const handleSelect = useCallback((cmd: CommandDef) => {
    const prefix =
      cmd.id === "forward" ? "forward " : cmd.id === "day-access" ? "day-access " : `${cmd.id} `;
    setQuery(cmd.id === "exceptions" ? "exceptions" : prefix);
    inputRef.current?.focus();
  }, []);

  const handleEnter = useCallback(() => {
    const parsed = parseCommand(query);
    const first = query.trim().toLowerCase();
    // Bare keywords that need more tokens: keep focus so the user can finish.
    if (["approve", "reject", "forward", "day-access", "exceptions"].includes(first)) {
      if (
        first === "forward" ||
        parsed.action === "UNKNOWN" ||
        (parsed.action !== "EXCEPTIONS" && parsed.action !== "DAY_ACCESS" && !parsed.ticket) ||
        (parsed.action === "DAY_ACCESS" && parsed.dayState === "") ||
        (parsed.action === "FORWARD" && !parsed.targetRole)
      ) {
        if (first === "exceptions" && parsed.action === "EXCEPTIONS") {
          executeCommand(parsed);
          return;
        }
        inputRef.current?.focus();
        return;
      }
    }
    executeCommand(parsed);
  }, [executeCommand, query]);

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!query.trim()) {
          if (filtered[active]) handleSelect(filtered[active]);
        } else {
          handleEnter();
        }
      }
    },
    [filtered, active, handleSelect, handleEnter, query]
  );

  if (!open) return null;

  const parsedPreview = query.trim() ? parseCommand(query) : null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="OIE command palette"
    >
      <div
        className="w-full max-w-md bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder={`OIE command (role: ${role})…`}
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none min-w-0"
            aria-label="OIE command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted shrink-0">
            esc
          </kbd>
        </div>

        {/* Parsed-command preview */}
        {parsedPreview && parsedPreview.action !== "UNKNOWN" ? (
          <div className="surface-card px-4 py-2 bg-bg-elevated text-xs text-text-secondary">
            <span className="font-mono font-bold text-action-primary">
              {parsedPreview.action}
            </span>
            {parsedPreview.action === "FORWARD" ? (
              <>
                {parsedPreview.ticket ? (
                  <span className="ml-1.5 font-mono">{parsedPreview.ticket}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[ticket required]</span>
                )}
                {parsedPreview.targetRole ? (
                  <span className="ml-1.5 text-text-muted italic">to {parsedPreview.targetRole}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[role required]</span>
                )}
              </>
            ) : parsedPreview.action === "DAY_ACCESS" ? (
              parsedPreview.dayState ? (
                <span className="ml-1.5 text-text-muted italic">{parsedPreview.dayState}</span>
              ) : (
                <span className="ml-1.5 text-text-muted italic">[open|close required]</span>
              )
            ) : (
              <>
                {parsedPreview.ticket ? (
                  <span className="ml-1.5 font-mono">{parsedPreview.ticket}</span>
                ) : (
                  <span className="ml-1.5 text-text-muted italic">[ticket required]</span>
                )}
                {parsedPreview.reason ? (
                  <span className="ml-1.5 text-text-muted italic">reason: {parsedPreview.reason}</span>
                ) : null}
              </>
            )}
            {busy ? <span className="ml-2 text-text-muted">processing…</span> : null}
          </div>
        ) : null}

        {/* Command list */}
        <ul role="listbox" aria-label="OIE commands" className="max-h-64 overflow-y-auto py-1">
          {filtered.length === 0 ? (
            <li className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </li>
          ) : (
            filtered.map((cmd, idx) => {
              const Icon = cmd.icon;
              const isActive = idx === active;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    disabled={busy}
                    onClick={() => handleSelect(cmd)}
                    onMouseEnter={() => setActive(idx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors disabled:opacity-50 ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="flex-1 min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate font-mono">
                        {cmd.hint}
                      </p>
                    </div>
                    {isActive ? (
                      <ChevronRight className="w-4 h-4 text-action-primary shrink-0" />
                    ) : null}
                  </button>
                </li>
              );
            })
          )}
        </ul>
      </div>
    </div>
  );
}

export default OieCommandBar;
</file>

