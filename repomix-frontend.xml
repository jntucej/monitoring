<file path="src/components/retention/TaskContinuity.tsx">
"use client";

import React, { useState, useEffect, useCallback, useMemo } from "react";
import {RotateCw, Clock, ChevronRight, X, ListPlus}  from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { useTaskDraftStore, hydrateTaskDraftsFromServer, type TaskDraftEntry } from "@/stores/taskDraftStore";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { getTaskDrafts } from "@/lib/retention";

/* ------------------------------------------------------------------ */
/* Draft type labels                                                   */
/* ------------------------------------------------------------------ */

const DRAFT_TYPE_LABELS: Record<string, string> = {
  request_draft: "Request Draft",
  event_registration: "Event Registration",
  approval_queue: "Approval Queue Position",
  incident: "Incident",
  draft_announcement: "Draft Announcement",
  search_filters: "Search Filters",
};

function getDraftLabel(draft: TaskDraftEntry): string {
  const label = DRAFT_TYPE_LABELS[draft.taskType] ?? draft.taskType;
  const extra =
    typeof draft.payload?.subject === "string"
      ? `: ${draft.payload.subject}`
      : typeof draft.payload?.title === "string"
      ? `: ${draft.payload.title}`
      : "";
  return label + extra;
}

/* ------------------------------------------------------------------ */
/* Component                                                           */
/* ------------------------------------------------------------------ */

export function TaskContinuity() {
  const { user } = useAuthStore();
  const localDrafts = useTaskDraftStore((s) => s.drafts);
  const [serverDrafts, setServerDrafts] = useState<TaskDraftEntry[]>([]);
  const [loading, setLoading] = useState(true);
  const [expanded, setExpanded] = useState<string | null>(null);

  const load = useCallback(async () => {
    if (!user) return;
    setLoading(true);
    try {
      // Hydrate local from server first
      await hydrateTaskDraftsFromServer();

      // Also fetch fresh from server
      const result = await getTaskDrafts();
      if (result.success) {
        setServerDrafts(
          result.data.drafts.map((d) => ({
            taskType: d.taskType as TaskDraftEntry["taskType"],
            payload: d.payload,
            position: d.position,
            updatedAt: d.updatedAt,
          }))
        );
      }
    } catch {
      // Silently fail
    } finally {
      setLoading(false);
    }
  }, [user]);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  const allDrafts = useMemo(() => {
    // Merge: prefer local (fresh), add server-only entries
    const localKeys = new Set(
      localDrafts.map((d) => `${d.taskType}:${d.position}`)
    );
    const serverOnly = serverDrafts.filter(
      (d) => !localKeys.has(`${d.taskType}:${d.position}`)
    );
    return [...localDrafts, ...serverOnly];
  }, [localDrafts, serverDrafts]);

  const handleResume = useCallback(
    (draft: TaskDraftEntry) => {
      // Navigate to the relevant page based on task type
      const base =
        draft.taskType === "request_draft"
          ? "/approver"
          : draft.taskType === "event_registration"
          ? "/campus"
          : draft.taskType === "approval_queue"
          ? "/approver"
          : draft.taskType === "incident"
          ? "/admin"
          : draft.taskType === "draft_announcement"
          ? "/admin"
          : "/";

      // Store the draft payload in sessionStorage for the target page to pick up
      try {
        sessionStorage.setItem(
          `resume-draft-${draft.taskType}`,
          JSON.stringify(draft.payload)
        );
      } catch {
        // Silently ignore
      }

      // Navigate — use window.location to avoid router dependency
      window.location.assign(base);
    },
    []
  );

  const handleDismiss = useCallback(
    async (draft: TaskDraftEntry) => {
      try {
        // Remove locally
        useTaskDraftStore.getState().removeDraft(draft.taskType, draft.position);
        // Also remove from server (best effort)
        const raw =
          sessionStorage.getItem("gate-monitor-auth") ??
          localStorage.getItem("gate-monitor-auth");
        if (raw) {
          const parsed = JSON.parse(raw);
          const token = parsed?.state?.token;
          if (token) {







            // Silently ignore
          }
        }
      } catch {
        // Silently ignore
      }
    },
    []
  );

  // Group drafts by type for display
  const grouped = useMemo(() => {
    const map: Record<string, TaskDraftEntry[]> = {};
    for (const d of allDrafts) {
      if (!map[d.taskType]) map[d.taskType] = [];
      map[d.taskType].push(d);
    }
    return map;
  }, [allDrafts]);

  const hasDrafts = allDrafts.length > 0;

  return (
    <WidgetBoundary title="Task Continuity">
      <div className="surface-card bg-bg-elevated/40 p-4 sm:p-5">
        {/* Header */}
        <div className="flex items-center gap-2 mb-4">
          <RotateCw className="h-4 w-4 text-unit-c" />
          <h3 className="text-sm font-medium text-text-primary">Resume Where You Left Off</h3>
          {hasDrafts && (
            <span className="surface-card bg-violet-500/20 px-2 py-0.5 text-xs text-unit-c">
              {allDrafts.length} draft(s)
            </span>
          )}
        </div>

        {/* Resume Banner */}
        {hasDrafts && (
          <div className="surface-card mb-4 bg-violet-500/10 p-3">
            <p className="text-xs text-violet-200 mb-1">
              You have unfinished work waiting. Pick up where you left off:
            </p>
            <ul className="space-y-1">
              {allDrafts.slice(0, 3).map((d, i) => (
                <li key={i} className="text-xs text-violet-300/80 truncate">
                  • {getDraftLabel(d)}
                  {d.updatedAt && (
                    <span className="text-violet-400/50 ml-1">
                      ({new Date(d.updatedAt).toLocaleDateString()})
                    </span>
                  )}
                </li>
              ))}
              {allDrafts.length > 3 && (
                <li className="text-xs text-violet-400/50">
                  +{allDrafts.length - 3} more
                </li>
              )}
            </ul>
          </div>
        )}

        {/* Draft List */}
        {loading ? (
          <div className="h-20 animate-pulse rounded bg-bg-elevated/20" />
        ) : !hasDrafts ? (
          <div className="py-6 text-center">
            <p className="text-xs text-text-muted">
              No saved drafts. In-progress tasks will appear here automatically.
            </p>
          </div>
        ) : (
          <div className="space-y-2 max-h-72 overflow-y-auto">
            {Object.entries(grouped).map(([type, drafts]) => (
              <div key={type}>
                <p className="text-xs font-medium text-text-muted uppercase tracking-wide mb-1.5 flex items-center gap-1">
                  <ListPlus className="size-3.5" />
                  {DRAFT_TYPE_LABELS[type] ?? type}
                </p>
                {drafts.map((draft, i) => (
                  <div
                    key={`${draft.taskType}-${i}`}
                    className={`rounded-lg border p-3 mb-1.5 ${
                      expanded === `${draft.taskType}:${draft.position}`
                        ? "border-violet-500/40 bg-violet-500/10"
                        : "border-border/40 bg-bg-elevated/30"
                    }`}
                  >
                    <button
                      type="button"
                      onClick={() =>
                        setExpanded(
                          expanded === `${draft.taskType}:${draft.position}`
                            ? null
                            : `${draft.taskType}:${draft.position}`
                        )
                      }
                      className="flex w-full items-center gap-2 text-left"
                    >
                      <span className="text-xs text-text-secondary flex-1 truncate">
                        {getDraftLabel(draft)}
                      </span>
                      {draft.updatedAt && (
                        <span className="text-xs text-text-muted shrink-0 flex items-center gap-1">
                          <Clock className="size-3.5" />
                          {new Date(draft.updatedAt).toLocaleDateString()}
                        </span>
                      )}
                      <ChevronRight
                        className={`h-3.5 w-3.5 text-text-muted transition-transform motion-reduce:transition-none ${
                          expanded === `${draft.taskType}:${draft.position}`
                            ? "rotate-90"
                            : ""
                        }`}
                      />
                    </button>

                    {expanded === `${draft.taskType}:${draft.position}` && (
                      <div className="mt-2 space-y-2">
                        <div className="surface-card bg-bg-surface/50 p-2 text-xs text-text-muted font-mono break-all max-h-24 overflow-y-auto">
                          {JSON.stringify(draft.payload, null, 2)}
                        </div>
                        <div className="flex gap-2">
                          <button
                            type="button"
                            onClick={() => handleResume(draft)}
                            className="surface-card flex items-center gap-1 bg-violet-500/80 px-2.5 py-1 text-xs text-white hover:bg-unit-c transition-colors motion-reduce:transition-none"
                          >
                            <RotateCw className="size-3.5" />
                            Resume
                          </button>
                          <button
                            type="button"
                            onClick={() => handleDismiss(draft)}
                            className="surface-card flex items-center gap-1 px-2.5 py-1 text-xs text-text-muted hover:bg-bg-elevated/40 transition-colors motion-reduce:transition-none"
                          >
                            <X className="size-3.5" />
                            Dismiss
                          </button>
                        </div>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            ))}
          </div>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default TaskContinuity;
</file>

<file path="src/components/retention/UnifiedCampusCalendar.tsx">
"use client";

import React, { useState, useEffect, useCallback, useMemo } from "react";
import {
  ChevronLeft,
  ChevronRight,
  Bell,
  BellOff,
  Calendar as CalendarIcon,
  Check,
} from "lucide-react";
import { useAuthStore } from "@/stores/authStore";

import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { getAuthHeaders } from "@/lib/utils";
import {
  getUnifiedCalendar,
  type CalendarEvent,
  type CalendarCategories,
} from "@/lib/retention";

/* ------------------------------------------------------------------ */
/* Helpers                                                             */
/* ------------------------------------------------------------------ */

const CATEGORY_COLORS: Record<string, string> = {
  examination: "var(--unit-c)",
  workshop: "var(--action-primary)",
  event: "var(--action-success)",
  department: "var(--action-warning)",
  hostel: "var(--action-info)",
  staff_duty: "var(--action-danger)",
  maintenance: "var(--action-success)",
  admin_deadline: "var(--unit-c)",
};

function getMonthKey(date: Date): string {
  return date.toISOString().slice(0, 7);
}

function daysInMonth(year: number, month: number): number {
  return new Date(year, month + 1, 0).getDate();
}

/* ------------------------------------------------------------------ */
/* Component                                                           */
/* ------------------------------------------------------------------ */

export function UnifiedCampusCalendar() {
  const { user } = useAuthStore();
  const [currentMonth, setCurrentMonth] = useState(getMonthKey(new Date()));
  const [events, setEvents] = useState<CalendarEvent[]>([]);
  const [categories, setCategories] = useState<CalendarCategories[]>([]);
  const [followedCategories, setFollowedCategories] = useState<string[]>([]);
  const [loading, setLoading] = useState(true);

  const [view, setView] = useState<"month" | "list">("month");

  const load = useCallback(async () => {
    if (!user) return;
    setLoading(true);
    try {
      const result = await getUnifiedCalendar(currentMonth, followedCategories);
      if (result.success) {
        setEvents(result.data.events);
        setCategories(result.data.categories);
        setFollowedCategories(result.data.followedCategories);
      }
    } catch {
      // Silently fail
    } finally {
      setLoading(false);
    }
  }, [user, currentMonth, followedCategories]);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  const toggleFollow = useCallback(
    async (categoryCode: string, reminder: boolean) => {
      if (!user) return;
      try {
        const headers = getAuthHeaders();
        await fetch(
          `/api/campus-extra/calendar?follow=${encodeURIComponent(
            categoryCode
          )}&reminder=${reminder}`,
          { method: "POST", headers }
        );
        // Refetch
        const result = await getUnifiedCalendar(currentMonth, followedCategories);
        if (result.success) {
          setFollowedCategories(result.data.followedCategories);
          setCategories(result.data.categories);
        }
      } catch {
        // Silently ignore
      }
    },
    [user, currentMonth, followedCategories]
  );

  // Build the month grid
  const [year, monthNum] = currentMonth.split("-").map(Number);
  const firstDay = new Date(year, monthNum - 1, 1).getDay();
  const numDays = daysInMonth(year, monthNum);
  const monthLabel = new Date(year, monthNum - 1, 1).toLocaleDateString(undefined, {
    month: "long",
    year: "numeric",
  });

  const eventsByDay = useMemo(() => {
    const map: Record<string, CalendarEvent[]> = {};
    for (const ev of events) {
      const day = ev.date.slice(0, 10);
      if (!map[day]) map[day] = [];
      map[day].push(ev);
    }
    return map;
  }, [events]);

  const cells: Array<{ day: number | null; dateStr: string; isCurrentMonth: boolean }> = [];
  for (let i = 0; i < firstDay; i++) {
    cells.push({ day: null, dateStr: "", isCurrentMonth: false });
  }
  for (let d = 1; d <= numDays; d++) {
    const dateStr = `${year}-${String(monthNum).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    cells.push({ day: d, dateStr, isCurrentMonth: true });
  }
  while (cells.length % 7 !== 0) {
    cells.push({ day: null, dateStr: "", isCurrentMonth: false });
  }

  const prevMonth = () => {
    const d = new Date(year, monthNum - 2, 1);
    setCurrentMonth(getMonthKey(d));
  };
  const nextMonth = () => {
    const d = new Date(year, monthNum, 1);
    setCurrentMonth(getMonthKey(d));
  };

  const isFollowed = (code: string) => followedCategories.includes(code);

  return (
    <WidgetBoundary title="Unified Campus Calendar">
      <div className="surface-card bg-bg-elevated/40 p-4 sm:p-5">
        {/* Header */}
        <div className="flex items-center justify-between mb-4 flex-wrap gap-2">
          <div className="flex items-center gap-2">
            <CalendarIcon className="h-4 w-4 text-action-primary" />
            <h3 className="text-sm font-medium text-text-primary">Campus Calendar</h3>
            <span className="text-xs text-text-muted">{monthLabel}</span>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={prevMonth}
              className="surface-card p-1 hover:bg-bg-elevated/50 text-text-muted transition-colors motion-reduce:transition-none"
              aria-label="Previous month"
            >
              <ChevronLeft className="h-4 w-4" />
            </button>
            <button
              type="button"
              onClick={nextMonth}
              className="surface-card p-1 hover:bg-bg-elevated/50 text-text-muted transition-colors motion-reduce:transition-none"
              aria-label="Next month"
            >
              <ChevronRight className="h-4 w-4" />
            </button>
            <button
              type="button"
              onClick={() => setView(view === "month" ? "list" : "month")}
              className="surface-card px-2 py-1 text-xs text-text-muted hover:bg-bg-elevated/50 transition-colors motion-reduce:transition-none"
            >
              {view === "month" ? "List" : "Month"}
            </button>
          </div>
        </div>

        {/* Category Filters */}
        <div className="flex flex-wrap gap-1.5 mb-4">
          {categories.map((cat) => {
            const followed = isFollowed(cat.code);
            return (
              <button
                key={cat.code}
                type="button"
                onClick={() => toggleFollow(cat.code, true)}
                className={`flex items-center gap-1 rounded-full px-2.5 py-1 text-xs transition-colors motion-reduce:transition-none ${
                  followed
                    ? "text-white"
                    : "border border-border/50 text-text-muted hover:bg-bg-elevated/40"
                }`}
                style={
                  followed
                    ? {
                        backgroundColor: `${cat.color}30`,
                        borderColor: `${cat.color}60`,
                        color: cat.color,
                      }
                    : undefined
                }
              >
                {followed ? <Check className="size-3.5" /> : <Bell className="size-3.5" />}
                {cat.label}
              </button>
            );
          })}
        </div>

        {loading ? (
          <div className="h-48 animate-pulse rounded bg-bg-elevated/20" />
        ) : view === "month" ? (
          /* Month Grid */
          <div className="grid grid-cols-7 gap-1">
            {["S", "M", "T", "W", "T", "F", "S"].map((d, i) => (
              <div key={i} className="text-center text-xs text-text-muted py-1">
                {d}
              </div>
            ))}
            {cells.map((cell, i) => (
              <div
                key={i}
                className={`min-h14 rounded border p-1 text-xs ${
                  cell.isCurrentMonth
                    ? "border-border/50 bg-bg-elevated/30"
                    : "border-transparent"
                } ${
                  cell.day &&
                  eventsByDay[cell.dateStr]?.some((e) => e.followable)
                    ? "ring-1 ring-indigo-500/20"
                    : ""
                }`}
              >
                {cell.day && (
                  <div className="text-text-muted mb-0.5">{cell.day}</div>
                )}
                {cell.day &&
                  eventsByDay[cell.dateStr]
                    ?.slice(0, 3)
                    .map((ev, j) => (
                      <div
                        key={j}
                        className="surface-card truncate px-1 py-0.5 text-xs mb-0.5"
                        style={{
                          backgroundColor: `${CATEGORY_COLORS[ev.category] ?? "var(--text-muted)"}25`,
                          color: CATEGORY_COLORS[ev.category] ?? "var(--text-muted)",
                        }}
                        title={`${ev.title} — ${ev.owner ?? "Campus"}`}
                      >
                        {ev.title}
                      </div>
                    ))}
                {cell.day &&
                  eventsByDay[cell.dateStr] &&
                  eventsByDay[cell.dateStr].length > 3 && (
                    <div className="text-xs text-text-muted">
                      +{eventsByDay[cell.dateStr]!.length - 3} more
                    </div>
                  )}
              </div>
            ))}
          </div>
        ) : (
          /* List View */
          <div className="space-y-2 max-h-80 overflow-y-auto">
            {events.length === 0 ? (
              <p className="text-xs text-text-muted">No events for this month.</p>
            ) : (
              events.map((ev) => (
                <div
                  key={ev.id}
                  className="surface-card flex items-start gap-3 bg-bg-elevated/30 p-3"
                >
                  <div
                    className="mt-0.5 h-2 w-2 rounded-full shrink-0"
                    style={{
                      backgroundColor: CATEGORY_COLORS[ev.category] ?? "var(--text-muted)",
                    }}
                  />
                  <div className="flex-1 min-w-0">
                    <p className="text-xs font-medium text-text-secondary truncate">{ev.title}</p>
                    <p className="text-xs text-text-muted">
                      {new Date(ev.date).toLocaleDateString()}
                      {ev.time ? ` · ${ev.time}` : ""}
                      {ev.location ? ` · ${ev.location}` : ""}
                    </p>
                  </div>
                  <button
                    type="button"
                    onClick={() =>
                      toggleFollow(ev.category, !(ev.reminderOptin ?? false))
                    }
                    className="p-1 text-text-muted hover:text-text-secondary transition-colors motion-reduce:transition-none"
                    aria-label="Toggle reminder"
                  >
                    {ev.reminderOptin ? (
                      <Bell className="h-3.5 w-3.5 text-action-primary" />
                    ) : (
                      <BellOff className="h-3.5 w-3.5" />
                    )}
                  </button>
                </div>
              ))
            )}
          </div>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default UnifiedCampusCalendar;
</file>

<file path="src/components/shared/achievements/ProgressCard.tsx">
/**
 * shared/achievements/ProgressCard.tsx — progress bar for an in-progress
 * achievement + proof cross-link. "You're 3 events away from 'Event
 * Enthusiast' · Earned via: Robotics, Coding Club, Quiz Night".
 *
 * The "LINK" step: every achievement shows which activities earned it.
 */

"use client";

import { Award, Lock, Sparkles } from "lucide-react";
import { cn } from "@/lib/utils";

export interface ProgressCardProps {
  /** The achievement title. */
  title: string;
  /** 0–1 progress. */
  progress: number;
  /** The source activities (proof cross-links). */
  proof?: string[];
  /** Whether it's unlocked. */
  earned?: boolean;
  className?: string;
}

export function ProgressCard({
  title,
  progress,
  proof,
  earned,
  className,
}: ProgressCardProps) {
  const pct = Math.round((earned ? 1 : progress) * 100);

  return (
    <div className={cn("surface-card p-4 space-y-2", className)}>
      {/* Header */}
      <div className="flex items-center gap-2">
        <div
          className={cn(
            "flex h-8 w-8 items-center justify-center rounded-lg",
            earned ? "bg-green-500/10 text-green-400" : "bg-bg-elevated text-text-muted",
          )}
        >
          {earned ? <Award className="h-4 w-4" /> : <Lock className="h-4 w-4" />}
        </div>
        <div className="flex-1">
          <p className="text-sm font-medium text-text">{title}</p>
          <p className="text-xs text-text-muted">
            {earned ? "Unlocked" : `${pct}% complete`}
          </p>
        </div>
      </div>

      {/* Progress bar */}
      {!earned && (
        <div className="h-1.5 overflow-hidden rounded-full bg-bg-elevated">
          <div
            className="h-full rounded-full bg-action-primary transition-all"
            style={{ width: `${pct}%` }}
          />
        </div>
      )}

      {/* Proof: the activities that earned it */}
      {proof && proof.length > 0 && (
        <div className="flex flex-wrap gap-1">
          {proof.slice(0, 4).map((p) => (
            <span
              key={p}
              className="flex items-center gap-1 rounded-full bg-bg-elevated px-2 py-0.5 text-[10px] text-text-muted"
            >
              <Sparkles className="h-2.5 w-2.5" />
              {p}
            </span>
          ))}
          {proof.length > 4 && (
            <span className="rounded-full bg-bg-elevated px-2 py-0.5 text-[10px] text-text-muted">
              +{proof.length - 4} more
            </span>
          )}
        </div>
      )}
    </div>
  );
}

export default ProgressCard;
</file>

<file path="src/components/shared/attendance/AttendanceSummaryCards.tsx">
/**
 * shared/attendance/AttendanceSummaryCards.tsx — per-subject attendance
 * summary with delta + achievement cross-link. The "STATUS" step of the
 * attendance loop: "Physics: 87% · 3 absences · 1 unexcused". Also
 * surfaces the "90% attendance streak" achievement progress when active.
 */

"use client";

import { TrendingUp, TrendingDown, Trophy } from "lucide-react";
import { cn } from "@/lib/utils";

export interface SubjectAttendance {
  subject: string;
  /** 0–1 attendance rate. */
  rate: number;
  absences: number;
  unexcused: number;
  /** Delta vs last period (percentage points, negative = worse). */
  delta: number;
}

export interface AttendanceSummaryCardsProps {
  subjects: SubjectAttendance[];
  /** The attendance achievement threshold (default 0.9 = 90%). */
  achievementThreshold?: number;
  /** Class name. */
  className?: string;
}

export function AttendanceSummaryCards({
  subjects,
  achievementThreshold = 0.9,
  className,
}: AttendanceSummaryCardsProps) {
  // Overall rate = average of subject rates.
  const overall =
    subjects.length > 0
      ? subjects.reduce((sum, s) => sum + s.rate, 0) / subjects.length
      : 0;
  const achieved = overall >= achievementThreshold;

  return (
    <div className={cn("space-y-3", className)}>
      {/* Overall + achievement */}
      <div className="surface-card flex items-center justify-between p-4">
        <div>
          <p className="text-xs text-text-muted">Overall attendance</p>
          <p className="text-2xl font-bold text-text">
            {(overall * 100).toFixed(0)}%
          </p>
        </div>
        <div
          className={cn(
            "flex items-center gap-2 rounded-lg px-3 py-2",
            achieved ? "bg-green-500/10 text-green-400" : "bg-bg-elevated text-text-muted",
          )}
        >
          <Trophy className="h-4 w-4" />
          <div>
            <p className="text-xs font-medium">
              {achieved
                ? "Attendance streak achieved"
                : `${Math.round((achievementThreshold - overall) * 100)}% to go for "Perfect Month"`}
            </p>
            <p className="text-[10px] opacity-70">
              {achieved ? "90%+ this period" : `${(overall * 100).toFixed(0)}% / ${Math.round(achievementThreshold * 100)}%`}
            </p>
          </div>
        </div>
      </div>

      {/* Per-subject cards */}
      <div className="grid grid-cols-2 gap-2 sm:grid-cols-3">
        {subjects.map((s) => {
          const deltaUp = s.delta > 0;
          return (
            <div key={s.subject} className="surface-card p-3">
              <p className="text-xs font-medium text-text truncate">{s.subject}</p>
              <div className="mt-1 flex items-baseline gap-2">
                <span className="text-lg font-bold text-text">
                  {(s.rate * 100).toFixed(0)}%
                </span>
                <span
                  className={cn(
                    "flex items-center gap-0.5 text-[10px]",
                    deltaUp ? "text-green-400" : s.delta < 0 ? "text-red-400" : "text-text-muted",
                  )}
                >
                  {deltaUp ? (
                    <TrendingUp className="h-3 w-3" />
                  ) : s.delta < 0 ? (
                    <TrendingDown className="h-3 w-3" />
                  ) : null}
                  {deltaUp ? "+" : ""}
                  {s.delta.toFixed(0)}%
                </span>
              </div>
              <p className="mt-1 text-[10px] text-text-muted">
                {s.absences} absences · {s.unexcused} unexcused
              </p>
            </div>
          );
        })}
      </div>
    </div>
  );
}

export default AttendanceSummaryCards;
</file>

<file path="src/components/shared/calendar/CalendarEventSheet.tsx">
/**
 * shared/calendar/CalendarEventSheet.tsx — tap a calendar day/event to see
 * the deep-link: a class -> attendance, a pass -> live tracker, an event
 * -> RSVP. This is the "tap to act" of the calendar loop. It takes a
 * CalendarEvent and renders a small sheet with the right CTA + deep-link.
 */

"use client";

import Link from "next/link";
import { X, MapPin, Clock, ArrowRight } from "lucide-react";
import { cn } from "@/lib/utils";
import type { CalendarEvent } from "@/lib/retention";

export interface CalendarEventSheetProps {
  event: CalendarEvent | null;
  onClose: () => void;
  className?: string;
}

/** Map a calendar category to its deep-link + CTA label. */
function eventDeepLink(ev: CalendarEvent): { href: string; cta: string } {
  const cat = (ev.category || "").toLowerCase();
  if (cat.includes("class") || cat.includes("timetable"))
    return { href: "/student/attendance", cta: "View attendance" };
  if (cat.includes("pass") || cat.includes("outpass") || cat.includes("permission"))
    return { href: "/student/passes", cta: "Track pass" };
  if (cat.includes("meal") || cat.includes("mess") || cat.includes("food"))
    return { href: "/student/mess", cta: "View meals" };
  if (cat.includes("curfew"))
    return { href: "/student", cta: "Today's status" };
  if (cat.includes("exam"))
    return { href: "/student", cta: "Exams" };
  if (cat.includes("event") || cat.includes("workshop") || cat.includes("sport"))
    return { href: "/student/my-events", cta: "RSVP / check-in" };
  return { href: "/student", cta: "Open" };
}

export function CalendarEventSheet({ event, onClose, className }: CalendarEventSheetProps) {
  if (!event) return null;
  const link = eventDeepLink(event);

  return (
    <div className={cn("fixed inset-0 z-50 flex items-end bg-black/40 sm:items-center", className)}>
      <div className="w-full rounded-t-xl bg-bg-elevated p-4 sm:max-w-md sm:rounded-xl">
        <div className="flex items-start justify-between gap-2">
          <div>
            <p className="text-xs text-text-muted capitalize">{event.category}</p>
            <h3 className="text-base font-semibold text-text-primary">{event.title}</h3>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="rounded p-1 text-text-muted hover:bg-bg"
            aria-label="Close"
          >
            <X className="h-4 w-4" />
          </button>
        </div>

        <div className="mt-3 space-y-1 text-xs text-text-muted">
          <p className="flex items-center gap-1.5">
            <Clock className="h-3 w-3" />
            {new Date(event.date).toLocaleDateString("en-IN", {
              weekday: "short",
              day: "2-digit",
              month: "short",
            })}
            {event.time ? ` · ${event.time}` : ""}
          </p>
          {event.location && (
            <p className="flex items-center gap-1.5">
              <MapPin className="h-3 w-3" />
              {event.location}
            </p>
          )}
        </div>

        <div className="mt-4">
          <Link
            href={link.href}
            onClick={onClose}
            className="flex items-center justify-center gap-1.5 rounded-lg bg-action-primary px-4 py-2 text-sm font-medium text-white hover:bg-action-primary/90"
          >
            {link.cta}
            <ArrowRight className="h-3.5 w-3.5" />
          </Link>
        </div>
      </div>
    </div>
  );
}

export default CalendarEventSheet;
</file>

