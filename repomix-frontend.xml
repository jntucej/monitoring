    try {
      const res = await fetch("/api/departments", { headers: getAuthHeaders() });
      const body = await res.json();
      setRows((body?.data ?? []) as DeptRow[]);
    } catch (e) {
      console.error("departments", e);
    } finally {
      setLoading(false);
    }
  }, []);

