<file path="src/components/shared/pass/CurfewTimer.tsx">
/**
 * shared/pass/CurfewTimer — live countdown to curfew (hosteller only).
 * Polls every 30s. Shows "in Xh Ym" or "curfew breached".
 */

"use client";

import { useEffect, useState } from "react";
import { Moon, AlertTriangle } from "lucide-react";
import { cn } from "@/lib/utils";
import { usePersona } from "@/hooks/usePersona";

/** Campus default curfew (IST). Override via campus config in a later phase. */
const DEFAULT_CURFEW_HHMM = "22:00";

export interface CurfewTimerProps {
  /** Override the curfew time (HH:MM, campus-local). */
  curfewTime?: string;
  /** If set, show "must return by" against an expected-return time instead. */
  expectedReturnAt?: string;
  className?: string;
}

function toMinutes(hhmm: string): number {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
}

export function CurfewTimer({ curfewTime, expectedReturnAt, className }: CurfewTimerProps) {
  const persona = usePersona();
  const [, setTick] = useState(0);

  // Re-render every 30s to keep the countdown live.
  useEffect(() => {
    const id = setInterval(() => setTick((t) => t + 1), 30_000);
    return () => clearInterval(id);
  }, []);

  // Only hostellers get a curfew timer.
  if (persona !== "hosteller") return null;

  const targetHHMM = expectedReturnAt ? expectedReturnAt.slice(11, 16) : (curfewTime ?? DEFAULT_CURFEW_HHMM);
  const targetMin = toMinutes(targetHHMM);
  const now = new Date();
  const nowMin = now.getHours() * 60 + now.getMinutes();
  const diffMin = targetMin - nowMin;

  const breached = diffMin < 0;
  const label = breached
    ? "curfew breached"
    : diffMin < 60
      ? `in ${diffMin} min`
      : `in ${Math.floor(diffMin / 60)}h ${diffMin % 60}m`;

  return (
    <div
      className={cn(
        "rounded-xl border p-3 flex items-center gap-3",
        breached
          ? "border-rose-500/30 bg-rose-500/10"
          : "border-border bg-bg-elevated",
        className
      )}
    >
      {breached ? (
        <AlertTriangle className="h-5 w-5 text-rose-500 shrink-0" />
      ) : (
        <Moon className="h-5 w-5 text-rose-500/70 shrink-0" />
      )}
      <div className="min-w-0">
        <p className={cn("text-xs font-semibold", breached ? "text-rose-600" : "text-text-primary")}>
          {breached ? "Past curfew" : "Curfew"}
          {expectedReturnAt && !breached ? " / return" : ""}
        </p>
        <p className={cn("text-sm font-bold tabular-nums", breached ? "text-rose-600" : "text-text-primary")}>
          {targetHHMM}
        </p>
      </div>
      <div className="ml-auto text-right">
        <p className={cn("text-xs font-semibold tabular-nums", breached ? "text-rose-500" : "text-text-muted")}>
          {label}
        </p>
        {expectedReturnAt && (
          <p className="text-[10px] text-text-muted">expected return</p>
        )}
      </div>
    </div>
  );
}

export default CurfewTimer;
</file>

<file path="src/components/shared/pass/ExtendPassModal.tsx">
/**
 * shared/pass/ExtendPassModal — extension request for an existing pass.
 *
 * Re-enters the approval chain (the pass is not just extended; it goes
 * back to the next approver). Driven by PassTypeConfig.
 */

"use client";

import { useEffect, useState } from "react";
import { Loader2, Clock, X } from "lucide-react";
import { getAuthHeaders, cn } from "@/lib/utils";
import { Modal } from "@/components/ui/modal";
import { useUIStore } from "@/stores/uiStore";
import type { PassTypeConfig } from "@/lib/pass-types";
import { ApprovalChainPreview } from "@/components/shared/pass/ApprovalChainPreview";

export interface ExtendPassModalProps {
  open: boolean;
  onClose: () => void;
  /** The pass being extended. */
  pass: { id: string; to: string; code: string };
  config: PassTypeConfig;
}

function toLocalInput(d: Date): string {
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

export function ExtendPassModal({ open, onClose, pass, config }: ExtendPassModalProps) {
  const { addToast } = useUIStore();
  const [newTo, setNewTo] = useState("");
  const [submitting, setSubmitting] = useState(false);

  // Prefill with the current pass end time.
  useEffect(() => {
    if (open && pass.to) {
      const d = new Date(pass.to);
      // Default extension: +2 hours
      d.setHours(d.getHours() + 2);
      setNewTo(toLocalInput(d));
    }
  }, [open, pass.to]);

  const submit = async () => {
    if (!newTo) return;
    setSubmitting(true);
    try {
      const res = await fetch(`/api/permissions/${pass.id}/extend`, {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ newTo: new Date(newTo).toISOString() }),
      });
      const body = await res.json().catch(() => null);
      if (res.ok) {
        addToast({ variant: "success", title: "Extension requested", message: "Re-submitted for approval." });
        onClose();
      } else {
        addToast({ variant: "error", title: "Extension failed", message: body?.error?.message ?? "Could not extend." });
      }
    } catch {
      addToast({ variant: "error", title: "Extension failed", message: "Network error." });
    } finally {
      setSubmitting(false);
    }
  };

  const valid = newTo && new Date(newTo).getTime() > new Date(pass.to).getTime();

  return (
    <Modal isOpen={open} onClose={onClose} title="Extend pass" size="sm">
      <div className="space-y-4">
        <div className="flex items-center justify-between text-xs text-text-muted">
          <span>Current end</span>
          <span className="tabular-nums text-text-primary">
            {new Date(pass.to).toLocaleString("en-IN", {
              day: "2-digit",
              month: "short",
              hour: "2-digit",
              minute: "2-digit",
            })}
          </span>
        </div>

        <div>
          <label className="text-xs font-medium text-text-muted flex items-center gap-1 mb-1">
            <Clock className="h-3 w-3" /> New return time
          </label>
          <input
            type="datetime-local"
            value={newTo}
            onChange={(e) => setNewTo(e.target.value)}
            className="surface-card w-full bg-bg-base px-3 py-2 text-xs text-text-primary focus:outline-none"
          />
        </div>

        {/* Approval chain (re-enters) */}
        <ApprovalChainPreview config={config} />

        <div className="flex gap-2">
          <button
            type="button"
            onClick={onClose}
            className="flex-1 rounded-lg border border-border px-3 py-2 text-xs text-text-secondary hover:bg-bg-elevated flex items-center justify-center gap-1"
          >
            <X className="h-3.5 w-3.5" /> Cancel
          </button>
          <button
            type="button"
            onClick={() => void submit()}
            disabled={!valid || submitting}
            className={cn(
              "flex-1 rounded-lg px-3 py-2 text-xs font-semibold flex items-center justify-center gap-1",
              "bg-action-primary text-white hover:opacity-90 disabled:opacity-40"
            )}
          >
            {submitting && <Loader2 className="h-3.5 w-3.5 animate-spin" />}
            Request extension
          </button>
        </div>
      </div>
    </Modal>
  );
}

export default ExtendPassModal;
</file>

<file path="src/components/shared/pass/ParentConsentCard.tsx">
/**
 * shared/pass/ParentConsentCard — pending parent-consent state for a pass.
 *
 * Reused by:
 *   - shared/pass/PassHub (student side: "waiting on parent")
 *   - parent/ParentConsentInbox (parent side: "act on this")
 *
 * Shows consent expiry countdown + approve/decline for parent mode.
 */

"use client";

import { useEffect, useState } from "react";
import { ShieldCheck, Clock, CheckCircle2, XCircle } from "lucide-react";
import { getAuthHeaders, cn } from "@/lib/utils";
import type { PassTypeConfig } from "@/lib/pass-types";
import { useUIStore } from "@/stores/uiStore";

export interface ParentConsentCardProps {
  /** The pass type config (must have requiresParentConsent). */
  config: PassTypeConfig;
  /** The pending consent record. */
  consent: {
    id: string;
    expiresAt: string;
    status: "pending" | "approved" | "declined";
  };
  /** "student" = read-only status; "parent" = actionable. */
  mode: "student" | "parent";
  onAction?: (consentId: string, action: "approved" | "declined") => void;
  className?: string;
}

export function ParentConsentCard({
  config,
  consent,
  mode,
  onAction,
  className,
}: ParentConsentCardProps) {
  const { addToast } = useUIStore();
  const [, setTick] = useState(0);

  // Live expiry countdown
  useEffect(() => {
    if (consent.status !== "pending") return;
    const id = setInterval(() => setTick((t) => t + 1), 30_000);
    return () => clearInterval(id);
  }, [consent.status]);

  const expired = new Date(consent.expiresAt).getTime() < Date.now();
  const decided = consent.status === "approved" || consent.status === "declined";

  return (
    <div
      className={cn(
        "rounded-xl border p-4 space-y-2.5",
        consent.status === "approved" && "border-action-success/30 bg-action-success/5",
        consent.status === "declined" && "border-action-danger/30 bg-action-danger/5",
        consent.status === "pending" && "border-action-warning/30 bg-action-warning/5",
        className
      )}
    >
      <div className="flex items-center gap-2">
        <ShieldCheck
          className={cn(
            "h-5 w-5",
            consent.status === "approved" ? "text-action-success"
              : consent.status === "declined" ? "text-action-danger"
              : "text-action-warning"
          )}
        />
        <div>
          <p className="text-sm font-semibold text-text-primary">Parent consent</p>
          <p className="text-xs text-text-muted">{config.label}</p>
        </div>
        <div className="ml-auto text-right">
          {decided ? (
            <p
              className={cn(
                "text-xs font-semibold uppercase",
                consent.status === "approved" ? "text-action-success" : "text-action-danger"
              )}
            >
              {consent.status}
            </p>
          ) : expired ? (
            <p className="text-xs font-semibold text-action-danger flex items-center gap-1">
              <XCircle className="h-3 w-3" /> Expired
            </p>
          ) : (
            <p className="text-xs text-action-warning flex items-center gap-1">
              <Clock className="h-3 w-3" />
              expires {new Date(consent.expiresAt).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })}
            </p>
          )}
        </div>
      </div>

      {/* Parent actionable buttons */}
      {mode === "parent" && !decided && !expired && (
        <div className="flex gap-2">
          <button
            type="button"
            onClick={() => {
              onAction?.(consent.id, "approved");
              addToast({ variant: "success", title: "Approved", message: "Parent consent granted." });
            }}
            className="inline-flex items-center gap-1.5 flex-1 rounded-lg bg-action-success px-3 py-2 text-xs font-semibold text-white hover:opacity-90"
          >
            <CheckCircle2 className="h-3.5 w-3.5" /> Approve
          </button>
          <button
            type="button"
            onClick={() => {
              onAction?.(consent.id, "declined");
              addToast({ variant: "warning", title: "Declined", message: "Parent consent declined." });
            }}
            className="inline-flex items-center gap-1.5 flex-1 rounded-lg bg-action-danger/10 border border-action-danger/30 px-3 py-2 text-xs font-semibold text-action-danger hover:bg-action-danger/20"
          >
            <XCircle className="h-3.5 w-3.5" /> Decline
          </button>
        </div>
      )}

      {/* Student read-only note */}
      {mode === "student" && !decided && (
        <p className="text-xs text-text-muted">
          {expired
            ? "Consent window has expired. The request needs to be resubmitted."
            : "Waiting for your parent to approve this request."}
        </p>
      )}
    </div>
  );
}

export default ParentConsentCard;
</file>

<file path="src/components/shared/pass/PassHistory.tsx">
/**
 * shared/pass/PassHistory — period-filtered pass history with compare + rate + export.
 *
 * The "compare" pillar: this period vs last period, with a rate-the-process
 * star input and CSV export.
 */

"use client";

import { useCallback, useMemo, useState } from "react";
import { FileDown, Star, Clock, Ticket, Loader2 } from "lucide-react";
import { getAuthHeaders, cn } from "@/lib/utils";
import { useExport } from "@/hooks/useExport";
import { PeriodPicker } from "@/components/shared/PeriodPicker";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import type { Period, PeriodKey } from "@/lib/period";
import { getPeriod } from "@/lib/period";
import { useAuthStore } from "@/stores/authStore";

interface PassRow {
  id: string;
  code: string;
  from: string;
  to: string;
  status: string;
  requestedAt: string;
}

function periodFromStr(key: PeriodKey): string {
  const p = getPeriod(key);
  return p.from.slice(0, 10);
}

export function PassHistory({ className }: { className?: string }) {
  const { exportCSV } = useExport();
  const [period, setPeriod] = useState<Period>(getPeriod("this-month"));
  const [passes, setPasses] = useState<PassRow[]>([]);
  const [loading, setLoading] = useState(false);
  const [rates, setRates] = useState<Record<string, number>>({});

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const res = await fetch("/api/passes", { headers: getAuthHeaders(), cache: "no-store" });
      const body = await res.json().catch(() => null);
      setPasses((body?.data ?? []) as PassRow[]);
    } catch {}
    finally {
      setLoading(false);
    }
  }, []);

  // Load once
  useMemo(() => { load(); /* eslint-disable-line */ }, [load]);

  const fromStr = periodFromStr(period.key);
  const filtered = useMemo(
    () => passes.filter((p) => p.from.slice(0, 10) >= fromStr),
    [passes, fromStr]
  );

  // Compare: previous same-length window
  const compare = useMemo(() => {
    const prevKey: PeriodKey = period.key === "this-week" ? "last-week"
      : period.key === "this-month" ? "last-month"
      : "all-time";
    const prevFrom = periodFromStr(prevKey);
    const prevCount = passes.filter((p) => p.from.slice(0, 10) >= prevFrom).length;
    return { cur: filtered.length, prev: prevCount, delta: filtered.length - prevCount };
  }, [passes, filtered, period.key]);

  const handleExport = () => {
    exportCSV(
      filtered.map((p) => ({
        type: p.code,
        from: p.from,
        to: p.to,
        status: p.status,
      })),
      [
        { key: "type", header: "Pass Type" },
        { key: "from", header: "From" },
        { key: "to", header: "To" },
        { key: "status", header: "Status" },
      ],
      `pass_history_${period.key}.csv`
    );
  };

  return (
    <WidgetBoundary name="pass-history">
      <div className={cn("rounded-xl border border-border bg-bg-elevated p-4 space-y-3", className)}>
        <div className="flex items-center justify-between gap-2">
          <p className="text-xs font-semibold text-text-muted flex items-center gap-1.5">
            <Ticket className="h-3.5 w-3.5" /> Pass history
          </p>
          <div className="flex items-center gap-2">
            <PeriodPicker value={period} onChange={setPeriod} />
            <button
              type="button"
              onClick={handleExport}
              disabled={filtered.length === 0}
              className="inline-flex items-center gap-1 text-xs text-text-muted hover:text-action-primary disabled:opacity-40"
            >
              <FileDown className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        {/* Compare KPI */}
        <div className="flex items-center gap-3 text-xs">
          <span className="text-text-muted">
            {compare.cur} this period · {compare.prev} prev
          </span>
          {compare.prev > 0 && <DeltaBadge value={compare.cur} reference={compare.prev} label="" />}
        </div>

        {loading ? (
          <div className="flex items-center gap-2 text-sm text-text-muted">
            <Loader2 className="h-4 w-4 animate-spin" /> Loading…
          </div>
        ) : filtered.length === 0 ? (
          <p className="text-xs text-text-muted">No passes in this period.</p>
        ) : (
          <div className="space-y-2">
            {filtered.slice(0, 20).map((p) => (
              <div key={p.id} className="rounded-lg border border-border bg-bg-base px-3 py-2">
                <div className="flex items-center justify-between text-xs">
                  <span className="font-medium text-text-primary capitalize">{(p.code ?? "PASS").replace(/_/g, " ")}</span>
                  <span
                    className={cn(
                      "uppercase font-semibold",
                      p.status === "APPROVED" || p.status === "COMPLETED"
                        ? "text-action-success"
                        : p.status === "REJECTED"
                          ? "text-action-danger"
                          : "text-action-warning"
                    )}
                  >
                    {p.status}
                  </span>
                </div>
                <div className="flex items-center justify-between text-[10px] text-text-muted mt-1">
                  <span className="tabular-nums">{p.from.slice(0, 10)} → {p.to.slice(0, 10)}</span>
                  {/* Rate the process (1-5 stars) */}
                  <div className="flex items-center gap-0.5">
                    {[1, 2, 3, 4, 5].map((n) => (
                      <button
                        key={n}
                        type="button"
                        onClick={() => setRates((r) => ({ ...r, [p.id]: n }))}
                        className="p-0.5"
                        aria-label={`Rate ${n}`}
                      >
                        <Star
                          className={cn(
                            "h-3 w-3",
                            (rates[p.id] ?? 0) >= n ? "fill-action-warning text-action-warning" : "text-text-muted"
                          )}
                        />
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default PassHistory;
</file>

<file path="src/components/shared/pass/PassHub.tsx">
/**
 * shared/pass/PassHub — the full student passes page.
 *
 * Orchestrates: active passes (with curfew timer + QR), create form,
 * quota card, and history. This is the single "passes" surface that
 * replaces the scattered ActivePasses + PassCreateForm + history bits.
 */

"use client";

import { useState } from "react";
import {
  Ticket,
  Plus,
  History,
  QrCode,
  ShieldCheck,
} from "lucide-react";
import { cn } from "@/lib/utils";
import { usePassTypesV2 } from "@/hooks/usePassTypes";
import { usePersona } from "@/hooks/usePersona";
import { useIsSakuga } from "@/components/student/useIsSakuga";
import type { PassTypeConfig } from "@/lib/pass-types";
import { PassCreateFormV2 } from "@/components/shared/pass/PassCreateFormV2";
import { QuotaCard } from "@/components/shared/pass/QuotaCard";
import { CurfewTimer } from "@/components/shared/pass/CurfewTimer";
import { ActivePasses } from "@/components/student/ActivePasses";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

export interface PassHubProps {
  /** Restrict the create form to a single pass type. */
  initialCode?: string;
  /** Hide the create form (e.g. parent view). */
  hideCreate?: boolean;
  className?: string;
  /** Fired when the user selects a pass row (ticket id), enabling the
   * page-level "focus a document" pivot / SelfActionLoop. */
  onSelectPass?: (ticketId: string) => void;
}

export function PassHub({ initialCode, hideCreate, className, onSelectPass }: PassHubProps) {
  const persona = usePersona();
  const isSakuga = useIsSakuga();
  const { configs } = usePassTypesV2({ persona });
  const [showHistory, setShowHistory] = useState(false);

  // Find the config that has a quota, to render the QuotaCard.
  const quotaConfig: PassTypeConfig | undefined = configs.find((c) => c.quotaKey && c.quotaLimit != null);

  // Find a config with expectedReturnRequired to drive the curfew timer.
  const curfewConfig: PassTypeConfig | undefined = configs.find((c) => c.curfewApplies);

  return (
    <div className={cn("space-y-5", className)}>
      {/* Header */}
      <div className="flex items-center gap-2">
        <div className="p-2 rounded-xl bg-action-primary/10 text-action-primary">
          <Ticket className="h-5 w-5" />
        </div>
        <div>
          <h1 className="text-lg font-bold text-text-primary">My Passes</h1>
          <p className="text-xs text-text-muted">
            {persona === "hosteller" ? "Hosteller" : "Day scholar"} · persona-scoped
          </p>
        </div>
      </div>

      {/* Curfew timer (hosteller) */}
      {curfewConfig && (
        <WidgetBoundary name="curfew-timer">
          <CurfewTimer />
        </WidgetBoundary>
      )}

      {/* Active passes */}
      <WidgetBoundary name="active-passes">
        <ActivePasses onSelectPass={onSelectPass} />
      </WidgetBoundary>

      {/* Quota card */}
      {quotaConfig && (
        <WidgetBoundary name="quota-card">
          <QuotaCard config={quotaConfig} />
        </WidgetBoundary>
      )}

      {/* Create form */}
      {!hideCreate && (
        <WidgetBoundary name="pass-create">
          <div className="rounded-xl border border-border bg-bg-elevated p-4">
            <div className="flex items-center gap-2 mb-3">
              <Plus className="h-4 w-4 text-action-primary" />
              <h2 className="text-sm font-semibold text-text-primary">New pass</h2>
            </div>
            <PassCreateFormV2 mode="student" initialCode={initialCode} />
          </div>
        </WidgetBoundary>
      )}

      {/* History toggle */}
      <div className="flex items-center justify-between">
        {isSakuga ? (
          <sakuga-toggle
            checked={showHistory}
            onChange={((v: unknown) => setShowHistory(Boolean(v))) as any}
          />
        ) : (
        <button
          type="button"
          onClick={() => setShowHistory((v) => !v)}
          className="inline-flex items-center gap-1.5 text-xs text-text-muted hover:text-action-primary"
        >
          <History className="h-3.5 w-3.5" />
          {showHistory ? "Hide history" : "View history"}
        </button>
        )}
        <span className="text-xs text-text-muted">
          {configs.length} pass types available
        </span>
      </div>
    </div>
  );
}

export default PassHub;
</file>

<file path="src/components/shared/pass/PassLiveTracker.tsx">
/**
 * shared/pass/PassLiveTracker.tsx — the live "where is my pass" tracker.
 * Step 4 (TRACK) of the pass loop: "Approved 14:40 → gate OUT 15:10 →
 * expected IN by 20:00 (2h left)". Reuses RequestTimeline for the approval
 * chain + adds the live gate-scan state + curfew countdown.
 */

"use client";

import { useEffect, useState } from "react";
import { Clock, MapPin, QrCode, CheckCircle2, AlertTriangle } from "lucide-react";
import { cn } from "@/lib/utils";
import { getAuthHeaders } from "@/lib/utils";

export interface PassLiveTrackerProps {
  /** The permission/pass id. */
  passId: string;
  /** The expected return time (curfew). When set, shows a countdown. */
  expectedReturnAt?: string;
  /** Class name. */
  className?: string;
}

export function PassLiveTracker({ passId, expectedReturnAt, className }: PassLiveTrackerProps) {
  const [status, setStatus] = useState<string>("pending");
  const [lastScan, setLastScan] = useState<{ direction: string; at: string } | null>(null);
  const [, setTick] = useState(0);

  // Poll the pass status + last gate scan every 30s (the "live" tracker).
  useEffect(() => {
    let cancelled = false;
    const poll = async () => {
      try {
        const res = await fetch(`/api/passes/${passId}/status`, { headers: getAuthHeaders() });
        if (!res.ok) return;
        const data = await res.json();
        if (cancelled) return;
        setStatus(data.status ?? status);
        setLastScan(
          data.last_scan
            ? { direction: data.last_scan.direction, at: data.last_scan.at }
            : null,
        );
      } catch {
        // keep last known state
      }
    };
    poll();
    const id = setInterval(poll, 30_000);
    // Tick every 30s for the curfew countdown.
    const tick = setInterval(() => setTick((t) => t + 1), 30_000);
    return () => {
      cancelled = true;
      clearInterval(id);
      clearInterval(tick);
    };
  }, [passId]);

  const statusMeta: Record<string, { label: string; accent: string }> = {
    pending: { label: "Pending approval", accent: "text-amber-400" },
    approved: { label: "Approved", accent: "text-green-400" },
    active: { label: "Active — out", accent: "text-blue-400" },
    returned: { label: "Returned on time", accent: "text-green-400" },
    late: { label: "Returned late", accent: "text-red-400" },
    rejected: { label: "Rejected", accent: "text-red-400" },
    cancelled: { label: "Cancelled", accent: "text-text-muted" },
  };
  const meta = statusMeta[status] ?? statusMeta.pending;

  // Curfew countdown.
  const minsLeft = expectedReturnAt
    ? Math.max(0, Math.floor((new Date(expectedReturnAt).getTime() - Date.now()) / 60_000))
    : null;
  const h = minsLeft !== null ? Math.floor(minsLeft / 60) : 0;
  const m = minsLeft !== null ? minsLeft % 60 : 0;

  return (
    <div className={cn("space-y-3", className)}>
      {/* Status banner */}
      <div className="flex items-center justify-between rounded-lg bg-bg-elevated px-3 py-2.5">
        <div className="flex items-center gap-2">
          {status === "returned" ? (
            <CheckCircle2 className={cn("h-4 w-4", meta.accent)} />
          ) : status === "late" || status === "rejected" ? (
            <AlertTriangle className={cn("h-4 w-4", meta.accent)} />
          ) : (
            <Clock className={cn("h-4 w-4", meta.accent)} />
          )}
          <span className={cn("text-sm font-medium", meta.accent)}>{meta.label}</span>
        </div>
        {expectedReturnAt && status === "active" && (
          <span className="text-xs text-text-muted">
            {minsLeft === 0 ? "due now" : `${h}h ${m}m to curfew`}
          </span>
        )}
      </div>

      {/* Last scan */}
      {lastScan && (
        <div className="flex items-center gap-2 text-xs text-text-muted">
          <MapPin className="h-3.5 w-3.5" />
          Last scan: <span className="font-medium text-text capitalize">{lastScan.direction}</span> at{" "}
          {new Date(lastScan.at).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })}
        </div>
      )}

      {/* QR reminder */}
      {(status === "approved" || status === "active") && (
        <div className="flex items-center gap-2 text-xs text-text-muted">
          <QrCode className="h-3.5 w-3.5" />
          Show your QR at the gate to scan out / in
        </div>
      )}
    </div>
  );
}

export default PassLiveTracker;
</file>

<file path="src/components/shared/pass/PassTrackTimeline.tsx">
/**
 * shared/pass/PassTrackTimeline — approval + scan timeline for a single pass.
 *
 * Thin wrapper around the existing RequestTimeline, adding a scan-status
 * footer (gate-in / gate-out) when available.
 */

"use client";

import { CheckCircle2, XCircle, Clock } from "lucide-react";
import { RequestTimeline } from "@/components/shared/RequestTimeline";
import { cn } from "@/lib/utils";

export interface PassScanStatus {
  gateInAt: string | null;
  gateOutAt: string | null;
}

export interface PassTrackTimelineProps {
  ticket: string;
  /** Optional scan status to render a footer. */
  scan?: PassScanStatus;
  className?: string;
}

export function PassTrackTimeline({ ticket, scan, className }: PassTrackTimelineProps) {
  return (
    <div className={cn("space-y-3", className)}>
      <RequestTimeline ticket={ticket} compact />

      {/* Scan-status footer */}
      {scan && (
        <div className="flex gap-2">
          <div className="flex-1 rounded-lg border border-border bg-bg-elevated px-3 py-2 text-xs">
            <div className="flex items-center gap-1.5 text-text-muted">
              <CheckCircle2 className="h-3.5 w-3.5" />
              Gate in
            </div>
            {scan.gateInAt ? (
              <p className="text-text-primary mt-1">
                {new Date(scan.gateInAt).toLocaleString("en-IN", {
                  day: "2-digit",
                  month: "short",
                  hour: "2-digit",
                  minute: "2-digit",
                })}
              </p>
            ) : (
              <p className="text-text-muted mt-1 flex items-center gap-1">
                <Clock className="h-3 w-3" /> Not scanned in
              </p>
            )}
          </div>
          <div className="flex-1 rounded-lg border border-border bg-bg-elevated px-3 py-2 text-xs">
            <div className="flex items-center gap-1.5 text-text-muted">
              <XCircle className="h-3.5 w-3.5" />
              Gate out
            </div>
            {scan.gateOutAt ? (
              <p className="text-text-primary mt-1">
                {new Date(scan.gateOutAt).toLocaleString("en-IN", {
                  day: "2-digit",
                  month: "short",
                  hour: "2-digit",
                  minute: "2-digit",
                })}
              </p>
            ) : (
              <p className="text-text-muted mt-1 flex items-center gap-1">
                <Clock className="h-3 w-3" /> Not scanned out
              </p>
            )}
          </div>
        </div>
      )}
    </div>
  );
}

export default PassTrackTimeline;
