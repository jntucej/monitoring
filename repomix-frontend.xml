<file path="src/app/(admin)/admin/faculty-assignments/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { usePersistentQuery } from "@/hooks/usePersistentQuery";
import { Link2, Plus, Trash2, Search, Loader2 } from "lucide-react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

interface FacultyAssignment {
  id: string;
  facultyId: string;
  classId: string;
  subjectCode: string;
  role: "class_teacher" | "subject_faculty" | "assistant";
  assignedBy: string | null;
  assignedAt: string;
  isActive: boolean;
}
interface FacultyUser {
  id: string;
  name: string;
  email: string | null;
}
interface ClassRow {
  id: string;
  year: number;
  section: string;
  departmentId: string;
  name: string | null;
}
interface SubjectRow {
  code: string;
  label: string;
}

async function fetchAssignments(): Promise<FacultyAssignment[]> {
  const res = await fetch("/api/faculty-assignments", { headers: getAuthHeaders() });
  const body = await res.json();
  return (body?.data ?? body ?? []) as FacultyAssignment[];
}
async function fetchFaculty(): Promise<FacultyUser[]> {
  const res = await fetch("/api/faculty", { headers: getAuthHeaders() });
  const body = await res.json();
  return (body?.data ?? body ?? []) as FacultyUser[];
}
async function fetchClasses(): Promise<ClassRow[]> {
  const res = await fetch("/api/classes", { headers: getAuthHeaders() });
  const body = await res.json();
  return (body?.data ?? body ?? []) as ClassRow[];
}
async function fetchSubjects(): Promise<SubjectRow[]> {
  const res = await fetch("/api/config/subjects", { headers: getAuthHeaders() });
  const body = await res.json();
  return (body?.data ?? body ?? []) as SubjectRow[];
}

/**
 * Admin Faculty Assignments — assign faculty to classes/subjects.
 * Backend: /api/faculty-assignments (hod|faculty|admin|sysadmin). No UI anywhere.
 */
function AdminFacultyAssignmentsInner() {
  const [rows, setRows] = useState<FacultyAssignment[]>([]);
  const [faculty, setFaculty] = useState<FacultyUser[]>([]);
  const [classes, setClasses] = useState<ClassRow[]>([]);
  const [subjects, setSubjects] = useState<SubjectRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [query, setQuery] = usePersistentQuery("gate-admin-faculty-query");
  const [saving, setSaving] = useState(false);
  const [draft, setDraft] = useState({
    facultyId: "", classId: "", subjectCode: "", role: "subject_faculty",
  });

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const [a, f, c, s] = await Promise.all([
        fetchAssignments(), fetchFaculty(), fetchClasses(), fetchSubjects(),
      ]);
      setRows(a);
      setFaculty(f);
      setClasses(c);
      setSubjects(s);
    } catch (e) {
      console.error("faculty-assignments", e);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  const facultyName = (id: string) => faculty.find((f) => f.id === id)?.name ?? id.slice(0, 8);
  const className = (id: string) => {
    const c = classes.find((x) => x.id === id);
    return c ? `Y${c.year} ${c.section}` : id.slice(0, 8);
  };
  const subjectLabel = (code: string) => subjects.find((s) => s.code === code)?.label ?? code;

  const filtered = useMemo(() => {
    if (!query.trim()) return rows;
    const q = query.toLowerCase();
    return rows.filter((r) =>
      `${facultyName(r.facultyId)} ${className(r.classId)} ${subjectLabel(r.subjectCode)} ${r.role}`.toLowerCase().includes(q)
    );
  }, [rows, query, faculty, classes, subjects]);

  const assign = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!draft.facultyId || !draft.classId || !draft.subjectCode) return;
    setSaving(true);
    try {
      const res = await fetch("/api/faculty-assignments", {
        method: "POST",
        headers: { ...getAuthHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({
          facultyId: draft.facultyId,
          classId: draft.classId,
          subjectCode: draft.subjectCode,
          role: draft.role,
        }),
      });
      const json = await res.json();
      if (res.ok && json.success) load();
    } finally {
      setSaving(false);
    }
  };

  const unassign = async (id: string) => {
    const res = await fetch(`/api/faculty-assignments/${id}`, {
      method: "DELETE",
      headers: getAuthHeaders(),
    });
    if (res.ok) load();
  };

  if (loading) {
    return (
      <div className="space-y-4 p-4 md:p-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Assign faculty to classes and subjects"
        why="Assignment changes immediately affect attendance entry, marks entry, and correction request approvals."
        contextLabel="Assign faculty to classes and subjects"
        statusSummary="Review current assign faculty to classes and subjects state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
        <Skeleton className="h-10 w-48" />
        <Skeleton className="h-64 rounded-2xl" />
      </div>
    );
  }

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-4 md:py-6">
      <PageHeader
        title="Faculty Assignments"
        subtitle="Assign faculty to classes and subjects"
        onRefresh={load}
      />
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Bind faculty members to classes and subjects so attendance and class-teacher approvals route accurately."
        contextLabel="Faculty-Class Bindings"
        statusTone={
          classes.filter((c) => !rows.some((r) => r.classId === c.id)).length > 0
            ? "warn"
            : "ok"
        }
        statusPill={`${rows.length} bindings`}
        statusSummary={(() => {
          const unassignedClasses = classes.filter((c) => !rows.some((r) => r.classId === c.id)).length;
          const unassignedFaculty = faculty.filter((f) => !rows.some((r) => r.facultyId === f.id)).length;
          return unassignedClasses > 0 || unassignedFaculty > 0
            ? `${unassignedClasses} class${unassignedClasses === 1 ? "" : "es"} and ${unassignedFaculty} faculty member${unassignedFaculty === 1 ? "" : "s"} have no active assignment.`
            : `All ${classes.length} classes and ${faculty.length} faculty members have active bindings.`;
        })()}
        primaryAction={{ label: "Manage Subjects", href: "/admin/subjects" }}
        secondaryAction={{ label: "Admin Overview", href: "/admin" }}
      />

      <WidgetBoundary title="New assignment">
        <form onSubmit={assign} className="surface-card p-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3 items-end">
          <label>
            <span className="text-xs font-semibold text-text-secondary block mb-1">Faculty</span>
            <select
              value={draft.facultyId}
              onChange={(e) => setDraft((d) => ({ ...d, facultyId: e.target.value }))}
              className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm"
              required
            >
              <option value="">Select</option>
              {faculty.map((f) => <option key={f.id} value={f.id}>{f.name}</option>)}
            </select>
          </label>
          <label>
            <span className="text-xs font-semibold text-text-secondary block mb-1">Class</span>
            <select
              value={draft.classId}
              onChange={(e) => setDraft((d) => ({ ...d, classId: e.target.value }))}
              className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm"
              required
            >
              <option value="">Select</option>
              {classes.map((c) => <option key={c.id} value={c.id}>Y{c.year} {c.section}</option>)}
            </select>
          </label>
          <label>
            <span className="text-xs font-semibold text-text-secondary block mb-1">Subject</span>
            <select
              value={draft.subjectCode}
              onChange={(e) => setDraft((d) => ({ ...d, subjectCode: e.target.value }))}
              className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm"
              required
            >
              <option value="">Select</option>
              {subjects.map((s) => <option key={s.code} value={s.code}>{s.label}</option>)}
            </select>
          </label>
          <label>
            <span className="text-xs font-semibold text-text-secondary block mb-1">Role</span>
            <select
              value={draft.role}
              onChange={(e) => setDraft((d) => ({ ...d, role: e.target.value as FacultyAssignment["role"] }))}
              className="surface-card w-full min-h-11 px-3 py-2 bg-bg-elevated text-sm"
            >
              <option value="subject_faculty">Subject faculty</option>
              <option value="assistant">Assistant</option>
            </select>
          </label>
          <button type="submit" disabled={saving}
            className="surface-card inline-flex items-center justify-center gap-1.5 px-3 py-2 min-h-11 bg-action-primary text-white text-xs font-semibold disabled:opacity-50">
            {saving ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Plus className="w-3.5 h-3.5" />} Assign
          </button>
        </form>
      </WidgetBoundary>

      <WidgetBoundary title="Assignment list">
        <div className="glass-card">
          <div className="surface-card p-4 flex flex-wrap items-center gap-2">
            <Link2 className="w-4 h-4 text-action-primary" />
            <span className="text-sm font-semibold">{filtered.length} assignments</span>
            <div className="ml-auto relative min-w40">
              <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-muted" />
              <input
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="Filter…"
                className="surface-card pl-8 pr-3 py-1.5 min-h-11 bg-bg-elevated text-xs w-full sm:w-40"
              />
            </div>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-xs text-text-muted border-b border-border">
                  <th className="p-3 text-left">Faculty</th>
                  <th className="p-3 text-left">Class</th>
                  <th className="p-3 text-left">Subject</th>
                  <th className="p-3 text-left">Role</th>
                  <th className="p-3 text-left">Status</th>
                  <th className="p-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-border">
                {filtered.length === 0 && (
                  <tr><td colSpan={6} className="p-6 text-center text-text-muted">No assignments.</td></tr>
                )}
                {filtered.map((r) => (
                  <tr key={r.id} className="hover:bg-bg-elevated/40">
                    <td className="p-3 text-text-primary">{facultyName(r.facultyId)}</td>
                    <td className="p-3">{className(r.classId)}</td>
                    <td className="p-3 text-text-muted">{subjectLabel(r.subjectCode)}</td>
                    <td className="p-3">
                      <span className="surface-card px-2 py-0.5 text-xs bg-bg-elevated text-text-muted capitalize">
                        {r.role.replace("_", " ")}
                      </span>
                    </td>
                    <td className="p-3">
                      <span className={`px-2 py-0.5 rounded-full text-xs ${r.isActive ? "bg-emerald-500/10 text-action-success" : "bg-rose-500/10 text-action-danger"}`}>
                        {r.isActive ? "Active" : "Off"}
                      </span>
                    </td>
                    <td className="p-3 text-right">
                      <button onClick={() => unassign(r.id)} aria-label="Unassign"
                        className="p-2 min-h-11 min-w-11 inline-flex items-center justify-center text-text-muted hover:text-action-danger transition-colors">
                        <Trash2 className="w-4 h-4" />
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </WidgetBoundary>
    </div>
  );
}

export default function AdminFacultyAssignmentsPage() {
  return (
    
      <AdminFacultyAssignmentsInner />
    
    

  );
}
</file>

<file path="src/app/(admin)/admin/gate-device-configuration/page.tsx">
"use client";

import { useMemo } from "react";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";

import { PageLoading } from "@/components/admin/shared/LoadingStates";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import {
  Cpu,
  DoorOpen,
  Radio,
  MapPin,
  Clock,
  Lock,
  AlertCircle,
  Wifi,
  WifiOff,
} from "lucide-react";
import Link from "next/link";
import { Suspense } from "react";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";
/* ── response shape (mirrors /api/admin/gate-device-configuration) ────────── */

interface GateSchedule {
  day_of_week: number;
  open_time: string;
  close_time: string;
  is_active: boolean;
}

interface GateRow {
  id: string;
  gate_code: string;
  name: string;
  location: string;
  type: string;
  is_active: boolean;
  latitude: number | null;
  longitude: number | null;
  allowed_radius_meters: number | null;
  schedules: GateSchedule[];
}

interface DeviceVerification {
  device_type: string;
  enabled: boolean;
  scope: string;
  scope_id: string | null;
}

interface GateDeviceConfigData {
  gates: GateRow[];
  device_verification: DeviceVerification[];
  note?: string;
}

const DEVICE_LABELS: Record<string, string> = {
  thumb: "Thumbprint",
  face: "Face",
  barcode: "Barcode",
  qr: "QR Code",
};

const DAY_LABELS = ["", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

function AdminGateDeviceConfigurationInner() {
  const res = useApiResource<{ success: boolean; data: GateDeviceConfigData }>("/api/admin/gate-device-configuration", { ttlMs: 30_000 });

  usePolling(
    () => {
      clearCache("/api/admin/gate-device-configuration");
      return res.refresh();
    },
    { intervalMs: 60_000 }
  );

  const gates = res.data?.data?.gates ?? [];
  const deviceVerification = res.data?.data?.device_verification ?? [];
  const loading = res.loading && !res.data;

  const activeGates = useMemo(() => gates.filter((g) => g.is_active), [gates]);
  const totalScheduleEntries = useMemo(
    () => gates.reduce((sum, g) => sum + g.schedules.length, 0),
    [gates]
  );

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <ContextSituationBar
        roleLabel="Campus Admin"
        purpose="Gate roster, schedules, and per-device settings"
        why="Changes to device pairing and firmware here take effect on the next scanner sync cycle."
        contextLabel="Gate roster, schedules, and per-device settings"
        statusSummary="Review current gate roster, schedules, and per-device settings state and take action below."
        primaryAction={{ label: "Admin Overview", href: "/admin" }}
        secondaryAction={{ label: "Campus Reports", href: "/admin/reports" }}
      />
      <PageHeader
        title="Gate & Device Configuration"
        subtitle="Gate roster, schedules, and per-device settings"
      />
      {/* KPI cards */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <WidgetBoundary title="Gate Roster">
          <div className="surface-card bg-bg-elevated p-4">
            <div className="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-text-muted">
              <DoorOpen className="w-3.5 h-3.5 text-action-success" /> Gate Roster
            </div>
            <div className="mt-1.5 text-xl font-black text-white tabular-nums">
              {loading ? <span className="inline-block w-10 h-5 rounded bg-bg-elevated animate-pulse" /> : activeGates.length}
            </div>
            <p className="mt-0.5 text-xs text-text-muted">Active gates configured</p>
          </div>
        </WidgetBoundary>

        <WidgetBoundary title="Schedules">
          <div className="surface-card bg-bg-elevated p-4">
            <div className="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-text-muted">
              <Clock className="w-3.5 h-3.5 text-action-primary" /> Schedule Entries
            </div>
            <div className="mt-1.5 text-xl font-black text-white tabular-nums">
              {loading ? <span className="inline-block w-10 h-5 rounded bg-bg-elevated animate-pulse" /> : totalScheduleEntries}
            </div>
            <p className="mt-0.5 text-xs text-text-muted">Gate opening windows defined</p>
          </div>
        </WidgetBoundary>

        <WidgetBoundary title="Devices">
          <div className="surface-card bg-bg-elevated p-4">
            <div className="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-text-muted">
              <Cpu className="w-3.5 h-3.5 text-action-warning" /> Device Modes
            </div>
            <div className="mt-1.5 text-xl font-black text-white tabular-nums">
              {loading
                ? <span className="inline-block w-10 h-5 rounded bg-bg-elevated animate-pulse" />
                : deviceVerification.filter((dv) => dv.enabled).length}
            </div>
            <p className="mt-0.5 text-xs text-text-muted">Verification modes enabled</p>
          </div>
        </WidgetBoundary>
      </div>

      {/* Gate configuration cards */}
      <WidgetBoundary title="Gate Configuration">
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {loading ? (
            Array.from({ length: 3 }).map((_, i) => (
              <div key={i} className="surface-card bg-bg-elevated p-4 space-y-2 animate-pulse">
                <div className="h-4 w-32 rounded bg-bg-elevated" />
                <div className="h-3 w-40 rounded bg-bg-elevated" />
                <div className="h-3 w-24 rounded bg-bg-elevated" />
              </div>
            ))
          ) : gates.length === 0 ? (
            <div className="surface-card col-span-full bg-bg-elevated p-8 text-center">
              <DoorOpen className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No gates configured yet.</p>
              <Link
                href="/admin/gates"
                className="mt-3 inline-block text-xs font-semibold text-action-success hover:text-action-success"
              >
                View gate telemetry →
              </Link>
            </div>
          ) : (
            gates.map((gate) => (
              <div
                key={gate.id}
                className={`rounded-xl border p-4 space-y-3 ${
                  gate.is_active
                    ? "bg-bg-elevated border-border"
                    : "bg-bg-surface/40 border-border/60 opacity-70"
                }`}
              >
                <div className="flex items-start justify-between gap-2">
                  <div className="min-w-0">
                    <p className="text-sm font-bold text-white flex items-center gap-1.5">
                      <MapPin className="w-3.5 h-3.5 text-action-success shrink-0" />
                      <span className="truncate">{gate.name}</span>
                    </p>
                    <p className="text-xs text-text-muted">{gate.gate_code} · {gate.location}</p>
                  </div>
                  <span
                    className={`rounded px-2 py-0.5 text-xs font-bold uppercase shrink-0 ${
                      gate.is_active ? "bg-emerald-500/15 text-action-success" : "bg-bg-elevated text-text-muted"
                    }`}
                  >
                    {gate.is_active ? "Active" : "Disabled"}
                  </span>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                  <div className="surface-card bg-bg-surface/60 p-2.5">
                    <p className="text-text-muted mb-0.5">Geofence</p>
                    <p className="text-text-secondary tabular-nums">
                      {gate.latitude != null && gate.longitude != null
                        ? `${gate.latitude.toFixed(4)}, ${gate.longitude.toFixed(4)}`
                        : "Not set"}
                    </p>
                  </div>
                  <div className="surface-card bg-bg-surface/60 p-2.5">
                    <p className="text-text-muted mb-0.5">Radius</p>
                    <p className="text-text-secondary tabular-nums">
                      {gate.allowed_radius_meters != null ? `${gate.allowed_radius_meters} m` : "Default"}
                    </p>
                  </div>
                </div>

                <div>
                  <p className="text-xs font-bold uppercase tracking-wider text-text-muted mb-1.5 flex items-center gap-1">
                    <Clock className="size-3.5" /> Schedules
                  </p>
                  {gate.schedules.length === 0 ? (
                    <p className="text-xs text-text-muted">No schedule entries</p>
                  ) : (
                    <ul className="space-y-1">
                      {gate.schedules.slice(0, 4).map((s) => (
                        <li key={`${s.day_of_week}-${s.open_time}`} className="flex items-center gap-2 text-xs">
                          <span className="w-8 text-text-muted font-medium">{DAY_LABELS[s.day_of_week] || `D${s.day_of_week}`}</span>
                          <span className="text-text-secondary tabular-nums">
                            {s.open_time?.slice(0, 5)} – {s.close_time?.slice(0, 5)}
                          </span>
                          {!s.is_active && (
                            <span className="text-xs text-text-muted uppercase">off</span>
                          )}
                        </li>
                      ))}
                      {gate.schedules.length > 4 && (
                        <li className="text-xs text-text-muted">+{gate.schedules.length - 4} more</li>
                      )}
                    </ul>
                  )}
                </div>
              </div>
            ))
          )}
        </div>
      </WidgetBoundary>

      {/* Device verification modes */}
      <WidgetBoundary title="Device Verification Modes">
        <div className="rounded-2xl border border-border bg-bg-elevated overflow-hidden">
          {loading ? (
            <div className="p-4 space-y-2">
              <div className="h-4 rounded bg-bg-elevated animate-pulse" />
              <div className="h-4 rounded bg-bg-elevated animate-pulse" />
            </div>
          ) : deviceVerification.length === 0 ? (
            <div className="p-8 text-center">
              <Radio className="w-6 h-6 text-text-muted mx-auto mb-2" />
              <p className="text-sm text-text-muted">No device verification modes configured.</p>
              <p className="mt-1 text-xs text-text-muted">Modes are provisioned by the platform team.</p>
            </div>
          ) : (
            <div className="divide-y divide-slate-800/70">
              {deviceVerification.map((dv) => (
                <div key={dv.device_type} className="flex items-center justify-between gap-4 px-4 py-3">
                  <div className="flex items-center gap-3 min-w-0">
                    {dv.enabled ? (
                      <Wifi className="w-4 h-4 text-action-success shrink-0" />
                    ) : (
                      <WifiOff className="w-4 h-4 text-text-muted shrink-0" />
                    )}
                    <div className="min-w-0">
                      <p className="text-xs font-semibold text-white">
                        {DEVICE_LABELS[dv.device_type] || dv.device_type}
                      </p>
                      <p className="text-xs text-text-muted">
                        Scope: {dv.scope === "global" ? "Campus-wide" : `${dv.scope}${dv.scope_id ? " (scoped)" : ""}`}
                      </p>
                    </div>
                  </div>
                  <span
                    className={`rounded px-2 py-0.5 text-xs font-bold uppercase shrink-0 ${
                      dv.enabled ? "bg-emerald-500/15 text-action-success" : "bg-bg-elevated text-text-muted"
                    }`}
                  >
                    {dv.enabled ? "Enabled" : "Disabled"}
                  </span>
                </div>
              ))}
            </div>
          )}
        </div>
      </WidgetBoundary>

      {/* Read-only notice */}
      <div className="surface-card bg-amber-500/[0.06] p-4 flex items-start gap-3">
        <Lock className="w-4 h-4 text-action-warning shrink-0 mt-0.5" />
        <div>
          <p className="text-sm font-semibold text-action-warning flex items-center gap-1.5">
            Read-only view <AlertCircle className="w-3.5 h-3.5 opacity-70" />
          </p>
          <p className="mt-1 text-xs text-text-muted">
            Gate geofences, schedules and device verification modes are locked for admins — editing
            requires sysadmin access. Live hardware telemetry and operator assignments stay under the{" "}
            <Link href="/admin/gates" className="text-action-success hover:underline">Gates</Link> section.
          </p>
        </div>
      </div>

    </div>
  );
}

export default function AdminGateDeviceConfigurationPage() {
  return (
    
      <Suspense fallback={<PageLoading />}>
        <AdminGateDeviceConfigurationInner />
      </Suspense>
    
    

  );
}
