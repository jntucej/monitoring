<file path="src/components/shared/AuthGuard.tsx">
"use client";
import { useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import { useAuthStore, useHasHydrated } from "@/stores/authStore";
import type { Role } from "@/lib/types";

import { getDefaultRouteForRole } from "@/lib/route-helpers";

interface AuthGuardProps {
  children: React.ReactNode;
  allowedRoles?: Role[];
}

export function AuthGuard({ children, allowedRoles }: AuthGuardProps) {
  const router = useRouter();
  const hasHydrated = useHasHydrated();
  // Subscribe via individual selectors, not the whole store object. A full
  // `useAuthStore()` call re-renders this component on every store field
  // change (including transient loading flags), which cascades into the
  // child shell and triggers the React issue-310 "too many re-renders" loop on
  // operator consoles where AuthGuard wraps RoleDesktopShell.
  const user = useAuthStore((s) => s.user);
  const authenticated = useAuthStore((s) => s.authenticated);
  const checkSession = useAuthStore((s) => s.checkSession);
  const [isChecking, setIsChecking] = useState(true);
  const [mounted, setMounted] = useState(false);
  const [timedOut] = useState(false);
  const redirectCountRef = useRef(0);
  const handledRef = useRef(false);

  // Track actual mount to keep SSR + first client paint identical (both render
  // the loading spinner). React error 321 (hydration mismatch) fires when SSR
  // renders one branch and the first client render renders a different one —
  // this only happens when persisted state (localStorage) is available on the
  // client but not on the server.
  useEffect(() => { setMounted(true); }, []);

  const userId = user?.id;
  const userRole = user?.role;
  const gateId = user?.gateId;

  // Fix 6: set data-user-role on body for CSS/a11y
  useEffect(() => {
    if (userRole && typeof document !== "undefined") {
      document.body.setAttribute("data-user-role", userRole);
    }
  }, [userRole]);

  useEffect(() => {
    if (hasHydrated) return;
    const t = setTimeout(() => {
      try {
        useAuthStore.persist?.rehydrate();
      } catch {
        useAuthStore.getState().setHasHydrated(true);
      }
    }, 3000);
    return () => clearTimeout(t);
  }, [hasHydrated]);

  useEffect(() => {
    // Wait until store has hydrated from localStorage/sessionStorage
    if (!hasHydrated) return;

    // If not authenticated or no user set, redirect to login — guard against loops
    if (!authenticated || !userId) {
      if (handledRef.current) return;
      handledRef.current = true;

      let targetRole: Role | null = null;

      if (typeof window !== "undefined") {
        const path = window.location.pathname;
        if (path.startsWith("/sysadmin")) targetRole = "sysadmin";
        else if (path.startsWith("/admin")) targetRole = "admin";
        else if (path.startsWith("/gate") || path.startsWith("/operator")) targetRole = "operator";
        else if (path.startsWith("/student")) targetRole = "student";
        else if (path.startsWith("/guardian")) targetRole = "guardian";
        else if (path.startsWith("/worker")) targetRole = "worker";
        else if (path.startsWith("/supervisor")) targetRole = "supervisor";
        else if (path.startsWith("/principal")) targetRole = "principal";
        else if (path.startsWith("/vice-principal")) targetRole = "vice_principal";
        else if (path.startsWith("/mess")) targetRole = "mess_incharge";
        else if (path.startsWith("/hostel-manager")) targetRole = "hostel_manager";
        else if (path.startsWith("/deputy-warden")) targetRole = "deputy_warden";
        else if (path.startsWith("/caretaker")) targetRole = "caretaker";
        else if (path.startsWith("/exam-branch")) targetRole = "exam_branch";
        else if (path.startsWith("/exam/superintendent")) targetRole = "exam_superintendent";
        else if (path.startsWith("/oie")) targetRole = "oie";
        else if (path.startsWith("/hod")) targetRole = "hod";
        else if (path.startsWith("/emo")) targetRole = "emo";
        else if (path.startsWith("/staff")) targetRole = "staff";
        else if (path.startsWith("/faculty")) targetRole = "faculty";
        else if (path.startsWith("/person")) targetRole = "student";
      }

      if (!targetRole && allowedRoles && allowedRoles.length > 0) {
        targetRole = allowedRoles[0];
      }

      const loginUrl = targetRole ? `/login?role=${targetRole}` : "/login";
      router.replace(loginUrl);
      return;
    }

    // Check role authorization if specified
    if (allowedRoles && allowedRoles.length > 0 && userRole && !allowedRoles.includes(userRole)) {
      if (redirectCountRef.current >= 3) return; // 3-strike guard
      redirectCountRef.current += 1;
      const defaultRoute = getDefaultRouteForRole(userRole, gateId);
      router.replace(defaultRoute);
      return;
    }

    setIsChecking(false);
  }, [hasHydrated, authenticated, userId, userRole, gateId, allowedRoles, router]);

  // Revalidate session asynchronously
  useEffect(() => {
    if (!hasHydrated || !authenticated || !userId) return;
    checkSession();
  }, [hasHydrated, authenticated, userId, checkSession]);

  if (timedOut && !hasHydrated) {
    router.replace("/login");
    return (
      <div className="min-h-dvh w-full flex flex-col items-center justify-center bg-bg-base text-text-primary" role="status" aria-live="polite" aria-busy="true">
        <div className="size-6 border-4 border-action-success border-t-transparent rounded-full animate-spin motion-reduce:animate-none mb-4" aria-hidden />
        <p className="text-xs font-semibold text-text-muted">Checking your session…</p>
      </div>
    );
  }

  // Before mount (SSR + first client paint): always show the spinner.
  // This guarantees identical markup server-side and on first hydration,
  // preventing React error 321.
  if (!mounted || !hasHydrated || isChecking || !authenticated || !user) {
    return (
      <div className="min-h-dvh w-full flex flex-col items-center justify-center bg-bg-base text-text-primary" role="status" aria-live="polite" aria-busy="true">
        <div className="size-6 border-4 border-action-success border-t-transparent rounded-full animate-spin motion-reduce:animate-none mb-4" aria-hidden />
        <p className="text-xs font-semibold text-text-muted">Loading your dashboard…</p>
        <span className="sr-only">Please wait while we load your account details.</span>
      </div>
    );
  }

  return <>{children}</>;
}
</file>

<file path="src/components/shared/Board.tsx">
"use client";

/**
 * Board — vertical feed of records for the role console.
 *
 * Fetches the board source endpoint (e.g. /api/operator/transactions),
 * extracts the record array via the itemKey, and renders rows newest-first.
 * Each row is keyboard-focusable and clickable; keyboard up/down moves the
 * selection, Enter opens the ContextPanel via the onSelect callback.
 *
 * No horizontal scroll, no KPI cards, no charts — just the feed.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { ArrowDownLeft, ArrowUpRight, Loader2, Flag } from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { EmptyState } from "@/components/shared/EmptyState";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";

export interface BoardRow {
  id: string;
  roll: string | null;
  name: string | null;
  person_type: string | null;
  direction: string;
  reason: string | null;
  gate_id: string | null;
  gate_name: string | null;
  timestamp: string;
  scan_type: string | null;
  is_correction: boolean | null;
  created_at: string | null;
}

interface BoardResponse {
  success?: boolean;
  data: {
    [itemKey: string]: BoardRow[] | { total: number; entries: number; exits: number; manual: number; flagged: number };
    counts: {
      total: number;
      entries: number;
      exits: number;
      manual: number;
      flagged: number;
    };
  };
}

export interface BoardProps {
  source: string;
  itemKey: string;
  /** Called when the user selects a row (keyboard Enter or click). */
  onSelect: (row: BoardRow) => void;
}

function fmtTime(iso: string | null | undefined) {
  if (!iso) return "";
  try {
    return new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
  } catch {
    return "";
  }
}

export function Board({ source, itemKey, onSelect }: BoardProps) {
  const { data, loading, error } = useApiResource<BoardResponse>(source, { ttlMs: 15_000 });

  const rows = useMemo(() => {
    const raw = data?.data?.[itemKey];
    const list = Array.isArray(raw) ? raw : [];
    return [...list].sort(
      (a, b) =>
        new Date(b.timestamp ?? b.created_at ?? 0).getTime() -
        new Date(a.timestamp ?? a.created_at ?? 0).getTime(),
    );
  }, [data, itemKey]);

  const [activeIndex, setActiveIndex] = useState(0);
  const listRef = useRef<HTMLOListElement>(null);

  // Keep activeIndex in bounds when the list shrinks.
  useEffect(() => {
    if (activeIndex >= rows.length && rows.length > 0) setActiveIndex(rows.length - 1);
    if (rows.length === 0) setActiveIndex(0);
  }, [rows.length, activeIndex]);

  // Scroll the active row into view.
  useEffect(() => {
    const el = listRef.current?.children[activeIndex] as HTMLElement | undefined;
    el?.scrollIntoView({ block: "nearest" });
  }, [activeIndex]);

  const handleKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActiveIndex((i) => Math.min(i + 1, rows.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActiveIndex((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (rows[activeIndex]) onSelect(rows[activeIndex]);
      }
    },
    [rows, activeIndex, onSelect],
  );

  return (
    <WidgetBoundary title="Feed">
      {loading && rows.length === 0 ? (
        <div className="flex items-center justify-center gap-2 py-8 text-sm text-text-muted">
          <Loader2 className="w-4 h-4 animate-spin" /> Loading today&rsquo;s scans&hellip;
        </div>
      ) : error ? (
        <div className="surface-card py-6 text-xs text-action-warning bg-amber-400/10 p-3">
          {error}
        </div>
      ) : rows.length === 0 ? (
        <EmptyState title="No scans recorded yet" description="Scans will appear here as they are processed at the gate." />
      ) : (
        <ol
          ref={listRef}
          className="space-y-1 max-h-[calc(100dvh-280px)] overflow-y-auto custom-scrollbar p-1"
          onKeyDown={handleKeyDown}
          tabIndex={0}
          aria-label="Today's scan feed"
          role="listbox"
        >
          {rows.map((row, idx) => {
            const isActive = idx === activeIndex;
            const isIn = row.direction === "IN";
            const isFlagged = row.is_correction === true || row.scan_type === "manual";
            return (
              <li key={row.id} role="option" aria-selected={isActive}>
                <button
                  type="button"
                  onClick={() => {
                    setActiveIndex(idx);
                    onSelect(row);
                  }}
                  onFocus={() => setActiveIndex(idx)}
                  className={`w-full flex items-center gap-3 py-2.5 px-3 rounded-xl text-left transition-colors min-h13 ${
                    isActive
                      ? "bg-action-primary/10 border border-action-primary/30"
                      : "hover:bg-bg-elevated border border-transparent"
                  }`}
                >
                  {/* direction arrow */}
                  <span
                    className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                      isFlagged
                        ? "bg-amber-500/15 text-action-warning"
                        : isIn
                          ? "bg-emerald-500/15 text-action-success"
                          : "bg-rose-500/15 text-action-danger"
                    }`}
                  >
                    {isFlagged ? (
                      <Flag className="w-4 h-4" />
                    ) : isIn ? (
                      <ArrowDownLeft className="w-4 h-4" />
                    ) : (
                      <ArrowUpRight className="w-4 h-4" />
                    )}
                  </span>

                  {/* name + roll */}
                  <div className="flex-1 min-w-0">
                    <p className="text-sm font-bold text-text-primary truncate">
                      {row.name || row.roll || "—"}
                    </p>
                    <p className="text-xs font-mono text-text-muted truncate">
                      {row.roll || "—"}
                      {row.person_type ? ` · ${row.person_type}` : ""}
                    </p>
                  </div>

                  {/* gate + reason */}
                  <div className="flex items-center gap-2 shrink-0">
                    <span className="text-xs text-text-secondary max-w20 truncate">
                      {row.gate_name || row.gate_id || "Gate"}
                    </span>
                    {row.reason ? (
                      <span className="surface-card text-xs px-1.5 py-0.5 bg-bg-elevated text-text-secondary max-w-[70px] truncate">
                        {row.reason}
                      </span>
                    ) : null}
                  </div>

                  {/* timestamp */}
                  <time className="text-xs font-mono text-text-muted tabular-nums shrink-0 w18 text-right">
                    {fmtTime(row.timestamp ?? row.created_at)}
                  </time>
                </button>
              </li>
            );
          })}
        </ol>
      )}
    </WidgetBoundary>
  );
}
</file>

<file path="src/components/shared/ChangePasswordCard.tsx">
"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { Lock, KeyRound, Eye, EyeOff, Loader2, CheckCircle2, AlertCircle } from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { useApi } from "@/hooks/useApi";

export function ChangePasswordCard() {
const api = useApi();
  const mustChangePassword = useAuthStore((s) => s.mustChangePassword);
  const setMustChangePassword = useAuthStore((s) => s.setMustChangePassword);
  const router = useRouter();
  const logout = useAuthStore((s) => s.logout);

  const [current, setCurrent] = useState("");
  const [next, setNext] = useState("");
  const [confirm, setConfirm] = useState("");
  const [showCurrent, setShowCurrent] = useState(false);
  const [showNext, setShowNext] = useState(false);
  const [showConfirm, setShowConfirm] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState(false);

  const validate = (): string | null => {
    if (!current || !next || !confirm) return "All fields are required.";
    if (next.length < 8) return "New password must be at least 8 characters.";
    if (next.length > 128) return "New password must be at most 128 characters.";
    if (next !== confirm) return "New passwords do not match.";
    if (next === current) return "New password must be different from current password.";
    return null;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);

    const localError = validate();
    if (localError) {
      setError(localError);
      return;
    }

    setSubmitting(true);
    try {
      const res = await fetch("/api/auth/change-password", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          ...api.getHeaders(),
        },
        body: JSON.stringify({
          currentPassword: current,
          newPassword: next,
        }),
      });

      // Session invalidation may land as 401 — treat success only for 2xx.
      const payload = await res.json().catch(() => ({}));

      if (!res.ok) {
        if (res.status === 401 && !payload?.error) {
          setError("Session expired. Please sign in again.");
        } else {
          setError(payload?.error || "Could not change password.");
        }
        return;
      }

      setSuccess(true);
      setCurrent("");
      setNext("");
      setConfirm("");
      // The rotation just cleared the server-side password_must_change flag;
      // clear the client-side copy so the redirect target is the normal
      // dashboard (or login page) instead of the forced-change flow again.
      setMustChangePassword(false);

      // Server bumped session_version → every token is now stale.
      // Give the user a moment to read the confirmation, then sign out.
      setTimeout(async () => {
        await logout();
        router.replace("/login?changed=1");
      }, 1800);
    } catch {
      setError("Network error. Please try again.");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="surface-card bg-bg-surface p-6">
      {mustChangePassword && !success && (
        <div className="surface-card mb-4 flex items-start gap-2 bg-amber-500/10 p-3 text-xs text-action-warning">
          <AlertCircle className="mt-0.5 h-4 w-4 shrink-0" />
          <div>
            <p className="font-semibold">A temporary password was set for your account.</p>
            <p className="mt-0.5 text-amber-700/80">
              You must choose a new password now — the one an administrator or the
              enrollment process set for you is valid until you replace it.
            </p>
          </div>
        </div>
      )}
      <div className="flex items-center gap-3 mb-5">
        <div className="surface-card p-2 bg-action-primary/10">
          <KeyRound className="w-5 h-5 text-action-primary" />
        </div>
        <div>
          <h3 className="text-lg font-semibold text-text-primary">Change password</h3>
          <p className="text-sm text-text-muted">
            You will be signed out of all devices after this change.
          </p>
        </div>
      </div>

      {success ? (
        <div className="surface-card flex items-start gap-3 bg-emerald-500/10 p-4">
          <CheckCircle2 className="w-5 h-5 text-action-success mt-0.5" />
          <div>
            <p className="text-sm font-medium text-action-success dark:text-action-success">
              Password changed successfully.
            </p>
            <p className="text-xs text-emerald-700/80 dark:text-emerald-700/80 mt-1">
              Signing you out…
            </p>
          </div>
        </div>
      ) : (
        <form onSubmit={handleSubmit} className="space-y-4">
          <PasswordField
            label="Current password"
            value={current}
            onChange={setCurrent}
            show={showCurrent}
            onToggle={() => setShowCurrent((v) => !v)}
            autoComplete="current-password"
          />
          <PasswordField
            label="New password"
            value={next}
            onChange={setNext}
            show={showNext}
            onToggle={() => setShowNext((v) => !v)}
            autoComplete="new-password"
            hint="At least 8 characters."
          />
          <PasswordField
            label="Confirm new password"
            value={confirm}
            onChange={setConfirm}
            show={showConfirm}
            onToggle={() => setShowConfirm((v) => !v)}
            autoComplete="new-password"
          />

          {error && (
            <div className="surface-card flex items-start gap-2 bg-rose-500/10 p-3">
              <AlertCircle className="w-4 h-4 text-action-danger mt-0.5 flex-shrink-0" />
              <p className="text-sm text-action-danger dark:text-action-danger">{error}</p>
            </div>
          )}

          <button
            type="submit"
            disabled={submitting}
            className="surface-card w-full inline-flex items-center justify-center gap-2 bg-action-primary px-4 py-2.5 text-sm font-medium text-white hover:opacity-90 disabled:opacity-60 transition"
          >
            {submitting ? (
              <>
                <Loader2 className="w-4 h-4 animate-spin" />
                Updating…
              </>
            ) : (
              <>
                <Lock className="w-4 h-4" />
                Update password
              </>
            )}
          </button>
        </form>
      )}
    </div>
  );
}

interface PasswordFieldProps {
  label: string;
  value: string;
  onChange: (v: string) => void;
  show: boolean;
  onToggle: () => void;
  autoComplete: string;
  hint?: string;
}

function PasswordField({
  label, value, onChange, show, onToggle, autoComplete, hint,
}: PasswordFieldProps) {
  return (
    <label className="block">
      <span className="block text-sm font-medium text-text-secondary mb-1.5">
        {label}
      </span>
      <div className="relative">
        <input
          type={show ? "text" : "password"}
          value={value}
          onChange={(e) => onChange(e.target.value)}
          autoComplete={autoComplete}
          className="surface-card w-full bg-bg-base px-3 py-2.5 pr-10 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-action-primary/40"
        />
        <button
          type="button"
          onClick={onToggle}
          aria-label={show ? "Hide password" : "Show password"}
          className="absolute inset-y-0 right-2 flex items-center px-2 text-text-muted hover:text-text-primary"
        >
          {show ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
        </button>
      </div>
      {hint && <p className="text-xs text-text-muted mt-1">{hint}</p>}
    </label>
  );
}
