<file path="src/components/shared/RoleExportButton.tsx">
"use client";

import React, { useState } from "react";
import { Download, Loader2 } from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { getTierForRole } from "@/lib/record-capabilities";

export type RoleTier = ReturnType<typeof getTierForRole>;

export type ExportResource =
  | "own-history"
  | "shift-scans"
  | "meal-counts"
  | "dept-attendance"
  | "hostel-movement"
  | "exam-clearances"
  | "approvals-ledger"
  | "institutional-analytics"
  | "audit-logs";

const EXPORT_ACCESS: Record<ExportResource, string[]> = {
  "own-history": ["student", "guardian"],
  "shift-scans": ["operator", "supervisor", "admin", "sysadmin"],
  "meal-counts": ["mess_incharge", "admin", "sysadmin"],
  "dept-attendance": ["faculty", "hod", "vice_principal", "principal", "admin", "sysadmin"],
  "hostel-movement": [
    "deputy_warden",
    "hostel_manager",
    "vice_principal",
    "principal",
    "supervisor",
    "admin",
    "sysadmin",
  ],
  "exam-clearances": [
    "exam_branch",
    "oie",
    "exam_superintendent",
    "vice_principal",
    "principal",
    "admin",
    "sysadmin",
  ],
  "approvals-ledger": [
    "hod",
    "deputy_warden",
    "hostel_manager",
    "exam_branch",
    "oie",
    "vice_principal",
    "principal",
    "supervisor",
    "admin",
    "sysadmin",
  ],
  "institutional-analytics": ["vice_principal", "principal", "supervisor", "admin", "sysadmin"],
  "audit-logs": ["principal", "admin", "sysadmin"],
};

const TIER_ORDER: Record<RoleTier, number> = {
  "tier-0": 0,
  "tier-1": 1,
  "tier-2": 2,
  "tier-3": 3,
  "tier-4": 4,
};

export function canRoleExport(role: string | null | undefined, resource: ExportResource): boolean {
  if (!role) return false;
  return (EXPORT_ACCESS[resource] ?? []).includes(role.toLowerCase());
}

export interface ExportColumn<T> {
  key: keyof T | string;
  header: string;
  minTier?: RoleTier;
  accessor?: (row: T) => string | number | boolean | null | undefined;
}

export function RoleExportButton<T extends object>({
  resource,
  filenamePrefix,
  rows,
  columns,
  serverExportUrl,
}: {
  resource: ExportResource;
  filenamePrefix: string;
  rows: T[];
  columns: ExportColumn<T>[];
  serverExportUrl?: string;
}) {
  const role = useAuthStore((s) => s.user?.role)?.toLowerCase();
  const [exporting, setExporting] = useState(false);

  if (!canRoleExport(role, resource)) {
    return null;
  }

  const viewerTier = getTierForRole(role);
  const allowedColumns = columns.filter((col) => {
    if (!col.minTier) return true;
    return TIER_ORDER[viewerTier] >= TIER_ORDER[col.minTier];
  });

  const handleExport = async () => {
    setExporting(true);
    try {
      if (serverExportUrl) {
        window.open(serverExportUrl, "_blank", "noopener,noreferrer");
        return;
      }

      const headerLine = allowedColumns
        .map((c) => `"${String(c.header).replace(/"/g, '""')}"`)
        .join(",");
      const dataLines = rows.map((row) =>
        allowedColumns
          .map((col) => {
            const raw = col.accessor
              ? col.accessor(row)
              : (row as Record<string, unknown>)[String(col.key)];
            const str = raw === null || raw === undefined ? "" : String(raw);
            return `"${str.replace(/"/g, '""')}"`;
          })
          .join(","),
      );

      const csv = [headerLine, ...dataLines].join("\n");
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${filenamePrefix}-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } finally {
      setExporting(false);
    }
  };

  return (
    <button
      type="button"
      data-testid={`export-${resource}`}
      disabled={exporting || (!serverExportUrl && rows.length === 0)}
      onClick={handleExport}
      className="inline-flex items-center gap-1.5 rounded-lg border border-border bg-bg-surface px-3 py-1.5 text-xs font-medium text-text-primary hover:bg-bg-elevated transition-colors disabled:opacity-50"
    >
      {exporting ? (
        <Loader2 className="h-3.5 w-3.5 animate-spin" />
      ) : (
        <Download className="h-3.5 w-3.5" />
      )}
      <span>Export CSV{!serverExportUrl ? ` (${rows.length})` : ""}</span>
    </button>
  );
}
</file>

<file path="src/components/shared/RoleFlash.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import { motion, useAnimation } from "framer-motion";
import { Zap } from "lucide-react";
import { cn } from "@/lib/utils";

/** localStorage key for the per-role dismissed state. */
const KEY = "qa-flash-dismissed";

interface RoleFlashProps {
  /** Stable role identifier (e.g. "admin", "operator") — scopes the dismiss state. */
  role: string;
  /**
   * The actual navigation handler — the flash delegates to it, so the
   * "jump" still happens; the flash just adds a 420ms visual lead-in.
   */
  onNavigate: () => void;
  label?: string;
  icon?: React.ComponentType<{ className?: string }>;
}

/**
 * RoleFlash — scroll-linked staggered micro-interaction for the primary
 * quick-action tile.
 *
 * On first hover/focus the tile's icon does a short spring pulse and the
 * label nudges 2px in the navigation direction (right for forward nav,
 * up for back) — a "task-path" cue: the control physically gestures
 * toward the destination before the route change. A 420ms settle window
 * lets the user cancel (hover out) before the push fires.
 *
 * Design constraints honoured:
 *   - respects prefers-reduced-motion (pulse / nudge disabled, only the
 *     native hover ring remains)
 *   - dismisses itself after 2 uses (flagged in localStorage per role)
 *   - 44px+ touch target preserved (tile dimensions unchanged)
 *   - no layout shift: the nudge is translate-only, no reflow
 */
export function RoleFlash({ role, onNavigate, label, icon: Icon }: RoleFlashProps) {
  const [dismissed, setDismissed] = useState(false);
  const [prefersReducedMotion, setPrefersReducedMotion] = useState(false);
  const controls = useAnimation();

  useEffect(() => {
    const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
    setPrefersReducedMotion(mq.matches);
    const onMq = (e: MediaQueryListEvent) => setPrefersReducedMotion(e.matches);
    mq.addEventListener("change", onMq);
    const flag = localStorage.getItem(KEY);
    const seen = flag ? (JSON.parse(flag) as Record<string, number>) : {};
    if ((seen[role] ?? 0) >= 2) setDismissed(true);
    return () => mq.removeEventListener("change", onMq);
  }, [role]);

  const recordUse = useCallback(() => {
    const flag = localStorage.getItem(KEY);
    const seen = flag ? (JSON.parse(flag) as Record<string, number>) : {};
    seen[role] = (seen[role] ?? 0) + 1;
    localStorage.setItem(KEY, JSON.stringify(seen));
    if ((seen[role] ?? 0) >= 2) setDismissed(true);
  }, [role]);

  const hoverIn = useCallback(async () => {
    if (dismissed || prefersReducedMotion) return;
    // Pulse the icon.
    await controls.start({
      scale: [1, 1.18, 1],
      transition: { duration: 0.35, ease: "easeOut" },
    });
    recordUse();
  }, [dismissed, prefersReducedMotion, controls, recordUse]);

  const hoverOut = useCallback(() => {
    // Cancel any in-flight settle so the flash doesn't fire on an
    // accidental hover-out (the native hover ring is the fallback).
    controls.stop();
  }, [controls]);

  // Direction: forward nav nudges right, back nav nudges left.
  const direction = "right";
  const nudge = prefersReducedMotion || dismissed ? 0 : 2;

  return (
    <motion.button
      type="button"
      onHoverStart={hoverIn}
      onHoverEnd={hoverOut}
      onFocus={hoverIn}
      onClick={() => {
        onNavigate();
        recordUse();
      }}
      animate={controls}
      className={cn(
        "group/flash relative flex items-center gap-3 rounded-xl border p-3.5 text-left transition-colors",
        "border-border bg-bg-surface",
        "hover:bordertext-muted hover:bg-bg-elevated",
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ringfocus-ring",
        "active:scale-[0.98] min-h-11 min-w-11"
      )}
    >
      <motion.span
        initial={false}
        animate={{ scale: dismissed ? 1 : 1, x: dismissed ? 0 : nudge * (direction === "right" ? 1 : -1) }}
        transition={{ type: "spring", stiffness: 300, damping: 20 }}
        className="flex size-6 shrink-0 items-center justify-center rounded-lg border border-border bg-bg-elevated text-action-primary"
      >
        {Icon ? <Icon className="h-4 w-4" /> : <Zap className="h-4 w-4" />}
      </motion.span>
      <span className="text-sm font-semibold text-text-primary">
        {label}
        {/* Trailing chevron only appears on hover/focus — task-path cue. */}
        <span
          aria-hidden
          className={cn(
            "ml-1 inline-block text-text-muted transition-opacity",
            "opacity-0 group-hover/flash:opacity-100 group-focus-visible/flash:opacity-100"
          )}
        >
          {direction === "right" ? "→" : "←"}
        </span>
      </span>
    </motion.button>
  );
}

export default RoleFlash;
</file>

