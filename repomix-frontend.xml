"use client";

/**
 * StudentContextPanel — 1.12 extracted context panel for the faculty subject
 * drilldown. Renders the selected student's attendance summary in a side panel.
 *
 * Backed by the shared /api/attendance_records feed filtered to the student's
 * roll (light, subject-scoped read). The parent owns selection state, so
 * opening the panel does NOT re-mount the RoleConsole shell.
 */

import { useMemo, useState } from "react";
import { X, Clock, User, CalendarDays, Loader2, TrendingUp, AlertTriangle } from "lucide-react";
import { PageLoading } from "@/components/shared/LoadingStates";
import { EmptyState } from "@/components/shared/EmptyState";
import { useApiResource } from "@/hooks/useApiResource";
import { DeltaBadge } from "@/components/shared/DeltaBadge";
import { MiniSparkline } from "@/components/shared/MiniSparkline";

interface AttendanceRow {
  id?: string;
  roll?: string | null;
  student_id?: string | null;
  date?: string | null;
  status?: string | null;
  in_time?: string | null;
  out_time?: string | null;
  created_at?: string;
  [key: string]: unknown;
}

interface AttendanceResponse {
  success: boolean;
  data: AttendanceRow[];
}

interface StudentOverview {
  success: boolean;
  data: {
    students: Array<{
      id: string;
      roll?: string | null;
      name?: string | null;
      year?: number | null;
      section?: string | null;
    }>;
  };
}

export function StudentContextPanel({
  studentId,
  classId,
  onClose,
}: {
  studentId: string;
  classId?: string;
  onClose: () => void;
}) {
  const [reloadKey, setReloadKey] = useState(0);

  // Fetch the roster to resolve student id -> roll + name (light re-read of
  // the class overview already cached by useApiResource's TTL).
  const { data: overview } = useApiResource<StudentOverview>(
    classId ? `/api/faculty/my-class/${classId}` : "/api/attendance_records",
    { ttlMs: 30_000 },
  );

  const student = useMemo(
    () => (overview?.data?.students ?? []).find((s) => s.id === studentId) ?? null,
    [overview, studentId],
  );

  const roll = student?.roll ?? "";

  const { data, loading } = useApiResource<AttendanceResponse>(
    roll
      ? `/api/attendance_records?roll=${encodeURIComponent(roll)}&k=${reloadKey}`
      : "/api/attendance_records",
    { ttlMs: 60_000, enabled: Boolean(roll) },
  );

  const rows = useMemo(() => {
    const all = data?.data ?? [];
    const filtered = roll ? all.filter((r) => (r.roll ?? r.student_id ?? "") === roll || r.student_id === studentId) : all;
    return filtered.slice(0, 25);
  }, [data, roll, studentId]);

  const present = rows.filter((r) => ["PRESENT", "IN", "present"].includes(r.status ?? "")).length;
  const absent = rows.length - present;

  // Weekly attendance trend (last 7 calendar weeks, present-day counts)
  const weeklyTrend = useMemo(() => {
    const all = data?.data ?? [];
    const buckets: number[] = Array.from({ length: 7 }, () => 0);
    const now = new Date();
    for (const r of all) {
      if (!r.date) continue;
      const d = new Date(r.date);
      const weeksAgo = Math.floor((now.getTime() - d.getTime()) / (7 * 86_400_000));
      if (weeksAgo >= 0 && weeksAgo < 7 && ["PRESENT", "IN", "present"].includes(r.status ?? "")) {
        buckets[6 - weeksAgo] += 1;
      }
    }
    return buckets;
  }, [data]);

  // Time spent in class: sum of (out_time - in_time) where both present
  const hoursInClass = useMemo(() => {
    const all = data?.data ?? [];
    let totalMs = 0;
    for (const r of all) {
      if (r.in_time && r.out_time) {
        const ms = new Date(r.out_time).getTime() - new Date(r.in_time).getTime();
        if (ms > 0) totalMs += ms;
      }
    }
    return Math.round((totalMs / 3_600_000) * 10) / 10;
  }, [data]);

  // Disputes raised by this student (from attendance_disputes)
  const [disputes, setDisputes] = useState<Array<{ date: string; reason: string; status: string }> | null>(null);
  const loadDisputes = () => {
    if (!studentId) return;
    fetch(`/api/faculty/attendance/student-disputes?studentId=${studentId}`, {
      headers: { Authorization: `Bearer ${localStorage.getItem("accessToken") ?? ""}` },
    })
      .then((r) => (r.ok ? r.json() : null))
      .then((b) => {
        const d = (b?.data?.disputes ?? []) as Array<{ date: string; reason: string; status: string }>;
        setDisputes(d);
      })
      .catch(() => setDisputes([]));
  };

  // Lazy-load disputes once the student is resolved
  useMemo(() => {
    if (student && !disputes) loadDisputes();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [student]);

  const weeklyAvg = weeklyTrend.length > 0 ? weeklyTrend.reduce((s, n) => s + n, 0) / 7 : 0;

  if (loading && !student) {
    return (
      <aside className="surface-card min-w-0 w-full bg-bg-surface p-4">
        <div className="flex items-center gap-2 py-6 text-sm text-text-muted">
          <Loader2 className="w-4 h-4 animate-spin" /> Loading student…
        </div>
      </aside>
    );
  }

  return (
    <aside className="surface-card min-w-0 w-full bg-bg-surface p-4 md:sticky md:top-4 md:max-h-[calc(100dvh-6rem)] md:overflow-y-auto">
      {/* Header */}
      <div className="flex items-start justify-between gap-2 mb-3">
        <div className="min-w-0">
          <p className="text-sm font-semibold text-text-primary truncate">
            {student?.name || "Selected student"}
          </p>
          <p className="text-xs font-mono text-text-muted">
            Roll {student?.roll || "—"}
          </p>
        </div>
        <button
          type="button"
          onClick={onClose}
          aria-label="Close context panel"
          className="surface-card p-1 text-text-muted hover:text-text-primary hover:bg-bg-elevated"
        >
          <X className="w-4 h-4" />
        </button>
      </div>

      {/* Summary */}
      <div className="grid grid-cols-2 gap-2 mb-4">
        <div className="surface-card bg-emerald-400/10 p-3">
          <div className="flex items-center gap-1.5 text-xs text-action-success">
            <Clock className="w-3.5 h-3.5" /> Present
          </div>
          <p className="mt-1 text-xl font-bold text-action-success tabular-nums">{present}</p>
        </div>
        <div className="surface-card bg-rose-400/10 p-3">
          <div className="flex items-center gap-1.5 text-xs text-action-danger">
            <CalendarDays className="w-3.5 h-3.5" /> Absent
          </div>
          <p className="mt-1 text-xl font-bold text-action-danger tabular-nums">{absent}</p>
        </div>
      </div>

      {/* Weekly trend + time-in-class + disputes */}
      <div className="space-y-3 mb-4">
        <div className="rounded-xl border border-border bg-bg-elevated p-3">
          <div className="flex items-center justify-between mb-2">
            <p className="text-xs font-semibold uppercase tracking-wide text-text-muted">7-week trend</p>
            <span className="text-xs text-text-muted tabular-nums">~{Math.round(weeklyAvg * 10) / 10}/wk</span>
          </div>
          <MiniSparkline data={weeklyTrend} width={220} height={36} />
        </div>

        {hoursInClass > 0 && (
          <div className="rounded-xl border border-border bg-bg-elevated p-3 flex items-center justify-between">
            <p className="text-xs font-semibold uppercase tracking-wide text-text-muted">Time in class</p>
            <p className="text-lg font-bold text-text-primary tabular-nums">{hoursInClass}h</p>
          </div>
        )}

        {disputes && disputes.length > 0 && (
          <div className="rounded-xl border border-amber-500/20 bg-amber-500/5 p-3 space-y-2">
            <p className="text-xs font-semibold uppercase tracking-wide text-amber-600 flex items-center gap-1.5">
              <AlertTriangle className="w-3.5 h-3.5" /> Open disputes
            </p>
            <div className="space-y-1">
              {disputes.map((d, i) => (
                <div key={i} className="text-xs text-text-secondary">
                  <span className="font-medium text-text-primary">{d.date}</span> — {d.reason}
                  <span className="ml-1 text-text-muted">({d.status})</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Attendance history */}
      <div className="space-y-2">
        <p className="text-xs font-semibold uppercase tracking-wide text-text-muted">
          Recent attendance
        </p>
        {loading ? (
          <div className="py-6">
            <PageLoading />
          </div>
        ) : rows.length === 0 ? (
          <EmptyState
            title="No attendance records"
            description={`No recent attendance rows found for roll ${roll || "—"}.`}
          />
        ) : (
          <ul className="space-y-1.5">
            {rows.map((r, i) => (
              <li
                key={r.id ?? `${r.date}-${i}`}
                className="surface-card flex items-center justify-between gap-2 bg-bg-elevated px-3 py-2 text-xs"
              >
                <div className="flex items-center gap-2 min-w-0">
                  <User className="w-3.5 h-3.5 text-text-muted shrink-0" />
                  <span className="text-text-secondary truncate">
                    {r.date ? new Date(r.date).toLocaleDateString("en-IN", { day: "2-digit", month: "short" }) : "—"}
                  </span>
                </div>
                <span
                  className={`rounded-full px-2 py-0.5 text-xs font-semibold ${
                    r.status === "PRESENT" || r.status === "IN"
                      ? "bg-emerald-400/15 text-action-success"
                      : "bg-rose-400/15 text-action-danger"
                  }`}
                >
                  {r.status || "—"}
                </span>
              </li>
            ))}
          </ul>
        )}
        {rows.length > 0 && (
          <button
            type="button"
            onClick={() => setReloadKey((k) => k + 1)}
            className="text-xs text-text-muted hover:text-text-primary underline decoration-dotted"
          >
            Refresh
          </button>
        )}
      </div>
    </aside>
  );
}
</file>

<file path="src/components/governance/ReactiveAssignmentTree.tsx">
"use client";

import { useMemo, useState } from "react";
import Link from "next/link";
import {
  Building2,
  ChevronDown,
  ChevronRight,
  GraduationCap,
  Home,
  Search,
  UserPlus,
  Users,
  AlertCircle,
} from "lucide-react";
import { useApiResource } from "@/hooks/useApiResource";
import { useAuthStore } from "@/stores/authStore";
import { useUIStore } from "@/stores/uiStore";
import type { Person } from "@/lib/types";

interface DepartmentItem {
  code: string;
  name: string;
  hodName: string | null;
  faculty: number;
  students: number;
  ratio: number;
  attendancePct: number;
}

interface HostelBlock {
  id?: string;
  name?: string;
  block_name?: string;
  capacity?: number;
  total_rooms?: number;
  occupied?: number;
}

interface TreeNode {
  id: string;
  level: 1 | 2 | 3;
  kind: "institution" | "department" | "hostel";
  label: string;
  subtitle: string;
  metrics: Array<{ label: string; value: string | number }>;
  deptCode?: string;
  blockName?: string;
  children?: TreeNode[];
}

export function ReactiveAssignmentTree() {
  const user = useAuthStore((s) => s.user);
  const addToast = useUIStore((s) => s.addToast);
  const role = (user?.role ?? "").toLowerCase();
  const isHod = role === "hod";
  const hodDept = (user as { department?: string | null } | null)?.department ?? null;

  const { data: acadData } = useApiResource<{ data?: { departments?: DepartmentItem[] } }>(
    "/api/vp/academics",
    { ttlMs: 60_000 },
  );
  const { data: hostelData } = useApiResource<{ data?: HostelBlock[] }>(
    "/api/hostel/blocks",
    { ttlMs: 60_000 },
  );
  const { data: personsData, refresh: refreshPersons } = useApiResource<{ data?: Person[] }>(
    "/api/persons?limit=200",
    { ttlMs: 30_000 },
  );

  const departments = useMemo(() => {
    const all = acadData?.data?.departments ?? [];
    if (isHod && hodDept) {
      return all.filter(
        (d) =>
          d.code.toLowerCase() === hodDept.toLowerCase() ||
          d.name.toLowerCase() === hodDept.toLowerCase(),
      );
    }
    return all;
  }, [acadData, isHod, hodDept]);

  const blocks = useMemo(() => {
    if (isHod) return [];
    return Array.isArray(hostelData?.data) ? hostelData.data : [];
  }, [hostelData, isHod]);

  const people = useMemo(
    () => (Array.isArray(personsData?.data) ? personsData.data : []),
    [personsData],
  );

  const students = useMemo(
    () => people.filter((p) => (p.role ?? p.personType ?? "").toLowerCase() === "student"),
    [people],
  );

  const treeNodes: TreeNode[] = useMemo(() => {
    const deptNodes: TreeNode[] = departments.map((d) => ({
      id: `dept:${d.code}`,
      level: 2,
      kind: "department",
      label: `${d.name} (${d.code})`,
      subtitle: `HOD: ${d.hodName ?? "Unassigned"}`,
      deptCode: d.code,
      metrics: [
        { label: "Students", value: d.students },
        { label: "Faculty", value: d.faculty },
        { label: "Attendance", value: `${d.attendancePct}%` },
      ],
    }));

    const hostelNodes: TreeNode[] = blocks.map((b, idx) => {
      const name = b.name ?? b.block_name ?? `Block ${idx + 1}`;
      return {
        id: `hostel:${b.id ?? name}`,
        level: 2,
        kind: "hostel",
        label: name,
        subtitle: "Hostel Block",
        blockName: name,
        metrics: [
          { label: "Occupied", value: b.occupied ?? 0 },
          { label: "Capacity", value: b.capacity ?? b.total_rooms ?? 0 },
        ],
      };
    });

    return [
      {
        id: "institution",
        level: 1,
        kind: "institution",
        label: isHod && hodDept ? `${hodDept} Department Tree` : "JNTUH CEJ Institutional Tree",
        subtitle: isHod ? "Department Cohort & Faculty Scope" : "Principal · VP · Admin · SysAdmin",
        metrics: [
          { label: "Departments", value: departments.length },
          { label: "Students Loaded", value: students.length },
          { label: "Hostel Blocks", value: blocks.length },
        ],
        children: [...deptNodes, ...hostelNodes],
      },
    ];
  }, [departments, blocks, students.length, isHod, hodDept]);

  const [selectedId, setSelectedId] = useState<string>("institution");
  const [expanded, setExpanded] = useState<Record<string, boolean>>({ institution: true });
  const [query, setQuery] = useState("");
  const [assignOpen, setAssignOpen] = useState(false);
  const [assignTargetId, setAssignTargetId] = useState("");
  const [assignRole, setAssignRole] = useState<"cr" | "faculty" | "hostel">("cr");

  const allFlatNodes = useMemo(() => {
    const out: TreeNode[] = [];
    for (const root of treeNodes) {
      out.push(root);
      for (const child of root.children ?? []) out.push(child);
    }
    return out;
  }, [treeNodes]);

  const selectedNode =
    allFlatNodes.find((n) => n.id === selectedId) ?? treeNodes[0];

  const filteredChildren = useMemo(() => {
    const q = query.trim().toLowerCase();
    const children = treeNodes[0]?.children ?? [];
    if (!q) return children;
    return children.filter(
      (c) =>
        c.label.toLowerCase().includes(q) ||
        c.subtitle.toLowerCase().includes(q),
    );
  }, [treeNodes, query]);

  const nodeStudents = useMemo(() => {
    if (!selectedNode) return [];
    if (selectedNode.kind === "department" && selectedNode.deptCode) {
      const code = selectedNode.deptCode.toLowerCase();
      return students.filter(
        (s) =>
          (s.department ?? "").toLowerCase() === code ||
          (s.uniqueId ?? "").toLowerCase().includes(code),
      );
    }
    if (selectedNode.kind === "hostel") {
      return students.filter((s) => Boolean((s as { isHosteller?: boolean }).isHosteller));
    }
    return students;
  }, [selectedNode, students]);

  const unlinkedCount = nodeStudents.filter(
    (s) => !(s as { guardianId?: string | null }).guardianId,
  ).length;

  const handleQuickAssign = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!assignTargetId.trim()) return;
    addToast({
      variant: "success",
      message: `Assignment queued (${assignRole.toUpperCase()}) for ${assignTargetId.trim()}`,
    });
    setAssignTargetId("");
    setAssignOpen(false);
    await refreshPersons();
  };

  return (
    <div
      data-testid="reactive-assignment-tree"
      className="w-full min-w-0 overflow-x-hidden space-y-4"
    >
      {/* Sticky Breadcrumb Pill Bar */}
      <nav
        aria-label="Hierarchy breadcrumb"
        className="surface-card sticky top-0 z-10 flex flex-wrap items-center gap-1.5 bg-bg-surface/95 px-3 py-2 backdrop-blur"
      >
        <button
          type="button"
          onClick={() => setSelectedId("institution")}
          className="action-btn min-h-9 px-2.5 py-1 text-xs font-semibold text-action-primary hover:bg-bg-elevated"
        >
          Institution
        </button>
        {selectedNode && selectedNode.id !== "institution" && (
          <>
            <span className="text-xs text-text-muted">&rsaquo;</span>
            <span className="action-btn bg-action-primary/10 px-2.5 py-1 text-xs font-semibold text-action-primary">
              {selectedNode.label}
            </span>
          </>
        )}
      </nav>

      {/* Split Master-Detail Layout (Desktop 40/60, Mobile Accordion) */}
      <div className="grid grid-cols-1 md:grid-cols-12 gap-4">
        {/* Left Pane: Searchable Collapsible Tree */}
        <aside className="md:col-span-5 surface-card bg-bg-surface p-3.5 space-y-3">
          <div className="relative">
            <Search className="size-3.5 text-text-muted absolute left-3 top-1/2 -translate-y-1/2" />
            <input
              type="search"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Filter departments or hostel blocks..."
              className="surface-card w-full min-h-9 bg-bg-base pl-8 pr-3 text-xs text-text-primary"
            />
          </div>

          <div className="space-y-1.5">
            <button
              type="button"
              onClick={() => {
                setSelectedId("institution");
                setExpanded((prev) => ({ ...prev, institution: !prev.institution }));
              }}
              className={`action-btn w-full min-h-10 border px-3 py-2 text-left flex items-center justify-between gap-2 ${
                selectedId === "institution"
                  ? "border-action-primary bg-action-primary/10"
                  : "border-border bg-bg-base hover:bg-bg-elevated"
              }`}
            >
              <div className="flex items-center gap-2 min-w-0">
                {expanded.institution ? (
                  <ChevronDown className="size-4 shrink-0 text-text-muted" />
                ) : (
                  <ChevronRight className="size-4 shrink-0 text-text-muted" />
                )}
                <Building2 className="size-4 shrink-0 text-action-primary" />
                <span className="text-xs font-semibold truncate">{treeNodes[0]?.label}</span>
              </div>
              <span className="font-mono text-[11px] text-text-muted shrink-0">
                {students.length}
              </span>
            </button>

            {expanded.institution && (
              <div className="border-l border-border pl-3.5 space-y-1.5">
                {filteredChildren.map((node) => (
                  <button
                    key={node.id}
                    type="button"
                    onClick={() => setSelectedId(node.id)}
                    className={`action-btn w-full min-h-10 border px-3 py-2 text-left flex items-center justify-between gap-2 ${
                      selectedId === node.id
                        ? "border-action-primary bg-action-primary/10"
                        : "border-border bg-bg-base hover:bg-bg-elevated"
                    }`}
                  >
                    <div className="flex items-center gap-2 min-w-0">
                      {node.kind === "department" ? (
                        <GraduationCap className="size-3.5 shrink-0 text-action-primary" />
                      ) : (
                        <Home className="size-3.5 shrink-0 text-action-warning" />
                      )}
                      <div className="min-w-0">
                        <p className="text-xs font-semibold text-text-primary truncate">
                          {node.label}
                        </p>
                        <p className="text-[11px] text-text-muted truncate">{node.subtitle}</p>
                      </div>
                    </div>
                    <span className="font-mono text-[11px] text-text-muted shrink-0">
                      {node.metrics[0]?.value ?? 0}
                    </span>
                  </button>
                ))}
              </div>
            )}
          </div>
        </aside>

        {/* Right Pane: Selected Node Details, Gaps & Leaf Students */}
        <section className="md:col-span-7 surface-card bg-bg-surface p-4 space-y-4">
          <div className="flex flex-wrap items-start justify-between gap-3">
            <div className="min-w-0">
              <h2 className="text-base font-semibold text-text-primary truncate">
                {selectedNode?.label}
              </h2>
              <p className="text-xs text-text-muted">{selectedNode?.subtitle}</p>
            </div>
            <button
              type="button"
              onClick={() => setAssignOpen((v) => !v)}
              className="action-btn min-h-9 inline-flex items-center gap-1.5 bg-action-primary px-3 py-1.5 text-xs font-semibold text-white hover:brightness-110"
            >
              <UserPlus className="size-3.5" />
              <span>+ Assign People</span>
            </button>
          </div>

          {/* 2-column wrap metric grid */}
          <div className="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
            {(selectedNode?.metrics ?? []).map((m) => (
              <div key={m.label} className="action-btn border border-border bg-bg-base p-2.5">
                <p className="text-[11px] text-text-muted">{m.label}</p>
                <p className="text-lg font-semibold text-text-primary">{m.value}</p>
              </div>
            ))}
          </div>

          {unlinkedCount > 0 && (
            <div className="surface-card bg-amber-500/10 px-3 py-2 text-xs text-amber-700 dark:text-amber-300 flex items-center gap-2">
              <AlertCircle className="size-4 shrink-0" />
              <span>
                {unlinkedCount} student{unlinkedCount === 1 ? "" : "s"} in this scope missing a
                linked guardian record.
              </span>
            </div>
          )}

          {assignOpen && (
            <form
              onSubmit={handleQuickAssign}
              className="surface-card bg-bg-base p-3 space-y-2.5"
            >
              <p className="text-xs font-semibold text-text-primary">
                Quick Assign to {selectedNode?.label}
              </p>
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
                <select
                  value={assignRole}
                  onChange={(e) => setAssignRole(e.target.value as "cr" | "faculty" | "hostel")}
                  className="action-btn min-h-9 border border-border bg-bg-surface px-2.5 text-xs"
                >
                  <option value="cr">Promote Student to CR</option>
                  <option value="faculty">Assign Faculty / Class Teacher</option>
                  <option value="hostel">Allocate Hostel Room</option>
                </select>
                <input
                  type="text"
                  required
                  value={assignTargetId}
                  onChange={(e) => setAssignTargetId(e.target.value)}
                  placeholder="Roll number or Employee ID..."
                  className="action-btn min-h-9 border border-border bg-bg-surface px-2.5 text-xs sm:col-span-2"
                />
              </div>
              <div className="flex items-center gap-2">
                <button
                  type="submit"
                  className="action-btn min-h-9 bg-action-primary px-3 py-1 text-xs font-semibold text-white"
                >
                  Save Assignment
                </button>
                <button
                  type="button"
                  onClick={() => setAssignOpen(false)}
                  className="surface-card min-h-9 px-3 py-1 text-xs font-medium"
                >
                  Cancel
                </button>
              </div>
            </form>
          )}

          {/* Leaf Student Nodes */}
          <div className="space-y-2">
            <h3 className="text-xs font-semibold uppercase tracking-wider text-text-muted flex items-center gap-1.5">
              <Users className="size-3.5" />
              Assigned Students ({nodeStudents.length})
            </h3>
            {nodeStudents.length === 0 ? (
              <p className="text-xs text-text-muted">
                No students matched this node scope yet.
              </p>
            ) : (
              <ul className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {nodeStudents.slice(0, 24).map((s) => (
                  <li key={s.id}>
                    <Link
                      href={`/admin/students/${s.id}`}
                      className="action-btn block border border-border bg-bg-base p-2.5 hover:bg-bg-elevated transition-colors"
                    >
                      <div className="flex items-center justify-between gap-2">
                        <span className="text-xs font-semibold text-text-primary truncate">
                          {s.fullName || s.name || s.uniqueId}
                        </span>
                        <span className="font-mono text-[11px] text-action-primary shrink-0">
                          {s.uniqueId}
                        </span>
                      </div>
                      <p className="text-[11px] text-text-muted truncate mt-0.5">
                        {s.department ?? "General"} ·{" "}
                        {(s as { isOnCampus?: boolean }).isOnCampus ? "ON CAMPUS" : "OFF CAMPUS"}
                      </p>
                    </Link>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      </div>
    </div>
  );
}
</file>

<file path="src/components/hod/DeptClassReviewsCard.tsx">
"use client";

/**
 * DeptClassReviewsCard — HOD/authority "Dept class reviews" card.
 *
 * Rolls up class-session reviews by faculty for the authority's department
 * (or campus-wide for a principal). Data: /api/class-sessions/reviews/summary
 * ?dept=me (the authority's own dept; campus-wide when the caller can). Shows
 * overall avg, review count, and the top faculties by volume.
 */

import { useApiResource } from "@/hooks/useApiResource";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { PageLoading } from "@/components/shared/LoadingStates";
import { BarChart3, Star, Users } from "lucide-react";
import { useAuthStore } from "@/stores/authStore";

interface DeptSummary {
  data: {
    view: string;
    faculty: Array<{ facultyId: string; facultyName: string | null; total: number; avg: number | null }>;
    totals: { facultyCount: number; reviews: number; overallAvg: number | null };
  };
}

function DeptClassReviewsCardInner() {
  const user = useAuthStore((s) => s.user);
  const { data, error, loading } = useApiResource<DeptSummary>(
    "/api/class-sessions/reviews/summary?dept=me",
    { ttlMs: 300_000 },
  );
  const s = data?.data;

  if (loading) {
    return (
      <WidgetBoundary name="DeptClassReviewsCard" title="Dept class reviews" capability="class.review.view">
        <PageLoading />
      </WidgetBoundary>
    );
  }
  if (error || !s) {
    return (
      <WidgetBoundary name="DeptClassReviewsCard" title="Dept class reviews" capability="class.review.view">
        <div className="surface-card bg-bg-surface p-4 text-sm text-text-muted">
          Dept class reviews unavailable{error ? `: ${String(error)}` : ""}.
        </div>
      </WidgetBoundary>
    );
  }

  const top = [...s.faculty].sort((a, b) => b.total - a.total).slice(0, 5);

  return (
    <WidgetBoundary name="DeptClassReviewsCard" title="Dept class reviews" capability="class.review.view">
      <div className="surface-card bg-bg-surface p-4 space-y-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <BarChart3 className="h-4 w-4 text-action-primary" />
            <h3 className="text-sm font-semibold text-text-primary">Dept class reviews</h3>
          </div>
          <span className="text-xs text-text-muted">
            {s.totals.reviews} reviews · {s.totals.facultyCount} faculty
          </span>
        </div>

        <div className="flex items-center gap-2">
          <Star className="h-4 w-4 text-amber-500" />
          <span className="text-lg font-bold text-text-primary tabular-nums">
            {s.totals.overallAvg != null ? s.totals.overallAvg : "—"}
          </span>
          <span className="text-xs text-text-muted">overall avg</span>
        </div>

        {top.length === 0 ? (
          <p className="text-sm text-text-muted">No class reviews yet in your department.</p>
        ) : (
          <div className="space-y-1.5">
            <div className="flex items-center gap-1.5 text-xs text-text-muted">
              <Users className="h-3.5 w-3.5" /> By faculty
            </div>
            {top.map((f) => (
              <div key={f.facultyId} className="flex items-center justify-between text-xs">
                <span className="text-text-secondary">{f.facultyName ?? f.facultyId.slice(0, 8)}</span>
                <span className="flex items-center gap-2 text-text-muted">
                  <span className="tabular-nums">{f.total} reviews</span>
                  <span className="text-amber-500 tabular-nums">{f.avg ?? "—"}</span>
                </span>
              </div>
            ))}
          </div>
        )}
      </div>
    </WidgetBoundary>
  );
}

export function DeptClassReviewsCard() {
  return <DeptClassReviewsCardInner />;
}
