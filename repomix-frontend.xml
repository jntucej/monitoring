}

export function MiniDriftPill({ driftCount, label, onClick, className }: MiniDriftPillProps) {
  const isDrift = driftCount > 0;

  return (
    <button
      type="button"
      onClick={onClick}
      disabled={!onClick}
      aria-label={label}
      className={cn("flex items-center h-4 min-w-0", className)}
