<file path="src/app/(approver)/exam/permissions/_panel.tsx">
"use client";

import { useState } from "react";
import Link from "next/link";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";


import { useAuthStore } from "@/stores/authStore";
import { getRoleTier } from "@/lib/alert-hierarchy";
import type { Role } from "@/lib/types";
import { PermissionList } from "@/components/approver/PermissionList";
import { useApiResource, clearCache } from "@/hooks/useApiResource";
import { usePolling } from "@/hooks/usePolling";
import {
  ShieldCheck,
  UserCheck,
  AlertTriangle,
  Loader2,
  Inbox,
} from "lucide-react";
import type { PermissionItem } from "@/components/approver/PermissionRow";
import {
  ApproverStageDrawer,
  type StagePivotItem,
} from "@/components/nav/level2/ApproverStageDrawer";

export type ExamQueue = "oie" | "vice_principal";

interface PermissionsResponse {
  success: boolean;
  data: PermissionItem[];
  total?: number;
}

function StatCard({
  icon: Icon,
  label,
  value,
  sub,
  accent = "text-white",
  loading,
}: {
  icon: React.ComponentType<{ className?: string }>;
  label: string;
  value: React.ReactNode;
  sub?: string;
  accent?: string;
  loading?: boolean;
}) {
  return (
    <div className="surface-card bg-bg-base p-4 flex flex-col gap-2">
      <div className="flex items-center gap-2 text-text-muted">
        <Icon className="w-4 h-4" />
        <span className="text-xs font-semibold uppercase tracking-wide">{label}</span>
      </div>
      {loading ? (
        <Loader2 className="w-5 h-5 animate-spin text-text-muted" />
      ) : (
        <p className={`text-2xl font-bold ${accent}`}>{value}</p>
      )}
      {sub && <p className="text-xs text-text-muted">{sub}</p>}
    </div>
  );
}

function EmptyState({ message }: { message: string }) {
  return (
    <div className="surface-card bg-bg-elevated/30 p-8 text-center text-sm text-text-muted">
      {message}
    </div>
  );
}

export function ExamPermissionsPanel({ queue }: { queue: ExamQueue }) {
  const user = useAuthStore((s) => s.user);
  const role = (user?.role ?? "exam_branch") as Role;
  const tier = getRoleTier(role);
  const [stageItem, setStageItem] = useState<StagePivotItem | null>(null);

  const isExamBranchRole = role === "exam_branch";

  const {
    data: oieData,
    loading: oieLoading,
    refresh: refreshOie,
  } = useApiResource<PermissionsResponse>(
    isExamBranchRole
      ? "/api/permissions?workflow_type=exam&status=PENDING&stage=oie"
      : "/api/permissions?workflow_type=exam&status=PENDING",
    { ttlMs: 30_000 },
  );

  const {
    data: vpData,
    loading: vpLoading,
    refresh: refreshVp,
  } = useApiResource<PermissionsResponse>(
    "/api/permissions?workflow_type=exam&status=PENDING&stage=vice_principal",
    { ttlMs: 30_000 }
  );

  const refresh = async () => {
    clearCache();
    await Promise.all([refreshOie(), refreshVp()]);
  };
  usePolling(refresh, { intervalMs: 30_000, enabled: !!user });

  const oieTotal = oieData?.total ?? oieData?.data?.length ?? 0;
  const vpTotal = vpData?.total ?? vpData?.data?.length ?? 0;

  const oieSlaBreached = (oieData?.data ?? []).filter((r) => {
    if (!r.sla_deadline) return false;
    const ts = new Date(r.sla_deadline).getTime();
    return !Number.isNaN(ts) && ts < Date.now();
  }).length;

  return (
    <div className="mx-auto w-full max-w-7xl space-y-6 px-4 sm:px-6 lg:px-8 py-6 min-w-0">
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p className="mt-1 text-sm text-text-muted">
            Signed in as <span className="font-medium capitalize text-text-secondary">{role.replace(/_/g, " ")}</span>
            {user?.name ? ` · ${user.name}` : ""}
          </p>
        </div>
      </div>

      {/* KPI row */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <Link href="/exam/permissions/oie" className="block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary">
          <StatCard
            icon={Inbox}
            label="OIE Pending"
            value={oieTotal}
            sub="Exam clearances awaiting OIE review"
            accent="text-action-success"
            loading={oieLoading && !oieData}
          />
        </Link>
        <Link href="/exam/permissions/vice-principal" className="block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary">
          <StatCard
            icon={UserCheck}
            label="VP Pending"
            value={vpTotal}
            sub="Requests escalated to Vice Principal"
            accent="text-action-info"
            loading={vpLoading && !vpData}
          />
        </Link>
        <Link href="/exam/permissions/oie" className="block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary">
          <StatCard
            icon={AlertTriangle}
            label="SLA Breached"
            value={oieSlaBreached}
            sub="OIE queue past their 48h SLA deadline"
            accent="text-action-warning"
            loading={oieLoading && !oieData}
          />
        </Link>
        <Link href="/exam/permissions/oie" className="block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action-primary">
          <StatCard
            icon={ShieldCheck}
            label="Total Open"
            value={oieTotal + vpTotal}
            sub="All pending exam-branch approvals"
            accent="text-white"
            loading={(oieLoading && !oieData) || (vpLoading && !vpData)}
          />
        </Link>
      </div>

      {/* Queue */}
      {queue === "oie" ? (
        <WidgetBoundary title="OIE Queue">
          {oieData?.data?.length ? (
            <PermissionList
              key="oie-queue"
              workflowType="exam"
              stageFilter="oie"
              title="OIE Queue"
              subtitle="Officer in Examination approval queue"
              initialPermissions={oieData.data}
            />
          ) : oieLoading ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted">
              <Loader2 className="w-4 h-4 animate-spin" /> Loading OIE queue…
            </div>
          ) : (
            <EmptyState message="No pending OIE exam clearances. The queue is clear." />
          )}
        </WidgetBoundary>
      ) : (
        <WidgetBoundary title="VP Queue">
          {vpData?.data?.length ? (
            <PermissionList
              key="vp-queue"
              workflowType="exam"
              stageFilter="vice_principal"
              title="Vice Principal Queue"
              subtitle="Vice Principal examination review queue"
              initialPermissions={vpData.data}
            />
          ) : vpLoading ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted">
              <Loader2 className="w-4 h-4 animate-spin" /> Loading VP queue…
            </div>
          ) : (
            <EmptyState message="No pending Vice Principal review items." />
          )}
        </WidgetBoundary>
      )}

      <ApproverStageDrawer item={stageItem} onClose={() => setStageItem(null)} />
    </div>
  );
}
