"use client";

import React, { useState, useEffect, useCallback } from "react";
import {Award, Share, CheckCircle, Calendar, ShieldCheck, FileText}  from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { getContributionPortfolio, type PortfolioItem } from "@/lib/retention";

/* ------------------------------------------------------------------ */
/* Type labels                                                         */
/* ------------------------------------------------------------------ */

const TYPE_LABELS: Record<string, string> = {
  achievement: "Achievement",
  event_attendance: "Event Attendance",
  event_registration: "Event Registration",
  goal_completed: "Goal Completed",
  work_assignment: "Work Assignment",
};

const TYPE_COLORS: Record<string, string> = {
  achievement: "text-action-warning bg-amber-500/10 border-amber-500/30",
  event_attendance: "text-action-success bg-emerald-500/10 border-emerald-500/30",
  event_registration: "text-action-primary bg-blue-500/10 border-blue-500/30",
  goal_completed: "text-unit-c bg-purple-500/10 border-purple-500/30",
  work_assignment: "text-cyan-400 bg-cyan-500/10 border-cyan-500/30",
};

/* ------------------------------------------------------------------ */
/* Component                                                           */
/* ------------------------------------------------------------------ */

export function ContributionPortfolio() {
  const { user } = useAuthStore();
  const [items, setItems] = useState<PortfolioItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [exported, setExported] = useState(false);

  const load = useCallback(async () => {
    if (!user) return;
    setLoading(true);
    try {
      const result = await getContributionPortfolio();
      if (result.success) {
        setItems(result.data.items);
      }
    } catch {
      // Silently fail
    } finally {
      setLoading(false);
    }
  }, [user]);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  // Group by type









  const userName = user?.name;
  const handleExport = useCallback(async () => {
    if (items.length === 0) return;
    try {
      const exportData = items
        .filter((i) => i.verified)
        .map((i) => ({
          title: i.title,
          type: i.type,
          date: i.date,
          verified: true,
        }));

      const json = JSON.stringify(
        {
          exportedAt: new Date().toISOString(),
          userName,
          items: exportData,
          note: "Verified contributions only. Not an official transcript.",
        },
        null,
        2
      );

      // Copy to clipboard as fallback
      try {
        await navigator.clipboard.writeText(json);
      } catch {
        // Try download
        const blob = new Blob([json], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `contribution-portfolio-${Date.now()}.json`;
        a.click();
        URL.revokeObjectURL(url);
      }
      setExported(true);
      setTimeout(() => setExported(false), 3000);
    } catch {
      // Silently ignore
    }
  }, [items, userName]);

  const totalVerified = items.filter((i) => i.verified).length;

  return (
    <WidgetBoundary title="Contribution Portfolio">
      <div className="surface-card bg-bg-elevated/40 p-4 sm:p-5">
        {/* Header */}
        <div className="flex items-center justify-between mb-4 flex-wrap gap-2">
          <div className="flex items-center gap-2">
            <Award className="h-4 w-4 text-action-warning" />
            <h3 className="text-sm font-medium text-text-primary">Contribution Portfolio</h3>
            {totalVerified > 0 && (
              <span className="surface-card bg-amber-500/20 px-2 py-0.5 text-xs text-action-warning">
                {totalVerified} verified
              </span>
            )}
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExport}
              disabled={items.length === 0 || exported}
              className="surface-card flex items-center gap-1.5 bg-amber-500/10 px-3 py-1.5 text-xs text-action-warning hover:bg-amber-500/20 disabled:opacity-40 transition-colors motion-reduce:transition-none"
            >
              {exported ? (
                <>
                  <CheckCircle className="h-3.5 w-3.5" />
                  Copied
                </>
              ) : (
                <>
                  <Share className="h-3.5 w-3.5" />
                  Export
                </>
              )}
            </button>
          </div>
        </div>

        {/* Disclaimer */}
        <div className="surface-card mb-4 bg-bg-surface/30 p-2.5">
          <p className="text-xs text-text-muted flex items-center gap-1.5">
            <ShieldCheck className="h-3.5 w-3.5" />
            Verified contributions only. This is a personal record, not an
            official transcript. Exported items contain no PII.
          </p>
        </div>

        {/* Content */}
        {loading ? (
          <div className="h-32 animate-pulse rounded bg-bg-elevated/20" />
        ) : items.length === 0 ? (
          <div className="py-8 text-center">
            <FileText className="size-6 text-text-muted mx-auto mb-2" />
            <p className="text-xs text-text-muted">
              No contributions yet. Participate in campus events, complete goals,
              and earn achievements to build your portfolio.
            </p>
          </div>
        ) : (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 max-h-96 overflow-y-auto">
            {items.map((item) => (
              <div
                key={item.id}
                className={`rounded-lg border p-3 ${
                  TYPE_COLORS[item.type] ?? "text-text-secondary border-border/40 bg-bg-elevated/30"
                }`}
              >
                <div className="flex items-start gap-2">
                  <div className="flex-1 min-w-0">
                    <p className="text-xs font-medium text-text-primary truncate">
                      {item.title}
                    </p>
                    <div className="mt-1.5 flex flex-wrap items-center gap-2">
                      <span className="text-xs opacity-70">
                        {TYPE_LABELS[item.type] ?? item.type}
                      </span>
                      <span className="text-xs opacity-60 flex items-center gap-1">
                        <Calendar className="size-3.5" />
                        {new Date(item.date).toLocaleDateString()}
                      </span>
                    </div>
                    {item.details && (
                      <p className="mt-1 text-xs opacity-60 line-clamp-1">
                        {item.details}
                      </p>
                    )}
                  </div>
                  {item.verified && (
                    <CheckCircle className="h-4 w-4 shrink-0 text-action-success" />
                  )}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default ContributionPortfolio;
</file>

<file path="src/components/retention/DigitalHandover.tsx">
"use client";

import React, { useState, useEffect, useCallback } from "react";
import {
  Handshake,
  AlertTriangle,
  Wrench,
  ListTodo,
  CheckCircle,
  Plus,
  X,
  ChevronDown,
  Clock,
} from "lucide-react";
import { useAuthStore } from "@/stores/authStore";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import {
  getShiftHandovers,
  createShiftHandover,
  type HandoverItem,
  type HandoverRecord,
} from "@/lib/retention";

/* ------------------------------------------------------------------ */
/* Constants                                                           */
/* ------------------------------------------------------------------ */

const HANDOVER_ROLES = [
  "operator",
  "caretaker",
  "supervisor",
  "admin",
  "sysadmin",
  "hostel_manager",
];

const ITEM_TYPES = [
  "unresolved_incident",
  "equipment_fault",
  "outstanding_exception",
  "pending_task",
] as const;

const SEVERITY_COLORS: Record<string, string> = {
  high: "text-action-danger border-rose-500/30 bg-rose-500/10",
  medium: "text-action-warning border-amber-500/30 bg-amber-500/10",
  low: "text-text-muted border-border/30 bg-bg-elevated/20",
};

/* ------------------------------------------------------------------ */
/* Component                                                           */
/* ------------------------------------------------------------------ */

export function DigitalHandover() {
  const { user, role } = useAuthStore();
  const [handovers, setHandovers] = useState<HandoverRecord[]>([]);
  const [loading, setLoading] = useState(true);
  const [showForm, setShowForm] = useState(false);
  const [expandedId, setExpandedId] = useState<string | null>(null);

  // Form state
  const [toRole, setToRole] = useState("operator");
  const [items, setItems] = useState<HandoverItem[]>([
    { type: "unresolved_incident", title: "", severity: "medium" },
  ]);
  const [notes, setNotes] = useState("");
  const [submitting, setSubmitting] = useState(false);

  const canHandover = HANDOVER_ROLES.includes(role ?? "");

  const load = useCallback(async () => {
    if (!user || !canHandover) return;
    setLoading(true);
    try {
      const result = await getShiftHandovers(role ?? undefined);
      if (result.success) {
        setHandovers(result.data.handovers);
      }
    } catch {
      // Silently fail
    } finally {
      setLoading(false);
    }
  }, [user, role, canHandover]);

  useEffect(() => {
    load().catch(() => {});
  }, [load]);

  const addItem = () => {
    setItems((prev) => [
      ...prev,
      { type: "unresolved_incident", title: "", severity: "medium" },
    ]);
  };

  const removeItem = (idx: number) => {
    setItems((prev) => prev.filter((_, i) => i !== idx));
  };

  const updateItem = (idx: number, field: keyof HandoverItem, value: string) => {
    setItems((prev) => {
      const next = [...prev];
      next[idx] = { ...next[idx], [field]: value } as HandoverItem;
      return next;
    });
  };

  const handleSubmit = useCallback(async () => {
    if (!user) return;
    const validItems = items.filter((i) => i.title.trim());
    if (validItems.length === 0) return;
    setSubmitting(true);
    try {
      const result = await createShiftHandover({
        toRole,
        items: validItems,
        notes: notes.trim() || undefined,
      });
      if (result.success) {
        setItems([{ type: "unresolved_incident", title: "", severity: "medium" }]);
        setNotes("");
        setShowForm(false);
        load();
      }
    } catch {
      // Silently ignore
    } finally {
      setSubmitting(false);
    }
  }, [user, toRole, items, notes, load]);

  return (
    <WidgetBoundary title="Digital Handover">
      <div className="surface-card bg-bg-elevated/40 p-4 sm:p-5">
        {/* Header */}
        <div className="flex items-center justify-between mb-4 flex-wrap gap-2">
          <div className="flex items-center gap-2">
            <Handshake className="h-4 w-4 text-action-warning" />
            <h3 className="text-sm font-medium text-text-primary">Shift Handover</h3>
            <span className="text-xs text-text-muted capitalize">{role}</span>
          </div>
          {canHandover && (
            <button
              type="button"
              onClick={() => setShowForm(!showForm)}
              className="surface-card flex items-center gap-1.5 bg-amber-500/10 px-3 py-1.5 text-xs text-action-warning hover:bg-amber-500/20 transition-colors motion-reduce:transition-none"
            >
              <Plus className="h-3.5 w-3.5" />
              {showForm ? "Cancel" : "New Handover"}
            </button>
          )}
        </div>

        {/* Create Handover Form */}
        {showForm && (
          <div className="surface-card mb-4 space-y-3 bg-bg-surface/40 p-4">
            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="block text-xs text-text-muted mb-1.5">
                  Hand over to role
                </label>
                <select
                  value={toRole}
                  onChange={(e) => setToRole(e.target.value)}
                  className="surface-card w-full bg-bg-elevated/50 px-3 py-2 text-xs text-text-secondary focus:outline-none focus:ring-1 focus:ring-amber-500/50"
                >
                  {HANDOVER_ROLES.map((r) => (
                    <option key={r} value={r}>
                      {r.charAt(0).toUpperCase() + r.slice(1)}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="block text-xs text-text-muted mb-1.5">
                  Notes (optional)
                </label>
                <input
                  type="text"
                  value={notes}
                  onChange={(e) => setNotes(e.target.value)}
                  placeholder="Brief shift summary"
                  className="surface-card w-full bg-bg-elevated/50 px-3 py-2 text-xs text-text-secondary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-amber-500/50"
                />
              </div>
            </div>

            {/* Items */}
            <div>
              <p className="text-xs text-text-muted mb-2">Items to hand over</p>
              <div className="space-y-2">
                {items.map((item, idx) => (
                  <div key={idx} className="flex gap-2 items-start">
                    <select
                      value={item.type}
                      onChange={(e) =>
                        updateItem(idx, "type", e.target.value)
                      }
                      className="surface-card bg-bg-elevated/50 px-2 py-1.5 text-xs text-text-secondary focus:outline-none w-6 shrink-0"
                      aria-label="Item type"
                    >
                      {ITEM_TYPES.map((t) => (
                        <option key={t} value={t}>
                          {t.replace(/_/g, " ").toUpperCase()}
                        </option>
                      ))}
                    </select>
                    <input
                      type="text"
                      value={item.title}
                      onChange={(e) =>
                        updateItem(idx, "title", e.target.value)
                      }
                      placeholder="Describe the item"
                      className="surface-card flex-1 bg-bg-elevated/50 px-3 py-1.5 text-xs text-text-secondary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-amber-500/50"
                    />
                    <select
                      value={item.severity}
                      onChange={(e) =>
                        updateItem(idx, "severity", e.target.value)
                      }
                      className="surface-card bg-bg-elevated/50 px-2 py-1.5 text-xs text-text-secondary focus:outline-none w-6 shrink-0"
                      aria-label="Severity"
                    >
                      <option value="low">Low</option>
                      <option value="medium">Med</option>
                      <option value="high">High</option>
                    </select>
                    <button
                      type="button"
                      onClick={() => removeItem(idx)}
                      className="p-1 text-text-muted hover:text-action-danger transition-colors motion-reduce:transition-none shrink-0"
                      aria-label="Remove item"
                    >
                      <X className="h-3.5 w-3.5" />
                    </button>
                  </div>
                ))}
              </div>
              <button
                type="button"
                onClick={addItem}
                className="mt-2 text-xs text-action-warning hover:text-action-warning transition-colors motion-reduce:transition-none"
              >
                + Add another item
              </button>
            </div>

            <button
              type="button"
              onClick={handleSubmit}
              disabled={submitting || items.filter((i) => i.title.trim()).length === 0}
              className="surface-card flex items-center gap-1.5 bg-amber-500/80 px-4 py-2 text-xs font-medium text-white hover:bg-action-warning disabled:opacity-40 transition-colors motion-reduce:transition-none"
            >
              {submitting ? (
                "Creating…"
              ) : (
                <>
                  <CheckCircle className="h-3.5 w-3.5" />
                  Generate Handover
                </>
              )}
            </button>
          </div>
        )}

        {/* Handover History */}
        {loading ? (
          <div className="h-6 animate-pulse rounded bg-bg-elevated/20" />
        ) : handovers.length === 0 ? (
          <p className="text-xs text-text-muted py-6 text-center">
            No handovers yet. Generate one at the end of your shift.
          </p>
        ) : (
          <div className="space-y-3 max-h-6 overflow-y-auto">
            {handovers.map((ho) => {
              const expanded = expandedId === ho.id;
              return (
                <div
                  key={ho.id}
                  className={`rounded-lg border p-3 ${
                    expanded
                      ? "border-amber-500/40 bg-amber-500/5"
                      : "border-border/40 bg-bg-elevated/30"
                  }`}
                >
                  <button
                    type="button"
                    onClick={() => setExpandedId(expanded ? null : ho.id)}
                    className="flex w-full items-start gap-2 text-left"
                  >
                    <div
                      className={`mt-0.5 flex h-6 w-6 items-center justify-center rounded-full ${
                        ho.items.some((i) => i.severity === "high")
                          ? "bg-rose-500/20 text-action-danger"
                          : "bg-amber-500/20 text-action-warning"
                      }`}
                    >
                      {ho.items.some((i) => i.severity === "high") ? (
                        <AlertTriangle className="h-3.5 w-3.5" />
                      ) : (
                        <Wrench className="h-3.5 w-3.5" />
                      )}
                    </div>
                    <div className="flex-1 min-w-0">
                      <p className="text-xs font-medium text-text-secondary">
                        {ho.byUserName} → {ho.toRole}
                      </p>
                      <p className="text-xs text-text-muted flex items-center gap-2">
                        <Clock className="size-3.5" />
                        {new Date(ho.createdAt).toLocaleString()}
                        <span>·</span>
                        {ho.items.length} item(s)
                      </p>
                    </div>
                    <ChevronDown
                      className={`h-4 w-4 text-text-muted shrink-0 transition-transform motion-reduce:transition-none ${
                        expanded ? "rotate-180" : ""
                      }`}
                    />
                  </button>

                  {expanded && (
                    <div className="mt-3 space-y-1.5">
                      {ho.notes && (
                        <p className="text-xs text-text-muted italic">
                          &ldquo;{ho.notes}&rdquo;
                        </p>
                      )}
                      {ho.items.map((item, i) => (
                        <div
                          key={i}
                          className={`flex items-start gap-2 rounded border p-2 ${SEVERITY_COLORS[item.severity ?? "low"] ?? SEVERITY_COLORS.low}`}
                        >
                          <ListTodo className="h-3.5 w-3.5 mt-0.5 shrink-0" />
                          <div className="flex-1 min-w-0">
                            <p className="text-xs text-text-secondary truncate">
                              {item.title}
                            </p>
                            <p className="text-xs opacity-70 capitalize">
                              {item.type.replace(/_/g, " ")}
                            </p>
                          </div>
                          <span className="text-xs uppercase shrink-0 opacity-70">
                            {item.severity}
                          </span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}
      </div>
    </WidgetBoundary>
  );
}

export default DigitalHandover;
