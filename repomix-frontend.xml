        why="Auditing ingredient stock levels prevents kitchen runouts during active meal hours and initiates timely restock requests."
        severity="info"
        primaryAction={{ label: "Operational Requests", href: "/mess/operational-requests" }}
        secondaryActions={[
          { label: "Menu Management", href: "/mess/menu-management" },
          { label: "Mess Overview", href: "/mess" },
        ]}
      />

      {error && (
        <WidgetError message={`Inventory unavailable: ${error}`} onRetry={() => void refreshAll()} />
      )}

      <WidgetBoundary title="Inventory and Stock">
        <div className="rounded-xl border border-border bg-bg-base overflow-hidden min-w-0">
          <div className="surface-card px-4 py-3 flex items-center gap-2 min-w-0">
            <Package className="w-4 h-4 text-action-success shrink-0" />
            <span className="text-sm font-semibold text-white truncate">Inventory &amp; Stock</span>
            <span className="ml-auto text-xs text-text-muted shrink-0">{d ? `${d.total} item(s)` : "—"}</span>
          </div>
          {busy ? (
            <div className="p-4 flex items-center gap-2 text-sm text-text-muted min-w-0">
              <Loader2 className="w-4 h-4 animate-spin motion-reduce:animate-none shrink-0" />
              Loading inventory…
            </div>
          ) : items.length > 0 ? (
            <div className="min-w-0">
              <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 p-4 min-w-0">
                <div className="surface-card bg-bg-surface/40 p-3 min-w-0">
