<file path="src/components/shared/ChartRendererImpl.tsx">
"use client";
// src/components/shared/ChartRenderer.tsx
// SCAFFOLD:CHART — 8-type chart renderer. Idempotent: regenerate with
// `node scripts/scaffold-analytics.mjs new <feature> --force` to update.

import React, { useMemo } from "react";
import {
  ResponsiveContainer, LineChart, Line, BarChart, Bar, AreaChart, Area,
  PieChart, Pie, Cell, RadarChart, Radar, PolarGrid, PolarAngleAxis,
  PolarRadiusAxis, ScatterChart, Scatter, XAxis, YAxis, ZAxis, CartesianGrid,
  Tooltip, Legend, ComposedChart, RadialBarChart, RadialBar,
} from "recharts";
import { useGlass } from "@/context/GlassContext";

export type ChartType =
  | "line" | "area" | "bar" | "composed"
  | "radar" | "scatter" | "pie" | "radial";

export interface SeriesDef {
  key: string;
  label: string;
  color: string;
  type?: "line" | "area" | "bar";
}

export const CHART_PALETTE = [
  "var(--action-success)", "var(--action-primary)", "var(--action-warning)", "var(--action-danger)",
  "var(--unit-c)", "var(--action-info)", "var(--unit-c)", "var(--action-success)",
];

const AXIS = {
  stroke: "var(--text-muted)",
  fontSize: 11,
  tickLine: false,
  axisLine: false,
};

const TOOLTIP = {
  background: "var(--bg-elevated)",
  border: "1px solid var(--border)",
  borderRadius: 12,
  fontSize: 12,
  color: "var(--text-primary)",
};

/**
 * Fix 8: Throttle+debounce chart renders and disable animations on low-end
 * hardware (hardwareConcurrency <= 4). The parent should pass `isStale` which
 * is a timestamp/counter that only changes when fresh data arrives, preventing
 * re-renders on every layout tick.
 */
export function ChartRenderer({
  type, data, series, xKey, height = 280, stacked = false, onPointClick,
}: {
  type: ChartType;
  data: any[];
  series: SeriesDef[];
  xKey: string;
  height?: number;
  stacked?: boolean;
  /** Optional §12 chart drilldown: click a data point to surface the
   * underlying record(s) for that period. Receives the raw data row.
   * Only wired when a caller actually provides it — display-only charts
   * keep working unchanged. */
  onPointClick?: (row: any) => void;
}) {
  const { isLowEndDevice } = useGlass();

  // Fix 8: disable animation on low-end hardware
  const animationProps = useMemo(() => {
    if (isLowEndDevice) return { isAnimationActive: false };
    return {};
  }, [isLowEndDevice]);

  // Fix 8: limit data points for long lists (>50 items → sample)
  const chartData = useMemo(() => {
    if (!data || data.length <= 50) return data;
    const step = Math.ceil(data.length / 50);
    return data.filter((_, i) => i % step === 0);
  }, [data]);

  if (type === "pie") {
    const key = series[0]?.key ?? "value";
    return (
      <ResponsiveContainer width="100%" height={height}>
        <PieChart>
          <Pie data={chartData} dataKey={key} nameKey={xKey} cx="50%" cy="50%"
               innerRadius={60} outerRadius={105} paddingAngle={3} stroke="none"
               {...animationProps}>
            {chartData.map((_: any, i: number) => (
              <Cell key={i} fill={CHART_PALETTE[i % CHART_PALETTE.length]} />
            ))}
          </Pie>
          <Tooltip contentStyle={TOOLTIP} />
          <Legend wrapperStyle={{ fontSize: 11 }} />
        </PieChart>
      </ResponsiveContainer>
    );
  }

  if (type === "radial") {
    const key = series[0]?.key ?? "value";
    return (
      <ResponsiveContainer width="100%" height={height}>
        <RadialBarChart data={chartData} innerRadius="20%" outerRadius="95%"
                        startAngle={90} endAngle={-270} {...animationProps}>
          <RadialBar dataKey={key} cornerRadius={8} background>
            {chartData.map((_: any, i: number) => (
              <Cell key={i} fill={CHART_PALETTE[i % CHART_PALETTE.length]} />
            ))}
          </RadialBar>
          <Tooltip contentStyle={TOOLTIP} />
          <Legend wrapperStyle={{ fontSize: 11 }} />
        </RadialBarChart>
      </ResponsiveContainer>
    );
  }

  if (type === "radar") {
    return (
      <ResponsiveContainer width="100%" height={height}>
        <RadarChart data={chartData} outerRadius="75%" {...animationProps}>
          <PolarGrid stroke="var(--border)" />
          <PolarAngleAxis dataKey={xKey} tick={{ fill: "var(--text-muted)", fontSize: 11 }} />
          <PolarRadiusAxis tick={{ fill: "var(--text-muted)", fontSize: 10 }} />
          {series.map((s) => (
            <Radar key={s.key} name={s.label} dataKey={s.key}
                   stroke={s.color} fill={s.color} fillOpacity={0.35} />
          ))}
          <Tooltip contentStyle={TOOLTIP} />
          <Legend wrapperStyle={{ fontSize: 11 }} />
        </RadarChart>
      </ResponsiveContainer>
    );
  }

  if (type === "scatter") {
    return (
      <ResponsiveContainer width="100%" height={height}>
        <ScatterChart>
          <CartesianGrid stroke="var(--border)" strokeDasharray="3 3" />
          <XAxis dataKey={xKey} {...AXIS} />
          <YAxis {...AXIS} />
          <ZAxis range={[60, 220]} />
          {series.map((s) => (
            <Scatter key={s.key} name={s.label} data={chartData} dataKey={s.key} fill={s.color} />
          ))}
          <Tooltip contentStyle={TOOLTIP} />
          <Legend wrapperStyle={{ fontSize: 11 }} />
        </ScatterChart>
      </ResponsiveContainer>
    );
  }

  if (type === "composed") {
    const [first, ...rest] = series;
    return (
      <ResponsiveContainer width="100%" height={height}>
        <ComposedChart data={chartData} {...animationProps}>
          <CartesianGrid stroke="var(--border)" strokeDasharray="3 3" />
          <XAxis dataKey={xKey} {...AXIS} />
          <YAxis {...AXIS} />
          <Tooltip contentStyle={TOOLTIP} />
          <Legend wrapperStyle={{ fontSize: 11 }} />
          {first && (
            <Area type="monotone" dataKey={first.key} name={first.label}
                  stroke={first.color} fill={first.color} fillOpacity={0.25} />
          )}
          {rest.map((s) => s.type === "bar" ? (
            <Bar key={s.key} dataKey={s.key} name={s.label} fill={s.color} radius={[6, 6, 0, 0]} />
          ) : (
            <Line key={s.key} type="monotone" dataKey={s.key} name={s.label}
                  stroke={s.color} strokeWidth={2.5} dot={{ r: 3 }} />
          ))}
        </ComposedChart>
      </ResponsiveContainer>
    );
  }

  if (type === "bar") {
    return (
      <ResponsiveContainer width="100%" height={height}>
        <BarChart data={chartData} {...animationProps}>
          <CartesianGrid stroke="var(--border)" strokeDasharray="3 3" />
          <XAxis dataKey={xKey} {...AXIS} />
          <YAxis {...AXIS} />
          <Tooltip contentStyle={TOOLTIP} />
          <Legend wrapperStyle={{ fontSize: 11 }} />
          {series.map((s) => (
            <Bar key={s.key} dataKey={s.key} name={s.label} fill={s.color}
                 radius={[6, 6, 0, 0]} stackId={stacked ? "stack" : undefined} />
          ))}
        </BarChart>
      </ResponsiveContainer>
    );
  }

  if (type === "area") {
    return (
      <ResponsiveContainer width="100%" height={height}>
        <AreaChart data={chartData} onClick={(e: any) => {
          const row = e?.activePayload?.[0]?.payload;
          if (onPointClick && row) onPointClick(row);
        }} {...animationProps}>
          <defs>
            {series.map((s) => (
              <linearGradient key={s.key} id={`grad-${s.key}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stopColor={s.color} stopOpacity={0.75} />
                <stop offset="95%" stopColor={s.color} stopOpacity={0} />
              </linearGradient>
            ))}
          </defs>
          <CartesianGrid stroke="var(--border)" strokeDasharray="3 3" />
          <XAxis dataKey={xKey} {...AXIS} />
          <YAxis {...AXIS} />
          <Tooltip contentStyle={TOOLTIP} />
          <Legend wrapperStyle={{ fontSize: 11 }} />
          {series.map((s) => (
            <Area key={s.key} type="monotone" dataKey={s.key} name={s.label}
                  stroke={s.color} fill={`url(#grad-${s.key})`}
                  stackId={stacked ? "stack" : undefined}
                  activeDot={onPointClick ? { r: 5 } : undefined} />
          ))}
        </AreaChart>
      </ResponsiveContainer>
    );
  }

  /* default: line */
  return (
    <ResponsiveContainer width="100%" height={height}>
      <LineChart data={chartData} onClick={(e: any) => {
        const row = e?.activePayload?.[0]?.payload;
        if (onPointClick && row) onPointClick(row);
      }} {...animationProps}>
        <CartesianGrid stroke="var(--border)" strokeDasharray="3 3" />
        <XAxis dataKey={xKey} {...AXIS} />
        <YAxis {...AXIS} />
        <Tooltip contentStyle={TOOLTIP} />
        <Legend wrapperStyle={{ fontSize: 11 }} />
        {series.map((s) => (
          <Line key={s.key} type="monotone" dataKey={s.key} name={s.label}
                stroke={s.color} strokeWidth={2.5}
                dot={onPointClick ? { r: 4 } : { r: 3 }}
                activeDot={{ r: 5 }} />
        ))}
      </LineChart>
    </ResponsiveContainer>
  );
}

export default ChartRenderer;
</file>

<file path="src/components/shared/ChartTypeSwitcher.tsx">
"use client";
// src/components/shared/ChartTypeSwitcher.tsx
// 8-type chart toggle. Idempotent: regenerate with --force.

import React from "react";
import {
  LineChart as LineChartIcon, BarChart3, PieChart as PieChartIcon,
  Radar as RadarIcon, ScatterChart as ScatterIcon, AreaChart as AreaChartIcon,
  Gauge, Layers, ChevronDown,
} from "lucide-react";
import type { ChartType } from "./ChartRenderer";

export const CHART_TYPE_OPTIONS: { id: ChartType; label: string; icon: React.ElementType }[] = [
  { id: "line",     label: "Line",     icon: LineChartIcon },
  { id: "area",     label: "Area",     icon: AreaChartIcon },
  { id: "bar",      label: "Bar",      icon: BarChart3 },
  { id: "composed", label: "Composed", icon: Layers },
  { id: "radar",    label: "Radar",    icon: RadarIcon },
  { id: "scatter",  label: "Scatter",  icon: ScatterIcon },
  { id: "pie",      label: "Pie",      icon: PieChartIcon },
  { id: "radial",   label: "Radial",   icon: Gauge },
];

/**
 * Chart type switcher.
 *
 * - sm+ (>=640px): icon-button row (all 8 options).
 * - < sm: a compact native <select> so the 8 options never overflow a
 *   narrow (375px) viewport.
 */
export function ChartTypeSwitcher({
  value, onChange, compact = false,
}: {
  value: ChartType;
  onChange: (t: ChartType) => void;
  compact?: boolean;
}) {
  const iconBtn = (opt: (typeof CHART_TYPE_OPTIONS)[number]) => {
    const Icon = opt.icon;
    const active = value === opt.id;
    return (
      <button
        key={opt.id}
        type="button"
        onClick={() => onChange(opt.id)}
        title={opt.label}
        aria-pressed={active}
        aria-label={opt.label}
        className={`flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-medium transition-all ${
          active
            ? "bg-emerald-500/15 text-action-success shadow-sm"
            : "text-text-muted hover:bg-bg-elevated hover:text-text-primary"
        }`}
      >
        <Icon className="h-3.5 w-3.5" />
        {!compact && <span>{opt.label}</span>}
      </button>
    );
  };

  return (
    <div className="flex items-center gap-2">
      {/* Compact select for narrow viewports (< sm) */}
      <div className="relative sm:hidden">
        <select
          value={value}
          onChange={(e) => onChange(e.target.value as ChartType)}
          aria-label="Chart type"
          className="surface-card appearance-none bg-bg-surface py-1.5 pl-3 pr-8 text-xs font-medium text-text-primary outline-none focus:"
        >
          {CHART_TYPE_OPTIONS.map((c) => (
            <option key={c.id} value={c.id}>{c.label}</option>
          ))}
        </select>
        <ChevronDown className="pointer-events-none absolute right-2 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-text-muted" />
      </div>

      {/* Full icon-button row (sm+) */}
      <div className="surface-card hidden sm:flex flex-wrap items-center gap-1 bg-bg-surface p-1">
        {CHART_TYPE_OPTIONS.map(iconBtn)}
      </div>
    </div>
  );
}

export default ChartTypeSwitcher;
</file>

<file path="src/components/shared/CommandBar.tsx">
"use client";

/**
 * CommandBar — Cmd/Ctrl+K command palette for the role console.
 *
 * Lists the role's configured actions (scan, manual-entry, pass-verify,
 * lookup) with keyboard navigation (up/down, Enter, Escape). Each action
 * navigates to the corresponding sub-route via next/navigation router.
 *
 * When the free-text query is 2+ chars the palette also runs a debounced
 * authenticated search against /api/persons?q=… and renders matching
 * person records above the static command list. Selecting a record row
 * navigates to the lookup page carrying the record id so the destination
 * page's own inspector opens it.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  ScanLine,
  UserPlus,
  BadgeCheck,
  Search,
  UserRound,
  Loader2,
} from "lucide-react";
import { useRouter } from "next/navigation";
import { getConsoleConfig, type ConsoleCommand } from "@/config/consoles";
import { getAuthHeaders } from "@/lib/utils";
import type { Person } from "@/lib/types";

interface CommandDef {
  id: ConsoleCommand;
  label: string;
  hint: string;
  icon: React.ComponentType<{ className?: string }>;
  href: string;
}

/** A person record returned by the /api/persons search. */
interface PersonHit {
  uniqueId: string;
  name: string;
  roll: string;
  personType: string;
}

function buildCommands(role: string): CommandDef[] {
  const config = getConsoleConfig(role);
  if (!config) return [];
  // Not every role defines every command; the operator + HOD nav commands
  // have explicit defs, while staff/faculty console commands (clock-in,
  // request-leave, attendance, ...) fall through to a generic def so the
  // palette still lists them.
  const defs: Partial<Record<ConsoleCommand, CommandDef>> = {
    scan: {
      id: "scan",
      label: "Scan badge",
      hint: "Open the scanner to read a pass or badge",
      icon: ScanLine,
      href: "/operator",
    },
    "manual-entry": {
      id: "manual-entry",
      label: "Manual entry",
      hint: "Record a movement without a scanner",
      icon: UserPlus,
      href: "/operator/manual-entry",
    },
    "pass-verify": {
      id: "pass-verify",
      label: "Verify pass",
      hint: "Check a person's QR pass validity",
      icon: BadgeCheck,
      href: "/operator/pass-verification",
    },
    lookup: {
      id: "lookup",
      label: "Look up person",
      hint: "Search a person by roll number or name",
      icon: Search,
      href: "/operator/manual-entry",
    },
    approve: {
      id: "approve",
      label: "Approve request",
      hint: "Approve a pending permission request",
      icon: BadgeCheck,
      href: "/hod/approvals/pending",
    },
    reject: {
      id: "reject",
      label: "Reject request",
      hint: "Reject a pending permission request",
      icon: Search,
      href: "/hod/approvals/pending",
    },
    escalate: {
      id: "escalate",
      label: "Escalate request",
      hint: "Escalate a permission request to a higher stage",
      icon: Search,
      href: "/hod/approvals/escalated",
    },
    "department-stats": {
      id: "department-stats",
      label: "Department stats",
      hint: "Open department reports and analytics",
      icon: Search,
      href: "/hod/reports",
    },
  };
  const roleRoot =
    role === "staff" ? "/staff" : role === "hod" ? "/hod" : "/operator";
  return (config.commands ?? [])
    .map((c) => defs[c])
    .filter((d): d is CommandDef => Boolean(d))
    .map((d) =>
      // Unknown console commands (staff/faculty) fall back to the role root
      // so the palette still navigates somewhere sensible.
      defs[d.id] ? d : { ...d, href: d.href || roleRoot },
    );
}

export interface CommandBarProps {
  role: string;
  /** Whether the palette is open. */
  open: boolean;
  onClose: () => void;
}

export function CommandBar({ role, open, onClose }: CommandBarProps) {
  const router = useRouter();
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const inputRef = useRef<HTMLInputElement>(null);

  const commands = useMemo(() => buildCommands(role), [role]);
  const lookupHref =
    commands.find((c) => c.id === "lookup")?.href ?? "/operator/manual-entry";

  // ── entity search state ────────────────────────────────────────────────
  const [personHits, setPersonHits] = useState<PersonHit[]>([]);
  const [searchLoading, setSearchLoading] = useState(false);
  const [searchError, setSearchError] = useState(false);
  const debounceRef = useRef<ReturnType<typeof setTimeout>>(null);

  // 2+ chars and not matching a command label/hint exactly (trim check)
  const q = query.trim();
  const isSearching = q.length >= 2;

  useEffect(() => {
    if (!open) return;
    if (!isSearching) {
      setPersonHits([]);
      setSearchLoading(false);
      setSearchError(false);
      return;
    }
    setSearchLoading(true);
    setSearchError(false);
    if (debounceRef.current) clearTimeout(debounceRef.current);
    debounceRef.current = setTimeout(async () => {
      try {
        const params = new URLSearchParams({ q });
        const res = await fetch(`/api/persons?${params.toString()}`, {
          headers: getAuthHeaders(),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const body = await res.json();
        const rows: Person[] | undefined = Array.isArray(body?.data)
          ? body.data
          : undefined;
        setPersonHits(
          (rows ?? []).slice(0, 8).map((p) => ({
            uniqueId: p.uniqueId,
            name: p.fullName || p.name || "Unknown",
            roll:
              p.studentDetails?.roll ||
              p.employeeDetails?.employeeId ||
              p.uniqueId,
            personType: p.personType,
          })),
        );
        setSearchLoading(false);
      } catch {
        setPersonHits([]);
        setSearchLoading(false);
        setSearchError(true);
      }
    }, 300);
    return () => {
      if (debounceRef.current) clearTimeout(debounceRef.current);
    };
  }, [q, isSearching, open]);

  // ── filtered command list ──────────────────────────────────────────────
  const filtered = useMemo(() => {
    if (!query.trim()) return commands;
    const lower = query.toLowerCase();
    return commands.filter(
      (c) =>
        c.label.toLowerCase().includes(lower) ||
        c.hint.toLowerCase().includes(lower),
    );
  }, [query, commands]);

  // Reset state when palette opens
  useEffect(() => {
    if (open) {
      setQuery("");
      setActive(0);
      setPersonHits([]);
      setSearchLoading(false);
      setSearchError(false);
      const t = setTimeout(() => inputRef.current?.focus(), 50);
      return () => clearTimeout(t);
    }
  }, [open]);

  // ── select handlers ────────────────────────────────────────────────────
  const handleSelectCommand = useCallback(
    (cmd: CommandDef) => {
      if (cmd.id === "lookup") {
        const params = new URLSearchParams();
        if (query.trim()) params.set("id", query.trim());
        const qs = params.toString();
        router.push(qs ? `${lookupHref}?${qs}` : lookupHref);
      } else {
        router.push(cmd.href);
      }
      onClose();
    },
    [lookupHref, onClose, query, router],
  );

  const handleSelectPerson = useCallback(
    (hit: PersonHit) => {
      const params = new URLSearchParams({ id: hit.uniqueId });
      router.push(`${lookupHref}?${params.toString()}`);
      onClose();
    },
    [lookupHref, onClose, router],
  );

  // ── combined list for keyboard nav ─────────────────────────────────────
  // Records come first when a search query is present; commands follow.
  type NavItem =
    | { kind: "person"; index: number; hit: PersonHit }
    | { kind: "command"; index: number; cmd: CommandDef };

  const navItems: NavItem[] = useMemo(() => {
    const items: NavItem[] = [];
    if (isSearching) {
      personHits.forEach((hit, i) =>
        items.push({ kind: "person", index: i, hit }),
      );
    }
    filtered.forEach((cmd, i) => items.push({ kind: "command", index: i, cmd }));
    return items;
  }, [isSearching, personHits, filtered]);

  const navCount = navItems.length;

  const onListKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((i) => Math.min(i + 1, navCount - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (navCount === 0) return;
        const item = navItems[active];
        if (!item) return;
        if (item.kind === "person") handleSelectPerson(item.hit);
        else handleSelectCommand(item.cmd);
      }
    },
    [navItems, navCount, active, handleSelectCommand, handleSelectPerson],
  );

  // Active index helpers
  const activePersonIdx = isSearching ? active : -1;
  const activeCmdOffset = isSearching ? active - personHits.length : active;

  if (!open) return null;

  return (
    <div
      className="fixed inset-0 z-50 flex items-start justify-center p-4 pt-[12vh] bg-black/60 backdrop-blur-sm"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
      aria-label="Command palette"
    >
      <div
        className="w-full max-w-md max-h-[80dvh] flex flex-col bg-bg-surface border border-border rounded-2xl shadow-2xl overflow-hidden"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Search input */}
        <div className="surface-card flex items-center gap-2 px-4 py-3">
          <Search className="w-4 h-4 text-text-muted shrink-0" />
          <input
            ref={inputRef}
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setActive(0);
            }}
            onKeyDown={onListKeyDown}
            placeholder="Type a command or search a roll number…"
            className="flex-1 bg-transparent text-sm text-text-primary placeholder:text-text-muted outline-none"
            aria-label="Command input"
          />
          <kbd className="surface-card text-xs font-mono px-1.5 py-0.5 bg-bg-elevated text-text-muted">
            esc
          </kbd>
        </div>

        {/* Records section (only when searching) */}
        {isSearching && (
          <div className="max-h-48 overflow-y-auto">
            <div className="px-4 pt-2 pb-1">
              <span className="text-[10px] font-semibold uppercase tracking-wider text-text-muted">
                Records
              </span>
            </div>
            {searchLoading ? (
              <div className="px-4 py-3 flex items-center gap-2 text-xs text-text-muted">
                <Loader2 className="w-3.5 h-3.5 animate-spin" />
                Searching…
              </div>
            ) : searchError ? (
              <div className="px-4 py-2 text-xs text-text-muted">
                Search unavailable
              </div>
            ) : personHits.length === 0 ? (
              <div className="px-4 py-2 text-xs text-text-muted">
                No matching records
              </div>
            ) : (
              <ul role="listbox" aria-label="Matching records">
                {personHits.map((hit, i) => {
                  const isActive = i === activePersonIdx;
                  return (
                    <li key={hit.uniqueId} role="option" aria-selected={isActive}>
                      <button
                        type="button"
                        onClick={() => handleSelectPerson(hit)}
                        onMouseEnter={() => setActive(i)}
                        className={`w-full flex items-center gap-3 px-4 py-2 text-left transition-colors ${
                          isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                        }`}
                      >
                        <span
                          className={`size-5 rounded flex items-center justify-center shrink-0 ${
                            isActive
                              ? "bg-action-primary/20 text-action-primary"
                              : "bg-bg-elevated text-text-secondary"
                          }`}
                        >
                          <UserRound className="w-3 h-3" />
                        </span>
                        <div className="min-w-0 flex-1">
                          <p
                            className={`text-sm truncate ${
                              isActive ? "text-action-primary" : "text-text-primary"
                            }`}
                          >
                            {hit.name}
                          </p>
                        </div>
                        <span className="font-mono text-xs text-text-muted shrink-0">
                          {hit.roll}
                        </span>
                      </button>
                    </li>
                  );
                })}
              </ul>
            )}
          </div>
        )}

        {/* Divider between records and commands when both are visible */}
        {isSearching && filtered.length > 0 && (
          <div className="border-t border-border" />
        )}

        {/* Command list */}
        {filtered.length > 0 ? (
          <ul
            role="listbox"
            aria-label="Commands"
            className="max-h-64 overflow-y-auto py-1"
          >
            {filtered.map((cmd, i) => {
              const globalIdx = isSearching ? personHits.length + i : i;
              const Icon = cmd.icon;
              const isActive = globalIdx === activeCmdOffset;
              return (
                <li key={cmd.id} role="option" aria-selected={isActive}>
                  <button
                    type="button"
                    onClick={() => handleSelectCommand(cmd)}
                    onMouseEnter={() => setActive(globalIdx)}
                    className={`w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors ${
                      isActive ? "bg-action-primary/10" : "hover:bg-bg-elevated"
                    }`}
                  >
                    <span
                      className={`size-6 rounded-lg flex items-center justify-center shrink-0 ${
                        isActive
                          ? "bg-action-primary/20 text-action-primary"
                          : "bg-bg-elevated text-text-secondary"
                      }`}
                    >
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <div className="min-w-0">
                      <p
                        className={`text-sm font-semibold ${
                          isActive ? "text-action-primary" : "text-text-primary"
                        }`}
                      >
                        {cmd.label}
                      </p>
                      <p className="text-xs text-text-muted truncate">{cmd.hint}</p>
                    </div>
                  </button>
                </li>
              );
            })}
          </ul>
        ) : (
          !isSearching && (
            <div className="px-4 py-6 text-center text-xs text-text-muted">
              No matching commands
            </div>
          )
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/shared/ConditionalAlert.tsx">
"use client";

import { useEffect, useState } from "react";
import { getRoleTier } from "@/lib/alert-hierarchy";
import { AlertDefinition, ALERT_CATALOGUE } from "@/lib/alert-hierarchy";
import type { AlertContext } from "@/lib/alert-hierarchy";
import { ChevronRight } from "lucide-react";

interface ConditionalAlertProps {
  ctx: AlertContext;
  limit?: number;
}

export function ConditionalAlert({ ctx, limit = 5 }: ConditionalAlertProps) {
  const [visible, setVisible] = useState<AlertDefinition[]>([]);

  useEffect(() => {
    const matches = ALERT_CATALOGUE.filter((a) => {
      // Tier gate

      const tier = getRoleTier(ctx.role);
      if (tier < a.minTier) return false;
      // Optional role allowlist
      if (a.visibleToRoles && !a.visibleToRoles.includes(ctx.role)) return false;
      // Dynamic condition
      return a.condition(ctx);
    });

    setVisible(matches.slice(0, limit));
  }, [ctx, limit]);

  if (!visible.length) return null;



  return (
      <div className="space-y-2" role="region" aria-label="Active alerts">
        {visible.map((a) => (
          <div
            key={a.id}
            className={`relative rounded-xl border p-3.5 flex items-start gap-3
              ${a.severity === "critical" ? "border-rose-500/50 bg-rose-500/10" : ""}
              ${a.severity === "high" ? "border-amber-500/50 bg-amber-500/10" : ""}
              ${a.severity === "medium" ? "border-sky-500/50 bg-sky-500/10" : ""}
              ${a.severity === "low" ? "border-emerald-500/50 bg-emerald-500/10" : ""}
            `}
          >
            <div className="flex-1 min-w-0">
              <p className="font-medium text-sm">{a.title}</p>
              <p className="mt-0.5 text-xs text-text-muted">{a.message}</p>
              {a.href && (
                <a
                  href={a.href}
                  className="mt-2 inline-flex items-center gap-1 text-xs font-medium text-action-success hover:underline"
                >
                  {a.ctaLabel ?? "Open"} <ChevronRight className="size-3.5" />
                </a>
              )}
            </div>
            <span className={`text-xs font-mono px-1.5 py-0.5 rounded
              ${a.severity === "critical" ? "bg-rose-500/20 text-action-danger" : ""}
              ${a.severity === "high" ? "bg-amber-500/20 text-action-warning" : ""}
              ${a.severity === "medium" ? "bg-sky-500/20 text-action-info" : ""}
              ${a.severity === "low" ? "bg-emerald-500/20 text-action-success" : ""}
            `}>
              {a.severity.toUpperCase()}
            </span>
          </div>
        ))}
      </div>
    );
}
