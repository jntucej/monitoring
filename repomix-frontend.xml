export function operationalRequestInspection(r: MessOperationalRequest): EntityInspection {
  const open = r.status === "OPEN";
  return {
    kind: "incident",
    title: r.title,
    subtitle: r.id,
    status: <StatusBadge text={r.status} tone={open ? "warn" : "ok"} />,
