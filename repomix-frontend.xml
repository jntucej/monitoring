<file path="src/app/(sysadmin)/sysadmin/analytics/page.tsx">
"use client";

import {
  useCallback, useEffect, useMemo, useState,
} from "react";
import {
  Activity, TrendingUp, Users, Download, RefreshCw,
} from "lucide-react";
import { AuthGuard } from "@/components/shared/AuthGuard";
import { WidgetBoundary } from "@/components/admin/shared/WidgetBoundary";
import { PageHeader } from "@/components/admin/shared/PageHeader";
import {
  ChartRenderer, type ChartType, type SeriesDef,
} from "@/components/admin/shared/ChartRenderer";
import { ChartTypeSwitcher } from "@/components/admin/shared/ChartTypeSwitcher";
import { Skeleton } from "@/components/ui/skeleton";
import { getAuthHeaders } from "@/lib/utils";
import { ContextSituationBar } from "@/components/shared/ContextSituationBar";

/**
 * SysAdmin Analytics — ported from the admin console so the root operator has
 * the same traffic / occupancy / demographic visibility. Reuses the admin
 * shared chart kit (gate-safe: the independence gate only forbids the
 * admin → sysadmin direction, never the reverse).
 */
interface DailyPoint {
  date: string;
  entries: number;
  exits: number;
  onCampus: number;
}
interface AnalyticsData {
  range: { from: string; to: string };
  daily: DailyPoint[];
  totals: { entries: number; exits: number; peakOnCampus: number; peakHour: string | null };
  byDepartment: Array<{ code: string; name: string; count: number }>;
  byRole: Array<{ role: string; count: number }>;
}
const CHART_PALETTE = {
  primary: "var(--action-success)", info: "var(--action-primary)", warning: "var(--action-warning)",
  danger: "var(--action-danger)", violet: "var(--unit-c)",
};

async function fetchAnalytics(days = 14): Promise<AnalyticsData> {
  const now = new Date();
  const dates: DailyPoint[] = [];
  const dayStr = (d: Date) => d.toISOString().slice(0, 10);
  const fetchOne = async (offset: number) => {
    const d = new Date(now);
    d.setDate(d.getDate() - offset);
    const res = await fetch(`/api/analytics/daily?date=${dayStr(d)}`, { headers: getAuthHeaders() });
    if (!res.ok) return null;
    const body = await res.json();
    const payload = body?.data ?? body;
    return {
      date: dayStr(d),
      entries: Number(payload?.entries ?? 0),
      exits: Number(payload?.exits ?? 0),
      onCampus: Number(payload?.onCampus ?? payload?.on_campus ?? 0),
    } as DailyPoint;
  };
  await Promise.all(Array.from({ length: days }, (_, i) => fetchOne(days - 1 - i).then((p) => p && dates.push(p))));
  dates.sort((a, b) => a.date.localeCompare(b.date));
  const totals = {
    entries: dates.reduce((a, b) => a + b.entries, 0),
    exits: dates.reduce((a, b) => a + b.exits, 0),
    peakOnCampus: Math.max(0, ...dates.map((d) => d.onCampus)),
    peakHour: null as string | null,
  };
  return { range: { from: dates[0]?.date ?? dayStr(now), to: dates[dates.length - 1]?.date ?? dayStr(now) }, daily: dates, totals, byDepartment: [], byRole: [] };
}

function SysAdminAnalyticsInner() {
  const [data, setData] = useState<AnalyticsData | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [range, setRange] = useState<7 | 14 | 30>(14);
  const [trafficType, setTrafficType] = useState<ChartType>("area");
  const [campusType, setCampusType] = useState<ChartType>("line");
  const [roleType, setRoleType] = useState<ChartType>("bar");

  const load = useCallback(async () => {
    try { setData(await fetchAnalytics(range)); setError(null); }
    catch (e) { setError(e instanceof Error ? e.message : "Failed to load analytics"); }
  }, [range]);
  useEffect(() => { load(); }, [load]);

  const trafficSeries: SeriesDef[] = [
    { key: "entries", label: "Entries", color: CHART_PALETTE.primary, type: "area" },
    { key: "exits", label: "Exits", color: CHART_PALETTE.danger, type: "area" },
  ];
  const campusSeries: SeriesDef[] = [{ key: "onCampus", label: "On campus", color: CHART_PALETTE.info, type: "line" }];
  const roleSeries: SeriesDef[] = [{ key: "count", label: "Users", color: CHART_PALETTE.violet, type: "bar" }];

  const trafficData = useMemo(() => (data?.daily ?? []).map((d) => ({ date: d.date.slice(5), entries: d.entries, exits: d.exits, onCampus: d.onCampus })), [data]);
  const deptData = useMemo(() => (data?.byDepartment ?? []).map((d) => ({ code: d.code, count: d.count })), [data]);

  const exportCsv = () => {
    if (!data) return;
    const header = "date,entries,exits,onCampus\n";
    const rows = data.daily.map((d) => `${d.date},${d.entries},${d.exits},${d.onCampus}`).join("\n");
    const blob = new Blob([header + rows], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = `sysadmin-analytics-${range}d.csv`; a.click();
    URL.revokeObjectURL(url);
  };

  if (!data && !error) {
    return (
      <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-4 py-4 md:py-6">
        <Skeleton className="h-10 w-64" />
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {Array.from({ length: 4 }).map((_, i) => <Skeleton key={i} className="h-24 rounded-2xl" />)}
        </div>
        <Skeleton className="h-72 rounded-2xl" />
      </div>
    );
  }

  return (
    <div className="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 py-4 md:py-6">
      <ContextSituationBar
        roleLabel="System Admin"
        contextLabel="Campus Movement Analytics"
        purpose="Analyze cross-campus pedestrian traffic flows, peak gate utilization, occupancy splits, and demographic movement trends."
        statusSummary={`${data?.totals?.entries ?? 0} entries and ${data?.totals?.exits ?? 0} exits logged across campus entry and exit turnstiles over the selected window.`}
        why="Longitudinal traffic and occupancy trends inform gate staffing schedules, security post allocations, and bottleneck mitigation plans."
        primaryAction={{ label: "SysAdmin Overview", href: "/sysadmin" }}
        secondaryAction={{ label: "Attendance Records", href: "/sysadmin/attendance" }}
      />
      <PageHeader title="Analytics" subtitle="Traffic, occupancy, and demographic breakdowns" onRefresh={load} />
      {error && <div className="surface-card p-3 text-sm text-action-danger">{error}</div>}

      <div className="flex items-center justify-between gap-2 flex-wrap">
        <div className="surface-card flex flex-wrap gap-1 p-1">
          {([7, 14, 30] as const).map((d) => (
            <button key={d} onClick={() => setRange(d)} className={`text-xs px-3 py-1 min-h-11 rounded-lg flex items-center justify-center ${range === d ? "bg-action-primary text-white" : "text-text-muted hover:text-text-primary"}`}>
              {d}d
            </button>
          ))}
        </div>
        <div className="flex flex-wrap items-center gap-2">
          <button onClick={exportCsv} className="surface-card flex items-center gap-1.5 text-xs px-3 py-1.5 min-h-11 hover:bg-bg-surface/60"><Download className="w-3.5 h-3.5" /> CSV</button>
          <button onClick={load} className="surface-card flex items-center gap-1.5 text-xs px-3 py-1.5 min-h-11 hover:bg-bg-surface/60"><RefreshCw className="w-3.5 h-3.5" /> Refresh</button>
        </div>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div className="surface-card p-4">
          <div className="flex items-center gap-2 text-xs text-text-muted mb-1"><TrendingUp className="w-3.5 h-3.5 text-action-primary" /> Total entries</div>
          <p className="text-2xl font-bold text-text-primary tabular-nums">{data?.totals.entries.toLocaleString() ?? "—"}</p>
        </div>
        <div className="surface-card p-4">
          <div className="flex items-center gap-2 text-xs text-text-muted mb-1"><TrendingUp className="w-3.5 h-3.5 text-action-danger" /> Total exits</div>
          <p className="text-2xl font-bold text-text-primary tabular-nums">{data?.totals.exits.toLocaleString() ?? "—"}</p>
        </div>
        <div className="surface-card p-4">
          <div className="flex items-center gap-2 text-xs text-text-muted mb-1"><Users className="w-3.5 h-3.5 text-action-info" /> Peak on campus</div>
          <p className="text-2xl font-bold text-text-primary tabular-nums">{data?.totals.peakOnCampus ?? "—"}</p>
        </div>
        <div className="surface-card p-4">
          <div className="flex items-center gap-2 text-xs text-text-muted mb-1"><Activity className="w-3.5 h-3.5 text-action-warning" /> Peak hour</div>
          <p className="text-2xl font-bold text-text-primary tabular-nums">{data?.totals.peakHour ?? "—"}</p>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <WidgetBoundary title="Traffic">
          <div className="surface-card p-4">
            <header className="flex items-center justify-between mb-3">
              <h2 className="text-sm font-semibold">Gate traffic</h2>
              <ChartTypeSwitcher value={trafficType} onChange={setTrafficType} compact />
            </header>
            <div style={{ height: 260 }}><ChartRenderer type={trafficType} data={trafficData} series={trafficSeries} xKey="date" /></div>
          </div>
        </WidgetBoundary>
        <WidgetBoundary title="Campus occupancy">
          <div className="surface-card p-4">
            <header className="flex items-center justify-between mb-3">
              <h2 className="text-sm font-semibold">On campus over time</h2>
              <ChartTypeSwitcher value={campusType} onChange={setCampusType} compact />
            </header>
            <div style={{ height: 260 }}><ChartRenderer type={campusType} data={trafficData} series={campusSeries} xKey="date" /></div>
          </div>
        </WidgetBoundary>
        <WidgetBoundary title="By department">
          <div className="surface-card p-4">
            <header className="flex items-center justify-between mb-3"><h2 className="text-sm font-semibold">Department breakdown</h2></header>
            <div style={{ height: 260 }}>
              <ChartRenderer type="bar" data={deptData} series={[{ key: "count", label: "Users", color: CHART_PALETTE.primary, type: "bar" }]} xKey="code" />
            </div>
          </div>
        </WidgetBoundary>
        <WidgetBoundary title="By role">
          <div className="surface-card p-4">
            <header className="flex items-center justify-between mb-3">
              <h2 className="text-sm font-semibold">Role distribution</h2>
              <ChartTypeSwitcher value={roleType} onChange={setRoleType} compact />
            </header>
            <div style={{ height: 260 }}><ChartRenderer type={roleType} data={data?.byRole ?? []} series={roleSeries} xKey="role" /></div>
          </div>
        </WidgetBoundary>
      </div>
    </div>
  );
}

export default function SysAdminAnalyticsPage() {
  return (
    <AuthGuard allowedRoles={["sysadmin", "admin"]}>
