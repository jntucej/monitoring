<file path="src/components/shared/MobileNavDrawer.tsx">
"use client";

import React, { useEffect, useRef } from "react";
import { X } from "lucide-react";
import { cn } from "@/lib/utils";

/**
 * MobileNavDrawer — a left-anchored, off-canvas navigation drawer shared by the
 * admin and sysadmin consoles.
 *
 * Fixes the "drawer slides in from the right" defect: it is anchored to
 * `left-0` and hidden off-screen to the *left* (`-translate-x-full`), which is
 * the accepted pattern (left = navigation, right = settings/filters).
 *
 * Accessibility:
 *  - Focus moves into the drawer on open and returns to the trigger on close.
 *  - Esc closes.
 *  - All motion is gated behind `prefers-reduced-motion`.
 *  - A body-scroll lock prevents the content behind the sheet from scrolling.
 */
export interface MobileNavDrawerProps {
  open: boolean;
  onClose: () => void;
  /** The trigger element to focus when the drawer closes. Pass the hamburger. */
  triggerRef?: React.RefObject<HTMLElement | null>;
  label?: string;
  children: React.ReactNode;
  className?: string;
}

export function MobileNavDrawer({
  open,
  onClose,
  triggerRef,
  label = "Navigation",
  children,
  className,
}: MobileNavDrawerProps) {
  const panelRef = useRef<HTMLDivElement | null>(null);
  const closeRef = useRef<HTMLButtonElement | null>(null);

  // Focus management + scroll lock + Esc.
  useEffect(() => {
    if (!open) return;
    const prevOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";

    // Move focus to the close button (first interactive control in the sheet).
    const t = window.setTimeout(() => closeRef.current?.focus(), 0);
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") onClose();
      // Simple focus trap: keep Tab inside the panel.
      if (e.key === "Tab" && panelRef.current) {
        const focusables = panelRef.current.querySelectorAll<HTMLElement>(
          'a[href], button, [tabindex]:not([tabindex="-1"])'
        );
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };
    document.addEventListener("keydown", onKey);
    return () => {
      window.clearTimeout(t);
      document.removeEventListener("keydown", onKey);
      document.body.style.overflow = prevOverflow;
      triggerRef?.current?.focus();
    };
  }, [open, onClose, triggerRef]);

  if (!open) return null;

  return (
    <div className="fixed inset-0 z-[var(--z-sheet)] md:hidden" role="presentation">
      {/* Backdrop */}
      <div
        className="absolute inset-0 bg-black/50 backdrop-blur-sm motion-reduce:backdrop-blur-none"
        onClick={onClose}
        aria-hidden="true"
      />
      {/* Sheet — left-anchored */}
      <div
        ref={panelRef}
        role="dialog"
        aria-modal="true"
        aria-label={label}
        className={cn(
          "absolute left-0 top-0 h-full w-[85%] max-w-sm bg-bg-surface shadow-2xl",
          "animate-drawer-in motion-reduce:animate-none",
          className
        )}
      >
        <div className="flex items-center justify-between p-2">
          <span className="sr-only">{label}</span>
          <button
            ref={closeRef}
            type="button"
            onClick={onClose}
            aria-label="Close navigation"
            className="inline-flex items-center justify-center rounded-md p-2 min-h-11 min-w-11 text-text-muted hover:bg-bg-elevated focus:outline-none focus-visible:ring-2 focus-visible:ring-action-primary"
          >
            <X className="h-4 w-4" />
          </button>
        </div>
        <div className="h-[calc(100%-3rem)] overflow-y-auto overscroll-contain">
          {children}
        </div>
      </div>
    </div>
  );
}

export default MobileNavDrawer;
</file>

<file path="src/components/shared/MyTicketsPanel.tsx">
"use client";
// src/components/shared/MyTicketsPanel.tsx
// SCAFFOLD:TICKETS — self-service ticket list. Any role can use it.
//
// Idempotent — regenerate with scripts/scaffold-tickets.mjs new <f> --force
// to update the shared panel across every role.

import { useCallback, useMemo, useState } from "react";
import Link from "next/link";
import {
  AlertCircle, ArrowLeft, Filter, Inbox, Loader2, Plus, RefreshCw,
} from "lucide-react";
import { WidgetBoundary } from "@/components/shared/WidgetBoundary";
import { EmptyState } from "@/components/shared/EmptyState";
import { Skeleton } from "@/components/ui/skeleton";
import { PermissionTicketCard } from "@/components/student/PermissionTicketCard";
import { PermissionDetailPanel } from "@/components/approver/PermissionDetailPanel";
import type { PermissionItem } from "@/components/approver/PermissionRow";
import { TicketKpiStrip, type TicketCounts } from "./TicketKpiStrip";
import { useDashboardData } from "@/hooks/useDashboardData";
import { usePolling } from "@/hooks/usePolling";

type StatusFilter = "ALL" | "PENDING" | "APPROVED" | "REJECTED" | "COMPLETED";

const FILTERS: StatusFilter[] = ["ALL", "PENDING", "APPROVED", "REJECTED", "COMPLETED"];












export interface MyTicketsPanelProps {
  title?: string;
  subtitle?: string;
  backHref?: string;
  newTicketHref?: string;
  canCreate?: boolean;
  /** Optional extra query params appended to /api/permissions?mine=true */
  extraQuery?: string;
  pollMs?: number;
}

export function MyTicketsPanel({
  title = "My Tickets",
  subtitle = "Permission requests you have raised",
  backHref,
  newTicketHref,
  canCreate = true,
  extraQuery = "",
  pollMs = 30_000,
}: MyTicketsPanelProps) {
  const [filter, setFilter] = useState<StatusFilter>("ALL");
  const [selected, setSelected] = useState<string | null>(null);

  const ticketsUrl = useMemo(
    () => `/api/permissions?mine=true${extraQuery ? `&${extraQuery}` : ""}`,
    [extraQuery],
  );

  const { data, loading, error, refresh, refreshKey } =
    useDashboardData<PermissionItem[]>(ticketsUrl, { ttlMs: 5_000, pollMs });

  const { data: countsData, refresh: refreshCounts } =
    useDashboardData<TicketCounts>("/api/permissions/my-counts", {
      ttlMs: 5_000,
      pollMs,
    });

  usePolling(
    useCallback(async () => { await refreshCounts(); }, [refreshCounts]),
    { intervalMs: pollMs, enabled: true },
  );

  const rows = data ?? [];
  const filtered = useMemo(
    () => (filter === "ALL" ? rows : rows.filter((r) => r.status === filter)),
    [rows, filter],
  );

  return (
    <div className="mx-auto max-w-5xl space-y-4 p-4">
      {/* Header */}
      <div className="flex items-center justify-between gap-3">
        <div className="flex items-center gap-3">
          {backHref && (
            <Link
              href={backHref}
              className="surface-card p-1.5 hover:bg-bg-elevated"
              aria-label="Back"
            >
              <ArrowLeft className="h-4 w-4" />
            </Link>
          )}
          <div>
            <h1 className="text-fluid-lg font-semibold">{title}</h1>
            {subtitle && (
              <p className="text-xs text-text-muted">{subtitle}</p>
            )}
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button
            type="button"
            onClick={() => void refresh()}
            disabled={loading}
            className="surface-card p-2 hover:bg-bg-elevated disabled:opacity-50"
            aria-label="Refresh tickets"
          >
            {loading
              ? <Loader2 className="h-4 w-4 animate-spin" />
              : <RefreshCw className="h-4 w-4" />}
          </button>
          {canCreate && newTicketHref && (
            <Link
              href={newTicketHref}
              className="surface-card flex items-center gap-1.5 bg-action-primary px-3 py-2 text-sm text-white"
            >
              <Plus className="h-4 w-4" />
              New Ticket
            </Link>
          )}
        </div>
      </div>

      {/* KPI strip */}
      <WidgetBoundary>
        <TicketKpiStrip
          counts={countsData ?? null}
          loading={!countsData && loading}
        />
      </WidgetBoundary>

      {/* Filter tabs */}
      <div className="flex flex-wrap items-center gap-2">
        <Filter className="h-3.5 w-3.5 text-text-muted" />
        {FILTERS.map((f) => (
          <button
            key={f}
            type="button"
            onClick={() => setFilter(f)}
            className={`rounded-full px-3 py-1 text-xs transition ${
              filter === f
                ? "bg-action-primary text-white"
                : "bg-bg-elevated text-text-muted hover:text-text-primary"
            }`}
          >
            {f}
          </button>
        ))}
      </div>

      {/* Error banner */}
      {error && (
        <div className="surface-card flex items-center gap-2 bg-action-danger/10 p-3 text-sm text-action-danger">
          <AlertCircle className="h-4 w-4 shrink-0" />
          <span className="min-w-0 flex-1 truncate">{error}</span>
          <button
            type="button"
            onClick={() => void refresh()}
            className="surface-card bg-bg-elevated px-2 py-1 text-xs"
          >
            Retry
          </button>
        </div>
      )}

      {/* Loading skeletons */}
      {loading && rows.length === 0 && (
        <div className="space-y-2">
          {[0, 1, 2].map((i) => <Skeleton key={i} className="h-24 rounded-xl" />)}
        </div>
      )}

      {/* Empty state */}
      {!loading && filtered.length === 0 && !error && (
        <EmptyState
          icon={<Inbox className="size-6" />}
          title={filter === "ALL" ? "No tickets yet" : `No ${filter.toLowerCase()} tickets`}
          description={
            filter === "ALL"
              ? "When you raise a permission request it will appear here."
              : "Try a different status filter, or create a new ticket."
          }
          action={
            canCreate && newTicketHref ? (
              <Link
                href={newTicketHref}
                className="surface-card inline-flex items-center gap-1.5 bg-action-primary px-3 py-2 text-sm text-white"
              >
                <Plus className="h-4 w-4" />
                New Ticket
              </Link>
            ) : undefined
          }
        />
      )}

      {/* Ticket list */}
      {filtered.length > 0 && (
        <WidgetBoundary key={refreshKey}>
          <div className="space-y-2">
            {filtered.map((t) => (
              <PermissionTicketCard
                key={t.id}
                ticket={t}
                onSelect={(n) => setSelected(n)}
              />
            ))}
          </div>
        </WidgetBoundary>
      )}

      {/* Detail panel */}
      <PermissionDetailPanel
        ticket={selected}
        onClose={() => setSelected(null)}
        onActionComplete={() => { void refresh(); void refreshCounts(); }}
      />
    </div>
  );
}
</file>

